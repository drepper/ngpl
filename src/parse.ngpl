let ast := @import("ast")
let diag := @import("diag")
let lex := @import("lex")
let tokens := @import("tokens")
let types := @import("types")

// ===========================================================================
// Parsing: tokens → Ast
// ===========================================================================



struct Parser:
    mtab : ast.Mods          // what the reader worked out about the modules
    udecl : str[]        // the measures a declaration has been read for
    edecl : str[]        // … and the enums
    blets : i64[]        // see Ast
    toks : lex.Toks
    src : byte[]
    pos : i64
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    fns : ast.FnDef[]
    qmods : str[]        // the module each qualified call names
    builds : ast.FnDef[]     // the @build recipe, kept apart from the rest
    globals : ast.GlobalDef[]
    structs : ast.SDef[]
    tanames : str[]      // the names standing for types, and what they stand for
    tatypes : i64[]
    unames : str[]       // the measures this file knows, builtin then defined
    udecay : i64[]       // … and what each may stand in for
    udname : str[]       // … as written, until the file has been read
    udtok : i64[]        // … and where it was written
    umarks : str[]       // … and how each one prints
    snames : str[]       // struct names, pre-scanned so a struct may
                         // be written below whatever names it
    sexp : i64[]         // … and 1 where @export lets another module
                         // name it
    eexp : i64[]         // the same for each enum
    tts : i64[]          // interned tuple shapes, moved into the Ast
    ttl : i64[]
    tte : i64[]
    fae : i64[]
    fas : i64[]
    hdty : i64[]         // the type digest() answers, per algorithm
    mel : i64[]
    mrr : i64[]
    mcc : i64[]
    mdd : i64[]
    minner : i64[]
    lts : i64[]
    ltl : i64[]
    lte : i64[]
    ltf : i64[]          // 1 where the lambda threads
    olds : i64[]         // the @old nodes of the definition being read
    enames : str[]
    ewidth : i64[]
    estart : i64[]
    ecount : i64[]
    eflag : i64[]
    emembers : str[]
    evalues : i64[]
    tvn : str[]          // type-variable spellings, interned file-wide
    braces : i64
    semi_end : bool      // the statement just ended carried a ';' where a
                         // line would have ended it: laid out, that says
                         // the value is dropped         // statements end at ';' inside a brace block
    lent : i64           // the statement's terminator belongs to the block
    ifexpr : i64         // an if is being parsed where a value is wanted,
                         // so a one-line block inside it ends at the
                         // clause after it and not at the line's end
    ignored : str[]
    igtests : str[]
    // Definitions marked @expect: kept, so the checker can draw the
    // diagnostics they were written to draw and hold them to what they
    // say.  expoff points at [n, level, code, …] in extra.
    expects : ast.FnDef[]
    expoff : i64[]
    pending_exp : i64    // the offset the definition being parsed will take
    def_start : i64      // where the definition being parsed began
    diags : diag.Diag[]
    poisoned : bool      // the statement at hand already misparsed

// What a block is opened with, said once because four constructs say
// it: the colon means the block is laid out under it and the brace
// means it is delimited, so one of them opens a block and never both.
fn both_openers() → str:
    """a ':' opens a block laid out under it and a '{' opens one written
     " in braces; a block takes one of them, not both"""

// Whether a name carries the module it was asked of.  A name written
// bare is its own module's or nobody's; one with a period was reached
// through a binding and says where to look.
fn holds_dot(nm : str) → bool:
    foreach c := nm:
        if c = '.':
            return true
    false

impl Parser:
    // The module a token was written in: the file it falls in says
    // which, and the file it falls in is the last one that begins at
    // or before it.  A handful of files, so the walk finds it in fewer
    // steps than a search would take to set up.
    fn mod_at(&self, at : i64) → str:
        let off : i64 ¤byte = self.toks.off[at × 1¤ptrdiff] × 1¤byte
        let k : mut i64 ¤ptrdiff = 0¤ptrdiff
        while k + 1¤ptrdiff < #self.mtab.offs and self.mtab.offs[k + 1¤ptrdiff] <= off:
            k ← k + 1¤ptrdiff
        self.mtab.names[self.mtab.fmod[k] × 1¤ptrdiff]

    // The whole module a definition lives in: the file's, and then the
    // section a `module` line opened inside it.
    // which module the file a token was written in is
    fn modidx_at(&self, at : i64) → i64:
        let off : i64 ¤byte = self.toks.off[at × 1¤ptrdiff] × 1¤byte
        let k : mut i64 ¤ptrdiff = 0¤ptrdiff
        while k + 1¤ptrdiff < #self.mtab.offs and self.mtab.offs[k + 1¤ptrdiff] <= off:
            k ← k + 1¤ptrdiff
        self.mtab.fmod[k]

    // The module a name reaches from where it is written, or "" where
    // it reaches none.  A binding belongs to the module it was written
    // in: what one module binds is not another's to write.
    fn bound_module(&self, at : i64) → str:
        if #self.mtab.bname = 0¤ptrdiff:
            return ""
        let owner : i64 = self.modidx_at(at)
        let nm : str = self.ttext(at)
        foreach i := 0¤ptrdiff…#self.mtab.bname:
            if self.mtab.bowner[i] = owner and self.mtab.bname[i] = nm:
                return self.mtab.names[self.mtab.bmod[i] × 1¤ptrdiff]
        ""

    // A name's whole name: the module the file is, and then its own.
    fn qual_type(&self, name : str, at : i64) → str:
        let f : str = self.mod_at(at)
        if f = "": name else: f ⧺ "." ⧺ name

    fn peek(&self) → i64:
        self.toks.kind[self.pos × 1¤ptrdiff]

    fn peek2(&self) → i64:
        self.toks.kind[(self.pos + 1) × 1¤ptrdiff]

    // A '{' after a name opens a struct literal when what stands
    // just inside says so -- nothing, or a field's name and its ':' --
    // and a block otherwise.  Without the distinction `while n < x {`
    // reads as a literal of type x and the loop's body is lost, which
    // is the one thing that stops a brace body being written wherever
    // an indented one can.  The interpreter draws the line in the same
    // place, so the two agree about which program is which.
    fn slit_ahead(&self) → bool:
        let n : i64 = @dropunit(#self.toks.kind)
        let a : i64 = self.pos + 2
        if a >= n:
            return false
        if self.toks.kind[a × 1¤ptrdiff] = tokens.Tk.rbrace:
            return true
        if self.toks.kind[a × 1¤ptrdiff] ≠ tokens.Tk.ident:
            return false
        if a + 1 >= n:
            return false
        self.toks.kind[(a + 1) × 1¤ptrdiff] = tokens.Tk.colon

    // A brace body ends at its '}' and the line ends after it, so an
    // `else` belonging to that if stands on the next line and the
    // newline is in the way of finding it.  It is stepped over there
    // and nowhere else: what is between a '}' and an `else` ends
    // nothing, while a blank line anywhere else still ends what it
    // ends.
    fn skip_nl_before_else(&mut self):
        let n : i64 = @dropunit(#self.toks.kind)
        if self.peek() ≠ tokens.Tk.nl or self.pos + 1 >= n or self.pos = 0:
            return
        if self.toks.kind[(self.pos - 1) × 1¤ptrdiff] ≠ tokens.Tk.rbrace:
            return
        let nx : i64 = self.toks.kind[(self.pos + 1) × 1¤ptrdiff]
        if nx = tokens.Tk.kw_else or nx = tokens.Tk.kw_elif:
            self.pos ← self.pos + 1

    fn ttext(&self, at : i64) → str:
        tokens.run_str(self.src, self.toks.off[at × 1¤ptrdiff],
                self.toks.len[at × 1¤ptrdiff])

    fn failed(&self) → bool:
        self.poisoned

    // a complaint about something already read points back at it, since
    // by the time it is noticed self.pos has moved past
    fn err_at(&mut self, tok : i64, m : str):
        if not self.poisoned:
            let at : i64 ¤ptrdiff = tok
            self.diags.push(diag.Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m, level: diag.DIAG_ERROR, code: diag.DIAG_NONE})
        self.poisoned ← true

    // the same, saying which complaint it is; see Checker.derrc
    @pre(code > 0)
    fn errc_at(&mut self, tok : i64, code : i64, m : str):
        if not self.poisoned:
            let at : i64 ¤ptrdiff = tok
            self.diags.push(diag.Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m, level: diag.DIAG_ERROR, code: code})
        self.poisoned ← true

    fn err(&mut self, m : str):
        if not self.poisoned:
            let at : i64 ¤ptrdiff = self.pos
            self.diags.push(diag.Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m, level: diag.DIAG_ERROR, code: diag.DIAG_NONE})
        self.poisoned ← true
        if #self.diags >= 20:
            // enough; parking on the closing EOF stops everything
            self.pos ← @dropunit(#self.toks.kind) - 1

    // skip what is left of the misparsed statement and start clean on
    // the next line; the block structure survives through the
    // indentation tokens
    fn sync(&mut self):
        self.poisoned ← false
        while true:
            let k : i64 = self.peek()
            if k = tokens.Tk.eof or k = tokens.Tk.dedent:
                return
            self.pos ← self.pos + 1
            if k = tokens.Tk.nl:
                return

    // The kind wanted arrives as what it is; the table it is compared
    // against is one array of numbers, and a kind meets a number there.
    fn eat(&mut self, k : tokens.Tk, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() ≠ k:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // a name where the bootstrap's reserved words are refused by name
    fn eat_name(&mut self, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() = tokens.Tk.reserved:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return at
        if self.peek() ≠ tokens.Tk.ident:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // an annotation or std-member name: reserved words are fine here,
    // since @start and std.println spell some of them
    fn eat_word(&mut self, what : str) → i64:
        let at : i64 = self.pos
        // a member's or field's name may be any word, including one
        // the language keeps for itself elsewhere: 'type' names a type
        // at the top level and a directory entry's kind after a dot
        if self.peek() ≠ tokens.Tk.ident and self.peek() ≠ tokens.Tk.reserved and self.peek() ≠ tokens.Tk.kw_type and self.peek() ≠ tokens.Tk.kw_enum:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // The kind arrives as what it is and is written down as the number
    // behind it: the tree is parallel arrays of numbers, which is what
    // every walk over it indexes.
    fn mknode(&mut self, k : ast.Nk, tok : i64, a : i64, b : i64, c : i64) → i64:
        let id : i64 = @dropunit(#self.nkind)
        self.nkind.push(k.ord())
        self.ntok.push(tok)
        self.na.push(a)
        self.nb.push(b)
        self.nc.push(c)
        id

    // where the next thing written into the extra table will land
    fn extra_end(&self) → i64 ¤"aextra":
        @dropunit(#self.extra) × 1¤"aextra"

    fn push_list(&mut self, items : i64[]) → i64 ¤"aextra":
        let off : i64 ¤"aextra" = self.extra_end()
        self.extra.push(@dropunit(#items))
        foreach a := items:
            self.extra.push(a)
        off

    // ------------------------------------------------------------------
    // Types
    // ------------------------------------------------------------------

    // [&[mut]] base [¤unit] [[]]; refs are only meaningful on
    // parameters and the caller of parse_type says whether they may be
    fn parse_type(&mut self, allow_ref : bool) → i64:
        let refk : mut i64 = 0
        if self.peek() = tokens.Tk.band:
            if not allow_ref:
                self.err("a borrow is written on a parameter, not here")
                return types.TY_I64
            self.pos ← self.pos + 1
            refk ← 1
            if self.peek() = tokens.Tk.kw_mut:
                self.pos ← self.pos + 1
                refk ← 2
        if self.peek() = tokens.Tk.lpar:
            // (T1, T2, …): a tuple type
            self.pos ← self.pos + 1
            if refk ≠ 0:
                self.err("a core-2 tuple is not borrowed; it is returned and taken apart")
                return types.TY_I64
            let es : mut i64[] = []
            while true:
                let et : i64 = self.parse_type(false)
                if not ((types.ty_is_int(et) and types.ty_unit(et) = 0) or et = types.TY_BOOL or et = types.TY_STR or et = types.TY_CHAR or types.ty_is_struct(et) or types.ty_is_opt(et)):
                    self.err("""a core-2 tuple holds plain integers, truth values, characters,
                              " strings, structs or optionals""")
                    return types.TY_I64
                es.push(et)
                if self.failed():
                    return types.TY_I64
                if self.peek() = tokens.Tk.comma:
                    self.pos ← self.pos + 1
                else:
                    break
            _ ← self.eat(tokens.Tk.rpar, "')' closing the tuple type")
            if #es < 2:
                self.err("a tuple type holds at least two elements; (T) is just T")
                return types.TY_I64
            if self.peek() = tokens.Tk.qmark:
                // a tuple is a pointer to its elements, so an optional
                // one is that pointer in a box, as any optional is
                self.pos ← self.pos + 1
                return types.mk_oty(types.mk_tty(self.tup_intern(es)))
            if self.peek() = tokens.Tk.lbrack:
                self.err("an array of tuples is not core-2 yet")
                return types.TY_I64
            return types.mk_tty(self.tup_intern(es))
        if self.peek() = tokens.Tk.number:
            self.err("'" ⧺ self.ttext(self.pos) ⧺ """' does not name a type; a type is written by
                                                   " name, as i64""")
            return types.TY_I64
        let ntok : i64 = self.pos
        let name : mut str = self.ttext(self.pos)
        _ ← self.eat_name("a type name")
        // `m.Name` where m is a bound import: a type of another module,
        // named through the only way into it.  Nothing else puts a dot
        // in a type, so the shape settles it.
        if name ≠ "std" and self.peek() = tokens.Tk.dot and self.toks.kind[(self.pos + 1) × 1¤ptrdiff] = tokens.Tk.ident:
            let bm : str = self.bound_module(ntok)
            if bm ≠ "":
                self.pos ← self.pos + 1
                let tn : i64 = self.pos
                let own : str = self.ttext(tn)
                name ← bm ⧺ "." ⧺ own
                _ ← self.eat_name("the type asked of the module")
                self.hold_export(tn, bm, own)
        let stdbase : mut i64 = ⁻1
        if name = "std":
            _ ← self.eat(tokens.Tk.dot, "'.' after std")
            let m := self.ttext(self.pos)
            _ ← self.eat_word("the std type's name")
            if m = "dict":
                _ ← self.eat(tokens.Tk.lpar, "'(' after std.dict")
                let kt : i64 = self.parse_type(false)
                _ ← self.eat(tokens.Tk.comma, "',' between the key and value types")
                let vt : i64 = self.parse_type(false)
                _ ← self.eat(tokens.Tk.rpar, "')' closing std.dict")
                if not ((types.ty_is_int(kt) and types.ty_unit(kt) = 0) or kt = types.TY_STR):
                    self.err("a core-2 dictionary key is a plain integer or a string")
                    return types.TY_I64
                // An enum is a number underneath and travels as one, so
                // a table may hold what it means rather than the number
                // behind it.
                if not ((types.ty_is_int(vt) and types.ty_unit(vt) = 0) or vt = types.TY_BOOL or vt = types.TY_STR or types.ty_is_struct(vt) or types.ty_is_enum(vt)):
                    self.err("""a core-2 dictionary holds integers, truth values, strings, structs
                              " or enumerations""")
                    return types.TY_I64
                if refk ≠ 0:
                    return types.mk_hty(kt, vt) + 262144 × refk
                return types.mk_hty(kt, vt)
            if m = "hash":
                // this type's name until std.hash became the digests
                self.err("""'std.hash' is the digests now; the type that maps keys to values is
                          " 'std.dict(K, V)'""")
                return types.TY_I64
            if m = "Build":
                // What a @build recipe declares on.  It is handed to the
                // recipe rather than copied into it, and the recipe adds
                // to it, so the parameter is written with the borrow that
                // says both.
                if refk ≠ 2:
                    self.err("""a std.Build is handed to a recipe, which adds what it declares to
                              " it; the parameter is written '&mut std.Build'""")
                    return types.TY_I64
                return types.TY_BUILD + 262144 × refk
            if m = "Options":
                // What the command line said, as a recipe reads it.  A
                // recipe reads it and does not change it -- the command
                // line is not a recipe's to rewrite -- so the borrow is
                // the plain one.
                if refk ≠ 1:
                    self.err("""a recipe reads what the command line said and does not change it;
                              " the parameter is written '&std.Options'""")
                    return types.TY_I64
                return types.TY_OPTIONS + 262144 × refk
            if m ≠ "iovec":
                self.err("'std." ⧺ m ⧺ """' is not a core-2 type; std.dict(K, V), std.iovec,
                          " std.Build and std.Options are""")
                return types.TY_I64
            // a run of bytes waiting to be written; what it holds is
            // settled where it is made, not where it is named, so the
            // name carries nothing with it
            stdbase ← types.TY_IOVEC
        if #name >= 2 and name[#name - 1] = '\'':
            // a type variable: whatever the call hands over
            let tv : mut i64 = ⁻1
            if #self.tvn > 0:
                foreach i := 0…#self.tvn:
                    if self.tvn[i] = name:
                        tv ← 194048 + @dropunit(i)
            if tv = ⁻1:
                if #self.tvn >= 32:
                    self.err("this file spells more than 32 type variables")
                    return types.TY_I64
                tv ← 194048 + @dropunit(#self.tvn)
                self.tvn.push(name)
            if self.peek() = tokens.Tk.lbrack or self.peek() = tokens.Tk.qmark or self.peek() = tokens.Tk.currency:
                self.err("a type variable stands alone; it carries no suffix")
                return types.TY_I64
            if refk ≠ 0:
                self.err("a type variable travels by value")
                return types.TY_I64
            return tv
        let base0 : i64 = if stdbase ≠ ⁻1: stdbase else: (ast.TYNAMES[name] ?? self.sindex_here(name, ntok))
        if base0 = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a core-2 type")
            return types.TY_I64
        let base : mut i64 = base0
        if self.peek() = tokens.Tk.currency:
            self.pos ← self.pos + 1
            // ¤name for a measure the language knows and ¤"name" for
            // one the file defined, the same two spellings a binding
            // takes -- a return type and a field are written the way a
            // parameter is or they are not written the same language
            let uname : mut str = ""
            if self.peek() = tokens.Tk.string:
                uname ← self.toks.strs[self.toks.val[self.pos × 1¤ptrdiff] × 1¤ptrdiff]
                self.pos ← self.pos + 1
            else:
                uname ← self.ttext(self.pos)
                _ ← self.eat_word("the unit's name")
            if not types.ty_is_int(base):
                self.err("only an integer carries a unit")
            else:
                let uix : i64 = self.unit_index(uname)
                if uix ≠ ⁻1:
                    base ← types.ty_with_unit(base, uix)
                else:
                    self.err("'¤" ⧺ uname ⧺ "' is no measure this file knows")
        if self.peek() = tokens.Tk.lbrack:
            self.pos ← self.pos + 1
            if not types.ty_is_int(base) and not types.ty_is_struct(base) and not types.ty_is_enum(base) and base ≠ types.TY_CHAR and base ≠ types.TY_STR and base ≠ types.TY_BOOL and base ≠ types.TY_IOVEC:
                self.err("""a core-2 array holds plain integers, truth values, characters, strings
                          " or structs""")
                return types.TY_I64
            let d0 : mut i64 = ⁻1
            if self.peek() = tokens.Tk.number:
                // T[n]: the size is part of the type
                if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                    self.err("a sized array states its size as a plain number")
                    return types.TY_I64
                d0 ← self.toks.val[self.pos × 1¤ptrdiff]
                self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.comma:
                // T[,] and its sized kin: a matrix, its rows one type
                self.pos ← self.pos + 1
                if types.ty_is_struct(base):
                    self.err("""a core-2 matrix holds plain integers, truth values, characters or
                              " strings""")
                    return types.TY_I64
                let d1 : mut i64 = ⁻1
                if self.peek() = tokens.Tk.number:
                    if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                        self.err("a matrix states its extents as plain numbers")
                        return types.TY_I64
                    d1 ← self.toks.val[self.pos × 1¤ptrdiff]
                    self.pos ← self.pos + 1
                let d2 : mut i64 = ⁻2
                if self.peek() = tokens.Tk.comma:
                    // T[,,]: a cube, its planes one matrix type
                    self.pos ← self.pos + 1
                    d2 ← ⁻1
                    if self.peek() = tokens.Tk.number:
                        if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                            self.err("a matrix states its extents as plain numbers")
                            return types.TY_I64
                        d2 ← self.toks.val[self.pos × 1¤ptrdiff]
                        self.pos ← self.pos + 1
                    if self.peek() = tokens.Tk.comma:
                        self.err("a rank-4 array is not core-2 yet")
                        return types.TY_I64
                _ ← self.eat(tokens.Tk.rbrack, "']' closing the matrix type")
                if d0 = 0 or d1 = 0 or d2 = 0:
                    self.err("a matrix has at least one row and one column")
                    return types.TY_I64
                base ← types.mk_mty(self.mat_intern(base, d0, d1, d2))
            elif d0 ≠ ⁻1:
                _ ← self.eat(tokens.Tk.rbrack, "']' closing the sized array type")
                base ← types.mk_fty(self.farr_intern(base, d0))
            else:
                _ ← self.eat(tokens.Tk.rbrack, "']' closing the array type")
                base ← types.mk_aty(base)
        if self.peek() = tokens.Tk.qmark or self.peek() = tokens.Tk.bang:
            // T? and T!: the expected rides the optional's box; what an
            // error carries beyond absence is not core-2 yet
            self.pos ← self.pos + 1
            if types.ty_is_mat(base):
                self.err("an optional matrix is not core-2 yet")
                return types.TY_I64
            if types.ty_is_arr(base):
                self.err("an optional array is not core-2 yet")
                return types.TY_I64
            if types.ty_is_hash(base):
                self.err("an optional dictionary is not core-2 yet")
                return types.TY_I64
            base ← types.mk_oty(base)
        if refk ≠ 0 and not types.ty_is_arr(base) and not types.ty_is_struct(base) and not types.ty_is_hash(base):
            self.err("core-2 borrows arrays, structs and dictionaries; a scalar travels by value")
            return types.TY_I64
        base + 262144 × refk

    // a tuple shape is interned so equal shapes share one type code,
    // and type equality stays one integer comparison
    fn tup_intern(&mut self, es : i64[]) → i64:
        // stored into ttl beside plain numbers, and handed back as a
        // plain type code, so the measure comes off at the declaration
        let n : i64 = @dropunit(#es)
        let at : i64 = @dropunit(#self.tts)
        foreach sh := 0¤ptrdiff…#self.tts:
            if self.ttl[sh] = n:
                let st : i64 = self.tts[sh]
                let same : mut bool = true
                foreach i := 0…n:
                    same ← same and self.tte[(st + i) × 1¤ptrdiff] = es[i × 1¤ptrdiff]
                if same:
                    return @dropunit(sh)
        self.tts.push(@dropunit(#self.tte))
        self.ttl.push(n)
        foreach e := es:
            self.tte.push(e)
        at

    fn farr_intern(&mut self, elem : i64, size : i64) → i64:
        // handed back as a plain type code, so the measure comes off
        // at the declaration rather than at the answer
        let at : i64 = @dropunit(#self.fae)
        foreach i := 0¤ptrdiff…#self.fae:
            if self.fae[i] = elem and self.fas[i] = size:
                return @dropunit(i)
        self.fae.push(elem)
        self.fas.push(size)
        at

    // u8[W] for every algorithm there is, so a digest's type is there
    // whichever one a program asks for
    fn intern_digest_types(&mut self):
        if #self.hdty > 0:
            return
        foreach w := ast.hash_digest_bytes():
            self.hdty.push(types.mk_fty(self.farr_intern(types.TY_U8, w)))

    // equal lambda signatures share one type code, as tuple shapes do
    // A lambda that threads and one that does not are not one type:
    // handed the same argument they do different things, so the flag
    // is part of the shape and not a note beside it.
    fn lam_intern(&mut self, pts : i64[], ret : i64, lstb : i64) → i64:
        // stored into ltl, which holds plain numbers beside this one,
        // so the measure comes off here rather than at every use
        let n : i64 = @dropunit(#pts)
        let at : i64 = @dropunit(#self.ltl)
        foreach sh := 0¤ptrdiff…#self.ltl:
            if self.ltl[sh] = n and self.ltf[sh] = lstb:
                let st : i64 = self.lts[sh]
                let same : mut bool = self.lte[(st + n) × 1¤ptrdiff] = ret
                foreach i := 0…n:
                    same ← same and self.lte[(st + i) × 1¤ptrdiff] = pts[i × 1¤ptrdiff]
                if same:
                    return @dropunit(sh)
        self.lts.push(@dropunit(#self.lte))
        self.ltl.push(n)
        self.ltf.push(lstb)
        foreach pt := pts:
            self.lte.push(pt)
        self.lte.push(ret)
        at

    // equal matrix shapes share one type code, as tuple shapes do
    fn mat_intern(&mut self, elem : i64, r : i64, c : i64, d : i64) → i64:
        // handed back as a plain type code, as the other interns are
        foreach i := 0¤ptrdiff…#self.mel:
            if self.mel[i] = elem and self.mrr[i] = r and self.mcc[i] = c and self.mdd[i] = d:
                return @dropunit(i)
        // What one subscript answers is settled here, where a shape may
        // still be interned, so that reading it later -- from a &self
        // that cannot intern -- is a plain lookup.
        let inner : mut i64 = types.mk_rty(elem)
        if d ≠ ⁻2:
            inner ← types.mk_mty(self.mat_intern(elem, c, d, ⁻2))
        // interning the plane may have grown the table, so where this
        // shape lands is asked again and not remembered from the scan
        let at : i64 = @dropunit(#self.mel)
        self.mel.push(elem)
        self.mrr.push(r)
        self.mcc.push(c)
        self.mdd.push(d)
        self.minner.push(inner)
        assert(#self.mel = #self.minner and #self.mel = #self.mdd, "shape table arrays in step")
        at

    // the pre-scanned struct names answer for a name TYNAMES does not
    // A type name written in a module: its own first, since what it
    // did not bind is not its to name, and then the plain name, which
    // is the root module's and the builtins'.  A program that binds no
    // import has no module to try and asks once, as it always did.
    // where an enum's whole name stands in the table, or ⁻1
    fn enum_slot(&self, whole : str) → i64:
        foreach i := 0¤ptrdiff…#self.enames:
            if self.enames[i] = whole:
                return @dropunit(i)
        ⁻1

    fn sindex_here(&self, name : str, at : i64) → i64:
        let m : str = self.mod_at(at)
        if m ≠ "":
            let mine : i64 = self.sindex_ty(m ⧺ "." ⧺ name)
            if mine ≠ ⁻1:
                return mine
            // A bare name written in a module is that module's own or
            // it is nothing: what another module holds is reached
            // through the binding, and the root module's names are the
            // root module's.  A name already carrying a module goes on
            // to be looked up as it is written.
            if not holds_dot(name):
                return ⁻1
        self.sindex_ty(name)

    // The file a module is rooted in, which is how a diagnostic names
    // one: a stem is not something a reader can go and open, and two
    // modules may share one.
    fn mod_file(&self, m : str) → str:
        foreach i := 0¤ptrdiff…#self.mtab.names:
            if self.mtab.names[i] = m:
                return self.mtab.roots[i]
        m

    // A type another module holds is named only where that module said
    // it may be.  Answers nothing and complains where it may not: the
    // name is looked up anyway, so that one refusal is what is read
    // rather than a second about a type that was found all along.
    fn hold_export(&mut self, at : i64, m : str, name : str):
        let whole : str = m ⧺ "." ⧺ name
        let e : i64 = self.enum_slot(whole)
        let ok : mut bool = true
        if e ≠ ⁻1:
            ok ← self.eexp[e × 1¤ptrdiff] = 1
        else:
            let si : mut i64 = ⁻1
            foreach i := 0¤ptrdiff…#self.snames:
                if self.snames[i] = whole:
                    si ← @dropunit(i)
            if si ≠ ⁻1:
                ok ← self.sexp[si × 1¤ptrdiff] = 1
        if not ok:
            self.errc_at(at, 2911, "the module " ⧺ self.mod_file(m) ⧺ " does not let others name '" ⧺ name ⧺ "'; @export says what leaves a module")

    fn sindex_ty(&self, name : str) → i64:
        // from NBUILTIN_ENUMS on: a builtin enum is a value under std,
        // not a type a program may write down, which is how the
        // interpreter has it
        if @dropunit(#self.enames) > types.NBUILTIN_ENUMS:
            foreach i := types.NBUILTIN_ENUMS × 1¤ptrdiff…#self.enames:
                if self.enames[i] = name:
                    return types.mk_ety(@dropunit(i))
        // a name standing for a type answers what it stands for
        if #self.tanames > 0:
            foreach i := 0…#self.tanames:
                if self.tanames[i] = name:
                    return self.tatypes[i]
        if #self.snames > 0:
            foreach i := 0…#self.snames:
                if self.snames[i] = name:
                    return types.mk_sty(@dropunit(i))
        ⁻1

    // the ¤unit that may follow a binding's or parameter's name
    fn unit_index(&self, name : str) → i64:
        foreach i := 1…#self.unames:
            if self.unames[i] = name:
                return @dropunit(i)
        ⁻1

    // A measure written before the type measures what an array holds,
    // the way it measures a bare number: `xs : i64 ¤meter[]` is an
    // array of lengths and not an array that is itself a length.  A
    // binding, a parameter and a field all write it the same way, so
    // they all settle it here.  `what` names the thing for the
    // complaint, since a field's reads better than a binding's.
    fn unit_on_type(&mut self, ty : i64, u : i64, what : str) → i64:
        if types.ty_is_arr(ty) and not types.ty_is_farr(ty) and types.ty_is_int(types.ty_elem(ty)):
            if types.ty_unit(types.ty_elem(ty)) ≠ 0 and types.ty_unit(types.ty_elem(ty)) ≠ u:
                self.err("the name and the type say different units")
                return ty
            return types.mk_aty(types.ty_with_unit(types.ty_elem(ty), u))
        if not types.ty_is_int(ty):
            self.err("only an integer" ⧺ what ⧺ " carries a unit")
            return ty
        if types.ty_unit(ty) ≠ 0 and types.ty_unit(ty) ≠ u:
            self.err("the name and the type say different units")
            return ty
        types.ty_with_unit(ty, u)

    fn parse_name_unit(&mut self) → i64:
        if self.peek() ≠ tokens.Tk.currency:
            return types.UNIT_NONE
        self.pos ← self.pos + 1
        // ¤name for one the language knows, ¤"name" for one the file
        // defined, as the specification writes them
        let uname : mut str = ""
        if self.peek() = tokens.Tk.string:
            uname ← self.toks.strs[self.toks.val[self.pos × 1¤ptrdiff] × 1¤ptrdiff]
            self.pos ← self.pos + 1
        else:
            uname ← self.ttext(self.pos)
            _ ← self.eat_word("the unit's name")
        let u : i64 = self.unit_index(uname)
        if u ≠ ⁻1:
            return u
        self.err("'¤" ⧺ uname ⧺ "' is no measure this file knows")
        types.UNIT_NONE

    // ------------------------------------------------------------------
    // Expressions, by precedence climbing
    // ------------------------------------------------------------------

    fn parse_args(&mut self) → i64:
        _ ← self.eat(tokens.Tk.lpar, "'('")
        let args : mut i64[] = []
        if self.peek() ≠ tokens.Tk.rpar:
            while true:
                if self.peek() = tokens.Tk.band:
                    // &x hands the callee the array itself; whether it
                    // may write is the parameter's declaration
                    let at : i64 = self.pos
                    self.pos ← self.pos + 1
                    if self.peek() = tokens.Tk.kw_mut:
                        self.err("""a borrow at a call is written &name; &mut is the parameter's
                                  " side""")
                        return ⁻1
                    let vtok : i64 = self.pos
                    _ ← self.eat_name("the borrowed name")
                    let v : i64 = self.mknode(ast.Nk.var, vtok, 0, 0, 0)
                    args.push(self.mknode(ast.Nk.ref, at, v, 1, 0))
                else:
                    args.push(self.parse_expr())
                if self.failed(): return ⁻1
                if self.peek() = tokens.Tk.comma:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(tokens.Tk.rpar, "')' after the arguments")
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#args))
        foreach a := args:
            self.extra.push(a)
        off

    // postfix: indexing and method calls chain off a primary
    // λx : T, y : T |cap| → R: expr — the captures are read where the
    // lambda is written, by value, and the body is one expression
    fn parse_lambda(&mut self, at : i64, lstb : i64) → i64:
        self.pos ← self.pos + 1
        // shapes an @expect means to refuse still have to parse; the
        // checker is where they are refused, so 'bad' rides along
        let bad : mut i64 = 0
        let ptoks : mut i64[] = []
        let pts : mut i64[] = []
        while true:
            let ptok : i64 = self.pos
            _ ← self.eat_name("the parameter's name")
            if self.peek() ≠ tokens.Tk.colon:
                bad ← 2
                ptoks.push(ptok)
                pts.push(types.TY_I64)
            else:
                self.pos ← self.pos + 1
                // The measure is written against the type, as a return
                // type writes its own, and parse_type reads it there.
                // What a walk over a measured range hands the question
                // arrives measured, and the question says what it is
                // measured in.
                let pt : i64 = self.parse_type(false)
                if not (types.ty_is_int(pt) or pt = types.TY_BOOL or pt = types.TY_CHAR or pt = types.TY_STR):
                    self.err("a core-2 lambda takes integers, truth values, characters and strings")
                    return self.mknode(ast.Nk.lit_int, at, 0, 0, 0)
                ptoks.push(ptok)
                pts.push(pt)
            if self.failed():
                return self.mknode(ast.Nk.lit_int, at, 0, 0, 0)
            if self.peek() = tokens.Tk.comma:
                self.pos ← self.pos + 1
            else:
                break
        if #pts > 5:
            self.err("a core-2 lambda takes at most five parameters")
            return self.mknode(ast.Nk.lit_int, at, 0, 0, 0)
        let caps : mut i64[] = []
        if self.peek() = tokens.Tk.bor:
            self.pos ← self.pos + 1
            while self.peek() ≠ tokens.Tk.bor and not self.failed():
                let ctok : i64 = self.pos
                _ ← self.eat_name("the captured name")
                caps.push(ctok)
                if self.peek() = tokens.Tk.comma:
                    self.pos ← self.pos + 1
            _ ← self.eat(tokens.Tk.bor, "'|' closing the capture list")
            if #caps = 0 and bad = 0:
                bad ← 1
        let ret : mut i64 = types.TY_UNIT
        if self.peek() ≠ tokens.Tk.arrow:
            if bad = 0:
                bad ← 3
            ret ← types.TY_I64
        else:
            self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.empty:
                // parsed so an @expect may hold it; the checker refuses it
                self.pos ← self.pos + 1
            else:
                ret ← self.parse_type(false)
                let rb : i64 = if types.ty_is_opt(ret): types.ty_opt_base(ret) else: ret
                if not ((types.ty_is_int(rb) and types.ty_unit(rb) = 0) or rb = types.TY_BOOL or rb = types.TY_CHAR or rb = types.TY_STR):
                    self.err("""a core-2 lambda answers a plain integer, a truth value, a character
                              " or a string""")
                    return self.mknode(ast.Nk.lit_int, at, 0, 0, 0)
        let body : mut i64 = ⁻1
        if self.peek() = tokens.Tk.lbrace:
            // written in braces, as any other block may be
            body ← self.parse_brace_block()
        elif self.peek() = tokens.Tk.colon and self.peek2() = tokens.Tk.nl:
            // a layout block, statement by statement, as a function's
            body ← self.parse_block()
        elif self.peek() = tokens.Tk.colon and self.peek2() = tokens.Tk.lbrace:
            self.err(both_openers())
            return self.mknode(ast.Nk.lit_int, at, 0, 0, 0)
        else:
            _ ← self.eat(tokens.Tk.colon, "':' or '{' and the lambda's body")
            body ← self.parse_expr()
        if bad ≠ 0:
            return self.mknode(ast.Nk.badlam, at, bad, 0, 0)
        let li : i64 = self.lam_intern(pts, ret, lstb)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#pts))
        foreach i := 0…#pts:
            self.extra.push(ptoks[i])
            self.extra.push(pts[i])
        self.extra.push(@dropunit(#caps))
        if #caps > 0:
            foreach i := 0…#caps:
                self.extra.push(caps[i])
        self.extra.push(ret)
        self.mknode(ast.Nk.lambda, at, off, body, li)

    // { s; s; e }: the braces hold statements where layout cannot go,
    // inside parentheses; ';' separates them and the last is the value
    fn parse_brace_block(&mut self) → i64:
        _ ← self.eat(tokens.Tk.lbrace, "'{' opening the block")
        self.braces ← self.braces + 1
        let stmts : mut i64[] = []
        while self.peek() ≠ tokens.Tk.rbrace and not self.failed():
            stmts.push(self.parse_stmt())
            // A statement that is itself a block -- an if, a while, a
            // walk -- ends at its own '}' and has no terminator of its
            // own to eat, where a plain one has already eaten the ';'
            // in end_stmt.  So the separator is taken here if it is
            // still there, which serves both.
            if self.peek() = tokens.Tk.semi:
                self.pos ← self.pos + 1
        self.braces ← self.braces - 1
        _ ← self.eat(tokens.Tk.rbrace, "'}' closing the block")
        let off : i64 = @dropunit(self.push_list(stmts))
        self.mknode(ast.Nk.block, 0, off, 0, 0)

    fn parse_postfix(&mut self, base0 : i64) → i64:
        let e : mut i64 = base0
        while not self.failed():
            if self.peek() = tokens.Tk.lbrack:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let idx : i64 = self.parse_expr()
                if self.nkind[idx × 1¤ptrdiff] = ast.Nk.rangev:
                    // v[a…b]: both ends included, a fresh array answers
                    if self.nc[idx × 1¤ptrdiff] ≠ ⁻1:
                        self.err("a stepped slice is not core-2 yet")
                        return e
                    if self.peek() = tokens.Tk.comma:
                        // m[rows, cols] and m[rows, i]: a range of rows
                        // cut down the other way.  Neither can hand back
                        // rows the matrix already holds, so both build
                        // what they answer.
                        self.pos ← self.pos + 1
                        let cidx : i64 = self.parse_expr()
                        if self.peek() = tokens.Tk.comma:
                            self.err("a rank-3 subscript is not core-2 yet")
                            return e
                        _ ← self.eat(tokens.Tk.rbrack, "']' closing the subscript")
                        let moff : i64 = @dropunit(#self.extra)
                        self.extra.push(self.na[idx × 1¤ptrdiff])
                        self.extra.push(self.nb[idx × 1¤ptrdiff])
                        if self.nkind[cidx × 1¤ptrdiff] = ast.Nk.rangev:
                            if self.nc[cidx × 1¤ptrdiff] ≠ ⁻1:
                                self.err("a stepped slice is not core-2 yet")
                                return e
                            self.extra.push(self.na[cidx × 1¤ptrdiff])
                            self.extra.push(self.nb[cidx × 1¤ptrdiff])
                            e ← self.mknode(ast.Nk.mslice, at, e, moff, 0)
                        else:
                            // one column: an element from each row, so
                            // what answers is an array and not a matrix
                            self.extra.push(cidx)
                            self.extra.push(⁻1)
                            e ← self.mknode(ast.Nk.mslice, at, e, moff, 1)
                        continue
                    _ ← self.eat(tokens.Tk.rbrack, "']' closing the slice")
                    e ← self.mknode(ast.Nk.slice, at, e, self.na[idx × 1¤ptrdiff], self.nb[idx × 1¤ptrdiff])
                elif self.peek() = tokens.Tk.comma:
                    // m[i, j] and m[i, a…b] reach the row and ask it,
                    // so the pair is the chain m[i][j] written short
                    self.pos ← self.pos + 1
                    e ← self.mknode(ast.Nk.index, at, e, idx, 0)
                    let jdx : i64 = self.parse_expr()
                    if self.peek() = tokens.Tk.comma and self.nkind[jdx × 1¤ptrdiff] ≠ ast.Nk.rangev:
                        // c[i, j, k]: one step further in, one more link
                        self.pos ← self.pos + 1
                        e ← self.mknode(ast.Nk.index, at, e, jdx, 0)
                        let kdx : i64 = self.parse_expr()
                        if self.peek() = tokens.Tk.comma:
                            self.err("a rank-4 subscript is not core-2 yet")
                            return e
                        if self.nkind[kdx × 1¤ptrdiff] = ast.Nk.rangev:
                            if self.nc[kdx × 1¤ptrdiff] ≠ ⁻1:
                                self.err("a stepped slice is not core-2 yet")
                                return e
                            _ ← self.eat(tokens.Tk.rbrack, "']' closing the slice")
                            e ← self.mknode(ast.Nk.slice, at, e, self.na[kdx × 1¤ptrdiff], self.nb[kdx × 1¤ptrdiff])
                        else:
                            _ ← self.eat(tokens.Tk.rbrack, "']' closing the subscript")
                            e ← self.mknode(ast.Nk.index, at, e, kdx, 0)
                        continue
                    if self.peek() = tokens.Tk.comma:
                        self.err("a rank-3 subscript is not core-2 yet")
                        return e
                    if self.nkind[jdx × 1¤ptrdiff] = ast.Nk.rangev:
                        if self.nc[jdx × 1¤ptrdiff] ≠ ⁻1:
                            self.err("a stepped slice is not core-2 yet")
                            return e
                        _ ← self.eat(tokens.Tk.rbrack, "']' closing the slice")
                        e ← self.mknode(ast.Nk.slice, at, e, self.na[jdx × 1¤ptrdiff], self.nb[jdx × 1¤ptrdiff])
                    else:
                        _ ← self.eat(tokens.Tk.rbrack, "']' closing the subscript")
                        e ← self.mknode(ast.Nk.index, at, e, jdx, 0)
                else:
                    _ ← self.eat(tokens.Tk.rbrack, "']' closing the subscript")
                    e ← self.mknode(ast.Nk.index, at, e, idx, 0)
            elif self.peek() = tokens.Tk.lpar:
                // (…) after a value: the value is applied
                let at : i64 = self.pos
                let coff : i64 = self.parse_args()
                e ← self.mknode(ast.Nk.callv, at, e, coff, 0)
            elif self.peek() = tokens.Tk.qmark:
                // e?: absence answers the function early
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                e ← self.mknode(ast.Nk.try, at, e, 0, 0)
            elif self.peek() = tokens.Tk.dot:
                self.pos ← self.pos + 1
                let mtok : i64 = self.pos
                _ ← self.eat_word("the member's name")
                if self.peek() = tokens.Tk.lpar:
                    let off : i64 = self.parse_args()
                    e ← self.mknode(ast.Nk.mcall, mtok, e, off, 0)
                else:
                    e ← self.mknode(ast.Nk.field, mtok, e, 0, 0)
            else:
                break
        e

    fn parse_primary(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = tokens.Tk.lambda:
            return self.parse_lambda(at, 0)
        if k = tokens.Tk.number:
            self.pos ← self.pos + 1
            // A measure the file declared reaches the literal here
            // rather than in the lexer, which settled the built-in ones
            // and left this one as a ¤ and a name of its own.
            let big0 : i64 = self.toks.big[at × 1¤ptrdiff]
            let big : mut i64 = big0
            if self.peek() = tokens.Tk.currency:
                let u : i64 = self.parse_name_unit()
                let st : i64 = big0 » 1
                if not types.ty_is_int(if st ≠ 0: st else: types.TY_I64):
                    self.err("only an integer carries a unit")
                else:
                    big ← (big0 & 1) + types.ty_with_unit(if st ≠ 0: st else: types.TY_I64, u) × 2
            let lit : i64 = self.mknode(ast.Nk.lit_int, at, self.toks.val[at × 1¤ptrdiff],
                                        big, 0)
            // 'a'.ord() reads on; a number's method wants parentheses,
            // as the bootstrap has it
            if big » 1 = types.TY_CHAR:
                return self.parse_postfix(lit)
            return lit
        if k = tokens.Tk.kw_true or k = tokens.Tk.kw_false:
            self.pos ← self.pos + 1
            return self.mknode(ast.Nk.lit_bool, at, if k = tokens.Tk.kw_true: 1 else: 0, 0, 0)
        if k = tokens.Tk.string:
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(ast.Nk.lit_str, at, self.toks.val[at × 1¤ptrdiff], 0, 0))
        if k = tokens.Tk.neg:
            self.pos ← self.pos + 1
            // ⁻ against a literal is part of it, as the language says
            if self.peek() = tokens.Tk.number:
                let vt : i64 = self.pos
                self.pos ← self.pos + 1
                if self.toks.big[vt × 1¤ptrdiff] & 1 = 1:
                    self.err("the literal is past i64; ⁻ has nothing to negate")
                    return 0
                if self.toks.big[vt × 1¤ptrdiff] » 1 = types.TY_CHAR:
                    self.err("⁻ negates a number, not a character")
                    return 0
                // the refusal above keeps the value inside i64, so
                // nothing wraps today; the annotation is what makes
                // that still true if ⁻9223372036854775808 is ever
                // admitted, which is the one value that would
                return self.mknode(ast.Nk.lit_int, vt,
                                   @wrap(0 - self.toks.val[vt × 1¤ptrdiff]),
                                   self.toks.big[vt × 1¤ptrdiff], 0)
            let e : i64 = self.parse_unary_operand()
            return self.mknode(ast.Nk.neg, at, e, 0, 0)
        if k = tokens.Tk.bnot:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(ast.Nk.bnot, at, e, 0, 0)
        if k = tokens.Tk.kw_not or k = tokens.Tk.lnot:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(ast.Nk.op_not, at, e, 0, 0)
        if k = tokens.Tk.kw_some:
            self.pos ← self.pos + 1
            _ ← self.eat(tokens.Tk.lpar, "'(' after ⊨")
            let e : i64 = self.parse_expr()
            _ ← self.eat(tokens.Tk.rpar, "')' closing ⊨")
            return self.mknode(ast.Nk.op_some, at, e, 0, 0)
        if k = tokens.Tk.empty:
            self.pos ← self.pos + 1
            return self.mknode(ast.Nk.emptyv, at, 0, 0, 0)
        if k = tokens.Tk.lhash:
            self.pos ← self.pos + 1
            let items : mut i64[] = []
            if self.peek() ≠ tokens.Tk.rhash:
                while true:
                    items.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() ≠ tokens.Tk.colon:
                        self.err("a set is not core-2 yet; a dictionary writes key: value")
                        return 0
                    self.pos ← self.pos + 1
                    items.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = tokens.Tk.comma:
                        self.pos ← self.pos + 1
                    else:
                        break
            _ ← self.eat(tokens.Tk.rhash, "'⸩' closing the dictionary literal")
            let off : i64 = @dropunit(#self.extra)
            self.extra.push((@dropunit(#items) ÷ 2) ?? 0)
            foreach it := items:
                self.extra.push(it)
            return self.mknode(ast.Nk.hlit, at, off, 0, 0)
        if k = tokens.Tk.hash:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(ast.Nk.len, at, e, 0, 0)
        if k = tokens.Tk.lpar:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_expr()
            if self.peek() = tokens.Tk.comma:
                // (a, b, …): a tuple literal
                let elems : mut i64[] = [e]
                while self.peek() = tokens.Tk.comma:
                    self.pos ← self.pos + 1
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                _ ← self.eat(tokens.Tk.rpar, "')' closing the tuple")
                let toff : i64 = @dropunit(self.push_list(elems))
                return self.mknode(ast.Nk.tuple, at, toff, 0, 0)
            _ ← self.eat(tokens.Tk.rpar, "')' closing the parenthesis")
            return self.parse_postfix(e)
        if k = tokens.Tk.lbrack:
            self.pos ← self.pos + 1
            let elems : mut i64[] = []
            if self.peek() ≠ tokens.Tk.rbrack:
                while true:
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = tokens.Tk.comma:
                        self.pos ← self.pos + 1
                        if self.peek() = tokens.Tk.rbrack:
                            break
                    else:
                        break
            _ ← self.eat(tokens.Tk.rbrack, "']' closing the array literal")
            let off : i64 = @dropunit(self.push_list(elems))
            return self.mknode(ast.Nk.arrlit, at, off, 0, 0)
        if k = tokens.Tk.at:
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            if name = "typeof":
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.lpar, "'(' after @typeof")
                let te : i64 = self.parse_expr()
                _ ← self.eat(tokens.Tk.rpar, "')' closing @typeof")
                return self.mknode(ast.Nk.typeof, at, te, 0, 0)
            if name = "sizeof":
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.lpar, "'(' after @sizeof")
                let se : i64 = self.parse_expr()
                _ ← self.eat(tokens.Tk.rpar, "')' closing @sizeof")
                return self.mknode(ast.Nk.sizeof, at, se, 0, 0)
            if name = "dropunit":
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.lpar, "'(' after @dropunit")
                let e0 : i64 = self.parse_expr()
                _ ← self.eat(tokens.Tk.rpar, "')' closing @dropunit")
                return self.mknode(ast.Nk.dropu, at, e0, 0, 0)
            if name = "old":
                // What a value was when the call began.  Read once,
                // before a statement of the body runs, and only a
                // postcondition is in a position to ask.
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.lpar, "'(' after @old")
                let oe : i64 = self.parse_expr()
                _ ← self.eat(tokens.Tk.rpar, "')' closing @old")
                let on : i64 = self.mknode(ast.Nk.old, at, oe, @dropunit(#self.olds), 0)
                self.olds.push(on)
                return on
            if name = "listable":
                // A lambda is a function like any other and threads the
                // same way; the annotation goes in front of the λ,
                // which is the only place it could go.
                self.pos ← self.pos + 1
                if self.peek() ≠ tokens.Tk.lambda:
                    self.err("""@listable in front of a value marks a lambda as one that threads, so
                              " a λ follows it""")
                    return 0
                return self.parse_lambda(self.pos, 1)
            if name ≠ "wrap":
                self.err("'@" ⧺ name ⧺ """' is not core-2; @wrap, @dropunit, @sizeof, @listable and
                                        " @old are the expression annotations""")
                return 0
            self.pos ← self.pos + 1
            _ ← self.eat(tokens.Tk.lpar, "'(' after @wrap")
            let e : i64 = self.parse_expr()
            _ ← self.eat(tokens.Tk.rpar, "')' closing @wrap")
            return self.mknode(ast.Nk.op_wrap, at, e, 0, 0)
        if k = tokens.Tk.ident:
            let name := self.ttext(at)
            // `m.f(…)` where m is a bound import: the name reaches one
            // module and the call is asked of that one.
            if self.toks.kind[(at + 1) × 1¤ptrdiff] = tokens.Tk.dot:
                let bm : str = self.bound_module(at)
                if bm ≠ "":
                    return self.parse_bound(at, bm)
            if name = "std":
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.dot, "'.' after std")
                let mtok : i64 = self.pos
                let m := self.ttext(mtok)
                _ ← self.eat_word("the std member's name")
                if m = "implementation":
                    return self.parse_implementation(at)
                if m = "args":
                    _ ← self.eat(tokens.Tk.dot, "'.' after std.args")
                    if self.ttext(self.pos) ≠ "all":
                        self.err("'std.args." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; all() is")
                        return 0
                    self.pos ← self.pos + 1
                    let aoff : i64 = self.parse_args()
                    return self.mknode(ast.Nk.scall, at, ast.SB_ARGS, aoff, 0)
                if m = "process":
                    return self.parse_process(at)
                if m = "env":
                    _ ← self.eat(tokens.Tk.dot, "'.' after std.env")
                    let em0 := self.ttext(self.pos)
                    let esb : mut i64 = ⁻1
                    if em0 = "names": esb ← ast.SB_ENVN
                    elif em0 = "get": esb ← ast.SB_ENVG
                    elif em0 = "has": esb ← ast.SB_ENVH
                    else:
                        self.err("'std.env." ⧺ em0 ⧺ """' is not core-2; names(), get() and has()
                                                      " are""")
                        return 0
                    self.pos ← self.pos + 1
                    let eoff : i64 = self.parse_args()
                    return self.mknode(ast.Nk.scall, at, esb, eoff, 0)
                if m = "Build":
                    // std.Build.Executable{…}: the one struct the build
                    // system defines rather than the program.  Its
                    // fields are read as any struct literal's are, and
                    // nb is how the node says which it is.
                    _ ← self.eat(tokens.Tk.dot, "'.' after std.Build")
                    let bt := self.ttext(self.pos)
                    if bt ≠ "Executable":
                        self.err("'std.Build." ⧺ bt ⧺ """' is not a type the build system defines;
                                  " std.Build.Executable is""")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(tokens.Tk.lbrace, "'{' after std.Build.Executable")
                    let bitems : mut i64[] = []
                    if self.peek() ≠ tokens.Tk.rbrace:
                        while true:
                            bitems.push(self.pos)
                            _ ← self.eat_name("a field's name")
                            _ ← self.eat(tokens.Tk.colon, "':' after the field's name")
                            bitems.push(self.parse_expr())
                            if self.failed(): return 0
                            if self.peek() = tokens.Tk.comma:
                                self.pos ← self.pos + 1
                            else:
                                break
                    _ ← self.eat(tokens.Tk.rbrace, "'}' closing std.Build.Executable")
                    let boff : i64 = @dropunit(#self.extra)
                    self.extra.push(@dropunit(#bitems) ÷ 2 ?? 0)
                    foreach it := bitems:
                        self.extra.push(it)
                    return self.mknode(ast.Nk.slit, at, boff, ast.SLIT_EXE, 0)
                if m = "arena":
                    _ ← self.eat(tokens.Tk.dot, "'.' after std.arena")
                    if self.ttext(self.pos) ≠ "allocator":
                        self.err("'std.arena." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; allocator() is")
                        return 0
                    self.pos ← self.pos + 1
                    let loff : i64 = self.parse_args()
                    return self.mknode(ast.Nk.scall, at, ast.SB_ALLOCATOR, loff, 0)
                if m = "fs":
                    _ ← self.eat(tokens.Tk.dot, "'.' after std.fs")
                    if self.ttext(self.pos) ≠ "cwd":
                        self.err("'std.fs." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; cwd() is")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(tokens.Tk.lpar, "'(' after cwd")
                    _ ← self.eat(tokens.Tk.rpar, "')' after cwd(")
                    if self.peek() ≠ tokens.Tk.dot:
                        // the directory itself, a value to iterate
                        let coff0 : i64 = @dropunit(#self.extra)
                        self.extra.push(0)
                        return self.mknode(ast.Nk.scall, at, ast.SB_CWD, coff0, 0)
                    _ ← self.eat(tokens.Tk.dot, "'.' and what cwd() is asked")
                    let fm := self.ttext(self.pos)
                    self.pos ← self.pos + 1
                    if fm = "open_file":
                        let ooff : i64 = self.parse_args()
                        return self.mknode(ast.Nk.scall, at, ast.SB_OPEN, ooff, 0)
                    if fm = "create_file":
                        let coff : i64 = self.parse_args()
                        return self.mknode(ast.Nk.scall, at, ast.SB_CREATE, coff, 0)
                    self.err("'" ⧺ fm ⧺ "' is not core-2; cwd() answers open_file and create_file")
                    return 0
                if m = "filetype":
                    _ ← self.eat(tokens.Tk.dot, "'.' after std.filetype")
                    let fname := self.ttext(self.pos)
                    self.pos ← self.pos + 1
                    // the enumerator's own value, from the builtin
                    // enum the file already holds
                    let st9 : i64 = self.estart[types.EI_FILETYPE × 1¤ptrdiff]
                    let n9 : i64 = self.ecount[types.EI_FILETYPE × 1¤ptrdiff]
                    let fv : mut i64 = ⁻1
                    foreach k9 := 0…n9:
                        if self.emembers[(st9 + k9) × 1¤ptrdiff] = fname:
                            fv ← self.evalues[(st9 + k9) × 1¤ptrdiff]
                    if fv = ⁻1:
                        self.err("'std.filetype." ⧺ fname ⧺ "' names no kind of file")
                        return 0
                    // an enumerator is a value like any other, so what
                    // may follow one may follow this: .ord() above all
                    return self.parse_postfix(self.mknode(ast.Nk.lit_int, at, fv, types.mk_ety(types.EI_FILETYPE) × 2, 0))
                if m = "bytes":
                    let boff : i64 = self.parse_args()
                    return self.mknode(ast.Nk.scall, at, ast.SB_BYTES, boff, 0)
                if m = "iov":
                    let ioff : i64 = self.parse_args()
                    return self.mknode(ast.Nk.scall, at, ast.SB_IOV, ioff, 0)
                if m = "hash":
                    // std.hash.<alg>.<member>: the algorithm names a
                    // namespace, so another algorithm is another
                    // namespace beside this one rather than two more
                    // names inside std.hash
                    _ ← self.eat(tokens.Tk.dot, "'.' and which algorithm")
                    let aname := self.ttext(self.pos)
                    let algs := ast.hash_algs()
                    let alg : mut i64 = ⁻1
                    foreach k := 0…#algs:
                        if algs[k] = aname:
                            alg ← @dropunit(k)
                    if alg = ⁻1:
                        self.err("'std.hash." ⧺ aname ⧺ "' names no algorithm; " ⧺ ast.hash_algs_named() ⧺ " does")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(tokens.Tk.dot, "'.' and what the algorithm is asked")
                    let hm := self.ttext(self.pos)
                    let hsb : mut i64 = ⁻1
                    if hm = "digest": hsb ← ast.SB_HDIGEST
                    elif hm = "start": hsb ← ast.SB_HSTART
                    else:
                        self.err("'std.hash." ⧺ aname ⧺ "." ⧺ hm ⧺ """' is not core-2; digest()
                                " answers the digest of a message in hand and start() a handle to
                                " feed one that is not""")
                        return 0
                    self.pos ← self.pos + 1
                    // What a digest is: a fixed count of bytes, which
                    // is part of the type it answers.  The shape is
                    // interned here because interning is the parser's,
                    // and the checker only reads what it finds.
                    self.intern_digest_types()
                    let hoff : i64 = self.parse_args()
                    return self.mknode(ast.Nk.scall, at, hsb, hoff, alg)
                let sb : mut i64 = ⁻1
                if m = "println": sb ← ast.SB_PRINTLN
                elif m = "print": sb ← ast.SB_PRINT
                elif m = "exit": sb ← ast.SB_EXIT
                else:
                    self.err("'std." ⧺ m ⧺ """' is not core-2; println, print, exit, args, env,
                                            " process, fs, arena, bytes, iov, hash, build and
                                            " implementation are""")
                    return 0
                let off : i64 = self.parse_args()
                return self.mknode(ast.Nk.scall, at, sb, off, 0)
            if self.peek2() = tokens.Tk.lpar:
                self.pos ← self.pos + 1
                let off : i64 = self.parse_args()
                return self.parse_postfix(self.mknode(ast.Nk.call, at, off, 0, 0))
            if self.peek2() = tokens.Tk.lbrace and self.slit_ahead():
                self.pos ← self.pos + 1
                let off : i64 = self.parse_slit_fields()
                if self.failed(): return 0
                return self.parse_postfix(self.mknode(ast.Nk.slit, at, off, ast.SLIT_PLAIN, 0))
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(ast.Nk.var, at, 0, 0, 0))
        if k = tokens.Tk.reserved:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return 0
        self.err("this token begins no core-2 expression")
        0

    fn parse_unary_operand(&mut self) → i64:
        self.parse_primary()

    // std.implementation says which implementation this is; ngplc
    // answers about itself, folded to constants before anything runs,
    // so a comptime check reads them for free
    fn impl_str(&mut self, s : str) → i64:
        if #self.toks.strs > 0:
            foreach i := 0…#self.toks.strs:
                if self.toks.strs[i] = s:
                    return @dropunit(i)
        let idx : i64 = @dropunit(#self.toks.strs)
        self.toks.strs.push(s)
        idx

    // std.process.<member>: what the kernel recorded at exec, read as a
    // member rather than called, since none of it can change
    fn parse_process(&mut self, at : i64) → i64:
        _ ← self.eat(tokens.Tk.dot, "'.' after std.process")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        let idx : mut i64 = ⁻1
        if m = "pagesize": idx ← ast.PROC_PAGESIZE
        elif m = "uid": idx ← ast.PROC_UID
        elif m = "euid": idx ← ast.PROC_EUID
        elif m = "gid": idx ← ast.PROC_GID
        elif m = "egid": idx ← ast.PROC_EGID
        elif m = "secure": idx ← ast.PROC_SECURE
        elif m = "exec_filename": idx ← ast.PROC_EXECFN
        else:
            self.err("'std.process." ⧺ m ⧺ """' is not a member; pagesize, uid, euid, gid, egid,
                                            " secure and exec_filename are""")
            return 0
        self.mknode(ast.Nk.scall, at, ast.SB_PROC, idx, 0)

    fn parse_implementation(&mut self, at : i64) → i64:
        _ ← self.eat(tokens.Tk.dot, "'.' after std.implementation")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        if m = "interpreter":
            return self.mknode(ast.Nk.lit_bool, at, 0, 0, 0)
        if m = "compiled":
            return self.mknode(ast.Nk.lit_bool, at, 1, 0, 0)
        if m = "name":
            return self.mknode(ast.Nk.lit_str, at, self.impl_str("ngplc"), 0, 0)
        if m = "language":
            return self.mknode(ast.Nk.lit_str, at, self.impl_str("core-1"), 0, 0)
        self.err("'std.implementation." ⧺ m ⧺ """' is not a member; name, language, interpreter and
                                               " compiled are""")
        0

    // binding power of a binary operator token; ⁻1 when it is none.
    // The numbers follow the bootstrap parser's ladder.
    fn bin_bp(&self, k : i64) → i64:
        if k = tokens.Tk.kw_or or k = tokens.Tk.coalesce: return 2
        if k = tokens.Tk.kw_and: return 3
        if k = tokens.Tk.lor: return 4
        if k = tokens.Tk.land: return 6
        if k = tokens.Tk.lxor or k = tokens.Tk.lnand or k = tokens.Tk.lnor: return 5
        if k = tokens.Tk.eq or k = tokens.Tk.ne or k = tokens.Tk.lt or k = tokens.Tk.gt or k = tokens.Tk.le or k = tokens.Tk.ge: return 7
        // a relational test between two sequences, where the other
        // relational tests are
        if k = tokens.Tk.prefix or k = tokens.Tk.suffix: return 7
        if k = tokens.Tk.max or k = tokens.Tk.min or k = tokens.Tk.elem or k = tokens.Tk.iota: return 9
        if k = tokens.Tk.shl or k = tokens.Tk.shr: return 10
        if k = tokens.Tk.bor: return 11
        if k = tokens.Tk.bxor: return 12
        if k = tokens.Tk.band: return 13
        if k = tokens.Tk.plus or k = tokens.Tk.minus or k = tokens.Tk.satadd or k = tokens.Tk.satsub: return 14
        if k = tokens.Tk.concat: return 15
        if k = tokens.Tk.mult or k = tokens.Tk.divide or k = tokens.Tk.mod or k = tokens.Tk.satmul: return 16
        if k = tokens.Tk.reshape: return 17
        ⁻1

    fn bin_nk(&self, k : i64) → ast.Nk:
        if k = tokens.Tk.prefix: return ast.Nk.run
        if k = tokens.Tk.suffix: return ast.Nk.run
        if k = tokens.Tk.kw_or: return ast.Nk.op_or
        if k = tokens.Tk.coalesce: return ast.Nk.default
        if k = tokens.Tk.kw_and: return ast.Nk.op_and
        if k = tokens.Tk.lor: return ast.Nk.lor
        if k = tokens.Tk.land: return ast.Nk.land
        if k = tokens.Tk.eq: return ast.Nk.eq
        if k = tokens.Tk.ne: return ast.Nk.ne
        if k = tokens.Tk.lt: return ast.Nk.lt
        if k = tokens.Tk.gt: return ast.Nk.gt
        if k = tokens.Tk.le: return ast.Nk.le
        if k = tokens.Tk.ge: return ast.Nk.ge
        if k = tokens.Tk.max: return ast.Nk.maxop
        if k = tokens.Tk.min: return ast.Nk.minop
        if k = tokens.Tk.elem: return ast.Nk.elemof
        if k = tokens.Tk.iota: return ast.Nk.iota
        if k = tokens.Tk.satadd: return ast.Nk.satadd
        if k = tokens.Tk.satsub: return ast.Nk.satsub
        if k = tokens.Tk.satmul: return ast.Nk.satmul
        if k = tokens.Tk.lxor: return ast.Nk.lxor
        if k = tokens.Tk.lnand: return ast.Nk.lnand
        if k = tokens.Tk.lnor: return ast.Nk.lnor
        if k = tokens.Tk.reshape: return ast.Nk.reshape
        if k = tokens.Tk.shl: return ast.Nk.shl
        if k = tokens.Tk.shr: return ast.Nk.shr
        if k = tokens.Tk.bor: return ast.Nk.bor
        if k = tokens.Tk.bxor: return ast.Nk.bxor
        if k = tokens.Tk.band: return ast.Nk.band
        if k = tokens.Tk.plus: return ast.Nk.add
        if k = tokens.Tk.minus: return ast.Nk.sub
        if k = tokens.Tk.concat: return ast.Nk.ccat
        if k = tokens.Tk.mult: return ast.Nk.mul
        if k = tokens.Tk.divide: return ast.Nk.div
        if k = tokens.Tk.mod: return ast.Nk.mod
        ast.Nk.none

    fn parse_bin(&mut self, min_bp : i64) → i64:
        let lhs : mut i64 = self.parse_primary()
        while not self.failed():
            let k : i64 = self.peek()
            if k = tokens.Tk.ellipsis and min_bp <= 8:
                // a…b, and a…step…b when a second … follows: the range
                // binds tighter than comparison, looser than arithmetic
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(9)
                if self.nkind[lhs × 1¤ptrdiff] = ast.Nk.rangev:
                    if self.nc[lhs × 1¤ptrdiff] ≠ ⁻1:
                        self.err("a range is lo…hi or lo…step…hi; a fourth part names nothing")
                        return lhs
                    // what stood as the end steps aside to be the step
                    lhs ← self.mknode(ast.Nk.rangev, at, self.na[lhs × 1¤ptrdiff], rhs, self.nb[lhs × 1¤ptrdiff])
                else:
                    lhs ← self.mknode(ast.Nk.rangev, at, lhs, rhs, ⁻1)
            elif (k = tokens.Tk.forall or k = tokens.Tk.exists or k = tokens.Tk.notex) and min_bp <= 17:
                // f ∀ v, f ∃ v and f ∄ v.  The right operand is read at
                // the range's level, so `f ∀ 1…5` needs no parentheses
                // and `f ∀ v ⧺ w` asks about the join, while a
                // comparison or a logical operator ends it -- the
                // answer being a bool, `f ∀ v ∧ g ∃ w` is what it looks
                // like.  nc says which question: 0 all, 1 any, 2 none.
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(8)
                let q : i64 = if k = tokens.Tk.exists: 1 else: (if k = tokens.Tk.notex: 2 else: 0)
                lhs ← self.mknode(ast.Nk.quant, at, lhs, rhs, q)
            else:
                let bp : i64 = self.bin_bp(k)
                if bp = ⁻1 or bp < min_bp:
                    break
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(bp + 1)
                lhs ← self.mknode(self.bin_nk(k), at, lhs, rhs, if k = tokens.Tk.suffix: 1 else: 0)
        lhs

    fn parse_expr(&mut self) → i64:
        // An `if` here is the statement form standing where a value is
        // wanted: it takes blocks rather than operands, and its value
        // is the value of whichever block runs.  Nothing else begins
        // an expression with `if`, the statement level having taken
        // its own already, so the two never have to be told apart.
        if self.peek() = tokens.Tk.kw_if:
            let owed : i64 = self.ifexpr
            self.ifexpr ← 1
            let e : i64 = self.parse_if_node()
            self.ifexpr ← owed
            return e
        // A match here is the statement form standing where a value is
        // wanted, as an if is.  Its arms are their own block each, and
        // the value is the value of whichever arm runs.
        if self.peek() = tokens.Tk.kw_match:
            return self.parse_match_node()
        let v : i64 = self.parse_bin(2)
        if self.failed(): return v
        if self.peek() ≠ tokens.Tk.kw_if:
            return v
        // `v if cond else w` was how a value was chosen once.  An if
        // hands back the value of the branch that runs, which says the
        // same thing and says it the one way, so this spelling is gone
        // and what is left of it is the sentence pointing at the other.
        self.err("""`a if c else b` is no longer how a value is chosen; an if hands back the value
                  " of the branch that runs, so this is written `if c: a else: b`""")
        v

    // ------------------------------------------------------------------
    // Statements and blocks
    // ------------------------------------------------------------------

    fn parse_block(&mut self) → i64:
        // A block is written one of two ways and means the same either
        // way: indented after a colon, with a statement to a line, or
        // in braces with ';' between the statements.  Every block goes
        // through here -- a function's body, an if's, a while's, a
        // walk's -- so saying it once says it for all of them.
        //
        // The colon says the block is laid out and the brace says it is
        // delimited, so one or the other opens it and never both.
        if self.peek() = tokens.Tk.lbrace:
            return self.parse_brace_block()
        _ ← self.eat(tokens.Tk.colon, "':' or '{' beginning the block")
        if self.peek() = tokens.Tk.lbrace:
            self.err(both_openers())
            return 0
        let stmts : mut i64[] = []
        if self.peek() ≠ tokens.Tk.nl:
            // The sole statement of a one-line block ends where the
            // block ends, and the block is what is inside braces, not
            // this: `{ if x > 10: return x - 10; y }` puts the ';'
            // after the if, not after the return.  So the terminator
            // is not this statement's to eat, and the count is put by
            // for the length of it.  It is balanced again on the far
            // side, since a brace block inside restores what it took.
            let outer : i64 = self.braces
            let owed : i64 = self.lent
            self.braces ← 0
            // only inside braces: at layout level the statement still
            // ends at the line's end, and an `elif` on the next line
            // is found only once that newline has been eaten
            let inside : i64 = 1
            self.lent ← if outer > 0 or self.ifexpr ≠ 0: inside else: owed
            stmts.push(self.parse_stmt())
            self.braces ← outer
            self.lent ← owed
        else:
            self.pos ← self.pos + 1
            _ ← self.eat(tokens.Tk.indent, "an indented block")
            while self.peek() ≠ tokens.Tk.dedent and self.peek() ≠ tokens.Tk.eof:
                if self.peek() = tokens.Tk.nl:
                    // a statement whose body was in braces ends at its
                    // '}' and leaves the line's end behind it
                    self.pos ← self.pos + 1
                    continue
                stmts.push(self.parse_stmt())
                if self.poisoned:
                    // this statement is lost; the next line starts over
                    _ ← stmts.pop() ?? 0
                    self.sync()
                    if self.peek() = tokens.Tk.indent:
                        // a block hangs off the broken statement;
                        // nothing owns it now, so it is skipped whole
                        self.skip_block()
            _ ← self.eat(tokens.Tk.dedent, "the end of the block")
        let off : i64 = @dropunit(self.push_list(stmts))
        self.mknode(ast.Nk.block, 0, off, 0, 0)

    // step over a balanced INDENT…DEDENT run
    fn skip_block(&mut self):
        let depth : mut i64 = 0
        while self.peek() ≠ tokens.Tk.eof:
            if self.peek() = tokens.Tk.indent:
                depth ← depth + 1
            elif self.peek() = tokens.Tk.dedent:
                depth ← depth - 1
                if depth = 0:
                    self.pos ← self.pos + 1
                    return
            self.pos ← self.pos + 1

    fn end_stmt(&mut self):
        // A brace block inside says its own rule, which is why this
        // comes first; only where none does is the terminator lent.
        if self.braces > 0:
            // inside { }: ';' separates, and '}' closes the last
            if self.peek() = tokens.Tk.semi:
                self.pos ← self.pos + 1
            elif self.peek() ≠ tokens.Tk.rbrace:
                self.err("';' separates the statements of a brace block")
            return
        if self.lent ≠ 0:
            return
        // A ';' ends a statement where a line would have, and is
        // written down: laid out, the semicolon is how a statement says
        // its value is dropped rather than handed back.
        if self.peek() = tokens.Tk.semi:
            self.pos ← self.pos + 1
            self.semi_end ← true
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
            return
        if self.peek() = tokens.Tk.nl:
            self.pos ← self.pos + 1
        elif self.peek() = tokens.Tk.dedent or self.peek() = tokens.Tk.eof:
            let _nothing_to_do : i64 = 0
        elif self.peek() = tokens.Tk.kw_else or self.peek() = tokens.Tk.kw_elif:
            // `if c: a else: b` -- the one statement of a one-line
            // block ends where the next clause begins, and the clause
            // is the if's to take
            let _nothing_to_do : i64 = 0
        elif self.pos > 0 and self.toks.kind[(self.pos - 1) × 1¤ptrdiff] = tokens.Tk.dedent:
            // a lambda's layout body closed the line already
            let _nothing_to_do : i64 = 0
        else:
            self.err("the statement has ended but the line has more on it")

    fn parse_let(&mut self) → i64:
        self.pos ← self.pos + 1
        if self.peek() = tokens.Tk.lpar:
            return self.parse_let_tuple()
        let name_tok : i64 = self.pos
        _ ← self.eat_name("the name the let binds")
        // A measure belongs to the type and is written there.  This
        // is the place it used to be written, kept only to say so.
        if self.peek() = tokens.Tk.currency:
            self.err("""a measure is written against the type, as 'let x : i64 ¤meter = …' -- or
                      " against nothing, as 'let x : ¤meter = …', where the right side says the type""")
            return 0
        let u : i64 = types.UNIT_NONE
        if self.peek() = tokens.Tk.define:
            // := takes the type from the right side, which must state it
            if u ≠ types.UNIT_NONE:
                self.err("a unit measures a stated type; write 'let x : i64 ¤ptrdiff = …'")
                return 0
            self.pos ← self.pos + 1
            let init0 : i64 = self.parse_expr()
            self.end_stmt()
            return self.mknode(ast.Nk.st_let, name_tok, init0, 0, ⁻1)
        _ ← self.eat(tokens.Tk.colon, "':' and the type of the binding")
        let is_mut : mut i64 = 0
        if self.peek() = tokens.Tk.kw_mut:
            is_mut ← 1
            self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.eq:
                // let x : mut = e -- mut, the type still inferred
                if u ≠ types.UNIT_NONE:
                    self.err("a unit measures a stated type; write 'let x : mut i64 ¤ptrdiff = …'")
                    return 0
                self.pos ← self.pos + 1
                let init1 : i64 = self.parse_expr()
                self.end_stmt()
                return self.mknode(ast.Nk.st_let, name_tok, init1, 1, ⁻1)
        // `let m : ¤meter = e` -- the measure with no type, which the
        // right side settles.  A measure belongs to a type, and where
        // the type is the initializer's there is nothing to write it
        // against, so the colon carries the measure alone.  nc holds
        // ⁻2 - u to say so, ⁻1 already meaning no type at all.
        if self.peek() = tokens.Tk.currency:
            if u ≠ types.UNIT_NONE:
                self.err("the name and the type say different units")
                return 0
            let mu : i64 = self.parse_name_unit()
            _ ← self.eat(tokens.Tk.eq, "'=' and the initial value")
            let init2 : i64 = self.parse_expr()
            self.end_stmt()
            return self.mknode(ast.Nk.st_let, name_tok, init2, is_mut, ⁻2 - mu)
        // `let v : &T = …` binds a borrow, and says so
        let is_blet : bool = self.peek() = tokens.Tk.band
        if is_blet:
            self.pos ← self.pos + 1
        let ty0 : i64 = self.parse_type(false)
        let ty : mut i64 = ty0
        if u ≠ types.UNIT_NONE:
            ty ← self.unit_on_type(ty, u, "")
        _ ← self.eat(tokens.Tk.eq, "'=' and the initial value")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        let lid : i64 = self.mknode(ast.Nk.st_let, name_tok, init, is_mut, ty)
        if is_blet:
            self.blets.push(lid)
        lid

    // let (a, b) := f()  or  let (a, b) : mut (i64, str) = …; the
    // names, '_' among them, take a tuple apart
    fn parse_let_tuple(&mut self) → i64:
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let ntoks : mut i64[] = []
        while true:
            ntoks.push(self.pos)
            _ ← self.eat_name("a name the let binds")
            if self.failed():
                return 0
            if self.peek() = tokens.Tk.comma:
                self.pos ← self.pos + 1
            else:
                break
        _ ← self.eat(tokens.Tk.rpar, "')' closing the names")
        if #ntoks < 2:
            self.err("a destructuring let takes at least two names")
            return 0
        let is_mut : mut i64 = 0
        let ty : mut i64 = ⁻1
        if self.peek() = tokens.Tk.colon:
            self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.kw_mut:
                is_mut ← 1
                self.pos ← self.pos + 1
            ty ← self.parse_type(false)
            if not types.ty_is_tup(ty):
                self.err("the names take a tuple apart; the stated type is not a tuple")
                return 0
            _ ← self.eat(tokens.Tk.eq, "'=' and the initial value")
        else:
            _ ← self.eat(tokens.Tk.define, "':=' (or ': (…) =') and the tuple taken apart")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        let toff : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ntoks))
        self.extra.push(ty)
        foreach t2 := ntoks:
            self.extra.push(t2)
        self.mknode(ast.Nk.st_lett, name_tok, init, is_mut, toff)

    // match over an enumeration.  The arms name values of it, one
    // apiece, and `_` stands for the rest; the indent has been taken
    // and the subject read, so this reads arms until the dedent.
    //
    // `at` is the match keyword's own token and not wherever the arms
    // ended: a diagnostic about the match has to point at the match,
    // and after the dedent the position is already past it -- past the
    // end of the file, for the last match in one.
    // match subject: arms -- one shape, whether the match stands as a
    // statement or where a value is wanted.  Which of the two it is is
    // not the parser's question: the node is the same either way and
    // what differs is only whether anything reads the value.
    fn parse_match_node(&mut self) → i64:
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let subject : i64 = self.parse_expr()
        // laid out under a colon, or written in braces, as every other
        // body is; a ';' after an arm is what a line would have said
        let braced : bool = self.peek() = tokens.Tk.lbrace
        if braced:
            _ ← self.eat(tokens.Tk.lbrace, "'{' opening the arms")
        else:
            _ ← self.eat(tokens.Tk.colon, "':' or '{' after the subject")
            if self.peek() = tokens.Tk.lbrace:
                self.err(both_openers())
                return 0
            _ ← self.eat(tokens.Tk.nl, "the arms on their own lines")
            _ ← self.eat(tokens.Tk.indent, "an indented arm list")
        let ender : tokens.Tk = if braced: tokens.Tk.rbrace else: tokens.Tk.dedent
        // An identifier where a pattern goes says this match is
        // over an enumeration: the arms name its values, and there
        // is no ⊨ or ∅ about it.
        let mut_pos : i64 = self.pos
        let is_enum : mut bool = false
        while self.peek() = tokens.Tk.nl:
            self.pos ← self.pos + 1
        if self.peek() = tokens.Tk.ident:
            is_enum ← true
        self.pos ← mut_pos
        if is_enum:
            return self.parse_match_enum(at, subject, ender, braced)
        let some_blk : mut i64 = ⁻1
        let empty_blk : mut i64 = ⁻1
        let bind_tok : mut i64 = ⁻1
        while self.peek() ≠ ender and not self.failed():
            if self.peek() = tokens.Tk.kw_some:
                if some_blk ≠ ⁻1:
                    self.err("match repeats the ⊨ pattern")
                    return 0
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.lpar, "'(' after ⊨")
                bind_tok ← self.pos
                _ ← self.eat_name("the name ⊨ binds")
                _ ← self.eat(tokens.Tk.rpar, "')' closing the pattern")
                some_blk ← self.parse_block()
            elif self.peek() = tokens.Tk.empty:
                if empty_blk ≠ ⁻1:
                    self.err("match repeats the ∅ pattern")
                    return 0
                self.pos ← self.pos + 1
                empty_blk ← self.parse_block()
            elif self.peek() = tokens.Tk.nl or self.peek() = tokens.Tk.semi:
                self.pos ← self.pos + 1
            else:
                self.err("a core-2 match arm is ⊨(name) or ∅")
                return 0
        _ ← self.eat(ender, if braced: "'}' closing the match" else: "the end of the match")
        if some_blk = ⁻1:
            self.err("match has no arm for ⊨")
            return 0
        if empty_blk = ⁻1:
            self.err("match has no arm for ∅")
            return 0
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(some_blk)
        self.extra.push(empty_blk)
        return self.mknode(ast.Nk.st_match, bind_tok, subject, off, 0)
    fn parse_match_enum(&mut self, at : i64, subject : i64, ender : tokens.Tk, braced : bool) → i64:
        let arms : mut i64[] = []
        let default_blk : mut i64 = ⁻1
        while self.peek() ≠ ender and not self.failed():
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
            elif self.peek() = tokens.Tk.ident and self.ttext(self.pos) = "_":
                if default_blk ≠ ⁻1:
                    self.err("match repeats the _ arm")
                    return 0
                self.pos ← self.pos + 1
                default_blk ← self.parse_block()
            elif self.peek() = tokens.Tk.ident:
                // `m.Enum.value` where m is a bound import: which
                // module the enum is of is settled by what is being
                // matched, so the binding is read past here and the
                // arm names the enum as the subject knows it.
                if self.toks.kind[(self.pos + 1) × 1¤ptrdiff] = tokens.Tk.dot and self.toks.kind[(self.pos + 2) × 1¤ptrdiff] = tokens.Tk.ident and self.toks.kind[(self.pos + 3) × 1¤ptrdiff] = tokens.Tk.dot and self.bound_module(self.pos) ≠ "":
                    let bm2 : str = self.bound_module(self.pos)
                    self.hold_export(self.pos + 2, bm2, self.ttext(self.pos + 2))
                    self.pos ← self.pos + 2
                let etok : i64 = self.pos
                self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.dot, "'.' and the value's name")
                let mtok : i64 = self.pos
                _ ← self.eat_name("the value's name")
                let blk : i64 = self.parse_block()
                arms.push(etok)
                arms.push(mtok)
                arms.push(blk)
                if self.peek() = tokens.Tk.semi:
                    self.pos ← self.pos + 1
            else:
                self.err("a match arm over an enumeration is Name.value or _")
                return 0
        _ ← self.eat(ender, if braced: "'}' closing the match" else: "the end of the match")
        if #arms = 0:
            self.err("match over an enumeration wants an arm naming a value of it")
            return 0
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#arms) ÷ 3 ?? 0)
        self.extra.push(default_blk)
        foreach v := arms:
            self.extra.push(v)
        self.mknode(ast.Nk.matche, at, subject, off, ⁻1)

    fn parse_stmt(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = tokens.Tk.at and (self.ttext(self.pos + 1) = "likely" or self.ttext(self.pos + 1) = "unlikely"):
            // @likely and @unlikely say which way a condition is
            // expected to go.  They belong to the if that follows and
            // to nothing else, and they never change what is computed
            // -- only where the compiler puts the code.
            let hname := self.ttext(self.pos + 1)
            self.pos ← self.pos + 2
            while self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.at and (self.ttext(self.pos + 1) = "likely" or self.ttext(self.pos + 1) = "unlikely"):
                let second := self.ttext(self.pos + 1)
                if second = hname:
                    self.err("@" ⧺ hname ⧺ " is given twice on the same condition")
                else:
                    self.err("@" ⧺ second ⧺ " contradicts @" ⧺ hname ⧺ " on the same condition")
                return 0
            if self.peek() ≠ tokens.Tk.kw_if:
                self.err("@" ⧺ hname ⧺ " applies to an if statement, but none follows")
                return 0
            let inner : i64 = self.parse_stmt()
            return self.mknode(ast.Nk.hinted, at, inner, if hname = "unlikely": 1 else: 0, 0)
        if k = tokens.Tk.at and self.ttext(self.pos + 1) = "expect":
            // @expect level "pattern" over the one statement that
            // follows: what it says is expected to be drawn, so what
            // it draws is caught and kept from the report.  Which
            // diagnostic it was is the interpreter's to check, as it
            // is for a definition marked the same way.
            let wants_err : mut i64 = 0
            while self.peek() = tokens.Tk.at and self.ttext(self.pos + 1) = "expect" and not self.failed():
                self.pos ← self.pos + 2
                let lvl := self.ttext(self.pos)
                if lvl ≠ "error" and lvl ≠ "warning":
                    self.err("@expect names a level, error or warning")
                    return 0
                if lvl = "error":
                    wants_err ← 1
                self.pos ← self.pos + 1
                // @expect <level> <code> ["message"], or the older
                // <level> "message".  Which diagnostic it was is the
                // interpreter's to check, so both shapes are read and
                // dropped here; what this needs to know is only that
                // the definition is expected to draw one.
                if self.peek() = tokens.Tk.number:
                    self.pos ← self.pos + 1
                    if self.peek() = tokens.Tk.string:
                        self.pos ← self.pos + 1
                elif self.peek() = tokens.Tk.string:
                    self.pos ← self.pos + 1
                else:
                    self.err("""@expect states the code it expects, and may state the message beside
                              " it; the older form states the message alone""")
                    return 0
                while self.peek() = tokens.Tk.nl:
                    self.pos ← self.pos + 1
            let inner : i64 = self.parse_stmt()
            return self.mknode(ast.Nk.expects, at, inner, wants_err, 0)
        if k = tokens.Tk.kw_let:
            return self.parse_let()
        if k = tokens.Tk.kw_if:
            return self.parse_if_node()
        if k = tokens.Tk.kw_while:
            self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.ident and (self.peek2() = tokens.Tk.define or (self.peek2() = tokens.Tk.colon and self.toks.kind[(self.pos + 2) × 1¤ptrdiff] ≠ tokens.Tk.nl)):
                // while x := e, while x : mut = e, while x : T = e --
                // the loop runs while e answers a value, x naming it
                let wname_tok : i64 = self.pos
                let wmut : mut i64 = 0
                let wty : mut i64 = ⁻1
                if self.peek2() = tokens.Tk.define:
                    self.pos ← self.pos + 2
                else:
                    self.pos ← self.pos + 2
                    if self.peek() = tokens.Tk.kw_mut:
                        wmut ← 1
                        self.pos ← self.pos + 1
                    if self.peek() ≠ tokens.Tk.eq:
                        wty ← self.parse_type(false)
                    _ ← self.eat(tokens.Tk.eq, "'=' and what the loop asks")
                let wcond : i64 = self.parse_expr()
                let wbody : i64 = self.parse_block()
                let woff : i64 = @dropunit(#self.extra)
                self.extra.push(wmut)
                self.extra.push(wty)
                return self.mknode(ast.Nk.whileb, wname_tok, wcond, wbody, woff)
            let cond : i64 = self.parse_expr()
            let body : i64 = self.parse_block()
            return self.mknode(ast.Nk.st_while, at, cond, body, 0)
        if k = tokens.Tk.kw_foreach:
            self.pos ← self.pos + 1
            let name_tok : i64 = self.pos
            if self.peek() = tokens.Tk.ident or self.peek() = tokens.Tk.reserved:
                _ ← self.eat_name("the loop variable")
            else:
                self.err("expected the loop variable")
                return 0
            _ ← self.eat(tokens.Tk.define, "':=' before what the loop walks")
            if self.peek() = tokens.Tk.band:
                // foreach x := &v / &mut v: the elements are lent
                self.pos ← self.pos + 1
                let brk : mut i64 = 1
                if self.peek() = tokens.Tk.kw_mut:
                    brk ← 2
                    self.pos ← self.pos + 1
                let btok : i64 = self.pos
                _ ← self.eat_name("the borrowed array's name")
                let bvar : i64 = self.mknode(ast.Nk.var, btok, 0, 0, 0)
                let bref : i64 = self.mknode(ast.Nk.ref, btok, bvar, brk, 0)
                let bbody : i64 = self.parse_block()
                return self.mknode(ast.Nk.foreacha, name_tok, bref, bbody, 0)
            let e1 : i64 = self.parse_bin(2)
            if self.nkind[e1 × 1¤ptrdiff] ≠ ast.Nk.rangev:
                // walking a container's elements, or a range that
                // arrives as a value
                let body : i64 = self.parse_block()
                return self.mknode(ast.Nk.foreacha, name_tok, e1, body, 0)
            let body : i64 = self.parse_block()
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(self.na[e1 × 1¤ptrdiff])
            self.extra.push(self.nc[e1 × 1¤ptrdiff])
            self.extra.push(self.nb[e1 × 1¤ptrdiff])
            return self.mknode(ast.Nk.st_foreach, name_tok, off, body, 0)
        if k = tokens.Tk.kw_match:
            return self.parse_match_node()
        if k = tokens.Tk.kw_return:
            self.pos ← self.pos + 1
            let v : mut i64 = ⁻1
            if self.peek() ≠ tokens.Tk.nl and self.peek() ≠ tokens.Tk.dedent:
                v ← self.parse_expr()
            self.end_stmt()
            return self.mknode(ast.Nk.st_return, at, v, 0, 0)
        if k = tokens.Tk.kw_break:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(ast.Nk.st_break, at, 0, 0, 0)
        if k = tokens.Tk.kw_continue:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(ast.Nk.st_continue, at, 0, 0, 0)
        if k = tokens.Tk.ident and self.peek2() = tokens.Tk.assign:
            let name := self.ttext(at)
            self.pos ← self.pos + 2
            let v : i64 = self.parse_expr()
            self.end_stmt()
            if name = "_":
                return self.mknode(ast.Nk.discard, at, v, 0, 0)
            return self.mknode(ast.Nk.assign, at, v, 0, 0)
        // any postfix path may be a store target: the expression is
        // parsed first, and a following ← turns it into the store its
        // shape names -- a field, an element, or nothing storable
        let e : i64 = self.parse_expr()
        if self.peek() = tokens.Tk.assign:
            self.pos ← self.pos + 1
            let v : i64 = self.parse_expr()
            self.end_stmt()
            let ek : i64 = self.nkind[e × 1¤ptrdiff]
            if ek = ast.Nk.field:
                return self.mknode(ast.Nk.storefld, self.ntok[e × 1¤ptrdiff],
                                   self.na[e × 1¤ptrdiff], v, 0)
            if ek = ast.Nk.index:
                return self.mknode(ast.Nk.storeidxp, at, self.na[e × 1¤ptrdiff],
                                   self.nb[e × 1¤ptrdiff], v)
            self.err("this is not a place a value can be stored into")
            return 0
        self.semi_end ← false
        self.end_stmt()
        self.mknode(ast.Nk.exprstmt, at, e, if self.semi_end: 1 else: 0, 0)

    // if cond block (elif cond block)* (else block)? -- one shape,
    // whether the if stands as a statement or where a value is
    // wanted.  Which of the two it is is not the parser's question:
    // the node is the same either way and what differs is only
    // whether anything reads the value, which is the checker's to
    // know.
    // Whether the arm about to be read is written in braces.  An if
    // opens every arm the way it opened its first, so the first arm's
    // answer is what the rest are held to.
    fn arm_braced(&self) → bool:
        self.peek() = tokens.Tk.lbrace

    // The arm here is opened the way the if's first arm was, or it is
    // refused: an if half laid out and half in braces is two ways of
    // writing one thing at once, and a reader has to hold both.
    fn arm_alike(&mut self, braced : bool) → bool:
        if self.arm_braced() = braced:
            return true
        let began : str = if braced: "'{'" else: "':'"
        let here : str = if braced: "':'" else: "'{'"
        self.err("an if opens every arm the way it opened its first: this one began with " ⧺ began ⧺ " and this arm begins with " ⧺ here)
        false

    fn parse_if_node(&mut self) → i64:
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_expr()
        let braced : bool = self.arm_braced()
        let then_blk : i64 = self.parse_block()
        let else_blk : mut i64 = ⁻1
        self.skip_nl_before_else()
        if self.peek() = tokens.Tk.kw_elif:
            else_blk ← self.parse_elif_chain(braced)
        elif self.peek() = tokens.Tk.kw_else:
            self.pos ← self.pos + 1
            if not self.arm_alike(braced):
                return 0
            else_blk ← self.parse_block()
        self.mknode(ast.Nk.st_if, at, cond, then_blk, else_blk)

    fn parse_elif_chain(&mut self, braced : bool) → i64:
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_expr()
        if not self.arm_alike(braced):
            return 0
        let then_blk : i64 = self.parse_block()
        let else_blk : mut i64 = ⁻1
        self.skip_nl_before_else()
        if self.peek() = tokens.Tk.kw_elif:
            else_blk ← self.parse_elif_chain(braced)
        elif self.peek() = tokens.Tk.kw_else:
            self.pos ← self.pos + 1
            if not self.arm_alike(braced):
                return 0
            else_blk ← self.parse_block()
        let ifn : i64 = self.mknode(ast.Nk.st_if, at, cond, then_blk, else_blk)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(ifn)
        self.mknode(ast.Nk.block, 0, off, 0, 0)

    // ------------------------------------------------------------------
    // Definitions
    // ------------------------------------------------------------------

    // mods: bit 0 says @replaceable, bit 1 @export, bit 2 @build,
    // bit 3 @listable and bit 4 @ignorable -- bits rather than
    // parameters, the subset holding a signature to twelve of them
    fn parse_fn(&mut self, imp : bool, is_start : bool, is_noreturn : bool,
                is_test : bool, mods : i64, ignored : bool,
                pres : i64[], post_toks : i64[], posts : i64[],
                prefix : str, self_sty : i64):
        _ ← self.eat(tokens.Tk.kw_fn, "'fn'")
        let name_tok : i64 = self.pos
        let name0 := self.ttext(name_tok)
        let name : str = if prefix = "": name0 else: prefix ⧺ "." ⧺ name0
        _ ← self.eat_name("the function's name")
        _ ← self.eat(tokens.Tk.lpar, "'(' and the parameters")
        let ptoks : mut i64[] = []
        let ptypes : mut i64[] = []
        if self_sty ≠ 0 and self.peek() = tokens.Tk.band:
            // the receiver: &self reads, &mut self changes
            self.pos ← self.pos + 1
            let srk : mut i64 = 1
            if self.peek() = tokens.Tk.kw_mut:
                self.pos ← self.pos + 1
                srk ← 2
            let stok : i64 = self.pos
            if self.ttext(stok) ≠ "self":
                self.err("a method's receiver is spelled &self or &mut self")
                return
            self.pos ← self.pos + 1
            ptoks.push(stok)
            ptypes.push(self_sty + 262144 × srk)
            if self.peek() = tokens.Tk.comma:
                self.pos ← self.pos + 1
        if self.peek() ≠ tokens.Tk.rpar:
            while true:
                ptoks.push(self.pos)
                _ ← self.eat_name("a parameter name")
                if self.peek() = tokens.Tk.currency:
                    self.err("a measure is written against the type, as 'a : i64 ¤meter'")
                    return
                let u : i64 = types.UNIT_NONE
                _ ← self.eat(tokens.Tk.colon, "':' and the parameter's type")
                let pmut : mut i64 = 0
                if self.peek() = tokens.Tk.kw_mut:
                    self.pos ← self.pos + 1
                    pmut ← 1
                let ty0a : i64 = self.parse_type(true)
                let ty0 : mut i64 = ty0a
                if pmut = 1:
                    if types.ty_ref_kind(ty0a) ≠ 0:
                        self.err("mut before a borrow says nothing; &mut already changes")
                    elif types.ty_is_arr(ty0a) or types.ty_is_hash(ty0a) or types.ty_is_mat(ty0a):
                        self.err("a mut container parameter changes the caller's own; write &mut")
                    else:
                        ty0 ← ty0a + 262144 × 3
                let ty : mut i64 = ty0
                if u ≠ types.UNIT_NONE:
                    let rk : i64 = types.ty_ref_kind(ty)
                    ty ← self.unit_on_type(types.ty_strip_ref(ty), u, "") + 262144 × rk
                if types.ty_is_tup(types.ty_strip_ref(ty)):
                    self.err("""a core-2 tuple is returned and taken apart; it does not travel as a
                              " parameter""")
                ptypes.push(ty)
                if self.failed(): return
                if self.peek() = tokens.Tk.comma:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(tokens.Tk.rpar, "')' after the parameters")
        let ret : mut i64 = types.TY_UNIT
        // `→ &T |p, q|`: the answer is a borrow, and reaches into the
        // parameters named after it -- the capture list's notation,
        // meaning here what it means there.  Left off, the one
        // borrowed parameter is the origin.
        let ret_ref : mut i64 = 0
        let origins : mut i64[] = []
        let wrote_origins : mut bool = false
        if self.peek() = tokens.Tk.arrow:
            self.pos ← self.pos + 1
            let ref_tok : i64 = self.pos
            if self.peek() = tokens.Tk.band:
                self.pos ← self.pos + 1
                ret_ref ← 1
                if self.peek() = tokens.Tk.kw_mut:
                    self.pos ← self.pos + 1
                    ret_ref ← 2
            ret ← self.parse_type(false)
            if self.peek() = tokens.Tk.bor:
                self.pos ← self.pos + 1
                wrote_origins ← true
                while self.peek() = tokens.Tk.ident:
                    let otok : i64 = self.pos
                    self.pos ← self.pos + 1
                    let oi : i64 = self.param_index(ptoks, self.ttext(otok))
                    if oi = ⁻1 or types.ty_ref_kind(ptypes[oi × 1¤ptrdiff]) = 0:
                        self.errc_at(otok, 2434, "'" ⧺ name ⧺ "' answers a borrow of '" ⧺ self.ttext(otok) ⧺ "', which is not a borrowed parameter")
                        return
                    origins.push(oi)
                    if self.peek() = tokens.Tk.comma:
                        self.pos ← self.pos + 1
                _ ← self.eat(tokens.Tk.bor, "'|' closing what the answer reaches into")
            if ret_ref ≠ 0:
                if not wrote_origins:
                    foreach i := 0…#ptypes:
                        if types.ty_ref_kind(ptypes[i]) ≠ 0:
                            origins.push(@dropunit(i))
                    if #origins = 0:
                        self.errc_at(ref_tok, 2434, "'" ⧺ name ⧺ "' answers a borrow, but borrows nothing it could be of; a borrowed answer reaches into a borrowed parameter")
                        return
                    if #origins > 1:
                        self.errc_at(ref_tok, 2435, "'" ⧺ name ⧺ "' answers a borrow and borrows more than one thing; write which the answer reaches into, as '|" ⧺ self.ttext(ptoks[origins[0¤ptrdiff] × 1¤ptrdiff]) ⧺ "|'")
                        return
                foreach o := origins:
                    if ret_ref = 2 and types.ty_ref_kind(ptypes[o × 1¤ptrdiff]) ≠ 2:
                        self.errc_at(ref_tok, 2434, "'" ⧺ name ⧺ "' answers a borrow that may change what it reaches, but '" ⧺ self.ttext(ptoks[o × 1¤ptrdiff]) ⧺ "' is lent for reading; write '&mut'")
                        return
            elif wrote_origins:
                self.errc_at(ref_tok, 2434, "'" ⧺ name ⧺ "' names what its answer reaches into, but answers no borrow; write '→ &…'")
                return
        let body : i64 = self.parse_block()
        if self.peek() = tokens.Tk.nl:
            self.pos ← self.pos + 1
        let params_off : i64 ¤"aextra" = self.extra_end()
        self.extra.push(@dropunit(#ptoks))
        if #ptoks > 0:
            foreach i := 0…#ptoks:
                self.extra.push(ptoks[i])
                self.extra.push(ptypes[i])
        let pre_off : mut i64 ¤"aextra" = ⁻1
        if #pres > 0:
            pre_off ← self.push_list(pres)
        let olds_off : mut i64 ¤"aextra" = ⁻1
        if #self.olds > 0:
            olds_off ← self.push_list(self.olds)
        let ret_from : i64 ¤"aextra" = if ret_ref ≠ 0: self.push_list(origins) else: ⁻1 × 1¤"aextra"
        let post_off : mut i64 ¤"aextra" = ⁻1
        if #posts > 0:
            post_off ← self.extra_end()
            self.extra.push(@dropunit(#posts))
            foreach i := 0…#posts:
                self.extra.push(post_toks[i])
                self.extra.push(posts[i])
        if ignored:
            // @expect: the definition is expected to draw diagnostics.
            // No code is written for it -- a.fns is the emission
            // schedule and this is not scheduled -- but it is kept, so
            // the checker can draw what it draws and hold it to what
            // the @expect lines said.
            self.ignored.push(name)
            // every @expect'd function is reported as a test of the
            // expectation itself, @test or not, as the interpreter
            // reports them
            self.igtests.push(name)
            self.expects.push(ast.FnDef{name: name, modname: self.mod_at(name_tok), tok: name_tok,
                                    params_off: params_off,
                                    ret: ret, body: body, is_export: false,
                                    is_replaceable: false, is_impure: imp,
                                    is_start: false, is_noreturn: is_noreturn, is_ignorable: (mods » 4) & 1 = 1,
                                    is_test: false,
                                    is_listable: false,
                                    olds_off: ⁻1,
                                    pre_off: pre_off, post_off: post_off,
                                    ret_ref: ret_ref, ret_from: ret_from,
                            tok_lo: self.def_start, tok_hi: self.pos})
            self.expoff.push(self.pending_exp)
            return
        if mods & 4 = 4:
            // The recipe is read while the program is built and nothing
            // of it is written, so it is kept apart from the functions
            // that are: a.fns is the emission schedule, one code offset
            // to an entry, and a recipe has no code to schedule.
            if #self.builds > 0:
                self.err_at(name_tok, "a program carries one @build function, and this is a second")
                return
            // A recipe is handed the build it declares on and, where it
            // reads it, what the command line said -- one std.Options
            // holding a member per option, rather than a parameter each,
            // so that an option added later leaves every recipe's
            // signature as it was.  A recipe that reads none of it
            // leaves the second parameter off, and the compiler applies
            // -o and --target to what the recipe adds either way.
            if #ptoks = 0¤ptrdiff or #ptoks > 2¤ptrdiff:
                self.err_at(name_tok, """the @build function takes the build it declares on and, where
                                       " it reads it, what the command line said, as
                                       " 'fn build(b : &mut std.Build, o : &std.Options)' -- the
                                       " second left off where it is not read""")
                return
            if types.ty_strip_ref(ptypes[0¤ptrdiff]) ≠ types.TY_BUILD:
                self.err_at(ptoks[0¤ptrdiff],
                            "a recipe declares a build on what it is handed: '&mut std.Build'")
                return
            if #ptoks = 2¤ptrdiff and types.ty_strip_ref(ptypes[1¤ptrdiff]) ≠ types.TY_OPTIONS:
                self.err_at(ptoks[1¤ptrdiff], """what the command line said reaches a recipe as one
                                               " thing holding all of it: '&std.Options'""")
                return
            if ret ≠ types.TY_UNIT:
                self.err_at(name_tok, """the @build function answers nothing; it declares a build on
                                       " the std.Build it is handed""")
                return
            self.builds.push(ast.FnDef{name: name, modname: self.mod_at(name_tok), tok: name_tok, params_off: params_off,
                                   ret: ret, body: body, is_export: false,
                                   is_replaceable: false, is_impure: false,
                                   is_start: false, is_noreturn: false, is_ignorable: false,
                                   is_test: false,
                                   is_listable: false,
                                   olds_off: ⁻1,
                                   pre_off: pre_off, post_off: post_off,
                                   ret_ref: 0, ret_from: ⁻1 × 1¤"aextra",
                            tok_lo: self.def_start, tok_hi: self.pos})
            return
        self.fns.push(ast.FnDef{name: name, modname: self.mod_at(name_tok), tok: name_tok, params_off: params_off,
                            ret: ret, body: body, is_export: (mods » 1) & 1 = 1,
                            is_replaceable: mods & 1 = 1,
                            is_impure: imp,
                            is_start: is_start, is_noreturn: is_noreturn, is_ignorable: (mods » 4) & 1 = 1,
                            is_test: is_test,
                            is_listable: (mods » 3) & 1 = 1,
                            olds_off: olds_off,
                            pre_off: pre_off, post_off: post_off,
                            ret_ref: ret_ref, ret_from: ret_from,
                            tok_lo: self.def_start, tok_hi: self.pos})

    // enum Name [: width]: one enumerator to a line.  What a value
    // holds is its place in the list; what it is called is kept so a
    // diagnostic and a printed value can say it.
    fn parse_enum(&mut self, is_flag : bool):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the enum's name")
        // The sweep before parsing wrote this enum's name down, so
        // finding it is finding itself; anything else of that name is
        // the clash worth refusing, and a second declaration of the
        // same one is too.
        let mine : i64 = self.enum_slot(self.qual_type(name, name_tok))
        let found : i64 = self.sindex_here(name, name_tok)
        let itself : bool = found ≠ ⁻1 and types.ty_is_enum(found) and types.ty_eidx(found) = mine
        let twice : mut bool = false
        foreach d := self.edecl:
            if d = self.qual_type(name, name_tok):
                twice ← true
        if (ast.TYNAMES[name] ?? ⁻1) ≠ ⁻1 or twice or (found ≠ ⁻1 and not itself):
            self.err("'" ⧺ name ⧺ "' already names a type")
            return
        self.edecl.push(self.qual_type(name, name_tok))
        // u64 where the enum names no type of its own, as the
        // specification says: the widest unsigned covers every
        // auto-numbered and every @flag member, and a negative one is
        // then refused until a signed type is named.
        let w : mut i64 = types.TY_U64
        let named : mut bool = false
        // `enum E : u8:` says what the values are held in.  A brace
        // after the colon is not that; it is the other opener, which
        // the check below has words for.
        if self.peek() = tokens.Tk.colon and self.peek2() ≠ tokens.Tk.nl and self.peek2() ≠ tokens.Tk.lbrace:
            self.pos ← self.pos + 1
            w ← self.parse_type(false)
            named ← true
            if not (types.ty_is_int(w) and types.ty_unit(w) = 0):
                self.err("an enum's values are held in a plain integer type")
                return
        // laid out under a colon, or written in braces, as a struct's
        // fields and a block's statements are
        let braced : bool = self.peek() = tokens.Tk.lbrace
        if braced:
            _ ← self.eat(tokens.Tk.lbrace, "'{' opening the enumerators")
        else:
            _ ← self.eat(tokens.Tk.colon, "':' or '{' beginning the enumerators")
            if self.peek() = tokens.Tk.lbrace:
                self.err(both_openers())
                return
            _ ← self.eat(tokens.Tk.nl, "the enumerators on their own lines")
            _ ← self.eat(tokens.Tk.indent, "an indented list of enumerators")
        let ender : tokens.Tk = if braced: tokens.Tk.rbrace else: tokens.Tk.dedent
        let first : i64 ¤ptrdiff = #self.emembers
        // a flag's members are bits, so the automatic values double
        // where an ordinary enum's count on
        let next_val : mut i64 = if is_flag: 1 else: 0
        while self.peek() ≠ ender and self.peek() ≠ tokens.Tk.eof and not self.failed():
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
                continue
            let mname := self.ttext(self.pos)
            _ ← self.eat_name("an enumerator's name")
            foreach m := first…#self.emembers:
                if self.emembers[m] = mname:
                    self.err("'" ⧺ mname ⧺ "' is named twice in this enum")
                    return
            // an enumerator may say what it stands for; the ones that
            // follow count on from there, as they count from zero
            let alias : mut bool = false
            // what the next enumerator would have counted on to, kept
            // because an alias is a nickname and does not count
            let keep : i64 = next_val
            if self.peek() = tokens.Tk.eq:
                self.pos ← self.pos + 1
                let neg : mut i64 = 1
                if self.peek() = tokens.Tk.neg:
                    self.pos ← self.pos + 1
                    neg ← ⁻1
                if self.peek() = tokens.Tk.ident and neg = 1:
                    // An enumerator standing for one this enum already
                    // names is another name for it, and says so.  That
                    // is the only way two names share a value, because
                    // sharing one silently is what makes '=' answer
                    // true for two things a reader took for different.
                    let aname := self.ttext(self.pos)
                    let av : mut i64 = 0
                    let found : mut bool = false
                    foreach q := first…#self.emembers:
                        if self.emembers[q] = aname:
                            av ← self.evalues[q]
                            found ← true
                    if not found:
                        self.err("'" ⧺ aname ⧺ """' is not an enumerator this enum has already
                                                " named; an enumerator stands for a written-out
                                                " number, or for one named above it""")
                        return
                    self.pos ← self.pos + 1
                    next_val ← av
                    alias ← true
                else:
                    if self.peek() ≠ tokens.Tk.number or self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                        self.err("""an enumerator stands for a written-out number, or for one this
                                  " enum named above it""")
                        return
                    next_val ← neg × self.toks.val[self.pos × 1¤ptrdiff]
                    self.pos ← self.pos + 1
            if not alias:
                foreach d := first…#self.emembers:
                    if self.evalues[d] = next_val:
                        self.err("'" ⧺ mname ⧺ "' stands for the same number as '" ⧺ self.emembers[d] ⧺ "', so '=' would answer true for the two of them; an enum that means that writes '" ⧺ mname ⧺ " = " ⧺ self.emembers[d] ⧺ "'")
                        return
            self.emembers.push(mname)
            self.evalues.push(next_val)
            if alias:
                next_val ← keep
            elif is_flag:
                next_val ← if next_val ≠ 0: @wrap(next_val « 1) else: 1
            else:
                next_val ← next_val + 1
            if self.peek() = tokens.Tk.semi:
                self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
        _ ← self.eat(ender, if braced: "'}' closing the enumerators" else: "the end of the enumerators")
        if is_flag:
            // a flag set holds the empty combination under 'nil'
            // unless some member already stands for zero
            let has0 : mut bool = false
            foreach z := first…#self.emembers:
                if self.evalues[z] = 0:
                    has0 ← true
            if not has0:
                self.emembers.push("nil")
                self.evalues.push(0)
        // every member fits the type the values are stored in
        let bits : i64 = types.ty_bits(w)
        let sgn : i64 = types.ty_sgn(w)
        foreach f := first…#self.emembers:
            let v : i64 = self.evalues[f]
            let lo : i64 = if sgn = 1 and bits < 64: 0 - (1 « (bits - 1)) else: (if sgn = 1: ⁻9223372036854775807 - 1 else: 0)
            // a shift of 63 is past what a signed count allows, so the
            // top of the range is written out where it would be needed
            let hi : i64 = if bits - sgn >= 63: 9223372036854775807 else: (1 « (bits - sgn)) - 1
            if v < lo or (bits - sgn < 64 and v > hi):
                let advice : str = if named: "" else: """ when none is named; a negative member wants a
                                                       " signed underlying type, as 'enum """ ⧺ name ⧺ " : i64:'"
                self.err("enum '" ⧺ name ⧺ "': member '" ⧺ self.emembers[f] ⧺ "' is " ⧺ tokens.i64_str(v) ⧺ ", which does not fit " ⧺ types.type_name_m(w, self.umarks, self.snames, self.enames) ⧺ ", the type the values are stored in" ⧺ advice)
                return
        let n : i64 ¤ptrdiff = #self.emembers - first
        if n = 0:
            self.err("an enum names at least one of what it holds")
            return
        if @dropunit(#self.enames) >= 256:
            self.err("this file names more than 256 enums")
            return
        // named by the module it is written in, as a struct is
        let ei : i64 = self.enum_slot(self.qual_type(name, name_tok))
        if ei = ⁻1:
            self.err("this file names more than 256 enums")
            return
        self.ewidth[ei × 1¤ptrdiff] ← w
        self.estart[ei × 1¤ptrdiff] ← @dropunit(first)
        self.ecount[ei × 1¤ptrdiff] ← @dropunit(n)
        self.eflag[ei × 1¤ptrdiff] ← if is_flag: 1 else: 0

    // unit name: a measure of the file's own, standing for nothing but
    // itself.  It is written ¤"name" where a shipped one is written
    // ¤name, as the specification has it.  A measure derived from
    // others -- a ratio of them, or a product -- is not core-2 yet:
    // what core-2 does with a measure is keep it apart from the
    // others, and that needs only its name.
    // What each measure stands in for, settled once the whole file has
    // been read so that one may name another declared further down.
    //
    // Standing in for something is an order, and an order has no
    // circles: a measure that reaches itself by standing in for things
    // says nothing about which of them is the wider.  A circle is
    // looked for here because this is the first moment it could exist
    // -- while the names were being read, the one closing it had not
    // been written yet.
    fn resolve_decays(&mut self):
        let n : i64 ¤ptrdiff = #self.unames
        foreach i := 0¤ptrdiff…n:
            let want : str = self.udname[i]
            if want ≠ "":
                let d : i64 = self.unit_index(want)
                if d = ⁻1:
                    self.poisoned ← false
                    self.err_at(self.udtok[i], "'" ⧺ want ⧺ "' is no measure this file knows, so '" ⧺ self.unames[i] ⧺ "' cannot stand in for it")
                else:
                    self.udecay[i] ← d
        foreach j := 0¤ptrdiff…n:
            if self.udecay[j] ≠ 0:
                let chain : mut str = self.unames[j]
                let step : mut i64 ¤ptrdiff = self.udecay[j] × 1¤ptrdiff
                let seen : mut i64 ¤ptrdiff = 0
                while step ≠ 0 and seen <= n:
                    chain ← chain ⧺ " → " ⧺ self.unames[step]
                    if step = j:
                        self.poisoned ← false
                        self.err_at(self.udtok[j], """a measure cannot stand in for itself, however
                                                    " far round it goes: """ ⧺ chain)
                        step ← 0¤ptrdiff
                    else:
                        step ← self.udecay[step] × 1¤ptrdiff
                        seen ← seen + 1

    // which parameter a name is, or ⁻1
    fn param_index(&self, ptoks : i64[], nm : str) → i64:
        foreach i := 0…#ptoks:
            if self.ttext(ptoks[i]) = nm:
                return @dropunit(i)
        ⁻1

    // The `{field: value, …}` of a struct literal, the name having
    // been read already.  Answers where the fields were written down.
    fn parse_slit_fields(&mut self) → i64:
        _ ← self.eat(tokens.Tk.lbrace, "'{' opening the struct literal")
        let items : mut i64[] = []
        if self.peek() ≠ tokens.Tk.rbrace:
            while true:
                items.push(self.pos)
                _ ← self.eat_name("a field's name")
                _ ← self.eat(tokens.Tk.colon, "':' after the field's name")
                items.push(self.parse_expr())
                if self.failed(): return 0
                if self.peek() = tokens.Tk.comma:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(tokens.Tk.rbrace, "'}' closing the struct literal")
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#items) ÷ 2 ?? 0)
        foreach it := items:
            self.extra.push(it)
        off

    fn parse_bound(&mut self, at : i64, path : str) → i64:
        self.pos ← at + 1
        _ ← self.eat(tokens.Tk.dot, "'.' and the name asked of the module")
        let ntok : i64 = self.pos
        _ ← self.eat_name("the name asked of the module")
        // `m.Name{…}`: a struct of another module, made through the
        // only way into it.  The whole name rides with the node, since
        // the token spells only what was written after the dot.
        if self.peek() = tokens.Tk.lbrace:
            self.hold_export(ntok, path, self.ttext(ntok))
            self.qmods.push(path)
            let qm : i64 = @dropunit(#self.qmods)
            let off : i64 = self.parse_slit_fields()
            if self.failed(): return 0
            return self.parse_postfix(self.mknode(ast.Nk.slit, ntok, off, ast.SLIT_PLAIN, qm))
        if self.peek() ≠ tokens.Tk.lpar:
            // A name asked of a module that is not called: a global it
            // holds, or an enum of its whose member follows.  The whole
            // name rides with the node, since the token spells only
            // what was written after the dot.  An enum is answered for
            // here; a global is the checker's, which knows what it was
            // marked.
            self.hold_export(ntok, path, self.ttext(ntok))
            self.qmods.push(path)
            let qv : i64 = @dropunit(#self.qmods)
            return self.parse_postfix(self.mknode(ast.Nk.var, ntok, 0, 0, qv))
        let aoff : i64 = self.parse_args()
        self.qmods.push(path)
        // what a call answers may be indexed, sliced or reached into,
        // as what any other call answers may be
        self.parse_postfix(self.mknode(ast.Nk.call, ntok, aoff, @dropunit(#self.qmods), 0))

    fn parse_unit_def(&mut self):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the measure's name")
        // the sweep before parsing wrote the name down; a second
        // declaration of it is the mistake
        let twice : mut bool = false
        foreach d := self.udecl:
            if d = name:
                twice ← true
        if twice:
            self.err("'" ⧺ name ⧺ "' already names a measure")
            return
        let ui : i64 = self.unit_index(name)
        if ui = ⁻1:
            self.err("this file names more than 125 measures")
            return
        if self.peek() = tokens.Tk.eq:
            self.err("a measure derived from others is not core-2 yet; 'unit " ⧺ name ⧺ "' names one of its own")
            return
        // `unit tok → ptrdiff` says a token index may go wherever a
        // ptrdiff is wanted.  It stays its own measure -- a node id is
        // still not one -- and the way back is not open: what stands in
        // for a thing is not the thing.
        //
        // The name is only written down here.  What it refers to is
        // settled once the whole file has been read, so a measure may
        // stand in for one declared further down, as a struct may be
        // named before it is declared.
        let dname : mut str = ""
        let dtok : mut i64 = 0
        if self.peek() = tokens.Tk.arrow:
            self.pos ← self.pos + 1
            dtok ← self.pos
            dname ← self.ttext(dtok)
            _ ← self.eat_name("the measure this one stands in for")
        self.udecl.push(name)
        self.udname[ui × 1¤ptrdiff] ← dname
        self.udtok[ui × 1¤ptrdiff] ← dtok
        self.end_stmt()

    // type Name = T: a name standing for a type, and nothing more --
    // what it stands for is what it is, everywhere the name is written
    fn parse_type_alias(&mut self):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the name being given to a type")
        if (ast.TYNAMES[name] ?? ⁻1) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' is already a type's name")
            return
        if self.sindex_ty(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already stands for something")
            return
        _ ← self.eat(tokens.Tk.eq, "'=' and the type the name stands for")
        let t : i64 = self.parse_type(false)
        if self.failed(): return
        self.tanames.push(name)
        self.tatypes.push(t)
        self.end_stmt()

    fn parse_struct(&mut self, repr_c : bool, invs : i64[]):
        _ ← self.eat(tokens.Tk.kw_struct, "'struct'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        // The fields are written the two ways a block is: indented
        // under a colon, or in braces.  Inside braces a line ends
        // nothing -- the lexer stops counting them there, which is
        // what lets a struct literal be spread out -- so ';' separates
        // the fields and the next field's name will do on its own.
        let braced : bool = self.peek() = tokens.Tk.lbrace
        if braced:
            _ ← self.eat(tokens.Tk.lbrace, "'{' opening the fields")
        else:
            _ ← self.eat(tokens.Tk.colon, "':' or '{' after the struct's name")
            if self.peek() = tokens.Tk.lbrace:
                self.err(both_openers())
                return
            _ ← self.eat(tokens.Tk.nl, "the fields on their own lines")
            _ ← self.eat(tokens.Tk.indent, "an indented field list")
        let ender : tokens.Tk = if braced: tokens.Tk.rbrace else: tokens.Tk.dedent
        let ftoks : mut i64[] = []
        let ftypes : mut i64[] = []
        while self.peek() ≠ ender and not self.failed():
            ftoks.push(self.pos)
            _ ← self.eat_name("a field's name")
            // a field may state a unit the way a binding does:
            // name : type ¤unit
            if self.peek() = tokens.Tk.currency:
                self.err("a measure is written against the type, as 'f : i64 ¤meter'")
                return
            let fu : i64 = types.UNIT_NONE
            _ ← self.eat(tokens.Tk.colon, "':' and the field's type")
            let ty : mut i64 = self.parse_type(false)
            if fu ≠ 0:
                ty ← self.unit_on_type(ty, fu, " field")
            if types.ty_is_tup(ty):
                self.err("a tuple inside a struct is not core-2 yet")
            ftypes.push(ty)
            if self.peek() = tokens.Tk.semi:
                self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
        _ ← self.eat(ender, if braced: "'}' closing the fields" else: "the end of the struct")
        if self.peek() = tokens.Tk.nl:
            self.pos ← self.pos + 1
        let off : i64 ¤"aextra" = self.extra_end()
        self.extra.push(@dropunit(#ftoks))
        if #ftoks > 0:
            foreach i := 0…#ftoks:
                self.extra.push(ftoks[i])
                self.extra.push(ftypes[i])
        let inv_off : mut i64 ¤"aextra" = ⁻1
        if #invs > 0:
            inv_off ← self.push_list(invs)
        // named by the module it is written in, as the sweep that
        // gathered the names before parsing named it
        self.structs.push(ast.SDef{name: self.qual_type(name, name_tok), tok: name_tok, fields_off: off,
                               is_repr_c: repr_c, inv_off: inv_off})

    fn parse_impl(&mut self):
        _ ← self.eat(tokens.Tk.kw_impl, "'impl'")
        let name_tok : i64 = self.pos
        let name0 := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        // The struct this is an implementation of, found in the module
        // in hand as any other type name is.  A method's whole name is
        // that struct's and then its own, so the prefix is the name the
        // struct is registered under rather than the one written here.
        let sty : i64 = self.sindex_here(name0, name_tok)
        if sty = ⁻1:
            self.err("'" ⧺ name0 ⧺ "' is not a struct this program defines")
            return
        // The prefix a method's name carries is the struct's own, less
        // the module: the method is written in a module of its own and
        // carries that already, so the whole name comes out as the
        // struct's module, the struct, and then the method.
        let name : str = if types.ty_is_struct(sty): parse_bare(self.snames[types.ty_sidx(sty) × 1¤ptrdiff]) else: name0
        // laid out under a colon, or written in braces, as a struct's
        // fields and a block's statements are
        let braced : bool = self.peek() = tokens.Tk.lbrace
        if braced:
            _ ← self.eat(tokens.Tk.lbrace, "'{' opening the methods")
        else:
            _ ← self.eat(tokens.Tk.colon, "':' or '{' after the name")
            if self.peek() = tokens.Tk.lbrace:
                self.err(both_openers())
                return
            _ ← self.eat(tokens.Tk.nl, "the methods on their own lines")
            _ ← self.eat(tokens.Tk.indent, "an indented method list")
        let ender : tokens.Tk = if braced: tokens.Tk.rbrace else: tokens.Tk.dedent
        while self.peek() ≠ ender and not self.failed():
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
                continue
            // where this method begins, which is its first annotation
            // and not the `fn`, as for a function at the top level.  An
            // impl block is one top-level definition, so without this
            // every method in it would say it began where the block
            // did -- and the bill of materials, which digests a
            // function over the tokens from here to its end, would
            // give the block's first method one row and the rest none.
            self.def_start ← self.pos
            let imp : mut bool = false
            let is_noreturn : mut bool = false
            let pres : mut i64[] = []
            let post_toks : mut i64[] = []
            let posts : mut i64[] = []
            while self.peek() = tokens.Tk.at and not self.failed():
                self.pos ← self.pos + 1
                let aname := self.ttext(self.pos)
                _ ← self.eat_word("the annotation's name")
                if aname = "impure":
                    imp ← true
                elif aname = "noreturn":
                    is_noreturn ← true
                elif aname = "pre":
                    _ ← self.eat(tokens.Tk.lpar, "'(' after @pre")
                    pres.push(self.parse_expr())
                    _ ← self.eat(tokens.Tk.rpar, "')' closing @pre")
                elif aname = "post":
                    _ ← self.eat(tokens.Tk.lpar, "'(' after @post")
                    post_toks.push(self.pos)
                    _ ← self.eat_name("the name @post gives the result")
                    _ ← self.eat(tokens.Tk.colon, "':' after the result's name")
                    posts.push(self.parse_expr())
                    _ ← self.eat(tokens.Tk.rpar, "')' closing @post")
                elif aname = "hot" or aname = "cold":
                    // how often a method is expected to run: noted, as
                    // the interpreter notes it
                    let mnoted : i64 = 0
                    _ ← mnoted
                else:
                    self.err("'@" ⧺ aname ⧺ "' is not core-2 on a method")
                    return
                if self.peek() = tokens.Tk.nl:
                    self.pos ← self.pos + 1
            if self.peek() = tokens.Tk.kw_fn:
                self.parse_fn(imp, false, is_noreturn, false, 0, false,
                              pres, post_toks, posts, name, sty)
            else:
                self.err("an impl block holds methods and nothing else")
        _ ← self.eat(ender, if braced: "'}' closing the impl block" else: "the end of the impl block")
        if self.peek() = tokens.Tk.nl:
            self.pos ← self.pos + 1

    fn parse_global(&mut self, ignored : bool):
        self.parse_global_x(ignored, false)

    fn parse_global_x(&mut self, ignored : bool, is_exp : bool):
        // A bound import: `let m := @import("x")`.  The reader has
        // already found the file and read it, so there is nothing to
        // parse but the shape and nothing to keep: what the name
        // reaches was settled before any of this was lexed.
        if self.is_bound_import():
            self.pos ← self.pos + 1
            _ ← self.eat_name("the name the module is bound to")
            _ ← self.eat(tokens.Tk.define, "':=' before the module")
            _ ← self.eat(tokens.Tk.at, "'@import'")
            _ ← self.eat_word("'import'")
            _ ← self.eat(tokens.Tk.lpar, "'(' after @import")
            _ ← self.eat(tokens.Tk.string, "the file's name, in quotes")
            _ ← self.eat(tokens.Tk.rpar, "')' closing @import")
            self.end_stmt()
            return
        // a top-level let: the same shape a local has
        let stmt : i64 = self.parse_let()
        if self.failed(): return
        let tok : i64 = self.ntok[stmt × 1¤ptrdiff]
        if ignored:
            // @expect: parsed, remembered, left uncompiled
            self.ignored.push(self.ttext(tok))
            return
        self.globals.push(ast.GlobalDef{name: self.qual_type(self.ttext(tok), tok), modname: self.mod_at(tok), tok: tok,
                                    ty: self.nc[stmt × 1¤ptrdiff],
                                    is_mut: self.nb[stmt × 1¤ptrdiff] = 1,
                                    is_export: is_exp,
                                    init: self.na[stmt × 1¤ptrdiff]})

    // whether what is here is `let name := @import(`
    fn is_bound_import(&self) → bool:
        if self.peek() ≠ tokens.Tk.kw_let:
            return false
        if self.toks.kind[(self.pos + 1) × 1¤ptrdiff] ≠ tokens.Tk.ident:
            return false
        if self.toks.kind[(self.pos + 2) × 1¤ptrdiff] ≠ tokens.Tk.define:
            return false
        if self.toks.kind[(self.pos + 3) × 1¤ptrdiff] ≠ tokens.Tk.at:
            return false
        self.ttext(self.pos + 4) = "import"

    fn parse_toplevel(&mut self):
        // where this definition begins, which is its first annotation
        // and not the `fn`: a contract is part of what a function is
        self.def_start ← self.pos
        // the @old nodes belong to the definition being read
        while #self.olds > 0:
            _ ← self.olds.pop() ?? 0
        let imp : mut bool = false
        let is_start : mut bool = false
        let is_noreturn : mut bool = false
        let is_test : mut bool = false
        let is_repl : mut bool = false
        let is_exp : mut bool = false
        let is_repr : mut bool = false
        let is_fl : mut bool = false
        let is_build : mut bool = false
        let is_ignb : mut bool = false
        let is_lstb : mut bool = false
        let invs : mut i64[] = []
        let expects : mut i64 = 0
        let exp_lvl : mut i64[] = []
        let exp_code : mut i64[] = []
        let pres : mut i64[] = []
        let post_toks : mut i64[] = []
        let posts : mut i64[] = []
        while self.peek() = tokens.Tk.at and not self.failed():
            let atok : i64 = self.pos
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            _ ← self.eat_word("the annotation's name")
            if name = "impure":
                imp ← true
            elif name = "start":
                is_start ← true
            elif name = "noreturn":
                is_noreturn ← true
            elif name = "ignorable":
                is_ignb ← true
            elif name = "test":
                is_test ← true
            elif name = "build":
                // the build recipe: read while the program is built, and
                // no code for it is ever written
                is_build ← true
            elif name = "replaceable":
                is_repl ← true
            elif name = "hot" or name = "cold":
                // how often a function is expected to run: noted and
                // not yet acted on, as the interpreter notes it.  It
                // says where to spend effort, never what to compute.
                let noted : i64 = 0
                _ ← noted
            elif name = "invariant":
                // what is always true of one of a type, rather than of
                // a call: the condition names the fields
                _ ← self.eat(tokens.Tk.lpar, "'(' after @invariant")
                invs.push(self.parse_expr())
                _ ← self.eat(tokens.Tk.rpar, "')' closing @invariant")
            elif name = "import":
                // A bound @import is read where a global binding is,
                // further up.  Reaching here means the answer was
                // thrown away, which is the one thing @import cannot
                // be asked for: a file brings nothing into the module
                // that reads it, so what is not bound is not reachable.
                self.err_at(atok, """@import answers a module and says nothing on its own; bind it, as
                                   " let x := @import(\"./x.ngpl\")""")
                return
            elif name = "listable":
                is_lstb ← true
            elif name = "export":
                is_exp ← true
            elif name = "flag":
                // the enum below holds independent bits rather than a
                // count; its automatic values double and combine
                is_fl ← true
            elif name = "repr":
                // @repr(C): the one layout there is.  An unknown name
                // is refused rather than ignored, since accepting it
                // and laying the struct out some other way is the one
                // behaviour guaranteed to corrupt data.
                _ ← self.eat(tokens.Tk.lpar, "'(' after @repr")
                let kind := self.ttext(self.pos)
                _ ← self.eat_word("the layout's name")
                if kind ≠ "C":
                    self.err("'@repr(" ⧺ kind ⧺ """)' is not a layout core-2 defines; C is the one
                                                 " there is""")
                    return
                _ ← self.eat(tokens.Tk.rpar, "')' closing @repr")
                is_repr ← true
            elif name = "expect":
                // @expect level "pattern": the definition is expected
                // to draw diagnostics, so it is parsed and then left
                // uncompiled; the interpreter is where the expectation
                // itself is verified
                let lvl := self.ttext(self.pos)
                if lvl ≠ "error" and lvl ≠ "warning":
                    self.err("@expect names a level, error or warning")
                    return
                self.pos ← self.pos + 1
                // @expect <level> <code> ["message"], or the older
                // <level> "message"
                if self.peek() = tokens.Tk.number:
                    exp_lvl.push(if lvl = "warning": diag.DIAG_WARNING else: diag.DIAG_ERROR)
                    exp_code.push(self.toks.val[self.pos × 1¤ptrdiff])
                    self.pos ← self.pos + 1
                    if self.peek() = tokens.Tk.string:
                        self.pos ← self.pos + 1
                elif self.peek() = tokens.Tk.string:
                    // the older form names no number, so there is
                    // nothing here to match on; the interpreter matches
                    // it by its words
                    self.pos ← self.pos + 1
                else:
                    self.err("""@expect states the code it expects, and may state the message beside
                              " it; the older form states the message alone""")
                    return
                expects ← expects + 1
            elif name = "pre":
                _ ← self.eat(tokens.Tk.lpar, "'(' after @pre")
                pres.push(self.parse_expr())
                _ ← self.eat(tokens.Tk.rpar, "')' closing @pre")
            elif name = "post":
                _ ← self.eat(tokens.Tk.lpar, "'(' after @post")
                post_toks.push(self.pos)
                _ ← self.eat_name("the name @post gives the result")
                _ ← self.eat(tokens.Tk.colon, "':' after the result's name")
                posts.push(self.parse_expr())
                _ ← self.eat(tokens.Tk.rpar, "')' closing @post")
            else:
                self.err("'@" ⧺ name ⧺ "' is not core-2")
                return
            if self.peek() = tokens.Tk.nl:
                self.pos ← self.pos + 1
        if is_repr and self.peek() ≠ tokens.Tk.kw_struct:
            self.err("@repr gives a struct its layout; nothing else has one")
            return
        if is_fl and self.peek() ≠ tokens.Tk.kw_enum:
            self.err("@flag makes an enum a bit set; nothing else combines")
            return
        if is_build and self.peek() ≠ tokens.Tk.kw_fn:
            self.err("@build heads the build recipe, which is a function")
            return
        // @start, @test, @export, @replaceable and @impure are all wrong
        // on a recipe for the one reason, so it is given once: a recipe
        // runs while the program is built and nothing of it is written.
        if is_build and (imp or is_start or is_noreturn or is_test or is_repl or is_exp):
            self.err("""the @build function carries no other annotation; it is read at compile time
                      " and no code for it is written""")
            return
        if self.peek() = tokens.Tk.kw_fn:
            // A signature is held to twelve parameters here, so what
            // the @expect lines said travels on the parser rather than
            // as a thirteenth.
            self.pending_exp ← ⁻1
            if #exp_code > 0:
                self.pending_exp ← @dropunit(#self.extra)
                self.extra.push(@dropunit(#exp_code))
                foreach i := 0…#exp_code:
                    self.extra.push(exp_lvl[i])
                    self.extra.push(exp_code[i])
            self.parse_fn(imp, is_start, is_noreturn, is_test,
                          (if is_repl: 1 else: 0) + (if is_exp: 2 else: 0)
                              + (if is_build: 4 else: 0)
                              + (if is_lstb: 8 else: 0)
                              + (if is_ignb: 16 else: 0),
                          expects > 0,
                          pres, post_toks, posts, "", 0)
        elif is_exp and not (self.peek() = tokens.Tk.kw_struct or self.peek() = tokens.Tk.kw_enum or self.peek() = tokens.Tk.kw_let or self.peek() = tokens.Tk.kw_type):
            self.err("""@export says what a module lets others name, and this is not something a
                      " module holds""")
            return
        elif self.peek() = tokens.Tk.kw_struct or self.peek() = tokens.Tk.kw_impl:
            if imp or is_start or is_noreturn or is_test or #pres > 0 or #posts > 0:
                self.err("a struct carries no annotations")
            elif expects > 0:
                // a struct's expected errors are parse-time, which no
                // single pass can both report and ignore
                self.err("""@expect covers functions and globals in core-2; an expected-error struct
                          " stays in the bootstrap suite""")
            elif self.peek() = tokens.Tk.kw_struct:
                self.parse_struct(is_repr, invs)
            else:
                self.parse_impl()
        elif self.peek() = tokens.Tk.kw_unit:
            self.parse_unit_def()
        elif self.peek() = tokens.Tk.kw_type:
            self.parse_type_alias()
        elif self.peek() = tokens.Tk.kw_enum:
            self.parse_enum(is_fl)
        elif self.peek() = tokens.Tk.kw_let:
            if imp or is_start or is_noreturn or is_test or #pres > 0 or #posts > 0:
                self.err("a global binding carries no annotations")
            else:
                self.parse_global_x(expects > 0, is_exp)
        else:
            self.err("""core-2 has functions, structs, impl blocks, enums, units, type names and
                      " global bindings at the top level""")

// The whole file, every definition understood or reported.
// a name's own part, less the module it was written in
fn parse_bare(whole : str) → str:
    let cut : mut i64 ¤ptrdiff = ⁻1¤ptrdiff
    foreach i := 0¤ptrdiff…#whole:
        if whole[i] = '.':
            cut ← i
    if cut < 0¤ptrdiff:
        return whole
    whole[cut + 1¤ptrdiff…#whole]

fn parse(toks : lex.Toks, src : byte[]) → ast.Ast:
    parse_mode(toks, src, false, ast.no_mods())

// The same, told what the reader worked out about the modules.
@export
fn parse_mods(toks : lex.Toks, src : byte[], mods : ast.Mods) → ast.Ast:
    parse_mode(toks, src, false, mods)

// A recipe's own file, read before the sources it names are known.
// Most of what is written beside the recipe cannot be understood yet --
// a signature naming a struct declared in another file has nothing to
// resolve against -- so every definition is tried and one that draws
// diagnostics is dropped, its diagnostics rolled back, rather than
// reported.  What is left is the recipe and whatever parses beside it,
// which is what the recipe may reach.  A recipe that itself fails to
// parse is not dropped: that is reported, since there is then nothing
// to run.
@export
fn parse_recipe(toks : lex.Toks, src : byte[]) → ast.Ast:
    parse_mode(toks, src, true, ast.no_mods())

fn parse_mode(toks : lex.Toks, src : byte[], lenient : bool, mods : ast.Mods) → ast.Ast:
    let p : mut Parser = (Parser{mtab: mods, udecl: [], edecl: [], toks: toks, src: src, pos: 0, blets: [],
                                 nkind: [], ntok: [], na: [], nb: [], nc: [],
                                 extra: [], fns: [], qmods: [],
                                 builds: [], globals: [], structs: [],
                                 tanames: [], tatypes: [],
                                 unames: types.unit_names(), umarks: types.unit_marks(),
                                 udecay: types.unit_decays(),
                                 udname: types.unit_none_names(),
                                 udtok: types.unit_decays(),
                                 snames: [], sexp: [], eexp: [1], tts: [], ttl: [], tte: [],
                                 fae: [], fas: [], hdty: [],
                                 mel: [], mrr: [], mcc: [], mdd: [], minner: [],
                                 lts: [], ltl: [], lte: [], ltf: [], olds: [],
                                 enames: types.builtin_enum_names(),
                                 ewidth: types.builtin_enum_widths(),
                                 estart: [0], ecount: [8], eflag: [0],
                                 emembers: types.builtin_enum_members(),
                                 evalues: types.builtin_enum_values(),
                                 tvn: [], braces: 0, semi_end: false, lent: 0, ifexpr: 0,
                                 ignored: [], igtests: [],
                                 expects: [], expoff: [], pending_exp: ⁻1, def_start: 0,
                                 diags: [], poisoned: false})
    // a struct may be written below whatever names it, so the names
    // are gathered in one sweep before anything is parsed
    let n : i64 = @dropunit(#toks.kind)
    let i : mut i64 = 0
    // A struct is named by the module it is written in, so the sweep
    // walks the files alongside the tokens
    let mut_fi : mut i64 ¤ptrdiff = 0¤ptrdiff
    // Whether an @export is standing open over what comes next.  A
    // type may be named from a module read before the one declaring
    // it, so whether it may be is settled here rather than where the
    // declaration is finally read.
    let exp_open : mut i64 = 0
    while i + 1 < n:
        while mut_fi + 1¤ptrdiff < #mods.offs and mods.offs[mut_fi + 1¤ptrdiff] <= toks.off[i × 1¤ptrdiff] × 1¤byte:
            mut_fi ← mut_fi + 1¤ptrdiff
        let fmod : str = mods.names[mods.fmod[mut_fi] × 1¤ptrdiff]
        if toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_struct and toks.kind[(i + 1) × 1¤ptrdiff] = tokens.Tk.ident:
            let sn : str = tokens.run_str(src, toks.off[(i + 1) × 1¤ptrdiff],
                                   toks.len[(i + 1) × 1¤ptrdiff])
            p.snames.push(if fmod = "": sn else: fmod ⧺ "." ⧺ sn)
            p.sexp.push(exp_open)
        // A measure is gathered here too, and for the same reason a
        // struct name is: a program says what it counts in wherever it
        // is written, and which file that is in is the program's own
        // business.  A measure is one program-wide thing -- what a
        // number counts is not a module's to keep -- so no module
        // qualifies it.
        // An enum is written down here for the same reason a struct
        // is: it may be named from a module that is read before the
        // one declaring it, and what its members are is filled in when
        // the declaration itself is read.
        if toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_enum and toks.kind[(i + 1) × 1¤ptrdiff] = tokens.Tk.ident:
            let en : str = tokens.run_str(src, toks.off[(i + 1) × 1¤ptrdiff],
                                   toks.len[(i + 1) × 1¤ptrdiff])
            let ewhole : str = if fmod = "": en else: fmod ⧺ "." ⧺ en
            if p.enum_slot(ewhole) = ⁻1:
                p.enames.push(ewhole)
                p.eexp.push(exp_open)
                p.ewidth.push(types.TY_I64)
                p.estart.push(0)
                p.ecount.push(0)
                p.eflag.push(0)
        if toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_unit and toks.kind[(i + 1) × 1¤ptrdiff] = tokens.Tk.ident:
            let un : str = tokens.run_str(src, toks.off[(i + 1) × 1¤ptrdiff],
                                   toks.len[(i + 1) × 1¤ptrdiff])
            if p.unit_index(un) = ⁻1 and @dropunit(#p.unames) < 125:
                p.unames.push(un)
                p.umarks.push(un)
                p.udecay.push(0)
                p.udname.push("")
                p.udtok.push(0)
        // An annotation stands over the definition after it and no
        // further, so what opens it is the word and what closes it is
        // whatever it was written for.
        if toks.kind[i × 1¤ptrdiff] = tokens.Tk.at and toks.kind[(i + 1) × 1¤ptrdiff] = tokens.Tk.ident and tokens.run_str(src, toks.off[(i + 1) × 1¤ptrdiff], toks.len[(i + 1) × 1¤ptrdiff]) = "export":
            exp_open ← 1
        elif toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_struct or toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_enum or toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_fn or toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_let or toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_impl or toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_type or toks.kind[i × 1¤ptrdiff] = tokens.Tk.kw_unit:
            exp_open ← 0
        i ← i + 1
    while p.peek() ≠ tokens.Tk.eof:
        if p.peek() = tokens.Tk.nl:
            p.pos ← p.pos + 1
        else:
            let d0 : i64 = @dropunit(#p.diags)
            let f0 : i64 = @dropunit(#p.fns)
            let g0 : i64 = @dropunit(#p.globals)
            let b0 : i64 = @dropunit(#p.builds)
            p.parse_toplevel()
            // a definition that did not parse is dropped whole, so
            // nothing half-built is left where the recipe can call it
            if lenient and @dropunit(#p.diags) > d0 and @dropunit(#p.builds) = b0:
                while @dropunit(#p.diags) > d0:
                    _ ← p.diags.pop() ?? (diag.Diag{line: 1¤"line", col: 1¤"col", msg: "", level: diag.DIAG_ERROR, code: diag.DIAG_NONE})
                while @dropunit(#p.fns) > f0:
                    _ ← p.fns.pop() ?? p.fns[0¤ptrdiff]
                while @dropunit(#p.globals) > g0:
                    _ ← p.globals.pop() ?? p.globals[0¤ptrdiff]
            if p.poisoned:
                p.poisoned ← false
                // hunt for the next definition at the left margin
                while p.peek() ≠ tokens.Tk.eof:
                    let k2 : i64 = p.peek()
                    if k2 = tokens.Tk.indent:
                        p.skip_block()
                    elif k2 = tokens.Tk.kw_fn or k2 = tokens.Tk.kw_struct or k2 = tokens.Tk.kw_impl or k2 = tokens.Tk.kw_let or k2 = tokens.Tk.at:
                        break
                    else:
                        p.pos ← p.pos + 1
    p.resolve_decays()
    if #p.diags = 0 and not lenient:
        // the type table was built from the pre-scan; a parse that
        // succeeded must have seen the same structs in the same order.
        // A lenient parse drops what it could not understand, so its
        // structs are a subset by design.
        assert(#p.structs = #p.snames, "every pre-scanned struct parsed")
        assert(#p.nkind = #p.ntok and #p.nkind = #p.na, "node arrays in step")
        assert(#p.nkind = #p.nb and #p.nkind = #p.nc, "node arrays in step")
    (ast.Ast{blets: p.blets, nkind: p.nkind, ntok: p.ntok, na: p.na, nb: p.nb, nc: p.nc,
         extra: p.extra, strs: p.toks.strs, fns: p.fns,
         qmods: p.qmods, mnames: mods.names, mroots: mods.roots,
         builds: p.builds,
         globals: p.globals,
         structs: p.structs, tts: p.tts, ttl: p.ttl, tte: p.tte,
         fae: p.fae, fas: p.fas, hdty: p.hdty,
         mel: p.mel, mrr: p.mrr, mcc: p.mcc, mdd: p.mdd, minner: p.minner,
         lts: p.lts, ltl: p.ltl, lte: p.lte, ltf: p.ltf,
         unames: p.unames, umarks: p.umarks, udecay: p.udecay,
         enames: p.enames, ewidth: p.ewidth, estart: p.estart,
         ecount: p.ecount, eflag: p.eflag, emembers: p.emembers,
         evalues: p.evalues,
         ignored: p.ignored, igtests: p.igtests,
         expects: p.expects, expoff: p.expoff, diags: p.diags})
