// ===========================================================================
// Parsing: tokens → Ast
// ===========================================================================

struct Parser:
    toks : Toks
    src : byte[]
    pos : i64
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    fns : FnDef[]
    curmod : str         // the module the definitions being read live in
    mods : str[]         // the modules declared so far, whole names
    qmods : str[]        // the module each qualified call names
    modtok : i64[]       // … and where each was written
    builds : FnDef[]     // the @build recipe, kept apart from the rest
    globals : GlobalDef[]
    structs : SDef[]
    tanames : str[]      // the names standing for types, and what they stand for
    tatypes : i64[]
    unames : str[]       // the measures this file knows, builtin then defined
    udecay : i64[]       // … and what each may stand in for
    udname : str[]       // … as written, until the file has been read
    udtok : i64[]        // … and where it was written
    umarks : str[]       // … and how each one prints
    snames : str[]       // struct names, pre-scanned so a struct may
                         // be written below whatever names it
    tts : i64[]          // interned tuple shapes, moved into the Ast
    ttl : i64[]
    tte : i64[]
    fae : i64[]
    fas : i64[]
    mel : i64[]
    mrr : i64[]
    mcc : i64[]
    mdd : i64[]
    minner : i64[]
    lts : i64[]
    ltl : i64[]
    lte : i64[]
    enames : str[]
    ewidth : i64[]
    estart : i64[]
    ecount : i64[]
    eflag : i64[]
    emembers : str[]
    evalues : i64[]
    tvn : str[]          // type-variable spellings, interned file-wide
    braces : i64         // statements end at ';' inside a brace block
    ignored : str[]
    igtests : str[]
    diags : Diag[]
    poisoned : bool      // the statement at hand already misparsed

impl Parser:
    fn peek(&self) → i64:
        self.toks.kind[self.pos × 1¤ptrdiff]

    fn peek2(&self) → i64:
        self.toks.kind[(self.pos + 1) × 1¤ptrdiff]

    fn ttext(&self, at : i64) → str:
        run_str(self.src, self.toks.off[at × 1¤ptrdiff],
                self.toks.len[at × 1¤ptrdiff])

    fn failed(&self) → bool:
        self.poisoned

    // a complaint about something already read points back at it, since
    // by the time it is noticed self.pos has moved past
    fn err_at(&mut self, tok : i64, m : str):
        if not self.poisoned:
            let at ¤ptrdiff : i64 = tok
            self.diags.push(Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m})
        self.poisoned ← true

    fn err(&mut self, m : str):
        if not self.poisoned:
            let at ¤ptrdiff : i64 = self.pos
            self.diags.push(Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m})
        self.poisoned ← true
        if #self.diags >= 20:
            // enough; parking on the closing EOF stops everything
            self.pos ← @dropunit(#self.toks.kind) - 1

    // skip what is left of the misparsed statement and start clean on
    // the next line; the block structure survives through the
    // indentation tokens
    fn sync(&mut self):
        self.poisoned ← false
        while true:
            let k : i64 = self.peek()
            if k = TK_EOF or k = TK_DEDENT:
                return
            self.pos ← self.pos + 1
            if k = TK_NL:
                return

    fn eat(&mut self, k : i64, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() ≠ k:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // a name where the bootstrap's reserved words are refused by name
    fn eat_name(&mut self, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() = TK_RESERVED:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return at
        if self.peek() ≠ TK_IDENT:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // an annotation or std-member name: reserved words are fine here,
    // since @start and std.println spell some of them
    fn eat_word(&mut self, what : str) → i64:
        let at : i64 = self.pos
        // a member's or field's name may be any word, including one
        // the language keeps for itself elsewhere: 'type' names a type
        // at the top level and a directory entry's kind after a dot
        if self.peek() ≠ TK_IDENT and self.peek() ≠ TK_RESERVED and self.peek() ≠ TK_TYPE and self.peek() ≠ TK_ENUM:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    fn mknode(&mut self, k : i64, tok : i64, a : i64, b : i64, c : i64) → i64:
        let id : i64 = @dropunit(#self.nkind)
        self.nkind.push(k)
        self.ntok.push(tok)
        self.na.push(a)
        self.nb.push(b)
        self.nc.push(c)
        id

    fn push_list(&mut self, items : i64[]) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#items))
        foreach a := items:
            self.extra.push(a)
        off

    // ------------------------------------------------------------------
    // Types
    // ------------------------------------------------------------------

    // [&[mut]] base [¤unit] [[]]; refs are only meaningful on
    // parameters and the caller of parse_type says whether they may be
    fn parse_type(&mut self, allow_ref : bool) → i64:
        let refk : mut i64 = 0
        if self.peek() = TK_BAND:
            if not allow_ref:
                self.err("a borrow is written on a parameter, not here")
                return TY_I64
            self.pos ← self.pos + 1
            refk ← 1
            if self.peek() = TK_MUT:
                self.pos ← self.pos + 1
                refk ← 2
        if self.peek() = TK_LPAR:
            // (T1, T2, …): a tuple type
            self.pos ← self.pos + 1
            if refk ≠ 0:
                self.err("a core-2 tuple is not borrowed; it is returned and taken apart")
                return TY_I64
            let es : mut i64[] = []
            while true:
                let et : i64 = self.parse_type(false)
                if not ((ty_is_int(et) and ty_unit(et) = 0) or et = TY_BOOL or et = TY_STR or et = TY_CHAR or ty_is_struct(et) or ty_is_opt(et)):
                    self.err("a core-2 tuple holds plain integers, truth values, characters, strings, structs or optionals")
                    return TY_I64
                es.push(et)
                if self.failed():
                    return TY_I64
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
            _ ← self.eat(TK_RPAR, "')' closing the tuple type")
            if #es < 2:
                self.err("a tuple type holds at least two elements; (T) is just T")
                return TY_I64
            if self.peek() = TK_QMARK:
                // a tuple is a pointer to its elements, so an optional
                // one is that pointer in a box, as any optional is
                self.pos ← self.pos + 1
                return mk_oty(mk_tty(self.tup_intern(es)))
            if self.peek() = TK_LBRACK:
                self.err("an array of tuples is not core-2 yet")
                return TY_I64
            return mk_tty(self.tup_intern(es))
        if self.peek() = TK_INT:
            self.err("'" ⧺ self.ttext(self.pos) ⧺ "' does not name a type; a type is written by name, as i64")
            return TY_I64
        let name := self.ttext(self.pos)
        _ ← self.eat_name("a type name")
        let stdbase : mut i64 = ⁻1
        if name = "std":
            _ ← self.eat(TK_DOT, "'.' after std")
            let m := self.ttext(self.pos)
            _ ← self.eat_word("the std type's name")
            if m = "dict":
                _ ← self.eat(TK_LPAR, "'(' after std.dict")
                let kt : i64 = self.parse_type(false)
                _ ← self.eat(TK_COMMA, "',' between the key and value types")
                let vt : i64 = self.parse_type(false)
                _ ← self.eat(TK_RPAR, "')' closing std.dict")
                if not ((ty_is_int(kt) and ty_unit(kt) = 0) or kt = TY_STR):
                    self.err("a core-2 dictionary key is a plain integer or a string")
                    return TY_I64
                if not ((ty_is_int(vt) and ty_unit(vt) = 0) or vt = TY_BOOL or vt = TY_STR or ty_is_struct(vt)):
                    self.err("a core-2 dictionary holds integers, truth values, strings or structs")
                    return TY_I64
                if refk ≠ 0:
                    return mk_hty(kt, vt) + 262144 × refk
                return mk_hty(kt, vt)
            if m = "hash":
                // this type's name until std.hash became the digests
                self.err("'std.hash' is the digests now; the type that maps keys to values is 'std.dict(K, V)'")
                return TY_I64
            if m ≠ "iovec":
                self.err("'std." ⧺ m ⧺ "' is not a core-2 type; std.dict(K, V) and std.iovec are")
                return TY_I64
            // a run of bytes waiting to be written; what it holds is
            // settled where it is made, not where it is named, so the
            // name carries nothing with it
            stdbase ← TY_IOVEC
        if #name >= 2 and name[#name - 1] = '\'':
            // a type variable: whatever the call hands over
            let tv : mut i64 = ⁻1
            if #self.tvn > 0:
                foreach i := 0…#self.tvn - 1:
                    if self.tvn[i] = name:
                        tv ← 194048 + @dropunit(i)
            if tv = ⁻1:
                if #self.tvn >= 32:
                    self.err("this file spells more than 32 type variables")
                    return TY_I64
                tv ← 194048 + @dropunit(#self.tvn)
                self.tvn.push(name)
            if self.peek() = TK_LBRACK or self.peek() = TK_QMARK or self.peek() = TK_CURRENCY:
                self.err("a type variable stands alone; it carries no suffix")
                return TY_I64
            if refk ≠ 0:
                self.err("a type variable travels by value")
                return TY_I64
            return tv
        let base0 : i64 = stdbase if stdbase ≠ ⁻1 else (TYNAMES[name] ?? self.sindex_ty(name))
        if base0 = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a core-2 type")
            return TY_I64
        let base : mut i64 = base0
        if self.peek() = TK_CURRENCY:
            self.pos ← self.pos + 1
            // ¤name for a measure the language knows and ¤"name" for
            // one the file defined, the same two spellings a binding
            // takes -- a return type and a field are written the way a
            // parameter is or they are not written the same language
            let uname : mut str = ""
            if self.peek() = TK_STR:
                uname ← self.toks.strs[self.toks.val[self.pos × 1¤ptrdiff] × 1¤ptrdiff]
                self.pos ← self.pos + 1
            else:
                uname ← self.ttext(self.pos)
                _ ← self.eat_word("the unit's name")
            if not ty_is_int(base):
                self.err("only an integer carries a unit")
            else:
                let uix : i64 = self.unit_index(uname)
                if uix ≠ ⁻1:
                    base ← ty_with_unit(base, uix)
                else:
                    self.err("'¤" ⧺ uname ⧺ "' is no measure this file knows")
        if self.peek() = TK_LBRACK:
            self.pos ← self.pos + 1
            if not ty_is_int(base) and not ty_is_struct(base) and not ty_is_enum(base) and base ≠ TY_CHAR and base ≠ TY_STR and base ≠ TY_BOOL and base ≠ TY_IOVEC:
                self.err("a core-2 array holds plain integers, truth values, characters, strings or structs")
                return TY_I64
            let d0 : mut i64 = ⁻1
            if self.peek() = TK_INT:
                // T[n]: the size is part of the type
                if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                    self.err("a sized array states its size as a plain number")
                    return TY_I64
                d0 ← self.toks.val[self.pos × 1¤ptrdiff]
                self.pos ← self.pos + 1
            if self.peek() = TK_COMMA:
                // T[,] and its sized kin: a matrix, its rows one type
                self.pos ← self.pos + 1
                if ty_is_struct(base):
                    self.err("a core-2 matrix holds plain integers, truth values, characters or strings")
                    return TY_I64
                let d1 : mut i64 = ⁻1
                if self.peek() = TK_INT:
                    if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                        self.err("a matrix states its extents as plain numbers")
                        return TY_I64
                    d1 ← self.toks.val[self.pos × 1¤ptrdiff]
                    self.pos ← self.pos + 1
                let d2 : mut i64 = ⁻2
                if self.peek() = TK_COMMA:
                    // T[,,]: a cube, its planes one matrix type
                    self.pos ← self.pos + 1
                    d2 ← ⁻1
                    if self.peek() = TK_INT:
                        if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                            self.err("a matrix states its extents as plain numbers")
                            return TY_I64
                        d2 ← self.toks.val[self.pos × 1¤ptrdiff]
                        self.pos ← self.pos + 1
                    if self.peek() = TK_COMMA:
                        self.err("a rank-4 array is not core-2 yet")
                        return TY_I64
                _ ← self.eat(TK_RBRACK, "']' closing the matrix type")
                if d0 = 0 or d1 = 0 or d2 = 0:
                    self.err("a matrix has at least one row and one column")
                    return TY_I64
                base ← mk_mty(self.mat_intern(base, d0, d1, d2))
            elif d0 ≠ ⁻1:
                _ ← self.eat(TK_RBRACK, "']' closing the sized array type")
                base ← mk_fty(self.farr_intern(base, d0))
            else:
                _ ← self.eat(TK_RBRACK, "']' closing the array type")
                base ← mk_aty(base)
        if self.peek() = TK_QMARK or self.peek() = TK_BANG:
            // T? and T!: the expected rides the optional's box; what an
            // error carries beyond absence is not core-2 yet
            self.pos ← self.pos + 1
            if ty_is_mat(base):
                self.err("an optional matrix is not core-2 yet")
                return TY_I64
            if ty_is_arr(base):
                self.err("an optional array is not core-2 yet")
                return TY_I64
            if ty_is_hash(base):
                self.err("an optional dictionary is not core-2 yet")
                return TY_I64
            base ← mk_oty(base)
        if refk ≠ 0 and not ty_is_arr(base) and not ty_is_struct(base) and not ty_is_hash(base):
            self.err("core-2 borrows arrays, structs and dictionaries; a scalar travels by value")
            return TY_I64
        base + 262144 × refk

    // a tuple shape is interned so equal shapes share one type code,
    // and type equality stays one integer comparison
    fn tup_intern(&mut self, es : i64[]) → i64:
        let n : i64 = @dropunit(#es)
        let m : i64 = @dropunit(#self.tts)
        let sh : mut i64 = 0
        while sh < m:
            if self.ttl[sh × 1¤ptrdiff] = n:
                let st : i64 = self.tts[sh × 1¤ptrdiff]
                let same : mut bool = true
                let i : mut i64 = 0
                while i < n:
                    same ← same and self.tte[(st + i) × 1¤ptrdiff] = es[i × 1¤ptrdiff]
                    i ← i + 1
                if same:
                    return sh
            sh ← sh + 1
        self.tts.push(@dropunit(#self.tte))
        self.ttl.push(n)
        let j : mut i64 = 0
        while j < n:
            self.tte.push(es[j × 1¤ptrdiff])
            j ← j + 1
        m

    fn farr_intern(&mut self, elem : i64, size : i64) → i64:
        let m : i64 = @dropunit(#self.fae)
        let i : mut i64 = 0
        while i < m:
            if self.fae[i × 1¤ptrdiff] = elem and self.fas[i × 1¤ptrdiff] = size:
                return i
            i ← i + 1
        self.fae.push(elem)
        self.fas.push(size)
        m

    // equal lambda signatures share one type code, as tuple shapes do
    fn lam_intern(&mut self, pts : i64[], ret : i64) → i64:
        let n : i64 = @dropunit(#pts)
        let m : i64 = @dropunit(#self.ltl)
        let sh : mut i64 = 0
        while sh < m:
            if self.ltl[sh × 1¤ptrdiff] = n:
                let st : i64 = self.lts[sh × 1¤ptrdiff]
                let same : mut bool = self.lte[(st + n) × 1¤ptrdiff] = ret
                let i : mut i64 = 0
                while i < n:
                    same ← same and self.lte[(st + i) × 1¤ptrdiff] = pts[i × 1¤ptrdiff]
                    i ← i + 1
                if same:
                    return sh
            sh ← sh + 1
        self.lts.push(@dropunit(#self.lte))
        self.ltl.push(n)
        let j : mut i64 = 0
        while j < n:
            self.lte.push(pts[j × 1¤ptrdiff])
            j ← j + 1
        self.lte.push(ret)
        m

    // equal matrix shapes share one type code, as tuple shapes do
    fn mat_intern(&mut self, elem : i64, r : i64, c : i64, d : i64) → i64:
        let m : i64 = @dropunit(#self.mel)
        let i : mut i64 = 0
        while i < m:
            if self.mel[i × 1¤ptrdiff] = elem and self.mrr[i × 1¤ptrdiff] = r and self.mcc[i × 1¤ptrdiff] = c and self.mdd[i × 1¤ptrdiff] = d:
                return i
            i ← i + 1
        // What one subscript answers is settled here, where a shape may
        // still be interned, so that reading it later -- from a &self
        // that cannot intern -- is a plain lookup.
        let inner : mut i64 = mk_rty(elem)
        if d ≠ ⁻2:
            inner ← mk_mty(self.mat_intern(elem, c, d, ⁻2))
        // interning the plane may have grown the table, so where this
        // shape lands is asked again and not remembered from the scan
        let at : i64 = @dropunit(#self.mel)
        self.mel.push(elem)
        self.mrr.push(r)
        self.mcc.push(c)
        self.mdd.push(d)
        self.minner.push(inner)
        assert(#self.mel = #self.minner and #self.mel = #self.mdd, "shape table arrays in step")
        at

    // the pre-scanned struct names answer for a name TYNAMES does not
    fn sindex_ty(&self, name : str) → i64:
        // from NBUILTIN_ENUMS on: a builtin enum is a value under std,
        // not a type a program may write down, which is how the
        // interpreter has it
        if @dropunit(#self.enames) > NBUILTIN_ENUMS:
            foreach i := NBUILTIN_ENUMS × 1¤ptrdiff…#self.enames - 1:
                if self.enames[i] = name:
                    return mk_ety(@dropunit(i))
        // a name standing for a type answers what it stands for
        if #self.tanames > 0:
            foreach i := 0…#self.tanames - 1:
                if self.tanames[i] = name:
                    return self.tatypes[i]
        if #self.snames > 0:
            foreach i := 0…#self.snames - 1:
                if self.snames[i] = name:
                    return mk_sty(@dropunit(i))
        ⁻1

    // the ¤unit that may follow a binding's or parameter's name
    fn unit_index(&self, name : str) → i64:
        foreach i := 1…#self.unames - 1:
            if self.unames[i] = name:
                return @dropunit(i)
        ⁻1

    // A measure written before the type measures what an array holds,
    // the way it measures a bare number: `xs ¤meter : i64[]` is an
    // array of lengths and not an array that is itself a length.  A
    // binding, a parameter and a field all write it the same way, so
    // they all settle it here.  `what` names the thing for the
    // complaint, since a field's reads better than a binding's.
    fn unit_on_type(&mut self, ty : i64, u : i64, what : str) → i64:
        if ty_is_arr(ty) and not ty_is_farr(ty) and ty_is_int(ty_elem(ty)):
            if ty_unit(ty_elem(ty)) ≠ 0 and ty_unit(ty_elem(ty)) ≠ u:
                self.err("the name and the type say different units")
                return ty
            return mk_aty(ty_with_unit(ty_elem(ty), u))
        if not ty_is_int(ty):
            self.err("only an integer" ⧺ what ⧺ " carries a unit")
            return ty
        if ty_unit(ty) ≠ 0 and ty_unit(ty) ≠ u:
            self.err("the name and the type say different units")
            return ty
        ty_with_unit(ty, u)

    fn parse_name_unit(&mut self) → i64:
        if self.peek() ≠ TK_CURRENCY:
            return UNIT_NONE
        self.pos ← self.pos + 1
        // ¤name for one the language knows, ¤"name" for one the file
        // defined, as the specification writes them
        let uname : mut str = ""
        if self.peek() = TK_STR:
            uname ← self.toks.strs[self.toks.val[self.pos × 1¤ptrdiff] × 1¤ptrdiff]
            self.pos ← self.pos + 1
        else:
            uname ← self.ttext(self.pos)
            _ ← self.eat_word("the unit's name")
        let u : i64 = self.unit_index(uname)
        if u ≠ ⁻1:
            return u
        self.err("'¤" ⧺ uname ⧺ "' is no measure this file knows")
        UNIT_NONE

    // ------------------------------------------------------------------
    // Expressions, by precedence climbing
    // ------------------------------------------------------------------

    fn parse_args(&mut self) → i64:
        _ ← self.eat(TK_LPAR, "'('")
        let args : mut i64[] = []
        if self.peek() ≠ TK_RPAR:
            while true:
                if self.peek() = TK_BAND:
                    // &x hands the callee the array itself; whether it
                    // may write is the parameter's declaration
                    let at : i64 = self.pos
                    self.pos ← self.pos + 1
                    if self.peek() = TK_MUT:
                        self.err("a borrow at a call is written &name; &mut is the parameter's side")
                        return ⁻1
                    let vtok : i64 = self.pos
                    _ ← self.eat_name("the borrowed name")
                    let v : i64 = self.mknode(NK_VAR, vtok, 0, 0, 0)
                    args.push(self.mknode(NK_REF, at, v, 1, 0))
                else:
                    args.push(self.parse_expr())
                if self.failed(): return ⁻1
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(TK_RPAR, "')' after the arguments")
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#args))
        foreach a := args:
            self.extra.push(a)
        off

    // postfix: indexing and method calls chain off a primary
    // λx : T, y : T |cap| → R: expr — the captures are read where the
    // lambda is written, by value, and the body is one expression
    fn parse_lambda(&mut self, at : i64) → i64:
        self.pos ← self.pos + 1
        // shapes an @expect means to refuse still have to parse; the
        // checker is where they are refused, so 'bad' rides along
        let bad : mut i64 = 0
        let ptoks : mut i64[] = []
        let pts : mut i64[] = []
        while true:
            let ptok : i64 = self.pos
            _ ← self.eat_name("the parameter's name")
            if self.peek() ≠ TK_COLON:
                bad ← 2
                ptoks.push(ptok)
                pts.push(TY_I64)
            else:
                self.pos ← self.pos + 1
                let pt : i64 = self.parse_type(false)
                if not ((ty_is_int(pt) and ty_unit(pt) = 0) or pt = TY_BOOL or pt = TY_CHAR or pt = TY_STR):
                    self.err("a core-2 lambda takes plain integers, truth values, characters and strings")
                    return self.mknode(NK_INT, at, 0, 0, 0)
                ptoks.push(ptok)
                pts.push(pt)
            if self.failed():
                return self.mknode(NK_INT, at, 0, 0, 0)
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
            else:
                break
        if #pts > 5:
            self.err("a core-2 lambda takes at most five parameters")
            return self.mknode(NK_INT, at, 0, 0, 0)
        let caps : mut i64[] = []
        if self.peek() = TK_BOR:
            self.pos ← self.pos + 1
            while self.peek() ≠ TK_BOR and not self.failed():
                let ctok : i64 = self.pos
                _ ← self.eat_name("the captured name")
                caps.push(ctok)
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
            _ ← self.eat(TK_BOR, "'|' closing the capture list")
            if #caps = 0 and bad = 0:
                bad ← 1
        let ret : mut i64 = TY_UNIT
        if self.peek() ≠ TK_ARROW:
            if bad = 0:
                bad ← 3
            ret ← TY_I64
        else:
            self.pos ← self.pos + 1
            if self.peek() = TK_EMPTY:
                // parsed so an @expect may hold it; the checker refuses it
                self.pos ← self.pos + 1
            else:
                ret ← self.parse_type(false)
                let rb : i64 = ty_opt_base(ret) if ty_is_opt(ret) else ret
                if not ((ty_is_int(rb) and ty_unit(rb) = 0) or rb = TY_BOOL or rb = TY_CHAR or rb = TY_STR):
                    self.err("a core-2 lambda answers a plain integer, a truth value, a character or a string")
                    return self.mknode(NK_INT, at, 0, 0, 0)
        let body : mut i64 = ⁻1
        if self.peek() = TK_COLON and self.peek2() = TK_NL:
            // a layout block, statement by statement, as a function's
            body ← self.parse_block()
        elif self.peek() = TK_COLON and self.peek2() = TK_LBRACE:
            _ ← self.eat(TK_COLON, "':' and the lambda's body")
            body ← self.parse_brace_block()
        else:
            _ ← self.eat(TK_COLON, "':' and the lambda's body")
            body ← self.parse_expr()
        if bad ≠ 0:
            return self.mknode(NK_BADLAM, at, bad, 0, 0)
        let li : i64 = self.lam_intern(pts, ret)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#pts))
        foreach i := 0…#pts - 1:
            self.extra.push(ptoks[i])
            self.extra.push(pts[i])
        self.extra.push(@dropunit(#caps))
        if #caps > 0:
            foreach i := 0…#caps - 1:
                self.extra.push(caps[i])
        self.extra.push(ret)
        self.mknode(NK_LAMBDA, at, off, body, li)

    // { s; s; e }: the braces hold statements where layout cannot go,
    // inside parentheses; ';' separates them and the last is the value
    fn parse_brace_block(&mut self) → i64:
        _ ← self.eat(TK_LBRACE, "'{' opening the block")
        self.braces ← self.braces + 1
        let stmts : mut i64[] = []
        while self.peek() ≠ TK_RBRACE and not self.failed():
            stmts.push(self.parse_stmt())
        self.braces ← self.braces - 1
        _ ← self.eat(TK_RBRACE, "'}' closing the block")
        let off : i64 = self.push_list(stmts)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    fn parse_postfix(&mut self, base0 : i64) → i64:
        let e : mut i64 = base0
        while not self.failed():
            if self.peek() = TK_LBRACK:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let idx : i64 = self.parse_expr()
                if self.nkind[idx × 1¤ptrdiff] = NK_RANGEV:
                    // v[a…b]: both ends included, a fresh array answers
                    if self.nc[idx × 1¤ptrdiff] ≠ ⁻1:
                        self.err("a stepped slice is not core-2 yet")
                        return e
                    if self.peek() = TK_COMMA:
                        // m[rows, cols] and m[rows, i]: a range of rows
                        // cut down the other way.  Neither can hand back
                        // rows the matrix already holds, so both build
                        // what they answer.
                        self.pos ← self.pos + 1
                        let cidx : i64 = self.parse_expr()
                        if self.peek() = TK_COMMA:
                            self.err("a rank-3 subscript is not core-2 yet")
                            return e
                        _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                        let moff : i64 = @dropunit(#self.extra)
                        self.extra.push(self.na[idx × 1¤ptrdiff])
                        self.extra.push(self.nb[idx × 1¤ptrdiff])
                        if self.nkind[cidx × 1¤ptrdiff] = NK_RANGEV:
                            if self.nc[cidx × 1¤ptrdiff] ≠ ⁻1:
                                self.err("a stepped slice is not core-2 yet")
                                return e
                            self.extra.push(self.na[cidx × 1¤ptrdiff])
                            self.extra.push(self.nb[cidx × 1¤ptrdiff])
                            e ← self.mknode(NK_MSLICE, at, e, moff, 0)
                        else:
                            // one column: an element from each row, so
                            // what answers is an array and not a matrix
                            self.extra.push(cidx)
                            self.extra.push(⁻1)
                            e ← self.mknode(NK_MSLICE, at, e, moff, 1)
                        continue
                    _ ← self.eat(TK_RBRACK, "']' closing the slice")
                    e ← self.mknode(NK_SLICE, at, e, self.na[idx × 1¤ptrdiff], self.nb[idx × 1¤ptrdiff])
                elif self.peek() = TK_COMMA:
                    // m[i, j] and m[i, a…b] reach the row and ask it,
                    // so the pair is the chain m[i][j] written short
                    self.pos ← self.pos + 1
                    e ← self.mknode(NK_INDEX, at, e, idx, 0)
                    let jdx : i64 = self.parse_expr()
                    if self.peek() = TK_COMMA and self.nkind[jdx × 1¤ptrdiff] ≠ NK_RANGEV:
                        // c[i, j, k]: one step further in, one more link
                        self.pos ← self.pos + 1
                        e ← self.mknode(NK_INDEX, at, e, jdx, 0)
                        let kdx : i64 = self.parse_expr()
                        if self.peek() = TK_COMMA:
                            self.err("a rank-4 subscript is not core-2 yet")
                            return e
                        if self.nkind[kdx × 1¤ptrdiff] = NK_RANGEV:
                            if self.nc[kdx × 1¤ptrdiff] ≠ ⁻1:
                                self.err("a stepped slice is not core-2 yet")
                                return e
                            _ ← self.eat(TK_RBRACK, "']' closing the slice")
                            e ← self.mknode(NK_SLICE, at, e, self.na[kdx × 1¤ptrdiff], self.nb[kdx × 1¤ptrdiff])
                        else:
                            _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                            e ← self.mknode(NK_INDEX, at, e, kdx, 0)
                        continue
                    if self.peek() = TK_COMMA:
                        self.err("a rank-3 subscript is not core-2 yet")
                        return e
                    if self.nkind[jdx × 1¤ptrdiff] = NK_RANGEV:
                        if self.nc[jdx × 1¤ptrdiff] ≠ ⁻1:
                            self.err("a stepped slice is not core-2 yet")
                            return e
                        _ ← self.eat(TK_RBRACK, "']' closing the slice")
                        e ← self.mknode(NK_SLICE, at, e, self.na[jdx × 1¤ptrdiff], self.nb[jdx × 1¤ptrdiff])
                    else:
                        _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                        e ← self.mknode(NK_INDEX, at, e, jdx, 0)
                else:
                    _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                    e ← self.mknode(NK_INDEX, at, e, idx, 0)
            elif self.peek() = TK_LPAR:
                // (…) after a value: the value is applied
                let at : i64 = self.pos
                let coff : i64 = self.parse_args()
                e ← self.mknode(NK_CALLV, at, e, coff, 0)
            elif self.peek() = TK_QMARK:
                // e?: absence answers the function early
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                e ← self.mknode(NK_TRY, at, e, 0, 0)
            elif self.peek() = TK_DOT:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let mtok : i64 = self.pos
                _ ← self.eat_word("the member's name")
                if self.peek() = TK_LPAR:
                    let off : i64 = self.parse_args()
                    e ← self.mknode(NK_MCALL, mtok, e, off, 0)
                else:
                    e ← self.mknode(NK_FIELD, mtok, e, 0, 0)
            else:
                break
        e

    fn parse_primary(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = TK_LAMBDA:
            return self.parse_lambda(at)
        if k = TK_INT:
            self.pos ← self.pos + 1
            // A measure the file declared reaches the literal here
            // rather than in the lexer, which settled the built-in ones
            // and left this one as a ¤ and a name of its own.
            let big0 : i64 = self.toks.big[at × 1¤ptrdiff]
            let big : mut i64 = big0
            if self.peek() = TK_CURRENCY:
                let u : i64 = self.parse_name_unit()
                let st : i64 = big0 » 1
                if not ty_is_int(st if st ≠ 0 else TY_I64):
                    self.err("only an integer carries a unit")
                else:
                    big ← (big0 & 1) + ty_with_unit(st if st ≠ 0 else TY_I64, u) × 2
            let lit : i64 = self.mknode(NK_INT, at, self.toks.val[at × 1¤ptrdiff],
                                        big, 0)
            // 'a'.ord() reads on; a number's method wants parentheses,
            // as the bootstrap has it
            if big » 1 = TY_CHAR:
                return self.parse_postfix(lit)
            return lit
        if k = TK_TRUE or k = TK_FALSE:
            self.pos ← self.pos + 1
            return self.mknode(NK_BOOL, at, 1 if k = TK_TRUE else 0, 0, 0)
        if k = TK_STR:
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(NK_STR, at, self.toks.val[at × 1¤ptrdiff], 0, 0))
        if k = TK_NEG:
            self.pos ← self.pos + 1
            // ⁻ against a literal is part of it, as the language says
            if self.peek() = TK_INT:
                let vt : i64 = self.pos
                self.pos ← self.pos + 1
                if self.toks.big[vt × 1¤ptrdiff] & 1 = 1:
                    self.err("the literal is past i64; ⁻ has nothing to negate")
                    return 0
                if self.toks.big[vt × 1¤ptrdiff] » 1 = TY_CHAR:
                    self.err("⁻ negates a number, not a character")
                    return 0
                // the refusal above keeps the value inside i64, so
                // nothing wraps today; the annotation is what makes
                // that still true if ⁻9223372036854775808 is ever
                // admitted, which is the one value that would
                return self.mknode(NK_INT, vt,
                                   @wrap(0 - self.toks.val[vt × 1¤ptrdiff]),
                                   self.toks.big[vt × 1¤ptrdiff], 0)
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_NEG, at, e, 0, 0)
        if k = TK_BNOT:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_BNOT, at, e, 0, 0)
        if k = TK_NOT or k = TK_LNOT:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_NOT, at, e, 0, 0)
        if k = TK_EXISTS:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_LPAR, "'(' after ∃")
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing ∃")
            return self.mknode(NK_SOME, at, e, 0, 0)
        if k = TK_EMPTY:
            self.pos ← self.pos + 1
            return self.mknode(NK_EMPTYV, at, 0, 0, 0)
        if k = TK_LHASH:
            self.pos ← self.pos + 1
            let items : mut i64[] = []
            if self.peek() ≠ TK_RHASH:
                while true:
                    items.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() ≠ TK_COLON:
                        self.err("a set is not core-2 yet; a dictionary writes key: value")
                        return 0
                    self.pos ← self.pos + 1
                    items.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = TK_COMMA:
                        self.pos ← self.pos + 1
                    else:
                        break
            _ ← self.eat(TK_RHASH, "'⸩' closing the dictionary literal")
            let off : i64 = @dropunit(#self.extra)
            self.extra.push((@dropunit(#items) ÷ 2) ?? 0)
            foreach it := items:
                self.extra.push(it)
            return self.mknode(NK_HLIT, at, off, 0, 0)
        if k = TK_HASH:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_LEN, at, e, 0, 0)
        if k = TK_LPAR:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_expr()
            if self.peek() = TK_COMMA:
                // (a, b, …): a tuple literal
                let elems : mut i64[] = [e]
                while self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                _ ← self.eat(TK_RPAR, "')' closing the tuple")
                let toff : i64 = self.push_list(elems)
                return self.mknode(NK_TUPLE, at, toff, 0, 0)
            _ ← self.eat(TK_RPAR, "')' closing the parenthesis")
            return self.parse_postfix(e)
        if k = TK_LBRACK:
            self.pos ← self.pos + 1
            let elems : mut i64[] = []
            if self.peek() ≠ TK_RBRACK:
                while true:
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = TK_COMMA:
                        self.pos ← self.pos + 1
                        if self.peek() = TK_RBRACK:
                            break
                    else:
                        break
            _ ← self.eat(TK_RBRACK, "']' closing the array literal")
            let off : i64 = self.push_list(elems)
            return self.mknode(NK_ARRLIT, at, off, 0, 0)
        if k = TK_AT:
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            if name = "typeof":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_LPAR, "'(' after @typeof")
                let te : i64 = self.parse_expr()
                _ ← self.eat(TK_RPAR, "')' closing @typeof")
                return self.mknode(NK_TYPEOF, at, te, 0, 0)
            if name = "sizeof":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_LPAR, "'(' after @sizeof")
                let se : i64 = self.parse_expr()
                _ ← self.eat(TK_RPAR, "')' closing @sizeof")
                return self.mknode(NK_SIZEOF, at, se, 0, 0)
            if name = "dropunit":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_LPAR, "'(' after @dropunit")
                let e0 : i64 = self.parse_expr()
                _ ← self.eat(TK_RPAR, "')' closing @dropunit")
                return self.mknode(NK_DROPU, at, e0, 0, 0)
            if name ≠ "wrap":
                self.err("'@" ⧺ name ⧺ "' is not core-2; @wrap, @dropunit and @sizeof are the expression annotations")
                return 0
            self.pos ← self.pos + 1
            _ ← self.eat(TK_LPAR, "'(' after @wrap")
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing @wrap")
            return self.mknode(NK_WRAP, at, e, 0, 0)
        if k = TK_IDENT:
            let name := self.ttext(at)
            // `a.b.f(…)` where a.b is a module: the longest run of
            // identifiers that names one is the module, and what
            // follows it is the name being asked of it.  Read here
            // because further on it would be a field of a.
            let qn : i64 = self.module_prefix(at)
            if qn ≠ ⁻1:
                return self.parse_qualified(at, qn)
            if name = "std":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_DOT, "'.' after std")
                let mtok : i64 = self.pos
                let m := self.ttext(mtok)
                _ ← self.eat_word("the std member's name")
                if m = "implementation":
                    return self.parse_implementation(at)
                if m = "args":
                    _ ← self.eat(TK_DOT, "'.' after std.args")
                    if self.ttext(self.pos) ≠ "all":
                        self.err("'std.args." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; all() is")
                        return 0
                    self.pos ← self.pos + 1
                    let aoff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_ARGS, aoff, 0)
                if m = "process":
                    return self.parse_process(at)
                if m = "env":
                    _ ← self.eat(TK_DOT, "'.' after std.env")
                    let em0 := self.ttext(self.pos)
                    let esb : mut i64 = ⁻1
                    if em0 = "names": esb ← SB_ENVN
                    elif em0 = "get": esb ← SB_ENVG
                    elif em0 = "has": esb ← SB_ENVH
                    else:
                        self.err("'std.env." ⧺ em0 ⧺ "' is not core-2; names(), get() and has() are")
                        return 0
                    self.pos ← self.pos + 1
                    let eoff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, esb, eoff, 0)
                if m = "build":
                    _ ← self.eat(TK_DOT, "'.' after std.build")
                    let bm := self.ttext(self.pos)
                    let bsb : mut i64 = ⁻1
                    if bm = "source": bsb ← SB_BSRC
                    elif bm = "output": bsb ← SB_BOUT
                    elif bm = "output_dir": bsb ← SB_BOUTD
                    elif bm = "search_path": bsb ← SB_BPATH
                    elif bm = "flag": bsb ← SB_BFLAG
                    elif bm = "sources": bsb ← SB_BSRCS
                    elif bm = "output_name": bsb ← SB_BOUTN
                    elif bm = "output_directory": bsb ← SB_BOUTDN
                    elif bm = "paths": bsb ← SB_BPATHS
                    elif bm = "flags": bsb ← SB_BFLAGS
                    else:
                        self.err("'std.build." ⧺ bm ⧺ "' is not core-2; source(), output(), output_dir(), search_path() and flag() declare a build, and sources(), output_name(), output_directory(), paths() and flags() answer what was declared")
                        return 0
                    self.pos ← self.pos + 1
                    let boff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, bsb, boff, 0)
                if m = "arena":
                    _ ← self.eat(TK_DOT, "'.' after std.arena")
                    if self.ttext(self.pos) ≠ "allocator":
                        self.err("'std.arena." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; allocator() is")
                        return 0
                    self.pos ← self.pos + 1
                    let loff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_ALLOCATOR, loff, 0)
                if m = "fs":
                    _ ← self.eat(TK_DOT, "'.' after std.fs")
                    if self.ttext(self.pos) ≠ "cwd":
                        self.err("'std.fs." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; cwd() is")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(TK_LPAR, "'(' after cwd")
                    _ ← self.eat(TK_RPAR, "')' after cwd(")
                    if self.peek() ≠ TK_DOT:
                        // the directory itself, a value to iterate
                        let coff0 : i64 = @dropunit(#self.extra)
                        self.extra.push(0)
                        return self.mknode(NK_SCALL, at, SB_CWD, coff0, 0)
                    _ ← self.eat(TK_DOT, "'.' and what cwd() is asked")
                    let fm := self.ttext(self.pos)
                    self.pos ← self.pos + 1
                    if fm = "open_file":
                        let ooff : i64 = self.parse_args()
                        return self.mknode(NK_SCALL, at, SB_OPEN, ooff, 0)
                    if fm = "create_file":
                        let coff : i64 = self.parse_args()
                        return self.mknode(NK_SCALL, at, SB_CREATE, coff, 0)
                    self.err("'" ⧺ fm ⧺ "' is not core-2; cwd() answers open_file and create_file")
                    return 0
                if m = "filetype":
                    _ ← self.eat(TK_DOT, "'.' after std.filetype")
                    let fname := self.ttext(self.pos)
                    self.pos ← self.pos + 1
                    // the enumerator's own value, from the builtin
                    // enum the file already holds
                    let st9 : i64 = self.estart[EI_FILETYPE × 1¤ptrdiff]
                    let n9 : i64 = self.ecount[EI_FILETYPE × 1¤ptrdiff]
                    let fv : mut i64 = ⁻1
                    let k9 : mut i64 = 0
                    while k9 < n9:
                        if self.emembers[(st9 + k9) × 1¤ptrdiff] = fname:
                            fv ← self.evalues[(st9 + k9) × 1¤ptrdiff]
                        k9 ← k9 + 1
                    if fv = ⁻1:
                        self.err("'std.filetype." ⧺ fname ⧺ "' names no kind of file")
                        return 0
                    // an enumerator is a value like any other, so what
                    // may follow one may follow this: .ord() above all
                    return self.parse_postfix(self.mknode(NK_INT, at, fv, mk_ety(EI_FILETYPE) × 2, 0))
                if m = "bytes":
                    let boff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_BYTES, boff, 0)
                if m = "iov":
                    let ioff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_IOV, ioff, 0)
                if m = "hash":
                    // std.hash.<alg>.<member>: the algorithm names a
                    // namespace, so another algorithm is another
                    // namespace beside this one rather than two more
                    // names inside std.hash
                    _ ← self.eat(TK_DOT, "'.' and which algorithm")
                    let aname := self.ttext(self.pos)
                    let algs := hash_algs()
                    let alg : mut i64 = ⁻1
                    foreach k := 0…#algs - 1:
                        if algs[k] = aname:
                            alg ← @dropunit(k)
                    if alg = ⁻1:
                        self.err("'std.hash." ⧺ aname ⧺ "' names no algorithm; " ⧺ hash_algs_named() ⧺ " does")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(TK_DOT, "'.' and what the algorithm is asked")
                    let hm := self.ttext(self.pos)
                    let hsb : mut i64 = ⁻1
                    if hm = "digest": hsb ← SB_HDIGEST
                    elif hm = "start": hsb ← SB_HSTART
                    else:
                        self.err("'std.hash." ⧺ aname ⧺ "." ⧺ hm ⧺ "' is not core-2; digest() answers the digest of a message in hand and start() a handle to feed one that is not")
                        return 0
                    self.pos ← self.pos + 1
                    let hoff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, hsb, hoff, alg)
                let sb : mut i64 = ⁻1
                if m = "println": sb ← SB_PRINTLN
                elif m = "print": sb ← SB_PRINT
                elif m = "exit": sb ← SB_EXIT
                else:
                    self.err("'std." ⧺ m ⧺ "' is not core-2; println, print, exit, args, env, process, fs, arena, bytes, iov, hash, build and implementation are")
                    return 0
                let off : i64 = self.parse_args()
                return self.mknode(NK_SCALL, at, sb, off, 0)
            if self.peek2() = TK_LPAR:
                self.pos ← self.pos + 1
                let off : i64 = self.parse_args()
                return self.parse_postfix(self.mknode(NK_CALL, at, off, 0, 0))
            if self.peek2() = TK_LBRACE:
                self.pos ← self.pos + 2
                let items : mut i64[] = []
                if self.peek() ≠ TK_RBRACE:
                    while true:
                        items.push(self.pos)
                        _ ← self.eat_name("a field's name")
                        _ ← self.eat(TK_COLON, "':' after the field's name")
                        items.push(self.parse_expr())
                        if self.failed(): return 0
                        if self.peek() = TK_COMMA:
                            self.pos ← self.pos + 1
                        else:
                            break
                _ ← self.eat(TK_RBRACE, "'}' closing the struct literal")
                let off : i64 = @dropunit(#self.extra)
                self.extra.push(@dropunit(#items) ÷ 2 ?? 0)
                foreach it := items:
                    self.extra.push(it)
                return self.parse_postfix(self.mknode(NK_SLIT, at, off, 0, 0))
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(NK_VAR, at, 0, 0, 0))
        if k = TK_RESERVED:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return 0
        self.err("this token begins no core-2 expression")
        0

    fn parse_unary_operand(&mut self) → i64:
        self.parse_primary()

    // std.implementation says which implementation this is; ngplc
    // answers about itself, folded to constants before anything runs,
    // so a comptime check reads them for free
    fn impl_str(&mut self, s : str) → i64:
        if #self.toks.strs > 0:
            foreach i := 0…#self.toks.strs - 1:
                if self.toks.strs[i] = s:
                    return @dropunit(i)
        let idx : i64 = @dropunit(#self.toks.strs)
        self.toks.strs.push(s)
        idx

    // std.process.<member>: what the kernel recorded at exec, read as a
    // member rather than called, since none of it can change
    fn parse_process(&mut self, at : i64) → i64:
        _ ← self.eat(TK_DOT, "'.' after std.process")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        let idx : mut i64 = ⁻1
        if m = "pagesize": idx ← PROC_PAGESIZE
        elif m = "uid": idx ← PROC_UID
        elif m = "euid": idx ← PROC_EUID
        elif m = "gid": idx ← PROC_GID
        elif m = "egid": idx ← PROC_EGID
        elif m = "secure": idx ← PROC_SECURE
        elif m = "exec_filename": idx ← PROC_EXECFN
        else:
            self.err("'std.process." ⧺ m ⧺ "' is not a member; pagesize, uid, euid, gid, egid, secure and exec_filename are")
            return 0
        self.mknode(NK_SCALL, at, SB_PROC, idx, 0)

    fn parse_implementation(&mut self, at : i64) → i64:
        _ ← self.eat(TK_DOT, "'.' after std.implementation")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        if m = "interpreter":
            return self.mknode(NK_BOOL, at, 0, 0, 0)
        if m = "compiled":
            return self.mknode(NK_BOOL, at, 1, 0, 0)
        if m = "name":
            return self.mknode(NK_STR, at, self.impl_str("ngplc"), 0, 0)
        if m = "language":
            return self.mknode(NK_STR, at, self.impl_str("core-1"), 0, 0)
        self.err("'std.implementation." ⧺ m ⧺ "' is not a member; name, language, interpreter and compiled are")
        0

    // binding power of a binary operator token; ⁻1 when it is none.
    // The numbers follow the bootstrap parser's ladder.
    fn bin_bp(&self, k : i64) → i64:
        if k = TK_OR or k = TK_COALESCE: return 2
        if k = TK_AND: return 3
        if k = TK_LOR: return 4
        if k = TK_LAND: return 6
        if k = TK_LXOR or k = TK_LNAND or k = TK_LNOR: return 5
        if k = TK_EQ or k = TK_NE or k = TK_LT or k = TK_GT or k = TK_LE or k = TK_GE: return 7
        if k = TK_MAX or k = TK_MIN or k = TK_ELEM or k = TK_IOTA: return 9
        if k = TK_SHL or k = TK_SHR: return 10
        if k = TK_BOR: return 11
        if k = TK_BXOR: return 12
        if k = TK_BAND: return 13
        if k = TK_PLUS or k = TK_MINUS or k = TK_SATADD or k = TK_SATSUB: return 14
        if k = TK_CONCAT: return 15
        if k = TK_MULT or k = TK_DIVIDE or k = TK_MOD or k = TK_SATMUL: return 16
        if k = TK_RESHAPE: return 17
        ⁻1

    fn bin_nk(&self, k : i64) → i64:
        if k = TK_OR: return NK_OR
        if k = TK_COALESCE: return NK_DEFAULT
        if k = TK_AND: return NK_AND
        if k = TK_LOR: return NK_LOR
        if k = TK_LAND: return NK_LAND
        if k = TK_EQ: return NK_EQ
        if k = TK_NE: return NK_NE
        if k = TK_LT: return NK_LT
        if k = TK_GT: return NK_GT
        if k = TK_LE: return NK_LE
        if k = TK_GE: return NK_GE
        if k = TK_MAX: return NK_MAXOP
        if k = TK_MIN: return NK_MINOP
        if k = TK_ELEM: return NK_ELEMOF
        if k = TK_IOTA: return NK_IOTA
        if k = TK_SATADD: return NK_SATADD
        if k = TK_SATSUB: return NK_SATSUB
        if k = TK_SATMUL: return NK_SATMUL
        if k = TK_LXOR: return NK_LXOR
        if k = TK_LNAND: return NK_LNAND
        if k = TK_LNOR: return NK_LNOR
        if k = TK_RESHAPE: return NK_RESHAPE
        if k = TK_SHL: return NK_SHL
        if k = TK_SHR: return NK_SHR
        if k = TK_BOR: return NK_BOR
        if k = TK_BXOR: return NK_BXOR
        if k = TK_BAND: return NK_BAND
        if k = TK_PLUS: return NK_ADD
        if k = TK_MINUS: return NK_SUB
        if k = TK_CONCAT: return NK_CCAT
        if k = TK_MULT: return NK_MUL
        if k = TK_DIVIDE: return NK_DIV
        if k = TK_MOD: return NK_MOD
        0

    fn parse_bin(&mut self, min_bp : i64) → i64:
        let lhs : mut i64 = self.parse_primary()
        while not self.failed():
            let k : i64 = self.peek()
            if k = TK_ELLIPSIS and min_bp <= 8:
                // a…b, and a…step…b when a second … follows: the range
                // binds tighter than comparison, looser than arithmetic
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(9)
                if self.nkind[lhs × 1¤ptrdiff] = NK_RANGEV:
                    if self.nc[lhs × 1¤ptrdiff] ≠ ⁻1:
                        self.err("a range is lo…hi or lo…step…hi; a fourth part names nothing")
                        return lhs
                    // what stood as the end steps aside to be the step
                    lhs ← self.mknode(NK_RANGEV, at, self.na[lhs × 1¤ptrdiff], rhs, self.nb[lhs × 1¤ptrdiff])
                else:
                    lhs ← self.mknode(NK_RANGEV, at, lhs, rhs, ⁻1)
            else:
                let bp : i64 = self.bin_bp(k)
                if bp = ⁻1 or bp < min_bp:
                    break
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(bp + 1)
                lhs ← self.mknode(self.bin_nk(k), at, lhs, rhs, 0)
        lhs

    fn parse_expr(&mut self) → i64:
        let v : i64 = self.parse_bin(2)
        if self.failed(): return v
        if self.peek() ≠ TK_IF:
            return v
        // v if cond else w — only the side taken is read
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_bin(2)
        _ ← self.eat(TK_ELSE, "'else' after the condition of a conditional expression")
        let w : i64 = self.parse_expr()
        self.mknode(NK_COND, at, v, cond, w)

    // ------------------------------------------------------------------
    // Statements and blocks
    // ------------------------------------------------------------------

    fn parse_block(&mut self) → i64:
        _ ← self.eat(TK_COLON, "':' beginning the block")
        let stmts : mut i64[] = []
        if self.peek() ≠ TK_NL:
            stmts.push(self.parse_stmt())
        else:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_INDENT, "an indented block")
            while self.peek() ≠ TK_DEDENT and self.peek() ≠ TK_EOF:
                stmts.push(self.parse_stmt())
                if self.poisoned:
                    // this statement is lost; the next line starts over
                    _ ← stmts.pop() ?? 0
                    self.sync()
                    if self.peek() = TK_INDENT:
                        // a block hangs off the broken statement;
                        // nothing owns it now, so it is skipped whole
                        self.skip_block()
            _ ← self.eat(TK_DEDENT, "the end of the block")
        let off : i64 = self.push_list(stmts)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    // step over a balanced INDENT…DEDENT run
    fn skip_block(&mut self):
        let depth : mut i64 = 0
        while self.peek() ≠ TK_EOF:
            if self.peek() = TK_INDENT:
                depth ← depth + 1
            elif self.peek() = TK_DEDENT:
                depth ← depth - 1
                if depth = 0:
                    self.pos ← self.pos + 1
                    return
            self.pos ← self.pos + 1

    fn end_stmt(&mut self):
        if self.braces > 0:
            // inside { }: ';' separates, and '}' closes the last
            if self.peek() = TK_SEMI:
                self.pos ← self.pos + 1
            elif self.peek() ≠ TK_RBRACE:
                self.err("';' separates the statements of a brace block")
            return
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        elif self.peek() = TK_DEDENT or self.peek() = TK_EOF:
            let keep : i64 = 0
        elif self.pos > 0 and self.toks.kind[(self.pos - 1) × 1¤ptrdiff] = TK_DEDENT:
            // a lambda's layout body closed the line already
            let keep : i64 = 0
        else:
            self.err("the statement has ended but the line has more on it")

    fn parse_let(&mut self) → i64:
        self.pos ← self.pos + 1
        if self.peek() = TK_LPAR:
            return self.parse_let_tuple()
        let name_tok : i64 = self.pos
        _ ← self.eat_name("the name the let binds")
        let u : i64 = self.parse_name_unit()
        if self.peek() = TK_DEFINE:
            // := takes the type from the right side, which must state it
            if u ≠ UNIT_NONE:
                self.err("a unit measures a stated type; write 'let x ¤ptrdiff : i64 = …'")
                return 0
            self.pos ← self.pos + 1
            let init0 : i64 = self.parse_expr()
            self.end_stmt()
            return self.mknode(NK_LET, name_tok, init0, 0, ⁻1)
        _ ← self.eat(TK_COLON, "':' and the type of the binding")
        let is_mut : mut i64 = 0
        if self.peek() = TK_MUT:
            is_mut ← 1
            self.pos ← self.pos + 1
            if self.peek() = TK_EQ:
                // let x : mut = e -- mut, the type still inferred
                if u ≠ UNIT_NONE:
                    self.err("a unit measures a stated type; write 'let x ¤ptrdiff : mut i64 = …'")
                    return 0
                self.pos ← self.pos + 1
                let init1 : i64 = self.parse_expr()
                self.end_stmt()
                return self.mknode(NK_LET, name_tok, init1, 1, ⁻1)
        let ty0 : i64 = self.parse_type(false)
        let ty : mut i64 = ty0
        if u ≠ UNIT_NONE:
            ty ← self.unit_on_type(ty, u, "")
        _ ← self.eat(TK_EQ, "'=' and the initial value")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        self.mknode(NK_LET, name_tok, init, is_mut, ty)

    // let (a, b) := f()  or  let (a, b) : mut (i64, str) = …; the
    // names, '_' among them, take a tuple apart
    fn parse_let_tuple(&mut self) → i64:
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let ntoks : mut i64[] = []
        while true:
            ntoks.push(self.pos)
            _ ← self.eat_name("a name the let binds")
            if self.failed():
                return 0
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
            else:
                break
        _ ← self.eat(TK_RPAR, "')' closing the names")
        if #ntoks < 2:
            self.err("a destructuring let takes at least two names")
            return 0
        let is_mut : mut i64 = 0
        let ty : mut i64 = ⁻1
        if self.peek() = TK_COLON:
            self.pos ← self.pos + 1
            if self.peek() = TK_MUT:
                is_mut ← 1
                self.pos ← self.pos + 1
            ty ← self.parse_type(false)
            if not ty_is_tup(ty):
                self.err("the names take a tuple apart; the stated type is not a tuple")
                return 0
            _ ← self.eat(TK_EQ, "'=' and the initial value")
        else:
            _ ← self.eat(TK_DEFINE, "':=' (or ': (…) =') and the tuple taken apart")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        let toff : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ntoks))
        self.extra.push(ty)
        foreach t2 := ntoks:
            self.extra.push(t2)
        self.mknode(NK_LETT, name_tok, init, is_mut, toff)

    fn parse_stmt(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = TK_AT and (self.ttext(self.pos + 1) = "likely" or self.ttext(self.pos + 1) = "unlikely"):
            // @likely and @unlikely say which way a condition is
            // expected to go.  They belong to the if that follows and
            // to nothing else, and they never change what is computed
            // -- only where the compiler puts the code.
            let hname := self.ttext(self.pos + 1)
            self.pos ← self.pos + 2
            while self.peek() = TK_NL:
                self.pos ← self.pos + 1
            if self.peek() = TK_AT and (self.ttext(self.pos + 1) = "likely" or self.ttext(self.pos + 1) = "unlikely"):
                let second := self.ttext(self.pos + 1)
                if second = hname:
                    self.err("@" ⧺ hname ⧺ " is given twice on the same condition")
                else:
                    self.err("@" ⧺ second ⧺ " contradicts @" ⧺ hname ⧺ " on the same condition")
                return 0
            if self.peek() ≠ TK_IF:
                self.err("@" ⧺ hname ⧺ " applies to an if statement, but none follows")
                return 0
            let inner : i64 = self.parse_stmt()
            return self.mknode(NK_HINTED, at, inner, 1 if hname = "unlikely" else 0, 0)
        if k = TK_AT and self.ttext(self.pos + 1) = "expect":
            // @expect level "pattern" over the one statement that
            // follows: what it says is expected to be drawn, so what
            // it draws is caught and kept from the report.  Which
            // diagnostic it was is the interpreter's to check, as it
            // is for a definition marked the same way.
            let wants_err : mut i64 = 0
            while self.peek() = TK_AT and self.ttext(self.pos + 1) = "expect" and not self.failed():
                self.pos ← self.pos + 2
                let lvl := self.ttext(self.pos)
                if lvl ≠ "error" and lvl ≠ "warning":
                    self.err("@expect names a level, error or warning")
                    return 0
                if lvl = "error":
                    wants_err ← 1
                self.pos ← self.pos + 1
                if self.peek() ≠ TK_STR:
                    self.err("@expect states the message it expects, as a string")
                    return 0
                self.pos ← self.pos + 1
                while self.peek() = TK_NL:
                    self.pos ← self.pos + 1
            let inner : i64 = self.parse_stmt()
            return self.mknode(NK_EXPECTS, at, inner, wants_err, 0)
        if k = TK_LET:
            return self.parse_let()
        if k = TK_IF:
            self.pos ← self.pos + 1
            let cond : i64 = self.parse_expr()
            let then_blk : i64 = self.parse_block()
            let else_blk : mut i64 = ⁻1
            if self.peek() = TK_ELIF:
                else_blk ← self.parse_elif_chain()
            elif self.peek() = TK_ELSE:
                self.pos ← self.pos + 1
                else_blk ← self.parse_block()
            return self.mknode(NK_IF, at, cond, then_blk, else_blk)
        if k = TK_WHILE:
            self.pos ← self.pos + 1
            if self.peek() = TK_IDENT and (self.peek2() = TK_DEFINE or (self.peek2() = TK_COLON and self.toks.kind[(self.pos + 2) × 1¤ptrdiff] ≠ TK_NL)):
                // while x := e, while x : mut = e, while x : T = e --
                // the loop runs while e answers a value, x naming it
                let wname_tok : i64 = self.pos
                let wmut : mut i64 = 0
                let wty : mut i64 = ⁻1
                if self.peek2() = TK_DEFINE:
                    self.pos ← self.pos + 2
                else:
                    self.pos ← self.pos + 2
                    if self.peek() = TK_MUT:
                        wmut ← 1
                        self.pos ← self.pos + 1
                    if self.peek() ≠ TK_EQ:
                        wty ← self.parse_type(false)
                    _ ← self.eat(TK_EQ, "'=' and what the loop asks")
                let wcond : i64 = self.parse_expr()
                let wbody : i64 = self.parse_block()
                let woff : i64 = @dropunit(#self.extra)
                self.extra.push(wmut)
                self.extra.push(wty)
                return self.mknode(NK_WHILEB, wname_tok, wcond, wbody, woff)
            let cond : i64 = self.parse_expr()
            let body : i64 = self.parse_block()
            return self.mknode(NK_WHILE, at, cond, body, 0)
        if k = TK_FOREACH:
            self.pos ← self.pos + 1
            let name_tok : i64 = self.pos
            if self.peek() = TK_IDENT or self.peek() = TK_RESERVED:
                _ ← self.eat_name("the loop variable")
            else:
                self.err("expected the loop variable")
                return 0
            _ ← self.eat(TK_DEFINE, "':=' before what the loop walks")
            if self.peek() = TK_BAND:
                // foreach x := &v / &mut v: the elements are lent
                self.pos ← self.pos + 1
                let brk : mut i64 = 1
                if self.peek() = TK_MUT:
                    brk ← 2
                    self.pos ← self.pos + 1
                let btok : i64 = self.pos
                _ ← self.eat_name("the borrowed array's name")
                let bvar : i64 = self.mknode(NK_VAR, btok, 0, 0, 0)
                let bref : i64 = self.mknode(NK_REF, btok, bvar, brk, 0)
                let bbody : i64 = self.parse_block()
                return self.mknode(NK_FOREACHA, name_tok, bref, bbody, 0)
            let e1 : i64 = self.parse_bin(2)
            if self.nkind[e1 × 1¤ptrdiff] ≠ NK_RANGEV:
                // walking a container's elements, or a range that
                // arrives as a value
                let body : i64 = self.parse_block()
                return self.mknode(NK_FOREACHA, name_tok, e1, body, 0)
            let body : i64 = self.parse_block()
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(self.na[e1 × 1¤ptrdiff])
            self.extra.push(self.nc[e1 × 1¤ptrdiff])
            self.extra.push(self.nb[e1 × 1¤ptrdiff])
            return self.mknode(NK_FOREACH, name_tok, off, body, 0)
        if k = TK_MATCH:
            self.pos ← self.pos + 1
            let subject : i64 = self.parse_expr()
            _ ← self.eat(TK_COLON, "':' after the subject")
            _ ← self.eat(TK_NL, "the arms on their own lines")
            _ ← self.eat(TK_INDENT, "an indented arm list")
            let some_blk : mut i64 = ⁻1
            let empty_blk : mut i64 = ⁻1
            let bind_tok : mut i64 = ⁻1
            while self.peek() ≠ TK_DEDENT and not self.failed():
                if self.peek() = TK_EXISTS:
                    if some_blk ≠ ⁻1:
                        self.err("match repeats the ∃ pattern")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(TK_LPAR, "'(' after ∃")
                    bind_tok ← self.pos
                    _ ← self.eat_name("the name ∃ binds")
                    _ ← self.eat(TK_RPAR, "')' closing the pattern")
                    some_blk ← self.parse_block()
                elif self.peek() = TK_EMPTY:
                    if empty_blk ≠ ⁻1:
                        self.err("match repeats the ∅ pattern")
                        return 0
                    self.pos ← self.pos + 1
                    empty_blk ← self.parse_block()
                elif self.peek() = TK_NL:
                    self.pos ← self.pos + 1
                else:
                    self.err("a core-2 match arm is ∃(name) or ∅")
                    return 0
            _ ← self.eat(TK_DEDENT, "the end of the match")
            if some_blk = ⁻1:
                self.err("match has no arm for ∃")
                return 0
            if empty_blk = ⁻1:
                self.err("match has no arm for ∅")
                return 0
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(some_blk)
            self.extra.push(empty_blk)
            return self.mknode(NK_MATCH, bind_tok, subject, off, 0)
        if k = TK_RETURN:
            self.pos ← self.pos + 1
            let v : mut i64 = ⁻1
            if self.peek() ≠ TK_NL and self.peek() ≠ TK_DEDENT:
                v ← self.parse_expr()
            self.end_stmt()
            return self.mknode(NK_RETURN, at, v, 0, 0)
        if k = TK_BREAK:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(NK_BREAK, at, 0, 0, 0)
        if k = TK_CONTINUE:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(NK_CONTINUE, at, 0, 0, 0)
        if k = TK_IDENT and self.peek2() = TK_ASSIGN:
            let name := self.ttext(at)
            self.pos ← self.pos + 2
            let v : i64 = self.parse_expr()
            self.end_stmt()
            if name = "_":
                return self.mknode(NK_DISCARD, at, v, 0, 0)
            return self.mknode(NK_ASSIGN, at, v, 0, 0)
        // any postfix path may be a store target: the expression is
        // parsed first, and a following ← turns it into the store its
        // shape names -- a field, an element, or nothing storable
        let e : i64 = self.parse_expr()
        if self.peek() = TK_ASSIGN:
            self.pos ← self.pos + 1
            let v : i64 = self.parse_expr()
            self.end_stmt()
            let ek : i64 = self.nkind[e × 1¤ptrdiff]
            if ek = NK_FIELD:
                return self.mknode(NK_STOREFLD, self.ntok[e × 1¤ptrdiff],
                                   self.na[e × 1¤ptrdiff], v, 0)
            if ek = NK_INDEX:
                return self.mknode(NK_STOREIDXP, at, self.na[e × 1¤ptrdiff],
                                   self.nb[e × 1¤ptrdiff], v)
            self.err("this is not a place a value can be stored into")
            return 0
        self.end_stmt()
        self.mknode(NK_EXPRSTMT, at, e, 0, 0)

    fn parse_elif_chain(&mut self) → i64:
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_expr()
        let then_blk : i64 = self.parse_block()
        let else_blk : mut i64 = ⁻1
        if self.peek() = TK_ELIF:
            else_blk ← self.parse_elif_chain()
        elif self.peek() = TK_ELSE:
            self.pos ← self.pos + 1
            else_blk ← self.parse_block()
        let ifn : i64 = self.mknode(NK_IF, at, cond, then_blk, else_blk)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(ifn)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    // ------------------------------------------------------------------
    // Definitions
    // ------------------------------------------------------------------

    // mods: bit 0 says @replaceable, bit 1 says @export -- two bits
    // rather than two parameters, the subset holding a signature to
    // twelve of them
    fn parse_fn(&mut self, imp : bool, is_start : bool, is_noreturn : bool,
                is_test : bool, mods : i64, ignored : bool,
                pres : i64[], post_toks : i64[], posts : i64[],
                prefix : str, self_sty : i64):
        _ ← self.eat(TK_FN, "'fn'")
        let name_tok : i64 = self.pos
        let name0 := self.ttext(name_tok)
        let name : str = name0 if prefix = "" else prefix ⧺ "." ⧺ name0
        _ ← self.eat_name("the function's name")
        _ ← self.eat(TK_LPAR, "'(' and the parameters")
        let ptoks : mut i64[] = []
        let ptypes : mut i64[] = []
        if self_sty ≠ 0 and self.peek() = TK_BAND:
            // the receiver: &self reads, &mut self changes
            self.pos ← self.pos + 1
            let srk : mut i64 = 1
            if self.peek() = TK_MUT:
                self.pos ← self.pos + 1
                srk ← 2
            let stok : i64 = self.pos
            if self.ttext(stok) ≠ "self":
                self.err("a method's receiver is spelled &self or &mut self")
                return
            self.pos ← self.pos + 1
            ptoks.push(stok)
            ptypes.push(self_sty + 262144 × srk)
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
        if self.peek() ≠ TK_RPAR:
            while true:
                ptoks.push(self.pos)
                _ ← self.eat_name("a parameter name")
                let u : i64 = self.parse_name_unit()
                _ ← self.eat(TK_COLON, "':' and the parameter's type")
                let pmut : mut i64 = 0
                if self.peek() = TK_MUT:
                    self.pos ← self.pos + 1
                    pmut ← 1
                let ty0a : i64 = self.parse_type(true)
                let ty0 : mut i64 = ty0a
                if pmut = 1:
                    if ty_ref_kind(ty0a) ≠ 0:
                        self.err("mut before a borrow says nothing; &mut already changes")
                    elif ty_is_arr(ty0a) or ty_is_hash(ty0a) or ty_is_mat(ty0a):
                        self.err("a mut container parameter changes the caller's own; write &mut")
                    else:
                        ty0 ← ty0a + 262144 × 3
                let ty : mut i64 = ty0
                if u ≠ UNIT_NONE:
                    let rk : i64 = ty_ref_kind(ty)
                    ty ← self.unit_on_type(ty_strip_ref(ty), u, "") + 262144 × rk
                if ty_is_tup(ty_strip_ref(ty)):
                    self.err("a core-2 tuple is returned and taken apart; it does not travel as a parameter")
                ptypes.push(ty)
                if self.failed(): return
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(TK_RPAR, "')' after the parameters")
        let ret : mut i64 = TY_UNIT
        if self.peek() = TK_ARROW:
            self.pos ← self.pos + 1
            ret ← self.parse_type(false)
        let body : i64 = self.parse_block()
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        let params_off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ptoks))
        if #ptoks > 0:
            foreach i := 0…#ptoks - 1:
                self.extra.push(ptoks[i])
                self.extra.push(ptypes[i])
        let pre_off : mut i64 = ⁻1
        if #pres > 0:
            pre_off ← self.push_list(pres)
        let post_off : mut i64 = ⁻1
        if #posts > 0:
            post_off ← @dropunit(#self.extra)
            self.extra.push(@dropunit(#posts))
            foreach i := 0…#posts - 1:
                self.extra.push(post_toks[i])
                self.extra.push(posts[i])
        if ignored:
            // @expect: the definition is expected to draw diagnostics,
            // so it is not checked, not compiled, and not run --
            // remembered only so a reference to it can say why
            self.ignored.push(name)
            // every @expect'd function is reported as a test of the
            // expectation itself, @test or not, as the interpreter
            // reports them
            self.igtests.push(name)
            return
        if mods & 4 = 4:
            // The recipe is read while the program is built and nothing
            // of it is written, so it is kept apart from the functions
            // that are: a.fns is the emission schedule, one code offset
            // to an entry, and a recipe has no code to schedule.
            if #self.builds > 0:
                self.err_at(name_tok, "a program carries one @build function, and this is a second")
                return
            if #ptoks > 0:
                self.err_at(ptoks[0 × 1¤ptrdiff], "the @build function takes no parameters")
                return
            if ret ≠ TY_UNIT:
                self.err_at(name_tok, "the @build function answers nothing; it declares a build by calling std.build")
                return
            self.builds.push(FnDef{name: name, modname: self.curmod, tok: name_tok, params_off: params_off,
                                   ret: ret, body: body, is_export: false,
                                   is_replaceable: false, is_impure: false,
                                   is_start: false, is_noreturn: false,
                                   is_test: false,
                                   pre_off: pre_off, post_off: post_off})
            return
        self.fns.push(FnDef{name: name, modname: self.curmod, tok: name_tok, params_off: params_off,
                            ret: ret, body: body, is_export: (mods » 1) & 1 = 1,
                            is_replaceable: mods & 1 = 1,
                            is_impure: imp,
                            is_start: is_start, is_noreturn: is_noreturn,
                            is_test: is_test,
                            pre_off: pre_off, post_off: post_off})

    // enum Name [: width]: one enumerator to a line.  What a value
    // holds is its place in the list; what it is called is kept so a
    // diagnostic and a printed value can say it.
    fn parse_enum(&mut self, is_flag : bool):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the enum's name")
        if (TYNAMES[name] ?? ⁻1) ≠ ⁻1 or self.sindex_ty(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already names a type")
            return
        let w : mut i64 = TY_I64
        if self.peek() = TK_COLON and self.peek2() ≠ TK_NL:
            self.pos ← self.pos + 1
            w ← self.parse_type(false)
            if not (ty_is_int(w) and ty_unit(w) = 0):
                self.err("an enum's values are held in a plain integer type")
                return
        _ ← self.eat(TK_COLON, "':' beginning the enumerators")
        _ ← self.eat(TK_NL, "the enumerators on their own lines")
        _ ← self.eat(TK_INDENT, "an indented list of enumerators")
        let first : i64 = @dropunit(#self.emembers)
        // a flag's members are bits, so the automatic values double
        // where an ordinary enum's count on
        let next_val : mut i64 = 1 if is_flag else 0
        while self.peek() ≠ TK_DEDENT and self.peek() ≠ TK_EOF and not self.failed():
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
                continue
            let mname := self.ttext(self.pos)
            _ ← self.eat_name("an enumerator's name")
            let m : mut i64 = first
            while m < @dropunit(#self.emembers):
                if self.emembers[m × 1¤ptrdiff] = mname:
                    self.err("'" ⧺ mname ⧺ "' is named twice in this enum")
                    return
                m ← m + 1
            // an enumerator may say what it stands for; the ones that
            // follow count on from there, as they count from zero
            if self.peek() = TK_EQ:
                self.pos ← self.pos + 1
                let neg : mut i64 = 1
                if self.peek() = TK_NEG:
                    self.pos ← self.pos + 1
                    neg ← ⁻1
                if self.peek() ≠ TK_INT or self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                    self.err("an enumerator stands for a written-out number")
                    return
                next_val ← neg × self.toks.val[self.pos × 1¤ptrdiff]
                self.pos ← self.pos + 1
            self.emembers.push(mname)
            self.evalues.push(next_val)
            if is_flag:
                next_val ← @wrap(next_val « 1) if next_val ≠ 0 else 1
            else:
                next_val ← next_val + 1
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        _ ← self.eat(TK_DEDENT, "the end of the enumerators")
        if is_flag:
            // a flag set holds the empty combination under 'nil'
            // unless some member already stands for zero
            let has0 : mut bool = false
            let z : mut i64 = first
            while z < @dropunit(#self.emembers):
                if self.evalues[z × 1¤ptrdiff] = 0:
                    has0 ← true
                z ← z + 1
            if not has0:
                self.emembers.push("nil")
                self.evalues.push(0)
        // every member fits the type the values are stored in
        let bits : i64 = ty_bits(w)
        let sgn : i64 = ty_sgn(w)
        let f : mut i64 = first
        while f < @dropunit(#self.emembers):
            let v : i64 = self.evalues[f × 1¤ptrdiff]
            let lo : i64 = 0 - (1 « (bits - 1)) if sgn = 1 and bits < 64 else (⁻9223372036854775807 - 1 if sgn = 1 else 0)
            // a shift of 63 is past what a signed count allows, so the
            // top of the range is written out where it would be needed
            let hi : i64 = 9223372036854775807 if bits - sgn >= 63 else (1 « (bits - sgn)) - 1
            if v < lo or (bits - sgn < 64 and v > hi):
                self.err("enumerator '" ⧺ self.emembers[f × 1¤ptrdiff] ⧺ "' is " ⧺ i64_str(v) ⧺ ", which does not fit " ⧺ type_name_m(w, self.umarks) ⧺ ", the type the values are stored in")
                return
            f ← f + 1
        let n : i64 = @dropunit(#self.emembers) - first
        if n = 0:
            self.err("an enum names at least one of what it holds")
            return
        if @dropunit(#self.enames) >= 256:
            self.err("this file names more than 256 enums")
            return
        self.enames.push(name)
        self.ewidth.push(w)
        self.estart.push(first)
        self.ecount.push(n)
        self.eflag.push(1 if is_flag else 0)

    // unit name: a measure of the file's own, standing for nothing but
    // itself.  It is written ¤"name" where a shipped one is written
    // ¤name, as the specification has it.  A measure derived from
    // others -- a ratio of them, or a product -- is not core-2 yet:
    // what core-2 does with a measure is keep it apart from the
    // others, and that needs only its name.
    // What each measure stands in for, settled once the whole file has
    // been read so that one may name another declared further down.
    //
    // Standing in for something is an order, and an order has no
    // circles: a measure that reaches itself by standing in for things
    // says nothing about which of them is the wider.  A circle is
    // looked for here because this is the first moment it could exist
    // -- while the names were being read, the one closing it had not
    // been written yet.
    fn resolve_decays(&mut self):
        let n : i64 = @dropunit(#self.unames)
        let i : mut i64 = 0
        while i < n:
            let want : str = self.udname[i × 1¤ptrdiff]
            if want ≠ "":
                let d : i64 = self.unit_index(want)
                if d = ⁻1:
                    self.poisoned ← false
                    self.err_at(self.udtok[i × 1¤ptrdiff], "'" ⧺ want ⧺ "' is no measure this file knows, so '" ⧺ self.unames[i × 1¤ptrdiff] ⧺ "' cannot stand in for it")
                else:
                    self.udecay[i × 1¤ptrdiff] ← d
            i ← i + 1
        let j : mut i64 = 0
        while j < n:
            if self.udecay[j × 1¤ptrdiff] ≠ 0:
                let chain : mut str = self.unames[j × 1¤ptrdiff]
                let step : mut i64 = self.udecay[j × 1¤ptrdiff]
                let seen : mut i64 = 0
                while step ≠ 0 and seen <= n:
                    chain ← chain ⧺ " → " ⧺ self.unames[step × 1¤ptrdiff]
                    if step = j:
                        self.poisoned ← false
                        self.err_at(self.udtok[j × 1¤ptrdiff], "a measure cannot stand in for itself, however far round it goes: " ⧺ chain)
                        step ← 0
                    else:
                        step ← self.udecay[step × 1¤ptrdiff]
                        seen ← seen + 1
            j ← j + 1

    // `module a` says where the definitions after it live, until the
    // next such line says otherwise.  A bare name is read against the
    // module in hand, a leading period starts again from the outside,
    // and `module .` alone is the way back out to the global module --
    // C++'s namespace rules with a period for the two colons.
    // How many tokens from `at` name a module, or ⁻1 if none do.  The
    // longest run wins, so a.b beats a where both are modules.
    fn module_prefix(&self, at : i64) → i64:
        if #self.mods = 0 or self.toks.kind[(at + 1) × 1¤ptrdiff] ≠ TK_DOT:
            return ⁻1
        let best : mut i64 = ⁻1
        let path : mut str = self.ttext(at)
        let j : mut i64 = at
        while true:
            if self.knows_module(path):
                best ← j
            if self.toks.kind[(j + 1) × 1¤ptrdiff] ≠ TK_DOT:
                return best
            if self.toks.kind[(j + 2) × 1¤ptrdiff] ≠ TK_IDENT:
                return best
            j ← j + 2
            path ← path ⧺ "." ⧺ self.ttext(j)
        best

    // `mod.name(args)`: the module is written down beside the call, and
    // the checker looks the name up in it rather than in scope.
    fn parse_qualified(&mut self, at : i64, last : i64) → i64:
        let path : mut str = self.ttext(at)
        let j : mut i64 = at
        while j < last:
            j ← j + 2
            path ← path ⧺ "." ⧺ self.ttext(j)
        self.pos ← last + 1
        _ ← self.eat(TK_DOT, "'.' and the name asked of the module")
        let ntok : i64 = self.pos
        _ ← self.eat_name("the name asked of the module")
        if self.peek() ≠ TK_LPAR:
            self.err_at(ntok, "core-2 asks a module for a function; '" ⧺ path ⧺ "." ⧺ self.ttext(ntok) ⧺ "' is named without being called")
            return 0
        let aoff : i64 = self.parse_args()
        self.qmods.push(path)
        self.mknode(NK_CALL, ntok, aoff, @dropunit(#self.qmods), 0)

    fn parse_module_def(&mut self):
        let kw : i64 = self.pos
        self.pos ← self.pos + 1
        let absolute : bool = self.peek() = TK_DOT
        if absolute:
            self.pos ← self.pos + 1
        let path : mut str = ""
        if not absolute or self.peek() = TK_IDENT:
            path ← self.ttext(self.pos)
            _ ← self.eat_name("the module's name")
            while self.peek() = TK_DOT:
                self.pos ← self.pos + 1
                path ← path ⧺ "." ⧺ self.ttext(self.pos)
                _ ← self.eat_name("the module's name")
        let full : mut str = ""
        if path ≠ "":
            full ← path if absolute or self.curmod = "" else self.curmod ⧺ "." ⧺ path
        // the sweep before parsing already wrote it down; this only
        // moves the marker the definitions after it are read against
        _ ← kw
        self.curmod ← full
        self.end_stmt()

    fn knows_module(&self, name : str) → bool:
        foreach m := self.mods:
            if m = name:
                return true
        false

    fn parse_unit_def(&mut self):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the measure's name")
        if self.unit_index(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already names a measure")
            return
        if self.peek() = TK_EQ:
            self.err("a measure derived from others is not core-2 yet; 'unit " ⧺ name ⧺ "' names one of its own")
            return
        if @dropunit(#self.unames) >= 125:
            self.err("this file names more than 125 measures")
            return
        // `unit tok → ptrdiff` says a token index may go wherever a
        // ptrdiff is wanted.  It stays its own measure -- a node id is
        // still not one -- and the way back is not open: what stands in
        // for a thing is not the thing.
        //
        // The name is only written down here.  What it refers to is
        // settled once the whole file has been read, so a measure may
        // stand in for one declared further down, as a struct may be
        // named before it is declared.
        let dname : mut str = ""
        let dtok : mut i64 = 0
        if self.peek() = TK_ARROW:
            self.pos ← self.pos + 1
            dtok ← self.pos
            dname ← self.ttext(dtok)
            _ ← self.eat_name("the measure this one stands in for")
        self.unames.push(name)
        self.umarks.push(name)
        self.udecay.push(0)
        self.udname.push(dname)
        self.udtok.push(dtok)
        self.end_stmt()

    // type Name = T: a name standing for a type, and nothing more --
    // what it stands for is what it is, everywhere the name is written
    fn parse_type_alias(&mut self):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the name being given to a type")
        if (TYNAMES[name] ?? ⁻1) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' is already a type's name")
            return
        if self.sindex_ty(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already stands for something")
            return
        _ ← self.eat(TK_EQ, "'=' and the type the name stands for")
        let t : i64 = self.parse_type(false)
        if self.failed(): return
        self.tanames.push(name)
        self.tatypes.push(t)
        self.end_stmt()

    fn parse_struct(&mut self, repr_c : bool):
        _ ← self.eat(TK_STRUCT, "'struct'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        _ ← self.eat(TK_COLON, "':' after the struct's name")
        _ ← self.eat(TK_NL, "the fields on their own lines")
        _ ← self.eat(TK_INDENT, "an indented field list")
        let ftoks : mut i64[] = []
        let ftypes : mut i64[] = []
        while self.peek() ≠ TK_DEDENT and not self.failed():
            ftoks.push(self.pos)
            _ ← self.eat_name("a field's name")
            // a field may state a unit the way a binding does:
            // name ¤unit : type
            let fu : i64 = self.parse_name_unit()
            _ ← self.eat(TK_COLON, "':' and the field's type")
            let ty : mut i64 = self.parse_type(false)
            if fu ≠ 0:
                ty ← self.unit_on_type(ty, fu, " field")
            if ty_is_tup(ty):
                self.err("a tuple inside a struct is not core-2 yet")
            ftypes.push(ty)
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        _ ← self.eat(TK_DEDENT, "the end of the struct")
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ftoks))
        if #ftoks > 0:
            foreach i := 0…#ftoks - 1:
                self.extra.push(ftoks[i])
                self.extra.push(ftypes[i])
        self.structs.push(SDef{name: name, tok: name_tok, fields_off: off,
                               is_repr_c: repr_c})

    fn parse_impl(&mut self):
        _ ← self.eat(TK_IMPL, "'impl'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        let sty : i64 = self.sindex_ty(name)
        if sty = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a struct this program defines")
            return
        _ ← self.eat(TK_COLON, "':' after the name")
        _ ← self.eat(TK_NL, "the methods on their own lines")
        _ ← self.eat(TK_INDENT, "an indented method list")
        while self.peek() ≠ TK_DEDENT and not self.failed():
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
                continue
            let imp : mut bool = false
            let is_noreturn : mut bool = false
            let pres : mut i64[] = []
            let post_toks : mut i64[] = []
            let posts : mut i64[] = []
            while self.peek() = TK_AT and not self.failed():
                self.pos ← self.pos + 1
                let aname := self.ttext(self.pos)
                _ ← self.eat_word("the annotation's name")
                if aname = "impure":
                    imp ← true
                elif aname = "noreturn":
                    is_noreturn ← true
                elif aname = "pre":
                    _ ← self.eat(TK_LPAR, "'(' after @pre")
                    pres.push(self.parse_expr())
                    _ ← self.eat(TK_RPAR, "')' closing @pre")
                elif aname = "post":
                    _ ← self.eat(TK_LPAR, "'(' after @post")
                    post_toks.push(self.pos)
                    _ ← self.eat_name("the name @post gives the result")
                    _ ← self.eat(TK_COLON, "':' after the result's name")
                    posts.push(self.parse_expr())
                    _ ← self.eat(TK_RPAR, "')' closing @post")
                elif aname = "hot" or aname = "cold":
                    // how often a method is expected to run: noted, as
                    // the interpreter notes it
                    let mnoted : i64 = 0
                    _ ← mnoted
                else:
                    self.err("'@" ⧺ aname ⧺ "' is not core-2 on a method")
                    return
                if self.peek() = TK_NL:
                    self.pos ← self.pos + 1
            if self.peek() = TK_FN:
                self.parse_fn(imp, false, is_noreturn, false, 0, false,
                              pres, post_toks, posts, name, sty)
            else:
                self.err("an impl block holds methods and nothing else")
        _ ← self.eat(TK_DEDENT, "the end of the impl block")
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1

    fn parse_global(&mut self, ignored : bool):
        // a top-level let: the same shape a local has
        let stmt : i64 = self.parse_let()
        if self.failed(): return
        let tok : i64 = self.ntok[stmt × 1¤ptrdiff]
        if ignored:
            // @expect: parsed, remembered, left uncompiled
            self.ignored.push(self.ttext(tok))
            return
        self.globals.push(GlobalDef{name: self.ttext(tok), modname: self.curmod, tok: tok,
                                    ty: self.nc[stmt × 1¤ptrdiff],
                                    is_mut: self.nb[stmt × 1¤ptrdiff] = 1,
                                    init: self.na[stmt × 1¤ptrdiff]})

    fn parse_toplevel(&mut self):
        let imp : mut bool = false
        let is_start : mut bool = false
        let is_noreturn : mut bool = false
        let is_test : mut bool = false
        let is_repl : mut bool = false
        let is_exp : mut bool = false
        let is_repr : mut bool = false
        let is_fl : mut bool = false
        let is_build : mut bool = false
        let expects : mut i64 = 0
        let pres : mut i64[] = []
        let post_toks : mut i64[] = []
        let posts : mut i64[] = []
        while self.peek() = TK_AT and not self.failed():
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            _ ← self.eat_word("the annotation's name")
            if name = "impure":
                imp ← true
            elif name = "start":
                is_start ← true
            elif name = "noreturn":
                is_noreturn ← true
            elif name = "test":
                is_test ← true
            elif name = "build":
                // the build recipe: read while the program is built, and
                // no code for it is ever written
                is_build ← true
            elif name = "replaceable":
                is_repl ← true
            elif name = "hot" or name = "cold":
                // how often a function is expected to run: noted and
                // not yet acted on, as the interpreter notes it.  It
                // says where to spend effort, never what to compute.
                let noted : i64 = 0
                _ ← noted
            elif name = "export":
                is_exp ← true
            elif name = "flag":
                // the enum below holds independent bits rather than a
                // count; its automatic values double and combine
                is_fl ← true
            elif name = "repr":
                // @repr(C): the one layout there is.  An unknown name
                // is refused rather than ignored, since accepting it
                // and laying the struct out some other way is the one
                // behaviour guaranteed to corrupt data.
                _ ← self.eat(TK_LPAR, "'(' after @repr")
                let kind := self.ttext(self.pos)
                _ ← self.eat_word("the layout's name")
                if kind ≠ "C":
                    self.err("'@repr(" ⧺ kind ⧺ ")' is not a layout core-2 defines; C is the one there is")
                    return
                _ ← self.eat(TK_RPAR, "')' closing @repr")
                is_repr ← true
            elif name = "expect":
                // @expect level "pattern": the definition is expected
                // to draw diagnostics, so it is parsed and then left
                // uncompiled; the interpreter is where the expectation
                // itself is verified
                let lvl := self.ttext(self.pos)
                if lvl ≠ "error" and lvl ≠ "warning":
                    self.err("@expect names a level, error or warning")
                    return
                self.pos ← self.pos + 1
                if self.peek() ≠ TK_STR:
                    self.err("@expect states the message it expects, as a string")
                    return
                self.pos ← self.pos + 1
                expects ← expects + 1
            elif name = "pre":
                _ ← self.eat(TK_LPAR, "'(' after @pre")
                pres.push(self.parse_expr())
                _ ← self.eat(TK_RPAR, "')' closing @pre")
            elif name = "post":
                _ ← self.eat(TK_LPAR, "'(' after @post")
                post_toks.push(self.pos)
                _ ← self.eat_name("the name @post gives the result")
                _ ← self.eat(TK_COLON, "':' after the result's name")
                posts.push(self.parse_expr())
                _ ← self.eat(TK_RPAR, "')' closing @post")
            else:
                self.err("'@" ⧺ name ⧺ "' is not core-2")
                return
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        if is_repr and self.peek() ≠ TK_STRUCT:
            self.err("@repr gives a struct its layout; nothing else has one")
            return
        if is_fl and self.peek() ≠ TK_ENUM:
            self.err("@flag makes an enum a bit set; nothing else combines")
            return
        if is_build and self.peek() ≠ TK_FN:
            self.err("@build heads the build recipe, which is a function")
            return
        // @start, @test, @export, @replaceable and @impure are all wrong
        // on a recipe for the one reason, so it is given once: a recipe
        // runs while the program is built and nothing of it is written.
        if is_build and (imp or is_start or is_noreturn or is_test or is_repl or is_exp):
            self.err("the @build function carries no other annotation; it is read at compile time and no code for it is written")
            return
        if self.peek() = TK_FN:
            self.parse_fn(imp, is_start, is_noreturn, is_test,
                          (1 if is_repl else 0) + (2 if is_exp else 0)
                              + (4 if is_build else 0),
                          expects > 0,
                          pres, post_toks, posts, "", 0)
        elif is_exp:
            self.err("@export names what others may link against, and only a function is a symbol yet")
            return
        elif self.peek() = TK_STRUCT or self.peek() = TK_IMPL:
            if imp or is_start or is_noreturn or is_test or #pres > 0 or #posts > 0:
                self.err("a struct carries no annotations")
            elif expects > 0:
                // a struct's expected errors are parse-time, which no
                // single pass can both report and ignore
                self.err("@expect covers functions and globals in core-2; an expected-error struct stays in the bootstrap suite")
            elif self.peek() = TK_STRUCT:
                self.parse_struct(is_repr)
            else:
                self.parse_impl()
        elif self.peek() = TK_MODULE:
            if imp or is_start or is_noreturn or is_test or is_repl or is_exp or #pres > 0 or #posts > 0:
                self.err("a module carries no annotations; it says where what follows it lives")
            else:
                self.parse_module_def()
        elif self.peek() = TK_UNIT:
            self.parse_unit_def()
        elif self.peek() = TK_TYPE:
            self.parse_type_alias()
        elif self.peek() = TK_ENUM:
            self.parse_enum(is_fl)
        elif self.peek() = TK_LET:
            if imp or is_start or is_noreturn or is_test or #pres > 0 or #posts > 0:
                self.err("a global binding carries no annotations")
            else:
                self.parse_global(expects > 0)
        else:
            self.err("core-2 has modules, functions, structs, impl blocks, enums, type names and global bindings at the top level")

// The whole file, every definition understood or reported.
fn parse(toks : Toks, src : byte[]) → Ast:
    parse_mode(toks, src, false)

// A recipe's own file, read before the sources it names are known.
// Most of what is written beside the recipe cannot be understood yet --
// a signature naming a struct declared in another file has nothing to
// resolve against -- so every definition is tried and one that draws
// diagnostics is dropped, its diagnostics rolled back, rather than
// reported.  What is left is the recipe and whatever parses beside it,
// which is what the recipe may reach.  A recipe that itself fails to
// parse is not dropped: that is reported, since there is then nothing
// to run.
fn parse_recipe(toks : Toks, src : byte[]) → Ast:
    parse_mode(toks, src, true)

fn parse_mode(toks : Toks, src : byte[], lenient : bool) → Ast:
    let p : mut Parser = (Parser{toks: toks, src: src, pos: 0,
                                 nkind: [], ntok: [], na: [], nb: [], nc: [],
                                 extra: [], fns: [], curmod: "", mods: [], modtok: [], qmods: [],
                                 builds: [], globals: [], structs: [],
                                 tanames: [], tatypes: [],
                                 unames: unit_names(), umarks: unit_marks(),
                                 udecay: unit_decays(),
                                 udname: unit_none_names(),
                                 udtok: unit_decays(),
                                 snames: [], tts: [], ttl: [], tte: [],
                                 fae: [], fas: [],
                                 mel: [], mrr: [], mcc: [], mdd: [], minner: [],
                                 lts: [], ltl: [], lte: [],
                                 enames: builtin_enum_names(),
                                 ewidth: builtin_enum_widths(),
                                 estart: [0], ecount: [8], eflag: [0],
                                 emembers: builtin_enum_members(),
                                 evalues: builtin_enum_values(),
                                 tvn: [], braces: 0,
                                 ignored: [], igtests: [],
                                 diags: [], poisoned: false})
    // a struct may be written below whatever names it, so the names
    // are gathered in one sweep before anything is parsed
    let n : i64 = @dropunit(#toks.kind)
    let i : mut i64 = 0
    // The modules are gathered in the same sweep, and for the same
    // reason: a call may name one the file declares further down, and
    // `a.b.f()` cannot be told from a field of a until it is known that
    // a.b is a module.  The sweep replays the sectioning, since what a
    // bare name means depends on the module in hand when it is read.
    let here : mut str = ""
    while i + 1 < n:
        if toks.kind[i × 1¤ptrdiff] = TK_STRUCT and toks.kind[(i + 1) × 1¤ptrdiff] = TK_IDENT:
            p.snames.push(run_str(src, toks.off[(i + 1) × 1¤ptrdiff],
                                  toks.len[(i + 1) × 1¤ptrdiff]))
        if toks.kind[i × 1¤ptrdiff] = TK_MODULE:
            let kw : i64 = i
            let j : mut i64 = i + 1
            let absolute : bool = toks.kind[j × 1¤ptrdiff] = TK_DOT
            if absolute:
                j ← j + 1
            let path : mut str = ""
            while toks.kind[j × 1¤ptrdiff] = TK_IDENT:
                path ← path ⧺ ("" if path = "" else ".") ⧺ run_str(src, toks.off[j × 1¤ptrdiff], toks.len[j × 1¤ptrdiff])
                j ← j + 1
                if toks.kind[j × 1¤ptrdiff] ≠ TK_DOT or toks.kind[(j + 1) × 1¤ptrdiff] ≠ TK_IDENT:
                    j ← j
                else:
                    j ← j + 1
            here ← "" if path = "" else (path if absolute or here = "" else here ⧺ "." ⧺ path)
            if here ≠ "" and not p.knows_module(here):
                p.mods.push(here)
                p.modtok.push(kw)
        i ← i + 1
    while p.peek() ≠ TK_EOF:
        if p.peek() = TK_NL:
            p.pos ← p.pos + 1
        else:
            let d0 : i64 = @dropunit(#p.diags)
            let f0 : i64 = @dropunit(#p.fns)
            let g0 : i64 = @dropunit(#p.globals)
            let b0 : i64 = @dropunit(#p.builds)
            p.parse_toplevel()
            // a definition that did not parse is dropped whole, so
            // nothing half-built is left where the recipe can call it
            if lenient and @dropunit(#p.diags) > d0 and @dropunit(#p.builds) = b0:
                while @dropunit(#p.diags) > d0:
                    _ ← p.diags.pop() ?? (Diag{line: 1¤"line", col: 1¤"col", msg: ""})
                while @dropunit(#p.fns) > f0:
                    _ ← p.fns.pop() ?? p.fns[0 × 1¤ptrdiff]
                while @dropunit(#p.globals) > g0:
                    _ ← p.globals.pop() ?? p.globals[0 × 1¤ptrdiff]
            if p.poisoned:
                p.poisoned ← false
                // hunt for the next definition at the left margin
                while p.peek() ≠ TK_EOF:
                    let k2 : i64 = p.peek()
                    if k2 = TK_INDENT:
                        p.skip_block()
                    elif k2 = TK_FN or k2 = TK_STRUCT or k2 = TK_IMPL or k2 = TK_LET or k2 = TK_AT:
                        break
                    else:
                        p.pos ← p.pos + 1
    p.resolve_decays()
    if #p.diags = 0 and not lenient:
        // the type table was built from the pre-scan; a parse that
        // succeeded must have seen the same structs in the same order.
        // A lenient parse drops what it could not understand, so its
        // structs are a subset by design.
        assert(#p.structs = #p.snames, "every pre-scanned struct parsed")
        assert(#p.nkind = #p.ntok and #p.nkind = #p.na, "node arrays in step")
        assert(#p.nkind = #p.nb and #p.nkind = #p.nc, "node arrays in step")
    (Ast{nkind: p.nkind, ntok: p.ntok, na: p.na, nb: p.nb, nc: p.nc,
         extra: p.extra, strs: p.toks.strs, fns: p.fns,
         mods: p.mods, modtok: p.modtok, qmods: p.qmods, builds: p.builds,
         globals: p.globals,
         structs: p.structs, tts: p.tts, ttl: p.ttl, tte: p.tte,
         fae: p.fae, fas: p.fas,
         mel: p.mel, mrr: p.mrr, mcc: p.mcc, mdd: p.mdd, minner: p.minner,
         lts: p.lts, ltl: p.ltl, lte: p.lte,
         unames: p.unames, umarks: p.umarks, udecay: p.udecay,
         enames: p.enames, ewidth: p.ewidth, estart: p.estart,
         ecount: p.ecount, eflag: p.eflag, emembers: p.emembers,
         evalues: p.evalues,
         ignored: p.ignored, igtests: p.igtests, diags: p.diags})

