    em.b3(77, 57, 218)              // cmp r10, r11
    em.jlocal(134, 1)               // jbe Lins: load stays under 7/8
    em.b4(72, 139, 124, 36)
    em.b1(16)                       // mov rdi, [rsp+16]
    em.jglobal(232, ⁻1, emit.RT_HGROW)
