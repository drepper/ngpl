    em.b4(72, 193, 225, 4)          // shl rcx, 4
    em.b4(72, 139, 52, 10)          // mov rsi, [rdx+rcx]: the key
    em.b4(72, 139, 68, 10)
    em.b1(8)                        // mov rax, [rdx+rcx+8]
    em.b4(72, 137, 68, 36)
