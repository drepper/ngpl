    em.b4(72, 131, 196, 24)         // add rsp, 24
    em.b1(195)
    em.set_label(0)                 // Lheld
    em.b4(72, 139, 83, 8)           // mov rdx, [rbx+8]
    em.b4(72, 193, 224, 4)          // shl rax, 4
    em.b4(72, 139, 12, 36)          // mov rcx, [rsp]
    em.b4(72, 137, 76, 2)
    em.b1(8)                        // mov [rdx+rax+8], rcx
    em.b4(72, 131, 196, 24)         // add rsp, 24
    em.b1(195)
    em.resolve_locals()

