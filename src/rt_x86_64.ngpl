// ===========================================================================
// x86-64: the runtime, as machine code
// ===========================================================================
//
// Routines over raw syscalls, no libc, written by hand for the pioneer.
// The other five targets get the same routines from rt_portable.ngpl,
// which writes them once as IR and lets the driver spell them; these
// are what those are checked against.

let arch_x86_64 := @import("arch_x86_64")
let elf := @import("elf")
let emit := @import("emit")
let lower := @import("lower")
let rt_backtrace := @import("rt_backtrace")
let rt_bigint := @import("rt_bigint")
let rt_hash := @import("rt_hash")
let rt_portable := @import("rt_portable")
let rt_sha256 := @import("rt_sha256")

// A write takes (buf, len) in the ordinary argument registers -- the
// way every other routine takes its arguments, and the way
// rt_portable.ngpl writes this one for the other five targets.  It once
// took rsi and rdx, the syscall's own registers, because its only
// caller was the emitter for IR_PRINTS, which had them at hand; the
// first IR-built routine to call it handed rdi and rsi and wrote
// nothing.  RT_ABORT still keeps that private convention, stated where
// it is written, because nothing reaches it except by hand.
//
// The loop is the other half of the agreement: write says how much it
// took, and a pipe is free to take less than it was offered.


fn emit_write(em : &mut emit.Emit, fd : i64):
    em.begin_fn(2)
    em.b3(72, 137, 242)             // mov rdx, rsi -- what is left
    em.b3(72, 137, 254)             // mov rsi, rdi -- where it stands
    em.movimm(emit.R_DI, fd)
    em.set_label(0)
    em.b3(72, 133, 210)             // test rdx, rdx
    em.jlocal(132, 1)               // jz: nothing left
    em.movimm(emit.R_AX, 1)              // SYS_write
    em.b2(15, 5)                    // syscall
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(142, 1)               // jle: an error, or nothing taken
    em.b3(72, 1, 198)               // add rsi, rax
    em.b3(72, 41, 194)              // sub rdx, rax
    em.jlocal(⁻1, 0)
    em.set_label(1)
    em.b1(195)
    em.resolve_locals()

@export
fn emit_runtime(em : &mut emit.Emit, tg : elf.Target, lw : &mut lower.Lower, alloc_off : i64, args_off : i64,
                relro_off : i64):
    // RT_PRINTI: rdi = signed value → decimal on fd 1
    em.rt_begin(emit.RT_PRINTI)
    em.begin_fn(3)
    em.b4(72, 131, 236, 40)         // sub rsp, 40
    em.b3(76, 141, 76)
    em.b2(36, 39)                   // lea r9, [rsp+39]
    em.b3(77, 49, 210)              // xor r10, r10
    em.b3(72, 137, 248)             // mov rax, rdi
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(137, 0)               // jns L0
    em.b3(73, 199, 194)
    em.w32(1)                       // mov r10, 1
    em.b3(72, 247, 216)             // neg rax
    em.set_label(0)
    em.b3(72, 199, 193)
    em.w32(10)                      // mov rcx, 10
    em.set_label(1)
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.b3(72, 247, 241)             // div rcx
    em.b3(128, 194, 48)             // add dl, '0'
    em.b3(73, 255, 201)             // dec r9
    em.b3(65, 136, 17)              // mov [r9], dl
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(133, 1)               // jnz L1
    em.b3(77, 133, 210)             // test r10, r10
    em.jlocal(132, 2)               // jz L2
    em.b3(73, 255, 201)             // dec r9
    em.b4(65, 198, 1, 45)           // mov byte [r9], '-'
    em.set_label(2)
    em.b3(72, 141, 84)
    em.b2(36, 39)                   // lea rdx, [rsp+39]
    em.b3(76, 41, 202)              // sub rdx, r9
    em.b3(76, 137, 206)             // mov rsi, r9
    em.movimm(emit.R_DI, 1)
    em.movimm(emit.R_AX, 1)
    em.b2(15, 5)
    em.b4(72, 131, 196, 40)         // add rsp, 40
    em.b1(195)
    em.resolve_locals()

    // RT_WRITE1: (buf, len) onto the output stream
    em.rt_begin(emit.RT_WRITE1)
    emit_write(&em, 1)

    // RT_ABORT: rsi = message, rdx = its length.  Say it, then leave
    // through exit with a status rather than through a signal: a
    // signal is not a status, and a caller should not have to know to
    // look for one.
    em.rt_begin(emit.RT_ABORT)
    // A frame of its own, which this routine wanted for nothing until
    // there was a backtrace to make.  The chain a walk follows is one
    // of frames, and a frameless routine is a step the walk cannot
    // take: without this the innermost function -- the one the stop
    // happened in -- would be the one name missing from what is
    // printed.  Reached by a call or by a jump from RT_BOUNDS and its
    // kind, which push no frame either, so what sits above the saved
    // pointer is the address inside that function both ways.  Nothing
    // returns from here, so there is no epilogue to match.
    em.b1(85)                       // push rbp
    em.b3(72, 137, 229)             // mov rbp, rsp
    em.movimm(emit.R_AX, 1)
    em.movimm(emit.R_DI, 2)
    em.b2(15, 5)                    // write(2, rsi, rdx)
    // …and how the program got here.  Nothing pushed a frame between
    // the stop and this call, so rbp is still the frame the stop
    // happened in and the walk starts where it should.
    em.jglobal(232, ⁻1, emit.RT_BT)
    em.movimm(emit.R_DI, emit.EXIT_STOP)
    em.movimm(emit.R_AX, 60)
    em.b2(15, 5)                    // exit
    em.b2(15, 11)                   // ud2, which nothing reaches

    // RT_OV
    em.rt_begin(emit.RT_OV)
    let ovm : i64 = lw.intern("integer overflow\n")
    em.sref(emit.R_SI, ovm)
    em.movimm(emit.R_DX, emit.str_len(lw.strs[ovm × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, emit.RT_ABORT)

    // RT_SHIFT
    em.rt_begin(emit.RT_SHIFT)
    let shm : i64 = lw.intern("shift count is past the type\n")
    em.sref(emit.R_SI, shm)
    em.movimm(emit.R_DX, emit.str_len(lw.strs[shm × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, emit.RT_ABORT)

    // RT_BOUNDS
    em.rt_begin(emit.RT_BOUNDS)
    let bdm : i64 = lw.intern("index out of range\n")
    em.sref(emit.R_SI, bdm)
    em.movimm(emit.R_DX, emit.str_len(lw.strs[bdm × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, emit.RT_ABORT)

    // RT_OOM
    em.rt_begin(emit.RT_OOM)
    let oom : i64 = lw.intern("out of memory\n")
    em.sref(emit.R_SI, oom)
    em.movimm(emit.R_DX, emit.str_len(lw.strs[oom × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, emit.RT_ABORT)

    // RT_ALLOC: rdi = size → rax; a bump pointer over mmap regions
    em.rt_begin(emit.RT_ALLOC)
    em.begin_fn(2)
    em.b4(76, 141, 87, 15)          // lea r10, [rdi+15]
    em.b4(73, 131, 226, 240)        // and r10, -16
    em.dref(emit.R_R11, alloc_off)
    // A block given back of exactly this size is handed out again.
    // The slot is (size ÷ 16) mod AL_SLOTS, and whatever sizes share a
    // slot, only the one that matches exactly is taken -- handing back
    // a block too small is the one mistake that must not happen here.
    em.b3(76, 137, 209)             // mov rcx, r10
    em.b4(72, 193, 233, 4)          // shr rcx, 4
    em.b3(72, 105, 201)
    em.w32(emit.AL_MIX)                  // imul rcx, rcx, AL_MIX
    em.b4(72, 193, 233, emit.AL_SHIFT)   // shr rcx, AL_SHIFT
    em.b2(129, 225)
    em.w32(emit.AL_SLOTS - 1)            // and ecx, AL_SLOTS-1
    em.b4(73, 141, 76, 203)
    em.b1(emit.AL_FREE)                  // lea rcx, [r11+rcx*8+AL_FREE]
    em.b3(72, 139, 1)               // mov rax, [rcx]
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(132, 1)               // jz L1: the slot is empty
    em.b4(76, 57, 80, 8)            // cmp [rax+8], r10
    em.jlocal(133, 1)               // jne L1: another size lives here
    em.b3(72, 139, 16)              // mov rdx, [rax]
    em.b3(72, 137, 17)              // mov [rcx], rdx
    em.b1(195)                      // ret with the block
    em.set_label(1)
    em.b3(73, 139, 3)               // mov rax, [r11]
    em.b4(74, 141, 20, 16)          // lea rdx, [rax+r10]
    em.b4(73, 59, 83, 8)            // cmp rdx, [r11+8]
    em.jlocal(134, 0)               // jbe L0: it fits
    em.b2(65, 82)                   // push r10
    em.b3(73, 141, 178)
    em.w32(4095)                    // lea rsi, [r10+4095]
    em.b3(72, 129, 230)
    em.w32(⁻4096)                   // and rsi, -4096
    em.movimm(emit.R_CX, 1048576)
    em.b3(72, 57, 206)              // cmp rsi, rcx
    em.b4(72, 15, 66, 241)          // cmovb rsi, rcx
    em.b2(49, 255)                  // xor edi, edi
    em.movimm(emit.R_DX, 3)
    em.movimm(emit.R_R10, 34)
    em.movimm(emit.R_R8, ⁻1)
    em.b3(69, 49, 201)              // xor r9d, r9d
    em.movimm(emit.R_AX, 9)
    em.b2(15, 5)                    // mmap
    em.b3(72, 133, 192)             // test rax, rax
    em.jglobal(0, 136, emit.RT_OOM)      // js: the kernel said no
    em.b2(65, 90)                   // pop r10
    em.dref(emit.R_R11, alloc_off)
    em.b3(73, 137, 3)               // mov [r11], rax
    em.b4(72, 141, 20, 48)          // lea rdx, [rax+rsi]
    em.b4(73, 137, 83, 8)           // mov [r11+8], rdx
    em.set_label(0)
    em.b3(73, 139, 3)               // mov rax, [r11]
    em.b4(74, 141, 20, 16)          // lea rdx, [rax+r10]
    em.b3(73, 137, 19)              // mov [r11], rdx
    em.b1(195)
    em.resolve_locals()

    // RT_FREE: rdi = block, rsi = its size.  The block goes on the
    // list for its size and keeps that list in its own first two
    // words, so nothing smaller than those two words is taken back.
    em.rt_begin(emit.RT_FREE)
    em.begin_fn(1)
    em.b4(76, 141, 86, 15)          // lea r10, [rsi+15]
    em.b4(73, 131, 226, 240)        // and r10, -16
    em.b4(73, 131, 250, 16)         // cmp r10, 16
    em.jlocal(130, 0)               // jb L0: too small to hold a link
    em.dref(emit.R_R11, alloc_off)
    em.b3(76, 137, 209)             // mov rcx, r10
    em.b4(72, 193, 233, 4)          // shr rcx, 4
    em.b3(72, 105, 201)
    em.w32(emit.AL_MIX)                  // imul rcx, rcx, AL_MIX
    em.b4(72, 193, 233, emit.AL_SHIFT)   // shr rcx, AL_SHIFT
    em.b2(129, 225)
    em.w32(emit.AL_SLOTS - 1)            // and ecx, AL_SLOTS-1
    em.b4(73, 141, 76, 203)
    em.b1(emit.AL_FREE)                  // lea rcx, [r11+rcx*8+AL_FREE]
    em.b3(72, 139, 17)              // mov rdx, [rcx]
    em.b3(72, 137, 23)              // mov [rdi], rdx
    em.b4(76, 137, 87, 8)           // mov [rdi+8], r10
    em.b3(72, 137, 57)              // mov [rcx], rdi
    em.set_label(0)
    em.b1(195)
    em.resolve_locals()

    // RT_ARRNEW: rdi = capacity in elements → rax = descriptor
    em.rt_begin(emit.RT_ARRNEW)
    em.b1(87)                       // push rdi
    em.b3(72, 141, 60)
    em.b4(253, 24, 0, 0)
    em.b1(0)                        // lea rdi, [rdi*8+24]
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b1(89)                       // pop rcx
    em.b2(49, 210)                  // xor edx, edx
    em.b4(72, 137, 80, 8)           // mov [rax+8], rdx
    em.b4(72, 137, 72, 16)          // mov [rax+16], rcx
    em.b4(72, 141, 80, 24)          // lea rdx, [rax+24]
    em.b3(72, 137, 16)              // mov [rax], rdx
    em.b1(195)

    // RT_ARRPUSH: rdi = descriptor, rsi = value
    em.rt_begin(emit.RT_ARRPUSH)
    em.begin_fn(4)
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b4(72, 59, 79, 16)           // cmp rcx, [rdi+16]
    em.jlocal(130, 0)               // jb L0: room enough
    em.b1(87)                       // push rdi
    em.b1(86)                       // push rsi
    em.b4(72, 139, 119, 16)         // mov rsi, [rdi+16]
    em.b3(72, 1, 246)               // add rsi, rsi
    em.movimm(emit.R_CX, 8)
    em.b3(72, 57, 206)              // cmp rsi, rcx
    em.b4(72, 15, 66, 241)          // cmovb rsi, rcx
    em.b1(86)                       // push rsi (the new capacity)
    em.b3(72, 141, 60)
    em.b4(245, 0, 0, 0)
    em.b1(0)                        // lea rdi, [rsi*8]
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b2(65, 89)                   // pop r9 (new capacity)
    em.b1(94)                       // pop rsi (value)
    em.b1(95)                       // pop rdi (descriptor)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(1)
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 2)               // jbe L2: copied
    em.b4(78, 139, 28, 210)         // mov r11, [rdx+r10*8]
    em.b4(78, 137, 28, 208)         // mov [rax+r10*8], r11
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 1)
    em.set_label(2)
    // The slots just copied out of are unreachable the moment the copy
    // is done: nothing may hold a pointer into an array while it
    // grows, which is what a walk refusing to let its container change
    // is for.  So they go back -- unless they are the ones RT_ARRNEW
    // laid inside the descriptor, which are not a block of their own.
    // The old capacity is still in the descriptor here, which is where
    // the size to give back comes from.
    em.b4(76, 139, 87, 16)          // mov r10, [rdi+16]
    em.b4(73, 193, 226, 3)          // shl r10, 3
    em.b4(72, 141, 79, 24)          // lea rcx, [rdi+24]
    em.b3(72, 57, 202)              // cmp rdx, rcx
    em.jlocal(132, 3)               // je L3: they are the inline ones
    // rsi still holds the value this push is for, and the call is
    // about to want it for the size, so it is saved with the rest
    em.b1(80)                       // push rax
    em.b1(87)                       // push rdi
    em.b1(86)                       // push rsi
    em.b2(65, 81)                   // push r9
    em.b3(72, 137, 215)             // mov rdi, rdx
    em.b3(76, 137, 214)             // mov rsi, r10
    em.jglobal(232, ⁻1, emit.RT_FREE)
    em.b2(65, 89)                   // pop r9
    em.b1(94)                       // pop rsi
    em.b1(95)                       // pop rdi
    em.b1(88)                       // pop rax
    em.set_label(3)
    em.b3(72, 137, 7)               // mov [rdi], rax
    em.b4(76, 137, 79, 16)          // mov [rdi+16], r9
    em.set_label(0)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b4(72, 137, 52, 202)         // mov [rdx+rcx*8], rsi
    em.b3(72, 255, 193)             // inc rcx
    em.b4(72, 137, 79, 8)           // mov [rdi+8], rcx
    em.b1(195)
    em.resolve_locals()

    // RT_CONCAT: rdi, rsi = descriptors → rax = the joined string
    em.rt_begin(emit.RT_CONCAT)
    em.begin_fn(4)
    em.b1(87)                       // push rdi
    em.b1(86)                       // push rsi
    em.b4(72, 139, 87, 8)           // mov rdx, [rdi+8]
    em.b4(72, 3, 86, 8)             // add rdx, [rsi+8]
    em.b1(82)                       // push rdx
    em.b4(72, 141, 122, 16)         // lea rdi, [rdx+16]
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b1(90)                       // pop rdx
    em.b4(72, 141, 72, 16)          // lea rcx, [rax+16]
    em.b3(72, 137, 8)               // mov [rax], rcx
    em.b4(72, 137, 80, 8)           // mov [rax+8], rdx
    em.b1(94)                       // pop rsi (b)
    em.b1(95)                       // pop rdi (a)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(76, 139, 71, 8)           // mov r8, [rdi+8]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(0)
    em.b3(77, 57, 208)              // cmp r8, r10
    em.jlocal(134, 1)               // jbe L1
    em.b4(70, 138, 28, 18)          // mov r11b, [rdx+r10]
    em.b4(70, 136, 28, 17)          // mov [rcx+r10], r11b
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 0)
    em.set_label(1)
    em.b3(76, 1, 193)               // add rcx, r8
    em.b3(72, 139, 22)              // mov rdx, [rsi]
    em.b4(76, 139, 70, 8)           // mov r8, [rsi+8]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(2)
    em.b3(77, 57, 208)              // cmp r8, r10
    em.jlocal(134, 3)               // jbe L3
    em.b4(70, 138, 28, 18)          // mov r11b, [rdx+r10]
    em.b4(70, 136, 28, 17)          // mov [rcx+r10], r11b
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 2)
    em.set_label(3)
    em.b1(195)
    em.resolve_locals()

    // RT_STREQ: rdi, rsi = descriptors → rax = 0 or 1
    em.rt_begin(emit.RT_STREQ)
    em.begin_fn(3)
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b4(72, 59, 78, 8)            // cmp rcx, [rsi+8]
    em.jlocal(133, 0)               // jne Lfalse
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b3(76, 139, 6)               // mov r8, [rsi]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(1)
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 2)               // jbe Ltrue
    em.b4(70, 138, 12, 18)          // mov r9b, [rdx+r10]
    em.b4(71, 58, 12, 16)           // cmp r9b, [r8+r10]
    em.jlocal(133, 0)               // jne Lfalse
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 1)
    em.set_label(2)
    em.movimm(emit.R_AX, 1)
    em.b1(195)
    em.set_label(0)
    em.b2(49, 192)                  // xor eax, eax
    em.b1(195)
    em.resolve_locals()

    // RT_STRCHARS: rdi = descriptor → rax = characters, counted by
    // lead bytes with a materialized test -- no branch in the body
    em.rt_begin(emit.RT_STRCHARS)
    em.begin_fn(2)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b2(49, 192)                  // xor eax, eax
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(0)
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 1)               // jbe done
    em.b4(70, 138, 12, 18)          // mov r9b, [rdx+r10]
    em.b4(65, 128, 225, 192)        // and r9b, 0xC0
    em.b4(65, 128, 249, 128)        // cmp r9b, 0x80
    em.b3(65, 15, 149)
    em.b1(193)                      // setne r9b
    em.b4(77, 15, 182, 201)         // movzx r9, r9b
    em.b3(76, 1, 200)               // add rax, r9
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 0)
    em.set_label(1)
    em.b1(195)
    em.resolve_locals()

    // RT_PRINTSTR: rdi = descriptor
    em.rt_begin(emit.RT_PRINTSTR)
    em.b3(72, 139, 119)
    em.b1(0)                        // mov rsi, [rdi]  (disp8 0)
    em.b4(72, 139, 87, 8)           // mov rdx, [rdi+8]
    em.movimm(emit.R_DI, 1)
    em.movimm(emit.R_AX, 1)
    em.b2(15, 5)
    em.b1(195)

    // RT_PRINTU: rdi = unsigned value → decimal on fd 1
    em.rt_begin(emit.RT_PRINTU)
    em.begin_fn(1)
    em.b4(72, 131, 236, 40)         // sub rsp, 40
    em.b3(76, 141, 76)
    em.b2(36, 39)                   // lea r9, [rsp+39]
    em.b3(72, 137, 248)             // mov rax, rdi
    em.b3(72, 199, 193)
    em.w32(10)                      // mov rcx, 10
    em.set_label(0)
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.b3(72, 247, 241)             // div rcx
    em.b3(128, 194, 48)             // add dl, '0'
    em.b3(73, 255, 201)             // dec r9
    em.b3(65, 136, 17)              // mov [r9], dl
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(133, 0)               // jnz
    em.b3(72, 141, 84)
    em.b2(36, 39)                   // lea rdx, [rsp+39]
    em.b3(76, 41, 202)              // sub rdx, r9
    em.b3(76, 137, 206)             // mov rsi, r9
    em.movimm(emit.R_DI, 1)
    em.movimm(emit.R_AX, 1)
    em.b2(15, 5)
    em.b4(72, 131, 196, 40)         // add rsp, 40
    em.b1(195)
    em.resolve_locals()

    // A hash is a descriptor of ctrl, kv, count, cap, keystr over one
    // allocation: 1 ctrl byte per slot (0 empty, 1 held) and 16-byte
    // key/value pairs, capacity a power of two, load kept under 7/8,
    // linear probing.  Fresh memory from RT_ALLOC is virgin mmap and
    // so already zero: a new table's ctrl bytes need no clearing.

    // RT_HNEW: rdi = capacity (a power of two, at least a group's
    // sixteen), rsi = 1 for str keys → rax = descriptor
    em.rt_begin(emit.RT_HNEW)
    em.movimm(emit.R_AX, 16)
    em.b3(72, 57, 199)              // cmp rdi, rax
    em.b4(72, 15, 66, 248)          // cmovb rdi, rax: never below a group
    em.b1(86)                       // push rsi
    em.b1(87)                       // push rdi
    em.b4(72, 193, 231, 4)          // shl rdi, 4
    em.b4(72, 3, 60, 36)            // add rdi, [rsp]: 17 bytes a slot
    em.b4(72, 131, 199, 40)         // add rdi, 40: the descriptor
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b1(89)                       // pop rcx (capacity)
    em.b1(90)                       // pop rdx (keystr)
    em.b4(72, 141, 112, 40)         // lea rsi, [rax+40]: ctrl
    em.b3(72, 137, 48)              // mov [rax], rsi
    em.b4(72, 141, 52, 14)          // lea rsi, [rsi+rcx]: kv
    em.b4(72, 137, 112, 8)          // mov [rax+8], rsi
    em.b3(69, 49, 210)              // xor r10d, r10d
    em.b4(76, 137, 80, 16)          // mov [rax+16], r10: count
    em.b4(72, 137, 72, 24)          // mov [rax+24], rcx: cap
    em.b4(72, 137, 80, 32)          // mov [rax+32], rdx: keystr
