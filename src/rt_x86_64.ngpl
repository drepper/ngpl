    // RT_HFIND: rdi = descriptor, rsi = key → rax = the key's slot or
    // an empty one, rdx = 1 found / 0 empty, r13 = the slot's tag.
    // Leaves rbx = the descriptor and r12 = the key for its callers.
    //
    // The probe reads sixteen control bytes at a time.  A held slot's
    // control byte is its hash's low seven bits with the high bit set,
    // so it is never zero and an empty slot stays the zero that fresh
    // memory already is: one compare against the tag finds every
    // candidate in the group, and one against zero finds whether the
    // group has room -- and if it has, the key is not in the table at
    // all, since a run of probes never steps over an empty slot.
    // Groups are aligned to sixteen and the capacity is a power of two
    // no smaller, so a group never straddles the end and needs no
    // mirrored bytes after it.  The load is kept under seven eighths,
    // so some group always has room and the walk always ends.
    em.rt_begin(emit.RT_HFIND)
    em.begin_fn(10)
    em.b3(72, 137, 251)             // mov rbx, rdi
    em.b3(73, 137, 244)             // mov r12, rsi
    em.b4(76, 139, 115, 24)         // mov r14, [rbx+24]
    em.b3(73, 255, 206)             // dec r14: the mask
    em.b4(72, 139, 67, 32)          // mov rax, [rbx+32]: keystr
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(133, 0)               // jnz Lstr
    em.b3(76, 137, 224)             // mov rax, r12
    em.b3(72, 137, 193)             // mov rcx, rax
    em.b4(72, 193, 233, 33)         // shr rcx, 33
    em.b3(72, 49, 200)              // xor rax, rcx
    em.movimm(emit.R_CX, ⁻49064778989728563)  // the murmur3 finalizer constant
    em.b4(72, 15, 175, 193)         // imul rax, rcx
    em.b3(72, 137, 193)             // mov rcx, rax
    em.b4(72, 193, 233, 33)         // shr rcx, 33
    em.b3(72, 49, 200)              // xor rax, rcx
    em.jlocal(⁻1, 2)                // jmp Lprobe
    em.set_label(0)                 // Lstr: FNV-1a over the bytes
    em.b3(73, 139, 20)
    em.b1(36)                       // mov rdx, [r12]
    em.b4(73, 139, 76, 36)
    em.b1(8)                        // mov rcx, [r12+8]
    em.movimm(emit.R_AX, ⁻3750763034362895579)  // the FNV offset basis
    em.movimm(emit.R_R11, 1099511628211)      // the FNV prime
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(1)                 // Lfnv
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 2)               // jbe Lprobe
    em.b4(78, 15, 182, 12)
    em.b1(18)                       // movzx r9, byte [rdx+r10]
    em.b3(76, 49, 200)              // xor rax, r9
    em.b4(73, 15, 175, 195)         // imul rax, r11
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 1)
    em.set_label(2)                 // Lprobe: the tag from the low bits,
    em.b3(73, 137, 197)             // mov r13, rax
    em.b4(73, 131, 229, 127)        // and r13, 127
    em.b3(73, 129, 205)
    em.w32(128)                     // or r13, 128: never the empty byte
    em.b4(72, 193, 232, 7)          // shr rax, 7: the group from the rest
    em.b3(76, 33, 240)              // and rax, r14
    em.b4(72, 131, 224, 240)        // and rax, ⁻16: groups are aligned
    em.b3(73, 137, 199)             // mov r15, rax
    em.set_label(3)                 // Lgroup
    em.b3(76, 137, 234)             // mov rdx, r13
    em.movimm(emit.R_CX, 72340172838076673)   // the tag in all sixteen lanes
    em.b4(72, 15, 175, 209)         // imul rdx, rcx
    em.b4(102, 72, 15, 110)
    em.b1(202)                      // movq xmm1, rdx
    em.b4(102, 15, 108, 201)        // punpcklqdq xmm1, xmm1
    em.b3(72, 139, 11)              // mov rcx, [rbx]: ctrl
    em.b4(243, 66, 15, 111)
    em.b2(4, 57)                    // movdqu xmm0, [rcx+r15]
    em.b4(102, 15, 116, 193)        // pcmpeqb xmm0, xmm1
    em.b4(102, 15, 215, 192)        // pmovmskb eax, xmm0
    em.b3(73, 137, 193)             // mov r9, rax: the candidates
    em.set_label(4)                 // Lbit
    em.b3(77, 133, 201)             // test r9, r9
    em.jlocal(132, 8)               // jz Lroom
    em.b4(73, 15, 188, 201)         // bsf rcx, r9
    em.b4(77, 141, 20, 15)          // lea r10, [r15+rcx]: the slot
    em.b4(72, 139, 83, 8)           // mov rdx, [rbx+8]
    em.b3(76, 137, 208)             // mov rax, r10
    em.b4(72, 193, 224, 4)          // shl rax, 4
    em.b4(72, 139, 12, 2)           // mov rcx, [rdx+rax]: the key held
    em.b4(72, 139, 67, 32)          // mov rax, [rbx+32]
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(133, 5)               // jnz Lstrcmp
    em.b3(76, 57, 225)              // cmp rcx, r12
    em.jlocal(132, 6)               // je Lfound
    em.jlocal(⁻1, 7)                // jmp Lclear
    em.set_label(5)                 // Lstrcmp
    em.b2(65, 81)                   // push r9
    em.b2(65, 82)                   // push r10
    em.b3(72, 137, 207)             // mov rdi, rcx
    em.b3(76, 137, 230)             // mov rsi, r12
    em.jglobal(232, ⁻1, emit.RT_STREQ)
