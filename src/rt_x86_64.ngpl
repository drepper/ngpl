    em.b4(72, 137, 80, 8)           // mov [rax+8], rdx
    em.b3(72, 137, 223)             // mov rdi, rbx
    em.b3(72, 137, 198)             // mov rsi, rax
    em.jglobal(232, ⁻1, emit.RT_ARRPUSH)
    em.jlocal(⁻1, 1)
    em.set_label(7)                 // Lclose
    em.b3(76, 137, 231)             // mov rdi, r12
    em.movimm(emit.R_AX, 3)
    em.b2(15, 5)
    em.set_label(8)                 // Lret
    em.b4(72, 131, 196, 32)         // add rsp, 32
    em.b3(72, 137, 216)             // mov rax, rbx
    em.b1(195)
    em.resolve_locals()

    // RT_ENVN: → rax = a str[] of the environment's names, the part of
    // each entry before its '=' -- or the whole of one that has none,
    // as the interpreter's names() reads them
    em.rt_begin(emit.RT_ENVN)
    em.begin_fn(6)
    em.dref(emit.R_R11, args_off)
    em.b4(77, 139, 107, 16)         // mov r13, [r11+16]: envp
    em.b3(77, 49, 228)              // xor r12, r12
    em.set_label(0)                 // Lcount
    em.b4(75, 139, 68, 229)
    em.b1(0)                        // mov rax, [r13+r12*8]
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(132, 1)               // je Lgot
    em.b3(73, 255, 196)             // inc r12
    em.jlocal(⁻1, 0)
    em.set_label(1)                 // Lgot: r12 holds the count
    em.b3(76, 137, 231)             // mov rdi, r12
    em.jglobal(232, ⁻1, emit.RT_ARRNEW)
    em.b3(72, 137, 195)             // mov rbx, rax
    em.b3(77, 49, 246)              // xor r14, r14
    em.set_label(2)                 // Lloop
    em.b3(77, 57, 244)              // cmp r12, r14
    em.jlocal(134, 3)               // jbe Ldone
    em.b4(79, 139, 124, 245)
    em.b1(0)                        // mov r15, [r13+r14*8]
    em.b3(72, 49, 201)              // xor rcx, rcx
    em.set_label(4)                 // Lname
    em.b4(65, 138, 4, 15)           // mov al, [r15+rcx]
    em.b2(132, 192)                 // test al, al
    em.jlocal(132, 5)               // je Lend
    em.b2(60, 61)                   // cmp al, '='
    em.jlocal(132, 5)               // je Lend
    em.b3(72, 255, 193)             // inc rcx
    em.jlocal(⁻1, 4)
    em.set_label(5)                 // Lend: rcx is the name's length
    em.b1(81)                       // push rcx
    em.movimm(emit.R_DI, 16)
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b1(89)                       // pop rcx
    em.b3(76, 137, 56)              // mov [rax], r15
    em.b4(72, 137, 72, 8)           // mov [rax+8], rcx
    em.b3(72, 139, 19)              // mov rdx, [rbx]
    em.b4(74, 137, 4, 242)          // mov [rdx+r14*8], rax
    em.b3(73, 255, 198)             // inc r14
    em.jlocal(⁻1, 2)
    em.set_label(3)                 // Ldone
    em.b4(76, 137, 115, 8)          // mov [rbx+8], r14
    em.b3(72, 137, 216)             // mov rax, rbx
    em.b1(195)
    em.resolve_locals()

    // RT_ENVG: rsi = the name's bytes, rdx = how many → rax = an
    // optional string: the box holding the value, or the null for a
    // name the environment does not carry.  The first entry that
    // matches answers, as getenv has it.
    em.rt_begin(emit.RT_ENVG)
    em.begin_fn(7)
    em.b3(72, 137, 243)             // mov rbx, rsi: the name outlives the calls
    em.b3(73, 137, 212)             // mov r12, rdx: and so does its length
    em.dref(emit.R_R11, args_off)
    em.b4(77, 139, 107, 16)         // mov r13, [r11+16]: envp
    em.b3(77, 49, 246)              // xor r14, r14
    em.set_label(0)                 // Lentry
    em.b4(79, 139, 124, 245)
    em.b1(0)                        // mov r15, [r13+r14*8]
    em.b3(77, 133, 255)             // test r15, r15
    em.jlocal(132, 4)               // je Lnone
    em.b3(72, 49, 201)              // xor rcx, rcx
    em.set_label(1)                 // Lcmp
    em.b3(76, 57, 225)              // cmp rcx, r12
    em.jlocal(131, 2)               // jae Lsep: the name matched throughout
    em.b4(65, 138, 4, 15)           // mov al, [r15+rcx]
    em.b3(58, 4, 11)                // cmp al, [rbx+rcx]
    em.jlocal(133, 3)               // jne Lnext
    em.b3(72, 255, 193)             // inc rcx
    em.jlocal(⁻1, 1)
    em.set_label(2)                 // Lsep: and '=' ends it there
    em.b4(67, 128, 60, 39)
    em.b1(61)                       // cmp byte [r15+r12], '='
    em.jlocal(133, 3)               // jne Lnext
    em.b4(79, 141, 124, 39)
    em.b1(1)                        // lea r15, [r15+r12+1]: the value
    em.b3(72, 49, 201)              // xor rcx, rcx
    em.set_label(5)                 // Lvlen
    em.b4(65, 128, 60, 15)
    em.b1(0)                        // cmp byte [r15+rcx], 0
    em.jlocal(132, 6)               // je Lvgot
    em.b3(72, 255, 193)             // inc rcx
    em.jlocal(⁻1, 5)
    em.set_label(6)                 // Lvgot
    em.b1(81)                       // push rcx
    em.movimm(emit.R_DI, 16)
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b1(89)                       // pop rcx
    em.b3(76, 137, 56)              // mov [rax], r15
    em.b4(72, 137, 72, 8)           // mov [rax+8], rcx
    em.b3(73, 137, 199)             // mov r15, rax: the descriptor
    em.movimm(emit.R_DI, 8)
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b3(76, 137, 56)              // mov [rax], r15: and the box holds it
    em.b1(195)
    em.set_label(3)                 // Lnext
    em.b3(73, 255, 198)             // inc r14
    em.jlocal(⁻1, 0)
    em.set_label(4)                 // Lnone
    em.b2(49, 192)                  // xor eax, eax
    em.b1(195)
    em.resolve_locals()

    // RT_AUXV: rdi = the key → rax = what the auxiliary vector carries
    // under it, or zero when it carries nothing.  The vector is pairs
    // of words, a key and its value, ending at a key of zero.
    em.rt_begin(emit.RT_AUXV)
    em.begin_fn(3)
    em.dref(emit.R_R11, args_off)
    em.b4(73, 139, 75, 24)          // mov rcx, [r11+24]: the vector
    em.set_label(0)                 // Lscan
    em.b3(72, 139, 17)              // mov rdx, [rcx]: the key
    em.b3(72, 133, 210)             // test rdx, rdx
    em.jlocal(132, 2)               // je Lnone: the vector ended
    em.b3(72, 57, 250)              // cmp rdx, rdi
    em.jlocal(132, 1)               // je Lgot
    em.b4(72, 131, 193, 16)         // add rcx, 16
    em.jlocal(⁻1, 0)
    em.set_label(1)                 // Lgot
    em.b4(72, 139, 65, 8)           // mov rax, [rcx+8]
    em.b1(195)
    em.set_label(2)                 // Lnone
    em.b2(49, 192)                  // xor eax, eax
    em.b1(195)
    em.resolve_locals()

    // RT_EXECFN: → rax = the path execve was given, as a string.  The
    // vector holds where the bytes are; they lie above the environment
    // on the entry stack, which outlives the move to the program's own.
    em.rt_begin(emit.RT_EXECFN)
    em.begin_fn(3)
    em.movimm(emit.R_DI, 31)
    em.jglobal(232, ⁻1, emit.RT_AUXV)
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(132, 2)               // je Lnone
    em.b3(73, 137, 199)             // mov r15, rax: the bytes
    em.b3(72, 49, 201)              // xor rcx, rcx
    em.set_label(0)                 // Llen
    em.b4(65, 128, 60, 15)
    em.b1(0)                        // cmp byte [r15+rcx], 0
    em.jlocal(132, 1)               // je Lgot
    em.b3(72, 255, 193)             // inc rcx
    em.jlocal(⁻1, 0)
    em.set_label(1)                 // Lgot
    em.b1(81)                       // push rcx
    em.movimm(emit.R_DI, 16)
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b1(89)                       // pop rcx
    em.b3(76, 137, 56)              // mov [rax], r15
    em.b4(72, 137, 72, 8)           // mov [rax+8], rcx
    em.b1(195)
    em.set_label(2)                 // Lnone: no name, and so no bytes
    em.movimm(emit.R_DI, 16)
    em.jglobal(232, ⁻1, emit.RT_ALLOC)
    em.b2(49, 210)                  // xor edx, edx
    em.b3(72, 137, 16)              // mov [rax], rdx
    em.b4(72, 137, 80, 8)           // mov [rax+8], rdx
    em.b1(195)
    em.resolve_locals()

    // RT_RELRO: seal what the program headers say is read-only once it
    // has been written.  The headers are where AT_PHDR points, as many
    // as AT_PHNUM of AT_PHENT bytes each, and each one whose type is
    // PT_GNU_RELRO names a stretch to protect.  The ends are rounded
    // inward to whole pages, as a dynamic loader rounds them, so a
    // header that names part of a page protects none of it.
    em.rt_begin(emit.RT_RELRO)
    em.begin_fn(3)
    em.movimm(emit.R_DI, 3)              // AT_PHDR
    em.jglobal(232, ⁻1, emit.RT_AUXV)
    em.b3(73, 137, 197)             // mov r13, rax: the headers
    em.movimm(emit.R_DI, 5)              // AT_PHNUM
    em.jglobal(232, ⁻1, emit.RT_AUXV)
    em.b3(73, 137, 196)             // mov r12, rax: how many
    em.movimm(emit.R_DI, 4)              // AT_PHENT
    em.jglobal(232, ⁻1, emit.RT_AUXV)
    em.b3(73, 137, 198)             // mov r14, rax: how long each is
    em.movimm(emit.R_DI, 6)              // AT_PAGESZ
    em.jglobal(232, ⁻1, emit.RT_AUXV)
    em.b3(73, 137, 199)             // mov r15, rax: the page
    em.b3(77, 133, 237)             // test r13, r13
    em.jlocal(132, 2)               // je Lret: no headers, nothing to seal
    em.set_label(0)                 // Lhdr
    em.b3(77, 133, 228)             // test r12, r12
    em.jlocal(132, 2)               // je Lret
    em.b4(65, 139, 69, 0)           // mov eax, [r13]: p_type
    em.b2(72, 61)
    em.w32(1685382482)              // cmp rax, PT_GNU_RELRO
    em.jlocal(133, 1)               // jne Lnext
    em.b4(73, 139, 117, 16)         // mov rsi, [r13+16]: p_vaddr
    em.b4(73, 139, 85, 40)          // mov rdx, [r13+40]: p_memsz
    em.b3(72, 1, 242)               // add rdx, rsi: one past the end
    // both ends inward to a page: rsi up, rdx down
    em.b3(76, 137, 249)             // mov rcx, r15
    em.b3(72, 255, 201)             // dec rcx
    em.b3(72, 1, 206)               // add rsi, rcx
    em.b3(72, 247, 209)             // not rcx
    em.b3(72, 33, 206)              // and rsi, rcx
    em.b3(72, 33, 202)              // and rdx, rcx
    em.b3(72, 41, 242)              // sub rdx, rsi: how much of it
    em.jlocal(142, 1)               // jle Lnext: no whole page inside
    em.b3(72, 137, 247)             // mov rdi, rsi
    em.b3(72, 137, 214)             // mov rsi, rdx
    em.movimm(emit.R_DX, 1)              // PROT_READ
    em.movimm(emit.R_AX, 10)
    em.b2(15, 5)                    // mprotect
    em.set_label(1)                 // Lnext
    em.b3(77, 1, 245)               // add r13, r14
    em.b3(73, 255, 204)             // dec r12
    em.jlocal(⁻1, 0)
    em.set_label(2)                 // Lret
    em.b1(195)
    em.resolve_locals()

    // RT_STRNEXT: rdi = descriptor, rsi = a byte position → rax = the
    // character there, rdx = the position the next one begins at.  The
    // same shift-DFA as RT_CHARS, run until it says a character is
    // whole -- which is what lets a walk over a string read it where it
    // lies instead of laying its characters out first.
    em.rt_begin(emit.RT_STRNEXT)
    em.begin_fn(1)
    em.b3(76, 139, 7)               // mov r8, [rdi]: the bytes
    em.b3(77, 49, 210)              // xor r10, r10: the state
    em.b3(77, 49, 201)              // xor r9, r9: the code point
    em.rxref(emit.R_R11, 0)              // the byte classes
    em.rxref(emit.R_DI, 256)             // the transition words
    em.set_label(0)                 // Lstep
    em.b4(65, 15, 182, 4)
    em.b1(48)                       // movzx eax, byte [r8+rsi]
    em.b3(72, 255, 198)             // inc rsi
    em.b4(69, 15, 182, 60)
    em.b1(3)                        // movzx r15d, byte [r11+rax]: the class
    em.b3(72, 199, 194)
    em.w32(255)                     // mov rdx, 255
    em.b3(76, 137, 249)             // mov rcx, r15
    em.b3(72, 211, 234)             // shr rdx, cl
    em.b3(72, 199, 193)
    em.w32(63)                      // mov rcx, 63
    em.b3(77, 133, 210)             // test r10, r10
    em.b4(72, 15, 69, 209)          // cmovnz rdx, rcx
    em.b3(72, 33, 208)              // and rax, rdx
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.b3(77, 133, 210)             // test r10, r10
    em.b4(76, 15, 68, 202)          // cmovz r9, rdx
    em.b3(72, 49, 201)              // xor rcx, rcx
    em.b3(72, 199, 194)
    em.w32(6)                       // mov rdx, 6
    em.b3(77, 133, 210)             // test r10, r10
    em.b4(72, 15, 69, 202)          // cmovnz rcx, rdx
    em.b3(73, 211, 225)             // shl r9, cl
    em.b3(73, 9, 193)               // or r9, rax
    em.b4(74, 139, 4, 255)          // mov rax, [rdi+r15*8]
    em.b3(76, 137, 209)             // mov rcx, r10
    em.b3(72, 211, 232)             // shr rax, cl
    em.b4(72, 131, 224, 63)         // and rax, 63
    em.b3(73, 137, 194)             // mov r10, rax
    em.b3(77, 133, 210)             // test r10, r10
    em.jlocal(133, 0)               // jnz Lstep
    em.b3(76, 137, 200)             // mov rax, r9
    em.b3(72, 137, 242)             // mov rdx, rsi
    em.b1(195)
    em.resolve_locals()

    // The hash routines are the ones not written twice.  They are
    // arithmetic and nothing else -- no kernel, no calling convention
    // of their own -- so there is nothing here a hand-written version
    // would know that the IR does not, and rt_hash.ngpl and
    // rt_sha256.ngpl write them once for all six.
    em.rt_begin(emit.RT_HSTART)
    arch_x86_64.emit_fn(&em, rt_hash.rt_hstart_ir(), 1, lw.strs, 0, [])
    em.rt_begin(emit.RT_HUPDATE)
    arch_x86_64.emit_fn(&em, rt_hash.rt_hupdate_ir(&lw), 2, lw.strs, 0, [])
    em.rt_begin(emit.RT_HFINAL)
    arch_x86_64.emit_fn(&em, rt_hash.rt_hfinal_ir(&lw), 2, lw.strs, 0, [])
    em.rt_begin(emit.RT_SHA256INIT)
    arch_x86_64.emit_fn(&em, rt_sha256.rt_sha256init_ir(), 1, lw.strs, 0, [])
    em.rt_begin(emit.RT_SHA256BLK)
    arch_x86_64.emit_fn(&em, rt_sha256.rt_sha256blk_ir(), 1, lw.strs, 0, [])
    em.rt_begin(emit.RT_SHA256FIN)
    arch_x86_64.emit_fn(&em, rt_sha256.rt_sha256fin_ir(), 2, lw.strs, 0, [])

    // int's arithmetic is arithmetic and nothing else, so it is
    // written once in rt_bigint.ngpl and emitted here as it is
    // everywhere else.
    em.rt_begin(emit.RT_BIGFROM)
    arch_x86_64.emit_fn(&em, rt_bigint.rt_bigfrom_ir(), 1, lw.strs, 0, [])
    em.rt_begin(emit.RT_BIGCMP)
    arch_x86_64.emit_fn(&em, rt_bigint.rt_bigcmp_ir(), 2, lw.strs, 0, [])
    em.rt_begin(emit.RT_BIGADD)
    arch_x86_64.emit_fn(&em, rt_bigint.rt_bigadd_ir(), 3, lw.strs, 0, [])
    em.rt_begin(emit.RT_BIGMUL)
    arch_x86_64.emit_fn(&em, rt_bigint.rt_bigmul_ir(), 2, lw.strs, 0, [])
    em.rt_begin(emit.RT_BIGPRINT)
    arch_x86_64.emit_fn(&em, rt_bigint.rt_bigprint_ir(), 1, lw.strs, 0, [])

    // The backtrace is a walk over frames and a search of a table, and
    // neither is anything a hand-written version would do differently,
    // so rt_backtrace.ngpl writes it once for all six as well.
    em.rt_begin(emit.RT_BT)
    arch_x86_64.emit_fn(&em, rt_backtrace.rt_bt_ir(tg, &lw), 0, lw.strs, 0, [])

    // Cutting a string is a walk over its characters and a descriptor,
    // and neither is anything a hand-written version would do
    // differently, so this is written once as IR as well.
    em.rt_begin(emit.RT_SSLICE)
    arch_x86_64.emit_fn(&em, rt_portable.rt_build(emit.RT_SSLICE, tg, &lw), 3, lw.strs, 0, [])

    // Asking whether a name is a file is a statx and a look at two bits
    // of what it answered, which is the same on every machine, so this
    // is written once as IR too.
    em.rt_begin(emit.RT_FTHERE)
    arch_x86_64.emit_fn(&em, rt_portable.rt_build(emit.RT_FTHERE, tg, &lw), 1, lw.strs, 0, [])

    // ------------------------------------------------------------------
    // The stack running out
    // ------------------------------------------------------------------
    //
    // RT_SEGV(signum, siginfo, ucontext), entered by the kernel on its
    // own stack.  What makes it worth having is one comparison: the
    // faulting address against the guard's bounds.  Inside them, the
    // program walked off the bottom of its stack, and it says so in
    // its own voice and stops the way every other runtime stop does.
    // Outside them it is an ordinary fault in a program that had a
    // bug, and the best thing to do is get out of the way -- put the
    // default action back and return, and the faulting instruction
    // runs again and dies of it, core dump and all.
    em.rt_begin(emit.RT_SEGV)
    em.b4(72, 139, 70, 16)          // mov rax, [rsi+16]: si_addr
    em.dref(emit.R_R11, args_off)
    em.b4(73, 139, 75, emit.KB_GLO)      // mov rcx, [r11+KB_GLO]
    em.b3(72, 57, 200)              // cmp rax, rcx
    em.jlocal(130, 0)               // jb: below the guard
    em.b4(73, 139, 75, emit.KB_GHI)      // mov rcx, [r11+KB_GHI]
    em.b3(72, 57, 200)              // cmp rax, rcx
    em.jlocal(131, 0)               // jae: above it, so in the stack proper
    let ovm2 : i64 = lw.intern(emit.stack_overflow_msg())
    em.sref(emit.R_SI, ovm2)
    em.movimm(emit.R_DX, emit.str_len(lw.strs[ovm2 × 1¤ptrdiff]))
    em.movimm(emit.R_DI, 2)
    em.movimm(emit.R_AX, 1)
    em.b2(15, 5)                    // write(2, msg, len)
    em.movimm(emit.R_DI, emit.EXIT_STACK_OVERFLOW)
    em.movimm(emit.R_AX, 60)
    em.b2(15, 5)                    // exit, with this stop's own number
    em.set_label(0)
    // not the guard: the default action, put back, and let it happen
    em.dref(emit.R_R11, relro_off)
    em.b3(72, 49, 192)              // xor rax, rax
    em.b4(73, 137, 67, emit.SIG_ACT)     // sa_handler ← SIG_DFL
    em.b4(73, 137, 67, emit.SIG_ACT + 8) // sa_flags ← 0
    em.movimm(emit.R_DI, emit.SIGSEGV_NO)
    em.b3(73, 141, 115)
    em.b1(emit.SIG_ACT)                  // lea rsi, [r11+SIG_ACT]
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.movimm(emit.R_R10, 8)
    em.movimm(emit.R_AX, 13)             // rt_sigaction
    em.b2(15, 5)
    em.b1(195)                      // ret: through the restorer, and again
    em.resolve_locals()

    // The trampoline the kernel returns through.  x86-64 will not
    // install a handler without one, and returning from the handler
    // above is how an ordinary fault gets to happen twice.
    em.rt_begin(emit.RT_SIGRET)
    em.movimm(emit.R_AX, 15)             // rt_sigreturn
    em.b2(15, 5)
