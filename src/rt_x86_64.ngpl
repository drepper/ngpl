    em.b4(72, 137, 87, 8)           // mov [rdi+8], rdx
    em.b4(72, 137, 79, 24)          // mov [rdi+24], rcx
    em.b2(49, 201)                  // xor ecx, ecx
    em.b4(72, 137, 76, 36)
    em.b1(32)                       // mov [rsp+32], rcx: the index
    em.set_label(0)                 // Lloop
    em.b4(72, 139, 76, 36)
    em.b1(32)                       // mov rcx, [rsp+32]
    em.b4(72, 59, 76, 36)
    em.b1(24)                       // cmp rcx, [rsp+24]
