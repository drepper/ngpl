    em.b4(73, 141, 73, 255)         // lea rcx, [r9-1]
    em.b3(73, 33, 201)              // and r9, rcx
    em.jlocal(⁻1, 4)
    em.set_label(6)                 // Lfound
    em.b3(76, 137, 208)             // mov rax, r10
    em.movimm(emit.R_DX, 1)
    em.b1(195)
    em.set_label(8)                 // Lroom: has this group an empty slot?
    em.b3(72, 139, 11)              // mov rcx, [rbx]
    em.b4(243, 66, 15, 111)
    em.b2(28, 57)                   // movdqu xmm3, [rcx+r15]
    em.b4(102, 15, 239, 210)        // pxor xmm2, xmm2
    em.b4(102, 15, 116, 218)        // pcmpeqb xmm3, xmm2
    em.b4(102, 15, 215, 195)        // pmovmskb eax, xmm3
