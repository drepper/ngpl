let elf := @import("elf")
let emit := @import("emit")
let lower := @import("lower")
let machine := @import("machine")

// ---------------------------------------------------------------------------
// aarch64: the A64 instruction layer
//
// Register plan: RA=x9, RB=x10, RC=x11, x12/x13 scratch, arguments in
// x0..x7, the result in x0, x8 the syscall number, x29/x30 frame and
// link.  A frame is [outgoing args: 4 slots][vreg slots]; sp stays put
// between prologue and epilogue, so a slot is [sp, #32 + 8×slot] and
// an incoming stack argument [x29, #16 + 8×(k−8)].
// ---------------------------------------------------------------------------

@export
let A64_RA : i64 = 9
@export
let A64_RB : i64 = 10
@export
let A64_RC : i64 = 11
@export
let A64_T0 : i64 = 12
@export
let A64_T1 : i64 = 13

fn a64_r(r : i64) → i64:
    if r = machine.RG_A: A64_RA else: (if r = machine.RG_B: A64_RB else: A64_RC)

@export
fn a64_movimm(em : &mut emit.Emit, rd : i64, v : i64):
    if v >= 0 and v < 65536:
        em.aw(3531603968 + ((v & 65535) « 5) + rd)          // movz
        return
    // ~v computed with @wrap: the most negative value may pass through
    if v < 0 and @wrap(0 - v - 1) < 65536 and @wrap(0 - v - 1) >= 0:
        em.aw(2457862144 + ((@wrap(0 - v - 1) & 65535) « 5) + rd)  // movn
        return
    em.aw(3531603968 + ((v & 65535) « 5) + rd)              // movz lo
    em.aw(4070572032 + (((v » 16) & 65535) « 5) + rd)       // movk lsl16
    em.aw(4072669184 + (((v » 32) & 65535) « 5) + rd)       // movk lsl32
    em.aw(4074766336 + (((v » 48) & 65535) « 5) + rd)       // movk lsl48

// a 64-bit slot in the frame: [sp, #32 + 8×slot]
fn a64_ldslot(em : &mut emit.Emit, rd : i64, slot : i64):
    let off : i64 = 4 + slot
    assert(off >= 0 and off < 4096, "the frame offset fits the scaled field")
    em.aw(4181721088 + (off « 10) + (31 « 5) + rd)          // ldr rd, [sp, #off×8]

fn a64_stslot(em : &mut emit.Emit, rs : i64, slot : i64):
    let off : i64 = 4 + slot
    assert(off >= 0 and off < 4096, "the frame offset fits the scaled field")
    em.aw(4177526784 + (off « 10) + (31 « 5) + rs)          // str rs, [sp, #off×8]

// register-to-register forms, each one verified word
@export
fn a64_addr_(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2332033024 + (rm « 16) + (rn « 5) + rd)           // add
fn a64_subr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(3405774848 + (rm « 16) + (rn « 5) + rd)           // sub
// adds and subs, at a word or at a half of one.  The 32-bit encoding
// is the 64-bit one with the size bit cleared, and it sets the same
// flags about the narrower result -- which is the whole reason to ask
// at that width.
fn a64_addsr_w(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64, bits : i64):
    em.aw((if bits = 32: 721420288 else: 2868903936) + (rm « 16) + (rn « 5) + rd)
fn a64_subsr_w(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64, bits : i64):
    em.aw((if bits = 32: 1795162112 else: 3942645760) + (rm « 16) + (rn « 5) + rd)
fn a64_addsr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    a64_addsr_w(&em, rd, rn, rm, 64)
fn a64_subsr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    a64_subsr_w(&em, rd, rn, rm, 64)
fn a64_mulr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2600500224 + (rm « 16) + (rn « 5) + rd)           // mul (madd xzr)
fn a64_smulh(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2604694528 + (rm « 16) + (rn « 5) + rd)
fn a64_umulh(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2613083136 + (rm « 16) + (rn « 5) + rd)
fn a64_sdiv(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    a64_sdivw(&em, rd, rn, rm, 1)

@pre(sf = 0 or sf = 1)
fn a64_sdivw(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64, sf : i64):
    em.aw(448793600 + sf × 2147483648 + (rm « 16) + (rn « 5) + rd)
fn a64_udiv(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    a64_udivw(&em, rd, rn, rm, 1)

@pre(sf = 0 or sf = 1)
fn a64_udivw(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64, sf : i64):
    em.aw(448792576 + sf × 2147483648 + (rm « 16) + (rn « 5) + rd)
fn a64_msub(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64, ra : i64):
    em.aw(2600501248 + (rm « 16) + (ra « 10) + (rn « 5) + rd)
fn a64_andr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2315255808 + (rm « 16) + (rn « 5) + rd)
fn a64_orrr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2852126720 + (rm « 16) + (rn « 5) + rd)
fn a64_eorr(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(3388997632 + (rm « 16) + (rn « 5) + rd)
fn a64_mvn(em : &mut emit.Emit, rd : i64, rm : i64):
    em.aw(2854224864 + (rm « 16) + rd)
fn a64_negr(em : &mut emit.Emit, rd : i64, rm : i64):
    em.aw(3405775840 + (rm « 16) + rd)
fn a64_lslv(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596282368 + (rm « 16) + (rn « 5) + rd)
fn a64_lsrv(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596283392 + (rm « 16) + (rn « 5) + rd)
fn a64_asrv(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596284416 + (rm « 16) + (rn « 5) + rd)
@export
fn a64_cmpr(em : &mut emit.Emit, rn : i64, rm : i64):
    a64_cmprw(&em, rn, rm, 1)

// The same compare made at either width, sf being the bit that says
// which: set for the whole register, clear for its lower half.  A
// value only as wide as its type is compared there, and then what
// stands above it is not asked about.
@pre(sf = 0 or sf = 1)
fn a64_cmprw(em : &mut emit.Emit, rn : i64, rm : i64, sf : i64):
    em.aw(1795162143 + sf × 2147483648 + (rm « 16) + (rn « 5))
@export
fn a64_movr(em : &mut emit.Emit, rd : i64, rm : i64):
    em.aw(2852127712 + (rm « 16) + rd)                      // orr rd, xzr, rm
@export
fn a64_addi(em : &mut emit.Emit, rd : i64, rn : i64, imm : i64):
    assert(imm >= 0 and imm < 4096, "the immediate fits add's field")
    em.aw(2432696320 + (imm « 10) + (rn « 5) + rd)
fn a64_subi(em : &mut emit.Emit, rd : i64, rn : i64, imm : i64):
    assert(imm >= 0 and imm < 4096, "the immediate fits sub's field")
    em.aw(3506438144 + (imm « 10) + (rn « 5) + rd)

// A64 condition codes
let A64_EQ : i64 = 0
let A64_NE : i64 = 1
let A64_CS : i64 = 2
let A64_CC : i64 = 3
@export
let A64_MI : i64 = 4
let A64_VS : i64 = 6
let A64_HI : i64 = 8
let A64_LS : i64 = 9
let A64_GE : i64 = 10
let A64_LT : i64 = 11
let A64_GT : i64 = 12
let A64_LE : i64 = 13

// cset rd, cond: the cond is stored inverted, as csinc has it
fn a64_cset(em : &mut emit.Emit, rd : i64, cond : i64):
    em.aw(2594113504 + ((cond ^ 1) « 12) + rd)
fn a64_csel(em : &mut emit.Emit, rd : i64, rn : i64, rm : i64, cond : i64):
    em.aw(2592079872 + (rm « 16) + (cond « 12) + (rn « 5) + rd)

// loads and stores through a base register, offset zero
@export
fn a64_ldw(em : &mut emit.Emit, rd : i64, base : i64, width : i64, sgn : i64):
    if width = 8:
        em.aw(4181721088 + (base « 5) + rd)                 // ldr x
    elif width = 4:
        em.aw(3107979264 + (base « 5) + rd)                 // ldr w
        if sgn = 1:
            em.aw(2470476800 + (rd « 5) + rd)               // sxtw
    elif width = 2:
        em.aw(2034237440 + (base « 5) + rd)                 // ldrh
        if sgn = 1:
            em.aw(2470460416 + (rd « 5) + rd)               // sxth
    else:
        em.aw(960495616 + (base « 5) + rd)                  // ldrb
        if sgn = 1:
            em.aw(2470452224 + (rd « 5) + rd)               // sxtb
fn a64_stw(em : &mut emit.Emit, rs : i64, base : i64, width : i64):
    if width = 8:
        em.aw(4177526784 + (base « 5) + rs)                 // str x
    elif width = 4:
        em.aw(3103784960 + (base « 5) + rs)                 // str w
    elif width = 2:
        em.aw(2030043136 + (base « 5) + rs)                 // strh
    else:
        em.aw(956301312 + (base « 5) + rs)                  // strb

// scaled 64-bit load and store at a small positive byte offset
@export
fn a64_ldo(em : &mut emit.Emit, rd : i64, base : i64, off : i64):
    assert(off >= 0 and (off % 8 ?? 1) = 0 and off < 32768, "a scaled offset")
    em.aw(4181721088 + ((off ÷ 8 ?? 0) « 10) + (base « 5) + rd)
@export
fn a64_sto(em : &mut emit.Emit, rs : i64, base : i64, off : i64):
    assert(off >= 0 and (off % 8 ?? 1) = 0 and off < 32768, "a scaled offset")
    em.aw(4177526784 + ((off ÷ 8 ?? 0) « 10) + (base « 5) + rs)

fn a64_sxt(em : &mut emit.Emit, rd : i64, bits : i64):
    if bits = 8:
        em.aw(2470452224 + (rd « 5) + rd)                   // sxtb
    elif bits = 16:
        em.aw(2470460416 + (rd « 5) + rd)                   // sxth
    else:
        em.aw(2470476800 + (rd « 5) + rd)                   // sxtw
fn a64_uxt(em : &mut emit.Emit, rd : i64, bits : i64):
    if bits = 8:
        em.aw(1392516096 + (rd « 5) + rd)                   // uxtb
    elif bits = 16:
        em.aw(1392524288 + (rd « 5) + rd)                   // uxth
    else:
        em.aw(704644064 + (rd « 16) + rd)                   // mov w,w

// an absolute address, materialized as movz+movk and patched later;
// answers the position the patcher writes into
@export
fn a64_absref(em : &mut emit.Emit, rd : i64) → i64:
    let pos : i64 = em.here()
    em.aw(3531603968 + rd)                                  // movz rd, #0
    em.aw(4070572032 + rd)                                  // movk rd, #0, lsl 16
    pos

fn a64_patch_abs(em : &mut emit.Emit, pos : i64, v : i64):
    // the register the materialization was aimed at, read back from
    // its own first byte
    let rd : i64 = @dropunit(em.code[pos × 1¤byte]) & 31
    em.patch32(pos, 3531603968 + ((v & 65535) « 5) + rd)
    em.patch32(pos + 4, 4070572032 + (((v » 16) & 65535) « 5) + rd)

// local branches: the resolver reads the form
let A64F_B26 : i64 = 26
let A64F_B19 : i64 = 19

@export
fn a64_jmp(em : &mut emit.Emit, lab : i64):
    em.a64_bfix(335544320, lab, A64F_B26)                   // b
@export
fn a64_bcond(em : &mut emit.Emit, cond : i64, lab : i64):
    em.a64_bfix(1409286144 + cond, lab, A64F_B19)           // b.cond
fn a64_cbz(em : &mut emit.Emit, r : i64, lab : i64):
    em.a64_bfix(3019898880 + r, lab, A64F_B19)
@export
fn a64_cbnz(em : &mut emit.Emit, r : i64, lab : i64):
    em.a64_bfix(3036676096 + r, lab, A64F_B19)

// a call against a function or runtime id: one bl, patched at the end
@export
fn a64_call(em : &mut emit.Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here())
    em.cf_target.push(target)
    em.aw(2483027968)                                       // bl 0

fn a64_blr(em : &mut emit.Emit, r : i64):
    em.aw(3594452992 + (r « 5))
fn a64_br(em : &mut emit.Emit, r : i64):
    em.aw(3592355840 + (r « 5))
fn a64_ret(em : &mut emit.Emit):
    em.aw(3596551104)
@export
fn a64_svc(em : &mut emit.Emit):
    em.aw(3556769793)

// after the labels of a function settle, its local branches do
@export
fn a64_resolve(em : &mut emit.Emit):
    foreach i := 0…#em.tf_pos:
        let pos : i64 = em.tf_pos[i]
        let delta : i64 = em.labels[em.tf_lab[i] × 1¤ptrdiff] - pos
        let word : i64 = machine.code_word(em, pos)
        if em.tf_form[i] = A64F_B26:
            em.patch32(pos, word + (((delta » 2) & 67108863)))
        else:
            em.patch32(pos, word + (((delta » 2) & 524287) « 5))
    em.tf_pos ← []
    em.tf_lab ← []
    em.tf_form ← []

// ---------------------------------------------------------------------------
// The abstract operations, dispatched on the target.  Every function
// here is one small spelling decision; the thinking lives in the
// driver below, written once.
// ---------------------------------------------------------------------------
fn a64_ar(r : i64) → i64:
    if r = machine.RG_A: return A64_RA
    if r = machine.RG_B: return A64_RB
    if r = machine.RG_C: return A64_RC
    A64_T0

@export
fn a64g_lds(em : &mut emit.Emit, tg : &elf.Target, r : i64, slot : i64):
    a64_ldslot(&em, a64_ar(r), slot)

@export
fn a64g_sts(em : &mut emit.Emit, tg : &elf.Target, r : i64, slot : i64):
    a64_stslot(&em, a64_ar(r), slot)

@export
fn a64g_const(em : &mut emit.Emit, tg : &elf.Target, r : i64, v : i64):
    a64_movimm(&em, a64_ar(r), v)

@export
fn a64g_mov2(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64):
    a64_movr(&em, a64_ar(rd), a64_ar(rs))

@export
fn a64g_add3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_addr_(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_sub3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_subr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_mul3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_mulr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_and3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_andr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_or3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_orrr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_xor3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_eorr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_not2(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64):
    a64_mvn(&em, a64_ar(rd), a64_ar(rs))

@export
fn a64g_neg2(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64):
    a64_negr(&em, a64_ar(rd), a64_ar(rs))

@export
fn a64g_shl3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_lslv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_shr3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_lsrv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

@export
fn a64g_sar3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    a64_asrv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

// rd ← rs « imm, the shift written into the instruction
@export
fn a64g_shl3i(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64, imm : i64):
    // ubfm rd, rs, #(64-imm), #(63-imm)
    em.aw(3544186880 + (((64 - imm) & 63) « 16) + ((63 - imm) « 10) + (a64_ar(rs) « 5) + a64_ar(rd))

// the A64 spelling of a comparison's answer
fn a64_cc(cond : i64, sgn : i64) → i64:
    if cond = machine.CC_EQ: return A64_EQ
    if cond = machine.CC_NE: return A64_NE
    if sgn = 1:
        if cond = machine.CC_LT: return A64_LT
        if cond = machine.CC_LE: return A64_LE
        if cond = machine.CC_GT: return A64_GT
        return A64_GE
    if cond = machine.CC_LT: return A64_CC
    if cond = machine.CC_LE: return A64_LS
    if cond = machine.CC_GT: return A64_HI
    A64_CS

// rd ← rx rel ry, materialized as 0 or 1
// This machine compares at either width, so a thirty-two bit value is
// compared as one and what stands above it is never asked about.  The
// narrower widths have no compare of their own and are compared whole,
// which is why they are not among the widths the driver calls free.
@export
fn a64g_cmp3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64, bits : i64):
    a64_cmprw(&em, a64_ar(rx), a64_ar(ry), if bits = 32: 0 else: 1)
    a64_cset(&em, a64_ar(rd), a64_cc(cond, sgn))

// rd ← rc ≠ 0 ? rx : ry
@export
fn a64g_sel4(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rc : i64, rx : i64, ry : i64):
    em.aw(4043309087 + (a64_ar(rc) « 5))     // cmp rc, #0
    a64_csel(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), A64_NE)

@export
fn a64g_div3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    let sf : i64 = if bits = 32: 0 else: 1
    if sgn = 1:
        a64_sdivw(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), sf)
    else:
        a64_udivw(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), sf)

// The quotient is taken at the width; the multiply and the subtract
// that turn it into a remainder are right in their lower bits whatever
// stands above them, so they are left whole.
@export
fn a64g_mod3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    let sf : i64 = if bits = 32: 0 else: 1
    if sgn = 1:
        a64_sdivw(&em, A64_T1, a64_ar(rx), a64_ar(ry), sf)
    else:
        a64_udivw(&em, A64_T1, a64_ar(rx), a64_ar(ry), sf)
    a64_msub(&em, a64_ar(rd), A64_T1, a64_ar(ry), a64_ar(rx))

// rd ← rx op ry with rf saying whether the 64-bit result overflowed
// VC where a signed one did not overflow; for an unsigned add a clear
// carry says so, and for an unsigned subtract a set one does.
@export
fn a64g_addchk(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    a64_addsr_w(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), bits)
    a64_bcond(&em, if sgn = 1: 7 else: A64_CC, lab)

@export
fn a64g_subchk(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    a64_subsr_w(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), bits)
    a64_bcond(&em, if sgn = 1: 7 else: A64_CS, lab)

@export
fn a64g_addov(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    a64_addsr_w(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), bits)
    a64_cset(&em, a64_ar(rf), if sgn = 1: A64_VS else: A64_CS)

@export
fn a64g_subov(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    a64_subsr_w(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), bits)
    // on ARM a clear carry is the borrow
    a64_cset(&em, a64_ar(rf), if sgn = 1: A64_VS else: A64_CC)

@export
fn a64g_mulov(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    if sgn = 1:
        a64_mulr(&em, A64_T1, a64_ar(rx), a64_ar(ry))
        a64_smulh(&em, A64_T0, a64_ar(rx), a64_ar(ry))
        // the high half of an unoverflowed product is the low half's sign
        em.aw(2470445056 + (63 « 16) + (63 « 10) + (A64_T1 « 5) + a64_ar(rf))   // asr rf, t1, #63
        a64_cmpr(&em, A64_T0, a64_ar(rf))
        a64_cset(&em, a64_ar(rf), A64_NE)
        a64_movr(&em, a64_ar(rd), A64_T1)
    else:
        a64_mulr(&em, A64_T1, a64_ar(rx), a64_ar(ry))
        a64_umulh(&em, A64_T0, a64_ar(rx), a64_ar(ry))
        em.aw(4043309087 + (A64_T0 « 5))                            // cmp t0, #0
        a64_cset(&em, a64_ar(rf), A64_NE)
        a64_movr(&em, a64_ar(rd), A64_T1)

// r ← r as its width says, sign or zero carried through
@export
fn a64g_ext2(em : &mut emit.Emit, tg : &elf.Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    if sgn = 1:
        a64_sxt(&em, a64_ar(r), bits)
    else:
        a64_uxt(&em, a64_ar(r), bits)

// rd ← mem[rbase + off]; width 0 is the target's pointer, zero-extended
@export
fn a64g_ldo(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    if off = 0:
        a64_ldw(&em, a64_ar(rd), a64_ar(rbase), wd, sgn)
    elif wd = 8 and (off % 8 ?? 1) = 0 and off > 0:
        a64_ldo(&em, a64_ar(rd), a64_ar(rbase), off)
    else:
        a64_movimm(&em, A64_T1, off)
        a64_addr_(&em, A64_T1, a64_ar(rbase), A64_T1)
        a64_ldw(&em, a64_ar(rd), A64_T1, wd, sgn)

@export
fn a64g_sto(em : &mut emit.Emit, tg : &elf.Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    if off = 0:
        a64_stw(&em, a64_ar(rs), a64_ar(rbase), wd)
    elif wd = 8 and (off % 8 ?? 1) = 0 and off > 0:
        a64_sto(&em, a64_ar(rs), a64_ar(rbase), off)
    else:
        a64_movimm(&em, A64_T1, off)
        a64_addr_(&em, A64_T1, a64_ar(rbase), A64_T1)
        a64_stw(&em, a64_ar(rs), A64_T1, wd)

@export
fn a64g_jmp(em : &mut emit.Emit, tg : &elf.Target, lab : i64):
    a64_jmp(&em, lab)

@export
fn a64g_jz(em : &mut emit.Emit, tg : &elf.Target, r : i64, lab : i64):
    a64_cbz(&em, a64_ar(r), lab)

@export
fn a64g_jnz(em : &mut emit.Emit, tg : &elf.Target, r : i64, lab : i64):
    a64_cbnz(&em, a64_ar(r), lab)

@export
fn a64g_label(em : &mut emit.Emit, tg : &elf.Target, lab : i64):
    em.set_label(lab)

@export
fn a64g_call(em : &mut emit.Emit, tg : &elf.Target, target : i64):
    a64_call(&em, target)

@export
fn a64g_calli(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    a64_blr(&em, a64_ar(r))

@export
fn a64g_ijmp(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    a64_br(&em, a64_ar(r))

// arguments travel in x0…x7; the ninth onward in the outgoing slots
// Only i386 spends the private convention's headroom so far, so
// this puts the argument where the architecture's own convention
// says and the two agree.
@export
fn a64g_argreg(em : &mut emit.Emit, tg : &elf.Target, k : i64, slot : i64):
    a64g_argld(&em, &tg, k, slot)

@export
fn a64g_argld(em : &mut emit.Emit, tg : &elf.Target, k : i64, slot : i64):
    if k < 8:
        a64_ldslot(&em, k, slot)
    else:
        a64_ldslot(&em, A64_T1, slot)
        a64_sto(&em, A64_T1, 31, 8 × (k - 8))

@export
fn a64g_argconst(em : &mut emit.Emit, tg : &elf.Target, k : i64, v : i64):
    assert(k < 8, "a constant argument rides a register")
    a64_movimm(&em, k, v)

@export
fn a64g_argmov(em : &mut emit.Emit, tg : &elf.Target, k : i64, r : i64):
    assert(k < 8, "a moved argument rides a register")
    a64_movr(&em, k, a64_ar(r))

// the returned value's two directions
@export
fn a64g_retst(em : &mut emit.Emit, tg : &elf.Target, slot : i64):
    a64_stslot(&em, 0, slot)

@export
fn a64g_retld(em : &mut emit.Emit, tg : &elf.Target, slot : i64):
    a64_ldslot(&em, 0, slot)

@export
fn a64g_retmov(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    a64_movr(&em, 0, a64_ar(r))

// an absolute address, materialized into an abstract register or an
// argument register; the caller records the answered position in the
// fixup list the address belongs to
// x29 is the frame pointer the prologue set, and it is a register
// like any other to read
@export
fn a64g_fptr(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    a64_movr(&em, a64_ar(r), 29)

@export
fn a64g_absref(em : &mut emit.Emit, tg : &elf.Target, r : i64) → i64:
    a64_absref(&em, a64_ar(r))

@export
fn a64g_absref_arg(em : &mut emit.Emit, tg : &elf.Target, k : i64) → i64:
    assert(k < 8, "an address argument rides a register")
    a64_absref(&em, k)

// the kernel: arguments from slots, the number, the trap
@export
fn a64g_sysarg(em : &mut emit.Emit, tg : &elf.Target, k : i64, slot : i64):
    a64_ldslot(&em, k, slot)

@export
fn a64g_sysimm(em : &mut emit.Emit, tg : &elf.Target, k : i64, v : i64):
    a64_movimm(&em, k, v)

@export
fn a64g_sysmov(em : &mut emit.Emit, tg : &elf.Target, k : i64, r : i64):
    a64_movr(&em, k, a64_ar(r))

@export
fn a64g_syscall(em : &mut emit.Emit, tg : &elf.Target, scid : i64):
    a64_movimm(&em, 8, machine.sc_at(&tg, scid))
    a64_svc(&em)

@export
fn a64g_sysret(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    a64_movr(&em, a64_ar(r), 0)

// the frame: save the caller's, claim the slots and the outgoing
// argument room, spill the incoming arguments to their slots
// The address of the frame's object region, plus off.  The region
// takes the slots just past the vregs, so the slot formula gives it:
// slot s sits at sp + 8×(4+s), and the region begins at slot nvregs.
@export
@pre(off >= 0)
fn a64g_frameaddr(em : &mut emit.Emit, tg : &elf.Target, nvregs : i64, nobj : i64, off : i64, r : i64):
    _ ← nobj
    let at : i64 = 32 + 8 × nvregs + off
    assert(at >= 0 and at < 4096, "the frame offset fits the immediate")
    em.aw(2432696320 + (at « 10) + (31 « 5) + a64_ar(r))   // add xr, sp, #at

@export
fn a64g_prologue(em : &mut emit.Emit, tg : &elf.Target, nvregs : i64, np : i64, nreg : i64):
    let frame : i64 = elf.align_up(32 + 8 × nvregs, 16)
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.aw(2847898621)                            // stp x29, x30, [sp, #-16]!
    em.aw(2432697341)                            // mov x29, sp
    if frame < 4096:
        em.aw(3506438144 + (frame « 10) + (31 « 5) + 31)     // sub sp, sp, #frame
    else:
        a64_movimm(&em, A64_T1, frame)
        em.aw(3405774848 + (A64_T1 « 16) + (31 « 5) + 31)    // sub sp, sp, t1
    foreach j := 0…np:
        if j < 8:
            a64_stslot(&em, j, j)
        else:
            // an incoming stack argument sits above the saved pair
            a64_ldo(&em, A64_T1, 29, 16 + 8 × (j - 8))
            a64_stslot(&em, A64_T1, j)

@export
fn a64g_epilogue(em : &mut emit.Emit, tg : &elf.Target):
    em.aw(2432697279)                            // mov sp, x29: drop the frame
    em.aw(2831252477)                            // ldp x29, x30, [sp], #16
    a64_ret(&em)

@export
fn a64g_resolve(em : &mut emit.Emit, tg : &elf.Target):
    a64_resolve(&em)

@export
fn a64g_patch_abs(em : &mut emit.Emit, tg : &elf.Target, pos : i64, v : i64):
    a64_patch_abs(&em, pos, v)

@export
fn a64g_patch_call(em : &mut emit.Emit, tg : &elf.Target, pos : i64, dest : i64):
    let word : i64 = machine.code_word(em, pos)
    em.patch32(pos, word + (((dest - pos) » 2) & 67108863))

// the door of the program: keep what the kernel handed over, stand up
// the guarded stack, run the phases, and leave through exit
// aarch64's own startup.  It was written inline as the one the
// dispatch below fell through to, which made it the machine a
// seventh would have been given; a match wants every arm to name
// something, so it names this.
@export
fn a64_startup(em : &mut emit.Emit, lw : &mut lower.Lower, tg : &elf.Target, args_off : i64,
               stack_size : i64, guard_size : i64, ginit : i64,
               tdriver : i64, start_fn : i64, sret : bool):
    em.begin_fn(4)
    // the kernel block: argc, argv, envp, auxv as four 8-byte cells
    let pos : i64 = a64_absref(&em, A64_RB)
    em.df_pos.push(pos)
    em.df_off.push(args_off)
    a64_ldo(&em, A64_RA, 31, 0)                  // argc
    a64_sto(&em, A64_RA, A64_RB, 0)
    a64_addi(&em, A64_RC, 31, 8)                 // argv
    a64_sto(&em, A64_RC, A64_RB, 8)
    em.aw(3544186880 + (61 « 16) + (60 « 10) + (A64_RA « 5) + A64_T0)  // lsl t0, argc, #3
    a64_addr_(&em, A64_T0, A64_T0, A64_RC)
    a64_addi(&em, A64_T0, A64_T0, 8)             // envp = argv + 8×argc + 8
    a64_sto(&em, A64_T0, A64_RB, 16)
    em.set_label(0)                              // walk to the env's end
    a64_ldw(&em, A64_T1, A64_T0, 8, 0)
    a64_addi(&em, A64_T0, A64_T0, 8)
    a64_cbnz(&em, A64_T1, 0)
    a64_sto(&em, A64_T0, A64_RB, 24)             // auxv
    // the stack: one PROT_NONE reservation, the top opened RW
    a64_movimm(&em, 0, 0)
    a64_movimm(&em, 1, guard_size + stack_size)
    a64_movimm(&em, 2, 0)
    a64_movimm(&em, 3, 147490)
    a64_movimm(&em, 4, ⁻1)
    a64_movimm(&em, 5, 0)
    a64_movimm(&em, 8, machine.sc_number(&tg, machine.Sc.mmap))
    a64_svc(&em)
    a64_cmpr(&em, 0, 31)                         // the flags of x0 - xzr
    a64_bcond(&em, A64_MI, 1)                    // the kernel refused
    a64_movr(&em, A64_RB, 0)                     // the region's foot
    a64_movimm(&em, 0, guard_size)
    a64_addr_(&em, 0, 0, A64_RB)
    a64_movimm(&em, 1, stack_size)
    a64_movimm(&em, 2, 3)
    a64_movimm(&em, 8, machine.sc_number(&tg, machine.Sc.mprot))
    a64_svc(&em)
    a64_cmpr(&em, 0, 31)
    a64_bcond(&em, A64_MI, 1)
    a64_movimm(&em, A64_RA, guard_size + stack_size)
    a64_addr_(&em, A64_RA, A64_RA, A64_RB)
    em.aw(2432696320 + (A64_RA « 5) + 31)        // mov sp, ra
    a64_jmp(&em, 2)
    em.set_label(1)
    let smsg : i64 = lw.intern("the stack could not be reserved\n")
    let spos : i64 = a64_absref(&em, 0)
    em.sf_pos.push(spos)
    em.sf_str.push(smsg)
    a64_movimm(&em, 1, emit.str_len("the stack could not be reserved\n"))
    a64_call(&em, emit.RT_ABORT)
    em.set_label(2)
    // Where the guard is, for the handler to compare a faulting
    // address against, and then the handler itself.  Both before the
    // relro is sealed: the bounds live in it.
    let gpos : i64 = a64_absref(&em, A64_T0)
    em.df_pos.push(gpos)
    em.df_off.push(args_off)
    a64_sto(&em, A64_RB, A64_T0, emit.KB_GLO)
    a64_movimm(&em, A64_T1, guard_size)
    a64_addr_(&em, A64_T1, A64_T1, A64_RB)
    a64_sto(&em, A64_T1, A64_T0, emit.KB_GHI)
    a64_movimm(&em, A64_T1, guard_size + stack_size)
    a64_addr_(&em, A64_T1, A64_T1, A64_RB)
    a64_sto(&em, A64_T1, A64_T0, emit.KB_STOP)
    a64_call(&em, emit.RT_SIGINIT)
    if ginit >= 0:
        a64_call(&em, ginit)
    a64_call(&em, emit.RT_RELRO)
    a64_call(&em, tdriver)
    if start_fn >= 0:
        a64_call(&em, start_fn)
    if not sret:
        a64_movimm(&em, 0, 0)
    a64_movimm(&em, 8, machine.sc_number(&tg, machine.Sc.exit))
    a64_svc(&em)
    a64_resolve(&em)
