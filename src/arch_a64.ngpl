// ===========================================================================
// The retargetable backend's abstract machine
//
// Three abstract 64-bit registers, RA, RB and RC, every IR value in an
// 8-byte stack slot, and a small set of operations each target spells
// in its own instructions.  The driver below composes every IR op out
// of these; a target teaches the machine its spelling and gets the
// whole language.  The x86-64 pioneer keeps its hand-tuned emitter;
// everything else arrives through here.
// ===========================================================================

let RG_A : i64 = 0
let RG_B : i64 = 1
let RG_C : i64 = 2

// comparison conditions, signedness aside
let CC_EQ : i64 = 0
let CC_NE : i64 = 1
let CC_LT : i64 = 2
let CC_LE : i64 = 3
let CC_GT : i64 = 4
let CC_GE : i64 = 5

// IR the runtime builders use and the front end never writes
let IR_SYSC : i64 = 108    // d ← syscall a (an SC_* index); extra b: [argc, arg vregs…]

// what the runtime asks of the kernel, named so the builders stay
// architecture-blind; the target row resolves each to its number
let SC_READ : i64 = 0
let SC_WRITE : i64 = 1
let SC_CLOSE : i64 = 2
let SC_FSTAT : i64 = 3
let SC_MMAP : i64 = 4
let SC_MPROT : i64 = 5
let SC_WRITEV : i64 = 6
let SC_GETPID : i64 = 7
let SC_KILL : i64 = 8
let SC_EXIT : i64 = 9
let SC_GETDENTS : i64 = 10
let SC_OPENAT : i64 = 11
let SC_STATX : i64 = 12
let SC_RT_SIGACTION : i64 = 13
let SC_SIGALTSTACK : i64 = 14

fn sc_number(tg : Target, id : i64) → i64:
    if id = SC_READ: return tg.sc_read
    if id = SC_WRITE: return tg.sc_write
    if id = SC_CLOSE: return tg.sc_close
    if id = SC_FSTAT: return tg.sc_fstat
    if id = SC_MMAP: return tg.sc_mmap
    if id = SC_MPROT: return tg.sc_mprotect
    if id = SC_WRITEV: return tg.sc_writev
    if id = SC_GETPID: return tg.sc_getpid
    if id = SC_KILL: return tg.sc_kill
    if id = SC_EXIT: return tg.sc_exit
    if id = SC_GETDENTS: return tg.sc_getdents
    if id = SC_OPENAT: return tg.sc_openat
    if id = SC_RT_SIGACTION: return tg.sc_rt_sigaction
    if id = SC_SIGALTSTACK: return tg.sc_sigaltstack
    assert(id = SC_STATX, "a syscall the table knows")
    tg.sc_statx

// ---------------------------------------------------------------------------
// aarch64: the A64 instruction layer
//
// Register plan: RA=x9, RB=x10, RC=x11, x12/x13 scratch, arguments in
// x0..x7, the result in x0, x8 the syscall number, x29/x30 frame and
// link.  A frame is [outgoing args: 4 slots][vreg slots]; sp stays put
// between prologue and epilogue, so a slot is [sp, #32 + 8×slot] and
// an incoming stack argument [x29, #16 + 8×(k−8)].
// ---------------------------------------------------------------------------

let A64_RA : i64 = 9
let A64_RB : i64 = 10
let A64_RC : i64 = 11
let A64_T0 : i64 = 12
let A64_T1 : i64 = 13

fn a64_r(r : i64) → i64:
    if r = RG_A: A64_RA else: (if r = RG_B: A64_RB else: A64_RC)

impl Emit:
    // one A64 word, little-endian; respects the skipping switch
    fn aw(&mut self, w : i64):
        self.w32(w)

    // a local branch: the word goes down with a zero displacement and
    // the form says which immediate field the resolver fills
    fn a64_bfix(&mut self, word : i64, lab : i64, form : i64):
        self.tf_pos.push(self.here())
        self.tf_lab.push(lab)
        self.tf_form.push(form)
        self.aw(word)

// one little-endian word read back from the code, each byte widened
// before it is shifted
fn code_word(em : &Emit, pos : i64) → i64:
    let b0 : i64 = @dropunit(em.code[pos × 1¤byte])
    let b1 : i64 = @dropunit(em.code[(pos + 1) × 1¤byte])
    let b2 : i64 = @dropunit(em.code[(pos + 2) × 1¤byte])
    let b3 : i64 = @dropunit(em.code[(pos + 3) × 1¤byte])
    b0 + (b1 « 8) + (b2 « 16) + (b3 « 24)

fn a64_movimm(em : &mut Emit, rd : i64, v : i64):
    if v >= 0 and v < 65536:
        em.aw(3531603968 + ((v & 65535) « 5) + rd)          // movz
        return
    // ~v computed with @wrap: the most negative value may pass through
    if v < 0 and @wrap(0 - v - 1) < 65536 and @wrap(0 - v - 1) >= 0:
        em.aw(2457862144 + ((@wrap(0 - v - 1) & 65535) « 5) + rd)  // movn
        return
    em.aw(3531603968 + ((v & 65535) « 5) + rd)              // movz lo
    em.aw(4070572032 + (((v » 16) & 65535) « 5) + rd)       // movk lsl16
    em.aw(4072669184 + (((v » 32) & 65535) « 5) + rd)       // movk lsl32
    em.aw(4074766336 + (((v » 48) & 65535) « 5) + rd)       // movk lsl48

// a 64-bit slot in the frame: [sp, #32 + 8×slot]
fn a64_ldslot(em : &mut Emit, rd : i64, slot : i64):
    let off : i64 = 4 + slot
    assert(off >= 0 and off < 4096, "the frame offset fits the scaled field")
    em.aw(4181721088 + (off « 10) + (31 « 5) + rd)          // ldr rd, [sp, #off×8]

fn a64_stslot(em : &mut Emit, rs : i64, slot : i64):
    let off : i64 = 4 + slot
    assert(off >= 0 and off < 4096, "the frame offset fits the scaled field")
    em.aw(4177526784 + (off « 10) + (31 « 5) + rs)          // str rs, [sp, #off×8]

// register-to-register forms, each one verified word
fn a64_addr_(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2332033024 + (rm « 16) + (rn « 5) + rd)           // add
fn a64_subr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(3405774848 + (rm « 16) + (rn « 5) + rd)           // sub
fn a64_addsr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2868903936 + (rm « 16) + (rn « 5) + rd)           // adds
fn a64_subsr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(3942645760 + (rm « 16) + (rn « 5) + rd)           // subs
fn a64_mulr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2600500224 + (rm « 16) + (rn « 5) + rd)           // mul (madd xzr)
fn a64_smulh(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2604694528 + (rm « 16) + (rn « 5) + rd)
fn a64_umulh(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2613083136 + (rm « 16) + (rn « 5) + rd)
fn a64_sdiv(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596277248 + (rm « 16) + (rn « 5) + rd)
fn a64_udiv(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596276224 + (rm « 16) + (rn « 5) + rd)
fn a64_msub(em : &mut Emit, rd : i64, rn : i64, rm : i64, ra : i64):
    em.aw(2600501248 + (rm « 16) + (ra « 10) + (rn « 5) + rd)
fn a64_andr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2315255808 + (rm « 16) + (rn « 5) + rd)
fn a64_orrr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2852126720 + (rm « 16) + (rn « 5) + rd)
fn a64_eorr(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(3388997632 + (rm « 16) + (rn « 5) + rd)
fn a64_mvn(em : &mut Emit, rd : i64, rm : i64):
    em.aw(2854224864 + (rm « 16) + rd)
fn a64_negr(em : &mut Emit, rd : i64, rm : i64):
    em.aw(3405775840 + (rm « 16) + rd)
fn a64_lslv(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596282368 + (rm « 16) + (rn « 5) + rd)
fn a64_lsrv(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596283392 + (rm « 16) + (rn « 5) + rd)
fn a64_asrv(em : &mut Emit, rd : i64, rn : i64, rm : i64):
    em.aw(2596284416 + (rm « 16) + (rn « 5) + rd)
fn a64_cmpr(em : &mut Emit, rn : i64, rm : i64):
    em.aw(3942645791 + (rm « 16) + (rn « 5))
fn a64_movr(em : &mut Emit, rd : i64, rm : i64):
    em.aw(2852127712 + (rm « 16) + rd)                      // orr rd, xzr, rm
fn a64_addi(em : &mut Emit, rd : i64, rn : i64, imm : i64):
    assert(imm >= 0 and imm < 4096, "the immediate fits add's field")
    em.aw(2432696320 + (imm « 10) + (rn « 5) + rd)
fn a64_subi(em : &mut Emit, rd : i64, rn : i64, imm : i64):
    assert(imm >= 0 and imm < 4096, "the immediate fits sub's field")
    em.aw(3506438144 + (imm « 10) + (rn « 5) + rd)

// A64 condition codes
let A64_EQ : i64 = 0
let A64_NE : i64 = 1
let A64_CS : i64 = 2
let A64_CC : i64 = 3
let A64_MI : i64 = 4
let A64_VS : i64 = 6
let A64_HI : i64 = 8
let A64_LS : i64 = 9
let A64_GE : i64 = 10
let A64_LT : i64 = 11
let A64_GT : i64 = 12
let A64_LE : i64 = 13

// cset rd, cond: the cond is stored inverted, as csinc has it
fn a64_cset(em : &mut Emit, rd : i64, cond : i64):
    em.aw(2594113504 + ((cond ^ 1) « 12) + rd)
fn a64_csel(em : &mut Emit, rd : i64, rn : i64, rm : i64, cond : i64):
    em.aw(2592079872 + (rm « 16) + (cond « 12) + (rn « 5) + rd)

// loads and stores through a base register, offset zero
fn a64_ldw(em : &mut Emit, rd : i64, base : i64, width : i64, sgn : i64):
    if width = 8:
        em.aw(4181721088 + (base « 5) + rd)                 // ldr x
    elif width = 4:
        em.aw(3107979264 + (base « 5) + rd)                 // ldr w
        if sgn = 1:
            em.aw(2470476800 + (rd « 5) + rd)               // sxtw
    elif width = 2:
        em.aw(2034237440 + (base « 5) + rd)                 // ldrh
        if sgn = 1:
            em.aw(2470460416 + (rd « 5) + rd)               // sxth
    else:
        em.aw(960495616 + (base « 5) + rd)                  // ldrb
        if sgn = 1:
            em.aw(2470452224 + (rd « 5) + rd)               // sxtb
fn a64_stw(em : &mut Emit, rs : i64, base : i64, width : i64):
    if width = 8:
        em.aw(4177526784 + (base « 5) + rs)                 // str x
    elif width = 4:
        em.aw(3103784960 + (base « 5) + rs)                 // str w
    elif width = 2:
        em.aw(2030043136 + (base « 5) + rs)                 // strh
    else:
        em.aw(956301312 + (base « 5) + rs)                  // strb

// scaled 64-bit load and store at a small positive byte offset
fn a64_ldo(em : &mut Emit, rd : i64, base : i64, off : i64):
    assert(off >= 0 and (off % 8 ?? 1) = 0 and off < 32768, "a scaled offset")
    em.aw(4181721088 + ((off ÷ 8 ?? 0) « 10) + (base « 5) + rd)
fn a64_sto(em : &mut Emit, rs : i64, base : i64, off : i64):
    assert(off >= 0 and (off % 8 ?? 1) = 0 and off < 32768, "a scaled offset")
    em.aw(4177526784 + ((off ÷ 8 ?? 0) « 10) + (base « 5) + rs)

fn a64_sxt(em : &mut Emit, rd : i64, bits : i64):
    if bits = 8:
        em.aw(2470452224 + (rd « 5) + rd)                   // sxtb
    elif bits = 16:
        em.aw(2470460416 + (rd « 5) + rd)                   // sxth
    else:
        em.aw(2470476800 + (rd « 5) + rd)                   // sxtw
fn a64_uxt(em : &mut Emit, rd : i64, bits : i64):
    if bits = 8:
        em.aw(1392516096 + (rd « 5) + rd)                   // uxtb
    elif bits = 16:
        em.aw(1392524288 + (rd « 5) + rd)                   // uxth
    else:
        em.aw(704644064 + (rd « 16) + rd)                   // mov w,w

// an absolute address, materialized as movz+movk and patched later;
// answers the position the patcher writes into
fn a64_absref(em : &mut Emit, rd : i64) → i64:
    let pos : i64 = em.here()
    em.aw(3531603968 + rd)                                  // movz rd, #0
    em.aw(4070572032 + rd)                                  // movk rd, #0, lsl 16
    pos

fn a64_patch_abs(em : &mut Emit, pos : i64, v : i64):
    // the register the materialization was aimed at, read back from
    // its own first byte
    let rd : i64 = @dropunit(em.code[pos × 1¤byte]) & 31
    em.patch32(pos, 3531603968 + ((v & 65535) « 5) + rd)
    em.patch32(pos + 4, 4070572032 + (((v » 16) & 65535) « 5) + rd)

// local branches: the resolver reads the form
let A64F_B26 : i64 = 26
let A64F_B19 : i64 = 19

fn a64_jmp(em : &mut Emit, lab : i64):
    em.a64_bfix(335544320, lab, A64F_B26)                   // b
fn a64_bcond(em : &mut Emit, cond : i64, lab : i64):
    em.a64_bfix(1409286144 + cond, lab, A64F_B19)           // b.cond
fn a64_cbz(em : &mut Emit, r : i64, lab : i64):
    em.a64_bfix(3019898880 + r, lab, A64F_B19)
fn a64_cbnz(em : &mut Emit, r : i64, lab : i64):
    em.a64_bfix(3036676096 + r, lab, A64F_B19)

// a call against a function or runtime id: one bl, patched at the end
fn a64_call(em : &mut Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here())
    em.cf_target.push(target)
    em.aw(2483027968)                                       // bl 0

fn a64_blr(em : &mut Emit, r : i64):
    em.aw(3594452992 + (r « 5))
fn a64_br(em : &mut Emit, r : i64):
    em.aw(3592355840 + (r « 5))
fn a64_ret(em : &mut Emit):
    em.aw(3596551104)
fn a64_svc(em : &mut Emit):
    em.aw(3556769793)

// after the labels of a function settle, its local branches do
fn a64_resolve(em : &mut Emit):
    if #em.tf_pos > 0:
        foreach i := 0…#em.tf_pos - 1:
            let pos : i64 = em.tf_pos[i]
            let delta : i64 = em.labels[em.tf_lab[i] × 1¤ptrdiff] - pos
            let word : i64 = code_word(&em, pos)
            if em.tf_form[i] = A64F_B26:
                em.patch32(pos, word + (((delta » 2) & 67108863)))
            else:
                em.patch32(pos, word + (((delta » 2) & 524287) « 5))
    while #em.tf_pos > 0:
        _ ← em.tf_pos.pop() ?? 0
        _ ← em.tf_lab.pop() ?? 0
        _ ← em.tf_form.pop() ?? 0

// ---------------------------------------------------------------------------
// The abstract operations, dispatched on the target.  Every function
// here is one small spelling decision; the thinking lives in the
// driver below, written once.
// ---------------------------------------------------------------------------

let RG_T : i64 = 3

fn a64_ar(r : i64) → i64:
    if r = RG_A: return A64_RA
    if r = RG_B: return A64_RB
    if r = RG_C: return A64_RC
    A64_T0

fn a64g_lds(em : &mut Emit, tg : Target, r : i64, slot : i64):
    a64_ldslot(&em, a64_ar(r), slot)

fn a64g_sts(em : &mut Emit, tg : Target, r : i64, slot : i64):
    a64_stslot(&em, a64_ar(r), slot)

fn a64g_const(em : &mut Emit, tg : Target, r : i64, v : i64):
    a64_movimm(&em, a64_ar(r), v)

fn a64g_mov2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    a64_movr(&em, a64_ar(rd), a64_ar(rs))

fn a64g_add3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_addr_(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_sub3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_subr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_mul3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_mulr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_and3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_andr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_or3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_orrr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_xor3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_eorr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_not2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    a64_mvn(&em, a64_ar(rd), a64_ar(rs))

fn a64g_neg2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    a64_negr(&em, a64_ar(rd), a64_ar(rs))

fn a64g_shl3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_lslv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_shr3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_lsrv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_sar3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a64_asrv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

// rd ← rs « imm, the shift written into the instruction
fn a64g_shl3i(em : &mut Emit, tg : Target, rd : i64, rs : i64, imm : i64):
    // ubfm rd, rs, #(64-imm), #(63-imm)
    em.aw(3544186880 + (((64 - imm) & 63) « 16) + ((63 - imm) « 10) + (a64_ar(rs) « 5) + a64_ar(rd))

// the A64 spelling of a comparison's answer
fn a64_cc(cond : i64, sgn : i64) → i64:
    if cond = CC_EQ: return A64_EQ
    if cond = CC_NE: return A64_NE
    if sgn = 1:
        if cond = CC_LT: return A64_LT
        if cond = CC_LE: return A64_LE
        if cond = CC_GT: return A64_GT
        return A64_GE
    if cond = CC_LT: return A64_CC
    if cond = CC_LE: return A64_LS
    if cond = CC_GT: return A64_HI
    A64_CS

// rd ← rx rel ry, materialized as 0 or 1
fn a64g_cmp3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64):
    a64_cmpr(&em, a64_ar(rx), a64_ar(ry))
    a64_cset(&em, a64_ar(rd), a64_cc(cond, sgn))

// rd ← rc ≠ 0 ? rx : ry
fn a64g_sel4(em : &mut Emit, tg : Target, rd : i64, rc : i64, rx : i64, ry : i64):
    em.aw(4043309087 + (a64_ar(rc) « 5))     // cmp rc, #0
    a64_csel(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry), A64_NE)

fn a64g_div3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    if sgn = 1:
        a64_sdiv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))
    else:
        a64_udiv(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))

fn a64g_mod3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    if sgn = 1:
        a64_sdiv(&em, A64_T1, a64_ar(rx), a64_ar(ry))
    else:
        a64_udiv(&em, A64_T1, a64_ar(rx), a64_ar(ry))
    a64_msub(&em, a64_ar(rd), A64_T1, a64_ar(ry), a64_ar(rx))

// rd ← rx op ry with rf saying whether the 64-bit result overflowed
fn a64g_addov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    a64_addsr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))
    a64_cset(&em, a64_ar(rf), if sgn = 1: A64_VS else: A64_CS)

fn a64g_subov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    a64_subsr(&em, a64_ar(rd), a64_ar(rx), a64_ar(ry))
    // on ARM a clear carry is the borrow
    a64_cset(&em, a64_ar(rf), if sgn = 1: A64_VS else: A64_CC)

fn a64g_mulov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    if sgn = 1:
        a64_mulr(&em, A64_T1, a64_ar(rx), a64_ar(ry))
        a64_smulh(&em, A64_T0, a64_ar(rx), a64_ar(ry))
        // the high half of an unoverflowed product is the low half's sign
        em.aw(2470445056 + (63 « 16) + (63 « 10) + (A64_T1 « 5) + a64_ar(rf))   // asr rf, t1, #63
        a64_cmpr(&em, A64_T0, a64_ar(rf))
        a64_cset(&em, a64_ar(rf), A64_NE)
        a64_movr(&em, a64_ar(rd), A64_T1)
    else:
        a64_mulr(&em, A64_T1, a64_ar(rx), a64_ar(ry))
        a64_umulh(&em, A64_T0, a64_ar(rx), a64_ar(ry))
        em.aw(4043309087 + (A64_T0 « 5))                            // cmp t0, #0
        a64_cset(&em, a64_ar(rf), A64_NE)
        a64_movr(&em, a64_ar(rd), A64_T1)

// r ← r as its width says, sign or zero carried through
fn a64g_ext2(em : &mut Emit, tg : Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    if sgn = 1:
        a64_sxt(&em, a64_ar(r), bits)
    else:
        a64_uxt(&em, a64_ar(r), bits)

// rd ← mem[rbase + off]; width 0 is the target's pointer, zero-extended
fn a64g_ldo(em : &mut Emit, tg : Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    if off = 0:
        a64_ldw(&em, a64_ar(rd), a64_ar(rbase), wd, sgn)
    elif wd = 8 and (off % 8 ?? 1) = 0 and off > 0:
        a64_ldo(&em, a64_ar(rd), a64_ar(rbase), off)
    else:
        a64_movimm(&em, A64_T1, off)
        a64_addr_(&em, A64_T1, a64_ar(rbase), A64_T1)
        a64_ldw(&em, a64_ar(rd), A64_T1, wd, sgn)

fn a64g_sto(em : &mut Emit, tg : Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    if off = 0:
        a64_stw(&em, a64_ar(rs), a64_ar(rbase), wd)
    elif wd = 8 and (off % 8 ?? 1) = 0 and off > 0:
        a64_sto(&em, a64_ar(rs), a64_ar(rbase), off)
    else:
        a64_movimm(&em, A64_T1, off)
        a64_addr_(&em, A64_T1, a64_ar(rbase), A64_T1)
        a64_stw(&em, a64_ar(rs), A64_T1, wd)

fn a64g_jmp(em : &mut Emit, tg : Target, lab : i64):
    a64_jmp(&em, lab)

fn a64g_jz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    a64_cbz(&em, a64_ar(r), lab)

fn a64g_jnz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    a64_cbnz(&em, a64_ar(r), lab)

fn a64g_label(em : &mut Emit, tg : Target, lab : i64):
    em.set_label(lab)

fn a64g_call(em : &mut Emit, tg : Target, target : i64):
    a64_call(&em, target)

fn a64g_calli(em : &mut Emit, tg : Target, r : i64):
    a64_blr(&em, a64_ar(r))

fn a64g_ijmp(em : &mut Emit, tg : Target, r : i64):
    a64_br(&em, a64_ar(r))

// arguments travel in x0…x7; the ninth onward in the outgoing slots
// Only i386 spends the private convention's headroom so far, so
// this puts the argument where the architecture's own convention
// says and the two agree.
fn a64g_argreg(em : &mut Emit, tg : Target, k : i64, slot : i64):
    a64g_argld(&em, tg, k, slot)

fn a64g_argld(em : &mut Emit, tg : Target, k : i64, slot : i64):
    if k < 8:
        a64_ldslot(&em, k, slot)
    else:
        a64_ldslot(&em, A64_T1, slot)
        a64_sto(&em, A64_T1, 31, 8 × (k - 8))

fn a64g_argconst(em : &mut Emit, tg : Target, k : i64, v : i64):
    assert(k < 8, "a constant argument rides a register")
    a64_movimm(&em, k, v)

fn a64g_argmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    assert(k < 8, "a moved argument rides a register")
    a64_movr(&em, k, a64_ar(r))

// the returned value's two directions
fn a64g_retst(em : &mut Emit, tg : Target, slot : i64):
    a64_stslot(&em, 0, slot)

fn a64g_retld(em : &mut Emit, tg : Target, slot : i64):
    a64_ldslot(&em, 0, slot)

fn a64g_retmov(em : &mut Emit, tg : Target, r : i64):
    a64_movr(&em, 0, a64_ar(r))

// an absolute address, materialized into an abstract register or an
// argument register; the caller records the answered position in the
// fixup list the address belongs to
fn a64g_absref(em : &mut Emit, tg : Target, r : i64) → i64:
    a64_absref(&em, a64_ar(r))

fn a64g_absref_arg(em : &mut Emit, tg : Target, k : i64) → i64:
    assert(k < 8, "an address argument rides a register")
    a64_absref(&em, k)

// the kernel: arguments from slots, the number, the trap
fn a64g_sysarg(em : &mut Emit, tg : Target, k : i64, slot : i64):
    a64_ldslot(&em, k, slot)

fn a64g_sysimm(em : &mut Emit, tg : Target, k : i64, v : i64):
    a64_movimm(&em, k, v)

fn a64g_sysmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    a64_movr(&em, k, a64_ar(r))

fn a64g_syscall(em : &mut Emit, tg : Target, scid : i64):
    a64_movimm(&em, 8, sc_number(tg, scid))
    a64_svc(&em)

fn a64g_sysret(em : &mut Emit, tg : Target, r : i64):
    a64_movr(&em, a64_ar(r), 0)

// the frame: save the caller's, claim the slots and the outgoing
// argument room, spill the incoming arguments to their slots
// The address of the frame's object region, plus off.  The region
// takes the slots just past the vregs, so the slot formula gives it:
// slot s sits at sp + 8×(4+s), and the region begins at slot nvregs.
@pre(off >= 0)
fn a64g_frameaddr(em : &mut Emit, tg : Target, nvregs : i64, nobj : i64, off : i64, r : i64):
    _ ← nobj
    let at : i64 = 32 + 8 × nvregs + off
    assert(at >= 0 and at < 4096, "the frame offset fits the immediate")
    em.aw(2432696320 + (at « 10) + (31 « 5) + a64_ar(r))   // add xr, sp, #at

fn a64g_prologue(em : &mut Emit, tg : Target, nvregs : i64, np : i64, nreg : i64):
    let frame : i64 = align_up(32 + 8 × nvregs, 16)
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.aw(2847898621)                            // stp x29, x30, [sp, #-16]!
    em.aw(2432697341)                            // mov x29, sp
    if frame < 4096:
        em.aw(3506438144 + (frame « 10) + (31 « 5) + 31)     // sub sp, sp, #frame
    else:
        a64_movimm(&em, A64_T1, frame)
        em.aw(3405774848 + (A64_T1 « 16) + (31 « 5) + 31)    // sub sp, sp, t1
    let j : mut i64 = 0
    while j < np:
        if j < 8:
            a64_stslot(&em, j, j)
        else:
            // an incoming stack argument sits above the saved pair
            a64_ldo(&em, A64_T1, 29, 16 + 8 × (j - 8))
            a64_stslot(&em, A64_T1, j)
        j ← j + 1

fn a64g_epilogue(em : &mut Emit, tg : Target):
    em.aw(2432697279)                            // mov sp, x29: drop the frame
    em.aw(2831252477)                            // ldp x29, x30, [sp], #16
    a64_ret(&em)

fn a64g_resolve(em : &mut Emit, tg : Target):
    a64_resolve(&em)

fn a64g_patch_abs(em : &mut Emit, tg : Target, pos : i64, v : i64):
    a64_patch_abs(&em, pos, v)

fn a64g_patch_call(em : &mut Emit, tg : Target, pos : i64, dest : i64):
    let word : i64 = code_word(&em, pos)
    em.patch32(pos, word + (((dest - pos) » 2) & 67108863))


