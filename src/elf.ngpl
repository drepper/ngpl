// ---------------------------------------------------------------------------
// The ELF executable: text R+X, rodata R, data R+W
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Targets
//
// One backend, several architectures.  Everything that varies between
// them -- the ELF machine number and class, the width of a pointer,
// the Linux syscall numbers, the quirks -- is collected in one
// descriptor, so the code above it can ask rather than assume.  The
// data model does not vary: every value is an 8-byte slot on every
// target, and a pointer on a 32-bit machine rides zero-extended in
// one, so the data sections and the IR mean the same thing everywhere.
// A new target is a new row here and a new instruction layer below,
// and nothing in between.
// ---------------------------------------------------------------------------

// the machines ELF names, with the format's own width
enum Em : u16:
    none = 0
    i386 = 3
    arm = 40
    x86_64 = 62
    aarch64 = 183
    riscv = 243

// Which machine, as an enumeration rather than a run of numbers.  What
// this buys is that a match over it is held to having an arm for every
// one of them: adding a seventh stops every dispatcher that does not
// say what to do with it, where a chain of comparisons would quietly
// send it wherever the last branch went.
enum Tgt : u32:
    x64 = 0
    i386 = 1
    a64 = 2
    a32 = 3
    rv64 = 4
    rv32 = 5

let TGT_X64 : Tgt = Tgt.x64
let TGT_I386 : Tgt = Tgt.i386
let TGT_A64 : Tgt = Tgt.a64
let TGT_A32 : Tgt = Tgt.a32
let TGT_RV64 : Tgt = Tgt.rv64
let TGT_RV32 : Tgt = Tgt.rv32

// e_flags is the one header field whose meaning belongs to the machine
// rather than to ELF: what a bit says for arm it says for nothing else,
// and the top byte is not a flag at all but which version of the ABI
// this is.  So it is no enumeration -- the field stays a word, and the
// machines with something to put in it name their own pieces here.
// Every other machine this compiler targets puts nothing.
let EF_ARM_EABI_VER5 : i64 = 83886080      // 0x05000000, in the ABI byte
let EF_ARM_ABI_FLOAT_SOFT : i64 = 512      // the runtime touches no float register

struct Target:
    id : Tgt
    name : str           // the canonical spelling --target accepts
    machine : Em         // ELF e_machine
    is64 : bool          // ELFCLASS64: 8-byte kernel words
    eflags : i64         // ELF e_flags
    ptr : i64            // bytes in a pointer
    // the Linux syscall numbers the runtime issues.  The kernel gave
    // every old architecture its own table and the new ones a shared
    // generic table, which is why aarch64 and RISC-V agree and the
    // rest do not.
    sc_read : i64
    sc_write : i64
    sc_close : i64
    sc_fstat : i64
    sc_mmap : i64        // mmap2 on the 32-bit legacy targets
    sc_mprotect : i64
    sc_writev : i64
    sc_getpid : i64
    sc_kill : i64
    sc_exit : i64
    sc_getdents : i64
    sc_openat : i64
    stat_size : i64      // where st_size sits in what fstat fills in
    o_directory : i64    // O_DIRECTORY: x86 and the generic table disagree
    sc_statx : i64       // where an fstat-less arch (rv32) reads a size
    // What a program needs to catch its own stack running out: a
    // handler, and a stack for the handler to run on, since the one
    // that ran out is no place to put a frame.
    sc_rt_sigaction : i64
    sc_sigaltstack : i64
    // Where the restorer goes in the kernel's struct sigaction, or ⁻1
    // where the architecture has none and the mask follows the flags.
    // x86-64, i386 and arm carry one; aarch64 and riscv do not, and
    // their struct is shorter by a word because of it.
    sa_restorer_off : i64
    stx_size : i64       // …and where st_size sits in what it fills

fn targets() → Target[]:
    let t : mut Target[] = []
    t.push(Target{id: TGT_X64, name: "x86-64", machine: Em.x86_64, is64: true,
                  eflags: 0, ptr: 8,
                  sc_read: 0, sc_write: 1, sc_close: 3, sc_fstat: 5,
                  sc_mmap: 9, sc_mprotect: 10, sc_writev: 20,
                  sc_getpid: 39, sc_kill: 62, sc_exit: 60,
                  sc_getdents: 217, sc_openat: 257, stat_size: 48, o_directory: 65536, sc_statx: 291, stx_size: 40, sc_rt_sigaction: 13, sc_sigaltstack: 131, sa_restorer_off: 16})
    t.push(Target{id: TGT_I386, name: "i386", machine: Em.i386, is64: false,
                  eflags: 0, ptr: 4,
                  sc_read: 3, sc_write: 4, sc_close: 6, sc_fstat: 197,
                  sc_mmap: 192, sc_mprotect: 125, sc_writev: 146,
                  sc_getpid: 20, sc_kill: 37, sc_exit: 1,
                  sc_getdents: 220, sc_openat: 295, stat_size: 44, o_directory: 65536, sc_statx: 383, stx_size: 40, sc_rt_sigaction: 174, sc_sigaltstack: 186, sa_restorer_off: 8})
    t.push(Target{id: TGT_A64, name: "aarch64", machine: Em.aarch64, is64: true,
                  eflags: 0, ptr: 8,
                  sc_read: 63, sc_write: 64, sc_close: 57, sc_fstat: 80,
                  sc_mmap: 222, sc_mprotect: 226, sc_writev: 66,
                  sc_getpid: 172, sc_kill: 129, sc_exit: 93,
                  sc_getdents: 61, sc_openat: 56, stat_size: 48, o_directory: 16384, sc_statx: 291, stx_size: 40, sc_rt_sigaction: 134, sc_sigaltstack: 132, sa_restorer_off: ⁻1})
    t.push(Target{id: TGT_A32, name: "arm", machine: Em.arm, is64: false,
                  eflags: EF_ARM_EABI_VER5 | EF_ARM_ABI_FLOAT_SOFT, ptr: 4,
                  sc_read: 3, sc_write: 4, sc_close: 6, sc_fstat: 197,
                  sc_mmap: 192, sc_mprotect: 125, sc_writev: 146,
                  sc_getpid: 20, sc_kill: 37, sc_exit: 1,
                  sc_getdents: 217, sc_openat: 322, stat_size: 48, o_directory: 16384, sc_statx: 397, stx_size: 40, sc_rt_sigaction: 174, sc_sigaltstack: 186, sa_restorer_off: 8})
    t.push(Target{id: TGT_RV64, name: "riscv64", machine: Em.riscv, is64: true,
                  eflags: 0, ptr: 8,
                  sc_read: 63, sc_write: 64, sc_close: 57, sc_fstat: 80,
                  sc_mmap: 222, sc_mprotect: 226, sc_writev: 66,
                  sc_getpid: 172, sc_kill: 129, sc_exit: 93,
                  sc_getdents: 61, sc_openat: 56, stat_size: 48, o_directory: 65536, sc_statx: 291, stx_size: 40, sc_rt_sigaction: 134, sc_sigaltstack: 132, sa_restorer_off: ⁻1})
    t.push(Target{id: TGT_RV32, name: "riscv32", machine: Em.riscv, is64: false,
                  eflags: 0, ptr: 4,
                  sc_read: 63, sc_write: 64, sc_close: 57, sc_fstat: 80,
                  sc_mmap: 222, sc_mprotect: 226, sc_writev: 66,
                  sc_getpid: 172, sc_kill: 129, sc_exit: 93,
                  sc_getdents: 61, sc_openat: 56, stat_size: 48, o_directory: 65536, sc_statx: 291, stx_size: 40, sc_rt_sigaction: 134, sc_sigaltstack: 132, sa_restorer_off: ⁻1})
    t

// The architecture this compiler is running on, which is what a
// --target-less run aims at.  The compiler only builds and runs on
// x86-64 hosts today; when it is compiled for another host, the stage
// that compiles it stamps this answer.
fn host_target() → str:
    "x86-64"

// a spelling to a descriptor, the common aliases included; ⁻1 answers
// for a name no target claims
fn target_index(name : str) → i64:
    let canon : mut str = name
    if name = "amd64" or name = "x86_64": canon ← "x86-64"
    elif name = "x86-32" or name = "i686" or name = "ia32": canon ← "i386"
    elif name = "arm64": canon ← "aarch64"
    elif name = "arm32" or name = "armv7": canon ← "arm"
    elif name = "rv64": canon ← "riscv64"
    elif name = "rv32": canon ← "riscv32"
    let ts := targets()
    foreach i := 0…#ts:
        if ts[i].name = canon:
            return @dropunit(i)
    ⁻1

fn target_names() → str:
    let ts := targets()
    let out : mut str = ""
    foreach i := 0…#ts:
        out ← out ⧺ (if i = 0: "" else: ", ") ⧺ ts[i].name
    out

let IMAGE_BASE : i64 = 4194304
let PAGE : i64 = 4096

// The stack the program runs on is reserved at startup rather than
// grown by the kernel on demand: a region of STACK bytes with a GUARD
// of unreadable pages below it, so an overflow stops the program where
// it happens instead of walking into whatever lies beneath.  Both are
// settable on the command line; both are rounded up to whole pages.
let STACK_DEFAULT : i64 = 8388608     // 8 MiB, what a Linux stack usually gets
let GUARD_DEFAULT : i64 = 65536       // 64 KiB: sixteen pages of nothing
let SIZE_MAX_OPT : i64 = 1073741824   // a gibibyte is past any real need

@pre(a > 0 and v >= 0)
@post(r: r >= v and (r % a ?? 1) = 0)
fn align_up(v : i64, a : i64) → i64:
    ((v + a - 1) ÷ a ?? 0) × a

// the same rounding for byte-measured quantities: two alike divide
// into a bare count, which the alignment then scales back up
@pre(a > 0 and v >= 0)
@post(r: r >= v)
fn align_up_b(v : i64 ¤byte, a : i64 ¤byte) → i64 ¤byte:
    let one : i64 ¤byte = 1
    ((v + a - one) ÷ a ?? 0) × a

// What the file's numbers count.  Offsets, sizes and addresses count
// bytes, which the language already ships; the rest are the format's
// own countables, one measure each, so an index into the section
// table cannot wander into a symbol count without being told to part
// with its meaning first.
unit shndx
unit symndx
unit phndx

// What the constants in <elf.h> are called, spelled as what they
// are: enumerations with the format's own widths, and bit sets where
// the field is one.  The automatic @flag values double from one, so
// the members stand in <elf.h>'s order.
enum Et : u16:
    none
    rel
    exec
    dyn
    core

enum Ev : u32:
    none
    current

enum Pt : u32:
    null
    load
    dynamic
    interp
    note
    shlib
    phdr
    tls
    gnu_stack = 1685382481
    gnu_relro = 1685382482

@flag
enum Pf : u32:
    x
    w
    r

enum Sht : u32:
    null
    progbits
    symtab
    strtab
    rela
    hash
    dynamic
    note
    nobits

@flag
enum Shf : u64:
    write
    alloc
    execinstr


// What a symbol is for, and how far it is meant to reach.  ELF gives
// each its own set of names and then packs the two into one byte, so
// each is its own enumeration here and sym_info() is the one place the
// packing is written down.
enum Stb : u8:
    local
    global
    weak

enum Stt : u8:
    notype
    object
    func
    section
    file

// What a symbol shows to whoever links against it.  ELF calls the
// field st_other and gives meaning to its low two bits, which are
// these; the rest must be zero, so the field is nothing but this.
enum Stv : u8:
    default
    internal
    hidden
    protected

// The binding sits above the type in one byte.  Neither reaches
// sixteen, so the two fit side by side without either being cut short.
@post(r: r >= 0)
fn sym_info(bind : Stb, kind : Stt) → u8:
    bind.ord() × 16 + kind.ord()

// The identification bytes, which ELF names one at a time rather than
// giving them a structure: four that say the file is an ELF file at
// all, then how wide its words are, which end they start from, which
// version this is, and whose ABI it follows.  The rest is padding and
// must be zero.
enum Elfclass : u8:
    none
    class32
    class64

enum Elfdata : u8:
    none
    lsb                  // two's complement, least significant byte first
    msb

enum Elfosabi : u8:
    sysv                 // what Linux writes, whatever it then does
    hpux
    netbsd
    gnu

// EI_VERSION says the same thing e_version does, one byte wide where
// that field is a word, so Ev cannot be spelled here and this is the
// same value at the width the identification uses.
let EI_CURRENT : u8 = 1

// The file's own name for itself.  Written out rather than assembled
// from a literal so that each byte is said rather than counted to.
fn elf_ident(cls : Elfclass, order : Elfdata, abi : Elfosabi) → u8[16]:
    [127, 69, 76, 70,                       // DEL, then "ELF"
     cls.ord(), order.ord(), EI_CURRENT, abi.ord(),
     0, 0, 0, 0, 0, 0, 0, 0]

// A section index is a number and not an enumeration -- the sections
// are this file's own, and it names them by where they sit -- so these
// are named values of the measure rather than members of a type.  Only
// the absent one is ELF's; the text index is where this compiler puts
// its text.
let SHN_UNDEF : i64 ¤"shndx" = 0
let SHN_TEXT : i64 ¤"shndx" = 1   // the first section header is the absent one

// The file's own structures, as <elf.h> declares them.  They are
// written out as themselves rather than assembled byte by byte: a
// header is a statement about where things are, and stating it as a
// struct with a defined layout keeps the statement and the bytes the
// same thing.  Only what ELF gives no structure to -- the code, the
// read-only and writable images, the string tables, the gaps between
// segments -- stays a run of bytes.

@repr(C)
struct Elf64_Ehdr:
    e_ident : u8[16]
    e_type : Et
    e_machine : Em
    e_version : Ev
    e_entry : u64 ¤byte
    e_phoff : u64 ¤byte
    e_shoff : u64 ¤byte
    e_flags : u32
    e_ehsize : u16 ¤byte
    e_phentsize : u16 ¤byte
    e_phnum : u16 ¤"phndx"
    e_shentsize : u16 ¤byte
    e_shnum : u16 ¤"shndx"
    e_shstrndx : u16 ¤"shndx"

@repr(C)
struct Elf64_Phdr:
    p_type : Pt
    p_flags : Pf
    p_offset : u64 ¤byte
    p_vaddr : u64 ¤byte
    p_paddr : u64 ¤byte
    p_filesz : u64 ¤byte
    p_memsz : u64 ¤byte
    p_align : u64 ¤byte

@repr(C)
struct Elf64_Shdr:
    sh_name : u32 ¤byte
    sh_type : Sht
    sh_flags : Shf
    sh_addr : u64 ¤byte
    sh_offset : u64 ¤byte
    sh_size : u64 ¤byte
    sh_link : u32 ¤"shndx"
    sh_info : u32 ¤"symndx"
    sh_addralign : u64 ¤byte
    sh_entsize : u64 ¤byte

// A row of the bill of materials, as it sits in the file: what it is
// about, and where in .sbomstr its name and its digest are.  Twelve
// bytes, the same in both classes -- an offset into a string table is
// no wider on a 64-bit machine than on a 32-bit one.
@repr(C)
struct Sbom_Entry:
    kind : Sbomkind
    name : u32 ¤byte     // offset into .sbomstr
    hash : u32 ¤byte     // …and of the digest, written out as ASCII

@repr(C)
struct Elf64_Sym:
    st_name : u32 ¤byte
    st_info : u8
    st_other : Stv
    st_shndx : u16 ¤"shndx"
    st_value : u64 ¤byte
    st_size : u64 ¤byte


// The 32-bit file wears the same information in narrower fields, and
// twice in a different order: the ELF specification moved p_flags to
// the end of a 32-bit program header and st_info behind st_value in a
// 32-bit symbol.  The materializers below are where that difference
// lives, and nowhere else.
@repr(C)
struct Elf32_Ehdr:
    e_ident : u8[16]
    e_type : Et
    e_machine : Em
    e_version : Ev
    e_entry : u32 ¤byte
    e_phoff : u32 ¤byte
    e_shoff : u32 ¤byte
    e_flags : u32
    e_ehsize : u16 ¤byte
    e_phentsize : u16 ¤byte
    e_phnum : u16 ¤"phndx"
    e_shentsize : u16 ¤byte
    e_shnum : u16 ¤"shndx"
    e_shstrndx : u16 ¤"shndx"

@repr(C)
struct Elf32_Phdr:
    p_type : Pt
    p_offset : u32 ¤byte
    p_vaddr : u32 ¤byte
    p_paddr : u32 ¤byte
    p_filesz : u32 ¤byte
    p_memsz : u32 ¤byte
    p_flags : Pf
    p_align : u32 ¤byte

@repr(C)
struct Elf32_Shdr:
    sh_name : u32 ¤byte
    sh_type : Sht
    sh_flags : u32       // ELF32's Word is narrower than Shf's fixed
                         // u64, so the bits are copied out by number
    sh_addr : u32 ¤byte
    sh_offset : u32 ¤byte
    sh_size : u32 ¤byte
    sh_link : u32 ¤"shndx"
    sh_info : u32 ¤"symndx"
    sh_addralign : u32 ¤byte
    sh_entsize : u32 ¤byte

@repr(C)
struct Elf32_Sym:
    st_name : u32 ¤byte
    st_value : u32 ¤byte
    st_size : u32 ¤byte
    st_info : u8
    st_other : Stv
    st_shndx : u16 ¤"shndx"

// One symbol: what it is called, where it starts, how long it is, and
// whether anything outside may link against it.
struct Sym:
    name : str
    value : i64 ¤byte    // the offset within the text, made absolute below
    size : i64 ¤byte
    is_global : bool

// The images ELF gives no structure to -- the read-only and writable
// data -- are built a word at a time, since what they hold is the
// program's, not the format's.
fn push32(out : &mut u8[], v : i64):
    out.push(v & 255)
    out.push((v » 8) & 255)
    out.push((v » 16) & 255)
    out.push((v » 24) & 255)

fn push64(out : &mut u8[], v : i64):
    push32(&out, v)
    push32(&out, v » 32)

// n bytes of nothing, which is what a gap between segments is and what
// the file has no structure for
@pre(n >= 0)
@post(r: #r = n)
fn zeros(n : i64 ¤byte) → u8[]:
    let out : mut u8[] = []
    foreach i := 0…n:
        out.push(0)
    out

// The file, as the pieces it is made of and in the order they are
// written.  Nothing here is a single array of everything: each piece
// keeps its own shape until the kernel is handed all of them at once.
struct Elf:
    ehdr : Elf64_Ehdr
    phdrs : Elf64_Phdr[]
    gap_text : u8[]
    code : u8[]
    gap_ro : u8[]
    rodata : u8[]
    gap_data : u8[]
    data : u8[]
    gap_sbom : u8[]
    sbom : Sbom_Entry[]
    sbomstr : u8[]
    gap_syms : u8[]
    syms : Elf64_Sym[]
    strtab : u8[]
    shstrtab : u8[]
    gap_shdrs : u8[]
    shdrs : Elf64_Shdr[]

// …and the same pieces in the 32-bit spelling
struct Elf32:
    ehdr : Elf32_Ehdr
    phdrs : Elf32_Phdr[]
    gap_text : u8[]
    code : u8[]
    gap_ro : u8[]
    rodata : u8[]
    gap_data : u8[]
    data : u8[]
    gap_sbom : u8[]
    sbom : Sbom_Entry[]
    sbomstr : u8[]
    gap_syms : u8[]
    syms : Elf32_Sym[]
    strtab : u8[]
    shstrtab : u8[]
    gap_shdrs : u8[]
    shdrs : Elf32_Shdr[]

// a program header, whose fields are the same shape every time
fn phdr(kind : Pt, flags : Pf, off : i64 ¤byte, vaddr : i64 ¤byte,
        filesz : i64 ¤byte, memsz : i64 ¤byte, align : i64 ¤byte) → Elf64_Phdr:
    (Elf64_Phdr{p_type: kind, p_flags: flags,
                p_offset: off, p_vaddr: vaddr,
                p_paddr: vaddr, p_filesz: filesz,
                p_memsz: memsz, p_align: align})

fn shdr(name : i64 ¤byte, kind : Sht, flags : Shf, addr : i64 ¤byte,
        off : i64 ¤byte, size : i64 ¤byte, link : i64 ¤"shndx",
        info : i64 ¤"symndx", align : i64 ¤byte,
        entsize : i64 ¤byte) → Elf64_Shdr:
    (Elf64_Shdr{sh_name: name, sh_type: kind,
                sh_flags: flags, sh_addr: addr,
                sh_offset: off, sh_size: size,
                sh_link: link, sh_info: info,
                sh_addralign: align, sh_entsize: entsize})

// The plan, in the gelf manner: the 64-bit structures are wide enough
// to hold everything a 32-bit file says, so the planning phase builds
// the final Elf64 forms outright.  A 64-bit file hands them to the
// writer as they are -- the common path copies nothing -- and a
// 32-bit file narrows copies on the way out.  The values are the
// file's own either way: every offset below is computed with the
// class's entry sizes, so a 32-bit plan holds 32-bit truths in
// 64-bit fields, exactly as libelf's gelf_* functions have it.
struct ElfPlan:
    ehdr : Elf64_Ehdr
    phdrs : Elf64_Phdr[]
    shdrs : Elf64_Shdr[]
    syms : Elf64_Sym[]
    strtab : u8[]
    shstr : u8[]
    sbom : Sbom_Entry[]
    sbomstr : u8[]
    // where the pieces fall, for the gaps between them
    text_off : i64 ¤byte
    text_size : i64 ¤byte
    ro_off : i64 ¤byte
    ro_size : i64 ¤byte
    d_off : i64 ¤byte
    d_size : i64 ¤byte
    bom_off : i64 ¤byte
    bom_size : i64 ¤byte
    bstr_size : i64 ¤byte
    sym_off : i64 ¤byte
    shstr_off : i64 ¤byte
    sh_off : i64 ¤byte
    hdrs_size : i64 ¤byte

// The program itself, hashed: the code, what it reads, what it writes,
// and where it starts, plus which machine and how wide its words are.
// Not the file -- the bill of materials, the symbol names and the
// section headers are things said *about* the program, and two builds
// that differ only in what they say about themselves are one program.
fn image_digest(tgt : Target, code : u8[], rodata : u8[], data : u8[],
                entry : i64 ¤byte) → str:
    // The three segments go straight into the digest.  Copying them
    // into one array first said the same thing and asked for a second
    // copy of the whole image to say it.
    let h : mut = std.hash.sha256.start()
    h.update(code)
    h.update(rodata)
    h.update(data)
    let tail : mut u8[] = []
    push64(&tail, @dropunit(entry))
    push32(&tail, tgt.machine.ord())
    push32(&tail, if tgt.is64: 2 else: 1)
    push32(&tail, tgt.eflags)
    h.update(tail)
    hex_digest(h.digest())

// text_room and ro_room are how much of the address space those two
// regions are given, which is what they hold unless a build means to
// leave room to grow into.  Under --incremental a first build reserves
// more than it uses and a later one reserves exactly what the file it
// is written over reserved, so that .rodata and .data stay at the
// addresses the code already names.
@pre(#code > 0 and stack_size > 0)
@pre(relro_size >= 0)
@pre(text_room >= #code and ro_room >= #rodata)
fn plan_elf(tgt : Target, code : u8[], rodata : u8[], data : u8[],
            stack_size : i64 ¤byte, relro_size : i64 ¤byte,
            syms : Sym[], bom : SbomRow[],
            text_room : i64 ¤byte, ro_room : i64 ¤byte) → ElfPlan:
    // how wide this class's own bookkeeping is
    let ehsize : i64 ¤byte = if tgt.is64: @sizeof(Elf64_Ehdr) else: @sizeof(Elf32_Ehdr)
    let phent : i64 ¤byte = if tgt.is64: @sizeof(Elf64_Phdr) else: @sizeof(Elf32_Phdr)
    let shent : i64 ¤byte = if tgt.is64: @sizeof(Elf64_Shdr) else: @sizeof(Elf32_Shdr)
    let syment : i64 ¤byte = if tgt.is64: @sizeof(Elf64_Sym) else: @sizeof(Elf32_Sym)
    let page : i64 ¤byte = PAGE
    let image : i64 ¤byte = IMAGE_BASE
    let text_off : i64 ¤byte = PAGE
    let text_vaddr : i64 ¤byte = image + text_off
    let text_size : i64 ¤byte = #code
    let ro_off : i64 ¤byte = align_up_b(text_off + text_room, page)
    let ro_vaddr : i64 ¤byte = image + ro_off
    let ro_size : i64 ¤byte = #rodata
    let d_off : i64 ¤byte = align_up_b(ro_off + ro_room, page)
    let d_vaddr : i64 ¤byte = image + d_off
    let d_size : i64 ¤byte = #data

    // The bill of materials sits in its own read-only segment after the
    // writable one: loaded, so a program can read its own, and last of
    // what is loaded, so nothing mapped follows it.  The program's own
    // digest is taken here, where the entry point is known, and covers
    // the program rather than the file -- the code, what it reads, what
    // it writes, and where it starts.  Not the bill itself, which would
    // be a hash of its own hash; and not the name it was written under,
    // since the same program deployed twice is one program.
    // No bill asked for, no sections: a file built without one is what
    // it was before there were any.
    let rows : mut SbomRow[] = []
    if #bom > 0:
        foreach r := bom:
            rows.push(r)
        rows.push(SbomRow{kind: Sbomkind.output, name: "",
                          hash: image_digest(tgt, code, rodata, data, text_vaddr)})
    let sbomstr : mut u8[] = []
    if #rows > 0:
        // a string table begins with the empty string, so that offset
        // zero names nothing; with no bill there is no table at all
        sbomstr.push(0)
    let sbom : mut Sbom_Entry[] = []
    foreach r := rows:
        let nat : i64 ¤byte = #sbomstr
        foreach b := std.bytes(r.name):
            sbomstr.push(b)
        sbomstr.push(0)
        let hat : i64 ¤byte = #sbomstr
        foreach b := std.bytes(r.hash):
            sbomstr.push(b)
        sbomstr.push(0)
        sbom.push(Sbom_Entry{kind: r.kind, name: nat, hash: hat})
    let sbent : i64 ¤byte = @sizeof(Sbom_Entry)
    let bom_off : i64 ¤byte = if #rows > 0: align_up_b(d_off + d_size, page) else: d_off + d_size
    let bom_vaddr : i64 ¤byte = image + bom_off
    let bom_size : i64 ¤byte = sbent × @dropunit(#sbom)
    let bstr_off : i64 ¤byte = bom_off + bom_size
    let bstr_size : i64 ¤byte = #sbomstr
    let bom_seg : i64 ¤byte = bom_size + bstr_size

    // A symbol table names the locals first and the globals after, and
    // says in the section's own header where the first global sits;
    // readers rely on that, so the two runs are built separately.
    let strtab : mut u8[] = []
    strtab.push(0)
    let symtab : mut Elf64_Sym[] = []
    // the first symbol is the absent one, all zeroes
    symtab.push(Elf64_Sym{st_name: 0,
                          st_info: sym_info(Stb.local, Stt.notype),
                          st_other: Stv.default, st_shndx: SHN_UNDEF,
                          st_value: 0, st_size: 0})
    let nlocal : mut i64 ¤"symndx" = 0
    foreach want := 0…2:
        foreach sy := syms:
            if (if sy.is_global: 1 else: 0) = want:
                let bind : Stb = if sy.is_global: Stb.global else: Stb.local
                symtab.push(Elf64_Sym{st_name: #strtab,
                                      st_info: sym_info(bind, Stt.func),
                                      st_other: Stv.default,
                                      st_shndx: SHN_TEXT,
                                      st_value: text_vaddr + sy.value,
                                      st_size: sy.size})
                foreach b := std.bytes(sy.name):
                    strtab.push(b)
                strtab.push(0)
                if want = 0:
                    nlocal ← nlocal + 1

    let shstr : mut u8[] = []
    shstr.push(0)
    let shname : mut i64 ¤byte[] = []
    // The bill's two sections are named only when there is one, so a
    // file built without it is what it was before there were any.
    let names : mut str[] = [".text", ".rodata", ".data"]
    if #rows > 0:
        names.push(".sbom")
        names.push(".sbomstr")
    names.push(".symtab")
    names.push(".strtab")
    names.push(".shstrtab")
    foreach nm := names:
        shname.push(#shstr)
        foreach b := std.bytes(nm):
            shstr.push(b)
        shstr.push(0)
    // where the ones that are always there sit in that list
    let n_sym : i64 ¤ptrdiff = if #rows > 0: 5 else: 3
    let n_str : i64 ¤ptrdiff = n_sym + 1
    let n_shs : i64 ¤ptrdiff = n_sym + 2
    // which section header the symbol table's names are in: the null
    // one, the three that are always loaded, the bill's two when there
    // is one, then the symbols and their strings
    let strtab_ndx : i64 ¤"shndx" = if #rows > 0: 7 else: 5

    // Past the last thing the kernel loads: the symbol table, the
    // strings its names live in, and the section headers that say
    // where all of it is.  None of this is in a segment, so none of it
    // is mapped -- it is there for whoever reads the file.  Every
    // offset is settled here, before anything is written, which is why
    // nothing has to be patched afterwards.
    let nsym : i64 ¤"symndx" = @dropunit(#symtab)
    let word : i64 ¤byte = 8
    let sym_off : i64 ¤byte = align_up_b(bstr_off + bstr_size, word)
    let sym_size : i64 ¤byte = syment × @dropunit(nsym)
    let str_off : i64 ¤byte = sym_off + sym_size
    let shstr_off : i64 ¤byte = str_off + #strtab
    let sh_off : i64 ¤byte = align_up_b(shstr_off + #shstr, word)
    assert((sh_off % word ?? word) = 0, "the section headers are aligned")

    let phdrs : mut Elf64_Phdr[] = []
    // the headers themselves, mapped read-only: the kernel points
    // AT_PHDR at them, and a program that means to follow its own
    // program headers has to be able to read them
    phdrs.push(phdr(Pt.load, Pf.r, 0, image, page, page, page))
    phdrs.push(phdr(Pt.load, Pf.r | Pf.x, text_off, text_vaddr,
                    text_size, text_size, page))
    phdrs.push(phdr(Pt.load, Pf.r, ro_off, ro_vaddr, ro_size, ro_size, page))
    phdrs.push(phdr(Pt.load, Pf.r | Pf.w, d_off, d_vaddr, d_size, d_size, page))
    if #rows > 0:
        phdrs.push(phdr(Pt.load, Pf.r, bom_off, bom_vaddr, bom_seg, bom_seg, page))
    // PT_GNU_RELRO: the head of the writable segment, which holds what
    // is written before @start and never after.  A dynamic loader would
    // seal it; nothing loads a static program but itself, so the
    // program seals it, following this entry as any loader would.
    phdrs.push(phdr(Pt.gnu_relro, Pf.r, d_off, d_vaddr,
                    relro_size, relro_size, 1))
    // PT_GNU_STACK: read and write, and pointedly not execute.  Absent,
    // the kernel falls back to an executable stack; present, it says
    // what this program wants, and its size says how much.
    let sixteen : i64 ¤byte = 16
    phdrs.push(phdr(Pt.gnu_stack, Pf.r | Pf.w, 0, 0, 0, stack_size, sixteen))

    let nph : i64 ¤"phndx" = @dropunit(#phdrs)
    let hdrs_size : i64 ¤byte = ehsize + phent × @dropunit(nph)
    assert(hdrs_size <= text_off, "the headers fit the page before the text")

    let shdrs : mut Elf64_Shdr[] = []
    // section headers: the absent one, then what the file holds
    shdrs.push(shdr(0, Sht.null, Shf.nil, 0, 0, 0, 0, 0, 0, 0))
    shdrs.push(shdr(shname[0], Sht.progbits, Shf.alloc | Shf.execinstr,
                    text_vaddr, text_off, text_size, 0, 0, 16, 0))
    shdrs.push(shdr(shname[1], Sht.progbits, Shf.alloc,
                    ro_vaddr, ro_off, ro_size, 0, 0, 8, 0))
    shdrs.push(shdr(shname[2], Sht.progbits, Shf.write | Shf.alloc,
                    d_vaddr, d_off, d_size, 0, 0, 8, 0))
    if #rows > 0:
        shdrs.push(shdr(shname[3¤ptrdiff], Sht.progbits, Shf.alloc,
                        bom_vaddr, bom_off, bom_size, 0, 0, 4, sbent))
        shdrs.push(shdr(shname[4¤ptrdiff], Sht.strtab, Shf.alloc,
                        bom_vaddr + bom_size, bstr_off, bstr_size, 0, 0, 1, 0))
    shdrs.push(shdr(shname[n_sym], Sht.symtab, Shf.nil, 0, sym_off, sym_size,
                    strtab_ndx, nlocal + 1, 8, syment))
    shdrs.push(shdr(shname[n_str], Sht.strtab, Shf.nil, 0, str_off,
                    #strtab, 0, 0, 1, 0))
    shdrs.push(shdr(shname[n_shs], Sht.strtab, Shf.nil, 0, shstr_off,
                    #shstr, 0, 0, 1, 0))
    let nsh : i64 ¤"shndx" = @dropunit(#shdrs)

    let cls : Elfclass = if tgt.is64: Elfclass.class64 else: Elfclass.class32
    let ehdr : Elf64_Ehdr = (Elf64_Ehdr{
        e_ident: elf_ident(cls, Elfdata.lsb, Elfosabi.sysv),
        e_type: Et.exec, e_machine: tgt.machine,
        e_version: Ev.current, e_entry: text_vaddr,
        e_phoff: ehsize, e_shoff: sh_off,
        e_flags: tgt.eflags, e_ehsize: ehsize,
        e_phentsize: phent, e_phnum: nph,
        e_shentsize: shent, e_shnum: nsh,
        e_shstrndx: nsh - 1})

    (ElfPlan{ehdr: ehdr, phdrs: phdrs, shdrs: shdrs, syms: symtab,
             strtab: strtab, shstr: shstr,
             sbom: sbom, sbomstr: sbomstr,
             text_off: text_off, text_size: text_size,
             ro_off: ro_off, ro_size: ro_size,
             d_off: d_off, d_size: d_size,
             bom_off: bom_off, bom_size: bom_size, bstr_size: bstr_size,
             sym_off: sym_off, shstr_off: shstr_off,
             sh_off: sh_off, hdrs_size: hdrs_size})

// a 64-bit file is the plan with the gaps put in: nothing is copied
// and nothing converted, which is what building the wide forms up
// front buys
fn elf_file64(pl : ElfPlan, code : u8[], rodata : u8[], data : u8[]) → Elf:
    (Elf{ehdr: pl.ehdr, phdrs: pl.phdrs,
        gap_text: zeros(pl.text_off - pl.hdrs_size), code: code,
        gap_ro: zeros(pl.ro_off - (pl.text_off + pl.text_size)), rodata: rodata,
        gap_data: zeros(pl.d_off - (pl.ro_off + pl.ro_size)), data: data,
        gap_sbom: zeros(pl.bom_off - (pl.d_off + pl.d_size)),
        sbom: pl.sbom, sbomstr: pl.sbomstr,
        gap_syms: zeros(pl.sym_off - (pl.bom_off + pl.bom_size + pl.bstr_size)),
        syms: pl.syms,
        strtab: pl.strtab, shstrtab: pl.shstr,
        gap_shdrs: zeros(pl.sh_off - (pl.shstr_off + #pl.shstr)),
        shdrs: pl.shdrs})

// …and a 32-bit file narrows copies of the same structures, with the
// two reorderings the specification asks for written where the fields
// are named
fn elf_file32(pl : ElfPlan, code : u8[], rodata : u8[], data : u8[]) → Elf32:
    let phdrs : mut Elf32_Phdr[] = []
    foreach p := pl.phdrs:
        phdrs.push(Elf32_Phdr{p_type: p.p_type, p_offset: p.p_offset,
                              p_vaddr: p.p_vaddr, p_paddr: p.p_paddr,
                              p_filesz: p.p_filesz, p_memsz: p.p_memsz,
                              p_flags: p.p_flags, p_align: p.p_align})
    let shdrs : mut Elf32_Shdr[] = []
    foreach h := pl.shdrs:
        shdrs.push(Elf32_Shdr{sh_name: h.sh_name, sh_type: h.sh_type,
                              sh_flags: h.sh_flags.ord(), sh_addr: h.sh_addr,
                              sh_offset: h.sh_offset, sh_size: h.sh_size,
                              sh_link: h.sh_link, sh_info: h.sh_info,
                              sh_addralign: h.sh_addralign,
                              sh_entsize: h.sh_entsize})
    let symtab : mut Elf32_Sym[] = []
    foreach sy := pl.syms:
        symtab.push(Elf32_Sym{st_name: sy.st_name, st_value: sy.st_value,
                              st_size: sy.st_size, st_info: sy.st_info,
                              st_other: sy.st_other, st_shndx: sy.st_shndx})
    let e := pl.ehdr
    let ehdr : Elf32_Ehdr = (Elf32_Ehdr{
        e_ident: e.e_ident,
        e_type: e.e_type, e_machine: e.e_machine,
        e_version: e.e_version, e_entry: e.e_entry,
        e_phoff: e.e_phoff, e_shoff: e.e_shoff,
        e_flags: e.e_flags, e_ehsize: e.e_ehsize,
        e_phentsize: e.e_phentsize, e_phnum: e.e_phnum,
        e_shentsize: e.e_shentsize, e_shnum: e.e_shnum,
        e_shstrndx: e.e_shstrndx})
    (Elf32{ehdr: ehdr, phdrs: phdrs,
        gap_text: zeros(pl.text_off - pl.hdrs_size), code: code,
        gap_ro: zeros(pl.ro_off - (pl.text_off + pl.text_size)), rodata: rodata,
        gap_data: zeros(pl.d_off - (pl.ro_off + pl.ro_size)), data: data,
        // the bill of materials is the same twelve bytes a row in both
        // classes: an offset into a string table is no wider on a
        // 64-bit machine, so there is nothing here to narrow
        gap_sbom: zeros(pl.bom_off - (pl.d_off + pl.d_size)),
        sbom: pl.sbom, sbomstr: pl.sbomstr,
        gap_syms: zeros(pl.sym_off - (pl.bom_off + pl.bom_size + pl.bstr_size)),
        syms: symtab,
        strtab: pl.strtab, shstrtab: pl.shstr,
        gap_shdrs: zeros(pl.sh_off - (pl.shstr_off + #pl.shstr)),
        shdrs: shdrs})

