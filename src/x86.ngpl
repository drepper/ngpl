    em.b3(72, 199, 194)
    em.w32(255)                     // mov rdx, 255
    em.b3(76, 137, 249)             // mov rcx, r15
    em.b3(72, 211, 234)             // shr rdx, cl
    em.b3(72, 199, 193)
    em.w32(63)                      // mov rcx, 63
    em.b3(77, 133, 210)             // test r10, r10
    em.b4(72, 15, 69, 209)          // cmovnz rdx, rcx
    em.b3(72, 33, 208)              // and rax, rdx
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.b3(77, 133, 210)             // test r10, r10
    em.b4(76, 15, 68, 202)          // cmovz r9, rdx
    em.b3(72, 49, 201)              // xor rcx, rcx
    em.b3(72, 199, 194)
    em.w32(6)                       // mov rdx, 6
    em.b3(77, 133, 210)             // test r10, r10
    em.b4(72, 15, 69, 202)          // cmovnz rcx, rdx
    em.b3(73, 211, 225)             // shl r9, cl
    em.b3(73, 9, 193)               // or r9, rax
    em.b4(74, 139, 4, 255)          // mov rax, [rdi+r15*8]
    em.b3(76, 137, 209)             // mov rcx, r10
    em.b3(72, 211, 232)             // shr rax, cl
    em.b4(72, 131, 224, 63)         // and rax, 63
    em.b3(73, 137, 194)             // mov r10, rax
    em.b3(77, 133, 210)             // test r10, r10
    em.jlocal(133, 0)               // jnz Lstep
    em.b3(76, 137, 200)             // mov rax, r9
    em.b3(72, 137, 242)             // mov rdx, rsi
    em.b1(195)
    em.resolve_locals()

// the runtime's own routines, in the order their ids run, so a symbol
// table can name the code they occupy
fn rt_names() → str[]:
    [
    "RT_PRINTI",
    "RT_WRITE1",
    "RT_ABORT",
    "RT_OV",
    "RT_SHIFT",
    "RT_BOUNDS",
