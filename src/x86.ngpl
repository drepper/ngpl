    em.b2(60, 224)                  // cmp al, 0xE0
    em.b4(65, 15, 147, 192)         // setae r8b
    em.b3(77, 1, 193)               // add r9, r8
    em.b2(60, 240)                  // cmp al, 0xF0
    em.b4(65, 15, 147, 192)         // setae r8b
