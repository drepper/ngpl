                self.check_expr(rlo, TY_UNIT)
                self.check_expr(rhi, TY_UNIT)
                self.check_expr(clo, TY_UNIT)
                self.set_type(id, mk_aty(TY_I64))
                return
            self.check_index_expr(tok, mt9, rlo)
            self.check_index_expr(tok, mt9, rhi)
            let rowty : i64 = mk_aty(self.mat_elem(mt9))
            self.check_index_expr(tok, rowty, clo)
