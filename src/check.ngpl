    // Which function a call reaches, where that is knowable, and ⁻1
    // otherwise.  A method call carries the index it resolved to; a
    // plain one is found by the name it was written with.
    fn call_target(&self, na : i64) → i64:
        let k : i64 = self.kind_of(na)
        if k = NK_MCALL:
            let mid : i64 = self.a.nc[na × 1¤ptrdiff]
            if mid >= 1000:
                return ((mid - 1000) ÷ 2) ?? 0
            return ⁻1
        if k = NK_CALL:
            return self.fn_index_here(self.text(self.a.ntok[na × 1¤ptrdiff]))
        ⁻1

    // What to say about a statement whose value nothing reads.
    //
    // A partial application is refused outright, whichever way it is
    // dropped: it binds arguments and does nothing else -- currying is
    // offered only for a pure function -- so a line that drops one has
    // done nothing at all, and that is a mistake rather than a choice.
    //
    // A call that answers something is refused too, unless the
    // definition carries @ignorable and has said its answer may go
    // unread.  The interpreter has refused both since before this did,
    // and a program it will not run is not one to compile.
    fn unused_value(&mut self, tok : i64, na : i64, quiet : bool):
        // a curried call: the checker marked the site when it made one
        if self.kind_of(na) = NK_CALL and self.a.nc[na × 1¤ptrdiff] = 3:
            self.derrc(tok, 2293, """the partial application here is not used; it binds arguments
                                   " and does nothing else, so dropping it leaves nothing behind""")
            return
        // quiet says the value was dropped on purpose with '_ ← …', or
        // stands last in a body that hands nothing back
        if quiet:
            return
        let f : i64 = self.call_target(na)
        if f ≠ ⁻1:
            if self.a.fns[f × 1¤ptrdiff].is_ignorable:
                return
            self.derrc(tok, 2290, "the result of '" ⧺ self.a.fns[f × 1¤ptrdiff].name ⧺ "' is not used; a function that hands back a value is called for it, so write '_ ← …' where the value is meant to be dropped, name a return type where it was meant to be handed back, or mark it @ignorable")
            return
        self.derrc(tok, 2291, """the value of this statement is not used; it computes something and
                               " nothing reads it, so write '_ ← …' where the value is meant to be
                               " dropped, or name a return type where it was meant to be handed back""")

    fn check_foreach(&mut self, id : i64, tok : i64, na : i64, body : i64):
        let lo : i64 = self.a.extra[na × 1¤ptrdiff]
        let step : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi : i64 = self.a.extra[(na + 2) × 1¤ptrdiff]
        self.check_expr(lo, TY_UNIT)
        self.check_expr(hi, self.ty_of(lo))
        if step ≠ ⁻1:
            self.check_expr(step, self.ty_of(lo))
        // the variable's type is what the bounds agree on
        let tl : i64 = self.ty_of(lo)
        let th : i64 = self.ty_of(hi)
        let vt : mut i64 = TY_I64
        if tl ≠ TY_UNT:
            vt ← tl
        elif th ≠ TY_UNT:
            vt ← th
        elif step ≠ ⁻1 and self.ty_of(step) ≠ TY_UNT:
            vt ← self.ty_of(step)
        if not ty_is_int(vt):
            self.derr(tok, "a range walks numbers; this is " ⧺ self.tn(vt))
            vt ← TY_I64
        self.adopt(lo, vt)
        self.adopt(hi, vt)
        if self.ty_of(lo) ≠ vt or self.ty_of(hi) ≠ vt:
            self.derr(tok, "the range's ends say one type between them")
        if step ≠ ⁻1:
            self.adopt(step, vt)
            if self.ty_of(step) ≠ vt:
                self.derr(tok, "the step follows the range's type")
        self.push_scope()
        let slot : i64 = self.declare(tok, vt, 0)
        self.nslot[id × 1¤ptrdiff] ← slot
        self.loop_depth ← self.loop_depth + 1
        self.check_block(body, false)
        self.loop_depth ← self.loop_depth - 1
        self.pop_scope()

    // ------------------------------------------------------------------
    // Whether execution can only leave this statement by returning
    // ------------------------------------------------------------------

    fn always_returns(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        if k = NK_RETURN:
            return true
        if k = NK_EXPRSTMT:
            let e : i64 = self.a.na[id × 1¤ptrdiff]
            let ek : i64 = self.kind_of(e)
            if ek = NK_SCALL and self.a.na[e × 1¤ptrdiff] = SB_EXIT:
                return true
            if ek = NK_CALL:
                let nm := self.text(self.a.ntok[e × 1¤ptrdiff])
                if nm = "assert" and self.asserts_false(e):
                    // `assert(false, …)` is a statement that the place
                    // cannot be reached, and it stops the program if it
                    // ever is; either way nothing goes on from here
                    return true
                let f : i64 = self.fn_index(nm)
                if f ≠ ⁻1:
                    return self.a.fns[f × 1¤ptrdiff].is_noreturn
            return false
        if k = NK_IF:
            let nc : i64 = self.a.nc[id × 1¤ptrdiff]
            if nc = ⁻1:
                return false
            return self.block_leaves(self.a.nb[id × 1¤ptrdiff]) and self.block_leaves(nc)
        if k = NK_MATCH:
            let nb : i64 = self.a.nb[id × 1¤ptrdiff]
            return self.block_leaves(self.a.extra[nb × 1¤ptrdiff]) and self.block_leaves(self.a.extra[(nb + 1) × 1¤ptrdiff])
        if k = NK_MATCHE:
            // every value has an arm, so the arms are every way out:
            // if each of them leaves, so does the match
            let mb : i64 = self.a.nb[id × 1¤ptrdiff]
            let mn : i64 = self.a.extra[mb × 1¤ptrdiff]
            let md : i64 = self.a.extra[(mb + 1) × 1¤ptrdiff]
            if md ≠ ⁻1 and not self.block_leaves(md):
                return false
            foreach mi := 0…mn:
                if not self.block_leaves(self.a.extra[(mb + 4 + mi × 3) × 1¤ptrdiff]):
                    return false
            return true
        if k = NK_BLOCK:
            return self.block_leaves(id)
        if k = NK_WHILE:
            return self.loop_forever(id)
        false

    // Whether a block leaves for good rather than falling off its end.
    // Any statement that never passes control on is enough: what
    // follows it is unreachable, which is worth saying elsewhere but
    // is not a way back to the caller.
    fn block_leaves(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            if self.always_returns(self.a.extra[(off + 1 + i) × 1¤ptrdiff]):
                return true
        false

    fn asserts_false(&self, e : i64) → bool:
        let ao : i64 = self.a.na[e × 1¤ptrdiff]
        if self.a.extra[ao × 1¤ptrdiff] < 1:
            return false
        let a0 : i64 = self.a.extra[(ao + 1) × 1¤ptrdiff]
        self.kind_of(a0) = NK_BOOL and self.a.na[a0 × 1¤ptrdiff] = 0

    // A loop whose test never fails and which is never left runs on
    // for ever, so nothing after it is reached.  A break belongs to
    // the innermost loop around it -- core-2 has no break that names
    // an outer one -- so a break written inside a loop nested here
    // leaves that one and not this.
    fn loop_forever(&self, id : i64) → bool:
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        if self.kind_of(na) ≠ NK_BOOL or self.a.na[na × 1¤ptrdiff] = 0:
            return false
        not self.block_breaks(self.a.nb[id × 1¤ptrdiff])

    fn block_breaks(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            if self.stmt_breaks(self.a.extra[(off + 1 + i) × 1¤ptrdiff]):
                return true
        false

    fn stmt_breaks(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        if k = NK_BREAK:
            return true
        if k = NK_WHILE or k = NK_WHILEB or k = NK_FOREACH or k = NK_FOREACHA:
            // its breaks are its own
            return false
        if k = NK_HINTED:
            return self.stmt_breaks(self.a.na[id × 1¤ptrdiff])
        if k = NK_BLOCK:
            return self.block_breaks(id)
        if k = NK_IF:
            let nc : i64 = self.a.nc[id × 1¤ptrdiff]
            if self.block_breaks(self.a.nb[id × 1¤ptrdiff]):
                return true
            if nc = ⁻1:
                return false
            return self.block_breaks(nc)
        if k = NK_MATCH:
            let nb : i64 = self.a.nb[id × 1¤ptrdiff]
            return self.block_breaks(self.a.extra[nb × 1¤ptrdiff]) or self.block_breaks(self.a.extra[(nb + 1) × 1¤ptrdiff])
        if k = NK_MATCHE:
            let mb : i64 = self.a.nb[id × 1¤ptrdiff]
            let mn : i64 = self.a.extra[mb × 1¤ptrdiff]
            let md : i64 = self.a.extra[(mb + 1) × 1¤ptrdiff]
            if md ≠ ⁻1 and self.block_breaks(md):
                return true
            foreach mi := 0…mn:
                if self.block_breaks(self.a.extra[(mb + 4 + mi × 3) × 1¤ptrdiff]):
                    return true
            return false
        false

    // whether a block's last statement hands a value on or returns
    // Whether a statement standing last in a block is that block's
    // value.  An expression is; a match is, each arm answering; and an
    // if is where it has an else and both sides answer, which is the
    // same question asked one level down and is why the two call each
    // other.  An elif chain is a block holding one if, so a chain is
    // read by the same two steps as far as it goes.
    fn stmt_is_value(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        if k = NK_EXPRSTMT or k = NK_MATCH or k = NK_MATCHE:
            // Every value of the enumeration has an arm -- that is
            // checked where the match is -- so if each arm answers,
            // the match answers on every path.
            return true
        if k ≠ NK_IF:
            return false
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if nc = ⁻1:
            // With no else it falls past its branch, and ∅ is what it
            // answers there, so it does answer on every path -- but
            // only where the branch arrives with something for the ⊨
            // side to hold.  A branch that returns instead leaves the
            // fall-through with nothing, which is the old mistake and
            // still one.
            return self.block_arrives(self.a.nb[id × 1¤ptrdiff])
        self.block_yields(self.a.nb[id × 1¤ptrdiff]) and self.block_yields(nc)

    // Whether a block ends by arriving with a value rather than by
    // leaving: an expression, a match, an if that is one -- and not a
    // return, which hands its value straight to the caller.
    fn block_arrives(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
        self.stmt_is_value(last) and not self.always_returns(last)

    // What the body under check answers: a lambda's stated type where
    // one is being checked, and the function's otherwise.
    fn answer_ty(&self) → i64:
        if self.lam_ret ≠ ⁻1:
            return self.lam_ret
        self.a.fns[self.cur_fn × 1¤ptrdiff].ret

    // The one expression a block is, where it is exactly one and
    // nothing else; ⁻1 where the block does more than answer.
    fn block_value_node(&self, blk : i64) → i64:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        if self.a.extra[off × 1¤ptrdiff] ≠ 1:
            return ⁻1
        let only : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        if self.kind_of(only) ≠ NK_EXPRSTMT:
            return ⁻1
        self.a.na[only × 1¤ptrdiff]

    fn block_yields(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
        self.stmt_is_value(last) or self.always_returns(last)

    fn block_returns(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        self.always_returns(self.a.extra[(off + n) × 1¤ptrdiff])

    // ------------------------------------------------------------------
    // Functions and globals
    // ------------------------------------------------------------------

    fn fn_is_generic(&self, f : i64) → bool:
        let d := self.a.fns[f × 1¤ptrdiff]
        if ty_is_var(d.ret):
            return true
        let np : i64 ¤ptrdiff = self.a.extra[d.params_off] × 1¤ptrdiff
        foreach i := 0…np:
            if ty_is_var(ty_strip_ref(self.a.extra[d.params_off + 2 + i × 2])):
                return true
        false

    fn check_fn(&mut self, f : i64):
        self.cur_fn ← f
        self.curmod ← self.a.fns[f × 1¤ptrdiff].modname
        self.pack_reset(0)
        self.nslots ← 0
        self.loop_depth ← 0
        while #self.snames > 0:
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0
            _ ← self.sheld.pop() ?? 0
        while #self.marks > 0:
            _ ← self.marks.pop() ?? 0
        while #self.hslot > 0:
            _ ← self.hslot.pop() ?? 0
            _ ← self.hback.pop() ?? 0
        while #self.hmark > 0:
            _ ← self.hmark.pop() ?? 0
        let d := self.a.fns[f × 1¤ptrdiff]
        self.push_scope()
        let np : i64 ¤ptrdiff = self.a.extra[d.params_off] × 1¤ptrdiff
        foreach i := 0…np:
            let ptok : i64 = self.a.extra[d.params_off + 1 + i × 2]
            let pty : i64 = self.a.extra[d.params_off + 2 + i × 2]
            _ ← self.declare(ptok, pty, if ty_ref_kind(pty) = 2 or ty_ref_kind(pty) = 3: 1 else: 0)
        assert(self.nslots >= @dropunit(np), "every parameter took a slot")
        if np > 12:
            self.derr(d.tok, "more than twelve parameters is not core-2 yet")
        self.in_contract ← true
        if d.pre_off ≠ ⁻1:
            let n : i64 ¤ptrdiff = self.a.extra[d.pre_off] × 1¤ptrdiff
            foreach j := 0…n:
                let c : i64 = self.a.extra[d.pre_off + 1 + j]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "@pre")
        if d.post_off ≠ ⁻1:
            let n : i64 ¤ptrdiff = self.a.extra[d.post_off] × 1¤ptrdiff
            self.push_scope()
            if n > 0:
                let rtok : i64 = self.a.extra[d.post_off + 1]
                if d.ret = TY_UNIT:
                    self.derr(rtok, "@post names a result, but the function answers nothing")
                else:
                    _ ← self.declare(rtok, d.ret, 0)
            foreach j := 0…n:
                let c : i64 = self.a.extra[d.post_off + 2 + j × 2]
                self.in_post ← true
                self.check_expr(c, TY_UNIT)
                self.in_post ← false
                self.want_truthy(c, "@post")
            self.pop_scope()
        self.in_contract ← false
        self.check_block(d.body, true)
        self.pop_scope()
        if d.ret ≠ TY_UNIT:
            let off : i64 = self.a.na[d.body × 1¤ptrdiff]
            let n : i64 = self.a.extra[off × 1¤ptrdiff]
            let last_is_value : mut bool = false
            if n > 0:
                let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
                if self.stmt_is_value(last):
                    last_is_value ← true
            if not last_is_value and not self.block_returns(d.body):
                self.derr(d.tok, "'" ⧺ d.name ⧺ "' answers " ⧺ self.tn(d.ret) ⧺ " but not on every path")
        if d.is_noreturn and not self.block_leaves(d.body):
            // @noreturn says the caller is never reached again, and
            // falling off the end of a body is a way back to it like
            // any other -- the one the annotation is most often wrong
            // about, a body leaving on every path it thought of still
            // coming back on the one it did not.
            self.derr(d.tok, "'" ⧺ d.name ⧺ """' is @noreturn, so it does not come back, but this
                                             " body can fall off its end and come back""")
        self.fslots[f × 1¤ptrdiff] ← self.nslots
        // the bindings whose every read was somewhere a packed array
        // serves are told how many they hold, and become the elements
        self.pack_settle()
        self.fdone[f × 1¤ptrdiff] ← 1

    fn check_global(&mut self, g : i64):
        let gd := self.a.globals[g × 1¤ptrdiff]
        if gd.ty = ⁻1:
            // := at the top level: the right side says the type
            self.check_expr(gd.init, TY_UNIT)
            if self.ty_of(gd.init) = TY_UNT:
                self.adopt(gd.init, TY_I64)
            let it : i64 = self.ty_of(gd.init)
            self.a.globals[g × 1¤ptrdiff].ty ← it
            if ty_is_lam(it):
                // the box is built by init code before @start runs
                if gd.is_mut:
                    self.derr(gd.tok, "a global function value is immutable")
                self.gvals.push(0)
                self.ginit.push(g)
                return
            let ik0 : i64 = self.kind_of(gd.init)
            if (ty_is_int(it) or it = TY_BOOL) and (ik0 = NK_INT or ik0 = NK_BOOL):
                self.gvals.push(self.a.na[gd.init × 1¤ptrdiff])
                return
            self.derr(gd.tok, "a global begins at a constant the compiler can see")
            self.gvals.push(0)
            return
        if ty_is_hash(gd.ty):
            // an immutable dictionary global: its literal of constants is
            // built by init code before the start function runs
            if gd.is_mut:
                self.derr(gd.tok, """a global dictionary is immutable; build a mut one where it is
                                   " used""")
            if self.kind_of(gd.init) ≠ NK_HLIT:
                self.derr(gd.tok, "a global dictionary is born from its literal")
                self.gvals.push(0)
                return
            self.check_expr(gd.init, gd.ty)
            let hoff : i64 = self.a.na[gd.init × 1¤ptrdiff]
            let hn : i64 = self.a.extra[hoff × 1¤ptrdiff]
            foreach hi := 0…hn:
                let ke : i64 = self.a.extra[(hoff + 1 + hi × 2) × 1¤ptrdiff]
                let ve : i64 = self.a.extra[(hoff + 2 + hi × 2) × 1¤ptrdiff]
                if self.kind_of(ke) ≠ NK_INT and self.kind_of(ke) ≠ NK_STR:
                    self.derr(gd.tok, "a global dictionary holds constants the compiler can see")
                if self.kind_of(ve) ≠ NK_INT and self.kind_of(ve) ≠ NK_STR and self.kind_of(ve) ≠ NK_BOOL:
                    self.derr(gd.tok, "a global dictionary holds constants the compiler can see")
            self.gvals.push(0)
            self.ginit.push(g)
            return
        if ty_is_arr(gd.ty) or gd.ty = TY_STR or ty_is_tup(gd.ty):
            self.derr(gd.tok, """a core-2 global is a number, a truth value or a dictionary of
                               " constants""")
            self.gvals.push(0)
            return
        // fold the initializer to the constant the image carries
        self.check_expr(gd.init, gd.ty)
        if self.ty_of(gd.init) = TY_UNT:
            self.adopt(gd.init, gd.ty)
        elif self.ty_of(gd.init) ≠ gd.ty:
            self.derr(gd.tok, "the binding says " ⧺ self.tn(gd.ty) ⧺ " but the value is " ⧺ self.tn(self.ty_of(gd.init)))
        let ik : i64 = self.kind_of(gd.init)
        if ik = NK_INT or ik = NK_BOOL:
            self.gvals.push(self.a.na[gd.init × 1¤ptrdiff])
        else:
            self.derr(gd.tok, "a global begins at a constant the compiler can see")
            self.gvals.push(0)

// The numbers this compiler draws.  An @expect naming one of these
// says something this compiler is answerable for; an @expect naming
// any other number is one the interpreter draws and this compiler does
// not -- at run time, mostly, where a compiler is not looking -- and
// is passed over rather than failed.  Keep this in step with the
// derrc/dwarn calls; tests/compile/run_compile_tests.sh checks it.
fn diag_codes() → i64[]:
    [2024, 2025, 2026, 2111, 2229, 2245, 2253, 2254, 2256,
     2290, 2291, 2293,
     2400, 2401, 2402, 2403, 2404, 2421, 2619, 2728, 2729, 2741, 2910, 2911]

fn draws_code(code : i64) → bool:
    foreach c := diag_codes():
        if c = code:
            return true
    false

// Hold each @expect definition to what it said.
//
// The check is by number: where an expectation names a number this
// compiler draws -- diag_codes() says which -- that number must appear
// among what the definition drew.  This is what holds the two
// implementations to the same warnings.  A warning the interpreter
// makes and this compiler quietly dropped fails here, by number,
// without anyone having to read a message, and the wording of the two
// need not agree at all.
//
// Two things are deliberately *not* checked.
//
// A definition may draw more than it was asked about, and none of it
// is reported.  The definition is deliberately wrong, so every further
// complaint about it is noise, and a compiler is allowed to be
// stricter than the interpreter -- that direction is the permitted
// one.
//
// And a definition that draws nothing at all is not failed.  It would
// be the check worth having, since a program the interpreter refuses
// must not compile, but a compiler cannot tell a diagnostic it is
// missing from one the interpreter only finds by running: `v[3]` on an
// array of three is refused by the interpreter and is not something
// this compiler looks for.  The coverage is therefore exactly
// diag_codes(), and it grows as numbers are assigned.
//
// No code is written for any of them.  They are put on the schedule to
// be checked and taken off again, so what the emission sees is what it
// always saw.
fn check_expectations(c : &mut Checker, a : Ast):
    if #a.expects = 0:
        return
    foreach i := 0…#a.expects:
        let n_fns : i64 ¤ptrdiff = #c.a.fns
        let n_slots : i64 ¤ptrdiff = #c.fslots
        let n_lams : i64 ¤ptrdiff = #c.lams
        let n_psfn : i64 ¤ptrdiff = #c.psfn
        let n_diags : i64 ¤ptrdiff = #c.diags
        c.a.fns.push(a.expects[i])
        c.fslots.push(0)
        c.fdone.push(0)
        c.skipfn.push(0)
        c.check_fn(@dropunit(n_fns))

        // what it drew: the numbers, and whether anything refused
        let drew : mut i64[] = []
        foreach d := n_diags…#c.diags:
            drew.push(c.diags[d].code)

        // take it back off the schedule; nothing of it is written, so
        // nothing of it may be left behind
        while #c.diags > n_diags:
            _ ← c.diags.pop() ?? Diag{line: 1¤"line", col: 1¤"col", msg: "", level: DIAG_ERROR, code: DIAG_NONE}
        while #c.a.fns > n_fns:
            _ ← c.a.fns.pop() ?? a.expects[i]
        while #c.fslots > n_slots:
            _ ← c.fslots.pop() ?? 0
            _ ← c.fdone.pop() ?? 0
            _ ← c.skipfn.pop() ?? 0
        while #c.lams > n_lams:
            _ ← c.lams.pop() ?? 0
            _ ← c.lamns.pop() ?? 0
        while #c.psfn > n_psfn:
            _ ← c.psfn.pop() ?? 0
            _ ← c.psk.pop() ?? 0
            _ ← c.psnp.pop() ?? 0

        c.hold_expectation(a, @dropunit(i), drew)
    assert(#c.fslots = #c.a.fns, "the expectations left the schedule as they found it")

impl Checker:
    // The judgement on one @expect definition, given the numbers it
    // drew and whether anything it drew refuses.
    fn hold_expectation(&mut self, a : Ast, i : i64, drew : i64[]):
        let f := a.expects[i × 1¤ptrdiff]
        let off : i64 = a.expoff[i × 1¤ptrdiff]
        let want : i64 = if off ≠ ⁻1: a.extra[off × 1¤ptrdiff] else: 0
        foreach w := 0…want:
            let wc : i64 = a.extra[(off + 2 + 2 × w) × 1¤ptrdiff]
            if wc ≠ DIAG_NONE and draws_code(wc):
                let got : mut bool = false
                foreach g := drew:
                    got ← got or g = wc
                if not got:
                    self.derr(f.tok, "'" ⧺ f.name ⧺ "' says it draws " ⧺ i64_str(wc) ⧺ " and this compiler drew no such thing; the interpreter draws it, so leaving it out is a warning this implementation is missing")

fn check(a : Ast, toks : Toks, src : byte[]) → Chk:
    let fnames : mut str[] = []
    foreach f := a.fns:
        fnames.push(f.name)
    let gnames : mut str[] = []
    foreach g := a.globals:
        gnames.push(g.name)
    let nnodes : i64 ¤ptrdiff = #a.nkind
    let ntype : mut i64[] = []
    let nslot : mut i64[] = []
    let ncvt : mut i64[] = []
    let nrep : mut i64[] = []
    let nlam : mut i64[] = []
    let nhold : mut i64[] = []
    let nfree : mut i64[] = []
    foreach zi := 0¤ptrdiff…nnodes:
        ntype.push(0)
        nslot.push(⁻1)
        ncvt.push(0)
        nrep.push(⁻1)
        nlam.push(⁻1)
        nhold.push(0)
        nfree.push(0)
    let c : mut Checker = (Checker{a: a, toks: toks, src: src, fnames: fnames, curmod: "",
                                   gnames: gnames, gvals: [], ginit: [], ite: [],
                                   ntype: ntype, nslot: nslot, ncvt: ncvt,
                                   nrep: nrep, nlam: nlam, nhold: nhold, nfree: nfree,
                                   pcnt: [], puse: [], psafe: [], kuse: [], ksafe: [],
                                   pnode_slot: [], pnode_id: [],
                                   stmt_seq: 0, cur_stmt: ⁻1,
                                   lbirth: [], llast: [], luse: [],
                                   lesc: [], lwarn: [], ltok: [], log: [],
                                   lown: [], wslot: [], wreb: [],
                                   fslots: [],
                                   diags: [], snames: [], stype: [], smut: [],
                                   sslot: [], sheld: [], hslot: [], hback: [],
                                   hmark: [], marks: [], nslots: 0,
                                   loop_depth: 0, cur_fn: 0,
                                   in_contract: false, in_post: false,
                                   scope_floor: 0, lams: [], lamns: [],
                                   psfn: [], psk: [], psnp: [],
                                   fdone: [], skipfn: [], lam_ret: ⁻1,
                                   val_want: ⁻1,
                                   argcopy: []})
    if #a.structs > 0:
        foreach i := 0…#a.structs:
            let sd := a.structs[i]
            foreach j := 0…#a.structs:
                if j > i and a.structs[j].name = sd.name:
                    c.derr(a.structs[j].tok, "'" ⧺ sd.name ⧺ "' is already defined")
            let nf : i64 ¤ptrdiff = a.extra[sd.fields_off] × 1¤ptrdiff
            foreach x := 0…nf:
                foreach y := x + 1…nf:
                    let tx : i64 = a.extra[sd.fields_off + 1 + x × 2]
                    let ty0 : i64 = a.extra[sd.fields_off + 1 + y × 2]
                    if c.text(tx) = c.text(ty0):
                        c.derr(ty0, "'" ⧺ sd.name ⧺ "' names field '" ⧺ c.text(tx) ⧺ "' twice")
            // a @repr(C) struct is held to what C can represent where
            // it is written, not where its size is first asked for, so
            // the complaint points at the offending field
            if sd.is_repr_c:
                let bad : i64 = c_bad_field(a, @dropunit(i))
                if bad ≠ ⁻1:
                    let btok : i64 = a.extra[sd.fields_off + 1 + bad × 2¤ptrdiff]
                    let bty : i64 = a.extra[sd.fields_off + 2 + bad × 2¤ptrdiff]
                    c.derr(btok, "in @repr(C) struct '" ⧺ sd.name ⧺ "', field '" ⧺ c.text(btok) ⧺ "': " ⧺ c.tn(bty) ⧺ " has no defined C representation")
    let starts : mut i64 = 0
    if #a.fns > 0:
      foreach i := 0…#a.fns:
        let f := a.fns[i]
        foreach j := 0…#a.fns:
            if j > i and a.fns[j].name = f.name:
                c.derr(a.fns[j].tok, "'" ⧺ f.name ⧺ "' is already defined")
        if f.name = "assert" or f.name = "assert_eq":
            c.derr(f.tok, "'" ⧺ f.name ⧺ "' is the built-in check's name")
        if f.is_test:
            if a.extra[f.params_off] ≠ 0:
                c.derr(f.tok, "a @test function takes no parameters")
            if f.ret ≠ TY_UNIT:
                c.derr(f.tok, "a @test function answers nothing; assert is how it speaks")
            if f.is_start:
                c.derr(f.tok, "@test and @start name different duties; one function carries one")
        if f.is_start:
            starts ← starts + 1
            if a.extra[f.params_off] ≠ 0:
                c.derr(f.tok, "the @start function takes no parameters")
            if f.ret ≠ TY_UNIT and not (ty_is_int(f.ret) and ty_unit(f.ret) = 0):
                c.derr(f.tok, """the @start function answers the exit status, a plain integer, or
                               " nothing""")

    // per-function state first: a global's initializer may call, and
    // the call consults it
    if #a.fns > 0:
        foreach i := 0…#a.fns:
            c.fslots.push(0)
            c.fdone.push(0)
            c.skipfn.push(0)
    if #a.globals > 0:
        foreach i := 0…#a.globals:
            foreach j := 0…#a.globals:
                if j > i and a.globals[j].name = a.globals[i].name:
                    c.derr(a.globals[j].tok, "'" ⧺ a.globals[i].name ⧺ "' is already defined")
            c.check_global(@dropunit(i))
    let ntests : mut i64 = 0
    foreach f2 := a.fns:
        if f2.is_test:
            ntests ← ntests + 1
    // A module is a promise that something in it is worth naming from
    // outside; one that exports nothing keeps that promise to nobody,
    // and is a mistake rather than a place to put things.  What a
    // module inside it exports, it exports.
    if #a.mods > 0:
        foreach mi := 0…#a.mods:
            let mname : str = a.mods[mi]
            let seen : mut bool = false
            if #a.fns > 0:
                foreach fi := 0…#a.fns:
                    let fd := a.fns[fi]
                    if fd.is_export and mod_within(fd.modname, mname):
                        seen ← true
            if not seen:
                let mt : i64 ¤ptrdiff = a.modtok[mi]
                c.diags.push(Diag{line: toks.line[mt], col: toks.col[mt],
                                  msg: "module '" ⧺ mname ⧺ """' exports nothing, so nothing outside
                                          " it can name anything in it; mark what it is for with
                                          " @export""", level: DIAG_ERROR, code: DIAG_NONE})
    if starts = 0 and ntests = 0 and #a.igtests = 0:
        // a recipe is not a program: it says how to build one.  Someone
        // compiling a file that holds only a recipe has almost always
        // left out --build, so the refusal says so rather than leaving
        // them to work it out.
        let why : str = if #a.builds > 0: """a @build recipe says how to build a program and is not
                                           " one; --build reads it""" else: "no @start function and no @test; nothing would run"
        c.diags.push(Diag{line: 1¤"line", col: 1¤"col", msg: why, level: DIAG_ERROR, code: DIAG_NONE})
    if starts > 1:
        c.diags.push(Diag{line: 1¤"line", col: 1¤"col", msg: "more than one @start function", level: DIAG_ERROR, code: DIAG_NONE})
    if #a.structs > 0:
        foreach i := 0…#a.structs:
            c.check_invariants(@dropunit(i))
    if #a.fns > 0:
        foreach i := 0…#a.fns:
            if not c.fn_is_generic(@dropunit(i)):
                c.check_fn(@dropunit(i))
        // a generic no call reached is never shaped; a stub stands in
        foreach i := 0…#a.fns:
            if c.fdone[i] = 0:
                c.skipfn[i] ← 1
    // ------------------------------------------------------------------
    // The definitions marked @expect
    // ------------------------------------------------------------------
    //
    // Each is checked, and what it draws is held to what its @expect
    // lines said rather than reported.  A diagnostic an expectation
    // names is accounted for and goes no further; one nothing names is
    // reported, because a definition that draws something nobody asked
    // for is a definition nobody has read lately.
    //
    // An expectation that draws nothing is *not* an error here, and
    // that is the difference between a compiler and an interpreter:
    // the interpreter runs the definition and can see an index run off
    // the end, and the compiler does not run anything.  An expectation
    // this compiler cannot draw is one the interpreter will.
    //
    // No code is written for any of them.  They are appended to the
    // schedule to be checked and taken off again, so what the emission
    // sees is what it always saw.
    check_expectations(&c, a)
    if #c.diags = 0:
        assert(#c.fslots = #a.fns, "one slot count per function")
        assert(#c.gvals = #a.globals, "one folded value per global")
    (Chk{ntype: c.ntype, nslot: c.nslot, ncvt: c.ncvt, nrep: c.nrep, nlam: c.nlam, nhold: c.nhold, nfree: c.nfree, log: c.log, fslots: c.fslots,
         gvals: c.gvals, ginit: c.ginit, lams: c.lams, lamns: c.lamns,
         psfn: c.psfn, psk: c.psk, psnp: c.psnp, skipfn: c.skipfn,
         argcopy: c.argcopy,
         diags: c.diags})

