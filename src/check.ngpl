                    return
                if not self.enum_is_flag(tl):
                    self.derr(tok, "bit operations take a @flag enum; '" ⧺ self.a.enames[ty_eidx(tl) × 1¤ptrdiff] ⧺ "' counts rather than combines")
                self.set_type(id, tl)
                return
            if not (tl = TY_UNT or ty_is_int(tl) or ty_is_bigint(tl)) or not (tr = TY_UNT or ty_is_int(tr) or ty_is_bigint(tr)):
                self.derr(tok, "this operator works numbers; the sides are " ⧺ self.tn(tl) ⧺ " and " ⧺ self.tn(tr))
                self.set_type(id, TY_I64)
                return
            if tl = TY_UNT and tr = TY_UNT and self.kind_of(na) = NK_INT and self.kind_of(nb) = NK_INT and self.a.nb[na × 1¤ptrdiff] = 0 and self.a.nb[nb × 1¤ptrdiff] = 0 and k ≠ NK_SATADD and k ≠ NK_SATSUB and k ≠ NK_SATMUL:
                self.fold_bin(id, k, tok, self.a.na[na × 1¤ptrdiff],
                              self.a.na[nb × 1¤ptrdiff])
                return
            let t : i64 = self.unify_arith(tok, id, k, tl, tr)
            if (k = NK_SHL or k = NK_SHR or k = NK_BAND or k = NK_BOR or k = NK_BXOR) and t ≠ TY_UNT and ty_unit(t) ≠ 0:
                self.derr(tok, "bit operations work plain integers, not measured ones")
            if k = NK_SHL or k = NK_SHR:
                // the count is its own number; it does not widen the value
                self.set_type(id, if tl ≠ TY_UNT: tl else: t)
            else:
                self.set_type(id, t)

    // as above: the negation of a folded literal wraps rather than
    // reports, since the one value that would report is the one a
    // program is entitled to write
    fn fold_neg(&mut self, id : i64, na : i64):
        let v : i64 = self.a.na[na × 1¤ptrdiff]
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← @wrap(0 - v)
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, TY_UNT)

    // Make this operand an int: a number written down settles on one,
    // and a value of a fixed width is made into one where it stands.
    fn to_bigint(&mut self, e : i64, t : i64):
        if t = TY_UNT:
            self.adopt(e, TY_INT)
            return
        if ty_is_int(t):
            self.nhold[e × 1¤ptrdiff] ← 2
            self.set_type(e, TY_INT)
            return
        self.derr(self.a.ntok[e × 1¤ptrdiff], "an int meets numbers; this is " ⧺ self.tn(t))

    fn check_cmp_operands(&mut self, id : i64, tok : i64, k : i64, na : i64, nb : i64):
        let tl : i64 = self.ty_of(na)
        let tr : i64 = self.ty_of(nb)
        if ty_is_bigint(tl) or ty_is_bigint(tr):
            if not ty_is_bigint(tl):
                self.to_bigint(na, tl)
            if not ty_is_bigint(tr):
                self.to_bigint(nb, tr)
            self.set_type(id, TY_BOOL)
            return
        if tl = TY_UNT and tr = TY_UNT:
            if self.kind_of(na) = NK_INT and self.kind_of(nb) = NK_INT:
                self.fold_bin(id, k, tok, self.a.na[na × 1¤ptrdiff],
                              self.a.na[nb × 1¤ptrdiff])
                return
            self.derr(tok, "these two untyped numbers cannot meet here; state a type")
            self.set_type(id, TY_BOOL)
            return
        // Asking is not storing.  An untyped number takes the other
        // side's type here as it does anywhere -- except against an
        // enum, where becoming one would refuse a value the enum does
        // not hold and the question is only whether it matches.  It
        // settles on the enum's own width instead and is compared by
        // value.
        if tl = TY_UNT:
            self.adopt(na, if ty_is_enum(tr): self.a.ewidth[ty_eidx(tr) × 1¤ptrdiff] else: tr)
        elif tr = TY_UNT:
            self.adopt(nb, if ty_is_enum(tl): self.a.ewidth[ty_eidx(tl) × 1¤ptrdiff] else: tl)
        let l : i64 = self.ty_of(na)
        let r : i64 = self.ty_of(nb)
        if l = TY_CHAR and r = TY_CHAR:
            // characters order by code point; the slots hold small
            // positive numbers, so the signed compare serves
            self.set_type(id, TY_BOOL)
            return
        if ty_is_enum(l) or ty_is_enum(r):
            let e9 : i64 = if ty_is_enum(l): l else: r
            let o9 : i64 = if ty_is_enum(l): r else: l
            // asking is not storing: a number may be compared with an
            // enum and simply not match, where assigning one would
            // make a value the enum does not hold
            let numeric : bool = ty_is_int(o9) and ty_unit(o9) = 0
            if l ≠ r and not numeric:
                self.derr(tok, "an enum is asked about its own kind; the sides are " ⧺ self.tn(l) ⧺ " and " ⧺ self.tn(r))
            elif l ≠ r and self.enum_is_flag(e9):
                // a flag enum's values are combinations, which no bare
                // number names
                self.derr(tok, "a @flag enum holds combinations; a bare number names none of them")
            elif not (k = NK_EQ or k = NK_NE):
                self.derr(tok, "an enum is asked which it is; it has no order")
            self.set_type(id, TY_BOOL)
            return
        if not ty_is_int(l) or not ty_is_int(r):
            self.derr(tok, "an ordering compares numbers; the sides are " ⧺ self.tn(l) ⧺ " and " ⧺ self.tn(r))
        elif ty_sgn(l) ≠ ty_sgn(r):
            let sg2 : i64 = if ty_sgn(l) = 1: l else: r
            let un2 : i64 = if ty_sgn(l) = 1: r else: l
            if ty_bits(sg2) <= ty_bits(un2):
                self.derr(tok, "signed and unsigned do not meet; " ⧺ self.tn(l) ⧺ " and " ⧺ self.tn(r))
        elif not (self.stands_for(ty_unit(l), ty_unit(r))
                  or self.stands_for(ty_unit(r), ty_unit(l))):
            self.derr(tok, "a value measured " ⧺ self.tn(l) ⧺ " does not meet one measured " ⧺ self.tn(r))
        self.set_type(id, TY_BOOL)

    fn want_bool(&mut self, id : i64, what : str):
        if self.ty_of(id) ≠ TY_BOOL:
            self.derrc(self.a.ntok[id × 1¤ptrdiff], 2229,
                      what ⧺ " takes truth values, but this operand is " ⧺ self.tn(self.ty_of(id)) ⧺ "; a number asks its question with a comparison, as 'x ≠ 0'")

    fn want_truthy(&mut self, id : i64, what : str):
        let t : i64 = self.ty_of(id)
        if t = TY_UNT:
            self.adopt(id, TY_I64)
            return
        if ty_is_opt(t):
            // an optional in a condition asks whether a value is there
            return
        if not ty_is_int(t) and t ≠ TY_BOOL:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      what ⧺ " wants a truth value, but this is " ⧺ self.tn(t))

    // ------------------------------------------------------------------
    // A T[] that is the elements and nothing else
    // ------------------------------------------------------------------
    //
    // A binding born from a literal or a fill has a length settled
    // where it is written.  If nothing ever changes that length and the
    // value never leaves the function, the header beside the elements
    // is never read for anything, and the binding can be laid out the
    // way a T[N] is -- while staying a T[], so nothing legal on it
    // becomes illegal and the interpreter needs to know nothing of it.
    //
    // Whether it never leaves is decided by counting rather than by
    // listing what would count as leaving: every read of the name is
    // counted, and the reads in the four places a packed array can
    // serve are counted again.  Equal, and it stays; unequal, and some
    // read wanted the header.  A use nobody anticipated lands in the
    // first count and not the second, so the answer is no.

    fn pack_reset(&mut self, nslots : i64):
        while #self.pcnt > 0:
            _ ← self.pcnt.pop() ?? 0
            _ ← self.puse.pop() ?? 0
            _ ← self.psafe.pop() ?? 0
        while #self.pnode_slot > 0:
            _ ← self.pnode_slot.pop() ?? 0
            _ ← self.pnode_id.pop() ?? 0
        foreach i := 0…nslots:
            self.pcnt.push(⁻1)
            self.puse.push(0)
            self.psafe.push(0)

    fn pack_room(&mut self, s : i64):
        while #self.pcnt <= s × 1¤ptrdiff:
            self.pcnt.push(⁻1)
            self.puse.push(0)
            self.psafe.push(0)
            self.kuse.push(0)
            self.ksafe.push(0)

    // how many elements a binding is born with, or ⁻1 where that is
    // not something the text settles: a literal says so outright, and
    // `n ⍴ x` says so when n is written out
    fn born_count(&self, na : i64) → i64:
        let k : i64 = self.kind_of(na)
        if k = NK_ARRLIT:
            return self.a.extra[self.a.na[na × 1¤ptrdiff] × 1¤ptrdiff]
        if k = NK_RESHAPE:
            let cn : i64 = self.a.na[na × 1¤ptrdiff]
            if self.kind_of(cn) = NK_INT and self.a.nb[cn × 1¤ptrdiff] = 0:
                return self.a.na[cn × 1¤ptrdiff]
        ⁻1

    fn pack_note(&mut self, id : i64, s : i64, ty : i64, na : i64):
        if s < 0 or ty_is_farr(ty) or not ty_is_arr(ty):
            return
        let e : i64 = ty_elem(ty)
        if not (e = TY_BOOL or ty_is_int(e) or ty_is_enum(e)):
            return
        let n : i64 = self.born_count(na)
        if n < 0:
            return
        self.pack_room(s)
        self.pcnt[s × 1¤ptrdiff] ← n
        self.pnode_slot.push(s)
        self.pnode_id.push(na)

    fn pack_used(&mut self, s : i64, id : i64):
        if s < 0:
            return
        self.pack_room(s)
        self.puse[s × 1¤ptrdiff] ← self.puse[s × 1¤ptrdiff] + 1
        self.kuse[s × 1¤ptrdiff] ← self.kuse[s × 1¤ptrdiff] + 1
        self.pnode_slot.push(s)
        self.pnode_id.push(id)

    // A read somewhere a packed array serves.  Two kinds: the places
    // that read the elements where they lie -- an element, a count, a
    // walk -- and the places that lay them out afresh, which is what a
    // T[N] operand of ⧺, a slice or ⍴ already does.  Both are reads
    // that never want the header, which is the only question here.
    fn pack_safe(&mut self, na : i64):
        if self.kind_of(na) ≠ NK_VAR:
            return
        let s : i64 = self.nslot[na × 1¤ptrdiff]
        if s < 0 or s × 1¤ptrdiff >= #self.psafe:
            return
        self.psafe[s × 1¤ptrdiff] ← self.psafe[s × 1¤ptrdiff] + 1
        self.ksafe[s × 1¤ptrdiff] ← self.ksafe[s × 1¤ptrdiff] + 1

    // A read that could not have kept the object, though it is not one
    // a packed array could serve: push and pop write into what is
    // already there.
    fn keep_safe(&mut self, na : i64):
        if self.kind_of(na) ≠ NK_VAR:
            return
        let s : i64 = self.nslot[na × 1¤ptrdiff]
        if s >= 0 and s × 1¤ptrdiff < #self.ksafe:
            self.ksafe[s × 1¤ptrdiff] ← self.ksafe[s × 1¤ptrdiff] + 1

    // the name itself is written to, so its length is not settled
    fn pack_kill(&mut self, s : i64):
        if s >= 0 and s × 1¤ptrdiff < #self.pcnt:
            self.pcnt[s × 1¤ptrdiff] ← ⁻1

    // what survived: every node of a surviving slot is told how many
    fn pack_settle(&mut self):
        foreach i := 0¤ptrdiff…#self.pnode_slot:
            let s : i64 = self.pnode_slot[i]
            let n : i64 = self.pcnt[s × 1¤ptrdiff]
            if n >= 0 and self.puse[s × 1¤ptrdiff] = self.psafe[s × 1¤ptrdiff]:
                self.nrep[self.pnode_id[i] × 1¤ptrdiff] ← n

    fn check_var(&mut self, id : i64, tok : i64):
        let name := self.text(tok)
        if name = "_":
            self.derr(tok, "'_' holds nothing and cannot be read")
            self.set_type(id, TY_I64)
            return
        let s : i64 = self.lookup(name)
        if s ≠ ⁻1:
            if self.sheld[s × 1¤ptrdiff] = HOLD_NONE:
                self.derrc(tok, 2401, "'" ⧺ name ⧺ """' is lent out to be changed, so the name
                                                    " reaches nothing until the borrow ends; what
                                                    " the walk binds is the way in""")
            let st0 : i64 = self.stype[s × 1¤ptrdiff]
            let base0 : i64 = ty_strip_ref(st0)
            self.set_type(id, base0)
            self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
            self.life_used(self.sslot[s × 1¤ptrdiff])
            if ty_is_arr(base0):
                self.pack_used(self.sslot[s × 1¤ptrdiff], id)
            // an element reference holds the element's address: a read
            // of the name reaches through it
            if ty_ref_kind(st0) ≠ 0 and ty_ref_kind(st0) ≠ 3 and not ty_is_arr(base0) and not ty_is_hash(base0) and not ty_is_struct(base0):
                self.a.nb[id × 1¤ptrdiff] ← 1
            return
        let g : i64 = self.global_index(name)
        if g = ⁻1:
            let fidx : i64 = self.fn_index(name)
            if fidx ≠ ⁻1:
                // the function's name alone: it travels as a value
                let fd := self.a.fns[fidx × 1¤ptrdiff]
                let np : i64 ¤ptrdiff = self.a.extra[fd.params_off] × 1¤ptrdiff
                let ok9 : mut bool = np >= 1 and np <= 5 and fnval_ret_ok(fd.ret) and not fd.is_impure and not fd.is_replaceable and not self.fn_is_generic(fidx)
                let pts9 : mut i64[] = []
                foreach pi := 0…np:
                    let pty : i64 = self.a.extra[fd.params_off + 2 + pi × 2]
                    ok9 ← ok9 and ty_ref_kind(pty) = 0 and ((ty_is_int(pty) and ty_unit(pty) = 0) or pty = TY_BOOL or pty = TY_CHAR or pty = TY_STR)
                    pts9.push(ty_strip_ref(pty))
                if not ok9:
                    self.derr(tok, "'" ⧺ name ⧺ """' does not travel as a value; only a pure
                                                 " function of up to five plain scalars does""")
                    self.set_type(id, TY_I64)
                    return
                self.a.nkind[id × 1¤ptrdiff] ← NK_FNVAL
                self.a.na[id × 1¤ptrdiff] ← fidx
                self.set_type(id, mk_lty(self.lam_intern(pts9, fd.ret, if fd.is_listable: 1 else: 0)))
                return
            if self.is_ignored_name(name):
                self.derr(tok, "'" ⧺ name ⧺ """' expects errors under @expect and was left
                                             " uncompiled""")
            else:
                self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
            self.set_type(id, TY_I64)
            return
        let gd := self.a.globals[g × 1¤ptrdiff]
        if gd.is_mut and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "a mutable global is an effect; reading '" ⧺ name ⧺ "' wants @impure")
        if gd.is_mut and self.in_contract:
            self.derr(tok, "a contract's condition is pure; '" ⧺ name ⧺ "' is mutable")
        self.set_type(id, gd.ty)
        self.nslot[id × 1¤ptrdiff] ← 0 - g - 2

    fn elem_of(&self, t : i64) → i64:
        if ty_is_mat(t):
            return self.a.minner[ty_midx(t) × 1¤ptrdiff]
        if ty_is_farr(t): self.a.fae[ty_fidx(t) × 1¤ptrdiff] else: ty_elem(t)

    fn farr_size(&self, t : i64) → i64:
        self.a.fas[ty_fidx(t) × 1¤ptrdiff]

    // What digest() answers for one algorithm: a fixed count of bytes,
    // interned by the parser where it met std.hash.
    @pre(alg >= 0)
    @post(r: ty_is_farr(r))
    fn digest_type(&self, alg : i64) → i64:
        assert(alg × 1¤ptrdiff < #self.a.hdty, "the parser interned every algorithm's digest")
        self.a.hdty[alg × 1¤ptrdiff]

    // the checker interns a named function's signature when it turns
    // into a value, as the parser interns a written-out λ's
    // A lambda that threads and one that does not are not one type:
    // handed the same argument they do different things.
    fn lam_intern(&mut self, pts : i64[], ret : i64, lstb : i64) → i64:
        let n : i64 = @dropunit(#pts)
        // where a shape like this would land, which is the answer when
        // the scan finds none like it
        let at : i64 = @dropunit(#self.a.ltl)
        foreach sh := 0¤ptrdiff…#self.a.ltl:
            if self.a.ltl[sh] = n and self.a.ltf[sh] = lstb:
                let st : i64 = self.a.lts[sh]
                let same : mut bool = self.a.lte[(st + n) × 1¤ptrdiff] = ret
                foreach i := 0…n:
                    same ← same and self.a.lte[(st + i) × 1¤ptrdiff] = pts[i × 1¤ptrdiff]
                if same:
                    return @dropunit(sh)
        self.a.lts.push(@dropunit(#self.a.lte))
        self.a.ltl.push(n)
        self.a.ltf.push(lstb)
        foreach pt := pts:
            self.a.lte.push(pt)
        self.a.lte.push(ret)
        at

    // Whether a lambda of this type threads over a container.
    fn lam_listable(&self, t : i64) → bool:
        self.a.ltf[ty_lidx(t) × 1¤ptrdiff] = 1

    fn lam_np(&self, t : i64) → i64:
        self.a.ltl[ty_lidx(t) × 1¤ptrdiff]

    fn lam_pt(&self, t : i64, i : i64 ¤ptrdiff) → i64:
        self.a.lte[self.a.lts[ty_lidx(t) × 1¤ptrdiff] × 1¤ptrdiff + i]

    fn lam_ret(&self, t : i64) → i64:
        self.a.lte[(self.a.lts[ty_lidx(t) × 1¤ptrdiff] + self.a.ltl[ty_lidx(t) × 1¤ptrdiff]) × 1¤ptrdiff]

    // the checker interns shapes a slice invents, as the parser does
    fn mat_intern(&mut self, elem : i64, r : i64, c : i64, d : i64) → i64:
        // handed back as a plain type code, as the other interns are
        foreach i := 0¤ptrdiff…#self.a.mel:
            if self.a.mel[i] = elem and self.a.mrr[i] = r and self.a.mcc[i] = c and self.a.mdd[i] = d:
                return @dropunit(i)
        let inner : mut i64 = mk_rty(elem)
        if d ≠ ⁻2:
            inner ← mk_mty(self.mat_intern(elem, c, d, ⁻2))
        // interning the plane may have grown the table, so where this
        // shape lands is asked again and not remembered from the scan
        let at : i64 = @dropunit(#self.a.mel)
        self.a.mel.push(elem)
        self.a.mrr.push(r)
        self.a.mcc.push(c)
        self.a.mdd.push(d)
        self.a.minner.push(inner)
        assert(#self.a.mel = #self.a.minner and #self.a.mel = #self.a.mdd, "shape table arrays in step")
        at

    fn mat_elem(&self, t : i64) → i64:
        self.a.mel[ty_midx(t) × 1¤ptrdiff]

    fn mat_rr(&self, t : i64) → i64:
        self.a.mrr[ty_midx(t) × 1¤ptrdiff]

    fn mat_cc(&self, t : i64) → i64:
        self.a.mcc[ty_midx(t) × 1¤ptrdiff]

    fn mat_dd(&self, t : i64) → i64:
        self.a.mdd[ty_midx(t) × 1¤ptrdiff]

    // two extents or three
    fn mat_rank(&self, t : i64) → i64:
        if self.a.mdd[ty_midx(t) × 1¤ptrdiff] = ⁻2: 2 else: 3

    fn tup_len(&self, t : i64) → i64:
        self.a.ttl[ty_tidx(t) × 1¤ptrdiff]

    fn tup_elem(&self, t : i64, i : i64) → i64:
        self.a.tte[(self.a.tts[ty_tidx(t) × 1¤ptrdiff] + i) × 1¤ptrdiff]

    // a tuple literal takes its shape from where it is bound: the
    // stated binding type or the function's return type says it
    // a static assertion is judged as the file is checked: constant
    // operands only, and a failure is a diagnostic, not code
    fn check_static_assert(&mut self, id : i64, tok : i64, args_off : i64 ¤"aextra", is_eq : bool):
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        self.set_type(id, TY_UNIT)
        if is_eq:
            if argc ≠ 2:
                self.derr(tok, "static_assert_eq takes the two sides")
                return
            let x : i64 = self.a.extra[args_off + 1]
            let y : i64 = self.a.extra[args_off + 2]
            // a bare type name stands for its own spelling here
            self.sa_fold_typename(x)
            self.sa_fold_typename(y)
            self.check_expr(x, TY_UNIT)
            self.check_expr(y, TY_UNIT)
            let kx : i64 = self.kind_of(x)
            let ky : i64 = self.kind_of(y)
            if kx = NK_STR and ky = NK_STR:
                if self.a.strs[self.a.na[x × 1¤ptrdiff] × 1¤ptrdiff] ≠ self.a.strs[self.a.na[y × 1¤ptrdiff] × 1¤ptrdiff]:
                    self.derr(tok, "static assertion failed: \"" ⧺ self.a.strs[self.a.na[x × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\" is not \"" ⧺ self.a.strs[self.a.na[y × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\"")
                return
            if (kx = NK_INT or kx = NK_BOOL) and (ky = NK_INT or ky = NK_BOOL):
                if self.a.na[x × 1¤ptrdiff] ≠ self.a.na[y × 1¤ptrdiff]:
                    self.derr(tok, "static assertion failed: " ⧺ i64_str(self.a.na[x × 1¤ptrdiff]) ⧺ " is not " ⧺ i64_str(self.a.na[y × 1¤ptrdiff]))
                return
            self.derr(tok, """static_assert_eq reads what the compiler can see: literals, folded
                            " numbers, @typeof""")
            return
        if argc ≠ 1:
            self.derr(tok, "static_assert takes the condition")
            return
        let c : i64 = self.a.extra[args_off + 1]
        self.check_expr(c, TY_UNIT)
        let kc : i64 = self.kind_of(c)
        if kc ≠ NK_BOOL and kc ≠ NK_INT:
            self.derr(tok, "static_assert reads what the compiler can see: a condition that folds")
            return
        if self.a.na[c × 1¤ptrdiff] = 0:
            self.derr(tok, "static assertion failed")

    // i64 written bare in a static assertion is the name of the type
    fn sa_fold_typename(&mut self, e : i64):
        if self.kind_of(e) ≠ NK_VAR:
            return
        let nm := self.text(self.a.ntok[e × 1¤ptrdiff])
        if self.lookup(nm) ≠ ⁻1:
            return
        let known : bool = (TYNAMES[nm] ?? ⁻1) ≠ ⁻1 or self.struct_index(nm) ≠ ⁻1
        if not known:
            return
        self.a.strs.push(nm)
        self.a.nkind[e × 1¤ptrdiff] ← NK_STR
        self.a.na[e × 1¤ptrdiff] ← @dropunit(#self.a.strs) - 1
        self.a.nb[e × 1¤ptrdiff] ← 0
        self.set_type(e, TY_STR)

    fn ty_spell(&self, t : i64) → str:
        if t = TY_BOOL: return "bool"
        if t = TY_STR: return "str"
        if t = TY_CHAR: return "char"
        if ty_is_enum(t): return self.a.enames[ty_eidx(t) × 1¤ptrdiff]
        if ty_is_struct(t): return self.sname_of(t)
        if ty_is_int(t) and ty_unit(t) = 0:
            return (if ty_sgn(t) = 1: "i" else: "u") ⧺ i64_str(ty_bits(t))
        if ty_is_farr(t):
            let esp : str = self.ty_spell(self.a.fae[ty_fidx(t) × 1¤ptrdiff])
            if esp = "": return ""
            return esp ⧺ "[" ⧺ i64_str(self.farr_size(t)) ⧺ "]"
        if ty_is_tup(t):
            let n : i64 = self.tup_len(t)
            let sp : mut str = "("
            foreach i := 0…n:
                let e : str = self.ty_spell(self.tup_elem(t, i))
                if e = "": return ""
                sp ← sp ⧺ (if i = 0: "" else: ", ") ⧺ e
            return sp ⧺ ")"
        ""

    fn check_tuple(&mut self, id : i64, tok : i64, off : i64, want : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let w : i64 = ty_strip_ref(want)
        if not ty_is_tup(w):
            self.derr(tok, "a tuple literal takes its type from where it is bound; state it there")
            foreach i0 := 0…n:
                self.check_expr(self.a.extra[(off + 1 + i0) × 1¤ptrdiff], TY_UNIT)
            self.set_type(id, TY_I64)
            return
        if self.tup_len(w) ≠ n:
            self.derr(tok, "the type says " ⧺ i64_str(self.tup_len(w)) ⧺ " elements; the literal holds " ⧺ i64_str(n))
            self.set_type(id, w)
            return
        foreach i := 0…n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let et : i64 = self.tup_elem(w, i)
            self.check_expr(e, et)
            if self.is_open(self.ty_of(e)):
                self.adopt(e, et)
            elif not self.try_fit(e, et):
                self.derr(tok, "element " ⧺ i64_str(i) ⧺ " is " ⧺ self.tn(et) ⧺ ", not " ⧺ self.tn(self.ty_of(e)))
        self.set_type(id, w)

    // n ⍴ x: n copies of a scalar, or an array's elements cycled to
    // the count; the binding's type says what a sized array takes
    fn check_mreshape(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        let w : i64 = ty_strip_ref(want)
        if not ty_is_mat(w):
            self.derr(tok, """a pair of extents builds a matrix; state the matrix type where it is
                            " bound""")
            self.set_type(id, mk_aty(TY_I64))
            return
        let toff : i64 = self.a.na[na × 1¤ptrdiff]
        let tn : i64 = self.a.extra[toff × 1¤ptrdiff]
        let rank : i64 = self.mat_rank(w)
        if tn ≠ rank:
            self.derr(tok, if tn > 1: """a shape states as many extents as the binding has
                                       " dimensions, """ ⧺ i64_str(rank) else: "one extent is a count, not a shape")
            self.set_type(id, w)
            return
        let re : i64 = self.a.extra[(toff + 1) × 1¤ptrdiff]
        let ce : i64 = self.a.extra[(toff + 2) × 1¤ptrdiff]
        let de : i64 = self.a.extra[(toff + rank) × 1¤ptrdiff]
        if self.kind_of(re) ≠ NK_INT or self.kind_of(ce) ≠ NK_INT or self.kind_of(de) ≠ NK_INT or self.a.nb[re × 1¤ptrdiff] ≠ 0 or self.a.nb[ce × 1¤ptrdiff] ≠ 0 or self.a.nb[de × 1¤ptrdiff] ≠ 0:
            self.derr(tok, "a matrix ⍴ states its extents as written-out numbers")
            self.set_type(id, w)
            return
        self.set_type(re, TY_I64)
        self.set_type(ce, TY_I64)
        self.set_type(de, TY_I64)
        let r : i64 = self.a.na[re × 1¤ptrdiff]
        let c : i64 = self.a.na[ce × 1¤ptrdiff]
        let d3 : i64 = self.a.na[de × 1¤ptrdiff]
        if r < 1 or c < 1 or (rank = 3 and d3 < 1):
            self.derr(tok, "a matrix has at least one row and one column")
        if self.mat_rr(w) ≠ ⁻1 and r ≠ self.mat_rr(w):
            self.derr(tok, "array size mismatch: the type says " ⧺ i64_str(self.mat_rr(w)) ⧺ " rows, got " ⧺ i64_str(r))
        if self.mat_cc(w) ≠ ⁻1 and c ≠ self.mat_cc(w):
            self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(self.mat_cc(w)) ⧺ ", got " ⧺ i64_str(c))
        if rank = 3 and self.mat_dd(w) ≠ ⁻1 and d3 ≠ self.mat_dd(w):
            self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(self.mat_dd(w)) ⧺ ", got " ⧺ i64_str(d3))
        // the filler settles as it does for a one-dimensional ⍴
        let ew : i64 = self.mat_elem(w)
        if self.kind_of(nb) = NK_ARRLIT:
            self.check_expr(nb, mk_aty(ew))
        else:
            self.check_expr(nb, ew)
        let ft : i64 = self.ty_of(nb)
        if ty_is_rg(ft):
            if ty_rgelem(ft) ≠ ew:
                self.derr(tok, "the filler counts " ⧺ self.tn(ty_rgelem(ft)) ⧺ ", but the binding wants " ⧺ self.tn(ew))
        elif ty_is_arr(ft):
            if self.elem_of(ft) ≠ ew:
                self.derr(tok, "the filler holds " ⧺ self.tn(self.elem_of(ft)) ⧺ ", but the binding wants " ⧺ self.tn(ew))
        elif self.is_open(ft):
            self.adopt(nb, ew)
        elif not self.try_fit(nb, ew):
            self.derr(tok, "the filler is " ⧺ self.tn(ft) ⧺ ", but the binding wants " ⧺ self.tn(ew))
        self.set_type(id, w)

    fn check_reshape(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        if self.kind_of(na) = NK_TUPLE:
            self.check_mreshape(id, tok, na, nb, want)
            return
        self.check_expr(na, TY_UNIT)
        let ct : i64 = self.ty_of(na)
        if ct = TY_UNT:
            self.adopt(na, TY_I64)
        elif not ty_is_int(ct):
            self.derr(tok, "⍴ counts with a number; this is " ⧺ self.tn(ct))
        let w : i64 = ty_strip_ref(want)
        let wantish : bool = ty_is_arr(w)
        let ew : i64 = if wantish: self.elem_of(w) else: TY_UNIT
        // an array-literal filler settles under the array want; a
        // scalar filler settles under the element's
        if wantish and self.kind_of(nb) = NK_ARRLIT:
            self.check_expr(nb, mk_aty(ew))
        else:
            self.check_expr(nb, if wantish: ew else: TY_UNIT)
        let ft : i64 = self.ty_of(nb)
        if ty_is_rg(ft):
            // a range's steps cycle to the count as elements do
            if wantish and ty_rgelem(ft) ≠ self.elem_of(w):
                self.derr(tok, "the filler counts " ⧺ self.tn(ty_rgelem(ft)) ⧺ ", but the binding wants " ⧺ self.tn(self.elem_of(w)))
            self.set_type(id, if wantish: w else: mk_aty(ty_rgelem(ft)))
        elif ty_is_arr(ft):
            // the filler's elements cycle to the count
            self.pack_safe(nb)
            if wantish and self.elem_of(ft) ≠ self.elem_of(w):
                self.derr(tok, "the filler holds " ⧺ self.tn(self.elem_of(ft)) ⧺ ", but the binding wants " ⧺ self.tn(self.elem_of(w)))
            self.set_type(id, if wantish: w else: mk_aty(self.elem_of(ft)))
        else:
            if self.is_open(ft):
                if wantish:
                    self.adopt(nb, ew)
                else:
                    self.derr(tok, "the filler states no type; the binding must say it")
                    self.adopt(nb, TY_I64)
            elif wantish and not self.try_fit(nb, ew):
                self.derr(tok, "the filler is " ⧺ self.tn(ft) ⧺ ", but the binding wants " ⧺ self.tn(ew))
            self.set_type(id, if wantish: w else: mk_aty(self.ty_of(nb)))
        if ty_is_farr(w) and wantish:
            // a sized binding takes its size, stated as the count
            if self.kind_of(na) ≠ NK_INT:
                self.derr(tok, "a sized array's ⍴ states its size as a written-out number")
            elif self.a.na[na × 1¤ptrdiff] ≠ self.farr_size(w):
                self.derr(tok, "array size mismatch: declared " ⧺ i64_str(self.farr_size(w)) ⧺ ", got " ⧺ i64_str(self.a.na[na × 1¤ptrdiff]))

    // the length of a written-out plane's first row, or ⁻1 where the
    // literal does not say
    fn lit_cols(&self, poff : i64) → i64:
        if self.a.extra[poff × 1¤ptrdiff] = 0:
            return ⁻1
        let r0 : i64 = self.a.extra[(poff + 1) × 1¤ptrdiff]
        if self.kind_of(r0) ≠ NK_ARRLIT: ⁻1 else: self.a.extra[self.a.na[r0 × 1¤ptrdiff] × 1¤ptrdiff]

    fn check_matlit(&mut self, id : i64, tok : i64, off : i64, w : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let elem : i64 = self.mat_elem(w)
        if self.mat_rank(w) = 3:
            self.check_cubelit(id, tok, off, w)
            return
        if n = 0:
            self.derr(tok, "a matrix has at least one row")
            self.set_type(id, w)
            return
        if self.mat_rr(w) ≠ ⁻1 and n ≠ self.mat_rr(w):
            self.derr(tok, "array size mismatch: the type says " ⧺ i64_str(self.mat_rr(w)) ⧺ " rows, got " ⧺ i64_str(n))
        let cwant : i64 = self.mat_cc(w)
        let c0 : mut i64 = ⁻1
        foreach i := 0…n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            if self.kind_of(e) ≠ NK_ARRLIT:
                self.derr(tok, """a matrix literal writes its rows out; a computed row is not core-2
                                " yet""")
                self.check_expr(e, TY_UNIT)
            else:
                let rl : i64 = self.a.extra[self.a.na[e × 1¤ptrdiff] × 1¤ptrdiff]
                if rl = 0:
                    self.derr(tok, "a matrix has at least one column")
                elif cwant ≠ ⁻1 and rl ≠ cwant:
                    self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(cwant) ⧺ ", got " ⧺ i64_str(rl))
                elif c0 = ⁻1:
                    c0 ← rl
                elif rl ≠ c0:
                    self.derr(tok, "rows of differing lengths are not a dimension; " ⧺ i64_str(c0) ⧺ " then " ⧺ i64_str(rl))
                self.check_expr(e, mk_aty(elem))
        self.set_type(id, w)

    // a cube's elements are its planes, each a matrix literal.  Where
    // the type leaves an extent open the first plane settles it, so a
    // ragged literal is still caught.
    fn check_cubelit(&mut self, id : i64, tok : i64, off : i64, w : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            self.derr(tok, "a matrix has at least one row")
            self.set_type(id, w)
            return
        if self.mat_rr(w) ≠ ⁻1 and n ≠ self.mat_rr(w):
            self.derr(tok, "array size mismatch: the type says " ⧺ i64_str(self.mat_rr(w)) ⧺ " planes, got " ⧺ i64_str(n))
        let e0 : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        let rw : mut i64 = self.mat_cc(w)
        let cw : mut i64 = self.mat_dd(w)
        if self.kind_of(e0) = NK_ARRLIT:
            let poff0 : i64 = self.a.na[e0 × 1¤ptrdiff]
            rw ← if rw = ⁻1: self.a.extra[poff0 × 1¤ptrdiff] else: rw
            cw ← if cw = ⁻1: self.lit_cols(poff0) else: cw
        let inner : i64 = mk_mty(self.mat_intern(self.mat_elem(w), rw, cw, ⁻2))
        foreach i := 0…n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            if self.kind_of(e) ≠ NK_ARRLIT:
                self.derr(tok, """a matrix literal writes its rows out; a computed row is not core-2
                                " yet""")
                self.check_expr(e, TY_UNIT)
            else:
                self.check_matlit(e, tok, self.a.na[e × 1¤ptrdiff], inner)
        self.set_type(id, w)

    // An if standing where a value is wanted.  Each branch is a
    // block whose last statement is that branch's value, and the two
    // say one type between them: settled from what the context wants
    // where it wants something, and from the first branch that states
    // one otherwise -- which is how an array literal settles its
    // element type, and untyped numbers take the answer either way.
    //
    // There are always two sides here, however long the chain, because
    // an elif is a block holding one if and that if is its block's
    // value.  So the chain unifies pairwise from the far end back,
    // and each step is this one function.
    fn check_ife(&mut self, id : i64, tok : i64, na : i64, nb : i64, nc : i64, want : i64):
        self.check_expr(na, TY_UNIT)
        self.want_truthy(na, "the condition")
        if nc = ⁻1:
            self.check_ife_noelse(id, tok, nb, want)
            return
        let settled : mut i64 = ty_strip_ref(want)
        let v1 : i64 = self.ife_block_value(nb, self.value_hint(settled))
        if settled = TY_UNIT and self.states_a_type(v1):
            settled ← self.ty_of(v1)
        let v2 : i64 = self.ife_block_value(nc, self.value_hint(settled))
        if settled = TY_UNIT and self.states_a_type(v2):
            settled ← self.ty_of(v2)
        if v1 = ⁻1 and v2 = ⁻1:
            self.derr(tok, """an if standing where a value is wanted answers on some path; every
                            " branch of this one leaves instead""")
            self.set_type(id, TY_I64)
            return
        if settled = TY_UNIT:
            // neither side said what it is, and nothing asked for a
            // type either: a bare number is i64, as it is elsewhere
            settled ← TY_I64
        // A branch that says ∅ says the one value is an optional: an
        // optional is the type that holds both what it holds and the
        // absence of it, which is the whole of what it is for.
        if not ty_is_opt(settled) and (self.says_empty(v1) or self.says_empty(v2)):
            settled ← mk_oty(settled)
        self.ife_fits(tok, v1, settled, "an if is one value, so its branches")
        self.ife_fits(tok, v2, settled, "an if is one value, so its branches")
        self.set_type(id, settled)

    // What to ask a branch for.  Where the one value is optional the
    // branch is asked for what the optional holds: a branch may answer
    // either that or the optional itself, and asking for the optional
    // would settle an untyped number on a type no number can take.
    fn value_hint(&self, settled : i64) → i64:
        if ty_is_opt(settled):
            return ty_opt_base(settled)
        settled

    // Whether a branch's value settles the type for the other side.  A
    // number with no width takes what it is given, and ∅ says only
    // that the answer is optional, so neither settles anything.
    fn states_a_type(&self, v : i64) → bool:
        if v = ⁻1:
            return false
        self.ty_of(v) ≠ TY_UNT and self.ty_of(v) ≠ TY_EMPTY

    fn says_empty(&self, v : i64) → bool:
        if v = ⁻1:
            return false
        self.ty_of(v) = TY_EMPTY

    // An if with no else can fall past its branch, and what it hands
    // back there is nothing.  So its value is optional: ⊨ the branch's
    // value where the condition holds, ∅ where it does not.  A branch
    // that already answers an optional is that optional -- an optional
    // of an optional is refused here as it is refused of ⊨.
    fn check_ife_noelse(&mut self, id : i64, tok : i64, nb : i64, want : i64):
        let sw : i64 = ty_strip_ref(want)
        let inner : mut i64 = TY_UNIT
        if ty_is_opt(sw):
            inner ← ty_opt_base(sw)
        let v : i64 = self.ife_block_value(nb, inner)
        if v = ⁻1:
            // the branch leaves rather than arriving, so no value ever
            // comes back and there is nothing for ⊨ to hold
            self.derr(tok, """an if with no else answers ∅ where the condition does not hold, so its
                            " branch answers something where it does; this one leaves instead""")
            self.set_type(id, mk_oty(TY_I64))
            return
        if self.ty_of(v) = TY_UNT:
            let n : mut i64 = TY_I64
            if inner ≠ TY_UNIT and ty_is_int(inner):
                n ← inner
            self.adopt(v, n)
        let it : i64 = self.ty_of(v)
        if ty_is_arr(it):
            self.derr(tok, "an optional array is not core-2 yet")
            self.set_type(id, mk_oty(TY_I64))
            return
        if ty_is_hash(it):
            self.derr(tok, "an optional dictionary is not core-2 yet")
            self.set_type(id, mk_oty(TY_I64))
            return
        if it = TY_EMPTY:
            self.derr(tok, """an if with no else already answers ∅ where the condition does not
                            " hold; its branch answers a value""")
            self.set_type(id, mk_oty(TY_I64))
            return
        if ty_is_opt(it):
            // the branch is already an optional, and ∅ is one of its
            // own values, so nothing is wrapped a second time
            self.set_type(id, it)
            return
        self.set_type(id, mk_oty(it))

    // `whose` names the construct and what its parts are called --
    // "an if is one value, so its branches", "a match ... its arms" --
    // so one routine can answer for both and still read as itself.
    fn ife_fits(&mut self, tok : i64, v : i64, settled : i64, whose : str):
        if v = ⁻1:
            return
        let t : i64 = self.ty_of(v)
        if ty_is_opt(settled):
            // An optional holds what it holds and ∅ besides, so a
            // branch may say either and still be the one value; what
            // says the base type is held on the way out.
            if t = TY_EMPTY:
                return
            // the untyped case first: try_fit settles one itself, and
            // it would settle it on the optional rather than on what
            // the optional holds
            if t = TY_UNT:
                self.adopt(v, ty_opt_base(settled))
                return
            if self.try_fit(v, settled) or self.try_fit(v, ty_opt_base(settled)):
                return
            self.derr(tok, whose ⧺ " say one type between them; " ⧺ self.tn(t) ⧺ " is not " ⧺ self.tn(settled))
            return
        if t = TY_UNT:
            self.adopt(v, settled)
            return
        if not self.try_fit(v, settled):
            self.derr(tok, whose ⧺ " say one type between them; " ⧺ self.tn(t) ⧺ " is not " ⧺ self.tn(settled))

    // One branch: every statement but the last is itself, and the last
    // is the branch's value.  Answers the node that value is, or ⁻1
    // where the branch leaves rather than answering -- a return, an
    // abort -- which states no type and is not counted against the
    // other side.
    fn ife_block_value(&mut self, blk : i64, settled : i64) → i64:
        self.push_scope()
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        // every statement but the last, and an empty block has none
        foreach i := 0…(n - 1) ⌈ 0:
            self.check_stmt(self.a.extra[(off + 1 + i) × 1¤ptrdiff], false)
        let v : mut i64 = ⁻1
        if n = 0:
            self.derr(self.a.ntok[blk × 1¤ptrdiff], """a branch of an if used as a value holds the
                                                     " value; this one is empty""")
        else:
            let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
            let lk : i64 = self.kind_of(last)
            let ltok : i64 = self.a.ntok[last × 1¤ptrdiff]
            if lk = NK_EXPRSTMT or lk = NK_IF:
                self.val_want ← settled
                self.check_stmt(last, false)
                self.val_want ← ⁻1
                v ← if lk = NK_EXPRSTMT: self.a.na[last × 1¤ptrdiff] else: last
                if self.always_returns(last):
                    // it is checked, but it leaves rather than
                    // arriving with a value, so it states no type for
                    // the other side to agree with
                    v ← ⁻1
            else:
                self.check_stmt(last, false)
                if not self.always_returns(last):
                    self.derr(ltok, "a branch of an if used as a value ends in that value")
        self.pop_scope()
        v

    fn check_arrlit(&mut self, id : i64, tok : i64, off : i64, want : i64):
        if ty_is_mat(ty_strip_ref(want)):
            self.check_matlit(id, tok, off, ty_strip_ref(want))
            return
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let want_elem : mut i64 = TY_UNIT
        if ty_is_farr(ty_strip_ref(want)) and n ≠ self.farr_size(ty_strip_ref(want)):
            self.derr(tok, "array size mismatch: declared " ⧺ i64_str(self.farr_size(ty_strip_ref(want))) ⧺ ", got " ⧺ i64_str(n))
        if ty_is_arr(ty_strip_ref(want)):
            want_elem ← self.elem_of(ty_strip_ref(want))
        let settled : mut i64 = want_elem
        foreach i := 0…n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            self.check_expr(e, settled)
            if settled = TY_UNIT and self.ty_of(e) ≠ TY_UNT:
                settled ← self.ty_of(e)
        if settled = TY_UNIT:
            if n > 0:
                self.derr(tok, "the elements state no type; the binding must say it")
            self.set_type(id, if ty_is_arr(want): want else: mk_aty(TY_I64))
            return
        if not ty_is_int(settled) and not ty_is_struct(settled) and not ty_is_enum(settled) and settled ≠ TY_CHAR and settled ≠ TY_STR and settled ≠ TY_BOOL and settled ≠ TY_IOVEC:
            self.derr(tok, """a core-2 array holds plain integers, truth values, characters, strings
                            " or structs""")
            self.set_type(id, mk_aty(TY_I64))
            return
        // every element meets the settled type
        foreach j := 0…n:
            let e : i64 = self.a.extra[(off + 1 + j) × 1¤ptrdiff]
            if self.ty_of(e) = TY_UNT:
                self.adopt(e, settled)
            elif not self.try_fit(e, settled):
                self.derrc(tok, 2741, "one array, one element type; " ⧺ self.tn(self.ty_of(e)) ⧺ " is not " ⧺ self.tn(settled))
        self.set_type(id, if ty_is_farr(ty_strip_ref(want)): ty_strip_ref(want) else: mk_aty(settled))

    fn check_slit(&mut self, id : i64, tok : i64, off : i64):
        let name := self.text(tok)
        let sidx : i64 = self.struct_index(name)
        if sidx = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ "' is not a struct this program defines")
            self.set_type(id, TY_I64)
            return
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let nf : i64 ¤ptrdiff = self.a.extra[d.fields_off] × 1¤ptrdiff
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let filled : mut i64[] = []
        foreach j := 0…nf:
            filled.push(0)
        foreach i := 0…n:
            let ftok : i64 = self.a.extra[(off + 1 + i × 2) × 1¤ptrdiff]
            let e : i64 = self.a.extra[(off + 2 + i × 2) × 1¤ptrdiff]
            let (fidx, fty) := self.field_of(sidx, self.text(ftok))
            if fidx = ⁻1:
                self.derr(ftok, "'" ⧺ name ⧺ "' has no field '" ⧺ self.text(ftok) ⧺ "'")
                self.check_expr(e, TY_UNIT)
            else:
                if filled[fidx × 1¤ptrdiff] = 1:
                    self.derr(ftok, "the literal names '" ⧺ self.text(ftok) ⧺ "' twice")
                filled[fidx × 1¤ptrdiff] ← 1
                self.check_expr(e, fty)
                if self.is_open(self.ty_of(e)):
                    self.adopt(e, fty)
                elif not self.try_fit(e, fty):
                    self.derr(ftok, "field '" ⧺ self.text(ftok) ⧺ "' holds " ⧺ self.tn(fty) ⧺ ", not " ⧺ self.tn(self.ty_of(e)))
                // the resolved position replaces the name for lowering
                self.a.extra[(off + 1 + i × 2) × 1¤ptrdiff] ← fidx
        foreach m := 0…nf:
            if filled[m] = 0:
                let ftok : i64 = self.a.extra[d.fields_off + 1 + m × 2]
                self.derr(tok, "the literal misses field '" ⧺ self.text(ftok) ⧺ "'")
        self.set_type(id, mk_sty(sidx))

    fn check_field(&mut self, id : i64, tok : i64, na : i64):
        // Name.alignof, where Name is a struct's: the layout answers,
        // and does so before anything is evaluated
        let lsi : i64 = self.type_named(na)
        if lsi ≠ ⁻1:
            if self.text(tok) ≠ "alignof":
                self.derr(tok, "a struct type answers alignof and offsetof; '" ⧺ self.text(tok) ⧺ "' is a field, which an instance has")
                self.fold_bytes(id, 0)
                return
            let (asz, aal) := c_struct_layout(self.a, lsi, 0)
            _ ← asz
            if aal = ⁻1:
                self.layout_err(tok, lsi, "aligned")
                self.fold_bytes(id, 0)
                return
            self.fold_bytes(id, aal)
            return
        // Name.enumerator, where Name is an enum's: what it stands for
        // is its place in the list, settled here
        if self.kind_of(na) = NK_VAR:
            let bn := self.text(self.a.ntok[na × 1¤ptrdiff])
            if self.lookup(bn) = ⁻1:
                let ei : i64 = self.enum_index(bn)
                if ei ≠ ⁻1:
                    let m := self.text(tok)
                    let k : i64 = self.enum_member(ei, m)
                    if k = ⁻1:
                        self.derr(tok, "'" ⧺ bn ⧺ "' does not hold '" ⧺ m ⧺ "'")
                        self.set_type(id, mk_ety(ei))
                        return
                    self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                    self.a.na[id × 1¤ptrdiff] ← self.a.evalues[(self.a.estart[ei × 1¤ptrdiff] + k) × 1¤ptrdiff]
                    self.a.nb[id × 1¤ptrdiff] ← 0
                    self.set_type(id, mk_ety(ei))
                    return
        self.check_expr(na, TY_UNIT)
        let t : i64 = ty_strip_ref(self.ty_of(na))
        if t = TY_ENTRY:
            self.check_entry_field(id, tok)
            return
        if ty_is_mat(t):
            if self.text(tok) = "shape":
                self.set_type(id, mk_aty(ty_with_unit(TY_I64, UNIT_PTRDIFF)))
            else:
                self.derr(tok, "a matrix answers shape; '" ⧺ self.text(tok) ⧺ "' it does not have")
                self.set_type(id, TY_I64)
            return
        if not ty_is_struct(t):
            self.derr(tok, "only a struct has fields; this is " ⧺ self.tn(t))
            self.set_type(id, TY_I64)
            return
        let (fidx, fty) := self.field_of(ty_sidx(t), self.text(tok))
        if fidx = ⁻1:
            self.derr(tok, "'" ⧺ self.sname_of(t) ⧺ "' has no field '" ⧺ self.text(tok) ⧺ "'")
            self.set_type(id, TY_I64)
            return
        self.a.nb[id × 1¤ptrdiff] ← fidx
        self.set_type(id, fty)

    // whether an enum's members are independent bits
    fn enum_is_flag(&self, t : i64) → bool:
        self.a.eflag[ty_eidx(ty_strip_ref(t)) × 1¤ptrdiff] = 1

    // the union of a flag enum's bits, which is what ~ flips within
    fn enum_bits(&self, t : i64) → i64:
        let ei : i64 = ty_eidx(ty_strip_ref(t))
        let st : i64 = self.a.estart[ei × 1¤ptrdiff]
        let n : i64 = self.a.ecount[ei × 1¤ptrdiff]
        let m : mut i64 = 0
        foreach i := 0…n:
            m ← m | self.a.evalues[(st + i) × 1¤ptrdiff]
        m

    // the enum a written name stands for; the builtins are reached
    // through std and so are not found here
    fn enum_index(&self, name : str) → i64:
        if @dropunit(#self.a.enames) > NBUILTIN_ENUMS:
            foreach i := NBUILTIN_ENUMS × 1¤ptrdiff…#self.a.enames:
                if self.a.enames[i] = name:
                    return @dropunit(i)
        ⁻1

    fn enum_member(&self, ei : i64, m : str) → i64:
        let f : i64 = self.a.estart[ei × 1¤ptrdiff]
        let n : i64 = self.a.ecount[ei × 1¤ptrdiff]
        foreach i := 0…n:
            if self.a.emembers[(f + i) × 1¤ptrdiff] = m:
                return i
        ⁻1

    // ------------------------------------------------------------------
    // match over an enumeration
    // ------------------------------------------------------------------
    //
    // Every value the enumeration has must have an arm, or there must
    // be a `_`.  That is the whole point of writing it this way rather
    // than as a chain of comparisons: a value added to the enumeration
    // later stops every match that does not say what to do with it,
    // where a chain would quietly take whichever branch came last.
    //
    // Coverage is over the values and not the names, so an enumerator
    // that is another name for one already covered is covered too --
    // two names standing for one number are one case.
    // A match on an optional standing where a value is wanted.  Its
    // two arms are that one value, settled between them the way an
    // if's branches are.
    fn check_matchv(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        self.check_expr(na, TY_UNIT)
        let t : i64 = self.ty_of(na)
        if not ty_is_opt(t):
            self.derr(tok, "match asks an optional which it is; this is " ⧺ self.tn(t))
            self.set_type(id, TY_I64)
            return
        let some_blk : i64 = self.a.extra[nb × 1¤ptrdiff]
        let empty_blk : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
        let settled : mut i64 = ty_strip_ref(want)
        self.push_scope()
        let slot : i64 = self.declare(tok, ty_opt_base(t), 0)
        self.nslot[id × 1¤ptrdiff] ← slot
        let v1 : i64 = self.ife_block_value(some_blk, self.value_hint(settled))
        self.pop_scope()
        if settled = TY_UNIT and self.states_a_type(v1):
            settled ← self.ty_of(v1)
        let v2 : i64 = self.ife_block_value(empty_blk, self.value_hint(settled))
        let vals : mut i64[] = []
        vals.push(v1)
        vals.push(v2)
        self.settle_arms(id, tok, vals, settled, "match")

    // vwant is ⁻1 where the match stands as a statement, and what the
    // surrounding text asks for where it stands as a value.  In value
    // mode every arm answers, and the arms say one type between them,
    // settled the way an if's branches settle theirs.
    fn check_matche(&mut self, id : i64, tok : i64, na : i64, nb : i64, trailing : bool, vwant : i64):
        self.check_expr(na, TY_UNIT)
        let n : i64 = self.a.extra[nb × 1¤ptrdiff]
        let dflt : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
        let ename := self.text(self.a.extra[(nb + 2) × 1¤ptrdiff])
        let ei : i64 = self.enum_index(ename)
        if ei = ⁻1:
            self.derr(tok, "'" ⧺ ename ⧺ "' is not an enumeration")
            return
        self.a.nc[id × 1¤ptrdiff] ← ei
        let st : i64 = ty_strip_ref(self.ty_of(na))
        if st ≠ mk_ety(ei):
            self.derr(tok, "the arms name values of " ⧺ ename ⧺ ", but the subject is " ⧺ self.tn(st))
        // which values the arms account for
        let ecount : i64 = self.a.ecount[ei × 1¤ptrdiff]
        let est : i64 = self.a.estart[ei × 1¤ptrdiff]
        let settled : mut i64 = TY_UNIT
        if vwant ≠ ⁻1:
            settled ← ty_strip_ref(vwant)
        let vals : mut i64[] = []
        let taken : mut i64[] = []
        foreach ci := 0…ecount:
            taken.push(0)
        foreach i := 0…n:
            let etok : i64 = self.a.extra[(nb + 2 + i × 3) × 1¤ptrdiff]
            let mtok : i64 = self.a.extra[(nb + 3 + i × 3) × 1¤ptrdiff]
            let blk : i64 = self.a.extra[(nb + 4 + i × 3) × 1¤ptrdiff]
            if self.text(etok) ≠ ename:
                self.derr(etok, "one match asks about one enumeration; this arm names " ⧺ self.text(etok) ⧺ " and the first named " ⧺ ename)
            let m := self.text(mtok)
            let k : i64 = self.enum_member(ei, m)
            if k = ⁻1:
                self.derr(mtok, "'" ⧺ ename ⧺ "' does not hold '" ⧺ m ⧺ "'")
            else:
                let v : i64 = self.a.evalues[(est + k) × 1¤ptrdiff]
                // by value, so an arm for one name of a value covers
                // every other name of it -- and repeats that value
                foreach j := 0…ecount:
                    if self.a.evalues[(est + j) × 1¤ptrdiff] = v:
                        if taken[j × 1¤ptrdiff] = 1 and j = k:
                            self.derr(mtok, "match repeats '" ⧺ ename ⧺ "." ⧺ m ⧺ "'; the second arm can never be reached")
                        taken[j × 1¤ptrdiff] ← 1
            // An arm that leaves rather than falls through -- a
            // return, or a call to something @noreturn -- has no value
            // to hand on, so a trailing match does not ask it for one.
            if vwant ≠ ⁻1:
                let v : i64 = self.ife_block_value(blk, self.value_hint(settled))
                vals.push(v)
                if settled = TY_UNIT and self.states_a_type(v):
                    settled ← self.ty_of(v)
            else:
                self.check_block(blk, trailing and not self.block_returns(blk))
        if dflt ≠ ⁻1:
            if vwant ≠ ⁻1:
                let v : i64 = self.ife_block_value(dflt, self.value_hint(settled))
                vals.push(v)
                if settled = TY_UNIT and self.states_a_type(v):
                    settled ← self.ty_of(v)
            else:
                self.check_block(dflt, trailing and not self.block_returns(dflt))
        else:
            let missing : mut str = ""
            foreach mi := 0…ecount:
                if taken[mi × 1¤ptrdiff] = 0:
                    missing ← missing ⧺ (if missing = "": "" else: " or ") ⧺ ename ⧺ "." ⧺ self.a.emembers[(est + mi) × 1¤ptrdiff]
            if missing ≠ "":
                self.derr(tok, "match has no arm for " ⧺ missing ⧺ "; add the missing pattern or a _ arm")
        if trailing and vwant = ⁻1 and self.answer_ty() ≠ TY_UNIT:
            // standing last in a body, each arm hands its value on as
            // the function's answer, so each arm has one to hand
            foreach ai := 0…n:
                let ablk : i64 = self.a.extra[(nb + 4 + ai × 3) × 1¤ptrdiff]
                if not self.block_yields(ablk):
                    self.derr(self.a.extra[(nb + 3 + ai × 3) × 1¤ptrdiff], "this arm answers nothing on some path")
            if dflt ≠ ⁻1 and not self.block_yields(dflt):
                self.derr(tok, "the _ arm answers nothing on some path")
        if vwant ≠ ⁻1:
            self.settle_arms(id, tok, vals, settled, "match")

    // The arms of a match standing where a value is wanted are that
    // one value, so they say one type between them.  It is settled
    // exactly as an if's branches settle theirs -- which is why this
    // takes the values already collected rather than the arms.
    fn settle_arms(&mut self, id : i64, tok : i64, vals : i64[], settled0 : i64, what : str):
        let whose : str = "a " ⧺ what ⧺ " is one value, so its arms"
        let settled : mut i64 = settled0
        let arrives : mut bool = false
        let empties : mut bool = false
        foreach v := vals:
            if v ≠ ⁻1:
                arrives ← true
            if self.says_empty(v):
                empties ← true
        if not arrives:
            self.derr(tok, "a " ⧺ what ⧺ """ standing where a value is wanted answers on some path;
                                          " every arm of this one leaves instead""")
            self.set_type(id, TY_I64)
            return
        if settled = TY_UNIT:
            settled ← TY_I64
        if not ty_is_opt(settled) and empties:
            settled ← mk_oty(settled)
        foreach v := vals:
            self.ife_fits(tok, v, settled, whose)
        self.set_type(id, settled)

    fn check_entry_field(&mut self, id : i64, tok : i64):
        let fname := self.text(tok)
        if fname = "name":
            self.a.nb[id × 1¤ptrdiff] ← 0
            self.set_type(id, TY_STR)
        elif fname = "type":
            self.a.nb[id × 1¤ptrdiff] ← 1
            self.set_type(id, mk_ety(EI_FILETYPE))
        else:
            self.derr(tok, "an entry holds its name and its type; '" ⧺ fname ⧺ "' is neither")
            self.set_type(id, TY_I64)

    fn check_hlit(&mut self, id : i64, tok : i64, off : i64, want : i64):
        // the binding says what a dictionary holds; the literal fills it
        if not ty_is_hash(ty_strip_ref(want)):
            self.derr(tok, "state the dictionary's type where it is bound, as ': std.dict(K, V) ='")
            self.set_type(id, mk_hty(TY_I64, TY_I64))
            return
        let kt : i64 = ty_hkey(ty_strip_ref(want))
        let vt : i64 = ty_hval(ty_strip_ref(want))
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            let ke : i64 = self.a.extra[(off + 1 + i × 2) × 1¤ptrdiff]
            let ve : i64 = self.a.extra[(off + 2 + i × 2) × 1¤ptrdiff]
            self.check_expr(ke, kt)
            if self.is_open(self.ty_of(ke)):
                self.adopt(ke, kt)
            elif not self.try_fit(ke, kt):
                self.derr(tok, "the keys are " ⧺ self.tn(kt) ⧺ ", not " ⧺ self.tn(self.ty_of(ke)))
            self.check_expr(ve, vt)
            if self.is_open(self.ty_of(ve)):
                self.adopt(ve, vt)
            elif not self.try_fit(ve, vt):
                self.derr(tok, "the values are " ⧺ self.tn(vt) ⧺ ", not " ⧺ self.tn(self.ty_of(ve)))
        self.set_type(id, ty_strip_ref(want))

    // a dictionary key meets the declared key type
    fn check_hash_key(&mut self, tok : i64, hty : i64, ke : i64):
        let kt : i64 = ty_hkey(hty)
        self.check_expr(ke, kt)
        if self.is_open(self.ty_of(ke)):
            self.adopt(ke, kt)
        elif not self.try_fit(ke, kt):
            self.derr(tok, "this dictionary's keys are " ⧺ self.tn(kt) ⧺ ", not " ⧺ self.tn(self.ty_of(ke)))

    fn index_unit_of(&self, arr_ty : i64) → i64:
        // a string is counted in characters, and an index into one is
        // a count of them
        if arr_ty = TY_STR:
            return UNIT_PTRDIFF
        if ty_is_mat(arr_ty):
            return UNIT_PTRDIFF
        if ty_drop_unit(self.elem_of(arr_ty)) = TY_U8: UNIT_BYTE else: UNIT_PTRDIFF

    fn check_index_expr(&mut self, tok : i64, arr_ty : i64, idx : i64):
        // the subscript carries the array's measure, or is an untyped
        // literal, which is exempt as the spec has it
        self.check_expr(idx, ty_with_unit(TY_I64, self.index_unit_of(arr_ty)))
        let t : i64 = self.ty_of(idx)
        if t = TY_UNT:
            self.adopt(idx, TY_I64)
            return
        if not ty_is_int(t):
            self.derr(tok, "a subscript is a number, not " ⧺ self.tn(t))
            return
        if not self.stands_for(ty_unit(t), self.index_unit_of(arr_ty)):
            let uname : str = if self.index_unit_of(arr_ty) = UNIT_BYTE: "¤byte" else: "¤ptrdiff"
            self.derr(tok, "this array's subscript is measured " ⧺ uname ⧺ ", but the index is " ⧺ self.tn(t))

    fn check_index(&mut self, id : i64, tok : i64, na : i64, nb : i64):
        self.check_expr(na, TY_UNIT)
        let t : i64 = self.ty_of(na)
        if ty_is_tup(t):
            // heterogeneous elements: the asking number is written out,
            // so the answer's type is known where it is asked
            self.check_expr(nb, TY_UNIT)
            if self.kind_of(nb) ≠ NK_INT:
                self.derr(tok, "a tuple is asked with a written-out number, 0 to " ⧺ i64_str(self.tup_len(t) - 1))
                self.set_type(id, TY_I64)
                return
            if self.is_open(self.ty_of(nb)):
                self.adopt(nb, TY_I64)
            let ix : i64 = self.a.na[nb × 1¤ptrdiff]
            if ix < 0 or ix >= self.tup_len(t):
                self.derr(tok, "the tuple holds " ⧺ i64_str(self.tup_len(t)) ⧺ " elements; " ⧺ i64_str(ix) ⧺ " is not one of them")
                self.set_type(id, TY_I64)
                return
            self.set_type(id, self.tup_elem(t, ix))
            return
        if t = TY_STR:
            // a position in a string is a count of characters, and
            // what it names is a character
            self.check_expr(nb, TY_UNIT)
            let ti : i64 = self.ty_of(nb)
            if ti = TY_UNT:
                self.adopt(nb, ty_with_unit(TY_I64, UNIT_PTRDIFF))
            elif not ty_is_int(ti):
                self.derr(tok, "a subscript is a number, not " ⧺ self.tn(ti))
            elif ty_unit(ti) ≠ UNIT_PTRDIFF:
                self.derr(tok, "a string's subscript is measured ¤ptrdiff, but the index is " ⧺ self.tn(ti))
            self.set_type(id, TY_CHAR)
            return
        if ty_is_hash(t):
            // asking a dictionary answers an optional: absence is ordinary
            self.check_hash_key(tok, t, nb)
            self.set_type(id, mk_oty(ty_hval(t)))
            return
        if not ty_is_arr(t) and not ty_is_mat(t):
            self.derr(tok, "only an array, a dictionary or a string is subscripted; this is " ⧺ self.tn(t))
            self.set_type(id, TY_I64)
            return
        self.check_index_expr(tok, t, nb)
        self.set_type(id, self.elem_of(t))

    fn check_call(&mut self, id : i64, tok : i64, args_off : i64 ¤"aextra"):
        let name := self.text(tok)
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if name = "assert" or name = "assert_eq":
            self.check_assert(id, tok, args_off, argc, name = "assert_eq")
            return
        if name = "static_assert" or name = "static_assert_eq":
            self.check_static_assert(id, tok, args_off, name = "static_assert_eq")
            return
        if name = "generate" and self.fn_index("generate") = ⁻1:
            self.check_generate(id, tok, args_off, argc)
            return
        let vs9 : i64 = self.lookup(name)
        if vs9 ≠ ⁻1 and ty_is_lam(ty_strip_ref(self.stype[vs9 × 1¤ptrdiff])):
            self.check_lcall(id, tok, args_off, argc, vs9)
            return
        let gl9 : i64 = self.global_index(name)
        if gl9 ≠ ⁻1 and ty_is_lam(self.a.globals[gl9 × 1¤ptrdiff].ty):
            self.check_glcall(id, tok, args_off, argc, gl9)
            return
        // nb on a call names the module it was asked of, one past the
        // index, so 0 is a name written with no module in front of it
        let qm : i64 = self.a.nb[id × 1¤ptrdiff]
        if qm ≠ 0:
            self.check_qualified(id, tok, name, args_off, argc, qm)
            return
        let f : i64 = self.fn_index_here(name)
        if f = ⁻1:
            if self.is_build_name(name):
                self.derr(tok, "'" ⧺ name ⧺ """' is the @build function; it runs while the program
                                             " is built and cannot be called""")
            elif self.is_ignored_name(name):
                self.derr(tok, "'" ⧺ name ⧺ """' expects errors under @expect and was left
                                             " uncompiled""")
            else:
                self.derr(tok, "'" ⧺ name ⧺ "' is not a function this program defines")
            foreach i := 0…argc:
                self.check_expr(self.a.extra[args_off + 1 + i], TY_UNIT)
            self.set_type(id, TY_I64)
            return
        self.check_resolved(id, tok, name, args_off, argc, f)

    // The rest of a call, once which function it is has been settled --
    // by walking out through the modules for a bare name, or by asking
    // the module a qualified one named.  The checks from here on are
    // the same either way.
    fn check_resolved(&mut self, id : i64, tok : i64, name : str,
                      args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff, f : i64):
        let callee := self.a.fns[f × 1¤ptrdiff]
        if callee.is_impure and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "'" ⧺ name ⧺ "' is @impure, and impurity travels to the caller")
        if self.in_contract and callee.is_impure:
            self.derr(tok, "a contract's condition is pure; '" ⧺ name ⧺ "' is not")
        if callee.is_replaceable and self.scope_floor > 0:
            self.derr(tok, "'" ⧺ name ⧺ """' is @replaceable and not captured; a lambda lists it in
                                         " |…|""")
        if self.fdone[f × 1¤ptrdiff] = 2 and self.fn_is_generic(f):
            self.derr(tok, "a generic function cannot shape itself; the recursion never settles")
            self.set_type(id, TY_I64)
            return
        if self.fdone[f × 1¤ptrdiff] = 0 and self.fn_is_generic(f):
            self.instantiate(id, tok, f, args_off, argc)
            return
        let np : i64 ¤ptrdiff = self.a.extra[callee.params_off] × 1¤ptrdiff
        if argc < np:
            // fewer arguments curry: what is given is bound now, by
            // value, and what answers waits for the rest
            self.check_partial(id, tok, f, args_off, argc)
            return
        if argc ≠ np:
            self.derr(tok, "'" ⧺ name ⧺ "' wants " ⧺ i64_str(@dropunit(np)) ⧺ " arguments, not " ⧺ i64_str(@dropunit(argc)))
            self.set_type(id, callee.ret)
            return
        let j : mut i64 ¤ptrdiff = 0
        let threads : mut bool = false
        while j < np:
            let arg : i64 = self.a.extra[args_off + 1 + j]
            let pty : i64 = self.a.extra[callee.params_off + 2 + j × 2]
            if callee.is_listable:
                let one : bool = self.check_listable_arg(tok, name, @dropunit(j) + 1, arg, pty)
                threads ← threads or one
            else:
                self.check_one_arg(tok, name, @dropunit(j) + 1, arg, pty)
            j ← j + 1
        self.check_alias(tok, name, ⁻1, args_off, argc, callee.params_off, 0)
        self.call_escapes(args_off, argc, callee.params_off, ⁻1, 0,
                          callee.is_impure, callee.ret)
        self.settle_pre(tok, name, f, args_off, argc)
        if threads:
            // what the return type states is what one element answers,
            // and the caller receives a container of them
            if ty_is_arr(callee.ret):
                self.derr(tok, "'" ⧺ name ⧺ "' is @listable and answers " ⧺ self.tn(callee.ret) ⧺ "; a listable answer is one element's, so an array of arrays is not core-2")
                self.set_type(id, callee.ret)
                return
            self.set_type(id, mk_aty(callee.ret))
            return
        self.set_type(id, callee.ret)

    // `mod.name(args)`: the module says where to look, so the walk out
    // through the enclosing modules does not happen, and what the
    // module did not export cannot be named from outside it.
    fn check_qualified(&mut self, id : i64, tok : i64, name : str,
                       args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff, qm : i64):
        let path : str = self.a.qmods[(qm - 1) × 1¤ptrdiff]
        let whole : str = path ⧺ "." ⧺ name
        let f : i64 = self.fn_in(whole)
        if f = ⁻1:
            self.derrc(tok, 2910, "module '" ⧺ path ⧺ "' defines no '" ⧺ name ⧺ "'")
            foreach i := 0…argc:
                self.check_expr(self.a.extra[args_off + 1 + i], TY_UNIT)
            self.set_type(id, TY_I64)
            return
        if not self.a.fns[f × 1¤ptrdiff].is_export and not mod_within(self.curmod, path):
            self.derrc(tok, 2911, "'" ⧺ whole ⧺ "' is not exported from module '" ⧺ path ⧺ "'; @export says what a module lets others name")
        self.check_resolved(id, tok, name, args_off, argc, f)

    // f(a) with fewer arguments than 'f' has parameters: a partial,
    // one shim per site, the bound values in the box
    fn check_partial(&mut self, id : i64, tok : i64, f : i64,
                     args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff):
        let callee := self.a.fns[f × 1¤ptrdiff]
        let np : i64 ¤ptrdiff = self.a.extra[callee.params_off] × 1¤ptrdiff
        let ok9 : mut bool = np <= 5 and fnval_ret_ok(callee.ret) and not callee.is_impure and not callee.is_replaceable
        let pts9 : mut i64[] = []
        foreach pi := 0…np:
            let pty : i64 = self.a.extra[callee.params_off + 2 + pi × 2]
            ok9 ← ok9 and ty_ref_kind(pty) = 0 and ((ty_is_int(pty) and ty_unit(pty) = 0) or pty = TY_BOOL or pty = TY_CHAR or pty = TY_STR)
            pts9.push(ty_strip_ref(pty))
        if not ok9:
            self.derr(tok, "'" ⧺ callee.name ⧺ """' does not curry; only a pure function of up to
                                                " five plain scalars does""")
            self.set_type(id, TY_I64)
            return
        if argc > 0:
            foreach j := 0…argc:
                let arg : i64 = self.a.extra[args_off + 1 + j]
                let pt : i64 = pts9[j]
                self.check_expr(arg, pt)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, pt)
                elif not self.fit_arg(arg, pt):
                    self.derr(tok, "argument " ⧺ i64_str(@dropunit(j) + 1) ⧺ " is " ⧺ self.tn(self.ty_of(arg)) ⧺ ", but the parameter says " ⧺ self.tn(pt))
        let rem : mut i64[] = []
        foreach j := argc…np:
            rem.push(pts9[j])
        self.a.nc[id × 1¤ptrdiff] ← 3
        self.a.nb[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.psfn.push(f)
        self.psk.push(@dropunit(argc))
        self.psnp.push(@dropunit(np))
        self.set_type(id, mk_lty(self.lam_intern(rem, callee.ret, if callee.is_listable: 1 else: 0)))

    // the one call that reaches a generic first gives it its shape:
    // each type variable takes its argument's type, the body is then
    // checked concrete, and every later call meets an ordinary function
    fn instantiate(&mut self, id : i64, tok : i64, f : i64,
                   args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff):
        let callee := self.a.fns[f × 1¤ptrdiff]
        let np : i64 ¤ptrdiff = self.a.extra[callee.params_off] × 1¤ptrdiff
        if argc ≠ np:
            self.derr(tok, "'" ⧺ callee.name ⧺ "' wants " ⧺ i64_str(@dropunit(np)) ⧺ " arguments, not " ⧺ i64_str(@dropunit(argc)))
            self.set_type(id, TY_I64)
            return
        let vmap : mut i64[] = []
        foreach vi := 0…32:
            vmap.push(⁻1)
        foreach j := 0…np:
            let arg : i64 = self.a.extra[args_off + 1 + j]
            let pty : i64 = self.a.extra[callee.params_off + 2 + j × 2]
            if ty_is_var(ty_strip_ref(pty)):
                self.check_expr(arg, TY_UNIT)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, TY_I64)
                let at9 : i64 = self.ty_of(arg)
                if ty_ref_kind(at9) ≠ 0 or at9 = TY_UNIT or at9 = TY_EMPTY:
                    self.derr(tok, "this argument cannot shape a type variable")
                let vix : i64 = ty_strip_ref(pty) - 194048
                if vmap[vix × 1¤ptrdiff] = ⁻1:
                    vmap[vix × 1¤ptrdiff] ← at9
                elif vmap[vix × 1¤ptrdiff] ≠ at9:
                    self.derr(tok, "one type variable, one type; it is handed " ⧺ self.tn(vmap[vix × 1¤ptrdiff]) ⧺ " and " ⧺ self.tn(at9) ⧺ " at once")
                self.a.extra[callee.params_off + 2 + j × 2] ← vmap[vix × 1¤ptrdiff]
            else:
                self.check_one_arg(tok, callee.name, @dropunit(j) + 1, arg, pty)
        self.check_alias(tok, callee.name, ⁻1, args_off, argc, callee.params_off, 0)
        self.call_escapes(args_off, argc, callee.params_off, ⁻1, 0,
                          callee.is_impure, callee.ret)
        if ty_is_var(callee.ret):
            let rix : i64 = callee.ret - 194048
            if vmap[rix × 1¤ptrdiff] ≠ ⁻1:
                self.a.fns[f × 1¤ptrdiff].ret ← vmap[rix × 1¤ptrdiff]
        // the caller's scopes are parked while the shaped body checks
        let sv_names : mut str[] = []
        foreach v := self.snames:
            sv_names.push(v)
        let sv_type : mut i64[] = []
        foreach v := self.stype:
            sv_type.push(v)
        let sv_mut : mut i64[] = []
        foreach v := self.smut:
            sv_mut.push(v)
        let sv_slot : mut i64[] = []
        foreach v := self.sslot:
            sv_slot.push(v)
        let sv_held : mut i64[] = []
        foreach v := self.sheld:
            sv_held.push(v)
        let sv_marks : mut i64[] = []
        foreach v := self.marks:
            sv_marks.push(v)
        let sv_hslot : mut i64[] = []
        foreach v := self.hslot:
            sv_hslot.push(v)
        let sv_hback : mut i64[] = []
        foreach v := self.hback:
            sv_hback.push(v)
        let sv_hmark : mut i64[] = []
        foreach v := self.hmark:
            sv_hmark.push(v)
        let sv_nslots : i64 = self.nslots
        let sv_cur : i64 = self.cur_fn
        let sv_loop : i64 = self.loop_depth
        let sv_floor : i64 = self.scope_floor
        let sv_inc : bool = self.in_contract
        self.scope_floor ← 0
        self.fdone[f × 1¤ptrdiff] ← 2
        self.check_fn(f)
        while #self.snames > 0:
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0
            _ ← self.sheld.pop() ?? 0
        while #self.marks > 0:
            _ ← self.marks.pop() ?? 0
        while #self.hslot > 0:
            _ ← self.hslot.pop() ?? 0
            _ ← self.hback.pop() ?? 0
        while #self.hmark > 0:
            _ ← self.hmark.pop() ?? 0
        foreach v := sv_names:
            self.snames.push(v)
        foreach v := sv_type:
            self.stype.push(v)
        foreach v := sv_mut:
            self.smut.push(v)
        foreach v := sv_slot:
            self.sslot.push(v)
        foreach v := sv_held:
            self.sheld.push(v)
        foreach v := sv_marks:
            self.marks.push(v)
        foreach v := sv_hslot:
            self.hslot.push(v)
        foreach v := sv_hback:
            self.hback.push(v)
        foreach v := sv_hmark:
            self.hmark.push(v)
        self.nslots ← sv_nslots
        self.cur_fn ← sv_cur
        self.loop_depth ← sv_loop
        self.scope_floor ← sv_floor
        self.in_contract ← sv_inc
        let shaped := self.a.fns[f × 1¤ptrdiff]
        if ty_is_var(shaped.ret):
            self.derr(tok, "'" ⧺ shaped.name ⧺ "' never settles what it answers")
            self.set_type(id, TY_I64)
            return
        self.set_type(id, shaped.ret)

    // calling through a global's box: as through a binding's, with the
    // box loaded from the global's slot
    fn check_glcall(&mut self, id : i64, tok : i64, args_off : i64 ¤"aextra",
                    argc : i64 ¤ptrdiff, g : i64):
        let lt : i64 = self.a.globals[g × 1¤ptrdiff].ty
        let np : i64 ¤ptrdiff = self.lam_np(lt) × 1¤ptrdiff
        if argc > np:
            self.derr(tok, "this function wants " ⧺ i64_str(@dropunit(np)) ⧺ " arguments, not " ⧺ i64_str(@dropunit(argc)))
            self.set_type(id, self.lam_ret(lt))
            return
        if argc > 0:
            foreach j := 0…argc:
                let arg : i64 = self.a.extra[args_off + 1 + j]
                let pt : i64 = self.lam_pt(lt, j)
                self.check_expr(arg, pt)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, pt)
                elif not self.fit_arg(arg, pt):
                    self.derr(tok, "argument " ⧺ i64_str(@dropunit(j) + 1) ⧺ " is " ⧺ self.tn(self.ty_of(arg)) ⧺ ", but the function takes " ⧺ self.tn(pt))
        if argc = np:
            self.a.nc[id × 1¤ptrdiff] ← 6
            self.nslot[id × 1¤ptrdiff] ← g
            self.set_type(id, self.lam_ret(lt))
            return
        if argc = 0:
            self.a.nc[id × 1¤ptrdiff] ← 7
            self.nslot[id × 1¤ptrdiff] ← g
            self.set_type(id, lt)
            return
        let rem : mut i64[] = []
        foreach j := argc…np:
            rem.push(self.lam_pt(lt, j))
        self.a.nc[id × 1¤ptrdiff] ← 8
        self.a.nb[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.nslot[id × 1¤ptrdiff] ← g
        self.psfn.push(⁻1)
        self.psk.push(@dropunit(argc))
        self.psnp.push(@dropunit(np))
        self.set_type(id, mk_lty(self.lam_intern(rem, self.lam_ret(lt), if self.lam_listable(lt): 1 else: 0)))

    fn check_lcall(&mut self, id : i64, tok : i64, args_off : i64 ¤"aextra",
                   argc : i64 ¤ptrdiff, vs : i64):
        // calling what a name holds reads the name, as reading it any
        // other way would
        self.life_used(self.sslot[vs × 1¤ptrdiff])
        let lt : i64 = ty_strip_ref(self.stype[vs × 1¤ptrdiff])
        let np : i64 ¤ptrdiff = self.lam_np(lt) × 1¤ptrdiff
        if argc > np:
            self.derr(tok, "this function wants " ⧺ i64_str(@dropunit(np)) ⧺ " arguments, not " ⧺ i64_str(@dropunit(argc)))
            self.set_type(id, self.lam_ret(lt))
            return
        let threads : mut bool = false
        if argc > 0:
            foreach j := 0…argc:
                let arg : i64 = self.a.extra[args_off + 1 + j]
                let pt : i64 = self.lam_pt(lt, j)
                if self.lam_listable(lt):
                    let one : bool = self.check_listable_arg(tok, "this function", @dropunit(j) + 1, arg, pt)
                    threads ← threads or one
                else:
                    self.check_expr(arg, pt)
                    if self.is_open(self.ty_of(arg)):
                        self.adopt(arg, pt)
                    elif not self.fit_arg(arg, pt):
                        self.derr(tok, "argument " ⧺ i64_str(@dropunit(j) + 1) ⧺ " is " ⧺ self.tn(self.ty_of(arg)) ⧺ ", but the function takes " ⧺ self.tn(pt))
        if argc = np:
            self.a.nc[id × 1¤ptrdiff] ← 1
            self.nslot[id × 1¤ptrdiff] ← self.sslot[vs × 1¤ptrdiff]
            self.nlam[id × 1¤ptrdiff] ← lt
            if threads:
                if ty_is_arr(self.lam_ret(lt)):
                    self.derr(tok, "this function is @listable and answers " ⧺ self.tn(self.lam_ret(lt)) ⧺ "; a listable answer is one element's, so an array of arrays is not core-2")
                    self.set_type(id, self.lam_ret(lt))
                    return
                self.set_type(id, mk_aty(self.lam_ret(lt)))
                return
            self.set_type(id, self.lam_ret(lt))
            return
        if argc = 0:
            // applying nothing changes nothing: the box itself answers
            self.a.nc[id × 1¤ptrdiff] ← 5
            self.nslot[id × 1¤ptrdiff] ← self.sslot[vs × 1¤ptrdiff]
            self.set_type(id, lt)
            return
        // some arguments: bind them now, wait for the rest
        let rem : mut i64[] = []
        foreach j := argc…np:
            rem.push(self.lam_pt(lt, j))
        self.a.nc[id × 1¤ptrdiff] ← 4
        self.a.nb[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.nslot[id × 1¤ptrdiff] ← self.sslot[vs × 1¤ptrdiff]
        self.psfn.push(⁻1)
        self.psk.push(@dropunit(argc))
        self.psnp.push(@dropunit(np))
        self.set_type(id, mk_lty(self.lam_intern(rem, self.lam_ret(lt), if self.lam_listable(lt): 1 else: 0)))

    // generate(f, r): f maps each of the range's steps to an element
    fn check_generate(&mut self, id : i64, tok : i64, args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff):
        if argc ≠ 2:
            self.derr(tok, "generate takes the function and the range")
            self.set_type(id, mk_aty(TY_I64))
            return
        let fe : i64 = self.a.extra[args_off + 1]
        let re : i64 = self.a.extra[args_off + 2]
        self.check_expr(fe, TY_UNIT)
        let ft : i64 = self.ty_of(fe)
        if not ty_is_lam(ft):
            self.derr(tok, "generate's first argument is a function; this is " ⧺ self.tn(ft))
            self.check_expr(re, TY_UNIT)
            self.set_type(id, mk_aty(TY_I64))
            return
        if self.lam_np(ft) ≠ 1:
            self.derr(tok, "generate maps one value at a time; this function takes " ⧺ i64_str(self.lam_np(ft)))
            self.check_expr(re, TY_UNIT)
            self.set_type(id, mk_aty(self.lam_ret(ft)))
            return
        let pt : i64 = self.lam_pt(ft, 0)
        if not ty_is_int(pt):
            self.derr(tok, """generate walks a range, so the function takes a number; this one takes
                            " """ ⧺ self.tn(pt))
        self.check_expr(re, pt)
        let rt : i64 = self.ty_of(re)
        if not ty_is_rg(rt):
            self.derrc(tok, 2253, "generate's second argument must be a range; this is " ⧺ self.tn(rt))
        elif ty_rgelem(rt) ≠ pt:
            self.derr(tok, "the range counts " ⧺ self.tn(ty_rgelem(rt)) ⧺ ", but the function takes " ⧺ self.tn(pt))
        self.a.nc[id × 1¤ptrdiff] ← 2
        self.set_type(id, mk_aty(self.lam_ret(ft)))

    // a ⊑ b and a ⊒ b: whether a runs along the front of b, or along
    // its back.  Both sides are sequences of the same thing -- two
    // strings, or two arrays of one element type -- and the answer is
    // a truth however long either of them is.
    fn check_run(&mut self, id : i64, tok : i64, ae : i64, be : i64, back : i64):
        let g : str = if back = 1: "⊒" else: "⊑"
        self.set_type(id, TY_BOOL)
        self.check_expr(ae, TY_UNIT)
        let at9 : i64 = self.ty_of(ae)
        self.check_expr(be, at9)
        let bt : i64 = self.ty_of(be)
        if at9 = TY_STR and bt = TY_STR:
            return
        let aseq : bool = ty_is_arr(at9) or ty_is_row(at9)
        let bseq : bool = ty_is_arr(bt) or ty_is_row(bt)
        if not aseq or not bseq:
            self.derr(tok, g ⧺ " lays one sequence against another; this is " ⧺ self.tn(at9) ⧺ " and " ⧺ self.tn(bt))
            return
        if ty_elem(at9) ≠ ty_elem(bt):
            self.derr(tok, g ⧺ " lays sequences of one thing against each other; the left holds " ⧺ self.tn(ty_elem(at9)) ⧺ " and the right holds " ⧺ self.tn(ty_elem(bt)))
    // f ∀ v and f ∃ v: whether f holds of every one of the things v
    // holds, and whether it holds of any.  The shape generate has --
    // a function of one value on the left, what it is asked about on
    // the right -- with the answer a bool rather than an array of the
    // answers, and the walk stopping where it can.
    fn check_quant(&mut self, id : i64, tok : i64, fe : i64, ce : i64, kind : i64):
        let g : str = if kind = 1: "∃" else: (if kind = 2: "∄" else: "∀")
        self.set_type(id, TY_BOOL)
        self.check_expr(fe, TY_UNIT)
        let ft : i64 = self.ty_of(fe)
        if not ty_is_lam(ft):
            self.derr(tok, g ⧺ """ asks something of each of them, so what stands on its left is a
                                " function; this is """ ⧺ self.tn(ft))
            self.check_expr(ce, TY_UNIT)
            return
        if self.lam_np(ft) ≠ 1:
            self.derr(tok, g ⧺ " asks about one value at a time; this function takes " ⧺ i64_str(self.lam_np(ft)))
            self.check_expr(ce, TY_UNIT)
            return
        // What it answers is the whole of what the operator answers,
        // so a function that answers anything else is refused here
        // rather than having its answer read as a truth.
        if self.lam_ret(ft) ≠ TY_BOOL:
            self.derr(tok, g ⧺ """ asks a question of each of them, so what it asks has to answer a
                                " bool; this answers """ ⧺ self.tn(self.lam_ret(ft)))
        let pt : i64 = self.lam_pt(ft, 0)
        self.check_expr(ce, mk_aty(pt))
        let ct : i64 = self.ty_of(ce)
        // an array of what it takes, or a range counting in it
        if ty_is_rg(ct):
            if ty_rgelem(ct) ≠ pt:
                self.derr(tok, "the range counts " ⧺ self.tn(ty_rgelem(ct)) ⧺ ", but the function takes " ⧺ self.tn(pt))
            // the fourth bit says the container is a range, which the
            // lowering walks as the array of its steps
            self.a.nc[id × 1¤ptrdiff] ← kind + 4
            return
        if not ty_is_arr(ct) and not ty_is_row(ct):
            self.derr(tok, g ⧺ " asks about each of an array or a range; this is " ⧺ self.tn(ct))
            return
        if ty_elem(ct) ≠ pt:
            self.derr(tok, "the array holds " ⧺ self.tn(ty_elem(ct)) ⧺ ", but the function takes " ⧺ self.tn(pt))
        self.a.nc[id × 1¤ptrdiff] ← kind
    // (expr)(args): the callee is a value, so the box travels as the
    // expression's own answer rather than out of a named slot
    fn check_callv(&mut self, id : i64, tok : i64, na : i64, args_off : i64 ¤"aextra"):
        self.check_expr(na, TY_UNIT)
        let lt : i64 = self.ty_of(na)
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if not ty_is_lam(lt):
            self.derr(tok, "only a function value is applied; this is " ⧺ self.tn(lt))
            if argc > 0:
                foreach j := 0…argc:
                    self.check_expr(self.a.extra[args_off + 1 + j], TY_UNIT)
            self.set_type(id, TY_I64)
            return
        let np : i64 ¤ptrdiff = self.lam_np(lt) × 1¤ptrdiff
        if argc > np:
            self.derr(tok, "this function wants " ⧺ i64_str(@dropunit(np)) ⧺ " arguments, not " ⧺ i64_str(@dropunit(argc)))
            self.set_type(id, self.lam_ret(lt))
            return
        if argc > 0:
            foreach j := 0…argc:
                let arg : i64 = self.a.extra[args_off + 1 + j]
                let pt : i64 = self.lam_pt(lt, j)
                self.check_expr(arg, pt)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, pt)
                elif not self.fit_arg(arg, pt):
                    self.derr(tok, "argument " ⧺ i64_str(@dropunit(j) + 1) ⧺ " is " ⧺ self.tn(self.ty_of(arg)) ⧺ ", but the function takes " ⧺ self.tn(pt))
        if argc = np:
            self.a.nc[id × 1¤ptrdiff] ← 1
            self.set_type(id, self.lam_ret(lt))
            return
        if argc = 0:
            self.a.nc[id × 1¤ptrdiff] ← 5
            self.set_type(id, lt)
            return
        let rem : mut i64[] = []
        foreach j := argc…np:
            rem.push(self.lam_pt(lt, j))
        self.a.nc[id × 1¤ptrdiff] ← 4
        self.nslot[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.psfn.push(⁻1)
        self.psk.push(@dropunit(argc))
        self.psnp.push(@dropunit(np))
        self.set_type(id, mk_lty(self.lam_intern(rem, self.lam_ret(lt), if self.lam_listable(lt): 1 else: 0)))

    // Whether handing this type over by value hands over the thing
    // itself.  A number is copied and two parameters holding one are
    // two numbers; an array, a dictionary, a matrix and a struct are
    // reached through, so passing one costs nothing and the callee sees
    // the caller's own -- which is fine while nothing can change it, and
    // is why the copy is elided.
    fn shares_by_value(&self, t : i64) → bool:
        let b : i64 = ty_strip_ref(t)
        ty_is_arr(b) or ty_is_hash(b) or ty_is_mat(b) or ty_is_struct(b)

    // Whether a value of this type can be copied at a call, for the one
    // case where the copy cannot be elided.  An array of numbers,
    // characters or strings can: its elements are values, so copying
    // the slots copies the array.  An array of arrays or of structs
    // cannot, because copying the slots would leave the elements
    // shared, and neither can a struct or a dictionary, for want of
    // anything to copy them with.  Those are refused rather than
    // half-copied; see TODO-compiler.md.
    fn copyable_by_value(&self, t : i64) → bool:
        let b : i64 = ty_strip_ref(t)
        if not ty_is_arr(b):
            return false
        let e : i64 = self.elem_of(b)
        ty_is_int(e) or e = TY_BOOL or e = TY_CHAR or e = TY_STR

    // Two parameters that reach one binding, where at least one of them
    // may change it.
    //
    // Two borrows are refused.  A function is written as though its
    // parameters were separate things, and every line of it is read
    // that way; handed one thing twice with a writer among them they
    // are not separate, and nothing the body does can be relied on --
    // `a.push(1)` may move what `b` points at.  There is no way to
    // write the callee that makes this safe, so it is refused at the
    // call, which is the one place both arguments can be seen at once.
    //
    // A by-value parameter is a different matter, because by value
    // means a copy.  The copy is elided everywhere it cannot be
    // noticed -- which is everywhere a `&mut` of the same thing is not
    // in the same call, since a `mut` container parameter is refused
    // and so a by-value one is never written through.  Here it can be
    // noticed, so here the copy is made, and lower_call makes it.
    // What is refused is only the type the compiler has no copy for.
    //
    // Two shared borrows of one thing are fine: reading does not
    // conflict with reading.
    fn check_alias(&mut self, tok : i64, name : str, recv : i64,
                   args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff, params_off : i64 ¤"aextra",
                   self_n : i64 ¤ptrdiff):
        let n : i64 ¤ptrdiff = argc + self_n
        if n < 2:
            return
        // what each parameter reaches, and whether it may change it
        let bases : mut i64[] = []
        let muts : mut i64[] = []
        let refs : mut i64[] = []
        let ptys : mut i64[] = []
        if self_n = 1:
            let rty : i64 = self.a.extra[params_off + 2]
            let rrk : i64 = ty_ref_kind(rty)
            bases.push(if rrk ≠ 0 or self.shares_by_value(rty): self.base_slot(recv) else: ⁻1)
            muts.push(if rrk = 2: 1 else: 0)
            refs.push(if rrk ≠ 0: 1 else: 0)
            ptys.push(rty)
        foreach j := 0…argc:
            let arg : i64 = self.a.extra[args_off + 1 + j]
            let pty : i64 = self.a.extra[params_off + 2 + (j + self_n) × 2]
            let rk : i64 = ty_ref_kind(pty)
            let inner : i64 = if self.kind_of(arg) = NK_REF: self.a.na[arg × 1¤ptrdiff] else: arg
            bases.push(if rk ≠ 0 or self.shares_by_value(pty): self.base_slot(inner) else: ⁻1)
            muts.push(if rk = 2: 1 else: 0)
            refs.push(if rk ≠ 0: 1 else: 0)
            ptys.push(pty)
        assert(@dropunit(#bases) = n, "one claim per parameter")
        // every pair once: a stops one short of the last, b runs past it
        foreach a := 0…n - 1:
            foreach b := a + 1…n:
                let ba : i64 = bases[a]
                if ba ≠ ⁻1 and ba = bases[b] and (muts[a] = 1 or muts[b] = 1):
                    // one of the two is by value: it is a copy, so the
                    // two are separate after all -- provided a copy can
                    // be made
                    let bycopy : i64 ¤ptrdiff = if muts[a] = 0 or muts[b] = 0: (if muts[a] = 0: a else: b) else: ⁻1
                    if bycopy ≠ ⁻1 and refs[bycopy] = 0:
                        if not self.copyable_by_value(ptys[bycopy]):
                            self.derrc(tok, 2403, self.arg_word(bycopy, self_n) ⧺ " of '" ⧺ name ⧺ "' is '" ⧺ self.snames[ba × 1¤ptrdiff] ⧺ "' by value and " ⧺ self.arg_word(if bycopy = b: a else: b, self_n) ⧺ " may change it, so the copy that by value means cannot be elided -- and " ⧺ self.tn(ptys[bycopy]) ⧺ " is a type this compiler has no copy for yet")
                        elif bycopy >= self_n:
                            self.argcopy.push(self.a.extra[args_off + 1 + bycopy - self_n])
                    else:
                        self.derrc(tok, 2402, self.arg_word(a, self_n) ⧺ " and " ⧺ self.arg_word(b, self_n) ⧺ " of '" ⧺ name ⧺ "' are both '" ⧺ self.snames[ba × 1¤ptrdiff] ⧺ "', and one of them may change it; a function is written as though its parameters were separate things, and two names for one thing that may change is not something the body can be written against")

    fn arg_word(&self, i : i64 ¤ptrdiff, self_n : i64 ¤ptrdiff) → str:
        if self_n = 1 and i = 0:
            return "the receiver"
        "argument " ⧺ i64_str(@dropunit(i + 1 - self_n))

    // One argument of a listable call.  Answers whether it is one of
    // the containers the call is threaded over: an array where the
    // parameter asked for one of the things in it.  A borrowed
    // parameter is never threaded -- what it borrows is the thing
    // itself -- and neither is an argument that is already what was
    // asked for.
    fn check_listable_arg(&mut self, tok : i64, name : str, num : i64,
                          arg : i64, pty : i64) → bool:
        let base : i64 = ty_strip_ref(pty)
        if ty_ref_kind(pty) ≠ 0 or self.kind_of(arg) = NK_REF:
            self.check_one_arg(tok, name, num, arg, pty)
            return false
        self.check_expr(arg, base)
        let at : i64 = ty_strip_ref(self.ty_of(arg))
        if ty_is_arr(at) and not ty_is_arr(base):
            let et : i64 = self.elem_of(at)
            if et ≠ base:
                self.derr(tok, "argument " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' holds " ⧺ self.tn(et) ⧺ ", and the parameter says " ⧺ self.tn(base) ⧺ "; a listable call is asked of each of the things in a container")
            return true
        if self.is_open(self.ty_of(arg)):
            self.adopt(arg, base)
        elif not self.fit_arg(arg, base):
            self.derr(tok, "argument " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' is " ⧺ self.tn(self.ty_of(arg)) ⧺ ", but the parameter says " ⧺ self.tn(base))
        false

    // A call written with constants says everything the callee's @pre
    // needs, so the condition can be read where the call is written
    // rather than at the first call that reaches it -- and a wrong one
    // is then reported whether or not that call is ever reached.
    //
    // The machinery is static_assert's: the arguments have been folded
    // by the time they are looked at, so what is left is to read the
    // condition with the parameters standing for them.
    fn settle_pre(&mut self, tok : i64, name : str, f : i64,
                  args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff):
        let callee := self.a.fns[f × 1¤ptrdiff]
        if callee.pre_off = ⁻1:
            return
        let np : i64 ¤ptrdiff = self.a.extra[callee.params_off] × 1¤ptrdiff
        if argc ≠ np:
            return
        // What each argument is.  A literal is one; so is arithmetic
        // over literals, which is not folded here -- the parameter's
        // type reaches the operands, so they settle rather than fold --
        // and is read for its value instead.
        let none : i64[] = []
        let vals : mut i64[] = []
        foreach i := 0…argc:
            let v : i64 = self.pre_const(self.a.extra[args_off + 1 + i], 0, 0, none)
            if v = PRE_UNKNOWN:
                // not known before anything runs; the condition is read
                // at the call, as it always was
                return
            vals.push(v)
        let n : i64 ¤ptrdiff = self.a.extra[callee.pre_off] × 1¤ptrdiff
        foreach j := 0…n:
            let c : i64 = self.a.extra[callee.pre_off + 1 + j]
            let v : i64 = self.pre_const(c, callee.params_off, np, vals)
            if v = 0:
                self.derrc(tok, 2619, "'" ⧺ name ⧺ """': a precondition does not hold for this call,
                                                    " whose arguments are known before anything runs""")
                return

    // The value a condition answers where the parameters stand for the
    // constants written at the call, or PRE_UNKNOWN where it says
    // something this cannot read.  A truth value answers 1 or 0, which
    // is what the caller above tests; anything unreadable answers
    // neither and is left to the run.
    // The node kinds a condition is read through: a comparison or an
    // arithmetic operator, each of which holds a left and a right.
    fn pre_reads(&self, k : i64) → bool:
        if k = NK_EQ or k = NK_NE or k = NK_LT or k = NK_LE:
            return true
        if k = NK_GT or k = NK_GE or k = NK_ADD or k = NK_SUB:
            return true
        k = NK_MUL or k = NK_DIV or k = NK_MOD

    fn pre_const(&self, e : i64, poff : i64 ¤"aextra", np : i64 ¤ptrdiff, vals : i64[]) → i64:
        let k : i64 = self.kind_of(e)
        let na : i64 = self.a.na[e × 1¤ptrdiff]
        let nb : i64 = self.a.nb[e × 1¤ptrdiff]
        if k = NK_INT or k = NK_BOOL:
            return na
        if k = NK_VAR:
            let nm := self.text(self.a.ntok[e × 1¤ptrdiff])
            foreach i := 0…np:
                if self.text(self.a.extra[poff + 1 + i × 2]) = nm:
                    return vals[i]
            return PRE_UNKNOWN
        if k = NK_NOT:
            let a : i64 = self.pre_const(na, poff, np, vals)
            if a = PRE_UNKNOWN:
                return PRE_UNKNOWN
            return if a = 0: 1 else: 0
        if k = NK_NEG:
            let a : i64 = self.pre_const(na, poff, np, vals)
            if a = PRE_UNKNOWN:
                return PRE_UNKNOWN
            return 0 - a
        if k = NK_AND or k = NK_OR:
            let a : i64 = self.pre_const(na, poff, np, vals)
            if a = PRE_UNKNOWN:
                return PRE_UNKNOWN
            // short-circuit: the settled side may answer alone
            if k = NK_AND and a = 0:
                return 0
            if k = NK_OR and a ≠ 0:
                return 1
            let b : i64 = self.pre_const(nb, poff, np, vals)
            if b = PRE_UNKNOWN:
                return PRE_UNKNOWN
            return if b = 0: 0 else: 1
        // What is left holds a left and a right, and the sides are
        // read below.  A condition may also be written with what this
        // cannot read -- a call, a length, an element -- and such a
        // node has no second side, so the kind is settled before the
        // sides are rather than after.
        if not self.pre_reads(k):
            return PRE_UNKNOWN
        let a : i64 = self.pre_const(na, poff, np, vals)
        if a = PRE_UNKNOWN:
            return PRE_UNKNOWN
        let b : i64 = self.pre_const(nb, poff, np, vals)
        if b = PRE_UNKNOWN:
            return PRE_UNKNOWN
        if k = NK_EQ:
            return if a = b: 1 else: 0
        if k = NK_NE:
            return if a ≠ b: 1 else: 0
        if k = NK_LT:
            return if a < b: 1 else: 0
        if k = NK_LE:
            return if a <= b: 1 else: 0
        if k = NK_GT:
            return if a > b: 1 else: 0
        if k = NK_GE:
            return if a >= b: 1 else: 0
        if k = NK_ADD:
            return a + b
        if k = NK_SUB:
            return a - b
        if k = NK_MUL:
            return a × b
        if k = NK_DIV or k = NK_MOD:
            // a zero divisor is a question with no answer; the run has
            // its own thing to say about it
            if b = 0:
                return PRE_UNKNOWN
            return if k = NK_DIV: (a ÷ b) ?? 0 else: (a % b) ?? 0
        PRE_UNKNOWN

    // What is always true of one of a type.  The condition names the
    // fields, and it is read wherever one of these is made or changed
    // rather than in any one frame -- so a field's name is turned into
    // a reference by index, which every site can answer for itself.
    fn check_invariants(&mut self, si : i64):
        let d := self.a.structs[si × 1¤ptrdiff]
        if d.inv_off = ⁻1:
            return
        let n : i64 ¤ptrdiff = self.a.extra[d.inv_off] × 1¤ptrdiff
        let sty : i64 = mk_sty(si)
        foreach j := 0…n:
            let c : i64 = self.a.extra[d.inv_off + 1 + j]
            self.bind_ifields(c, si)
            self.check_expr(c, TY_UNIT)
            self.want_truthy(c, "@invariant")
        _ ← sty

    // Turn every bare name the condition uses that is a field of this
    // struct into a reference to that field by index.  A walk of the
    // written expression: a name is a leaf, so what has to be reached
    // is every child of every node the condition can be made of.
    fn bind_ifields(&mut self, e : i64, si : i64):
        if e = ⁻1:
            return
        let k : i64 = self.kind_of(e)
        if k = NK_VAR:
            let nm := self.text(self.a.ntok[e × 1¤ptrdiff])
            let fi : i64 = self.field_index(si, nm)
            if fi ≠ ⁻1:
                self.a.nkind[e × 1¤ptrdiff] ← NK_IFIELD
                self.a.na[e × 1¤ptrdiff] ← fi
                self.a.nb[e × 1¤ptrdiff] ← si
            return
        if k = NK_IFIELD or k = NK_INT or k = NK_BOOL or k = NK_STR:
            return
        self.bind_ifields(self.a.na[e × 1¤ptrdiff], si)
        self.bind_ifields(self.a.nb[e × 1¤ptrdiff], si)

    fn field_index(&self, si : i64, nm : str) → i64:
        let d := self.a.structs[si × 1¤ptrdiff]
        let nf : i64 ¤ptrdiff = self.a.extra[d.fields_off] × 1¤ptrdiff
        foreach i := 0…nf:
            if self.text(self.a.extra[d.fields_off + 1 + i × 2]) = nm:
                return @dropunit(i)
        ⁻1

    fn check_one_arg(&mut self, tok : i64, name : str, num : i64,
                     arg : i64, pty : i64):
        let rk : i64 = ty_ref_kind(pty)
        let base : i64 = ty_strip_ref(pty)
        if rk = 1 or rk = 2:
            if self.kind_of(arg) ≠ NK_REF:
                self.derr(tok, "parameter " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' borrows; write &name")
            else:
                self.check_ref_arg(arg, base, rk)
        else:
            if self.kind_of(arg) = NK_REF:
                self.derr(tok, "parameter " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' takes a value, not a borrow")
            else:
                self.check_expr(arg, base)
                let at : i64 = self.ty_of(arg)
                if self.is_open(at):
                    self.adopt(arg, base)
                elif not self.fit_arg(arg, base):
                    self.derr(tok, "argument " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' is " ⧺ self.tn(at) ⧺ ", but the parameter says " ⧺ self.tn(base))

    fn check_ref_arg(&mut self, arg : i64, base : i64, rk : i64):
        let inner : i64 = self.a.na[arg × 1¤ptrdiff]
        let atok : i64 = self.a.ntok[arg × 1¤ptrdiff]
        self.check_expr(inner, TY_UNIT)
        if self.ty_of(inner) ≠ base:
            self.derr(atok, "the borrow hands over " ⧺ self.tn(self.ty_of(inner)) ⧺ ", but the parameter says " ⧺ self.tn(base))
        if rk = 2:
            let name := self.text(self.a.ntok[inner × 1¤ptrdiff])
            let s : i64 = self.lookup(name)
            if s ≠ ⁻1 and self.smut[s × 1¤ptrdiff] = 0 and ty_ref_kind(self.stype[s × 1¤ptrdiff]) ≠ 2:
                self.derrc(atok, 2404, "'" ⧺ name ⧺ "' is not mut, so &mut cannot hand it over")
        self.set_type(arg, base)

    fn check_assert(&mut self, id : i64, tok : i64, args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff,
                    is_eq : bool):
        if is_eq:
            if argc ≠ 2:
                self.derr(tok, "assert_eq takes the expected and the actual value")
            else:
                let x : i64 = self.a.extra[args_off + 1]
                let y : i64 = self.a.extra[args_off + 2]
                self.check_expr(x, TY_UNIT)
                self.check_expr(y, self.ty_of(x))
                let tl : i64 = self.ty_of(x)
                let tr : i64 = self.ty_of(y)
                if tl = TY_UNT and tr ≠ TY_UNT:
                    self.adopt(x, tr)
                elif tr = TY_UNT and tl ≠ TY_UNT:
                    self.adopt(y, tl)
                elif tl = TY_UNT and tr = TY_UNT:
                    self.adopt(x, TY_I64)
                    self.adopt(y, TY_I64)
                // a string compares by what it holds, which the
                // lowering has always known how to ask
                if ty_is_arr(self.ty_of(x)) or ty_is_hash(self.ty_of(x)) or ty_is_tup(self.ty_of(x)) or ty_is_mat(self.ty_of(x)) or ty_is_rg(self.ty_of(x)) or ty_is_lam(self.ty_of(x)):
                    self.derr(tok, """assert_eq compares numbers, truth values, characters and
                                    " strings in core-2""")
                elif not self.try_fit(x, self.ty_of(y)):
                    self.derr(tok, "assert_eq compares two of the same type")
        else:
            if argc < 1 or argc > 2:
                self.derr(tok, "assert takes the condition and possibly a message")
            if argc >= 1:
                let c : i64 = self.a.extra[args_off + 1]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "assert")
            if argc = 2:
                let m : i64 = self.a.extra[args_off + 2]
                self.check_expr(m, TY_UNIT)
                if self.kind_of(m) ≠ NK_STR:
                    self.derr(tok, "assert's message is a string literal")
        self.set_type(id, TY_UNIT)

    fn count_fields(&self, s : str) → i64 ¤ptrdiff:
        let n : mut i64 ¤ptrdiff = 0
        let i : mut i64 ¤ptrdiff = 0
        while i + 1 < #s:
            if s[i] = '{' and s[i + 1] = '}':
                n ← n + 1
                i ← i + 2
            else:
                i ← i + 1
        n

    fn check_scall(&mut self, id : i64, tok : i64, sb : i64, args_off : i64 ¤"aextra"):
        if sb >= SB_BSRC and sb <= SB_BFLAGS:
            // The recipe is the one function the checker never walks,
            // so a std.build reaching here is outside one by
            // construction -- no flag to set, and nothing to carry.
            self.derr(tok, """std.build belongs to the @build function; nothing else declares or
                            " reads a build""")
            self.set_type(id, TY_UNIT)
            return
        if sb = SB_PROC:
            // the member's own index rides where an argument list would;
            // what it answers cannot change, so reading it is pure
            if @dropunit(args_off) = PROC_PAGESIZE:
                self.set_type(id, ty_with_unit(TY_I64, UNIT_BYTE))
            elif @dropunit(args_off) = PROC_SECURE:
                self.set_type(id, TY_BOOL)
            elif @dropunit(args_off) = PROC_EXECFN:
                self.set_type(id, TY_STR)
            else:
                self.set_type(id, TY_U32)
            return
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if sb = SB_EXIT:
            if argc ≠ 1:
                self.derr(tok, "std.exit takes the exit code")
            else:
                let c : i64 = self.a.extra[args_off + 1]
                self.check_expr(c, TY_I64)
                if self.ty_of(c) = TY_UNT:
                    self.adopt(c, TY_I64)
                elif not ty_is_int(self.ty_of(c)):
                    self.derr(tok, "the exit code is a number")
            self.set_type(id, TY_UNIT)
            return
        if sb = SB_ARGS:
            if argc ≠ 0:
                self.derr(tok, "std.args.all takes nothing")
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "reading the arguments is impure; the function wants @impure")
            self.set_type(id, mk_aty(TY_STR))
            return
        if sb = SB_ENVN or sb = SB_ENVG or sb = SB_ENVH:
            // the environment is the process's own, and reading it is
            // as impure as reading the arguments
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "reading the environment is impure; the function wants @impure")
            if sb = SB_ENVN:
                if argc ≠ 0:
                    self.derr(tok, "std.env.names takes nothing")
                self.set_type(id, mk_aty(TY_STR))
                return
            if argc ≠ 1:
                self.derr(tok, "std.env." ⧺ (if sb = SB_ENVG: "get" else: "has") ⧺ " takes the variable's name")
            else:
                let nv : i64 = self.a.extra[args_off + 1]
                self.check_expr(nv, TY_STR)
                if self.ty_of(nv) ≠ TY_STR:
                    self.derr(tok, "a variable's name is a string, not " ⧺ self.tn(self.ty_of(nv)))
            self.set_type(id, if sb = SB_ENVG: mk_oty(TY_STR) else: TY_BOOL)
            return
        if sb = SB_CWD:
            // looking at a directory writes nothing; only opening and
            // creating files want @impure
            self.set_type(id, TY_DIR)
            return
        if sb = SB_BYTES:
            if argc ≠ 1:
                self.derr(tok, "std.bytes takes the string")
            else:
                let bs : i64 = self.a.extra[args_off + 1]
                self.check_expr(bs, TY_STR)
                if self.ty_of(bs) ≠ TY_STR:
                    self.derr(tok, "std.bytes reads a string, not " ⧺ self.tn(self.ty_of(bs)))
            self.set_type(id, mk_aty(TY_U8))
            return
        if sb = SB_HDIGEST or sb = SB_HSTART:
            let algs := hash_algs()
            let who : str = "std.hash." ⧺ algs[self.a.nc[id × 1¤ptrdiff] × 1¤ptrdiff]
            if sb = SB_HSTART:
                if argc ≠ 0:
                    self.derr(tok, who ⧺ """.start() takes nothing; what is to be digested goes to
                                          " update()""")
                self.set_type(id, TY_HASH)
                return
            // A string or its bytes.  The digest comes back as bytes
            // rather than a number, because no sized type the language
            // has holds two hundred and fifty-six bits, so a program
            // handed one could not keep it.
            if argc ≠ 1:
                self.derr(tok, who ⧺ ".digest takes the one thing it is to digest")
            else:
                let hv : i64 = self.a.extra[args_off + 1]
                self.check_expr(hv, mk_aty(TY_U8))
                let ht : i64 = ty_strip_ref(self.ty_of(hv))
                if ht ≠ mk_aty(TY_U8) and ht ≠ TY_STR:
                    self.derr(tok, who ⧺ ".digest digests a string or its bytes, not " ⧺ self.tn(ht))
            self.set_type(id, self.digest_type(self.a.nc[id × 1¤ptrdiff]))
            return
        if sb = SB_IOV:
            if argc ≠ 1:
                self.derr(tok, "std.iov takes the one thing it is to write")
            else:
                let iv : i64 = self.a.extra[args_off + 1]
                self.check_expr(iv, TY_UNIT)
                self.iov_source_ok(tok, ty_strip_ref(self.ty_of(iv)))
            self.set_type(id, TY_IOVEC)
            return
        if sb = SB_ALLOCATOR:
            if argc ≠ 0:
                self.derr(tok, "std.arena.allocator takes nothing")
            self.set_type(id, TY_ALLOC)
            return
        if sb = SB_OPEN or sb = SB_CREATE:
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "touching files is impure; the function wants @impure")
            if self.in_contract:
                self.derr(tok, "a contract's condition is pure and touches nothing")
            if argc < 1:
                self.derr(tok, "the path comes first")
                self.set_type(id, if sb = SB_OPEN: mk_oty(TY_FILE) else: TY_FILE)
                return
            let pth : i64 = self.a.extra[args_off + 1]
            self.check_expr(pth, TY_STR)
            if self.ty_of(pth) ≠ TY_STR:
                self.derr(tok, "the path is a string, not " ⧺ self.tn(self.ty_of(pth)))
            if sb = SB_OPEN:
                if argc ≠ 1:
                    self.derr(tok, "open_file takes the path alone")
                self.set_type(id, mk_oty(TY_FILE))
                return
            if argc ≠ 2:
                self.derr(tok, "create_file takes the path and the mode")
            else:
                let md : i64 = self.a.extra[args_off + 2]
                self.check_expr(md, TY_I64)
                if self.ty_of(md) = TY_UNT:
                    self.adopt(md, TY_I64)
                elif not ty_is_int(self.ty_of(md)):
                    self.derr(tok, "the mode is a number")
            self.set_type(id, TY_FILE)
            return
        if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "writing output is impure; the function wants @impure")
        if self.in_contract:
            self.derr(tok, "a contract's condition is pure and writes nothing")
        if argc < 1:
            self.derr(tok, "the first argument is the format string")
            self.set_type(id, TY_UNIT)
            return
        let fmt : i64 = self.a.extra[args_off + 1]
        self.check_expr(fmt, TY_UNIT)
        if self.kind_of(fmt) ≠ NK_STR:
            self.derr(tok, "the format is a string literal in core-1")
            self.set_type(id, TY_UNIT)
            return
        let fields : i64 ¤ptrdiff = self.count_fields(self.a.strs[self.a.na[fmt × 1¤ptrdiff] × 1¤ptrdiff])
        if fields ≠ argc - 1:
            self.derr(tok, "the format's {} fields and the arguments after it disagree in number")
        foreach i := 2…argc + 1:
            let arg : i64 = self.a.extra[args_off + i]
            self.check_expr(arg, TY_UNIT)
            let t : i64 = self.ty_of(arg)
            if t = TY_UNT:
                self.adopt(arg, TY_I64)
            elif not ty_is_int(t) and not ty_is_bigint(t) and t ≠ TY_BOOL and t ≠ TY_STR and t ≠ TY_CHAR:
                self.derr(tok, """println writes numbers, truth values, characters and strings; this
                                " is """ ⧺ self.tn(t))
        self.set_type(id, TY_UNIT)

    // T.offsetof("f"): where the named field begins, settled here and
    // folded, so nothing of it survives into the run
    fn check_offsetof(&mut self, id : i64, tok : i64, si : i64, args_off : i64 ¤"aextra"):
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if argc ≠ 1:
            self.derr(tok, "offsetof names one field, written out as a string")
            self.fold_bytes(id, 0)
            return
        let ae : i64 = self.a.extra[args_off + 1]
        if self.kind_of(ae) ≠ NK_STR:
            self.check_expr(ae, TY_STR)
            self.derr(tok, """offsetof names the field with a written-out string, since the answer
                            " is settled before the run""")
            self.fold_bytes(id, 0)
            return
        self.set_type(ae, TY_STR)
        let fname := self.a.strs[self.a.na[ae × 1¤ptrdiff] × 1¤ptrdiff]
        let (fidx, fty) := self.field_of(si, fname)
        _ ← fty
        if fidx = ⁻1:
            self.derr(tok, "'" ⧺ self.a.structs[si × 1¤ptrdiff].name ⧺ "' has no field '" ⧺ fname ⧺ "'")
            self.fold_bytes(id, 0)
            return
        let off : i64 = c_field_offset(self.a, si, fidx × 1¤ptrdiff)
        if off = ⁻1:
            self.layout_err(tok, si, "placed")
            self.fold_bytes(id, 0)
            return
        self.fold_bytes(id, off)

    fn check_mcall(&mut self, id : i64, tok : i64, na : i64, args_off : i64 ¤"aextra",
                   under_default : bool):
        let m := self.text(tok)
        // the base naming a struct type is a static call, unless a
        // variable shadows the name
        if self.kind_of(na) = NK_VAR:
            let bname := self.text(self.a.ntok[na × 1¤ptrdiff])
            if self.lookup(bname) = ⁻1 and self.struct_index(bname) ≠ ⁻1:
                if m = "offsetof":
                    self.check_offsetof(id, tok, self.struct_index(bname), args_off)
                    return
                self.check_smethod(id, tok, na, args_off, bname, m, false)
                return
        self.check_expr(na, TY_UNIT)
        let t : i64 = self.ty_of(na)
        if ty_is_struct(ty_strip_ref(t)):
            let sname := self.a.structs[ty_sidx(ty_strip_ref(t)) × 1¤ptrdiff].name
            self.check_smethod(id, tok, na, args_off, sname, m, true)
            return
        let argc0 : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if (ty_is_int(t) or t = TY_UNT) and m = "chr":
            if argc0 ≠ 0:
                self.derr(tok, "chr takes nothing")
            if self.kind_of(na) = NK_INT:
                // a literal's character is judged and folded here, with
                // the same three refusals the runtime check makes
                let v : i64 = self.a.na[na × 1¤ptrdiff]
                if v < 0 or self.a.nb[na × 1¤ptrdiff] ≠ 0:
                    self.derr(tok, """chr: the value is not a code point; a character is numbered
                                    " from 0""")
                elif v > 1114111:
                    self.derr(tok, "chr: " ⧺ i64_str(v) ⧺ " is past the last code point, 0x10FFFF")
                elif v >= 55296 and v <= 57343:
                    self.derr(tok, "chr: " ⧺ i64_str(v) ⧺ """ is a surrogate, which encodes half of
                            " a character in UTF-16 rather than being one""")
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.na[id × 1¤ptrdiff] ← v
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_CHAR)
                return
            if t = TY_UNT:
                self.adopt(na, TY_I64)
            self.a.nc[id × 1¤ptrdiff] ← MID_CHR
            self.set_type(id, TY_CHAR)
            return
        if ty_is_enum(t) and m = "ord":
            // the number an enumerator stands for, in the enum's own
            // underlying type -- for a @flag enum, the bit set
            if argc0 ≠ 0:
                self.derr(tok, "ord takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_ORD
            self.set_type(id, self.a.ewidth[ty_eidx(t) × 1¤ptrdiff])
            return
        if t = TY_CHAR and m = "ord":
            if argc0 ≠ 0:
                self.derr(tok, "ord takes nothing")
            if self.kind_of(na) = NK_INT:
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.na[id × 1¤ptrdiff] ← self.a.na[na × 1¤ptrdiff]
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_U32)
                return
            self.a.nc[id × 1¤ptrdiff] ← MID_ORD
            self.set_type(id, TY_U32)
            return
        if t = TY_HASH and (m = "update" or m = "digest"):
            // Hashing writes nothing anyone can see, so neither of
            // these asks for @impure; what update changes is the
            // handle it was reached through, which the caller owns.
            if m = "update":
                if argc0 ≠ 1:
                    self.derr(tok, "update takes the next piece of the message")
                else:
                    let uv : i64 = self.a.extra[args_off + 1]
                    self.check_expr(uv, mk_aty(TY_U8))
                    let ut : i64 = ty_strip_ref(self.ty_of(uv))
                    if ut ≠ mk_aty(TY_U8) and ut ≠ TY_STR:
                        self.derr(tok, "update adds a string or its bytes, not " ⧺ self.tn(ut))
                self.a.nc[id × 1¤ptrdiff] ← MID_HUPDATE
                self.set_type(id, TY_UNIT)
                return
            if argc0 ≠ 0:
                self.derr(tok, "digest takes nothing; it answers what was added")
            self.a.nc[id × 1¤ptrdiff] ← MID_HDIGEST
            // The handle's type does not say which algorithm made it,
            // and with one algorithm it does not have to.  A second
            // would have to be told apart here, so the day one arrives
            // this stops rather than answering the wrong width.
            assert(#hash_algs() = 1, """a second hash algorithm wants the handle's type to carry
                                      " which it is""")
            self.set_type(id, self.digest_type(0))
            return
        if t = TY_FILE and m = "writev":
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "touching files is impure; the function wants @impure")
            if self.a.extra[args_off] ≠ 1:
                self.derr(tok, "writev takes the runs to write, as one array of std.iovec")
            else:
                let pe : i64 = self.a.extra[args_off + 1]
                self.check_expr(pe, mk_aty(TY_IOVEC))
                if ty_strip_ref(self.ty_of(pe)) ≠ mk_aty(TY_IOVEC):
                    self.derr(tok, "writev writes runs of bytes; std.iov makes one, and this is " ⧺ self.tn(self.ty_of(pe)))
            self.a.nc[id × 1¤ptrdiff] ← MID_WRITEV
            self.set_type(id, TY_UNIT)
            return
        if t = TY_FILE and (m = "read_file" or m = "write" or m = "close"):
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "touching files is impure; the function wants @impure")
            if m = "read_file":
                if argc0 ≠ 1:
                    self.derr(tok, "read_file takes the allocator")
                else:
                    let al : i64 = self.a.extra[args_off + 1]
                    self.check_expr(al, TY_UNIT)
                    if self.ty_of(al) ≠ TY_ALLOC:
                        self.derr(tok, """read_file reads through an allocator;
                                        " std.arena.allocator() answers one""")
                self.a.nc[id × 1¤ptrdiff] ← MID_READF
                self.set_type(id, mk_aty(TY_U8))
                return
            if m = "write":
                if argc0 ≠ 1:
                    self.derr(tok, "write takes the bytes to put down")
                else:
                    let bs : i64 = self.a.extra[args_off + 1]
                    self.check_expr(bs, TY_UNIT)
                    if self.ty_of(bs) ≠ mk_aty(TY_U8):
                        self.derr(tok, "write puts down bytes, not " ⧺ self.tn(self.ty_of(bs)))
                self.a.nc[id × 1¤ptrdiff] ← MID_WRITEF
                self.set_type(id, TY_UNIT)
                return
            if argc0 ≠ 0:
                self.derr(tok, "close takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_CLOSEF
            self.set_type(id, TY_UNIT)
            return
        if t = TY_DIR and m = "iterate":
            if argc0 ≠ 0:
                self.derr(tok, "iterate takes nothing")
            let de : i64 = TY_ENTRY
            let di : mut i64 = ⁻1
            let dm : i64 = @dropunit(#self.ite)
            foreach ds := 0…dm:
                if self.ite[ds × 1¤ptrdiff] = de:
                    di ← ds
            if di = ⁻1:
                di ← dm
                self.ite.push(de)
            self.a.nc[id × 1¤ptrdiff] ← MID_DIRITER
            self.set_type(id, 30720 + di)
            return
        if ty_is_arr(t) and m = "iterate":
            if argc0 ≠ 0:
                self.derr(tok, "iterate takes nothing")
            let ie : i64 = self.elem_of(t)
            let ii : mut i64 = ⁻1
            let mi : i64 = @dropunit(#self.ite)
            foreach si := 0…mi:
                if self.ite[si × 1¤ptrdiff] = ie:
                    ii ← si
            if ii = ⁻1:
                ii ← mi
                self.ite.push(ie)
            self.a.nc[id × 1¤ptrdiff] ← MID_ITER
            // An iterator keeps the array it was made from, and there
            // is nothing in the language that says when the iterator
            // is done with, so the borrow runs to the end of the scope
            // the iterator was made in.  That is stricter than it has
            // to be and never wrong: what it costs is changing an
            // array later in the same scope, and what it buys is that
            // an iterator never walks a thing that moved under it.
            self.hold(na, HOLD_READ)
            self.set_type(id, 30720 + ii)
            return
        if ty_is_iter(t) and m = "next":
            if argc0 ≠ 0:
                self.derrc(tok, 2256, "next takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_NEXT
            let ne : i64 = self.ite[ty_iidx(t) × 1¤ptrdiff]
            self.set_type(id, if under_default: ne else: mk_oty(ne))
            return
        if t = TY_STR and m = "chars":
            if argc0 ≠ 0:
                self.derr(tok, "chars takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_CHARS
            self.set_type(id, mk_aty(TY_CHAR))
            return
        if not ty_is_arr(t):
            self.derr(tok, "'" ⧺ m ⧺ """' is asked of an array, a struct, a string, a character or a
                                      " number; this is """ ⧺ self.tn(t))
            self.set_type(id, TY_I64)
            return
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if ty_is_row(t) and (m = "push" or m = "pop" or m = "insert" or m = "remove"):
            self.derr(tok, "a matrix's row keeps its length; the matrix said it")
            self.set_type(id, if m = "push": TY_UNIT else: self.elem_of(t))
            return
        if ty_is_farr(t) and (m = "push" or m = "pop"):
            self.derr(tok, "a sized array holds its size; push and pop change none")
            self.set_type(id, if m = "push": TY_UNIT else: self.elem_of(t))
            return
        if m = "push":
            self.require_mut_base(na, tok)
            self.keep_safe(na)
            if argc ≠ 1:
                self.derr(tok, "push takes the one element to append")
            else:
                let arg : i64 = self.a.extra[args_off + 1]
                self.check_expr(arg, self.elem_of(t))
                if self.ty_of(arg) = TY_UNT:
                    self.adopt(arg, self.elem_of(t))
                elif not self.try_fit(arg, self.elem_of(t)):
                    self.derr(tok, "the array holds " ⧺ self.tn(self.elem_of(t)) ⧺ ", not " ⧺ self.tn(self.ty_of(arg)))
            self.a.nc[id × 1¤ptrdiff] ← MID_PUSH
            self.set_type(id, TY_UNIT)
        elif m = "pop":
            self.require_mut_base(na, tok)
            self.keep_safe(na)
            if argc ≠ 0:
                self.derr(tok, "pop takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_POP
            // under ?? the default stands in and the value is bare;
            // anywhere else the absence is the answer, and it is boxed
            // as any optional is
            self.set_type(id, if under_default: self.elem_of(t) else: mk_oty(self.elem_of(t)))
        elif m = "get":
            if argc ≠ 1:
                self.derr(tok, "get takes the index to look at")
            else:
                self.check_index_expr(tok, t, self.a.extra[args_off + 1])
            self.a.nc[id × 1¤ptrdiff] ← MID_GET
            self.set_type(id, if under_default: self.elem_of(t) else: mk_oty(self.elem_of(t)))
        else:
            self.derr(tok, "'" ⧺ m ⧺ "' is not a core-1 array method; push, pop and get are")
            self.set_type(id, TY_I64)

    fn check_smethod(&mut self, id : i64, tok : i64, na : i64, args_off : i64 ¤"aextra",
                     sname : str, m : str, instance : bool):
        let fname : str = sname ⧺ "." ⧺ m
        let f : i64 = self.fn_index(fname)
        if f = ⁻1:
            self.derr(tok, "'" ⧺ sname ⧺ "' has no method '" ⧺ m ⧺ "'")
            self.set_type(id, TY_I64)
            return
        let callee := self.a.fns[f × 1¤ptrdiff]
        if callee.is_impure and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "'" ⧺ fname ⧺ "' is @impure, and impurity travels to the caller")
        if self.in_contract and callee.is_impure:
            self.derr(tok, "a contract's condition is pure; '" ⧺ fname ⧺ "' is not")
        let np : i64 ¤ptrdiff = self.a.extra[callee.params_off] × 1¤ptrdiff
        let self_n : i64 ¤ptrdiff = if instance: 1 else: 0
        if instance:
            if np = 0 or not ty_is_struct(ty_strip_ref(self.a.extra[callee.params_off + 2])):
                self.derr(tok, "'" ⧺ fname ⧺ "' is a static method; ask it of the struct's name")
                self.set_type(id, callee.ret)
                return
            let srk : i64 = ty_ref_kind(self.a.extra[callee.params_off + 2])
            if srk = 2:
                self.require_mut_base(na, tok)
        elif np > 0 and ty_is_struct(ty_strip_ref(self.a.extra[callee.params_off + 2])) and ty_ref_kind(self.a.extra[callee.params_off + 2]) ≠ 0:
            self.derr(tok, "'" ⧺ fname ⧺ "' works an instance; ask it of a value, not the name")
            self.set_type(id, callee.ret)
            return
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if argc ≠ np - self_n:
            self.derr(tok, "'" ⧺ fname ⧺ "' wants " ⧺ i64_str(@dropunit(np - self_n)) ⧺ " arguments, not " ⧺ i64_str(@dropunit(argc)))
            self.set_type(id, callee.ret)
            return
        foreach j := 0…argc:
            let arg : i64 = self.a.extra[args_off + 1 + j]
            let pty : i64 = self.a.extra[callee.params_off + 2 + (j + self_n) × 2]
            self.check_one_arg(tok, fname, @dropunit(j) + 1, arg, pty)
        self.check_alias(tok, fname, na, args_off, argc, callee.params_off, self_n)
        self.call_escapes(args_off, argc, callee.params_off, na, self_n,
                          callee.is_impure, callee.ret)
        // lowering finds the function and whether a receiver travels
        self.a.nc[id × 1¤ptrdiff] ← 1000 + 2 × f + (if instance: 1 else: 0)
        self.set_type(id, callee.ret)

    // The type as this file writes it.  type_name() knows only the
    // measures the language ships with, so a message about one the
    // file declared would name it by its index; the Ast carries the
    // marks, and the checker carries the Ast.
    fn tn(&self, t : i64) → str:
        type_name_m(t, self.a.umarks)

    // Whether a value measured `u` may go where `want` is asked for.
    // Its own measure always may; beyond that the decay chain is
    // walked, since `unit tok → ptrdiff` says a token index goes
    // wherever a ptrdiff does, and as far as it goes, since a measure
    // may stand in for one that stands in for a third.  The way back is
    // not open, and two that stand in for the same thing do not stand
    // in for each other.  The walk ends because a circle among the
    // declarations is refused where they are written.
    @post(r: r or u ≠ want)
    fn stands_for(&self, u : i64, want : i64) → bool:
        if u = want:
            return true
        let n : i64 = @dropunit(#self.a.udecay)
        // A file names at most 125 measures and a circle among them is
        // refused where they are declared, so a chain is shorter than
        // this; the bound is a backstop and not the rule.
        let step : mut i64 = u
        foreach seen := 0…128:
            if step <= 0 or step >= n:
                return false
            step ← self.a.udecay[step × 1¤ptrdiff]
            if step = want:
                return true
        false

    fn is_ignored_name(&self, name : str) → bool:
        str_is(name) ∃ self.a.ignored

    // the recipe's name resolves to nothing, since it is not among the
    // functions; saying so is better than saying it does not exist
    fn is_build_name(&self, name : str) → bool:
        if #self.a.builds > 0:
            foreach b := self.a.builds:
                if b.name = name:
                    return true
        false

    fn call_noreturn(&self, e : i64) → bool:
        let f : i64 = self.fn_index(self.text(self.a.ntok[e × 1¤ptrdiff]))
        f ≠ ⁻1 and self.a.fns[f × 1¤ptrdiff].is_noreturn

    // The binding an expression is reaching into, or ⁻1 where it
    // reaches into no binding: a walk over `s.f` or `m[i]` borrows `s`
    // and `m`, and a walk over something freshly made borrows nothing
    // that has a name to lose.
    fn base_slot(&self, e : i64) → i64:
        if self.kind_of(e) = NK_FIELD or self.kind_of(e) = NK_INDEX:
            return self.base_slot(self.a.na[e × 1¤ptrdiff])
        if self.kind_of(e) ≠ NK_VAR:
            return ⁻1
        self.lookup(self.text(self.a.ntok[e × 1¤ptrdiff]))

    // Lend what something is walking, for as long as the scope in hand
    // lasts.  What was there before is kept beside the hold, so a walk
    // inside a walk gives back the outer walk's claim and not none at
    // all; and a walk already inside a borrow keeps the stricter of the
    // two, which is what walking one array twice over has to mean.
    @pre(how = HOLD_READ or how = HOLD_NONE)
    fn hold(&mut self, e : i64, how : i64):
        let s : i64 = self.base_slot(e)
        if s = ⁻1:
            return
        self.hslot.push(s)
        self.hback.push(self.sheld[s × 1¤ptrdiff])
        self.sheld[s × 1¤ptrdiff] ← self.sheld[s × 1¤ptrdiff] ⌈ how

    fn require_mut_base(&mut self, base : i64, tok : i64):
        if self.kind_of(base) = NK_FIELD or self.kind_of(base) = NK_INDEX:
            self.require_mut_base(self.a.na[base × 1¤ptrdiff], tok)
            return
        if self.kind_of(base) ≠ NK_VAR:
            self.derr(tok, "what is being changed is named directly in core-2")
            return
        let name := self.text(self.a.ntok[base × 1¤ptrdiff])
        let s : i64 = self.lookup(name)
        if s = ⁻1:
            let g : i64 = self.global_index(name)
            if g ≠ ⁻1 and not self.a.globals[g × 1¤ptrdiff].is_mut:
                self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may change it")
            return
        let hd : i64 = self.sheld[s × 1¤ptrdiff]
        if hd ≠ HOLD_FREE:
            self.derrc(tok, 2400, "'" ⧺ name ⧺ "' is lent out " ⧺ (if hd = HOLD_READ: "for reading" else: "to be changed") ⧺ " and cannot be changed until the borrow ends; a walk holds what it walks for the whole of its body")
            return
        let pt : i64 = self.stype[s × 1¤ptrdiff]
        if ty_ref_kind(pt) = 1:
            self.derr(tok, "'" ⧺ name ⧺ "' is a shared borrow; & reads and &mut changes")
        elif ty_ref_kind(pt) = 0 and self.smut[s × 1¤ptrdiff] = 0:
            self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may change it")

    // a bare ÷ or % answering into an optional: the zero divisor is ∅
    fn check_retdiv(&mut self, na : i64, want : i64):
        let base : i64 = ty_opt_base(want)
        let dl : i64 = self.a.na[na × 1¤ptrdiff]
        let dr : i64 = self.a.nb[na × 1¤ptrdiff]
        self.check_expr(dl, base)
        self.check_expr(dr, base)
        if self.ty_of(dl) = TY_UNT and self.ty_of(dr) = TY_UNT:
            self.adopt(dl, if ty_is_int(base): base else: TY_I64)
            self.adopt(dr, if ty_is_int(base): base else: TY_I64)
        let t : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, self.kind_of(na), self.ty_of(dl), self.ty_of(dr))
        self.set_type(na, if t ≠ TY_UNT: t else: TY_I64)
        if self.ty_of(na) ≠ base:
            self.derr(self.a.ntok[na × 1¤ptrdiff], "the function answers " ⧺ self.tn(want) ⧺ ", but the division works " ⧺ self.tn(self.ty_of(na)))

    fn check_default(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        let ik : i64 = self.kind_of(na)
        if ik = NK_DIV or ik = NK_MOD:
            let dl : i64 = self.a.na[na × 1¤ptrdiff]
            let dr : i64 = self.a.nb[na × 1¤ptrdiff]
            self.check_expr(dl, want)
            self.check_expr(dr, want)
            let tl : i64 = self.ty_of(dl)
            let tr : i64 = self.ty_of(dr)
            if tl = TY_UNT and tr = TY_UNT:
                let w : i64 = if ty_is_int(want): want else: TY_I64
                self.adopt(dl, w)
                self.adopt(dr, w)
            let t : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, ik,
                                           self.ty_of(dl), self.ty_of(dr))
            self.set_type(na, if t ≠ TY_UNT: t else: TY_I64)
        elif ik = NK_MCALL:
            self.check_mcall(na, self.a.ntok[na × 1¤ptrdiff],
                             self.a.na[na × 1¤ptrdiff],
                             self.a.nb[na × 1¤ptrdiff] × 1¤"aextra", true)
        else:
            let ow : i64 = if want ≠ TY_UNIT and (ty_is_int(want) or want = TY_BOOL or want = TY_STR or ty_is_struct(want)): mk_oty(want) else: TY_UNIT
            self.check_expr(na, ow)
            if ty_is_opt(self.ty_of(na)):
                let base : i64 = ty_opt_base(self.ty_of(na))
                if self.kind_of(nb) = NK_CALL and self.call_noreturn(nb):
                    // the default never answers; the held value's type
                    // stands alone
                    self.check_expr(nb, TY_UNIT)
                    self.set_type(id, base)
                    return
                self.check_expr(nb, base)
                if self.is_open(self.ty_of(nb)):
                    self.adopt(nb, base)
                elif not self.try_fit(nb, base):
                    self.derr(tok, "the default answers for the value, so it is " ⧺ self.tn(base) ⧺ ", not " ⧺ self.tn(self.ty_of(nb)))
                self.set_type(id, base)
                return
            self.derr(tok, "?? follows what answers a result or an optional")
        let t : i64 = self.ty_of(na)
        self.check_expr(nb, t)
        if self.ty_of(nb) = TY_UNT:
            self.adopt(nb, t)
        elif not self.try_fit(nb, t):
            self.derr(tok, "the default answers for the value, so it is " ⧺ self.tn(t) ⧺ ", not " ⧺ self.tn(self.ty_of(nb)))
        self.set_type(id, t)

    // ------------------------------------------------------------------
    // Statements
    // ------------------------------------------------------------------

    fn check_block(&mut self, blk : i64, is_fn_body : bool):
        self.push_scope()
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            let s : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let trailing : bool = is_fn_body and i = n - 1
            self.check_stmt(s, trailing)
        self.pop_scope()

    // ------------------------------------------------------------------
    // How long a binding lives
    // ------------------------------------------------------------------
    //
    // A lifetime runs from the statement that declared the binding to
    // the statement that last used it.  Statements are numbered as
    // they are walked, so the numbering is of the text and not of what
    // a run does with it -- which is what is wanted: this is a question
    // about the program, and a loop body is walked once.
    //
    // Where the two numbers are the same, nothing ever read what was
    // bound, and that is worth saying.

    // ------------------------------------------------------------------
    // Giving back what a walk was the last to hold
    // ------------------------------------------------------------------
    //
    // `foreach x := v: v ← …` leaves the object the walk took with no
    // name: the walk is the only thing still holding it, and at the end
    // of the walk nothing holds it at all.  That is a place the memory
    // can go back, and this works out where it is one.
    //
    // Three things have to be true, and the third is why this is narrow.
    // The name must be written over inside the walk, or the object is
    // still its.  Every value the name has held must have been
    // allocated where it was written -- a call is not enough, since a
    // function may answer an array it was only lent.  And every read of
    // the name must have been somewhere that keeps nothing: an element,
    // a count, a walk, a ⧺, a slice.  A read anywhere else may have put
    // the object somewhere this cannot see.

    // whether an expression certainly allocates what it answers
    fn allocates(&self, na : i64) → bool:
        let k : i64 = self.kind_of(na)
        k = NK_ARRLIT or k = NK_RESHAPE or k = NK_CCAT or k = NK_SLICE

    fn own_note(&mut self, slot : i64, na : i64):
        if slot < 0:
            return
        while #self.lown <= slot × 1¤ptrdiff:
            self.lown.push(0)
        self.lown[slot × 1¤ptrdiff] ← if self.allocates(na): 1 else: 0

    // a later value the name takes on has to be as certainly its own
    fn own_keep(&mut self, slot : i64, na : i64):
        if slot >= 0 and slot × 1¤ptrdiff < #self.lown and not self.allocates(na):
            self.lown[slot × 1¤ptrdiff] ← 0

    // The slot a walk walks, where what it walks is a bare name of a
    // mut binding.  Anything else -- a field, an element, something
    // freshly made -- answers ⁻1 and is never given back here.
    fn walked_slot(&self, na : i64) → i64:
        if self.kind_of(na) ≠ NK_VAR:
            return ⁻1
        let s : i64 = self.lookup(self.text(self.a.ntok[na × 1¤ptrdiff]))
        if s = ⁻1 or self.smut[s × 1¤ptrdiff] = 0:
            return ⁻1
        self.sslot[s × 1¤ptrdiff]

    fn walk_open(&mut self, slot : i64):
        self.wslot.push(slot)
        self.wreb.push(0)

    // the name a walk walks, written over inside it
    fn walk_wrote(&mut self, slot : i64):
        if slot < 0:
            return
        foreach i := 0¤ptrdiff…#self.wslot:
            if self.wslot[i] = slot:
                self.wreb[i] ← 1

    @post(r: r = 0 or r = 1)
    fn walk_close(&mut self) → i64:
        let slot : i64 = self.wslot.pop() ?? ⁻1
        let reb : i64 = self.wreb.pop() ?? 0
        if reb = 0 or slot < 0:
            return 0
        if slot × 1¤ptrdiff >= #self.lown or self.lown[slot × 1¤ptrdiff] = 0:
            return 0
        if slot × 1¤ptrdiff >= #self.kuse or self.kuse[slot × 1¤ptrdiff] ≠ self.ksafe[slot × 1¤ptrdiff]:
            return 0
        1

    fn life_born(&mut self, slot : i64, tok : i64):
        while #self.lbirth <= slot × 1¤ptrdiff:
            self.lbirth.push(⁻1)
            self.llast.push(⁻1)
            self.luse.push(0)
            self.lesc.push(0)
            self.lwarn.push(0)
            self.ltok.push(⁻1)
        self.lbirth[slot × 1¤ptrdiff] ← self.stmt_seq
        self.llast[slot × 1¤ptrdiff] ← self.stmt_seq
        self.luse[slot × 1¤ptrdiff] ← 0
        self.lesc[slot × 1¤ptrdiff] ← 0
        self.ltok[slot × 1¤ptrdiff] ← tok
        // Only a let is worth saying this about.  A parameter's
        // lifetime does not begin at a statement at all, and a uniform
        // signature -- every dispatcher taking a Target whether it
        // reads it or not -- is a shape and not an oversight; a
        // contract's result name is read inside the very statement
        // that binds it, which no let can do.
        self.lwarn[slot × 1¤ptrdiff] ← if self.cur_stmt = NK_LET: 1 else: 0

    fn life_used(&mut self, slot : i64):
        if slot >= 0 and slot × 1¤ptrdiff < #self.llast:
            self.llast[slot × 1¤ptrdiff] ← self.stmt_seq
            self.luse[slot × 1¤ptrdiff] ← self.luse[slot × 1¤ptrdiff] + 1

    // What a call does to the lifetimes of what it was handed.
    //
    // A binding handed over as a &mut is one the callee may do more
    // with than read.  Three answers, and which one depends on the
    // callee rather than on the call:
    //
    //   - an impure callee may put a reference to it somewhere that
    //     outlives the call -- a global, a structure it was also
    //     handed -- and nothing here can see where.  The lifetime runs
    //     to the end of the scope.
    //
    //   - a pure callee cannot store it, but it can answer it: if what
    //     the callee answers could hold what it was handed, the value
    //     leaves through the return and the lifetime runs to the end
    //     of the scope as well.  Answering a plain number cannot carry
    //     an array or a structure out, so that case is left alone.
    //
    //   - otherwise the call is a use like any other, and the lifetime
    //     ends there if nothing later reads it.
    //
    // The worst case is the end of the scope, and both of the first
    // two take it; what the distinction buys is that a pure function
    // answering a number does not extend anything.
    fn call_escapes(&mut self, args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff, params_off : i64 ¤"aextra",
                    recv : i64, self_n : i64 ¤ptrdiff, imp : bool, ret : i64):
        if self_n = 1:
            let rty : i64 = self.a.extra[params_off + 2]
            if ty_ref_kind(rty) = 2:
                self.arg_escapes(recv, rty, imp, ret)
        foreach j := 0…argc:
            let arg : i64 = self.a.extra[args_off + 1 + j]
            let pty : i64 = self.a.extra[params_off + 2 + (j + self_n) × 2]
            if ty_ref_kind(pty) = 2:
                self.arg_escapes(arg, pty, imp, ret)

    fn arg_escapes(&mut self, arg : i64, pty : i64, imp : bool, ret : i64):
        let inner : i64 = if self.kind_of(arg) = NK_REF: self.a.na[arg × 1¤ptrdiff] else: arg
        let s : i64 = self.base_slot(inner)
        if s < 0:
            return
        if imp or self.carries_out(ty_strip_ref(pty), ret):
            self.life_escapes(s)
        else:
            self.life_used(s)

    // Whether what a function answers could be, or could hold, what it
    // was handed.  A number cannot carry an array out; an array of the
    // same elements can, and so can a structure, which may have a
    // field of it.  The question is asked of the shapes and not of the
    // body, so the answer is the careful one.
    fn carries_out(&self, held : i64, ret : i64) → bool:
        let r : i64 = ty_strip_ref(ret)
        if r = TY_UNIT:
            return false
        if r = held:
            return true
        if ty_is_struct(r) or ty_is_tup(r) or ty_is_hash(r):
            return true
        if ty_is_arr(r) or ty_is_farr(r) or ty_is_mat(r):
            return true
        if ty_is_opt(r):
            return self.carries_out(held, ty_opt_base(r))
        false

    // The callee may have kept it, so the last use here is not the end.
    fn life_escapes(&mut self, slot : i64):
        if slot >= 0 and slot × 1¤ptrdiff < #self.lesc:
            self.lesc[slot × 1¤ptrdiff] ← 1
            self.llast[slot × 1¤ptrdiff] ← self.stmt_seq

    fn check_stmt(&mut self, id : i64, trailing : bool):
        self.stmt_seq ← self.stmt_seq + 1
        let k : i64 = self.kind_of(id)
        self.cur_stmt ← k
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_HINTED:
            // the hint says nothing about what is checked
            self.check_stmt(na, trailing)
            return
        if k = NK_EXPECTS:
            // A statement expected to draw an error is parsed and left
            // alone, as a definition marked the same way is: it does
            // not check, so there is nothing to check it against, and
            // which diagnostic it was is the interpreter's to say.
            // One expecting only a warning is an ordinary statement
            // here -- core-2 has no warnings to draw -- so it is
            // checked and reported on as any other, rather than having
            // its refusals quietly swallowed.
            if nb = 0:
                self.check_stmt(na, false)
            return
        if k = NK_LET:
            if nc <= ⁻2:
                // `let m : ¤meter = e`: the right side says the type
                // and the colon says what it measures
                let mu9 : i64 = ⁻2 - nc
                self.check_expr(na, TY_UNIT)
                let it9 : i64 = self.ty_of(na)
                if not ty_is_int(it9) or it9 = TY_UNT:
                    self.derr(tok, "a measure belongs to a number, and this binding's value is " ⧺ self.tn(it9) ⧺ "; state the type, as 'let " ⧺ self.text(tok) ⧺ " : i64 ¤… = …'")
                    _ ← self.declare(tok, TY_I64, nb)
                    return
                if ty_unit(it9) ≠ 0 and ty_unit(it9) ≠ mu9:
                    self.derr(tok, "the value is measured " ⧺ self.tn(it9) ⧺ ", and the binding says another measure")
                    _ ← self.declare(tok, it9, nb)
                    return
                let mslot : i64 = self.declare(tok, ty_with_unit(it9, mu9), nb)
                self.nslot[id × 1¤ptrdiff] ← mslot
                return
            if nc = ⁻1:
                // := and : mut =: the right side says the type; what
                // it does not say is refused with the stated-form cure
                self.check_expr(na, TY_UNIT)
                let it : i64 = self.ty_of(na)
                if it = TY_UNT:
                    self.derr(tok, """a binding with no type written down settles on 'int'; state a
                                    " sized type, as 'let """ ⧺ self.text(tok) ⧺ " : i64 = …'")
                    _ ← self.declare(tok, TY_I64, nb)
                    return
                if it = TY_EMPTY:
                    self.derr(tok, "∅ alone says no type; state the optional, as 'let " ⧺ self.text(tok) ⧺ " : i64? = ∅'")
                    _ ← self.declare(tok, mk_oty(TY_I64), nb)
                    return
                if it = TY_UNIT:
                    self.derr(tok, "the right side answers nothing; there is nothing to bind")
                    _ ← self.declare(tok, TY_I64, nb)
                    return
                if ty_is_hash(it) and nb = 1 and self.kind_of(na) ≠ NK_HLIT:
                    self.derr(tok, """a mut dictionary binding is born from its literal; borrow with
                                    " &mut to change a shared one""")
                    _ ← self.declare(tok, it, nb)
                    return
                if ty_is_arr(it) and nb = 1 and self.kind_of(na) ≠ NK_ARRLIT and self.kind_of(na) ≠ NK_CALL and self.kind_of(na) ≠ NK_MCALL and self.kind_of(na) ≠ NK_RESHAPE and self.kind_of(na) ≠ NK_CCAT and self.kind_of(na) ≠ NK_SLICE and self.kind_of(na) ≠ NK_SCALL:
                    self.derr(tok, """a mut array binding is born fresh, from its literal or a call;
                                    " borrow with &mut to change a shared one""")
                    _ ← self.declare(tok, it, nb)
                    return
                if ty_is_struct(it) and nb = 1 and not self.is_fresh_struct(na):
                    self.derr(tok, """a mut struct binding is born fresh, from its literal or a
                                    " call; borrow with &mut to change a shared one""")
                let islot : i64 = self.declare(tok, it, nb)
                self.nslot[id × 1¤ptrdiff] ← islot
                self.pack_note(id, islot, it, na)
                self.own_note(islot, na)
                return
            if ty_is_hash(nc):
                if nb = 1 and self.kind_of(na) ≠ NK_HLIT:
                    self.derr(tok, """a mut dictionary binding is born from its literal; borrow with
                                    " &mut to change a shared one""")
                self.check_expr(na, nc)
                if self.kind_of(na) ≠ NK_HLIT and self.ty_of(na) ≠ nc:
                    self.derr(tok, "the binding says " ⧺ self.tn(nc) ⧺ " but the value is " ⧺ self.tn(self.ty_of(na)))
                let slot1 : i64 = self.declare(tok, nc, nb)
                self.nslot[id × 1¤ptrdiff] ← slot1
                return
            if ty_is_struct(nc):
                // a struct value is a reference, as the bootstrap has
                // it: a read-only binding may name one held anywhere;
                // only a mut binding must be born fresh, so a mutable
                // alias cannot arise from a let
                if nb = 1 and not self.is_fresh_struct(na):
                    self.derr(tok, """a mut struct binding is born fresh, from its literal or a
                                    " call; borrow with &mut to change a shared one""")
                self.check_expr(na, nc)
                if self.ty_of(na) ≠ nc and not ty_is_arr(self.ty_of(na)):
                    if self.ty_of(na) ≠ TY_I64:
                        self.derr(tok, "the binding says " ⧺ self.sname_of(nc) ⧺ " but the value is " ⧺ self.sname_of(self.ty_of(na)))
                let slot0 : i64 = self.declare(tok, nc, nb)
                self.nslot[id × 1¤ptrdiff] ← slot0
                return
            if ty_is_arr(nc):
                if self.kind_of(na) = NK_CCAT:
                    self.check_expr(na, nc)
                    if self.ty_of(na) ≠ nc and not ty_is_farr(nc):
                        self.derr(tok, "the binding says " ⧺ self.tn(nc) ⧺ " but the value is " ⧺ self.tn(self.ty_of(na)))
                    let slot8 : i64 = self.declare(tok, nc, nb)
                    self.nslot[id × 1¤ptrdiff] ← slot8
                    return
                if self.kind_of(na) = NK_RESHAPE:
                    self.check_expr(na, nc)
                    let slot9 : i64 = self.declare(tok, nc, nb)
                    self.nslot[id × 1¤ptrdiff] ← slot9
                    self.pack_note(id, slot9, nc, na)
                    self.own_note(slot9, na)
                    return
                if self.kind_of(na) ≠ NK_ARRLIT:
                    // a call answers a fresh array; any other right side
                    // names a shared one, which a mut binding may not
                    self.check_expr(na, nc)
                    if nb = 1 and self.kind_of(na) ≠ NK_CALL and self.kind_of(na) ≠ NK_MCALL:
                        self.derr(tok, """a mut array binding is born fresh, from its literal or a
                                        " call; borrow with &mut to change a shared one""")
                    if self.ty_of(na) ≠ nc:
                        self.derr(tok, "the binding says " ⧺ self.tn(nc) ⧺ " but the value is " ⧺ self.tn(self.ty_of(na)))
                else:
                    self.check_expr(na, nc)
                    if self.ty_of(na) ≠ nc and self.a.extra[self.a.na[na × 1¤ptrdiff] × 1¤ptrdiff] > 0:
                        self.derr(tok, "the binding says " ⧺ self.tn(nc) ⧺ " but the value is " ⧺ self.tn(self.ty_of(na)))
                    self.set_type(na, nc)
            else:
                self.check_expr(na, nc)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, nc)
                elif not self.try_fit(na, nc):
                    self.derr(tok, "the binding says " ⧺ self.tn(nc) ⧺ " but the value is " ⧺ self.tn(self.ty_of(na)))
            let slot : i64 = self.declare(tok, nc, nb)
            self.nslot[id × 1¤ptrdiff] ← slot
            self.pack_note(id, slot, nc, na)
            self.own_note(slot, na)
        elif k = NK_LETT:
            let n : i64 = self.a.extra[nc × 1¤ptrdiff]
            let styp : i64 = self.a.extra[(nc + 1) × 1¤ptrdiff]
            self.check_expr(na, if styp ≠ ⁻1: styp else: TY_UNIT)
            let it : i64 = self.ty_of(na)
            if not ty_is_tup(it):
                self.derr(tok, "the names take a tuple apart; the right side is " ⧺ self.tn(it))
                foreach j := 0…n:
                    let tj : i64 = self.a.extra[(nc + 2 + j) × 1¤ptrdiff]
                    if self.text(tj) ≠ "_":
                        _ ← self.declare(tj, TY_I64, nb)
                return
            if styp ≠ ⁻1 and it ≠ styp:
                self.derr(tok, "the binding says " ⧺ self.tn(styp) ⧺ " but the value is " ⧺ self.tn(it))
            if self.tup_len(it) ≠ n:
                self.derr(tok, "the tuple holds " ⧺ i64_str(self.tup_len(it)) ⧺ " elements; " ⧺ i64_str(n) ⧺ " names try to take it")
                foreach j2 := 0…n:
                    let tj2 : i64 = self.a.extra[(nc + 2 + j2) × 1¤ptrdiff]
                    if self.text(tj2) ≠ "_":
                        _ ← self.declare(tj2, if j2 < self.tup_len(it): self.tup_elem(it, j2) else: TY_I64, nb)
                return
            let slot0 : mut i64 = ⁻1
            foreach i := 0…n:
                let t2 : i64 = self.a.extra[(nc + 2 + i) × 1¤ptrdiff]
                let sl : mut i64 = 0
                if self.text(t2) = "_":
                    // '_' takes no name but keeps the row of slots whole
                    sl ← self.nslots
                    self.nslots ← self.nslots + 1
                else:
                    sl ← self.declare(t2, self.tup_elem(it, i), nb)
                if i = 0:
                    slot0 ← sl
            assert(self.nslots = slot0 + n, "the names' slots sit side by side")
            self.nslot[id × 1¤ptrdiff] ← slot0
        elif k = NK_ASSIGN:
            let name := self.text(tok)
            let s : i64 = self.lookup(name)
            let asl : i64 = if s ≠ ⁻1: self.sslot[s × 1¤ptrdiff] else: ⁻1
            self.life_used(asl)
            self.pack_kill(asl)
            self.own_keep(asl, na)
            self.walk_wrote(asl)
            if s = ⁻1:
                let g : i64 = self.global_index(name)
                if g = ⁻1:
                    self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
                    self.check_expr(na, TY_UNIT)
                    return
                let gd := self.a.globals[g × 1¤ptrdiff]
                if not gd.is_mut:
                    self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may be stored into it")
                if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                    self.derr(tok, "writing a global is an effect; the function wants @impure")
                self.check_expr(na, gd.ty)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, gd.ty)
                elif not self.try_fit(na, gd.ty):
                    self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ self.tn(gd.ty) ⧺ ", not " ⧺ self.tn(self.ty_of(na)))
                self.nslot[id × 1¤ptrdiff] ← 0 - g - 2
                return
            let st : i64 = self.stype[s × 1¤ptrdiff]
            if ty_ref_kind(st) = 2 and not ty_is_arr(ty_strip_ref(st)) and not ty_is_hash(ty_strip_ref(st)) and not ty_is_struct(ty_strip_ref(st)):
                // through the element's address, back into the array
                self.check_expr(na, ty_strip_ref(st))
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, ty_strip_ref(st))
                elif not self.try_fit(na, ty_strip_ref(st)):
                    self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ self.tn(ty_strip_ref(st)) ⧺ ", not " ⧺ self.tn(self.ty_of(na)))
                self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
                self.a.nb[id × 1¤ptrdiff] ← 1
                self.set_type(id, TY_UNIT)
                return
            if ty_ref_kind(st) = 1 and not ty_is_arr(ty_strip_ref(st)) and not ty_is_hash(ty_strip_ref(st)) and not ty_is_struct(ty_strip_ref(st)):
                self.derr(tok, "'" ⧺ name ⧺ "' is a shared borrow; & reads and &mut changes")
                self.check_expr(na, TY_UNIT)
                return
            if ty_is_struct(ty_strip_ref(st)) and not self.is_fresh_struct(na):
                self.derr(tok, "a struct binding takes a fresh struct; the fields change in place")
            if ty_is_hash(ty_strip_ref(st)):
                self.derr(tok, "a core-2 dictionary is built once and changed in place")
