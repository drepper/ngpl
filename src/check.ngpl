// ===========================================================================
// Checking: names, types, widths, units, mutability, purity, returns
// ===========================================================================

let ast := @import("ast")
let diag := @import("diag")
let elf := @import("elf")
let lex := @import("lex")
let names := @import("names")
let tokens := @import("tokens")
let types := @import("types")

// method ids the checker writes into an MCALL's nc
@export
enum Mid : u8:
    push = 1
    pop = 2
    get = 3
    chr = 4
    ord = 5
    chars = 6
    readf = 7
    writef = 8
    closef = 9
    iter = 10
    next = 11
    diriter = 12
    writev = 13
    hupdate = 14   // h.update(x): another piece of the message
    hdigest = 15   // h.digest(): the answer, and the end of the handle
    fdev = 16   // f.device(): which device the file is on
    fino = 17   // f.inode(): its number on that device

// What is left of a binding while something else borrows it.  A borrow
// is a claim on the thing borrowed, and the binding is what the claim
// is taken out of: while a shared borrow is outstanding the binding may
// be read and not changed, and while a mutable one is outstanding the
// binding is not a way to reach the thing at all, because the borrow is.
enum Hold : u8:
    free = 0
    read = 1
    none = 2
// the last-use table's size: a power of two, and more than the names
// any one function has, so a probe ends
let LU_SIZE : i64 = 8192

// an enum's own name, less the module it was written in
fn enum_bare(whole : str) → str:
    let cut : mut i64 ¤ptrdiff = ⁻1¤ptrdiff
    foreach i := 0¤ptrdiff…#whole:
        if whole[i] = '.':
            cut ← i
    if cut < 0¤ptrdiff:
        return whole
    whole[cut + 1¤ptrdiff…#whole]

@export
struct Chk:
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    // Per node: where an array's value is the elements themselves,
    // how many; ⁻1 where it is an ordinary array.  A T[N] does not
    // need this -- its type says so -- and this is where a T[] whose
    // length never changes and which never leaves the function comes
    // to say the same thing without its type changing.
    nrep : i64[]
    // Per call through a binding that holds a lambda: that lambda's
    // type.  Lowering needs the parameter types to know which
    // arguments a listable call is threaded over, and a call by name
    // has no node for the callee to read them from.
    nlam : i64[]
    // Per node: 1 where what it answers is held in an optional on the
    // way out -- a value meeting a stated optional type, which is how
    // an optional is written.
    nhold : i64[]
    // Per walk: 1 where what it walked is nobody's by the time it
    // ends, so the walk is where the memory goes back.
    nfree : i64[]
    // Where a binding's life ends before its scope does: after the
    // statement rec_stmt, the array in slot rec_slot goes back.  Only
    // an array the binding made itself and showed to nothing that
    // could hold it is listed here.
    rec_stmt : i64[]
    rec_slot : i64[]
    // Per node: 1 on a read of a binding that was born fresh -- from a
    // literal, a join, a slice, a call -- so that answering it by value
    // moves it; anything else answered by value is the caller's own,
    // or shared with something that is, and is copied.  Per node and
    // not per slot: slots start over in every function, and lowering
    // runs after every function has been checked.
    nmove : i64[]
    fslots : i64[]
    gvals : i64[]        // the folded initial value of every global
    ginit : i64[]        // globals whose value is built as the run begins
    lams : i64[]         // every λ node, in the order lowered
    lamns : i64[]        // … and the slot count its frame must cover
    psfn : i64[]         // partial-application shims: target, bound, full count
    psk : i64[]
    psnp : i64[]
    skipfn : i64[]       // 1 where a generic was never shaped by a call
    // Arguments whose copy by value cannot be elided: a by-value
    // parameter beside a &mut of the same thing in the same call.
    // Nearly always empty, which is why lowering asks its length
    // before it asks anything else.
    argcopy : i64[]
    // One line per binding whose scope ended, saying how long it
    // lived.  Written under --log=json beside the lowering's own
    // decisions: a lifetime is something the compiler worked out, and
    // the way to see what it worked out is to ask.
    log : str[]
    diags : diag.Diag[]

// What a precondition answers where nothing readable says: the least
// i64 halved, a value no arithmetic here reaches, so it stands for
// "not known" without standing for a number too.
let PRE_UNKNOWN : i64 = ⁻4611686018427387904

// ---------------------------------------------------------------------------
// The C layout of a @repr(C) struct
// ---------------------------------------------------------------------------
//
// The System V AMD64 psABI's rules, which are also every other
// mainstream C ABI's for these types: a field starts at the next
// offset that is a multiple of its own alignment, the struct aligns
// like its widest field, and its size rounds up to that alignment so
// an array of it keeps every element aligned.
//
// Size and alignment answer ⁻1 where C has no representation for the
// type.  Nothing here reports a diagnostic: the caller knows which
// field it asked about and can point at where that field was written,
// which is where the mistake is.

// how deep a @repr(C) struct may nest before the nesting is taken for
// a cycle.  A struct holding itself by value has no finite size, and
// the fixed ceiling says so without a set to carry around.
let C_NEST_MAX : i64 = 24

// what a type C has no representation for answers, and what a type
// one byte wide and one byte aligned answers.  Both are written out
// as bindings rather than as a bare pair: a tuple of plain numbers
// states no type, and the bootstrap will not let one settle on a type
// it does not have.
fn c_none() → (i64, i64):
    let m : i64 = ⁻1
    (m, m)

fn c_byte_wide() → (i64, i64):
    let one : i64 = 1
    (one, one)

@export
fn c_layout(a : ast.Ast, t0 : i64, depth : i64) → (i64, i64):
    if depth > C_NEST_MAX:
        return c_none()
    let t : i64 = types.ty_drop_unit(types.ty_strip_ref(t0))
    if types.ty_ref_kind(t0) ≠ 0:
        return c_none()
    if t = types.TY_BOOL:
        return c_byte_wide()
    if types.ty_is_int(t):
        let w : i64 = types.ty_bits(t) ÷ 8 ?? 1
        return (w, w)
    if types.ty_is_enum(t):
        // an enum is its underlying integer and lays out as one
        let w : i64 = types.ty_bits(a.ewidth[types.ty_eidx(t) × 1¤ptrdiff]) ÷ 8 ?? 1
        return (w, w)
    if types.ty_is_farr(t):
        // T[N] is N elements running one after the other, so it aligns
        // like one of them and is as long as all of them
        let (es, ea) := c_layout(a, a.fae[types.ty_fidx(t) × 1¤ptrdiff], depth + 1)
        if es = ⁻1:
            return c_none()
        return (es × a.fas[types.ty_fidx(t) × 1¤ptrdiff], ea)
    if types.ty_is_struct(t):
        return c_struct_layout(a, types.ty_sidx(t), depth)
    c_none()

// A sized array is its elements and nothing else only where an element
// is something a load can move: an integer, a truth value, an
// enumerator.  A T[N] of anything else -- a struct, a string -- keeps
// the representation every other array has, and the size in its type
// is a check rather than a layout.  The line is drawn here because it
// is where it can be drawn once: the lowering asks this and nothing
// else about which of the two a sized array is.
@export
fn farr_is_packed(a : ast.Ast, t : i64) → bool:
    if not types.ty_is_farr(t):
        return false
    let e : i64 = a.fae[types.ty_fidx(t) × 1¤ptrdiff]
    e = types.TY_BOOL or types.ty_is_int(e) or types.ty_is_enum(e)

@export
@post(r: r[0] = ⁻1 or (r[1] >= 1 and (r[0] % r[1] ?? 1) = 0))
fn c_struct_layout(a : ast.Ast, si : i64, depth : i64) → (i64, i64):
    let d := a.structs[si × 1¤ptrdiff]
    if not d.is_repr_c or depth > C_NEST_MAX:
        return c_none()
    let n : i64 ¤ptrdiff = a.extra[d.fields_off] × 1¤ptrdiff
    let off : mut i64 = 0
    let al : mut i64 = 1
    if n > 0:
        foreach i := 0…n:
            let fty : i64 = a.extra[d.fields_off + 2 + i × 2]
            let (fs, fa) := c_layout(a, fty, depth + 1)
            if fs = ⁻1:
                return c_none()
            off ← elf.align_up(off, fa) + fs
            al ← al ⌈ fa
    (elf.align_up(off, al), al)

// where field k of a @repr(C) struct begins, or ⁻1 where the struct
// has no layout at all
@export
fn c_field_offset(a : ast.Ast, si : i64, k : i64 ¤ptrdiff) → i64:
    let d := a.structs[si × 1¤ptrdiff]
    if not d.is_repr_c:
        return ⁻1
    let n : i64 ¤ptrdiff = a.extra[d.fields_off] × 1¤ptrdiff
    if k < 0 or k >= n:
        return ⁻1
    let off : mut i64 = 0
    // through field k and not short of it: the last turn aligns to
    // where k starts without adding k's own size
    foreach i := 0…k + 1:
        let fty : i64 = a.extra[d.fields_off + 2 + i × 2]
        let (fs, fa) := c_layout(a, fty, 1)
        if fs = ⁻1:
            return ⁻1
        off ← elf.align_up(off, fa)
        if i < k:
            off ← off + fs
    off

// the first field whose type C cannot represent, so the diagnostic can
// point at the field rather than at the struct
fn c_bad_field(a : ast.Ast, si : i64) → i64:
    let d := a.structs[si × 1¤ptrdiff]
    let n : i64 ¤ptrdiff = a.extra[d.fields_off] × 1¤ptrdiff
    if n > 0:
        foreach i := 0…n:
            let fty : i64 = a.extra[d.fields_off + 2 + i × 2]
            let (fs, fa) := c_layout(a, fty, 1)
            _ ← fa
            if fs = ⁻1:
                return @dropunit(i)
    ⁻1

struct Checker:
    a : ast.Ast
    toks : lex.Toks
    src : byte[]
    fnames : str[]
    snm : str[]          // the structs' names, in their own order, so a
                         // message writes what the program wrote
    // What a name reaches, by hashing: the functions by bare name and
    // by whole name, the globals, the structs, and the enumerations
    // the program declared.  Each answers the first entry of that name
    // in its array, as the walk it replaces did; a checker asks these
    // once per call site, and walking the arrays was that many times
    // the size of the program.
    fn_at : names.Names
    fw_at : names.Names
    g_at : names.Names
    s_at : names.Names
    e_at : names.Names
    curmod : str         // the module the function being checked lives in
    gnames : str[]
    gvals : i64[]
    ginit : i64[]
    ite : i64[]          // iterators: the element type per interned kind
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    nrep : i64[]         // see Chk
    nlam : i64[]         // see Chk
    nhold : i64[]        // see Chk
    nfree : i64[]        // see Chk
    // Packing a T[] whose length never changes and which never leaves
    // the function.  Per slot of the function under check: how many
    // elements it was born with (⁻1 for no candidate), how many times
    // the name was read, and how many of those reads were somewhere a
    // packed array can serve.  The two counts are compared rather than
    // the uses enumerated, so a use nobody thought of disqualifies the
    // binding instead of miscompiling it.
    pcnt : i64[]
    puse : i64[]
    psafe : i64[]
    // The same counting for a different question.  Packing asks
    // whether a read wanted the header, and a push does -- it changes
    // the length.  Giving memory back asks whether a read could have
    // kept the object somewhere, and a push could not: it writes into
    // what is already there and keeps nothing.  Two questions, two
    // counts.
    kuse : i64[]
    ksafe : i64[]
    // ------------------------------------------------------------------
    // Borrows that come back, and lifetimes that end at the last use
    // ------------------------------------------------------------------
    // Per node: 1 or 2 where a call answers a borrow, shared or mutable
    nlend : i64[]
    // Which caller bindings a borrowed answer reaches into: one row per
    // (call node, scope entry) pair
    lorig_node : i64[]
    lorig_s : i64[]
    // Beside snames: the scope entry this binding is lent to (⁻1 for
    // none), and whether the binding is itself a borrowed answer
    slend : i64[]
    sborrow : i64[]
    // The lends in force: the borrower, the origin, the hold the origin
    // had before, the line the lend runs to, and how it is lent
    lend_b : i64[]
    lend_o : i64[]
    lend_back : Hold[]
    lend_until : i64 ¤"line"[]
    lend_how : i64[]
    // The last line each name in the function under check is read on,
    // found by reading the function's tokens before its body is checked.
    // Looked up by name through an open-addressed table, since the
    // largest functions have hundreds of names and thousands of tokens
    // and a walk per token was more than the bootstrap could afford.
    lu_name : str[]
    lu_line : i64 ¤"line"[]
    lu_slot : i64[]      // LU_SIZE entries: 1 + the name's index, or 0
    lu_used : i64[]      // the entries taken, so a function starts clean
    lu_tok : i64[]       // per name: the token it was first read from
    // The loops in hand: the line each ends on
    loop_end : i64 ¤"line"[]
    // Where the statement in hand ends, and where the block does
    stmt_end : i64 ¤"line"
    blk_end : i64 ¤"line"
    // What is given back after which statement (see Chk), and per
    // frame slot whether it already was
    rec_stmt : i64[]
    rec_slot : i64[]
    lrec : i64[]
    // the candidates, settled once the function's packing is: a packed
    // array lives in the frame and has no block to give back
    rec_cand_stmt : i64[]
    rec_cand_slot : i64[]
    rec_cand_tok : i64[]
    // per frame slot: 1 where the binding was born from a literal or a
    // join, which are fresh; a slice or a reshape may share storage
    lfresh : i64[]
    smove : i64[]        // per frame slot, for the function under check
    nmove : i64[]        // see Chk
    pnode_slot : i64[]   // the nodes to mark, if it comes to that
    pnode_id : i64[]
    // How long each binding lives.  Statements are numbered as they
    // are walked, so a lifetime is the number of the statement that
    // declared it and the number of the last that used it; the two
    // being equal means nothing ever read what was bound.  lesc says
    // the end is not the last use but the end of the scope, which is
    // what happens where a callee may have kept what it was handed.
    stmt_seq : i64
    cur_stmt : ast.Nk    // which kind of statement is being checked
    lbirth : i64[]
    llast : i64[]
    luse : i64[]         // how many times it was read
    lesc : i64[]
    lwarn : i64[]        // 1 where nothing reading it is worth saying
    ltok : i64[]
    // Whether every value a binding has held was allocated where it
    // was written -- a literal, a ⍴, a ⧺, a slice.  A call is not
    // among them: a function may answer an array it was only lent,
    // and giving that back would be giving back someone else's.
    lown : i64[]
    // The walks in progress, and whether the name each walks has been
    // written over inside it.  A walk that loses its name is holding
    // the last reference to what it walks.
    wslot : i64[]
    wreb : i64[]
    fslots : i64[]
    log : str[]
    diags : diag.Diag[]
    snames : str[]
    stype : i64[]
    smut : i64[]
    sslot : i64[]
    // What a binding has lent out, and so what is left of it:
    // Hold.free while nothing borrows it, Hold.read while something
    // is reading it and it may only be read, Hold.none while
    // something has it mutably and the name reaches nothing at all.
    sheld : Hold[]
    // Every hold taken, and what the binding said before it was taken,
    // so the scope that took a hold is the scope that gives it back.
    // A borrow ends where the thing borrowing it ends: a walk's at the
    // end of its body, an iterator's at the end of the block it was
    // made in, since nothing in the language says sooner.
    hslot : i64[]
    hback : Hold[]
    hmark : i64[]
    marks : i64[]
    nslots : i64
    loop_depth : i64
    cur_fn : i64
    in_contract : bool
    in_post : bool       // @old may be written here and nowhere else
    scope_floor : i64    // a lambda's body sees nothing below this
    lams : i64[]         // every λ node, in the order lowered
    lamns : i64[]        // … and the slot count its frame must cover
    psfn : i64[]         // partial-application shims: the named target, ⁻1 for a closure
    psk : i64[]          // … how many arguments the box binds
    psnp : i64[]         // … the target's full parameter count
    fdone : i64[]        // per function: 0 unchecked, 1 checked, 2 being checked
    skipfn : i64[]       // 1 where a generic was never shaped by a call
    lam_ret : i64        // the lambda under check answers this; ⁻1 outside
    val_want : i64       // the last statement of the block being checked
                         // is that block's value and is wanted at this
                         // type; ⁻1 where no value is wanted.  TY_UNIT
                         // says one is, and what type is still open.
    argcopy : i64[]      // see Chk

impl Checker:
    fn derr(&mut self, tok : i64, m : str):
        self.diags.push(diag.Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m, level: diag.Level.error, code: diag.DIAG_NONE})

    // The same complaint, saying which one it is.  A number is what an
    // @expect matches on and what a reader looks up; the words beside
    // it are free to improve without anything having to be rewritten.
    @pre(code > 0)
    fn derrc(&mut self, tok : i64, code : i64, m : str):
        self.diags.push(diag.Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m, level: diag.Level.error, code: code})

    // A warning does not refuse the program; -Werror makes it one.
    @pre(code > 0)
    fn dwarn(&mut self, tok : i64, code : i64, m : str):
        self.diags.push(diag.Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m, level: diag.Level.warning, code: code})

    fn text(&self, tok : i64) → str:
        tokens.run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    // @sizeof(T), T.alignof and T.offsetof(f) all answer a count of
    // bytes settled here, and all three fold into the literal the
    // lowering would have had to make anyway.
    fn fold_bytes(&mut self, id : i64, v : i64):
        self.a.nkind[id × 1¤ptrdiff] ← ast.Nk.lit_int
        self.a.na[id × 1¤ptrdiff] ← v
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.a.nc[id × 1¤ptrdiff] ← 0
        self.set_type(id, types.ty_with_unit(types.TY_I64, types.UNIT_BYTE))

    // the struct a name stands for, where the name is a type's and not
    // a binding's; ⁻1 for anything else
    fn type_named(&self, na : i64) → i64:
        if self.kind_of(na) ≠ ast.Nk.var:
            return ⁻1
        let nm := self.text(self.a.ntok[na × 1¤ptrdiff])
        if self.lookup(nm) ≠ ⁻1: ⁻1 else: self.struct_here(nm)

    // a struct with no layout has no size a program may use: reporting
    // one would invite exactly the dependency the default prevents
    fn layout_err(&mut self, tok : i64, si : i64, what : str):
        let d := self.a.structs[si × 1¤ptrdiff]
        if not d.is_repr_c:
            self.derr(tok, "struct '" ⧺ d.name ⧺ """' has no defined layout; annotate it with
                                                  " @repr(C) to give it one""")
            return
        let bad : i64 = c_bad_field(self.a, si)
        if bad = ⁻1:
            self.derr(tok, "struct '" ⧺ d.name ⧺ "' has no C layout")
            return
        let ftok : i64 = self.a.extra[d.fields_off + 1 + bad × 2¤ptrdiff]
        let fty : i64 = self.a.extra[d.fields_off + 2 + bad × 2¤ptrdiff]
        self.derr(ftok, "in @repr(C) struct '" ⧺ d.name ⧺ "', field '" ⧺ self.text(ftok) ⧺ "': " ⧺ self.tn(fty) ⧺ " has no defined C representation")
        _ ← what

    // the type a name stands for where the name is a type's, so
    // @sizeof takes the type itself and not only a value of it
    fn named_type(&self, na : i64) → i64:
        if self.kind_of(na) ≠ ast.Nk.var:
            return ⁻1
        let nm := self.text(self.a.ntok[na × 1¤ptrdiff])
        if self.lookup(nm) ≠ ⁻1:
            return ⁻1
        let bt : i64 = types.TYNAMES[nm] ?? ⁻1
        if bt ≠ ⁻1:
            return bt
        let si : i64 = self.struct_here(nm)
        if si ≠ ⁻1:
            return types.mk_sty(si)
        let ei : i64 = self.enum_here(nm)
        if ei = ⁻1: ⁻1 else: types.mk_ety(ei)

    // A run of bytes is made of one of three things: bytes as they
    // are, a struct whose layout says what its bytes are, or a table
    // of such structs, which C would lay out one after the other.
    fn iov_source_ok(&mut self, tok : i64, pt : i64):
        if pt = types.mk_aty(types.TY_U8):
            return
        let et : i64 = if types.ty_is_arr(pt): self.elem_of(pt) else: pt
        if not types.ty_is_struct(et):
            self.derr(tok, """a run of bytes is made from bytes, a struct with a defined layout, or
                            " an array of them; this is """ ⧺ self.tn(pt))
            return
        let (psz, pal) := c_struct_layout(self.a, types.ty_sidx(et), 0)
        _ ← pal
        if psz = ⁻1:
            self.layout_err(tok, types.ty_sidx(et), "written")

    fn check_sizeof(&mut self, id : i64, tok : i64, na : i64):
        let named : i64 = self.named_type(na)
        let t : mut i64 = named
        if named = ⁻1:
            self.check_expr(na, types.TY_UNIT)
            t ← types.ty_strip_ref(self.ty_of(na))
        let (sz, al) := c_layout(self.a, t, 0)
        _ ← al
        if sz ≠ ⁻1:
            self.fold_bytes(id, sz)
            return
        // no size to give.  A struct knows why -- no layout asked for,
        // or a field C cannot represent -- and says so; anything else
        // has no C representation at all.
        if types.ty_is_struct(t):
            self.layout_err(tok, types.ty_sidx(t), "sized")
        else:
            self.derr(tok, "@sizeof measures what C can represent; " ⧺ self.tn(t) ⧺ " it cannot")
        self.fold_bytes(id, 0)

    fn sname_of(&self, t : i64) → str:
        // a diagnostic writes the struct's name, not its number
        if types.ty_is_struct(types.ty_strip_ref(t)):
            return self.a.structs[types.ty_sidx(types.ty_strip_ref(t)) × 1¤ptrdiff].name
        self.tn(t)

    // The file a module is rooted in, which is how a diagnostic names
    // one: a stem is not something a reader can go and open, and two
    // modules may share one.
    fn mod_file(&self, m : str) → str:
        foreach i := 0¤ptrdiff…#self.a.mnames:
            if self.a.mnames[i] = m:
                return self.a.mroots[i]
        m

    // A bare name as the module in hand writes it.  A module is a
    // file, so the whole name is that file's and the name itself, and
    // a program of one file writes the name and nothing else.
    @post(r: #r >= #name)
    fn whole(&self, name : str) → str:
        if self.curmod = "": name else: self.curmod ⧺ "." ⧺ name

    // Whether a bare name may also be looked for as it was written.
    // Only the root module's may: a bare key is where the root module
    // holds its own names, and what a module did not bind is not its
    // to name.  The builtins and what std holds are reached another
    // way and are nobody's to hide.
    fn bare_too(&self) → bool:
        self.curmod = ""

    // A struct named from inside a module: its own first, then the
    // names that belong to nobody -- the builtins and what std holds.
    fn struct_here(&self, name : str) → i64:
        let si : i64 = self.struct_index(self.whole(name))
        if si ≠ ⁻1:
            return si
        if not self.bare_too():
            return ⁻1
        self.struct_index(name)

    fn struct_index(&self, name : str) → i64:
        self.s_at.find(name)

    // a field's position and type within a struct, by name; (⁻1, 0)
    // when the struct has no such field
    fn field_of(&self, sidx : i64, fname : str) → (i64, i64):
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let n : i64 ¤ptrdiff = self.a.extra[d.fields_off] × 1¤ptrdiff
        foreach i := 0…n:
            let ftok : i64 = self.a.extra[d.fields_off + 1 + i × 2]
            if self.text(ftok) = fname:
                return (@dropunit(i), self.a.extra[d.fields_off + 2 + i × 2])
        (⁻1i64, 0i64)

    // whether the expression builds a struct of its own rather than
    // naming one that already lives somewhere
    fn is_fresh_struct(&self, id : i64) → bool:
        let k : ast.Nk = self.kind_of(id)
        k = ast.Nk.slit or k = ast.Nk.call or k = ast.Nk.mcall

    // A name written unqualified, found the way its module sees it:
    // the module in hand first, then the names that belong to nobody.
    // Nothing found this way can be hidden, since a module hides
    // nothing from itself and what belongs to nobody is everyone's.
    fn fn_index_here(&self, name : str) → i64:
        let f : i64 = self.fn_in(self.whole(name))
        if f ≠ ⁻1:
            return f
        if not self.bare_too():
            return ⁻1
        self.fn_in(name)

    // the function whose whole name is this, or ⁻1
    fn fn_in(&self, whole : str) → i64:
        self.fw_at.find(whole)

    fn fn_index(&self, name : str) → i64:
        self.fn_at.find(name)

    // A global named from inside a module: its own first, then the
    // names that belong to nobody, as a call is found.
    fn global_here(&self, name : str) → i64:
        let g : i64 = self.global_index(self.whole(name))
        if g ≠ ⁻1:
            return g
        if not self.bare_too():
            return ⁻1
        self.global_index(name)

    fn global_index(&self, name : str) → i64:
        self.g_at.find(name)

    fn lookup(&self, name : str) → i64:
        foreach i := @dropunit(#self.snames) - 1…self.scope_floor - 1:
            if self.snames[i × 1¤ptrdiff] = name:
                return i
        ⁻1

    fn declare(&mut self, tok : i64, ty : i64, is_mut : i64) → i64:
        let name := self.text(tok)
        if types.ty_is_var(types.ty_strip_ref(ty)):
            self.derr(tok, "a type variable belongs in a signature; a binding states what it holds")
        if types.names_int_type(name):
            self.derr(tok, "'" ⧺ name ⧺ "' names a type and cannot name a variable")
        let low : i64 = self.marks[#self.marks - 1]
        foreach i := @dropunit(#self.snames) - 1…low - 1:
            if self.snames[i × 1¤ptrdiff] = name:
                self.derr(tok, "'" ⧺ name ⧺ "' is already defined in this scope")
                return self.sslot[i × 1¤ptrdiff]
        let slot : i64 = self.nslots
        self.nslots ← self.nslots + 1
        self.snames.push(name)
        self.stype.push(ty)
        self.smut.push(is_mut)
        self.sslot.push(slot)
        self.sheld.push(Hold.free)
        self.slend.push(⁻1)
        self.sborrow.push(0)
        self.life_born(slot, tok)
        slot

fn begins_underscore(nm : str) → bool:
    "_" ⊑ nm

impl Checker:
    // A binding leaves its scope here, so this is where its lifetime
    // is settled and where anything worth saying about it is said.
    // What is worth saying is that nothing read it: born and last used
    // at the same statement, and never handed anywhere that might have
    // kept it.
    fn life_ends(&mut self, slot : i64):
        if slot < 0 or slot × 1¤ptrdiff >= #self.lbirth:
            return
        let born : i64 = self.lbirth[slot × 1¤ptrdiff]
        let tok : i64 = self.ltok[slot × 1¤ptrdiff]
        if tok = ⁻1:
            return
        let nm := self.text(tok)
        let esc : i64 = self.lesc[slot × 1¤ptrdiff]
        // Where something may have kept it, the last use here says
        // nothing about when it stops being needed, and the worst case
        // is the whole scope -- which ends at the statement being left.
        let last : i64 = if esc = 1: self.stmt_seq else: self.llast[slot × 1¤ptrdiff]
        self.log.push("{\"function\": \"" ⧺ self.a.fns[self.cur_fn × 1¤ptrdiff].name ⧺ "\", \"line\": " ⧺ tokens.i64_str(@dropunit(self.toks.line[tok × 1¤ptrdiff])) ⧺ ", \"decision\": \"lifetime\", \"name\": \"" ⧺ nm ⧺ "\", \"born\": " ⧺ tokens.i64_str(born) ⧺ ", \"last\": " ⧺ tokens.i64_str(last) ⧺ ", \"escapes\": " ⧺ (if esc = 1: "true" else: "false") ⧺ "}")
        // A name beginning with _ says the binding is meant to go
        // unread, which is the one answer to this warning that is not
        // a change to the code.
        let unread : bool = self.luse[slot × 1¤ptrdiff] = 0 and esc = 0
        let worth : bool = self.lwarn[slot × 1¤ptrdiff] = 1 and nm ≠ "_" and not begins_underscore(nm)
        if unread and worth:
            self.dwarn(tok, 2421, "'" ⧺ nm ⧺ """' is bound and never read; its lifetime begins and
                                              " ends at the statement that declares it. Name it '_""" ⧺ nm ⧺ "' if that is meant")

    fn push_scope(&mut self):
        self.marks.push(@dropunit(#self.snames))
        self.hmark.push(@dropunit(#self.hslot))

    fn pop_scope(&mut self):
        // the holds this scope took, given back in the order they were
        // taken, so two walks over one array unwind to what was there
        let hlow : i64 = self.hmark.pop() ?? 0
        while @dropunit(#self.hslot) > hlow:
            let hs : i64 = self.hslot.pop() ?? 0
            let hb : Hold = self.hback.pop() ?? Hold.free
            self.sheld[hs × 1¤ptrdiff] ← hb
        let low : i64 = self.marks.pop() ?? 0
        // a lend ends with the scope of either side of it
        self.end_lends_from(low)
        while @dropunit(#self.snames) > low:
            self.life_ends(self.sslot[(#self.snames - 1¤ptrdiff)])
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0
            _ ← self.sheld.pop() ?? Hold.free
            _ ← self.slend.pop() ?? 0
            _ ← self.sborrow.pop() ?? 0

    fn is_open(&self, t : i64) → bool:
        t = types.TY_UNT or t = types.TY_EMPTY

    fn set_type(&mut self, id : i64, t : i64):
        self.ntype[id × 1¤ptrdiff] ← t

    fn ty_of(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kind_of(&self, id : i64) → ast.Nk:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // Untyped literals: folding, adoption, range checks
    // ------------------------------------------------------------------

    // whether the wrapped value v (big says ≥ 2^63) fits the type t
    fn lit_fits(&self, v : i64, big : i64, t : i64) → bool:
        let bits : i64 = types.ty_bits(t)
        let sgn : i64 = types.ty_sgn(t)
        if big = 1:
            return sgn = 0 and bits = 64
        if sgn = 0:
            if v < 0: return false
            if bits = 64: return true
            return v <= (1 « bits) - 1
        if bits = 64: return true
        let half : i64 = 1 « (bits - 1)
        v >= 0 - half and v <= half - 1

    // give an untyped node the type its context settled on
    // whether an integer value settles into the wanted integer type,
    // as the bootstrap has it: a value-preserving widening passes as
    // itself; a narrowing or sign-crossing is accepted with a fit
    // check the lowering emits, so a value that does not fit stops
    // the run exactly where the interpreter stops it.  Anything not
    // two integers answers plain type equality.
    // arguments are held tighter than bindings: a typed plain value
    // does not adopt a parameter's measure -- only an untyped literal
    // does -- which is the bootstrap's own rule
    fn fit_arg(&mut self, e : i64, want0 : i64) → bool:
        let t : i64 = self.ty_of(e)
        let want : i64 = types.ty_strip_ref(want0)
        if types.ty_is_int(t) and types.ty_is_int(want) and types.ty_unit(t) = 0 and types.ty_unit(want) ≠ 0:
            return false
        self.try_fit(e, want0)

    fn try_fit(&mut self, e : i64, want0 : i64) → bool:
        let t : i64 = self.ty_of(e)
        let want : i64 = types.ty_strip_ref(want0)
        if t = want:
            return true
        if types.ty_is_bigint(want) and types.ty_is_int(t):
            // every fixed width fits an int, which has none to leave
            self.nhold[e × 1¤ptrdiff] ← 2
            return true
        if types.ty_is_opt(want) and not types.ty_is_opt(t):
            // An optional is the type that holds a value and the
            // absence of one, so a value meets it by being held.  ∅ is
            // already one of its values and is held by nothing.  This
            // is the same reading as a wider type meeting a narrower
            // value: what is written is the value, and the type it
            // meets says what is done with it on the way in.
            if t = types.TY_EMPTY:
                return true
            if not self.try_fit(e, types.ty_opt_base(want)):
                return false
            // what the optional holds may itself have asked something
            // of the value -- an int? asks for both -- so this adds the
            // holding rather than replacing what is already said
            self.nhold[e × 1¤ptrdiff] ← self.nhold[e × 1¤ptrdiff] | 1
            return true
        if types.ty_is_mat(t) and types.ty_is_mat(want):
            // a stated extent fits an open one; an open one fits only
            // openness, since nothing vouches for its size
            return self.mat_elem(t) = self.mat_elem(want) and self.mat_rank(t) = self.mat_rank(want) and (self.mat_rr(want) = ⁻1 or self.mat_rr(want) = self.mat_rr(t)) and (self.mat_cc(want) = ⁻1 or self.mat_cc(want) = self.mat_cc(t)) and (self.mat_dd(want) = ⁻1 or self.mat_dd(want) = self.mat_dd(t))
        if not (types.ty_is_int(t) and types.ty_is_int(want)):
            return false
        if not self.stands_for(types.ty_unit(t), types.ty_unit(want)) and types.ty_unit(t) ≠ 0:
            // a measured value does not quietly drop or change its
            // measure; @dropunit is the word for parting with one.  A
            // measure that stands in for the one wanted is not a change
            // of measure -- it is what the declaration said it was for.
            return false
        // A value is kept only as wide as its type, so a widening is
        // work: the bits above its own are the sign or the zeros only
        // where something has put them there, and this is where.  A
        // narrowing is work for the other reason, the value having to
        // be checked against the range it is going into.
        self.ncvt[e × 1¤ptrdiff] ← want
        true

    fn adopt(&mut self, id : i64, t : i64):
        if self.ty_of(id) = types.TY_EMPTY:
            if types.ty_is_opt(t):
                self.set_type(id, t)
            else:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "∅ is the absent optional; " ⧺ self.tn(t) ⧺ " holds no absence")
            return
        if self.ty_of(id) ≠ types.TY_UNT:
            return
        if types.ty_is_opt(t):
            // a number written where an optional is wanted settles on
            // what the optional holds, and is held on the way in
            self.adopt(id, types.ty_opt_base(t))
            self.nhold[id × 1¤ptrdiff] ← self.nhold[id × 1¤ptrdiff] | 1
            return
        if types.ty_is_bigint(t):
            // int has no width to settle on, so a number written where
            // one is wanted is made into one on the way in
            self.set_type(id, types.TY_INT)
            self.nhold[id × 1¤ptrdiff] ← 2
            return
        if types.ty_is_enum(t) and self.kind_of(id) = ast.Nk.lit_int:
            // an enum holds exactly its members, so a written-out
            // number becomes one only where it names one -- and a
            // @flag enum's values are combinations, which no bare
            // number names, so none becomes one there
            let ei9 : i64 = types.ty_eidx(t)
            if self.enum_is_flag(t):
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "'" ⧺ self.a.enames[ei9 × 1¤ptrdiff] ⧺ """' is a @flag enum, so its values
                                  " are combinations of members that a bare number does not name""")
                self.set_type(id, t)
                return
            let st9 : i64 = self.a.estart[ei9 × 1¤ptrdiff]
            let n9 : i64 = self.a.ecount[ei9 × 1¤ptrdiff]
            let v9 : i64 = self.a.na[id × 1¤ptrdiff]
            let ok9 : mut bool = false
            foreach k9 := 0…n9:
                if self.a.evalues[(st9 + k9) × 1¤ptrdiff] = v9:
                    ok9 ← true
            if not ok9:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "'" ⧺ self.a.enames[ei9 × 1¤ptrdiff] ⧺ "' holds exactly its members, and " ⧺ tokens.i64_str(v9) ⧺ " is not one of them")
            self.set_type(id, t)
            return
        if not types.ty_is_int(t):
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "a number cannot become " ⧺ self.tn(t))
            self.set_type(id, types.TY_I64)
            return
        if self.kind_of(id) = ast.Nk.lit_int:
            if not self.lit_fits(self.a.na[id × 1¤ptrdiff],
                                 self.a.nb[id × 1¤ptrdiff], t):
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "the literal does not fit " ⧺ self.tn(t))
        elif self.kind_of(id) = ast.Nk.st_if:
            // every branch was untyped; the context settles each
            let tv : i64 = self.block_value_node(self.a.nb[id × 1¤ptrdiff])
            let ncc : i64 = self.a.nc[id × 1¤ptrdiff]
            let ev : mut i64 = ⁻1
            if ncc ≠ ⁻1:
                ev ← self.block_value_node(ncc)
            if tv ≠ ⁻1:
                self.adopt(tv, t)
            if ev ≠ ⁻1:
                self.adopt(ev, t)
        elif self.kind_of(id) = ast.Nk.sub and self.ty_of(self.a.na[id × 1¤ptrdiff]) = types.TY_CHAR:
            // The distance between two characters, which is worked out
            // while the program runs rather than folded here.  It is
            // untyped for the same reason a literal is -- nothing about
            // two code points says how wide the number between them
            // should be -- so it settles on what holds it, and the
            // subtraction then runs at that width, where a difference
            // the width cannot hold stops the program.
            let settled : i64 = 0
            _ ← settled
        else:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "this untyped computation cannot settle; ngplc folds only literals")
        self.set_type(id, t)

    // fold an arithmetic node whose operands folded to literals; the
    // computation is exact, and one that leaves i64 is refused since
    // no run of the program could hold it either
    fn fold_bin(&mut self, id : i64, k : ast.Nk, tok : i64, l : i64, r : i64):
        let res : mut i64 = 0
        let bad : mut bool = false
        if k = ast.Nk.add:
            res ← @wrap(l + r)
            bad ← (l > 0 and r > 0 and res < 0) or (l < 0 and r < 0 and res >= 0)
        elif k = ast.Nk.sub:
            res ← @wrap(l - r)
            bad ← (l >= 0 and r < 0 and res < 0) or (l < 0 and r > 0 and res >= 0)
        elif k = ast.Nk.mul:
            res ← @wrap(l × r)
            if l ≠ 0:
                bad ← (res ÷ l ?? 0) ≠ r or (l = ⁻1 and r = 0 - 9223372036854775807 - 1)
        elif k = ast.Nk.shl:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← @wrap(l « r)
                bad ← (res » r) ≠ l
        elif k = ast.Nk.shr:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← l » r
        elif k = ast.Nk.band:
            res ← l & r
        elif k = ast.Nk.bor:
            res ← l | r
        elif k = ast.Nk.bxor:
            res ← l ^ r
        elif k = ast.Nk.maxop:
            res ← l ⌈ r
        elif k = ast.Nk.minop:
            res ← l ⌊ r
        else:
            // comparisons of two untyped numbers answer at once
            let b : mut i64 = 0
            if k = ast.Nk.eq: b ← if l = r: 1 else: 0
            elif k = ast.Nk.ne: b ← if l ≠ r: 1 else: 0
            elif k = ast.Nk.lt: b ← if l < r: 1 else: 0
            elif k = ast.Nk.le: b ← if l <= r: 1 else: 0
            elif k = ast.Nk.gt: b ← if l > r: 1 else: 0
            elif k = ast.Nk.ge: b ← if l >= r: 1 else: 0
            else:
                self.derr(tok, "these two untyped numbers cannot meet here; state a type")
                self.set_type(id, types.TY_I64)
                return
            self.a.nkind[id × 1¤ptrdiff] ← ast.Nk.lit_bool
            self.a.na[id × 1¤ptrdiff] ← b
            self.set_type(id, types.TY_BOOL)
            return
        if bad:
            self.derr(tok, "this literal computation leaves i64, which no run could hold")
        self.a.nkind[id × 1¤ptrdiff] ← ast.Nk.lit_int
        self.a.na[id × 1¤ptrdiff] ← res
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, types.TY_UNT)

    // ------------------------------------------------------------------
    // Expression checking; `want` is the type the context asks for,
    // 0 (TY_UNIT) meaning it asks nothing
    // ------------------------------------------------------------------

    fn unify_arith(&mut self, tok : i64, id : i64, k : ast.Nk, tl : i64, tr : i64) → i64:
        // both integer operands; answers the operation's type
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if tl = types.TY_UNT and tr = types.TY_UNT:
            return types.TY_UNT
        if types.ty_is_bigint(tl) or types.ty_is_bigint(tr):
            // an accumulator is not narrowed by what is added to it:
            // int is wider than any fixed width, so the other side is
            // made into one and the answer is an int
            if k ≠ ast.Nk.add and k ≠ ast.Nk.sub and k ≠ ast.Nk.mul:
                // what an int can be worked with so far.  A division
                // wants the long division this has not written yet,
                // and a bit operation wants a width int has not got.
                self.derr(tok, """an int is added, subtracted and multiplied so far; this operator
                                " does not reach one yet""")
                return types.TY_INT
            if not types.ty_is_bigint(tl):
                self.to_bigint(na, tl)
            if not types.ty_is_bigint(tr):
                self.to_bigint(nb, tr)
            return types.TY_INT
        if tl = types.TY_UNT:
            self.adopt(na, tr)
            return tr
        if tr = types.TY_UNT:
            // × of a scalar and a measured value keeps the measure, so
            // an untyped right side of × under a united left adopts the
            // bare type; everything else adopts in full
            self.adopt(nb, tl)
            return tl
        // two typed operands: wider wins, and what measure the result
        // carries is the operator's own business
        let ru : i64 = self.unit_meet(tok, k, tl, tr)
        if types.ty_sgn(tl) ≠ types.ty_sgn(tr):
            // an unsigned value narrower than the signed side widens
            // as itself, and the signed type carries the operation
            let sg : i64 = if types.ty_sgn(tl) = 1: tl else: tr
            let un : i64 = if types.ty_sgn(tl) = 1: tr else: tl
            if types.ty_bits(sg) > types.ty_bits(un):
                return types.ty_with_unit(types.ty_drop_unit(sg), ru)
            self.derr(tok, "signed and unsigned do not meet; " ⧺ self.tn(tl) ⧺ " and " ⧺ self.tn(tr))
            return tl
        let wide : i64 = if types.ty_bits(tl) >= types.ty_bits(tr): tl else: tr
        types.ty_with_unit(types.ty_drop_unit(wide), ru)

    // What measure an operation's result carries, and whether the two
    // operands may meet at all.  A sum is of two of the same thing, so
    // its sides must be measured alike -- a plain number is not a
    // length, and the bootstrap refuses to add it to one.  A product
    // scales: one side measured and one plain keeps the measure, but
    // both measured makes a measure of its own (ptrdiff×ptrdiff),
    // which core-2 has no way to write down and so refuses.  A
    // quotient divides the measures out: alike, they cancel.
    fn unit_meet(&mut self, tok : i64, k : ast.Nk, tl : i64, tr : i64) → i64:
        let ul : i64 = types.ty_unit(tl)
        let ur : i64 = types.ty_unit(tr)
        if k = ast.Nk.none:
            // a conditional is not an operation on its two sides; it
            // hands one of them on, and the bootstrap lets the binding
            // say what that is
            return ul ⌈ ur
        if k = ast.Nk.shl or k = ast.Nk.shr or k = ast.Nk.band or k = ast.Nk.bor or k = ast.Nk.bxor:
            // measured operands are refused outright further on
            return ul ⌈ ur
        if k = ast.Nk.mul or k = ast.Nk.satmul:
            if ul ≠ 0 and ur ≠ 0:
                self.derr(tok, "multiplying " ⧺ self.tn(tl) ⧺ " by " ⧺ self.tn(tr) ⧺ """ makes a
                        " measure of its own, which core-2 cannot write down""")
                return 0
            return ul ⌈ ur
        if k = ast.Nk.div:
            if ul = ur:
                // the measures cancel and the answer is a bare count
                return 0
            if ur ≠ 0:
                self.derr(tok, "dividing " ⧺ self.tn(tl) ⧺ " by " ⧺ self.tn(tr) ⧺ """ makes a
                        " measure of its own, which core-2 cannot write down""")
                return 0
            return ul
        if k = ast.Nk.mod:
            if ul = ur:
                // what is left over is measured as what was divided
                return ul
            if ur ≠ 0:
                self.derr(tok, "taking " ⧺ self.tn(tl) ⧺ " modulo " ⧺ self.tn(tr) ⧺ """ makes a
                        " measure of its own, which core-2 cannot write down""")
                return 0
            return ul
        // + - ⌈ ⌊ ⊞ ⊟: two of the same thing, or nothing.  One side
        // standing in for the other settles which measure the answer
        // carries; neither doing so is two different things being added.
        if ul = ur:
            return ul
        if self.stands_for(ul, ur):
            return ur
        if self.stands_for(ur, ul):
            return ul
        self.derr(tok, "a value measured " ⧺ self.tn(tl) ⧺ " does not meet one measured " ⧺ self.tn(tr))
        ul

    fn check_expr(&mut self, id : i64, want : i64):
        let k : ast.Nk = self.kind_of(id)
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        match k:
            ast.Nk.lit_int:
                if nb >= 2:
                    // the width suffix -- or a character literal -- closed
                    // the type at the lexer; only the big bit stays for
                    // the fit check
                    let st : i64 = nb » 1
                    self.a.nb[id × 1¤ptrdiff] ← nb & 1
                    if st = types.TY_CHAR:
                        self.set_type(id, types.TY_CHAR)
                        return
                    if types.ty_is_enum(st):
                        self.set_type(id, st)
                        return
                    self.set_type(id, types.TY_UNT)
                    self.adopt(id, st)
                elif want ≠ types.TY_UNIT and types.ty_is_int(want):
                    self.set_type(id, types.TY_UNT)
                    self.adopt(id, want)
                else:
                    self.set_type(id, types.TY_UNT)
            ast.Nk.lit_bool:
                self.set_type(id, types.TY_BOOL)
            ast.Nk.lit_str:
