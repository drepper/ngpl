                // ÷ under ? answers the quotient, or ∅ for the zero
                let dl9 : i64 = self.a.na[na × 1¤ptrdiff]
                let dr9 : i64 = self.a.nb[na × 1¤ptrdiff]
                self.check_expr(dl9, TY_UNIT)
                self.check_expr(dr9, self.ty_of(dl9))
                if self.ty_of(dl9) = TY_UNT and self.ty_of(dr9) = TY_UNT:
                    self.adopt(dl9, TY_I64)
                    self.adopt(dr9, TY_I64)
                let dt9 : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, self.kind_of(na), self.ty_of(dl9), self.ty_of(dr9))
                self.set_type(na, if dt9 ≠ TY_UNT: dt9 else: TY_I64)
