            self.lam_ret ← lr_saved
            self.scope_floor ← floor9
            self.pop_scope()
            self.lams.push(id)
            self.lamns.push(self.nslots)
            self.nslot[id × 1¤ptrdiff] ← @dropunit(#self.lams) - 1
            self.set_type(id, mk_lty(nc))
        elif k = NK_BADLAM:
            if na = 1:
                self.derrc(tok, 2025, """an empty capture list says nothing; a lambda with no
                                       " captures leaves the bars off""")
            elif na = 2:
