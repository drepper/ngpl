                let ld_saved : i64 = self.loop_depth
                self.loop_depth ← 0
                self.check_block(nb, true)
                self.loop_depth ← ld_saved
                let boff : i64 = self.a.na[nb × 1¤ptrdiff]
                let bn : i64 = self.a.extra[boff × 1¤ptrdiff]
                let last_is_value : mut bool = false
                if bn > 0:
                    let blast : i64 = self.a.extra[(boff + bn) × 1¤ptrdiff]
                    if self.stmt_is_value(blast):
                        last_is_value ← true
                if not last_is_value and not self.block_returns(nb):
