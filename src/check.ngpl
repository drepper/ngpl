                        if ty_ref_kind(cty0) ≠ 0 or not (ty_is_int(cty0) or cty0 = TY_BOOL or cty0 = TY_CHAR or cty0 = TY_STR or ty_is_lam(cty0)):
                            self.derr(ctok, "a capture is one value read now; '" ⧺ self.text(ctok) ⧺ "' is " ⧺ self.tn(cty0))
                            self.set_type(id, TY_I64)
                            return
                        // The capture's value is read here, where the
                        // lambda is written, and a read is what it is:
                        // a binding used only through one is not a
                        // binding nothing reads.
                        self.life_used(self.sslot[cs × 1¤ptrdiff])
                        couter.push(self.sslot[cs × 1¤ptrdiff])
                        ctoks.push(ctok)
                        ctys.push(cty0)
            self.push_scope()
            let floor9 : i64 = self.scope_floor
            self.scope_floor ← @dropunit(#self.snames)
            foreach pi := 0…np9:
                let ptok : i64 = self.a.extra[(loff + 1 + pi × 2) × 1¤ptrdiff]
                let pty : i64 = self.a.extra[(loff + 2 + pi × 2) × 1¤ptrdiff]
                let ps : i64 = self.declare(ptok, pty, 0)
                self.a.extra[(loff + 1 + pi × 2) × 1¤ptrdiff] ← ps
