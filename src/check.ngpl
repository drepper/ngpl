                        ctoks.push(ctok)
                        ctys.push(cty0)
            self.push_scope()
            let floor9 : i64 = self.scope_floor
            self.scope_floor ← @dropunit(#self.snames)
            foreach pi := 0…np9 - 1:
                let ptok : i64 = self.a.extra[(loff + 1 + pi × 2) × 1¤ptrdiff]
                let pty : i64 = self.a.extra[(loff + 2 + pi × 2) × 1¤ptrdiff]
                let ps : i64 = self.declare(ptok, pty, 0)
                self.a.extra[(loff + 1 + pi × 2) × 1¤ptrdiff] ← ps
            if ncap9 > 0:
                foreach ci := 0…ncap9 - 1:
                    _ ← self.declare(ctoks[ci × 1¤ptrdiff], ctys[ci × 1¤ptrdiff], 0)
                    // the cell keeps the outer slot: the value's source
                    self.a.extra[(loff + 2 + np9 × 2 + ci) × 1¤ptrdiff] ← couter[ci × 1¤ptrdiff]
