// ===========================================================================
// Checking: names, types, widths, units, mutability, purity, returns
// ===========================================================================

// method ids the checker writes into an MCALL's nc
let MID_PUSH : i64 = 1
let MID_POP : i64 = 2
let MID_GET : i64 = 3
let MID_CHR : i64 = 4
let MID_ORD : i64 = 5
let MID_CHARS : i64 = 6
let MID_READF : i64 = 7
let MID_WRITEF : i64 = 8
let MID_CLOSEF : i64 = 9
let MID_ITER : i64 = 10
let MID_NEXT : i64 = 11
let MID_DIRITER : i64 = 12
let MID_WRITEV : i64 = 13
let MID_HUPDATE : i64 = 14   // h.update(x): another piece of the message

// What is left of a binding while something else borrows it.  A borrow
// is a claim on the thing borrowed, and the binding is what the claim
// is taken out of: while a shared borrow is outstanding the binding may
// be read and not changed, and while a mutable one is outstanding the
// binding is not a way to reach the thing at all, because the borrow is.
let HOLD_FREE : i64 = 0
let HOLD_READ : i64 = 1
let HOLD_NONE : i64 = 2
let MID_HDIGEST : i64 = 15   // h.digest(): the answer, and the end of the handle

// The module a module is written inside; "" for one written at the top.
fn mod_parent(m : str) → str:
    let cs := m.chars()
    let cut : mut i64 = ⁻1
    if #cs > 0:
        foreach i := 0…#cs - 1:
            if cs[i] = '.':
                cut ← @dropunit(i)
    if cut < 0:
        return ""
    let out : mut str = ""
    let j : mut i64 = 0
    while j < cut:
        out ← out ⧺ cs[j × 1¤ptrdiff]
        j ← j + 1
    out

// whether `inner` is `outer` or is written inside it
fn mod_within(inner : str, outer : str) → bool:
    let m : mut str = inner
    while true:
        if m = outer:
            return true
        if m = "":
            return false
        m ← mod_parent(m)
    false

struct Chk:
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    fslots : i64[]
    gvals : i64[]        // the folded initial value of every global
    ginit : i64[]        // globals whose value is built as the run begins
    lams : i64[]         // every λ node, in the order lowered
    lamns : i64[]        // … and the slot count its frame must cover
    psfn : i64[]         // partial-application shims: target, bound, full count
    psk : i64[]
    psnp : i64[]
    skipfn : i64[]       // 1 where a generic was never shaped by a call
    // Arguments whose copy by value cannot be elided: a by-value
    // parameter beside a &mut of the same thing in the same call.
    // Nearly always empty, which is why lowering asks its length
    // before it asks anything else.
    argcopy : i64[]
    diags : Diag[]

// ---------------------------------------------------------------------------
// The C layout of a @repr(C) struct
// ---------------------------------------------------------------------------
//
// The System V AMD64 psABI's rules, which are also every other
// mainstream C ABI's for these types: a field starts at the next
// offset that is a multiple of its own alignment, the struct aligns
// like its widest field, and its size rounds up to that alignment so
// an array of it keeps every element aligned.
//
// Size and alignment answer ⁻1 where C has no representation for the
// type.  Nothing here reports a diagnostic: the caller knows which
// field it asked about and can point at where that field was written,
// which is where the mistake is.

// how deep a @repr(C) struct may nest before the nesting is taken for
// a cycle.  A struct holding itself by value has no finite size, and
// the fixed ceiling says so without a set to carry around.
let C_NEST_MAX : i64 = 24

// what a type C has no representation for answers, and what a type
// one byte wide and one byte aligned answers.  Both are written out
// as bindings rather than as a bare pair: a tuple of plain numbers
// states no type, and the bootstrap will not let one settle on a type
// it does not have.
fn c_none() → (i64, i64):
    let m : i64 = ⁻1
    (m, m)

fn c_byte_wide() → (i64, i64):
    let one : i64 = 1
    (one, one)

fn c_layout(a : Ast, t0 : i64, depth : i64) → (i64, i64):
    if depth > C_NEST_MAX:
        return c_none()
    let t : i64 = ty_drop_unit(ty_strip_ref(t0))
    if ty_ref_kind(t0) ≠ 0:
        return c_none()
    if t = TY_BOOL:
        return c_byte_wide()
    if ty_is_int(t):
        let w : i64 = ty_bits(t) ÷ 8 ?? 1
        return (w, w)
    if ty_is_enum(t):
        // an enum is its underlying integer and lays out as one
        let w : i64 = ty_bits(a.ewidth[ty_eidx(t) × 1¤ptrdiff]) ÷ 8 ?? 1
        return (w, w)
    if ty_is_farr(t):
        // T[N] is N elements running one after the other, so it aligns
        // like one of them and is as long as all of them
        let (es, ea) := c_layout(a, a.fae[ty_fidx(t) × 1¤ptrdiff], depth + 1)
        if es = ⁻1:
            return c_none()
        return (es × a.fas[ty_fidx(t) × 1¤ptrdiff], ea)
    if ty_is_struct(t):
        return c_struct_layout(a, ty_sidx(t), depth)
    c_none()

@post(r: r[0] = ⁻1 or (r[1] >= 1 and (r[0] % r[1] ?? 1) = 0))
fn c_struct_layout(a : Ast, si : i64, depth : i64) → (i64, i64):
    let d := a.structs[si × 1¤ptrdiff]
    if not d.is_repr_c or depth > C_NEST_MAX:
        return c_none()
    let n : i64 = a.extra[d.fields_off × 1¤ptrdiff]
    let off : mut i64 = 0
    let al : mut i64 = 1
    if n > 0:
        foreach i := 0…n - 1:
            let fty : i64 = a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff]
            let (fs, fa) := c_layout(a, fty, depth + 1)
            if fs = ⁻1:
                return c_none()
            off ← align_up(off, fa) + fs
            al ← al ⌈ fa
    (align_up(off, al), al)

// where field k of a @repr(C) struct begins, or ⁻1 where the struct
// has no layout at all
fn c_field_offset(a : Ast, si : i64, k : i64) → i64:
    let d := a.structs[si × 1¤ptrdiff]
    if not d.is_repr_c:
        return ⁻1
    let n : i64 = a.extra[d.fields_off × 1¤ptrdiff]
    if k < 0 or k >= n:
        return ⁻1
    let off : mut i64 = 0
    foreach i := 0…k:
        let fty : i64 = a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff]
        let (fs, fa) := c_layout(a, fty, 1)
        if fs = ⁻1:
            return ⁻1
        off ← align_up(off, fa)
        if i < k:
            off ← off + fs
    off

// the first field whose type C cannot represent, so the diagnostic can
// point at the field rather than at the struct
fn c_bad_field(a : Ast, si : i64) → i64:
    let d := a.structs[si × 1¤ptrdiff]
    let n : i64 = a.extra[d.fields_off × 1¤ptrdiff]
    if n > 0:
        foreach i := 0…n - 1:
            let fty : i64 = a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff]
            let (fs, fa) := c_layout(a, fty, 1)
            _ ← fa
            if fs = ⁻1:
                return i
    ⁻1

struct Checker:
    a : Ast
    toks : Toks
    src : byte[]
    fnames : str[]
    curmod : str         // the module the function being checked lives in
    gnames : str[]
    gvals : i64[]
    ginit : i64[]
    ite : i64[]          // iterators: the element type per interned kind
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    fslots : i64[]
    diags : Diag[]
    snames : str[]
    stype : i64[]
    smut : i64[]
    sslot : i64[]
    // What a binding has lent out, and so what is left of it:
    // HOLD_FREE while nothing borrows it, HOLD_READ while something
    // is reading it and it may only be read, HOLD_NONE while
    // something has it mutably and the name reaches nothing at all.
    sheld : i64[]
    // Every hold taken, and what the binding said before it was taken,
    // so the scope that took a hold is the scope that gives it back.
    // A borrow ends where the thing borrowing it ends: a walk's at the
    // end of its body, an iterator's at the end of the block it was
    // made in, since nothing in the language says sooner.
    hslot : i64[]
    hback : i64[]
    hmark : i64[]
    marks : i64[]
    nslots : i64
    loop_depth : i64
    cur_fn : i64
    in_contract : bool
    scope_floor : i64    // a lambda's body sees nothing below this
    lams : i64[]         // every λ node, in the order lowered
    lamns : i64[]        // … and the slot count its frame must cover
    psfn : i64[]         // partial-application shims: the named target, ⁻1 for a closure
    psk : i64[]          // … how many arguments the box binds
    psnp : i64[]         // … the target's full parameter count
    fdone : i64[]        // per function: 0 unchecked, 1 checked, 2 being checked
    skipfn : i64[]       // 1 where a generic was never shaped by a call
    lam_ret : i64        // the lambda under check answers this; ⁻1 outside
    argcopy : i64[]      // see Chk

impl Checker:
    fn derr(&mut self, tok : i64, m : str):
        self.diags.push(Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m, level: DIAG_ERROR, code: DIAG_NONE})

    // The same complaint, saying which one it is.  A number is what an
    // @expect matches on and what a reader looks up; the words beside
    // it are free to improve without anything having to be rewritten.
    @pre(code > 0)
    fn derrc(&mut self, tok : i64, code : i64, m : str):
        self.diags.push(Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m, level: DIAG_ERROR, code: code})

    // A warning does not refuse the program; -Werror makes it one.
    @pre(code > 0)
    fn dwarn(&mut self, tok : i64, code : i64, m : str):
        self.diags.push(Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m, level: DIAG_WARNING, code: code})

    fn text(&self, tok : i64) → str:
        run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    // @sizeof(T), T.alignof and T.offsetof(f) all answer a count of
    // bytes settled here, and all three fold into the literal the
    // lowering would have had to make anyway.
    fn fold_bytes(&mut self, id : i64, v : i64):
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← v
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.a.nc[id × 1¤ptrdiff] ← 0
        self.set_type(id, ty_with_unit(TY_I64, UNIT_BYTE))

    // the struct a name stands for, where the name is a type's and not
    // a binding's; ⁻1 for anything else
    fn type_named(&self, na : i64) → i64:
        if self.kind_of(na) ≠ NK_VAR:
            return ⁻1
        let nm := self.text(self.a.ntok[na × 1¤ptrdiff])
        ⁻1 if self.lookup(nm) ≠ ⁻1 else self.struct_index(nm)

    // a struct with no layout has no size a program may use: reporting
    // one would invite exactly the dependency the default prevents
    fn layout_err(&mut self, tok : i64, si : i64, what : str):
        let d := self.a.structs[si × 1¤ptrdiff]
        if not d.is_repr_c:
            self.derr(tok, "struct '" ⧺ d.name ⧺ "' has no defined layout; annotate it with @repr(C) to give it one")
            return
        let bad : i64 = c_bad_field(self.a, si)
        if bad = ⁻1:
            self.derr(tok, "struct '" ⧺ d.name ⧺ "' has no C layout")
            return
        let ftok : i64 = self.a.extra[(d.fields_off + 1 + bad × 2) × 1¤ptrdiff]
        let fty : i64 = self.a.extra[(d.fields_off + 2 + bad × 2) × 1¤ptrdiff]
        self.derr(ftok, "in @repr(C) struct '" ⧺ d.name ⧺ "', field '" ⧺ self.text(ftok) ⧺ "': " ⧺ self.tn(fty) ⧺ " has no defined C representation")
        _ ← what

    // the type a name stands for where the name is a type's, so
    // @sizeof takes the type itself and not only a value of it
    fn named_type(&self, na : i64) → i64:
        if self.kind_of(na) ≠ NK_VAR:
            return ⁻1
        let nm := self.text(self.a.ntok[na × 1¤ptrdiff])
        if self.lookup(nm) ≠ ⁻1:
            return ⁻1
        let bt : i64 = TYNAMES[nm] ?? ⁻1
        if bt ≠ ⁻1:
            return bt
        let si : i64 = self.struct_index(nm)
        if si ≠ ⁻1:
            return mk_sty(si)
        let ei : i64 = self.enum_index(nm)
        ⁻1 if ei = ⁻1 else mk_ety(ei)

    // A run of bytes is made of one of three things: bytes as they
    // are, a struct whose layout says what its bytes are, or a table
    // of such structs, which C would lay out one after the other.
    fn iov_source_ok(&mut self, tok : i64, pt : i64):
        if pt = mk_aty(TY_U8):
            return
        let et : i64 = self.elem_of(pt) if ty_is_arr(pt) else pt
        if not ty_is_struct(et):
            self.derr(tok, "a run of bytes is made from bytes, a struct with a defined layout, or an array of them; this is " ⧺ self.tn(pt))
            return
        let (psz, pal) := c_struct_layout(self.a, ty_sidx(et), 0)
        _ ← pal
        if psz = ⁻1:
            self.layout_err(tok, ty_sidx(et), "written")

    fn check_sizeof(&mut self, id : i64, tok : i64, na : i64):
        let named : i64 = self.named_type(na)
        let t : mut i64 = named
        if named = ⁻1:
            self.check_expr(na, TY_UNIT)
            t ← ty_strip_ref(self.ty_of(na))
        let (sz, al) := c_layout(self.a, t, 0)
        _ ← al
        if sz ≠ ⁻1:
            self.fold_bytes(id, sz)
            return
        // no size to give.  A struct knows why -- no layout asked for,
        // or a field C cannot represent -- and says so; anything else
        // has no C representation at all.
        if ty_is_struct(t):
            self.layout_err(tok, ty_sidx(t), "sized")
        else:
            self.derr(tok, "@sizeof measures what C can represent; " ⧺ self.tn(t) ⧺ " it cannot")
        self.fold_bytes(id, 0)

    fn sname_of(&self, t : i64) → str:
        // a diagnostic writes the struct's name, not its number
        if ty_is_struct(ty_strip_ref(t)):
            return self.a.structs[ty_sidx(ty_strip_ref(t)) × 1¤ptrdiff].name
        self.tn(t)

    fn struct_index(&self, name : str) → i64:
        if #self.a.structs > 0:
            foreach i := 0…#self.a.structs - 1:
                if self.a.structs[i].name = name:
                    return @dropunit(i)
        ⁻1

    // a field's position and type within a struct, by name; (⁻1, 0)
    // when the struct has no such field
    fn field_of(&self, sidx : i64, fname : str) → (i64, i64):
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let n : i64 = self.a.extra[d.fields_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let ftok : i64 = self.a.extra[(d.fields_off + 1 + i × 2) × 1¤ptrdiff]
            if self.text(ftok) = fname:
                return (i, self.a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff])
            i ← i + 1
        (⁻1i64, 0i64)

    // whether the expression builds a struct of its own rather than
    // naming one that already lives somewhere
    fn is_fresh_struct(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        k = NK_SLIT or k = NK_CALL or k = NK_MCALL

    // A name written unqualified, found the way its module sees it: the
    // module in hand first, then the ones it is written inside, then
    // the global module.  Nothing found this way can be hidden, since
    // every candidate is in the current module or one it is written
    // inside, and a module hides nothing from what it contains.
    fn fn_index_here(&self, name : str) → i64:
        let where : mut str = self.curmod
        while true:
            let cand : str = name if where = "" else where ⧺ "." ⧺ name
            let f : i64 = self.fn_in(cand)
            if f ≠ ⁻1:
                return f
            if where = "":
                return ⁻1
            where ← mod_parent(where)
        ⁻1

    // the function whose whole name is this, or ⁻1
    fn fn_in(&self, whole : str) → i64:
        if #self.a.fns > 0:
            foreach i := 0…#self.a.fns - 1:
                let d := self.a.fns[i]
                let w : str = d.name if d.modname = "" else d.modname ⧺ "." ⧺ d.name
                if w = whole:
                    return @dropunit(i)
        ⁻1

    fn fn_index(&self, name : str) → i64:
        foreach i := 0…#self.fnames - 1:
            if self.fnames[i] = name:
                return @dropunit(i)
        ⁻1

    fn global_index(&self, name : str) → i64:
        if #self.gnames > 0:
            foreach i := 0…#self.gnames - 1:
                if self.gnames[i] = name:
                    return @dropunit(i)
        ⁻1

    fn lookup(&self, name : str) → i64:
        let i : mut i64 = @dropunit(#self.snames) - 1
        while i >= self.scope_floor:
            if self.snames[i × 1¤ptrdiff] = name:
                return i
            i ← i - 1
        ⁻1

    fn declare(&mut self, tok : i64, ty : i64, is_mut : i64) → i64:
        let name := self.text(tok)
        if ty_is_var(ty_strip_ref(ty)):
            self.derr(tok, "a type variable belongs in a signature; a binding states what it holds")
        if names_int_type(name):
            self.derr(tok, "'" ⧺ name ⧺ "' names a type and cannot name a variable")
        let low : i64 = self.marks[#self.marks - 1]
        let i : mut i64 = @dropunit(#self.snames) - 1
        while i >= low:
            if self.snames[i × 1¤ptrdiff] = name:
                self.derr(tok, "'" ⧺ name ⧺ "' is already defined in this scope")
                return self.sslot[i × 1¤ptrdiff]
            i ← i - 1
        let slot : i64 = self.nslots
        self.nslots ← self.nslots + 1
        self.snames.push(name)
        self.stype.push(ty)
        self.smut.push(is_mut)
        self.sslot.push(slot)
        self.sheld.push(HOLD_FREE)
        slot

    fn push_scope(&mut self):
        self.marks.push(@dropunit(#self.snames))
        self.hmark.push(@dropunit(#self.hslot))

    fn pop_scope(&mut self):
        // the holds this scope took, given back in the order they were
        // taken, so two walks over one array unwind to what was there
        let hlow : i64 = self.hmark.pop() ?? 0
        while @dropunit(#self.hslot) > hlow:
            let hs : i64 = self.hslot.pop() ?? 0
            let hb : i64 = self.hback.pop() ?? 0
            self.sheld[hs × 1¤ptrdiff] ← hb
        let low : i64 = self.marks.pop() ?? 0
        while @dropunit(#self.snames) > low:
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0
            _ ← self.sheld.pop() ?? 0

    fn is_open(&self, t : i64) → bool:
        t = TY_UNT or t = TY_EMPTY

    fn set_type(&mut self, id : i64, t : i64):
        self.ntype[id × 1¤ptrdiff] ← t

    fn ty_of(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kind_of(&self, id : i64) → i64:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // Untyped literals: folding, adoption, range checks
    // ------------------------------------------------------------------

    // whether the wrapped value v (big says ≥ 2^63) fits the type t
    fn lit_fits(&self, v : i64, big : i64, t : i64) → bool:
        let bits : i64 = ty_bits(t)
        let sgn : i64 = ty_sgn(t)
        if big = 1:
            return sgn = 0 and bits = 64
        if sgn = 0:
            if v < 0: return false
            if bits = 64: return true
            return v <= (1 « bits) - 1
        if bits = 64: return true
        let half : i64 = 1 « (bits - 1)
        v >= 0 - half and v <= half - 1

    // give an untyped node the type its context settled on
    // whether an integer value settles into the wanted integer type,
    // as the bootstrap has it: a value-preserving widening passes as
    // itself; a narrowing or sign-crossing is accepted with a fit
    // check the lowering emits, so a value that does not fit stops
    // the run exactly where the interpreter stops it.  Anything not
    // two integers answers plain type equality.
    // arguments are held tighter than bindings: a typed plain value
    // does not adopt a parameter's measure -- only an untyped literal
    // does -- which is the bootstrap's own rule
    fn fit_arg(&mut self, e : i64, want0 : i64) → bool:
        let t : i64 = self.ty_of(e)
        let want : i64 = ty_strip_ref(want0)
        if ty_is_int(t) and ty_is_int(want) and ty_unit(t) = 0 and ty_unit(want) ≠ 0:
            return false
        self.try_fit(e, want0)

    fn try_fit(&mut self, e : i64, want0 : i64) → bool:
        let t : i64 = self.ty_of(e)
        let want : i64 = ty_strip_ref(want0)
        if t = want:
            return true
        if ty_is_mat(t) and ty_is_mat(want):
            // a stated extent fits an open one; an open one fits only
            // openness, since nothing vouches for its size
            return self.mat_elem(t) = self.mat_elem(want) and self.mat_rank(t) = self.mat_rank(want) and (self.mat_rr(want) = ⁻1 or self.mat_rr(want) = self.mat_rr(t)) and (self.mat_cc(want) = ⁻1 or self.mat_cc(want) = self.mat_cc(t)) and (self.mat_dd(want) = ⁻1 or self.mat_dd(want) = self.mat_dd(t))
        if not (ty_is_int(t) and ty_is_int(want)):
            return false
        if not self.stands_for(ty_unit(t), ty_unit(want)) and ty_unit(t) ≠ 0:
            // a measured value does not quietly drop or change its
            // measure; @dropunit is the word for parting with one.  A
            // measure that stands in for the one wanted is not a change
            // of measure -- it is what the declaration said it was for.
            return false
        let widening : bool = ty_bits(want) > ty_bits(t) and not (ty_sgn(t) = 1 and ty_sgn(want) = 0)
        if not widening:
            self.ncvt[e × 1¤ptrdiff] ← want
        true

    fn adopt(&mut self, id : i64, t : i64):
        if self.ty_of(id) = TY_EMPTY:
            if ty_is_opt(t):
                self.set_type(id, t)
            else:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "∅ is the absent optional; " ⧺ self.tn(t) ⧺ " holds no absence")
            return
        if self.ty_of(id) ≠ TY_UNT:
            return
        if ty_is_enum(t) and self.kind_of(id) = NK_INT:
            // an enum holds exactly its members, so a written-out
            // number becomes one only where it names one -- and a
            // @flag enum's values are combinations, which no bare
            // number names, so none becomes one there
            let ei9 : i64 = ty_eidx(t)
            if self.enum_is_flag(t):
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "'" ⧺ self.a.enames[ei9 × 1¤ptrdiff] ⧺ "' is a @flag enum, so its values are combinations of members that a bare number does not name")
                self.set_type(id, t)
                return
            let st9 : i64 = self.a.estart[ei9 × 1¤ptrdiff]
            let n9 : i64 = self.a.ecount[ei9 × 1¤ptrdiff]
            let v9 : i64 = self.a.na[id × 1¤ptrdiff]
            let ok9 : mut bool = false
            let k9 : mut i64 = 0
            while k9 < n9:
                if self.a.evalues[(st9 + k9) × 1¤ptrdiff] = v9:
                    ok9 ← true
                k9 ← k9 + 1
            if not ok9:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "'" ⧺ self.a.enames[ei9 × 1¤ptrdiff] ⧺ "' holds exactly its members, and " ⧺ i64_str(v9) ⧺ " is not one of them")
            self.set_type(id, t)
            return
        if not ty_is_int(t):
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "a number cannot become " ⧺ self.tn(t))
            self.set_type(id, TY_I64)
            return
        if self.kind_of(id) = NK_INT:
            if not self.lit_fits(self.a.na[id × 1¤ptrdiff],
                                 self.a.nb[id × 1¤ptrdiff], t):
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "the literal does not fit " ⧺ self.tn(t))
        elif self.kind_of(id) = NK_COND:
            // both sides were untyped; the context settles each
            self.adopt(self.a.na[id × 1¤ptrdiff], t)
            self.adopt(self.a.nc[id × 1¤ptrdiff], t)
        else:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "this untyped computation cannot settle; ngplc folds only literals")
        self.set_type(id, t)

    // fold an arithmetic node whose operands folded to literals; the
    // computation is exact, and one that leaves i64 is refused since
    // no run of the program could hold it either
    fn fold_bin(&mut self, id : i64, k : i64, tok : i64, l : i64, r : i64):
        let res : mut i64 = 0
        let bad : mut bool = false
        if k = NK_ADD:
            res ← @wrap(l + r)
            bad ← (l > 0 and r > 0 and res < 0) or (l < 0 and r < 0 and res >= 0)
        elif k = NK_SUB:
            res ← @wrap(l - r)
            bad ← (l >= 0 and r < 0 and res < 0) or (l < 0 and r > 0 and res >= 0)
        elif k = NK_MUL:
            res ← @wrap(l × r)
            if l ≠ 0:
                bad ← (res ÷ l ?? 0) ≠ r or (l = ⁻1 and r = 0 - 9223372036854775807 - 1)
        elif k = NK_SHL:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← @wrap(l « r)
                bad ← (res » r) ≠ l
        elif k = NK_SHR:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← l » r
        elif k = NK_BAND:
            res ← l & r
        elif k = NK_BOR:
            res ← l | r
        elif k = NK_BXOR:
            res ← l ^ r
        elif k = NK_MAXOP:
            res ← l ⌈ r
        elif k = NK_MINOP:
            res ← l ⌊ r
        else:
            // comparisons of two untyped numbers answer at once
            let b : mut i64 = 0
            if k = NK_EQ: b ← 1 if l = r else 0
            elif k = NK_NE: b ← 1 if l ≠ r else 0
            elif k = NK_LT: b ← 1 if l < r else 0
            elif k = NK_LE: b ← 1 if l <= r else 0
            elif k = NK_GT: b ← 1 if l > r else 0
            elif k = NK_GE: b ← 1 if l >= r else 0
            else:
                self.derr(tok, "these two untyped numbers cannot meet here; state a type")
                self.set_type(id, TY_I64)
                return
            self.a.nkind[id × 1¤ptrdiff] ← NK_BOOL
            self.a.na[id × 1¤ptrdiff] ← b
            self.set_type(id, TY_BOOL)
            return
        if bad:
            self.derr(tok, "this literal computation leaves i64, which no run could hold")
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← res
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, TY_UNT)

    // ------------------------------------------------------------------
    // Expression checking; `want` is the type the context asks for,
    // 0 (TY_UNIT) meaning it asks nothing
    // ------------------------------------------------------------------

    fn unify_arith(&mut self, tok : i64, id : i64, k : i64, tl : i64, tr : i64) → i64:
        // both integer operands; answers the operation's type
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if tl = TY_UNT and tr = TY_UNT:
            return TY_UNT
        if tl = TY_UNT:
            self.adopt(na, tr)
            return tr
        if tr = TY_UNT:
            // × of a scalar and a measured value keeps the measure, so
            // an untyped right side of × under a united left adopts the
            // bare type; everything else adopts in full
            self.adopt(nb, tl)
            return tl
        // two typed operands: wider wins, and what measure the result
        // carries is the operator's own business
        let ul : i64 = ty_unit(tl)
        let ur : i64 = ty_unit(tr)
        let ru : i64 = self.unit_meet(tok, k, tl, tr)
        if ty_sgn(tl) ≠ ty_sgn(tr):
            // an unsigned value narrower than the signed side widens
            // as itself, and the signed type carries the operation
            let sg : i64 = tl if ty_sgn(tl) = 1 else tr
            let un : i64 = tr if ty_sgn(tl) = 1 else tl
            if ty_bits(sg) > ty_bits(un):
                return ty_with_unit(ty_drop_unit(sg), ru)
            self.derr(tok, "signed and unsigned do not meet; " ⧺ self.tn(tl) ⧺ " and " ⧺ self.tn(tr))
            return tl
        let wide : i64 = tl if ty_bits(tl) >= ty_bits(tr) else tr
        ty_with_unit(ty_drop_unit(wide), ru)

    // What measure an operation's result carries, and whether the two
    // operands may meet at all.  A sum is of two of the same thing, so
    // its sides must be measured alike -- a plain number is not a
    // length, and the bootstrap refuses to add it to one.  A product
    // scales: one side measured and one plain keeps the measure, but
    // both measured makes a measure of its own (ptrdiff×ptrdiff),
    // which core-2 has no way to write down and so refuses.  A
    // quotient divides the measures out: alike, they cancel.
    fn unit_meet(&mut self, tok : i64, k : i64, tl : i64, tr : i64) → i64:
        let ul : i64 = ty_unit(tl)
        let ur : i64 = ty_unit(tr)
        if k = ⁻1:
            // a conditional is not an operation on its two sides; it
            // hands one of them on, and the bootstrap lets the binding
            // say what that is
            return ul ⌈ ur
        if k = NK_SHL or k = NK_SHR or k = NK_BAND or k = NK_BOR or k = NK_BXOR:
            // measured operands are refused outright further on
            return ul ⌈ ur
        if k = NK_MUL or k = NK_SATMUL:
            if ul ≠ 0 and ur ≠ 0:
                self.derr(tok, "multiplying " ⧺ self.tn(tl) ⧺ " by " ⧺ self.tn(tr) ⧺ " makes a measure of its own, which core-2 cannot write down")
                return 0
            return ul ⌈ ur
        if k = NK_DIV:
            if ul = ur:
                // the measures cancel and the answer is a bare count
                return 0
            if ur ≠ 0:
                self.derr(tok, "dividing " ⧺ self.tn(tl) ⧺ " by " ⧺ self.tn(tr) ⧺ " makes a measure of its own, which core-2 cannot write down")
                return 0
            return ul
        if k = NK_MOD:
            if ul = ur:
                // what is left over is measured as what was divided
                return ul
            if ur ≠ 0:
                self.derr(tok, "taking " ⧺ self.tn(tl) ⧺ " modulo " ⧺ self.tn(tr) ⧺ " makes a measure of its own, which core-2 cannot write down")
                return 0
            return ul
        // + - ⌈ ⌊ ⊞ ⊟: two of the same thing, or nothing.  One side
        // standing in for the other settles which measure the answer
        // carries; neither doing so is two different things being added.
        if ul = ur:
            return ul
        if self.stands_for(ul, ur):
            return ur
        if self.stands_for(ur, ul):
            return ul
        self.derr(tok, "a value measured " ⧺ self.tn(tl) ⧺ " does not meet one measured " ⧺ self.tn(tr))
        ul

    fn check_expr(&mut self, id : i64, want : i64):
        let k : i64 = self.kind_of(id)
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_INT:
            if nb >= 2:
                // the width suffix -- or a character literal -- closed
                // the type at the lexer; only the big bit stays for
                // the fit check
                let st : i64 = nb » 1
                self.a.nb[id × 1¤ptrdiff] ← nb & 1
                if st = TY_CHAR:
                    self.set_type(id, TY_CHAR)
                    return
                if ty_is_enum(st):
                    self.set_type(id, st)
                    return
                self.set_type(id, TY_UNT)
                self.adopt(id, st)
            elif want ≠ TY_UNIT and ty_is_int(want):
                self.set_type(id, TY_UNT)
                self.adopt(id, want)
            else:
                self.set_type(id, TY_UNT)
        elif k = NK_BOOL:
            self.set_type(id, TY_BOOL)
        elif k = NK_STR:
            self.set_type(id, TY_STR)
        elif k = NK_VAR:
            self.check_var(id, tok)
        elif k = NK_ARRLIT:
            self.check_arrlit(id, tok, na, want)
        elif k = NK_HLIT:
            self.check_hlit(id, tok, na, want)
        elif k = NK_TUPLE:
            self.check_tuple(id, tok, na, want)
        elif k = NK_SIZEOF:
            self.check_sizeof(id, tok, na)
        elif k = NK_TYPEOF:
            self.check_expr(na, TY_UNIT)
            let tt : mut i64 = ty_strip_ref(self.ty_of(na))
            let tpre : mut str = ""
            if self.kind_of(na) = NK_VAR:
                let ts : i64 = self.lookup(self.text(self.a.ntok[na × 1¤ptrdiff]))
                if ts ≠ ⁻1:
                    let trk : i64 = ty_ref_kind(self.stype[ts × 1¤ptrdiff])
                    if trk = 1:
                        tpre ← "&"
                    elif trk = 2:
                        tpre ← "&mut "
            let sp0 : str = self.ty_spell(tt)
            let sp : str = "" if sp0 = "" else tpre ⧺ sp0
            if sp = "":
                self.derr(tok, "@typeof of " ⧺ self.tn(tt) ⧺ " carries the value, not the type alone; it is not core-2")
                self.set_type(id, TY_STR)
                return
            // the spelling is a constant the way a literal is
            self.a.strs.push(sp)
            self.a.nkind[id × 1¤ptrdiff] ← NK_STR
            self.a.na[id × 1¤ptrdiff] ← @dropunit(#self.a.strs) - 1
            self.a.nb[id × 1¤ptrdiff] ← 0
            self.set_type(id, TY_STR)
        elif k = NK_DROPU:
            self.check_expr(na, TY_UNIT)
            let dt : i64 = self.ty_of(na)
            if dt = TY_UNT:
                self.adopt(na, TY_I64)
                self.set_type(id, TY_I64)
            elif not ty_is_int(dt):
                self.derr(tok, "@dropunit unmeasures a number, not " ⧺ self.tn(dt))
                self.set_type(id, TY_I64)
            else:
                self.set_type(id, ty_drop_unit(dt))
        elif k = NK_SLIT:
            self.check_slit(id, tok, na)
        elif k = NK_FIELD:
            self.check_field(id, tok, na)
        elif k = NK_SOME:
            let iw : i64 = ty_opt_base(ty_strip_ref(want)) if ty_is_opt(ty_strip_ref(want)) else TY_UNIT
            self.check_expr(na, iw)
            if self.ty_of(na) = TY_UNT:
                self.adopt(na, iw if iw ≠ TY_UNIT and ty_is_int(iw) else TY_I64)
            let it : i64 = self.ty_of(na)
            if ty_is_arr(it):
                self.derr(tok, "an optional array is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            if ty_is_hash(it):
                self.derr(tok, "an optional dictionary is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            if ty_is_opt(it) or it = TY_EMPTY:
                self.derr(tok, "an optional of an optional is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            self.set_type(id, mk_oty(it))
        elif k = NK_EMPTYV:
            self.set_type(id, want if ty_is_opt(want) else TY_EMPTY)
        elif k = NK_INDEX:
            self.check_index(id, tok, na, nb)
        elif k = NK_LEN:
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if t = TY_STR:
                self.set_type(id, ty_with_unit(TY_I64, UNIT_PTRDIFF))
            elif ty_is_arr(t):
                let u : i64 = UNIT_BYTE if ty_drop_unit(self.elem_of(t)) = TY_U8 else UNIT_PTRDIFF
                self.set_type(id, ty_with_unit(TY_I64, u))
            elif ty_is_hash(t) or ty_is_tup(t) or ty_is_mat(t):
                self.set_type(id, ty_with_unit(TY_I64, UNIT_PTRDIFF))
            else:
                self.derr(tok, "# counts an array, a dictionary, a tuple or a string; this is " ⧺ self.tn(t))
                self.set_type(id, TY_I64)
        elif k = NK_CALL:
            self.check_call(id, tok, na)
        elif k = NK_CALLV:
            self.check_callv(id, tok, na, nb)
        elif k = NK_SCALL:
            self.check_scall(id, tok, na, nb)
        elif k = NK_MCALL:
            self.check_mcall(id, tok, na, nb, false)
        elif k = NK_REF:
            self.derr(tok, "a borrow is an argument, not a value of its own")
            self.set_type(id, TY_I64)
        elif k = NK_NEG:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.set_type(id, TY_UNT)
                // the parser folds ⁻literal; reaching here means ⁻(expr)
                if self.kind_of(na) = NK_INT:
                    self.fold_neg(id, na)
            elif ty_is_int(t):
                self.set_type(id, t)
            else:
                self.derr(tok, "⁻ negates a number, not " ⧺ self.tn(t))
                self.set_type(id, TY_I64)
        elif k = NK_BNOT:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.a.na[id × 1¤ptrdiff] ← ~(self.a.na[na × 1¤ptrdiff])
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_UNT)
            elif ty_is_int(t) and ty_unit(t) = 0:
                self.set_type(id, t)
            elif ty_is_enum(t) and self.enum_is_flag(t):
                // the complement within the set's own bits
                self.set_type(id, t)
            else:
                self.derr(tok, "~ flips the bits of a plain integer or a @flag enum, not " ⧺ self.tn(t))
                self.set_type(id, TY_I64)
        elif k = NK_NOT:
            self.check_expr(na, TY_UNIT)
            self.want_bool(na, "¬")
            self.set_type(id, TY_BOOL)
        elif k = NK_COND:
            self.check_expr(nb, TY_UNIT)
            self.want_truthy(nb, "the condition")
            self.check_expr(na, want)
            self.check_expr(nc, want)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nc)
            if tl = TY_UNT and tr ≠ TY_UNT:
                self.adopt(na, tr)
            elif tr = TY_UNT and tl ≠ TY_UNT:
                self.adopt(nc, tl)
            elif tl = TY_UNT and tr = TY_UNT:
                self.set_type(id, TY_UNT)
                return
            let ta : i64 = self.ty_of(na)
            let tc : i64 = self.ty_of(nc)
            if ta = tc:
                self.set_type(id, ta)
            elif ty_is_int(ta) and ty_is_int(tc):
                let joint : i64 = self.unify_arith(tok, id, ⁻1, ta, tc)
                _ ← self.try_fit(na, joint)
                _ ← self.try_fit(nc, joint)
                self.set_type(id, joint)
            else:
                self.derr(tok, "the two sides of a conditional say one type between them")
                self.set_type(id, ta)
        elif k = NK_WRAP:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.derr(tok, "@wrap wants a width to wrap within; state a type")
                self.set_type(id, TY_I64)
            elif ty_is_int(t):
                self.set_type(id, t)
            else:
                self.derr(tok, "@wrap wraps integer arithmetic, not " ⧺ self.tn(t))
                self.set_type(id, TY_I64)
        elif k = NK_DEFAULT:
            self.check_default(id, tok, na, nb, want)
        elif k = NK_DIV or k = NK_MOD:
            self.derr(tok, "÷ and % answer a result; write (a ÷ b) ?? default")
            self.check_expr(na, want)
            self.check_expr(nb, want)
            self.set_type(id, TY_I64)
        elif k = NK_EQ or k = NK_NE:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nb)
            if tl = TY_EMPTY or tr = TY_EMPTY:
                if tl = TY_EMPTY and tr = TY_EMPTY:
                    self.derr(tok, "∅ against ∅ says nothing; state which optional is asked")
                elif tl = TY_EMPTY:
                    if ty_is_opt(tr):
                        self.adopt(na, tr)
                    else:
                        self.derr(tok, "only an optional is asked about ∅; this is " ⧺ self.tn(tr))
                elif ty_is_opt(tl):
                    self.adopt(nb, tl)
                else:
                    self.derr(tok, "only an optional is asked about ∅; this is " ⧺ self.tn(tl))
                self.set_type(id, TY_BOOL)
                return
            if ty_is_opt(tl) or ty_is_opt(tr):
                let ob : i64 = ty_opt_base(tl if ty_is_opt(tl) else tr)
                if tl ≠ tr:
                    self.derr(tok, "an optional compares with its own kind or ∅; the sides are " ⧺ self.tn(tl) ⧺ " and " ⧺ self.tn(tr))
                elif not ((ty_is_int(ob) and ty_unit(ob) = 0) or ob = TY_BOOL or ob = TY_CHAR or ob = TY_STR):
                    self.derr(tok, "an optional of " ⧺ self.tn(ob) ⧺ " is not compared whole; match takes it apart")
                self.set_type(id, TY_BOOL)
                return
            if tl = TY_STR and tr = TY_STR:
                self.set_type(id, TY_BOOL)
                return
            if tl = TY_BOOL and tr = TY_BOOL:
                self.set_type(id, TY_BOOL)
                return
            if ty_is_hash(tl) or ty_is_hash(tr) or ty_is_arr(tl) or ty_is_arr(tr) or ty_is_tup(tl) or ty_is_tup(tr) or ty_is_mat(tl) or ty_is_mat(tr) or ty_is_rg(tl) or ty_is_rg(tr):
                self.derr(tok, "core-2 does not compare " ⧺ self.tn(tl) ⧺ " with " ⧺ self.tn(tr) ⧺ "; ask the entries")
                self.set_type(id, TY_BOOL)
                return
            self.check_cmp_operands(id, tok, k, na, nb)
        elif k = NK_LT or k = NK_LE or k = NK_GT or k = NK_GE:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            self.check_cmp_operands(id, tok, k, na, nb)
        elif k = NK_RESHAPE:
            self.check_reshape(id, tok, na, nb, want)
        elif k = NK_IOTA:
            // where the wanted value sits in the container, if anywhere
            self.check_expr(na, TY_UNIT)
            let ct : i64 = self.ty_of(na)
            if not ty_is_arr(ct):
                self.derr(tok, "⍳ looks through an array; this is " ⧺ self.tn(ct))
                self.check_expr(nb, TY_UNIT)
                self.set_type(id, mk_oty(ty_with_unit(TY_I64, UNIT_PTRDIFF)))
                return
            let et : i64 = self.elem_of(ct)
            self.check_expr(nb, et)
            if self.is_open(self.ty_of(nb)):
                self.adopt(nb, et)
            elif not self.try_fit(nb, et):
                self.derr(tok, "⍳: the container holds " ⧺ self.tn(et) ⧺ ", and what is looked for is " ⧺ self.tn(self.ty_of(nb)))
            self.set_type(id, mk_oty(ty_with_unit(TY_I64, UNIT_PTRDIFF)))
        elif k = NK_LAMBDA:
            let loff : i64 = na
            let np9 : i64 = self.a.extra[loff × 1¤ptrdiff]
            let ncap9 : i64 = self.a.extra[(loff + 1 + np9 × 2) × 1¤ptrdiff]
            let lret : i64 = self.a.extra[(loff + 2 + np9 × 2 + ncap9) × 1¤ptrdiff]
            if lret = TY_UNIT:
                self.derrc(tok, 2254, "a lambda must not return ∅; it answers a value")
                self.set_type(id, TY_I64)
                return
            // captures resolve outside, before the floor closes: their
            // values are read where the lambda is written
            let couter : mut i64[] = []
            let ctoks : mut i64[] = []
            let ctys : mut i64[] = []
            if ncap9 > 0:
                foreach ci := 0…ncap9 - 1:
                    let ctok : i64 = self.a.extra[(loff + 2 + np9 × 2 + ci) × 1¤ptrdiff]
                    let cs : i64 = self.lookup(self.text(ctok))
                    if cs = ⁻1:
                        let cf : i64 = self.fn_index(self.text(ctok))
                        if cf = ⁻1:
                            self.derrc(ctok, 2111, "'" ⧺ self.text(ctok) ⧺ "' is not here to capture")
                            self.set_type(id, TY_I64)
                            return
                        // a captured function is its value in the box,
                        // read now -- which is what @replaceable asks
                        if self.fn_is_generic(cf):
                            self.derr(ctok, "a generic function has no one shape to capture")
                            self.set_type(id, TY_I64)
                            return
                        let cd := self.a.fns[cf × 1¤ptrdiff]
                        let cnp : i64 = self.a.extra[cd.params_off × 1¤ptrdiff]
                        let cok : mut bool = cnp >= 1 and cnp <= 5 and fnval_ret_ok(cd.ret) and not cd.is_impure
                        let cpts : mut i64[] = []
                        foreach cpi := 0…cnp - 1:
                            let cpty : i64 = self.a.extra[(cd.params_off + 2 + cpi × 2) × 1¤ptrdiff]
                            cok ← cok and ty_ref_kind(cpty) = 0 and ((ty_is_int(cpty) and ty_unit(cpty) = 0) or cpty = TY_BOOL or cpty = TY_CHAR or cpty = TY_STR)
                            cpts.push(ty_strip_ref(cpty))
                        if not cok:
                            self.derr(ctok, "'" ⧺ self.text(ctok) ⧺ "' does not travel as a value; only a pure function of up to five plain scalars does")
                            self.set_type(id, TY_I64)
                            return
                        couter.push(0 - cf - 1)
                        ctoks.push(ctok)
