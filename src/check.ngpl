                                    " only a pure function of up to five plain scalars does""")
                            self.set_type(id, TY_I64)
                            return
                        couter.push(0 - cf - 1)
                        ctoks.push(ctok)
                        ctys.push(mk_lty(self.lam_intern(cpts, cd.ret, if cd.is_listable: 1 else: 0)))
