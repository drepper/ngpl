            let rhi : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
            let clo : i64 = self.a.extra[(nb + 2) × 1¤ptrdiff]
            let chi : i64 = self.a.extra[(nb + 3) × 1¤ptrdiff]
            if ty_is_mat(mt9) and self.mat_rank(mt9) = 3:
