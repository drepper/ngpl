// ===========================================================================
// x86-64: the hand-tuned emitter
// ===========================================================================
//
// The pioneer.  x86-64 fixes what every IR operation means, and is the
// measure the five that arrive through the shared retargetable path
// are checked against; it did not change when that path was built.
// Its runtime is beside it, in rt_x86_64.ngpl.

@pre(j >= 0 and j <= 5)
fn arg_reg(j : i64) → i64:
    if j = 0: return R_DI
    if j = 1: return R_SI
    if j = 2: return R_DX
    if j = 3: return R_CX
    if j = 4: return R_R8
    R_R9

// the setcc condition for a comparison at a signedness
@pre(sgn = 0 or sgn = 1)
@post(r: r >= 146 and r <= 159)
fn cc_of(o : i64, sgn : i64) → i64:
    if o = IR_CEQ: return 148
    if o = IR_CNE: return 149
    if sgn = 1:
        if o = IR_CLT: return 156
        if o = IR_CLE: return 158
        if o = IR_CGT: return 159
        return 157
    if o = IR_CLT: return 146
    if o = IR_CLE: return 150
    if o = IR_CGT: return 151
    147

fn emit_fn(em : &mut Emit, ir : IrFn, np : i64, strs : str[]):
    assert(ir.nvregs >= np, "the frame covers the spilled arguments")
    em.begin_fn(ir.nlabels)
    em.b1(85)                       // push rbp
    em.b3(72, 137, 229)             // mov rbp, rsp
    em.b3(72, 129, 236)             // sub rsp, imm32
    let frame : i64 = 8 × ir.nvregs + 8
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.w32(frame)
    let j : mut i64 = 0
    while j < np:
        if j < 6:
            em.store(arg_reg(j), j)
        else:
            em.b3(72, 139, 133)
            em.w32(16 + 8 × (j - 6))    // mov rax, [rbp+…]: a stack argument
            em.store(R_AX, j)
        j ← j + 1
    let n : i64 = @dropunit(#ir.op)
    let i : mut i64 = 0
    while i < n:
        let o : i64 = ir.op[i × 1¤ptrdiff]
        let a : i64 = ir.ia[i × 1¤ptrdiff]
        let b : i64 = ir.ib[i × 1¤ptrdiff]
        let c : i64 = ir.ic[i × 1¤ptrdiff]
        let d : i64 = ir.id[i × 1¤ptrdiff]
        let w : i64 = ir.iw[i × 1¤ptrdiff]
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if o = IR_CONST:
            em.movimm(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_MOV:
            em.load(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_ADD or o = IR_ADDW or o = IR_SUB or o = IR_SUBW:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if o = IR_ADD or o = IR_ADDW:
                em.b3(72, 1, 200)   // add rax, rcx
            else:
                em.b3(72, 41, 200)  // sub rax, rcx
            if o = IR_ADD or o = IR_SUB:
                if bits = 64:
                    em.jglobal(0, 128 if sgn = 1 else 130, RT_OV)  // jo / jc
                else:
                    em.range_check(w)
            else:
                em.canon(w)
            em.store(R_AX, d)
        elif o = IR_MUL or o = IR_MULW:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if sgn = 1 or o = IR_MULW:
                em.b4(72, 15, 175, 193)      // imul rax, rcx
                if o = IR_MUL:
                    if bits = 64:
                        em.jglobal(0, 128, RT_OV)
                    else:
                        em.range_check(w)
                else:
                    em.canon(w)
            else:
                em.b3(72, 247, 225)          // mul rcx
                em.jglobal(0, 130, RT_OV)    // jc: past 64 bits
                if bits ≠ 64:
                    em.range_check(w)
            em.store(R_AX, d)
        elif o = IR_NEG or o = IR_NEGW:
            em.load(R_AX, a)
            em.b3(72, 247, 216)              // neg rax
            if o = IR_NEG:
                if sgn = 1:
                    if bits = 64:
                        em.jglobal(0, 128, RT_OV)
                    else:
                        em.range_check(w)
                else:
                    // a negated unsigned is only 0; nonzero sets carry
                    if bits = 64:
                        em.jglobal(0, 130, RT_OV)
                    else:
                        em.range_check(w)
            else:
                em.canon(w)
            em.store(R_AX, d)
        elif o = IR_BAND or o = IR_BORR or o = IR_BXORR:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if o = IR_BAND:
                em.b3(72, 33, 200)
            elif o = IR_BORR:
                em.b3(72, 9, 200)
            else:
                em.b3(72, 49, 200)
            em.store(R_AX, d)
        elif o = IR_BNOTT:
            em.load(R_AX, a)
            em.b3(72, 247, 208)              // not rax
            em.canon(w)
            em.store(R_AX, d)
        elif o = IR_SHLL or o = IR_SHRR:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 131, 249)              // cmp rcx, value-bits
            em.b1(bits - sgn)
            em.jglobal(0, 131, RT_SHIFT)     // jae
            if o = IR_SHLL:
                em.b3(72, 211, 224)          // shl rax, cl
                em.canon(w)
            else:
                if sgn = 1:
                    em.b3(72, 211, 248)      // sar rax, cl
                else:
                    em.b3(72, 211, 232)      // shr rax, cl
            em.store(R_AX, d)
        elif o >= IR_CEQ and o <= IR_CGE:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 57, 200)               // cmp rax, rcx
            em.b3(15, cc_of(o, sgn), 192)    // setcc al
            em.b4(72, 15, 182, 192)          // movzx rax, al
            em.store(R_AX, d)
        elif o = IR_MAXX or o = IR_MINN:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 57, 200)               // cmp rax, rcx
            let cmov : mut i64 = 0
            if o = IR_MAXX:
                cmov ← 76 if sgn = 1 else 66     // cmovl / cmovb
            else:
                cmov ← 79 if sgn = 1 else 71     // cmovg / cmova
            em.b4(72, 15, cmov, 193)             // cmovcc rax, rcx
            em.store(R_AX, d)
        elif o = IR_SEL:
            em.load(R_R10, a)
            em.load(R_AX, b)
            em.load(R_CX, c)
            em.b3(77, 133, 210)              // test r10, r10
            em.b4(72, 15, 68, 193)           // cmovz rax, rcx
            em.store(R_AX, d)
        elif o = IR_DIVV or o = IR_MODD:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 133, 201)              // test rcx, rcx
            em.b2(15, 133)                   // jnz over the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.load(R_AX, c)
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            if sgn = 1:
                if bits = 64:
                    em.movimm(R_R10, ⁻9223372036854775807 - 1)
                    em.b3(76, 57, 208)       // cmp rax, r10
                    em.b2(15, 133)           // jne
                    let p3 : i64 = em.here()
                    em.w32(0)
                    em.b3(72, 131, 249)      // cmp rcx, ⁻1
                    em.b1(255)
                    em.jglobal(0, 132, RT_OV)    // je
                    em.patch32(p3, em.here() - (p3 + 4))
                em.b2(72, 153)               // cqo
                em.b3(72, 247, 249)          // idiv rcx
            else:
                em.b2(49, 210)               // xor edx, edx
                em.b3(72, 247, 241)          // div rcx
            if o = IR_MODD:
                em.b3(72, 137, 208)          // mov rax, rdx
            if sgn = 1 and bits ≠ 64:
                em.range_check(w)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_JMP:
            em.jlocal(⁻1, a)
        elif o = IR_JZ or o = IR_JNZ:
            em.load(R_AX, a)
            em.b3(72, 133, 192)
            em.jlocal(132 if o = IR_JZ else 133, b)
        elif o = IR_LABEL:
            em.set_label(a)
        elif o = IR_CALL:
            let argc : i64 = ir.extra[b × 1¤ptrdiff]
            if argc > 6:
                // the seventh argument onward rides the stack, pushed
                // last-first so the seventh sits at [rbp+16]
                let x : mut i64 = argc - 1
                while x >= 6:
                    em.load(R_AX, ir.extra[(b + 1 + x) × 1¤ptrdiff])
                    em.b1(80)                    // push rax
                    x ← x - 1
            let k : mut i64 = 0
            while k < (argc ⌊ 6):
                em.load(arg_reg(k), ir.extra[(b + 1 + k) × 1¤ptrdiff])
                k ← k + 1
            em.jglobal(232, ⁻1, a)
            if argc > 6:
                em.b3(72, 129, 196)
                em.w32(8 × (argc - 6))           // add rsp: the ride is over
            em.store(R_AX, d)
        elif o = IR_FADDR:
            em.raxbar()
            em.b2(72, 141)                   // lea rax, [rip+disp32]
            em.jglobal(5, ⁻1, a)
            em.store(R_AX, d)
        elif o = IR_CALLI:
            let argci : i64 = ir.extra[b × 1¤ptrdiff]
            let ki : mut i64 = 0
            while ki < argci:
                em.load(arg_reg(ki), ir.extra[(b + 1 + ki) × 1¤ptrdiff])
                ki ← ki + 1
            em.load(R_R11, a)
            em.raxbar()
            em.b3(65, 255, 211)              // call r11
            em.store(R_AX, d)
        elif o = IR_RET:
            if a ≠ ⁻1:
                em.load(R_AX, a)
            em.b1(201)
            em.b1(195)
        elif o = IR_PRINTS:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_WRITE1)
        elif o = IR_EPRINTS:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_WRITE2)
        elif o = IR_PRINTI:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTI)
        elif o = IR_PRINTU:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTU)
        elif o = IR_EXIT:
            em.load(R_DI, a)
            em.movimm(R_AX, 60)
            em.b2(15, 5)
        elif o = IR_ABORT:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_ABORT)
        elif o = IR_GLOAD:
            em.gref(R_R11, a)
            em.b3(73, 139, 3)                // mov rax, [r11]
            em.store(R_AX, d)
        elif o = IR_GSTORE:
            em.load(R_AX, b)
            em.gref(R_R11, a)
            em.b3(73, 137, 3)                // mov [r11], rax
        elif o = IR_ANEW:
            em.movimm(R_DI, a)
            em.jglobal(232, ⁻1, RT_ARRNEW)
            em.store(R_AX, d)
        elif o = IR_APUSH:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_ARRPUSH)
        elif o = IR_AIDX:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.jglobal(0, 131, RT_BOUNDS)    // jae
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.store(R_AX, d)
        elif o = IR_DENTS:
            em.jglobal(232, ⁻1, RT_DENTS)
            em.store(R_AX, d)
        elif o = IR_AREF:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.jglobal(0, 131, RT_BOUNDS)    // jae
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 141, 4, 202)           // lea rax, [rdx+rcx*8]
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_ASTO:
            em.load(R_R10, a)
            em.load(R_CX, b)
            em.b4(73, 59, 74, 8)             // cmp rcx, [r10+8]
            em.jglobal(0, 131, RT_BOUNDS)
            em.b3(73, 139, 18)               // mov rdx, [r10]
            em.load(R_AX, c)
            em.b4(72, 137, 4, 202)           // mov [rdx+rcx*8], rax
        elif o = IR_APOP:
            em.load(R_AX, a)
            em.b4(72, 139, 72, 8)            // mov rcx, [rax+8]
            em.b3(72, 133, 201)              // test rcx, rcx
            em.b2(15, 132)                   // jz to the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.b3(72, 255, 201)              // dec rcx
            em.b4(72, 137, 72, 8)            // mov [rax+8], rcx
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            em.load(R_AX, b)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_AGET:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.b2(15, 131)                   // jae to the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            em.load(R_AX, c)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_ALEN:
            em.load(R_AX, a)
            em.b4(72, 139, 64, 8)            // mov rax, [rax+8]
            em.store(R_AX, d)
        elif o = IR_SC:
            em.sdref(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_SCCAT:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_CONCAT)
            em.store(R_AX, d)
        elif o = IR_SEQV:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_STREQ)
            em.store(R_AX, d)
        elif o = IR_SLENV:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_STRCHARS)
            em.store(R_AX, d)
        elif o = IR_PRINTSV:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTSTR)
        elif o = IR_VTAB:
            let vmin : i64 = ir.extra[b × 1¤ptrdiff]
            let span : i64 = ir.extra[(b + 1) × 1¤ptrdiff]
            let defv : i64 = ir.extra[(b + 2) × 1¤ptrdiff]
            em.load(R_AX, a)
            em.movimm(R_R10, vmin)
            em.b3(76, 41, 208)               // sub rax, r10
            em.b3(72, 49, 201)               // xor rcx, rcx, before the flags matter
            em.movimm(R_R11, span)
            em.b3(76, 57, 216)               // cmp rax, r11
            em.b4(65, 15, 146, 194)          // setb r10b: inside the table
            em.b4(77, 15, 182, 210)          // movzx r10, r10b
            em.b4(72, 15, 67, 193)           // cmovae rax, rcx: clamp the load
            let id2 : i64 = em.jt_count
            em.jt_count ← em.jt_count + 1
            em.jtref(R_DX, id2)
            em.b4(72, 139, 4, 194)           // mov rax, [rdx+rax*8]
            em.movimm(R_CX, defv)
            em.b3(77, 133, 210)              // test r10, r10
            em.b4(72, 15, 68, 193)           // cmovz rax, rcx: outside answers the default
            em.store(R_AX, d)
            em.pj_id.push(id2)
            em.pj_start.push(@dropunit(#em.pj_labels))
            em.pj_len.push(0 - span)         // negative: raw values, not labels
            let e2 : mut i64 = 0
            while e2 < span:
                em.pj_labels.push(ir.extra[(b + 3 + e2) × 1¤ptrdiff])
                e2 ← e2 + 1
        elif o = IR_SNEW:
            em.movimm(R_DI, 8 × a)
            em.jglobal(232, ⁻1, RT_ALLOC)
            em.store(R_AX, d)
        elif o = IR_FLD:
            em.load(R_AX, a)
            em.b3(72, 139, 128)              // mov rax, [rax+disp32]
            em.w32(8 × b)
            em.store(R_AX, d)
        elif o = IR_FSTO:
            em.load(R_R10, a)
            em.load(R_AX, c)
            em.b3(73, 137, 130)              // mov [r10+disp32], rax
            em.w32(8 × b)
        elif o = IR_HNEW:
            em.movimm(R_DI, a)
            em.movimm(R_SI, b)
            em.jglobal(232, ⁻1, RT_HNEW)
            em.store(R_AX, d)
        elif o = IR_HPUT:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.load(R_DX, c)
            em.jglobal(232, ⁻1, RT_HPUT)
        elif o = IR_HGET:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_HGET)
            em.store(R_AX, d)
        elif o = IR_HELEM:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_HELEM)
            em.store(R_AX, d)
        elif o = IR_HLEN:
            em.load(R_AX, a)
            em.b4(72, 139, 64, 16)           // mov rax, [rax+16]
            em.store(R_AX, d)
        elif o = IR_CHR:
            em.load(R_AX, a)
            em.movimm(R_R10, 1114111)
            em.b3(76, 57, 208)               // cmp rax, r10
            em.jglobal(0, 135, RT_BADCHAR)   // ja: past the last, negatives included
            em.b3(72, 141, 136)
            em.w32(⁻55296)                   // lea rcx, [rax - 0xD800]
            em.movimm(R_R10, 2048)
            em.b3(76, 57, 209)               // cmp rcx, r10
            em.jglobal(0, 130, RT_BADCHAR)   // jb: a surrogate
            em.store(R_AX, d)
        elif o = IR_SIDX:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_STRIDX)
            em.store(R_AX, d)
        elif o = IR_CHARS:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_CHARS)
            em.store(R_AX, d)
        elif o = IR_CHARSTR:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_CHARSTR)
            em.store(R_AX, d)
        elif o = IR_SDEC:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_STRNEXT)
            em.store(R_AX, d)
            em.store(R_DX, c)
        elif o = IR_AUXV:
            em.movimm(R_DI, a)
            em.jglobal(232, ⁻1, RT_AUXV)
            em.store(R_AX, d)
        elif o = IR_EXECFN:
            em.jglobal(232, ⁻1, RT_EXECFN)
            em.store(R_AX, d)
        elif o = IR_ENVN:
            em.jglobal(232, ⁻1, RT_ENVN)
            em.store(R_AX, d)
        elif o = IR_ENVG:
            em.load(R_R11, a)
            em.b3(73, 139, 51)                   // mov rsi, [r11]: the name's bytes
            em.b4(73, 139, 83, 8)                // mov rdx, [r11+8]: how many
            em.jglobal(232, ⁻1, RT_ENVG)
            em.store(R_AX, d)
        elif o = IR_ARGS:
            em.jglobal(232, ⁻1, RT_ARGS)
            em.store(R_AX, d)
        elif o = IR_FOPEN:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_FOPEN)
            em.store(R_AX, d)
        elif o = IR_FCREATE:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_FCREATE)
            em.store(R_AX, d)
        elif o = IR_FREAD:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_FREAD)
            em.store(R_AX, d)
        elif o = IR_FWRITE:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_FWRITE)
        elif o = IR_TORAW:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_TORAW)
            em.store(R_AX, d)
        elif o = IR_WRITEV:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_WRITEV)
        elif o = IR_FCLOSE:
            em.load(R_DI, a)
            em.b3(72, 137, 248)              // mov rax, rdi -- the fd
            em.b3(72, 137, 199)              // mov rdi, rax
            em.movimm(R_AX, 3)
            em.b2(15, 5)                     // close
            em.raxbar()
        elif o = IR_NARROW:
            em.load(R_AX, a)
            let nbits : i64 = w & 255
            let nsgn : i64 = w » 8
            if nbits = 64:
                // crossing between i64 and u64 either way: the value
                // is out of reach exactly when its top bit is set
                em.b3(72, 133, 192)              // test rax, rax
                em.jglobal(0, 136, RT_BADFIT)    // js
            elif nsgn = 0:
                em.movimm(R_R10, (1 « nbits) - 1)
