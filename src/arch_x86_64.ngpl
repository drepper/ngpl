let emit := @import("emit")
let ir_m := @import("ir")

// ===========================================================================
// x86-64: the hand-tuned emitter
// ===========================================================================
//
// The pioneer.  x86-64 fixes what every IR operation means, and is the
// measure the five that arrive through the shared retargetable path
// are checked against; it did not change when that path was built.
// Its runtime is beside it, in rt_x86_64.ngpl.



@pre(j >= 0 and j <= 5)
fn arg_reg(j : i64) → i64:
    if j = 0: return emit.R_DI
    if j = 1: return emit.R_SI
    if j = 2: return emit.R_DX
    if j = 3: return emit.R_CX
    if j = 4: return emit.R_R8
    emit.R_R9

// Where an argument travels, for a function nobody outside can call.
//
// The architecture puts the first two in rdi and rsi, and this emitter
// works in rax and rcx: every operation reads its first operand into
// rax and its second into rcx.  So a private function takes them there
// instead, and the move between the two disappears at both ends -- the
// caller has the value where the callee wants it, and the callee wants
// it where the arithmetic already looks.
//
// The rest keep their places as far as they can, rdi and rsi taking the
// two the front of the list gave up.  Six arguments still travel in
// registers; what changes is which.
@export
@pre(j >= 0)
fn arg_reg_p(j : i64, priv : i64) → i64:
    if priv = 0:
        return arg_reg(j)
    if j = 0: return emit.R_AX
    if j = 1: return emit.R_CX
    if j = 2: return emit.R_DX
    if j = 3: return emit.R_SI
    if j = 4: return emit.R_DI
    emit.R_R8

// the setcc condition for a comparison at a signedness
@pre(sgn = 0 or sgn = 1)
@post(r: r >= 146 and r <= 159)
fn cc_of(o : i64, sgn : i64) → i64:
    if o = ir_m.IR_CEQ: return 148
    if o = ir_m.IR_CNE: return 149
    if sgn = 1:
        if o = ir_m.IR_CLT: return 156
        if o = ir_m.IR_CLE: return 158
        if o = ir_m.IR_CGT: return 159
        return 157
    if o = ir_m.IR_CLT: return 146
    if o = ir_m.IR_CLE: return 150
    if o = ir_m.IR_CGT: return 151
    147

// Whether an operation begins by loading its first operand into rax.
//
// IR_RET is here for the same reason as the rest, though it opens with
// a test of whether there is a value at all: where there is one, the
// first thing it does is read it into rax.  Reading this list off the
// emitter mechanically had left it out for the shape of that line, and
// the cost was a store before every return that nothing ever read.
// Only those can have the store before them dropped: the value stays in
// rax and the memo hands it straight over, and any other opening would
// write over rax before it was read.  Checked against the emitter
// below, one branch at a time.
fn se_reads_a_first(o : i64) → bool:
    if o >= ir_m.IR_CEQ and o <= ir_m.IR_CGE:
        return true
    o = ir_m.IR_MOV or o = ir_m.IR_ADD or o = ir_m.IR_ADDW or o = ir_m.IR_SUB or o = ir_m.IR_SUBW or o = ir_m.IR_MUL or o = ir_m.IR_MULW or o = ir_m.IR_NEG or o = ir_m.IR_NEGW or o = ir_m.IR_BAND or o = ir_m.IR_BORR or o = ir_m.IR_BXORR or o = ir_m.IR_BNOTT or o = ir_m.IR_SHLL or o = ir_m.IR_SHRR or o = ir_m.IR_MAXX or o = ir_m.IR_MINN or o = ir_m.IR_DIVV or o = ir_m.IR_MODD or o = ir_m.IR_JZ or o = ir_m.IR_JNZ or o = ir_m.IR_AIDX or o = ir_m.IR_AREF or o = ir_m.IR_APOP or o = ir_m.IR_AGET or o = ir_m.IR_ALEN or o = ir_m.IR_LDN or o = ir_m.IR_FLD or o = ir_m.IR_HLEN or o = ir_m.IR_CHR or o = ir_m.IR_NARROW or o = ir_m.IR_RET or o = ir_m.IR_EXT

// Whether the store this operation ends with may be dropped.
//
// It may when the only other place naming the slot is the operation
// straight after, which reads it first and into rax.  Nothing else in
// the function names it, so nothing else can read it from memory; and
// the next operation cannot be arrived at any other way, since it is
// not a label and a jump has nowhere else to land.  What holds the
// value between the two is rax, which is where the memo is already
// looking.
fn se_can_drop(ir : ir_m.IrFn, i : i64 ¤ptrdiff, n : i64 ¤ptrdiff, cnt : i64[], nv : i64) → bool:
    let d : i64 = ir.id[i]
    if d < 0 or d >= nv or i + 1 >= n:
        return false
    let nx : i64 = ir.op[i + 1]
    if nx = ir_m.IR_LABEL or not se_reads_a_first(nx):
        return false
    if ir.ia[i + 1] ≠ d:
        return false
    // every naming of it outside this operation is that one read
    cnt[d × 1¤ptrdiff] - ir_m.se_here(ir, i, d) = ir_m.se_here(ir, i + 1, d) and ir_m.se_here(ir, i + 1, d) = 1

// What the first operation reads, where that is known exactly.
//
// 1: it reads a into rax and writes no argument register before doing
// so.  2: it reads a into rax and then b into rcx.  0: anything else,
// about which nothing is assumed.
//
// Read off the emitter below as the other two lists were, by the
// sequence of typed loads each branch begins with.  An operation that
// writes rdx or another argument register later in its body is still
// here: what matters is that the reads come first, and nothing is
// believed about a register once the first operation is done.
fn p_class(o : i64) → i64:
    if o >= ir_m.IR_CEQ and o <= ir_m.IR_CGE:
        return 2
    if o = ir_m.IR_ADD or o = ir_m.IR_ADDW or o = ir_m.IR_SUB or o = ir_m.IR_SUBW or o = ir_m.IR_MUL or o = ir_m.IR_MULW or o = ir_m.IR_BAND or o = ir_m.IR_BORR or o = ir_m.IR_BXORR or o = ir_m.IR_SHLL or o = ir_m.IR_SHRR or o = ir_m.IR_MAXX or o = ir_m.IR_MINN or o = ir_m.IR_DIVV or o = ir_m.IR_MODD or o = ir_m.IR_AIDX or o = ir_m.IR_AREF or o = ir_m.IR_AGET:
        return 2
    if o = ir_m.IR_EXT or o = ir_m.IR_MOV or o = ir_m.IR_NEG or o = ir_m.IR_NEGW or o = ir_m.IR_BNOTT or o = ir_m.IR_JZ or o = ir_m.IR_JNZ or o = ir_m.IR_RET or o = ir_m.IR_APOP or o = ir_m.IR_ALEN or o = ir_m.IR_LDN or o = ir_m.IR_FLD or o = ir_m.IR_HLEN or o = ir_m.IR_CHR or o = ir_m.IR_NARROW:
        return 1
    0

// Whether parameter j never needs the spill the prologue would make.
//
// It does not when every read of it in the whole function is in the
// first operation: nothing has run before that could have written over
// the register it arrived in, so the read can come from there.  Later
// than that and the register may be anything -- the emitter writes many
// of them as raw bytes, which no memo could follow -- so nothing beyond
// the first operation is claimed.
// Whether anything jumps to a label.
fn p_jumped_to(ir : ir_m.IrFn, n : i64 ¤ptrdiff, lab : i64) → bool:
    let hit : mut bool = false
    foreach i := 0…n:
        let o : i64 = ir.op[i]
        // a table keeps its labels in extra, where this does not look
        hit ← hit or o = ir_m.IR_JTAB or o = ir_m.IR_VTAB
        hit ← hit or (o = ir_m.IR_JMP and ir.ia[i] = lab)
        hit ← hit or ((o = ir_m.IR_JZ or o = ir_m.IR_JNZ) and ir.ib[i] = lab)
    hit

// The first operation that does anything, and ⁻1 where control could
// arrive before it.
//
// A body opens with the label a tail call comes back to.  Where nothing
// jumps there it is not somewhere control arrives, and the registers
// still hold what the caller put in them.  Where something does, the
// tail call has written the parameters to their slots and the registers
// say nothing about them -- so the spill those slots need is made.
fn p_first(ir : ir_m.IrFn, n : i64 ¤ptrdiff) → i64 ¤ptrdiff:
    let i : mut i64 ¤ptrdiff = 0¤ptrdiff
    while i < n and ir.op[i] = ir_m.IR_LABEL:
        if p_jumped_to(ir, n, ir.ia[i]):
            return ⁻1¤ptrdiff
        i ← i + 1
    if i >= n:
        return ⁻1¤ptrdiff
    i

fn p_keep(ir : ir_m.IrFn, j : i64, cnt : i64[], nv : i64, first : i64 ¤ptrdiff, priv : i64) → bool:
    if first < 0 or j < 0 or j >= nv:
        return false
    let c : i64 = p_class(ir.op[first])
    if c = 0:
        return false
    // The first operand is read into rax, which writes over whatever was
    // there.  Where the second operand is the parameter that arrived in
    // rax -- which only the private convention puts there -- it would be
    // gone before it was read, so neither is kept and both are spilled.
    let ia0 : i64 = ir.ia[first]
    let ib0 : i64 = ir.ib[first]
    if c = 2 and ia0 ≠ ib0 and ib0 >= 0 and ib0 < 6 and arg_reg_p(ib0, priv) = emit.R_AX:
        return false
    let ha : i64 = if ia0 = j: 1 else: 0
    let hb : i64 = if c = 2 and ib0 = j: 1 else: 0
    let here : i64 = ha + hb
    here > 0 and cnt[j × 1¤ptrdiff] = here

// priv says whether this function takes the private convention; priv_of
// says the same of every function it might call, indexed as a call
// target is.  A runtime routine, whose number is negative, and anything
// past the end of that table take the architecture's convention.
// A produced value is put into canonical form only where something
// will read it wider than its type -- which canon_wanted has already
// worked out.  Everywhere else the bits above the width may stay as
// they fell, nothing being about to look at them.
// cmp rax against a value, at the width the division is running at.
// The widest needs a register to hold the number; the others say it
// where they stand.
fn cmpimm_ax(em : &mut emit.Emit, dw : i64, v : i64):
    if dw = 16:
        em.b2(102, 61)                       // cmp ax, imm16
        em.b1(v & 255)
        em.b1((v » 8) & 255)
    elif dw = 32:
        em.b1(61)                            // cmp eax, imm32
        em.w32(v)
    else:
        em.movimm(emit.R_R10, v)
        em.b3(76, 57, 208)                   // cmp rax, r10

// The least value a width holds, which over minus one is the division
// the machine faults on rather than answers.
fn least_at(dw : i64) → i64:
    if dw = 16:
        return ⁻32768
    if dw = 32:
        return ⁻2147483648
    ⁻9223372036854775807 - 1

@export
fn want_canon(cwant : i64[], d : i64, w : i64) → bool:
    let bits : i64 = w & 255
    if bits ≠ 8 and bits ≠ 16 and bits ≠ 32:
        return false
    d >= 0 and d < @dropunit(#cwant) and cwant[d × 1¤ptrdiff] = 1

@export
fn emit_fn(em : &mut emit.Emit, ir : ir_m.IrFn, np : i64, strs : str[],
           priv : i64, priv_of : i64[]):
    assert(ir.nvregs >= np, "the frame covers the spilled arguments")
    em.begin_fn(ir.nlabels)
    em.b1(85)                       // push rbp
    em.b3(72, 137, 229)             // mov rbp, rsp
    em.b3(72, 129, 236)             // sub rsp, imm32
    // a slot for every vreg, then the objects that live in the frame
    // outright, which take the slots just past them
    let nobj : i64 = (@dropunit(ir.fbytes) + 7) ÷ 8 ?? 0
    let frame : i64 = 8 × (ir.nvregs + nobj) + 8
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.w32(frame)
    let secnt : i64[] = ir_m.se_counts(ir, ir.nvregs)
    // which results anything will read wider than their type
    let cwant : i64[] = ir_m.canon_wanted(ir, ir.nvregs, 7, 7)
    let nops : i64 ¤ptrdiff = #ir.op
    let pfirst : i64 ¤ptrdiff = p_first(ir, nops)
    // one function's answer is not the next one's
    em.pclear()
    em.self_priv ← priv
    foreach j := 0…np:
        if j < 6:
            if p_keep(ir, j, secnt, ir.nvregs, pfirst, priv):
                // read where it arrived; no spill is made for it
                em.pkeep.push(1)
            else:
                em.pkeep.push(0)
                em.store(arg_reg_p(j, priv), j)
        else:
            em.b3(72, 139, 133)
            em.w32(16 + 8 × (j - 6))    // mov rax, [rbp+…]: a stack argument
            em.store(emit.R_AX, j)
    let n : i64 ¤ptrdiff = nops
    foreach i := 0¤ptrdiff…n:
        let o : i64 = ir.op[i]
        let a : i64 = ir.ia[i]
        let b : i64 = ir.ib[i]
        let c : i64 = ir.ic[i]
        let d : i64 = ir.id[i]
        let w : i64 = ir.iw[i]
        let bits : i64 = w & 255
        em.drop_slot ← if se_can_drop(ir, i, n, secnt, ir.nvregs): d else: ⁻1
        let sgn : i64 = w » 8
        if o = ir_m.IR_CONST:
            em.movimm(emit.R_AX, a)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_MOV:
            em.load(emit.R_AX, a)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_ADD or o = ir_m.IR_ADDW or o = ir_m.IR_SUB or o = ir_m.IR_SUBW:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            // A checked type is worked out at its own width so that the
            // machine's flag is the answer; a wrapping one at 64, being
            // narrowed afterwards in either case.
            let ck : bool = o = ir_m.IR_ADD or o = ir_m.IR_SUB
            let dw : i64 = if ck: bits else: 64
            em.opw(dw, if o = ir_m.IR_ADD or o = ir_m.IR_ADDW: 1 else: 41, 200)
            if ck:
                em.jabort(if sgn = 1: 128 else: 130, emit.RT_OV)  // jo / jc
            if want_canon(cwant, d, w):
                em.canon_at(w, dw)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_MUL or o = ir_m.IR_MULW:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            if sgn = 1 or o = ir_m.IR_MULW:
                // imul has no 8-bit two-operand form, so a checked
                // signed byte keeps the old shape and its range check
                if o = ir_m.IR_MUL and bits ≠ 8:
                    em.imulw(bits)
                    em.jabort(128, emit.RT_OV)
                    if want_canon(cwant, d, w):
                        em.canon(w)
                else:
                    em.b4(72, 15, 175, 193)  // imul rax, rcx
                    if o = ir_m.IR_MUL:
                        em.range_check(w)
                    elif want_canon(cwant, d, w):
                        em.canon(w)
            else:
                // mul sets carry when the half above the width is not
                // zero, which for this width is exactly the overflow
                em.opw(bits, 247, 225)       // mul rcx
                em.jabort(130, emit.RT_OV)    // jc
                if want_canon(cwant, d, w):
                    em.canon_at(w, bits)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_NEG or o = ir_m.IR_NEGW:
            em.load(emit.R_AX, a)
            let nw : i64 = if o = ir_m.IR_NEG: bits else: 64
            em.opw(nw, 247, 216)                            // neg
            if o = ir_m.IR_NEG:
                // overflow for a signed negation is the least value
                // alone, and for an unsigned one is anything but zero:
                // at this width the machine says both
                em.jabort(if sgn = 1: 128 else: 130, emit.RT_OV)
            if want_canon(cwant, d, w):
                em.canon_at(w, nw)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_BAND or o = ir_m.IR_BORR or o = ir_m.IR_BXORR:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            if o = ir_m.IR_BAND:
                em.b3(72, 33, 200)
            elif o = ir_m.IR_BORR:
                em.b3(72, 9, 200)
            else:
                em.b3(72, 49, 200)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_BNOTT:
            em.load(emit.R_AX, a)
            em.b3(72, 247, 208)              // not rax
            if want_canon(cwant, d, w):
                em.canon(w)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_SHLL or o = ir_m.IR_SHRR:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            em.b3(72, 131, 249)              // cmp rcx, value-bits
            em.b1(bits - sgn)
            em.jabort(131, emit.RT_SHIFT)     // jae
            if o = ir_m.IR_SHLL:
                em.b3(72, 211, 224)          // shl rax, cl
                if want_canon(cwant, d, w):
                    em.canon(w)
            else:
                if sgn = 1:
                    em.b3(72, 211, 248)      // sar rax, cl
                else:
                    em.b3(72, 211, 232)      // shr rax, cl
            em.store(emit.R_AX, d)
        elif o >= ir_m.IR_CEQ and o <= ir_m.IR_CGE:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            // at the width the values are, so that what stands above it
            // is not asked about and need not be true
            em.opw(bits, 57, 200)            // cmp
            em.b3(15, cc_of(o, sgn), 192)    // setcc al
            em.b4(72, 15, 182, 192)          // movzx rax, al
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_MAXX or o = ir_m.IR_MINN:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            em.opw(bits, 57, 200)            // cmp, at the values' width
            let cmov : mut i64 = 0
            if o = ir_m.IR_MAXX:
                cmov ← if sgn = 1: 76 else: 66// cmovl / cmovb
            else:
                cmov ← if sgn = 1: 79 else: 71// cmovg / cmova
            em.b4(72, 15, cmov, 193)             // cmovcc rax, rcx
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_SEL:
            em.load(emit.R_R10, a)
            em.load(emit.R_AX, b)
            em.load(emit.R_CX, c)
            em.b3(77, 133, 210)              // test r10, r10
            em.b4(72, 15, 68, 193)           // cmovz rax, rcx
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_DIVV or o = ir_m.IR_MODD:
            em.load(emit.R_AX, a)
            em.load(emit.R_CX, b)
            // A byte-wide division is the one the machine puts in ah
            // rather than in dx, so it is done a word wider with its
            // operands brought up first.  Every other width divides as
            // it stands, which is what lets what is above it be
            // anything at all.
            let dw : i64 = if bits = 8: 32 else: bits
            if bits = 8:
                em.canon(w)
                em.canon_reg(w, emit.R_CX)
            em.opw(dw, 133, 201)             // test rcx, rcx
            em.b2(15, 133)                   // jnz over the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.load(emit.R_AX, c)
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            let p6 : mut i64 = ⁻1
            if sgn = 1:
                // The least value over minus one has no quotient the
                // type can hold, and dividing at the width the machine
                // faults on it rather than working out something too
                // large.  A byte is the exception, being divided wider
                // than it is: 128 fits where it is worked out, and the
                // range check below is what refuses it.
                if bits ≠ 8:
                    cmpimm_ax(&em, dw, least_at(dw))
                    em.b2(15, 133)           // jne
                    let p3 : i64 = em.here()
                    em.w32(0)
                    em.opw(dw, 131, 249)     // cmp rcx, ⁻1
                    em.b1(255)
                    if o = ir_m.IR_MODD:
                        // The least integer divided by minus one has
                        // no quotient this type can hold, and the
                        // machine faults working the quotient and the
                        // remainder out at once.  The remainder is
                        // nought though, and always was: x % ⁻1 is
                        // nought for every x.  So this is the one the
                        // machine cannot answer and the language can.
                        em.b2(15, 133)       // jne, on past
                        let p4 : i64 = em.here()
                        em.w32(0)
                        em.b3(72, 49, 192)   // xor rax, rax
                        em.b1(233)           // jmp to the end
                        p6 ← em.here()
                        em.w32(0)
                        em.patch32(p4, em.here() - (p4 + 4))
                    else:
                        em.jabort(132, emit.RT_OV)    // je
                    em.patch32(p3, em.here() - (p3 + 4))
                if dw = 16:
                    em.b2(102, 153)          // cwd
                elif dw = 32:
                    em.b1(153)               // cdq
                else:
                    em.b2(72, 153)           // cqo
                em.opw(dw, 247, 249)         // idiv rcx
            else:
                em.b2(49, 210)               // xor edx, edx
                em.opw(dw, 247, 241)         // div rcx
            if o = ir_m.IR_MODD:
                em.b3(72, 137, 208)          // mov rax, rdx
            if sgn = 1 and bits = 8:
                // the wider division leaves its answer zero-extended
                // into the rest of the register, and the range check
                // reads the whole of it
                em.canon(32 + 256)
                em.range_check(w)
            em.patch32(p2, em.here() - (p2 + 4))
            if p6 ≠ ⁻1:
                em.patch32(p6, em.here() - (p6 + 4))
            // every way here leaves a value only as wide as its type
            if want_canon(cwant, d, w):
                em.canon(w)
            em.raxbar()
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_JMP:
            em.jlocal(⁻1, a)
        elif o = ir_m.IR_JZ or o = ir_m.IR_JNZ:
            em.load(emit.R_AX, a)
            em.b3(72, 133, 192)
            em.jlocal(if o = ir_m.IR_JZ: 132 else: 133, b)
        elif o = ir_m.IR_LABEL:
            em.set_label(a)
        elif o = ir_m.IR_CALL:
            let argc : i64 = ir.extra[b × 1¤ptrdiff]
            let cp : i64 = if a >= 0 and a < @dropunit(#priv_of): priv_of[a × 1¤ptrdiff] else: 0
            if argc > 6:
                // the seventh argument onward rides the stack, pushed
                // last-first so the seventh sits at [rbp+16]
                foreach x := argc - 1…5:
                    em.load(emit.R_AX, ir.extra[(b + 1 + x) × 1¤ptrdiff])
                    em.b1(80)                    // push rax
            foreach k := 0…(argc ⌊ 6):
                em.load(arg_reg_p(k, cp), ir.extra[(b + 1 + k) × 1¤ptrdiff])
            em.jglobal(232, ⁻1, a)
            if argc > 6:
                em.b3(72, 129, 196)
                em.w32(8 × (argc - 6))           // add rsp: the ride is over
            // a returned value is only as wide as its type; where this
            // caller wants more, this caller is the one that says so
            if want_canon(cwant, d, w):
                em.canon(w)
            em.store(emit.R_AX, d)
        elif o = ir_m.IR_FADDR:
            em.raxbar()
