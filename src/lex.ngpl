let ast := @import("ast")
let diag := @import("diag")
let tokens := @import("tokens")
let types := @import("types")

// ===========================================================================
// Lexing: a byte-class table drives the scan
// ===========================================================================
//
// Every byte is classified once through a 256-entry table; the class
// either is the token (entries ≥ 100 carry the token kind directly) or
// names the one handler that reads the run.  Multi-byte glyphs go
// through the GLYPHS hashes.  This is the scalar, table-driven shape of
// the mask-pipeline design DESIGN.md describes: the classes here are
// the classes a SIMD or GPU lexer computes 64 bytes at a time.



// What kind of byte begins a token, which is all the class table
// says: which token a byte makes by itself is the table beside it.
enum Cl : u8:
    invalid = 0
    ws = 1
    nl = 2
    digit = 3
    ident = 4
    quote = 5
    slash = 6
    mb2 = 7    // two-byte glyph lead (C2, C3, CE)
    mb3 = 8    // three-byte glyph lead (E2)
    tab = 9
    colon = 10    // : or :=
    lt = 11    // < <= << <-
    gt = 12    // > >= >>
    dash = 13    // - or ->
    qmark = 14    // ??
    apos = 15    // a character literal
    punct = 16    // a byte that is a whole token by itself

// Which token each byte makes where it makes one by itself, and
// Tk.none for every byte that does not.  The kinds live here rather
// than folded into the class table's numbers: a table of kinds holds
// kinds, and the class table then says what kind of byte it is and
// nothing more.
fn mkpunct() → tokens.Tk[256]:
    let t : mut tokens.Tk[256] = 256 ⍴ tokens.Tk.none
    t[33] ← tokens.Tk.bang
    t[59] ← tokens.Tk.semi
    t[40] ← tokens.Tk.lpar
    t[41] ← tokens.Tk.rpar
    t[44] ← tokens.Tk.comma
    t[46] ← tokens.Tk.dot
    t[64] ← tokens.Tk.at
    t[43] ← tokens.Tk.plus
    t[37] ← tokens.Tk.mod
    t[61] ← tokens.Tk.eq
    t[126] ← tokens.Tk.bnot
    t[38] ← tokens.Tk.band
    t[124] ← tokens.Tk.bor
    t[94] ← tokens.Tk.bxor
    t[91] ← tokens.Tk.lbrack
    t[93] ← tokens.Tk.rbrack
    t[35] ← tokens.Tk.hash
    t[123] ← tokens.Tk.lbrace
    t[125] ← tokens.Tk.rbrace
    t

// The class table, built once per run.
//
// It is a sized array and not a T[] because its size is not in
// question: a byte has two hundred and fifty-six values and the table
// has an entry for each.  Saying so in the type is what makes it the
// elements and nothing else -- no length beside them, no capacity, no
// second allocation -- and turns the two hundred and fifty-six push
// calls that used to fill it into one fill of the caller's own space.
// Every self.cls[b] below then checks against a constant rather than
// against a length it has to load first.
fn mkcls() → Cl[256]:
    let p : tokens.Tk[256] = mkpunct()
    let t : mut Cl[256] = 256 ⍴ Cl.invalid
    foreach b := 0¤ptrdiff…256:
        if p[b] ≠ tokens.Tk.none:
            t[b] ← Cl.punct
    t[32] ← Cl.ws
    t[10] ← Cl.nl
    t[9] ← Cl.tab
    foreach d := 48¤ptrdiff…58:
        t[d] ← Cl.digit
    foreach c := 97¤ptrdiff…123:
        t[c] ← Cl.ident
    foreach c := 65¤ptrdiff…91:
        t[c] ← Cl.ident
    t[95] ← Cl.ident
    t[34] ← Cl.quote
    t[47] ← Cl.slash
    t[194] ← Cl.mb2
    t[195] ← Cl.mb2
    t[206] ← Cl.mb2
    t[226] ← Cl.mb3
    t[58] ← Cl.colon
    t[60] ← Cl.lt
    t[62] ← Cl.gt
    t[45] ← Cl.dash
    t[63] ← Cl.qmark
    t[39] ← Cl.apos
    t

fn is_digit(b : i32) → bool:
    b >= 48 and b <= 57

@post(r: r >= ⁻1 and r <= 15)
fn hex_val(b : i32) → i32:
    if is_digit(b): return b - 48
    if b >= 97 and b <= 102: return b - 87
    if b >= 65 and b <= 70: return b - 55
    ⁻1

@export
struct Toks:
    kind : tokens.Tk[]
    off : i64[]
    len : i64[]
    line : i64 ¤"line"[]
    col : i64 ¤"col"[]
    val : i64[]      // value of Tk.number, string table index of Tk.string
    big : i64[]      // 1 when a Tk.number is in [2^63, 2^64), stored wrapped
    strs : str[]     // string literal table
    diags : diag.Diag[]

struct Lexer:
    src : byte[]
    n : i64
    cls : Cl[256]
    punct : tokens.Tk[256]   // which token a byte makes by itself
    pos : i64
    line : i64 ¤"line"
    col : i64 ¤"col"
    parens : i64
    kind : tokens.Tk[]
    off : i64[]
    len : i64[]
    tline : i64 ¤"line"[]
    tcol : i64 ¤"col"[]
    val : i64[]
    big : i64[]
    strs : str[]
    indents : i64 ¤"col"[]   // the column each open block starts at
    diags : diag.Diag[]

impl Lexer:
    // A byte, or ⁻1 past the end.  Answered as an i32 because that is
    // what the lexer computes with: a byte, a packed run of two or
    // three of them, and a code point all fit one, and UCS-4 has
    // nothing that does not.
    fn peek(&self, ahead : i64) → i32:
        if self.pos + ahead >= self.n: return ⁻1
        self.src[(self.pos + ahead) × 1¤byte]

    fn emit(&mut self, k : tokens.Tk, o : i64, l : i64, c : i64 ¤"col", v : i64, b : i64):
        self.kind.push(k)
        self.off.push(o)
        self.len.push(l)
        self.tline.push(self.line)
        self.tcol.push(c)
        self.val.push(v)
        self.big.push(b)

    fn err(&mut self, m : str):
        self.diags.push(diag.Diag{line: self.line, col: self.col, msg: m, level: diag.DIAG_ERROR, code: diag.DIAG_NONE})
        self.pos ← self.n

    // one ASCII byte
    // Move on by n bytes of one column apiece.  The count is a
    // parameter because the callers know it: a two-character operator
    // moves two, and a loop that would have called this once a byte
    // counts the bytes first and moves once.
    @pre(n >= 0)
    fn adv(&mut self, n : i64):
        self.pos ← self.pos + n
        self.col ← self.col + n × 1¤"col"

    // a whole glyph of n bytes counts one column: columns are
    // characters, as the interpreter reports them
    fn advg(&mut self, n : i64):
        self.pos ← self.pos + n
        self.col ← self.col + 1

    fn skip_gaps(&mut self) → bool:
        while true:
            let b : i32 = self.peek(0)
            if b = ⁻1 or b = 10:
                return false
            let c : Cl = self.cls[b × 1¤ptrdiff]
            match c:
                Cl.ws:
                    // a run of spaces is one move: the run is counted
                    // first and the position walks past it once
                    let runs : mut i64 = 0
                    while self.peek(runs) = 32:
                        runs ← runs + 1
                    self.adv(runs)
                Cl.tab:
                    self.err("tab in indentation or code; ngplc reads spaces only")
                    return false
                Cl.slash:
                    if self.peek(1) = 47:
                        while self.peek(0) ≠ 10 and self.peek(0) ≠ ⁻1:
                            self.pos ← self.pos + 1
                    elif self.peek(1) = 42:
                        if not self.skip_block_comment():
                            return false
                    else:
                        return true
                _:
                    return true
        false

    // Past a /* … */, answering false where the file ends inside one.
    // A line inside it is a line, so the count follows it.
    fn skip_block_comment(&mut self) → bool:
        self.adv(2)
        while true:
            let d : i32 = self.peek(0)
            if d = ⁻1:
                self.err("unterminated block comment")
                return false
            if d = 42 and self.peek(1) = 47:
                self.adv(2)
                return true
            if d = 10:
                self.pos ← self.pos + 1
                self.line ← self.line + 1
                self.col ← 1¤"col"
            else:
                // any byte, including inside a multi-byte character;
                // the column counts lead bytes only
                self.pos ← self.pos + 1
                self.col ← self.col + (if (d & 192) = 128: 0¤"col" else: 1¤"col")
        false

    fn handle_indent(&mut self):
        let width : i64 ¤"col" = self.col - 1
        let top : i64 ¤"col" = self.indents[#self.indents - 1]
        if width > top:
            self.indents.push(width)
            self.emit(tokens.Tk.indent, self.pos, 0, self.col, 0, 0)
        else:
            while width < self.indents[#self.indents - 1]:
                _ ← self.indents.pop() ?? 0¤"col"
                self.emit(tokens.Tk.dedent, self.pos, 0, self.col, 0, 0)
            if width ≠ self.indents[#self.indents - 1]:
                self.err("indentation does not match any enclosing block")

    // whether appending decimal digit d to the wrapped value v walks
    // past 2^64-1, v being read through the unsigned lens
    fn too_big_dec(&self, v : i64, d : i64) → bool:
        if v < 0:
            // already ≥ 2^63; ×10 always overflows
            return true
        let lim : i64 = 1844674407370955161
        v > lim or (v = lim and d > 5)

    fn read_number(&mut self):
        let spos : i64 = self.pos
        let scol : i64 ¤"col" = self.col
        let v : mut i64 = 0
        let big : mut i64 = 0
        if self.peek(0) = 48 and (self.peek(1) = 120 or self.peek(1) = 88):
            self.adv(2)
            if hex_val(self.peek(0)) = ⁻1:
                self.err("hexadecimal literal without digits")
                return
            // A u64 literal past i64 is meant to run negative: the
            // bit pattern is the value, and the sign is how the reader
            // below learns the literal is a big one.  This is the
            // wrapping the annotation is for.
            let digits : mut i64 = 0
            while hex_val(self.peek(0)) ≠ ⁻1:
                digits ← digits + 1
                if digits > 16:
                    self.err("integer literal does not fit u64, the widest core-1 has")
                    return
                v ← @wrap(v × 16 + hex_val(self.peek(0)))
                self.adv(1)
            if v < 0:
                big ← 1
        else:
            // …and the same for a decimal one
            while is_digit(self.peek(0)):
                let d : i32 = self.peek(0) - 48
                if self.too_big_dec(v, d):
                    self.err("integer literal does not fit u64, the widest core-1 has")
                    return
                v ← @wrap(v × 10 + d)
                self.adv(1)
            if v < 0:
                big ← 1
        let nb : i32 = self.peek(0)
        let st : mut i64 = ⁻1
        if nb ≠ ⁻1 and self.cls[nb × 1¤ptrdiff] = Cl.ident:
            // i8…i64, u8…u64: the suffix says the literal's type, and
            // it rides in the big field as big + 2 × the type's code
            // the suffix is a run of the source, read where it stands
            // once its end is known
            let spos9 : i64 = self.pos
            let sfxn : mut i64 = 0
            while self.peek(sfxn) ≠ ⁻1 and (self.cls[self.peek(sfxn) × 1¤ptrdiff] = Cl.ident or is_digit(self.peek(sfxn))):
                sfxn ← sfxn + 1
            self.adv(sfxn)
            let sfx : str = tokens.run_str(self.src, spos9, self.pos - spos9)
            st ← types.TYNAMES[sfx] ?? ⁻1
            if st = ⁻1 or not types.ty_is_int(st):
                self.err("'" ⧺ sfx ⧺ "' is not a width; a literal's suffix is i8…i64 or u8…u64")
                return
        if self.peek(0) = 194 and self.peek(1) = 164:
            // 1¤ptrdiff, 0¤byte: the literal states its measure, and
            // an unstated width settles on i64.  The lexer runs before
            // any 'unit' line is read, so it settles the measures the
            // language ships with and hands anything else back: the ¤
            // and the name are left to lex as themselves, and the
            // parser -- which by then knows what the file declared --
            // puts them on the literal.
            // where to fall back to, if the measure is not one the
            // lexer settles; the scan position is a plain count for now
            let upos : i64 = self.pos
            let ucol : i64 ¤"col" = self.col
            self.adv(2)
            let upos9 : i64 = self.pos
            let usfxn : mut i64 = 0
            while self.peek(usfxn) ≠ ⁻1 and self.cls[self.peek(usfxn) × 1¤ptrdiff] = Cl.ident:
                usfxn ← usfxn + 1
            self.adv(usfxn)
            let usfx : str = tokens.run_str(self.src, upos9, self.pos - upos9)
            let names := types.unit_names()
            let u : mut i64 = ⁻1
            foreach i := 1…#names:
                if names[i] = usfx:
                    u ← @dropunit(i)
            if u = ⁻1:
                self.pos ← upos
                self.col ← ucol
            else:
                st ← types.ty_with_unit(if st ≠ ⁻1: st else: types.TY_I64, u)
        if st ≠ ⁻1:
            self.emit(tokens.Tk.number, spos, self.pos - spos, scol, v, big + st × 2)
            return
        self.emit(tokens.Tk.number, spos, self.pos - spos, scol, v, big)

    // 'a', 'λ', '\n', '\u{1F389}': one character between apostrophes.
    // The token is a Tk.number whose big field carries 2 × TY_CHAR, the
    // same closed-type ride a width suffix takes.
    fn read_char(&mut self):
        let spos : i64 = self.pos
        let scol : i64 ¤"col" = self.col
        self.adv(1)
        let b : i32 = self.peek(0)
        let code : mut i32 = 0
        if b = ⁻1 or b = 10:
            self.err("a character literal ends on the line it starts")
            return
        if b = 39:
            self.err("""a character literal holds one character, and this one holds none; a string
                      " of no characters is written \"\"""")
            return
        if b = 92:
            let e : i32 = self.peek(1)
            if e = 117:
                self.adv(2)
                if self.peek(0) ≠ 123:
                    self.err("\\u opens its number with '{'")
                    return
                self.adv(1)
                let digits : mut i64 = 0
                while hex_val(self.peek(0)) ≠ ⁻1:
                    code ← code × 16 + hex_val(self.peek(0))
                    digits ← digits + 1
                    if digits > 6:
                        self.err("a code point has at most six hex digits")
                        return
                    self.adv(1)
                if digits = 0 or self.peek(0) ≠ 125:
                    self.err("\\u{…} holds hex digits up to '}'")
                    return
                self.adv(1)
            else:
                if e = 110: code ← 10
                elif e = 116: code ← 9
                elif e = 114: code ← 13
                elif e = 92: code ← 92
                elif e = 39: code ← 39
                elif e = 34: code ← 34
                else:
                    self.err("unknown escape in character literal")
                    return
                self.adv(2)
        elif b < 128:
            code ← b
            self.adv(1)
        else:
            // one UTF-8 character, sized by its lead byte
            let extra : mut i64 = 0
            if b >= 240:
                code ← b & 7
                extra ← 3
            elif b >= 224:
                code ← b & 15
                extra ← 2
            elif b >= 194:
                code ← b & 31
                extra ← 1
            else:
                self.err("this byte begins no character")
                return
            self.adv(1)
            while extra > 0:
                let cb : i64 = self.peek(0)
                if cb < 128 or cb >= 192:
                    self.err("the character's encoding breaks off")
                    return
                code ← code × 64 + (cb & 63)
                self.adv(1)
                extra ← extra - 1
        if self.peek(0) ≠ 39:
            self.err("""a character literal holds one character; ' closes it, and a string is
                      " written with double quotes""")
            return
        self.adv(1)
        if code > 1114111:
            self.err("character literal: " ⧺ tokens.i64_str(code) ⧺ " is past the last code point, 0x10FFFF")
            return
        if code >= 55296 and code <= 57343:
            self.err("character literal: " ⧺ tokens.i64_str(code) ⧺ """ is a surrogate, which encodes half
                    " of a character in UTF-16 rather than being one""")
            return
        self.emit(tokens.Tk.number, spos, self.pos - spos, scol, code, types.TY_CHAR × 2)

    // Three quotes open a string that may run over several lines.
    // Every line after the first begins with a quote, which may be
    // indented as the code around it is, and neither that quote nor
    // the whitespace before it nor the line break itself is part of
    // what the string holds: the pieces are joined as they were
    // written, and a break inside the text is written \n as it is in
    // any other string.  It ends at the next three quotes, so a single
    // quote stands for itself inside one and needs no escape.
    fn read_string(&mut self):
        let spos : i64 = self.pos
        let scol : i64 ¤"col" = self.col
        let sline : i64 ¤"line" = self.line
        self.adv(1)
        let multi : bool = self.peek(0) = 34 and self.peek(1) = 34
        if multi:
            self.adv(2)
        let s : mut str = ""
        while true:
            let b : i32 = self.peek(0)
            if multi and b = 34 and self.peek(1) = 34 and self.peek(2) = 34:
                self.advg(3)
                break
            if b = ⁻1:
                self.err("string literal does not end before the file does")
                return
            if b = 10 and multi:
                self.pos ← self.pos + 1
                self.line ← self.line + 1¤"line"
                self.col ← 1¤"col"
                let lead : mut i64 = 0
                while self.peek(lead) = 32 or self.peek(lead) = 9:
                    lead ← lead + 1
                self.adv(lead)
                if self.peek(0) = 34 and self.peek(1) = 34 and self.peek(2) = 34:
                    self.advg(3)
                    break
                if self.peek(0) ≠ 34:
                    self.err("""a line continuing a multi-line string begins with a quote, and what
                              " stands before that quote is not part of the string""")
                    return
                self.adv(1)
                continue
            if b = 10:
                self.err("string literal does not end before the line does")
                return
            if b = 34 and not multi:
                self.adv(1)
                break
            if b = 92:
                let e : i32 = self.peek(1)
                if e = 110: s ← s ⧺ (10).chr()
                elif e = 116: s ← s ⧺ (9).chr()
                elif e = 114: s ← s ⧺ (13).chr()
                elif e = 92: s ← s ⧺ (92).chr()
                elif e = 34: s ← s ⧺ (34).chr()
                else:
                    self.err("unknown escape in string literal")
                    return
                self.adv(2)
            else:
                s ← s ⧺ b.chr()
                self.pos ← self.pos + 1
                self.col ← self.col + (if (b & 192) = 128: 0¤"col" else: 1¤"col")
        let idx : i64 = @dropunit(#self.strs)
        self.strs.push(s)
        // one that ran over several lines is still written where it
        // began, which is where anything said about it should point
        let eline : i64 ¤"line" = self.line
        self.line ← sline
        self.emit(tokens.Tk.string, spos, self.pos - spos, scol, idx, 0)
        self.line ← eline

    fn read_ident(&mut self):
        let spos : i64 = self.pos
        let scol : i64 ¤"col" = self.col
        while true:
            let b : i32 = self.peek(0)
            if b = ⁻1: break
            let c : Cl = self.cls[b × 1¤ptrdiff]
            if c ≠ Cl.ident and c ≠ Cl.digit: break
            self.adv(1)
        if self.peek(0) = 39:
            // F', T': the prime rides the name; it spells a type variable
            self.adv(1)
        let text := tokens.run_str(self.src, spos, self.pos - spos)
        self.emit(tokens.KEYWORDS[text] ?? tokens.Tk.ident, spos, self.pos - spos, scol, 0, 0)

    // the two-character ASCII operators, reached through their class
    fn read_op2(&mut self, c : Cl):
        let spos : i64 = self.pos
        let scol : i64 ¤"col" = self.col
        let b1 : i32 = self.peek(1)
        let k : mut tokens.Tk = tokens.Tk.none
        let w : mut i64 = 1
        match c:
            Cl.colon:
                k ← tokens.Tk.colon
                if b1 = 61:
                    k ← tokens.Tk.define
                    w ← 2
            Cl.lt:
                k ← tokens.Tk.lt
                if b1 = 61:
                    k ← tokens.Tk.le
                    w ← 2
                elif b1 = 60:
                    k ← tokens.Tk.shl
                    w ← 2
                elif b1 = 45:
                    k ← tokens.Tk.assign
                    w ← 2
            Cl.gt:
                k ← tokens.Tk.gt
                if b1 = 61:
                    k ← tokens.Tk.ge
                    w ← 2
                elif b1 = 62:
                    k ← tokens.Tk.shr
                    w ← 2
            Cl.dash:
                k ← tokens.Tk.minus
                if b1 = 62:
                    k ← tokens.Tk.arrow
                    w ← 2
            _:
                k ← tokens.Tk.qmark
                if b1 = 63:
                    k ← tokens.Tk.coalesce
                    w ← 2
        self.adv(w)
        self.emit(k, spos, w, scol, 0, 0)

    fn read_glyph(&mut self, c : Cl):
        let spos : i64 = self.pos
        let scol : i64 ¤"col" = self.col
        if c = Cl.mb2:
            let key : i32 = self.peek(0) × 256 + self.peek(1)
            let k : tokens.Tk = tokens.GLYPHS2[key] ?? tokens.Tk.none
            if k = tokens.Tk.none:
                self.err("this character begins nothing core-1 knows")
                return
            self.advg(2)
            self.emit(k, spos, 2, scol, 0, 0)
        else:
            let key : i32 = self.peek(0) × 65536 + self.peek(1) × 256 + self.peek(2)
            let k : tokens.Tk = tokens.GLYPHS3[key] ?? tokens.Tk.none
            if k = tokens.Tk.none:
                self.err("this character begins nothing core-1 knows")
                return
            if k = tokens.Tk.lhash:
                self.parens ← self.parens + 1
            if k = tokens.Tk.rhash and self.parens > 0:
                self.parens ← self.parens - 1
            self.advg(3)
            self.emit(k, spos, 3, scol, 0, 0)

@export
fn lex(src : byte[]) → Toks:
    let lx : mut Lexer = (Lexer{src: src, n: @dropunit(#src), cls: mkcls(), punct: mkpunct(),
                                pos: 0, line: 1, col: 1, parens: 0,
                                kind: [], off: [], len: [], tline: [],
                                tcol: [], val: [], big: [], strs: [],
                                indents: [0¤"col"], diags: []})
    let at_line_start : mut bool = true
    while lx.pos < lx.n and #lx.diags = 0:
        let more : bool = lx.skip_gaps()
        if not more:
            if lx.peek(0) = 10:
                if lx.parens = 0 and not at_line_start:
                    lx.emit(tokens.Tk.nl, lx.pos, 1, lx.col, 0, 0)
                lx.pos ← lx.pos + 1
                lx.line ← lx.line + 1
                lx.col ← 1
                if lx.parens = 0:
                    at_line_start ← true
            continue
        if at_line_start:
            lx.handle_indent()
            at_line_start ← false
            if #lx.diags > 0:
                break
        // The byte is what the two tables are indexed by, so it is
        // measured as an index: every use of it below is one.
        let b : i64 ¤ptrdiff = lx.peek(0) × 1¤ptrdiff
        let c : Cl = lx.cls[b]
        // One arm per class, which is what the table was built to
        // allow: the class is read once and the arm is reached without
        // walking a ladder of comparisons.
        match c:
            Cl.punct:
                let k : tokens.Tk = lx.punct[b]
                if k = tokens.Tk.lpar or k = tokens.Tk.lbrack or k = tokens.Tk.lbrace:
                    lx.parens ← lx.parens + 1
                if (k = tokens.Tk.rpar or k = tokens.Tk.rbrack or k = tokens.Tk.rbrace) and lx.parens > 0:
                    lx.parens ← lx.parens - 1
                lx.emit(k, lx.pos, 1, lx.col, 0, 0)
                lx.adv(1)
            Cl.digit:
                lx.read_number()
            Cl.ident:
                lx.read_ident()
            Cl.quote:
                lx.read_string()
            Cl.apos:
                lx.read_char()
            Cl.mb2, Cl.mb3:
                lx.read_glyph(c)
            Cl.colon, Cl.lt, Cl.gt, Cl.dash, Cl.qmark:
                lx.read_op2(c)
            Cl.slash:
                lx.err("'/' is not an operator; division is written ÷")
            _:
                lx.err("this byte begins nothing core-1 knows")
    if not at_line_start and #lx.diags = 0:
        lx.emit(tokens.Tk.nl, lx.n, 0, lx.col, 0, 0)
    while #lx.indents > 1:
        _ ← lx.indents.pop() ?? 0¤"col"
        lx.emit(tokens.Tk.dedent, lx.n, 0, 1, 0, 0)
    lx.emit(tokens.Tk.eof, lx.n, 0, 1, 0, 0)
    // the token columns are parallel arrays; leaving out of step here
    // would surface as nonsense positions far away
    assert(#lx.kind = #lx.off and #lx.kind = #lx.len, "token arrays in step")
    assert(#lx.kind = #lx.tline and #lx.kind = #lx.val and #lx.kind = #lx.big,
           "token arrays in step")
    (Toks{kind: lx.kind, off: lx.off, len: lx.len, line: lx.tline,
          col: lx.tcol, val: lx.val, big: lx.big, strs: lx.strs,
          diags: lx.diags})
