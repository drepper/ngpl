// ===========================================================================
// The AST: flat parallel arrays indexed by node id
// ===========================================================================

// expressions

@import("./diag.ngpl")

let NK_INT : i64 = 1        // na = value (wrapped), nb = big flag
let NK_BOOL : i64 = 2       // na = 0 or 1
let NK_STR : i64 = 3        // na = string table index
let NK_VAR : i64 = 4        // name is the token
let NK_ARRLIT : i64 = 5     // na = extra [count, elem…]
let NK_INDEX : i64 = 6      // na = base, nb = index
let NK_LEN : i64 = 7        // na = base (# of an array or a string)
let NK_CALL : i64 = 10      // na = extra [argc, arg…]; callee token
let NK_SCALL : i64 = 11     // na = builtin id, nb = extra [argc, arg…]
let NK_MCALL : i64 = 12     // na = base, nb = extra [argc, arg…]; method token
let NK_REF : i64 = 13       // na = inner, nb = 1 shared or 2 mut
let NK_SLIT : i64 = 14      // na = extra [n, field-token, expr, …]; name token
let NK_FIELD : i64 = 15     // na = base; field token
let NK_SOME : i64 = 16      // na = the value ⊨ carries
let NK_EMPTYV : i64 = 17    // a bare ∅
let NK_HLIT : i64 = 18      // na = extra [n, key, value, …]
let NK_TUPLE : i64 = 19     // na = extra [n, expr…]
let NK_DROPU : i64 = 45     // @dropunit: na = the measured value
let NK_IOTA : i64 = 46      // container ⍳ wanted: where it sits, if anywhere
let NK_SATADD : i64 = 47    // ⊞: the sum, held at the type's edge
let NK_SATSUB : i64 = 48    // ⊟
let NK_SATMUL : i64 = 49    // ⊠
let NK_LXOR : i64 = 53      // ⊕, both sides read
let NK_LNAND : i64 = 54     // ⊼
let NK_LNOR : i64 = 58      // ⊽
let NK_SLICE : i64 = 59     // v[a…b]: na = base, nb = lo, nc = hi
let NK_RESHAPE : i64 = 60   // n ⍴ x: na = the count, nb = the filler
let NK_WHILEB : i64 = 61    // while x := e: na = e, nb = body; name token
let NK_TYPEOF : i64 = 62    // @typeof(e): folds to the type's spelling
let NK_ELEMOF : i64 = 43    // key ∊ dictionary
let NK_ADD : i64 = 20
let NK_SUB : i64 = 21
let NK_MUL : i64 = 22
let NK_DIV : i64 = 23
let NK_MOD : i64 = 24
let NK_SHL : i64 = 25
let NK_SHR : i64 = 26
let NK_BAND : i64 = 27
let NK_BOR : i64 = 28
let NK_BXOR : i64 = 29
let NK_EQ : i64 = 30
let NK_NE : i64 = 31
let NK_LT : i64 = 32
let NK_LE : i64 = 33
let NK_GT : i64 = 34
let NK_GE : i64 = 35
let NK_AND : i64 = 36       // short-circuit
let NK_OR : i64 = 37        // short-circuit
let NK_LAND : i64 = 38      // ∧, both sides read
let NK_LOR : i64 = 39       // ∨
let NK_MAXOP : i64 = 40     // ⌈
let NK_MINOP : i64 = 41     // ⌊
let NK_CCAT : i64 = 42      // ⧺ on strings
let NK_NEG : i64 = 50       // ⁻
let NK_NOT : i64 = 51       // not, ¬
let NK_BNOT : i64 = 52      // ~
// 55 was NK_COND, `a if c else b`, which was withdrawn.  @old took the
// number rather than another gap being opened: na = the expression,
// nb = which @old of this function's postconditions it is.
let NK_OLD : i64 = 55
// A field named inside an @invariant.  The condition is written once
// and read wherever one of the type is made or changed, so its field
// references cannot be slots of any one frame: na is the field's
// index, and what it is read out of is whatever the site has to hand.
let NK_IFIELD : i64 = 98
let NK_WRAP : i64 = 56      // na = inner
let NK_DEFAULT : i64 = 57   // na = the result-shaped thing, nb = default
// statements
let NK_LET : i64 = 70       // na = init, nb = 1 when mut, nc = type; name token
let NK_ASSIGN : i64 = 71    // na = value; target name token
let NK_DISCARD : i64 = 72   // na = value
let NK_IF : i64 = 73        // na = cond, nb = then block, nc = else block or ⁻1
let NK_WHILE : i64 = 74     // na = cond, nb = body
let NK_FOREACH : i64 = 75   // na = extra [lo, step or ⁻1, hi], nb = body; var token
let NK_FOREACHA : i64 = 76  // na = array expr, nb = body; var token
let NK_RETURN : i64 = 77    // na = value or ⁻1
let NK_BREAK : i64 = 78
let NK_CONTINUE : i64 = 79
let NK_EXPRSTMT : i64 = 80  // na = expr
let NK_BLOCK : i64 = 81     // na = extra [count, stmt…]
let NK_STOREFLD : i64 = 83  // na = base var, nb = value; field token
let NK_MATCH : i64 = 84     // na = subject, nb = extra [some-block, empty-block]; bind token
let NK_LETT : i64 = 85      // let (a, b) …: na = init, nb = 1 when mut, nc = extra [n, type or ⁻1, name-token…]
let NK_STOREIDXP : i64 = 86 // path[i] ← v: na = base expr, nb = index, nc = value
let NK_RANGEV : i64 = 87    // a…b and a…step…b as a value: na = lo, nb = hi, nc = step or ⁻1
let NK_LAMBDA : i64 = 88    // λ literal: na = extra [np, (tok,ty)…, ncap, tok…, ret], nb = body, nc = lambda index
let NK_FNVAL : i64 = 89     // a named function as a value: na = fn index
let NK_CALLV : i64 = 90     // applying a value: na = callee expr, nb = args
let NK_EXPECTS : i64 = 93   // @expect over one statement: na = it, nb = 1 when an error is expected
let NK_HINTED : i64 = 94    // @likely/@unlikely over an if: na = it, nb = 1 when unlikely
let NK_SIZEOF : i64 = 96    // @sizeof(T) or @sizeof(e): folds to a count of bytes
// match over an enumeration: na = subject, nb = extra
//   [n, default block or ⁻1, then n × (enum token, member token, block)]
// and nc = which enum, settled by the checker
let NK_MATCHE : i64 = 97
// f ∀ v and f ∃ v: na = what asks, nb = what is asked about, nc = 1
// for ∃ and 0 for ∀
let NK_QUANT : i64 = 99
// a ⊑ b and a ⊒ b: na = the shorter run, nb = the one it is laid
// against, nc = 1 for the back and 0 for the front
let NK_RUN : i64 = 100
let NK_MSLICE : i64 = 95    // m[rows, cols]: na = matrix, nb = extra [rlo, rhi, clo, chi], nc = 1 for a column
let NK_TRY : i64 = 91       // e?: ∅ answers the function early, a value unwraps
let NK_BADLAM : i64 = 92    // a λ the checker refuses: na says why

// std builtins reachable from core-1
let SB_PRINTLN : i64 = 1
let SB_PRINT : i64 = 2
let SB_EXIT : i64 = 3
let SB_ARGS : i64 = 4       // std.args.all() → str[]
let SB_OPEN : i64 = 5       // std.fs.cwd().open_file(p) → File?
let SB_CREATE : i64 = 6     // std.fs.cwd().create_file(p, mode) → File
let SB_ALLOCATOR : i64 = 7  // std.arena.allocator()
let SB_BYTES : i64 = 8      // std.bytes(s) → the string's bytes, u8[]
let SB_CWD : i64 = 9        // std.fs.cwd() as a value
let SB_ENVN : i64 = 10      // std.env.names() → str[]
let SB_ENVG : i64 = 11      // std.env.get(name) → str?
let SB_ENVH : i64 = 12      // std.env.has(name) → bool
let SB_IOV : i64 = 14       // std.iov(x) → the bytes of x, ready to be written
let SB_PROC : i64 = 13      // std.process.<member>: nb names which

// A struct literal writes a name and its fields; one of them names no
// struct the program declares but the one the build system defines,
// std.Build.Executable, and this in nb is how the node says so.
let SLIT_PLAIN : i64 = 0
let SLIT_EXE : i64 = 1      // std.Build.Executable{…}

// What a recipe may say to the std.Build it is handed.  These are
// member functions and data members of a value rather than names under
// std, so they are dispatched where the receiver is known -- at
// evaluation -- and are numbered only to be named in a diagnostic.
let BM_ADDEXE : i64 = 1     // b.add_executable(cfg)
let BM_PATH : i64 = 2       // b.search_path(p)
let BM_FLAG : i64 = 3       // b.flag(f)
let BM_HOST : i64 = 4       // b.host_target
let BM_OUTDIR : i64 = 5     // b.output_dir

fn build_member(name : str) → i64:
    if name = "add_executable": return BM_ADDEXE
    if name = "search_path": return BM_PATH
    if name = "flag": return BM_FLAG
    if name = "host_target": return BM_HOST
    if name = "output_dir": return BM_OUTDIR
    ⁻1

// What a recipe may read of the command line.  These are data members
// of the std.Options it is handed, one per option whose value a recipe
// could want; an option added later adds a member here and changes no
// recipe's signature, which is the reason the options arrive as one
// thing rather than as a parameter each.
let OM_OUTPUT : i64 = 1     // o.output: what -o named, ∅ where it was not given
let OM_TARGET : i64 = 2     // o.target: what --target named, ∅ likewise
let OM_OPTIMIZE : i64 = 3   // o.optimize: the level -O asked for, ∅ likewise

fn option_member(name : str) → i64:
    if name = "output": return OM_OUTPUT
    if name = "target": return OM_TARGET
    if name = "optimize": return OM_OPTIMIZE
    ⁻1

// what a std.Options holds, for the diagnostic that says it does not
fn option_members() → str:
    """output is what -o named, target what --target named and optimize the level -O asked
     " for, each ∅ where the command line said nothing"""

// what a std.Build offers, for the diagnostic that says it does not
fn build_members() → str:
    """add_executable() declares an output; search_path() and flag() say where a source is
     " looked for and what the compiler is asked for; host_target and output_dir are what it
     " holds"""

// std.hash.<alg>.<member>: which algorithm is in nc, so an algorithm
// added later adds an entry to the table below and nothing else.
let SB_HDIGEST : i64 = 25   // std.hash.<alg>.digest(x) → the digest of x, a u8[]
let SB_HSTART : i64 = 26    // std.hash.<alg>.start() → a handle to feed

// the algorithms, in the order hash_algs() names them
let HALG_SHA256 : i64 = 0

fn hash_algs() → str[]:
    ["sha256"]

// How many bytes each answers.  The width is part of what digest()
// hands back -- a u8[32], not a u8[] -- so it has to be known while
// the program is being read, not while it runs.
fn hash_digest_bytes() → i64[]:
    [32]

// the same names as a diagnostic says them
@post(r: #r > 0)
fn hash_algs_named() → str:
    let algs := hash_algs()
    let out : mut str = ""
    foreach k := 0…#algs:
        out ← out ⧺ (if k = 0: "" else: ", ") ⧺ algs[k]
    out

// what the auxiliary vector is asked for, and under which key
let PROC_PAGESIZE : i64 = 0
let PROC_UID : i64 = 1
let PROC_EUID : i64 = 2
let PROC_GID : i64 = 3
let PROC_EGID : i64 = 4
let PROC_SECURE : i64 = 5
let PROC_EXECFN : i64 = 6

@pre(m >= 0 and m <= 6)
fn proc_key(m : i64) → i64:
    if m = PROC_PAGESIZE: return 6
    if m = PROC_UID: return 11
    if m = PROC_EUID: return 12
    if m = PROC_GID: return 13
    if m = PROC_EGID: return 14
    if m = PROC_SECURE: return 23
    31

// the base type names, one probe instead of a ladder
let TYNAMES : std.dict(str, i64) = (⸨
    "i8": 17, "i16": 19, "i32": 21, "i64": 23,
    "u8": 16, "u16": 18, "u32": 20, "u64": 22,
    "bool": 2, "str": 3, "char": 4, "byte": 16,
    "int": 11⸩)

// Where something sits in the extra table, and how many slots it takes
// up there.  The table is one flat array of plain numbers -- a count
// and then whatever that count describes -- so a place in it is nothing
// a node id or a token index is, and saying so is what keeps the three
// apart.  It stands in for a ptrdiff because that is what subscripts
// the table.
unit aextra → ptrdiff

struct FnDef:
    name : str
    modname : str        // the module it was written in, "" for the global one
    tok : i64
    params_off : i64 ¤"aextra"     // extra: [n, name-token, type, …]
    ret : i64
    body : i64
    is_export : bool     // its symbol is one others may link against
    is_replaceable : bool
    is_impure : bool
    is_start : bool
    is_noreturn : bool
    is_ignorable : bool  // a caller may drop what it hands back
    is_test : bool
    is_listable : bool   // handed a container where it asked for one of the
                         // things in it, it is asked of each of them
    olds_off : i64 ¤"aextra"       // extra: [n, @old node…] or ⁻1.  Read before a
                         // statement of the body runs, so a postcondition
                         // may say what a parameter was rather than what
                         // it has become.
    pre_off : i64 ¤"aextra"        // extra: [n, expr…] or ⁻1
    post_off : i64 ¤"aextra"       // extra: [n, name-token, expr, …] or ⁻1
    // A function may answer a borrow: 1 where the answer is a & of
    // something it was lent, 2 a &mut, 0 where it answers a value.
    // ret_from is then extra: [n, parameter index…] -- the origins,
    // the parameters the answer reaches into -- and ⁻1 otherwise.
    ret_ref : i64
    ret_from : i64 ¤"aextra"
    // Which tokens the definition is written in, from its first
    // annotation to the last token of its body.  The bill of materials
    // hashes these: what a function is, rather than how it was typed.
    tok_lo : i64
    tok_hi : i64

struct SDef:
    name : str
    tok : i64
    fields_off : i64 ¤"aextra"     // extra: [n, field-token, type, …]
    is_repr_c : bool     // @repr(C): the fields sit where C would put them
    inv_off : i64 ¤"aextra"        // extra: [n, condition…] or ⁻1.  What is always
                         // true of one of these: asked wherever one is
                         // made and wherever a field of one is written.

struct GlobalDef:
    name : str
    modname : str        // the module it was written in, "" for the global one
    tok : i64
    ty : i64
    is_mut : bool
    init : i64

struct Ast:
    // the let nodes written `let v : &T = …`, which bind a borrow
    blets : i64[]
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    strs : str[]
    fns : FnDef[]
    mods : str[]         // the modules this file declares, whole names
    modtok : i64[]       // … and where each was written
    qmods : str[]        // the module each qualified call names
    builds : FnDef[]     // the @build recipe, read while the program is
                         // built and never written into the image
    globals : GlobalDef[]
    structs : SDef[]
    tts : i64[]          // tuple shapes: start into tte per shape
    ttl : i64[]          // … how many elements
    tte : i64[]          // … the element types, flattened
    fae : i64[]          // sized arrays: the element type per shape
    fas : i64[]          // … and the size
    hdty : i64[]         // the type digest() answers, per hash algorithm
    mel : i64[]          // matrices: the element type per shape
    mrr : i64[]          // … the first extent, ⁻1 where the type leaves it open
    mcc : i64[]          // … the second, likewise
    mdd : i64[]          // … the third, or ⁻2 where the shape has only two
    minner : i64[]       // … and the type one subscript answers: a row for a
                         //   matrix, a matrix for a cube
    lts : i64[]          // lambda signatures: start into lte per shape
    ltl : i64[]          // … how many parameters
    lte : i64[]          // … the parameter types then the answer, flattened
    ltf : i64[]          // … 1 where the lambda threads, 0 where it does not.
                         // Part of the shape rather than beside it: a lambda
                         // that threads and one that does not behave
                         // differently at every call, so they are not one type.
    unames : str[]       // the measures the file knows
    umarks : str[]       // … and how each one prints
    udecay : i64[]       // … and what each may stand in for, 0 for nothing
    enames : str[]       // enums: the name of each
    ewidth : i64[]       // … the integer type its values are held in
    estart : i64[]       // … where its enumerators begin in emembers
    ecount : i64[]       // … how many it has
    eflag : i64[]        // … and 1 where @flag makes it a bit set
    emembers : str[]     // … their names, flattened
    evalues : i64[]      // … and what each one stands for
    ignored : str[]      // names @expect left uncompiled
    igtests : str[]      // the @test names among them, in source order
    // Definitions marked @expect: no code is written for them, and the
    // checker draws what they draw so the @expect lines can be held to.
    // expoff points at [n, level, code, …] in extra, or ⁻1 where the
    // definition named no number.
    expects : FnDef[]
    expoff : i64[]
    diags : Diag[]

