// ---------------------------------------------------------------------------
// Putting the pieces together
// ---------------------------------------------------------------------------

let abi := @import("abi")
let arch_x86_64 := @import("arch_x86_64")
let ast := @import("ast")
let check := @import("check")
let codegen_t := @import("codegen_t")
let diag := @import("diag")
let elf := @import("elf")
let emit := @import("emit")
let incr_m := @import("incr")
let ir_m := @import("ir")
let lex := @import("lex")
let lower := @import("lower")
let names := @import("names")
let machine := @import("machine")
let rt_backtrace := @import("rt_backtrace")
let rt_x86_64 := @import("rt_x86_64")
let symbols := @import("symbols")
let tokens := @import("tokens")
let types := @import("types")

// what codegen answers: the three images and what the file writer
// needs to wrap them.  The ELF itself is built in main, where the
// target's class picks the materializer.


@export
struct Compiled:
    // Under --incremental against a file: "" when every function
    // landed where that file had it and inside the room it was given,
    // and otherwise what stopped one, which the driver prints before
    // compiling whole.
    incr_why : str
    // Where .rodata stops being the strings' own bytes and becomes
    // their descriptors and the tables: from here on a build that
    // lines up with a previous one has to match it byte for byte,
    // while the bytes before are what the strings say, which a message
    // naming a line the source moved is allowed to change.
    ro_fixed : i64 ¤byte
    // and where the globals that are never written sit inside it,
    // which is values again: a constant's value may change where the
    // constant has not moved
    ro_vals : i64 ¤byte
    ro_vals_end : i64 ¤byte
    // and where the table a backtrace reads sits, which says where
    // every function begins and how far it runs: layout written down
    // as data, so it says something else whenever a function has
    // moved, at addresses nothing points into
    ro_bt : i64 ¤byte
    ro_bt_end : i64 ¤byte
    // What this build gave the text region and the read-only data, on
    // which it patched every address it wrote into an instruction.
    // The ELF plan is told rather than asked to work it out again: the
    // two have to agree to the byte, and the way to make sure of that
    // is to have one of them decide.
    text_room : i64 ¤byte
    ro_room : i64 ¤byte
    // Where each section of the text region ends: .text first, then
    // one for each build that had to move a function out of it.  They
    // are one mapping and one buffer; the boundaries are what the
    // section headers say about it.
    tx_ends : i64[]
    code : u8[]
    rodata : u8[]
    data : u8[]
    relro_size : i64
    syms : elf.Sym[]
    log : str[]
    diags : diag.Diag[]

// a synthesized function starts from a clean sheet
fn lw_reset(lw : &mut lower.Lower, fname : str):
    // fresh columns: what the last function left is its own now
    lw.op ← []
    lw.ia ← []
    lw.ib ← []
    lw.ic ← []
    lw.idd ← []
    lw.iww ← []
    lw.extra ← []
    lw.nlabels ← 0
    lw.tbase ← 0
    lw.tnext ← 0
    lw.tmax ← 0
    lw.in_wrap ← 0
    lw.cur_ret ← types.TY_UNIT
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← fname

// …and leaves its instructions behind as an IrFn
fn lw_snapshot(lw : lower.Lower) → ir_m.IrFn:
    // the columns, cut whole: a slice is one operation where a loop
    // over the elements is one per instruction lowered
    let opc : ir_m.Ir[] = lw.op[0¤ptrdiff…#lw.op]
    let iac : i64[] = lw.ia[0¤ptrdiff…#lw.ia]
    let ibc : i64[] = lw.ib[0¤ptrdiff…#lw.ib]
    let icc : i64[] = lw.ic[0¤ptrdiff…#lw.ic]
    let idc : i64[] = lw.idd[0¤ptrdiff…#lw.idd]
    let iwc : i64[] = lw.iww[0¤ptrdiff…#lw.iww]
    let exc : i64[] = lw.extra[0¤ptrdiff…#lw.extra]
    ir_m.IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
         extra: exc, nvregs: lw.tmax, nlabels: lw.nlabels, fbytes: lw.fbytes}

// std.args.all()'s answer: the kernel's arguments with the test
// harness's own options taken out, as the interpreter takes out its
// own before a program reads them
@export
fn lower_argsfilter(lw : &mut lower.Lower) → ir_m.IrFn:
    lw_reset(&lw, "the argument filter")
    let raw : i64 = lw.tmp()
    lw.ir(ir_m.Ir.args, 0, 0, 0, raw, 0)
    let out : i64 = lw.tmp()
    lw.ir(ir_m.Ir.anew, 4, 0, 0, out, 0)
    let n : i64 = lw.tmp()
    lw.ir(ir_m.Ir.alen, raw, 0, 0, n, 0)
    let i : i64 = lw.tmp()
    lw.ir(ir_m.Ir.const, 0, 0, 0, i, 0)
    let t1 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.sc, lw.intern("--test"), 0, 0, t1, 0)
    let t2 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.sc, lw.intern("--skip-tests"), 0, 0, t2, 0)
    let ltop : i64 = lw.label()
    let lskip : i64 = lw.label()
    let lend : i64 = lw.label()
    lw.ir(ir_m.Ir.label, ltop, 0, 0, 0, 0)
    let c : i64 = lw.tmp()
    lw.ir(ir_m.Ir.clt, i, n, 0, c, 64 + 256)
    lw.ir(ir_m.Ir.jz, c, lend, 0, 0, 0)
    let sv : i64 = lw.tmp()
    lw.ir(ir_m.Ir.aidx, raw, i, 0, sv, 0)
    let e1 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.seqv, sv, t1, 0, e1, 64)
    lw.ir(ir_m.Ir.jnz, e1, lskip, 0, 0, 0)
    let e2 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.seqv, sv, t2, 0, e2, 64)
    lw.ir(ir_m.Ir.jnz, e2, lskip, 0, 0, 0)
    lw.ir(ir_m.Ir.apush, out, sv, 0, 0, 0)
    lw.ir(ir_m.Ir.label, lskip, 0, 0, 0, 0)
    let one : i64 = lw.tmp()
    lw.ir(ir_m.Ir.const, 1, 0, 0, one, 0)
    let ni : i64 = lw.tmp()
    lw.ir(ir_m.Ir.addw, i, one, 0, ni, 64 + 256)
    lw.ir(ir_m.Ir.mov, ni, 0, 0, i, 0)
    lw.ir(ir_m.Ir.jmp, ltop, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.label, lend, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.ret, out, 0, 0, 0, 0)
    lw_snapshot(lw)

// the test driver the image runs between the globals and @start: the
// harness options are read, and the @test functions run -- silently
// before @start, or reported and counted under --test, on the error
// stream as the interpreter reports them
@export
fn lower_testdriver(lw : &mut lower.Lower, a : &ast.Ast) → ir_m.IrFn:
    lw_reset(&lw, "the test driver")
    let tests : mut i64[] = []
    foreach fi := 0…#a.fns:
        if a.fns[fi].is_test:
            tests.push(@dropunit(fi))
    let total : i64 = @dropunit(#tests) + @dropunit(#a.igtests)
    let argv : i64 = lw.tmp()
    lw.ir(ir_m.Ir.args, 0, 0, 0, argv, 0)
    let ton : i64 = lw.tmp()
    lw.ir(ir_m.Ir.const, 0, 0, 0, ton, 0)
    let skp : i64 = lw.tmp()
    lw.ir(ir_m.Ir.const, 0, 0, 0, skp, 0)
    let n : i64 = lw.tmp()
    lw.ir(ir_m.Ir.alen, argv, 0, 0, n, 0)
    let i : i64 = lw.tmp()
    lw.ir(ir_m.Ir.const, 0, 0, 0, i, 0)
    let t1 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.sc, lw.intern("--test"), 0, 0, t1, 0)
    let t2 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.sc, lw.intern("--skip-tests"), 0, 0, t2, 0)
    let one : i64 = lw.tmp()
    lw.ir(ir_m.Ir.const, 1, 0, 0, one, 0)
    let ltop : i64 = lw.label()
    let lnext : i64 = lw.label()
    let l2 : i64 = lw.label()
    let lscanned : i64 = lw.label()
    let lrun : i64 = lw.label()
    let lend : i64 = lw.label()
    lw.ir(ir_m.Ir.label, ltop, 0, 0, 0, 0)
    let c : i64 = lw.tmp()
    lw.ir(ir_m.Ir.clt, i, n, 0, c, 64 + 256)
    lw.ir(ir_m.Ir.jz, c, lscanned, 0, 0, 0)
    let sv : i64 = lw.tmp()
    lw.ir(ir_m.Ir.aidx, argv, i, 0, sv, 0)
    let e1 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.seqv, sv, t1, 0, e1, 64)
    lw.ir(ir_m.Ir.jz, e1, l2, 0, 0, 0)
    lw.ir(ir_m.Ir.mov, one, 0, 0, ton, 0)
    lw.ir(ir_m.Ir.label, l2, 0, 0, 0, 0)
    let e2 : i64 = lw.tmp()
    lw.ir(ir_m.Ir.seqv, sv, t2, 0, e2, 64)
    lw.ir(ir_m.Ir.jz, e2, lnext, 0, 0, 0)
    lw.ir(ir_m.Ir.mov, one, 0, 0, skp, 0)
    lw.ir(ir_m.Ir.label, lnext, 0, 0, 0, 0)
    let ni : i64 = lw.tmp()
    lw.ir(ir_m.Ir.addw, i, one, 0, ni, 64 + 256)
    lw.ir(ir_m.Ir.mov, ni, 0, 0, i, 0)
    lw.ir(ir_m.Ir.jmp, ltop, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.label, lscanned, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.jz, ton, lrun, 0, 0, 0)
    // --test: report and count, then exit without @start
    if total = 0:
        lw.ir(ir_m.Ir.eprints, lw.intern("""error: no tests: nothing in this file is marked @test or
                                     " @expect\n"""), 0, 0, 0, 0)
        let z0 : i64 = lw.tmp()
        lw.ir(ir_m.Ir.const, 1, 0, 0, z0, 0)
        lw.ir(ir_m.Ir.exit, z0, 0, 0, 0, 0)
    else:
        foreach gname := a.igtests:
            lw.ir(ir_m.Ir.eprints, lw.intern("test " ⧺ gname ⧺ " ... ok\n"), 0, 0, 0, 0)
        lw.ir(ir_m.Ir.eprints, lw.intern("\nrunning " ⧺ tokens.i64_str(total) ⧺ " tests\n"), 0, 0, 0, 0)
        foreach fi2 := tests:
            lw.ir(ir_m.Ir.eprints, lw.intern("test " ⧺ a.fns[fi2 × 1¤ptrdiff].name ⧺ " ... "), 0, 0, 0, 0)
            let coff : i64 = @dropunit(#lw.extra)
            lw.extra.push(0)
            let d : i64 = lw.tmp()
            lw.ir(ir_m.Ir.call, fi2, coff, 0, d, 0)
            lw.ir(ir_m.Ir.eprints, lw.intern("ok\n"), 0, 0, 0, 0)
        lw.ir(ir_m.Ir.eprints, lw.intern("\ntest result: ok. " ⧺ tokens.i64_str(total) ⧺ " passed; 0 failed\n"), 0, 0, 0, 0)
        let z1 : i64 = lw.tmp()
        lw.ir(ir_m.Ir.const, 0, 0, 0, z1, 0)
        lw.ir(ir_m.Ir.exit, z1, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.label, lrun, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.jnz, skp, lend, 0, 0, 0)
    // the ordinary run: every test, silently, before @start
    foreach fi3 := tests:
        let coff2 : i64 = @dropunit(#lw.extra)
        lw.extra.push(0)
        let d2 : i64 = lw.tmp()
        lw.ir(ir_m.Ir.call, fi3, coff2, 0, d2, 0)
    lw.ir(ir_m.Ir.label, lend, 0, 0, 0, 0)
    lw.ir(ir_m.Ir.ret, ⁻1, 0, 0, 0, 0)
    lw_snapshot(lw)

// the init function the image runs before @start: every marked
// global's literal is built and stored where GLOAD reads it
@export
fn lower_ginit(lw : &mut lower.Lower, a : &ast.Ast, chk : &check.Chk) → ir_m.IrFn:
    // fresh columns: what the last function left is its own now
    lw.op ← []
    lw.ia ← []
    lw.ib ← []
    lw.ic ← []
    lw.idd ← []
    lw.iww ← []
    lw.extra ← []
    lw.nlabels ← 0
    lw.tbase ← 0
    lw.tnext ← 0
    lw.tmax ← 0
    lw.in_wrap ← 0
    lw.cur_ret ← types.TY_UNIT
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← "the global initializer"
    foreach g := chk.ginit:
        lw.tnext ← lw.tbase
        let v : i64 = lw.lower_expr(a.globals[g × 1¤ptrdiff].init)
        lw.ir(ir_m.Ir.gstore, g, v, 0, 0, 0)
    lw.ir(ir_m.Ir.ret, ⁻1, 0, 0, 0, 0)
    // the columns, cut whole: a slice is one operation where a loop
    // over the elements is one per instruction lowered
    let opc : ir_m.Ir[] = lw.op[0¤ptrdiff…#lw.op]
    let iac : i64[] = lw.ia[0¤ptrdiff…#lw.ia]
    let ibc : i64[] = lw.ib[0¤ptrdiff…#lw.ib]
    let icc : i64[] = lw.ic[0¤ptrdiff…#lw.ic]
    let idc : i64[] = lw.idd[0¤ptrdiff…#lw.idd]
    let iwc : i64[] = lw.iww[0¤ptrdiff…#lw.iww]
    let exc : i64[] = lw.extra[0¤ptrdiff…#lw.extra]
    ir_m.IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
         extra: exc, nvregs: lw.tmax, nlabels: lw.nlabels, fbytes: lw.fbytes}

// Whether a build that lined its functions up with a previous binary
// may be written back into it: everything the copied code names has to
// be where it was.  Answers "" when it may, and otherwise what stopped
// it, which the driver prints and then compiles whole.
//
// This is what makes it safe to have skipped emitting most of the
// program.  Whatever a skipped function would have contributed to
// .rodata, to .data and to the symbol table, it contributed to the
// previous build; if those came out the same, the skipping cost
// nothing.
@export
fn incr_lines_up(prev : &incr_m.Prev, incr : &incr_m.Incr, c : Compiled) → str:
    // Everything the copied code points into is named by an offset,
    // and the offsets are what has to hold: the address of a string,
    // of a descriptor, of a table.  A string's own bytes are not
    // pointed into and may say something else -- @pre names the line
    // it is written on, and a line moves when one is added above it.
    // The descriptors say where each string begins and how long it is,
    // so comparing from them onwards checks every offset at once: a
    // string that changed length moved either the descriptors or the
    // strings after it, and either way what follows will not match.
    //
    // The read-only data may also grow at its end -- that is where the
    // jump tables of the functions this build wrote again go, and a
    // message that gained a character is longer than the one it
    // replaces -- into the room the build that wrote the file
    // reserved.  Past that room is where .data begins.
    if c.ro_fixed > prev.ro_size:
        return "the strings grew past where the read-only data ended"
    if #c.rodata < prev.ro_size:
        return "the read-only data shrank, from " ⧺ tokens.i64_str(@dropunit(prev.ro_size)) ⧺ " bytes to " ⧺ tokens.i64_str(@dropunit(#c.rodata))
    if #c.rodata > incr_m.incr_ro_room(&prev):
        return "the read-only data grew past the room the file left it: " ⧺ tokens.i64_str(@dropunit(#c.rodata)) ⧺ " bytes where " ⧺ tokens.i64_str(@dropunit(incr_m.incr_ro_room(&prev))) ⧺ " were reserved"
    if #c.code > incr_m.incr_text_room(&prev):
        return "the code grew past the room the file left it: " ⧺ tokens.i64_str(@dropunit(#c.code)) ⧺ " bytes where " ⧺ tokens.i64_str(@dropunit(incr_m.incr_text_room(&prev))) ⧺ " were reserved"
    foreach i := c.ro_fixed…prev.ro_size:
        // the read-only globals are values too, and so is the table a
        // backtrace reads: a value that did not move is a value the
        // copied code reads correctly, whatever it now says
        if (i < c.ro_vals or i >= c.ro_vals_end) and (i < c.ro_bt or i >= c.ro_bt_end):
            if c.rodata[i] ≠ prev.raw[prev.ro_off + i]:
                return "the read-only data came out different, from byte " ⧺ tokens.i64_str(@dropunit(i))
    if @dropunit(#c.data) ≠ @dropunit(prev.d_size):
        return "the writable data is " ⧺ tokens.i64_str(@dropunit(#c.data)) ⧺ " bytes and was " ⧺ tokens.i64_str(@dropunit(prev.d_size))
    foreach i := 0¤byte…#c.data:
        if c.data[i] ≠ prev.raw[prev.d_off + i]:
            return "the writable data came out different"
    // Every symbol the previous build had, at the address it had it,
    // with one exception and one allowance.  The exception is a
    // function this build had to move: it is past everything that
    // build used, in a section of its own, and the callers that name
    // it were written again with its new address.  The allowance is
    // that a slot may grow, which is what happens to the symbol before
    // one that moved -- a slot's size is the distance to the next
    // symbol, and the next symbol is out in the overflow now.  It may
    // not shrink: that would mean something else has taken the room.
    //
    // The symbols are matched by name rather than by their place in
    // the table, since a function that moved is no longer in the same
    // place in it.
    if #c.syms ≠ #prev.sym_name:
        return "the symbol table holds a different number of symbols"
    foreach i := 0¤ptrdiff…#c.syms:
        let nm : str = c.syms[i].name
        let was : i64 = incr.at_of(nm)
        if was < 0:
            return "'" ⧺ nm ⧺ "' is a symbol the previous build did not have"
        if @dropunit(c.syms[i].value) ≠ was:
            if @dropunit(c.syms[i].value) < incr_m.incr_text_end(&incr):
                return "'" ⧺ nm ⧺ "' moved, and not out past what the previous build used"
            continue
        if @dropunit(c.syms[i].value + c.syms[i].size) < incr.end_of(nm):
            return "the room '" ⧺ nm ⧺ "' is smaller than it was"
    ""

@export
@pre(stack_size >= elf.PAGE and guard_size >= elf.PAGE)
@pre((stack_size % elf.PAGE ?? 1) = 0 and (guard_size % elf.PAGE ?? 1) = 0)
@pre(olevel >= 0)
fn codegen(a : &ast.Ast, toks : &lex.Toks, src : byte[], chk : &check.Chk, tgt : &elf.Target,
           stack_size : i64, guard_size : i64, olevel : i64, want_log : bool,
           incr : &incr_m.Incr) → Compiled:
    if tgt.id ≠ elf.Tgt.x64:
        // the shared driver and the target's instruction layer carry
        // every other architecture
        return codegen_t.codegen_t(&a, &toks, src, &chk, &tgt, stack_size, guard_size, olevel, want_log, &incr)
    // Which functions nobody outside can call, and what that buys.  The
    // pioneer takes six arguments in registers and spends none of the
    // headroom past them yet -- rax is the memo and r10 and r11 are the
    // emitter's own scratch -- so it grants nothing, and the log says
    // six because six is what it uses.
    let ab : abi.Abi = abi.analyze_abi(&a, &toks, 6, 0, want_log)
    // Who takes the private convention, indexed as a call target is.
    // A synthetic past the end of this -- a lambda, a shim, the test
    // driver -- takes the architecture's, as anything reached through
    // an address must.
    // A private convention is decided over the whole program, so it can
    // move for a function whose own source did not -- and a function
    // this build copies rather than generates was written against the
    // convention it had.  Under --incremental every function keeps the
    // architecture's, which is the same in every build.
    let privs : mut i64[] = []
    foreach i := 0…#a.fns:
        privs.push(if incr.mode ≠ 0: 0 else: ab.private[i])
    let strs0 : mut str[] = []
    foreach s := a.strs:
        strs0.push(s)
    let sat0 : mut names.Names = names.names_new(@dropunit(#strs0))
    foreach i0 := 0¤ptrdiff…#strs0:
        sat0.add_at(strs0[i0], @dropunit(i0))
    let lw : mut lower.Lower = lower.Lower{a: a, toks: toks, src: src, ntype: chk.ntype,
                               nslot: chk.nslot, ncvt: chk.ncvt, nrep: chk.nrep, nlam: chk.nlam, nhold: chk.nhold, nfree: chk.nfree, rec_stmt: chk.rec_stmt, rec_slot: chk.rec_slot, nmove: chk.nmove, cur_ref: 0, strs: strs0, sat: sat0, loop_labels: [],
                               op: [], ia: [], ib: [], ic: [], idd: [],
                               iww: [], extra: [], tbase: 0, tnext: 0,
                               tmax: 0, nlabels: 0, breaks: [], conts: [],
                               in_wrap: 0, argsfix: ⁻1, lambase: 0,
                               shimbase: 0,
                               cur_ret: 0, post_label: ⁻1,
                               res_vreg: ⁻1, old_base: 0, inv_subject: ⁻1, tail_label: ⁻1, tail_fn: ⁻1, tail_np: 0, cur_fname: "", dlog: [],
                               argcopy: chk.argcopy, fbytes: 0¤byte, sret: ⁻1,
                               olevel: olevel}
    let em : mut emit.Emit = emit.Emit{code: [], cf_pos: [], cf_target: [],
                             sf_pos: [], sf_str: [], sd_pos: [], sd_str: [],
                             df_pos: [], df_off: [], labels: [],
                             lf_pos: [], lf_label: [], fn_off: [],
                             rt_off: [], rax_slot: ⁻1, drop_slot: ⁻1, hold_slot: ⁻1, pkeep: [], self_priv: 0,
                             jt_pos: [], jt_id: [], jt_count: 0,
                             jt_starts: [], jt_is_code: [], jt_entries: [],
                             pj_id: [],
                             pj_start: [], pj_len: [], pj_labels: [],
                             max_frame: 0,
                             gmap: [], gseg: [], gr_pos: [], gr_off: [],
                             skipping: 0, rt_need: [],
                             rx: [], rx_pos: [], rx_off: [], bt_pos: [],
                             ab_kind: [], ab_lab: [],
                             tf_pos: [], tf_lab: [], tf_form: [],
                             ff_pos: [], ff_fn: [], k_args: 0, k_alloc: 0, k_sig: 0}
    let nglobals : i64 ¤ptrdiff = #a.globals
    // The data a program carries falls into three kinds.  One is never
    // written and rides with the other read-only things.  One is
    // written before @start is reached and never again -- the globals
    // the initializer builds, and what the kernel handed us -- and is
    // made read-only there, which is what PT_GNU_RELRO records.  The
    // rest is written throughout and stays writable.
    let is_relro : mut i64[] = nglobals ⍴ 0
    foreach g := chk.ginit:
        is_relro[g × 1¤ptrdiff] ← 1
    let n_ro : mut i64 = 0
    let n_relro : mut i64 = 0
    let n_rw : mut i64 = 0
    if nglobals > 0:
        foreach i := 0…nglobals:
            if a.globals[i].is_mut:
                n_rw ← n_rw + 1
            elif is_relro[i] = 1:
                n_relro ← n_relro + 1
            else:
                n_ro ← n_ro + 1
    // what the kernel handed over is written once, at the very top of
    // the program, so it belongs with the rest of the relro
    let args_off : i64 = 8 × n_relro
    let relro_size : i64 = elf.align_up(args_off + emit.KB_SIZE, elf.PAGE)
    // the signal structures sit at the head of the writable data
    let alloc_off : i64 = relro_size + emit.SIG_SIZE + 8 × n_rw
    let k_ro : mut i64 = 0
    let k_relro : mut i64 = 0
    let k_rw : mut i64 = 0
    if nglobals > 0:
        foreach i := 0…nglobals:
            if a.globals[i].is_mut:
                em.gseg.push(1)
                em.gmap.push(relro_size + emit.SIG_SIZE + 8 × k_rw)
                k_rw ← k_rw + 1
            elif is_relro[i] = 1:
                em.gseg.push(1)
                em.gmap.push(8 × k_relro)
                k_relro ← k_relro + 1
            else:
                em.gseg.push(0)
                em.gmap.push(8 × k_ro)
                k_ro ← k_ro + 1
    assert(#em.gmap = nglobals, "every global was placed")
    let nfns : i64 = @dropunit(#a.fns)
    // _start: call the @start function, then exit 0
    let start_fn : mut i64 = ⁻1
    foreach i := 0…#a.fns:
        if a.fns[i].is_start:
            start_fn ← @dropunit(i)
    // the kernel's argc and argv sit at the entry rsp; they are kept
    // in the data segment before anything moves the stack
    em.b3(72, 139, 4)
    em.b1(36)                       // mov rax, [rsp]
    em.dref(emit.R_R11, args_off)
    em.b3(73, 137, 3)               // mov [r11], rax: argc
    em.b4(72, 141, 68, 36)
    em.b1(8)                        // lea rax, [rsp+8]
    em.b4(73, 137, 67, 8)           // mov [r11+8], rax: argv
    // the environment block follows argv and the NULL that ends it
    em.b3(72, 139, 12)              // mov rcx, [rsp]: argc
    em.b1(36)
    em.b4(72, 141, 68, 200)         // lea rax, [rax+rcx*8+8]
    em.b1(8)
    em.b4(73, 137, 67, 16)          // mov [r11+16], rax: envp
    // and the auxiliary vector begins one word past the NULL that ends
    // the environment, where the kernel left it
    em.begin_fn(1)
    em.b3(72, 137, 193)             // mov rcx, rax
    em.set_label(0)                 // Lwalk
    em.b3(72, 139, 17)              // mov rdx, [rcx]
    em.b4(72, 131, 193, 8)          // add rcx, 8
    em.b3(72, 133, 210)             // test rdx, rdx
    em.jlocal(133, 0)               // jne Lwalk
    em.b4(73, 137, 75, 24)          // mov [r11+24], rcx: auxv
    em.resolve_locals()
    // The stack the program will stand on: one reservation of
    // guard + stack bytes, unreadable throughout, of which the upper
    // stack bytes are then opened for reading and writing.  What is
    // left below stays unreadable, so an overflow faults on the guard
    // rather than reaching whatever the kernel put beneath.  argc and
    // argv were copied out above, and the entry stack stays mapped, so
    // the strings they point at outlive the move.
    em.begin_fn(2)
    em.b2(49, 255)                  // xor edi, edi: let the kernel place it
    em.movimm(emit.R_SI, guard_size + stack_size)
    em.b2(49, 210)                  // xor edx, edx: PROT_NONE
    em.movimm(emit.R_R10, 147490)        // PRIVATE|ANONYMOUS|NORESERVE|STACK
    em.movimm(emit.R_R8, ⁻1)
    em.b3(69, 49, 201)              // xor r9d, r9d
    em.movimm(emit.R_AX, 9)
    em.b2(15, 5)                    // mmap
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(136, 0)               // js: the kernel refused
    em.b3(72, 137, 195)             // mov rbx, rax: the region's foot
    em.movimm(emit.R_DI, guard_size)
    em.b3(72, 1, 199)               // add rdi, rax: past the guard
    em.movimm(emit.R_SI, stack_size)
    em.movimm(emit.R_DX, 3)              // PROT_READ|PROT_WRITE
    em.movimm(emit.R_AX, 10)
    em.b2(15, 5)                    // mprotect
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(136, 0)               // js: the kernel refused
    em.movimm(emit.R_AX, guard_size + stack_size)
    em.b3(72, 1, 216)               // add rax, rbx: the head of the region
    em.b3(72, 137, 196)             // mov rsp, rax: and the program stands
    // Where the guard is, for the handler to compare a faulting
    // address against.  Written here because here is where it is
    // known, and sealed with the rest of the relro straight after.
    em.dref(emit.R_R11, args_off)
    em.b4(73, 137, 91, emit.KB_GLO)      // mov [r11+KB_GLO], rbx
    em.movimm(emit.R_AX, guard_size)
    em.b3(72, 1, 216)               // add rax, rbx
    em.b4(73, 137, 67, emit.KB_GHI)      // mov [r11+KB_GHI], rax
    em.movimm(emit.R_AX, guard_size + stack_size)
    em.b3(72, 1, 216)               // add rax, rbx
    em.b4(73, 137, 67, emit.KB_STOP)     // mov [r11+KB_STOP], rax: one past the top
    em.jlocal(⁻1, 1)
    em.set_label(0)
    let smsg : i64 = lw.intern("the stack could not be reserved\n")
    em.sref(emit.R_SI, smsg)
    em.movimm(emit.R_DX, emit.str_len("the stack could not be reserved\n"))
    em.jglobal(232, ⁻1, emit.RT_ABORT)
    em.set_label(1)
    em.resolve_locals()
    // ------------------------------------------------------------------
    // Catching the stack running out
    // ------------------------------------------------------------------
    //
    // A program that recurses too deep walks off the bottom of its
    // stack into the guard, which is mapped unreadable, and the kernel
    // sends SIGSEGV.  Without a handler that is a bare "Segmentation
    // fault" from the shell, which says nothing about which of the two
    // things it was.  With one, and with the guard's bounds to compare
    // the faulting address against, the program can say so itself.
    //
    // The handler needs a stack of its own -- the one that ran out is
    // no place to put a frame -- so a small region is mapped for it
    // and sigaltstack is told about it.
    em.begin_fn(1)
    em.b2(49, 255)                  // xor edi, edi
    em.movimm(emit.R_SI, emit.SIGALT_BYTES)
    em.movimm(emit.R_DX, 3)              // PROT_READ|PROT_WRITE
    em.movimm(emit.R_R10, 16418)         // PRIVATE|ANONYMOUS|NORESERVE
    em.movimm(emit.R_R8, ⁻1)
    em.b3(69, 49, 201)              // xor r9d, r9d
    em.movimm(emit.R_AX, 9)
    em.b2(15, 5)                    // mmap
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(136, 0)               // js: no handler stack, so no handler
    em.dref(emit.R_R11, relro_size)
    em.b4(73, 137, 67, emit.SIG_ALT)     // mov [r11+SIG_ALT], rax: ss_sp
    em.b3(72, 49, 192)              // xor rax, rax
    em.b4(73, 137, 67, emit.SIG_ALT + 8) // ss_flags
    em.movimm(emit.R_AX, emit.SIGALT_BYTES)
    em.b4(73, 137, 67, emit.SIG_ALT + 16)  // ss_size
    em.b3(73, 141, 123)
    em.b1(emit.SIG_ALT)                  // lea rdi, [r11+SIG_ALT]
    em.b3(72, 49, 246)              // xor rsi, rsi
    em.movimm(emit.R_AX, machine.sc_number(&tgt, machine.Sc.sigaltstack))
    em.b2(15, 5)
    // the action: the handler's own address, the flags that ask for
    // the faulting address and for the handler's own stack, and a
    // restorer, which x86-64 will not take a handler without
    em.dref(emit.R_R11, relro_size)
    em.b3(72, 141, 5)               // lea rax, [rip+disp32]
    em.gref_code(emit.RT_SEGV)
    em.b4(73, 137, 67, emit.SIG_ACT)     // sa_handler
    em.movimm(emit.R_AX, emit.SA_FLAGS_R)
    em.b4(73, 137, 67, emit.SIG_ACT + 8)   // sa_flags
    em.b3(72, 141, 5)
    em.gref_code(emit.RT_SIGRET)
    em.b4(73, 137, 67, emit.SIG_ACT + 16)  // sa_restorer
    em.b3(72, 49, 192)
    em.b4(73, 137, 67, emit.SIG_ACT + 24)  // sa_mask
    em.movimm(emit.R_DI, emit.SIGSEGV_NO)
    em.b3(73, 141, 115)
    em.b1(emit.SIG_ACT)                  // lea rsi, [r11+SIG_ACT]
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.movimm(emit.R_R10, 8)             // the mask is eight bytes
    em.movimm(emit.R_AX, machine.sc_number(&tgt, machine.Sc.rt_sigaction))
    em.b2(15, 5)
    em.set_label(0)
    em.resolve_locals()
    let ninit : i64 = @dropunit(#chk.ginit)
    let g1 : i64 = if ninit > 0: 1 else: 0
    // past the user's functions sit the synthetics: the global init,
    // the argument filter, the test driver
    lw.argsfix ← nfns + g1
    lw.lambase ← nfns + g1 + 2
    lw.shimbase ← lw.lambase + @dropunit(#chk.lams)
    let tdriver : i64 = nfns + g1 + 1
    if ninit > 0:
        em.jglobal(232, ⁻1, nfns)
    // everything written before @start has now been written; what the
    // headers say is read-only from here on is made so
    em.jglobal(232, ⁻1, emit.RT_RELRO)
    em.jglobal(232, ⁻1, tdriver)
    if start_fn >= 0:
        em.jglobal(232, ⁻1, start_fn)
    // the start function's answer is the exit status; one that
    // answers nothing exits 0, as does a test file with no @start
    if start_fn >= 0 and a.fns[start_fn × 1¤ptrdiff].ret ≠ types.TY_UNIT:
        em.b3(72, 137, 199)         // mov rdi, rax
    else:
        em.b3(72, 49, 255)          // xor rdi, rdi
    em.movimm(emit.R_AX, 60)
    em.b2(15, 5)
    // The program's own code first: what it calls is then known, and
    // the runtime that follows carries only what is reached.
    let incr_why : mut str = ""
    // Functions that are not written where they stand: one that has
    // outgrown its slot, and one an earlier build already moved past
    // .text.  Their bodies go after the runtime, in the room reserved
    // beyond what the last build used, so this gathers them as it
    // goes and comes back to them there.
    let dfr_fn : mut i64[] = []        // which function of a.fns
    let dfr_at : mut i64[] = []        // where it already lives, or ⁻1
    let dfr_np : mut i64[] = []
    let dfr_ir : mut ir_m.IrFn[] = []
    let dfr_rt : mut i64[] = []        // the runtime it reaches, harvested
    // A function nothing reaches is in no binary.  Its slot in the
    // schedule stays, so every index into it still means what it meant
    // -- the lambdas and the shims are numbered past the functions --
    // and its offset is the one no call may land on, so a call that
    // somehow reaches for it is caught where the calls are resolved
    // rather than jumping into whatever stands at the front.
    let live : bool[] = incr_m.reached_fns(&a, &toks, src)
    foreach i := 0…#a.fns:
        let f : i64 = @dropunit(i)
        if not live[i]:
            if want_log:
                lw.dlog.push("{\"function\": \"" ⧺ a.fns[i].name ⧺ "\", \"decision\": \"unreached\"}")
            // Its slot stays, so every index into the schedule still
            // means what it meant -- the lambdas and the shims are
            // numbered past the functions -- and its offset is the one
            // no call may land on, so a call that somehow reaches for
            // it is caught where the calls are resolved rather than
            // jumping into whatever stands at the front.
            em.fn_off.push(⁻1)
            continue
        // the space for a sized answer arrives as one more argument
        let np : i64 = a.extra[a.fns[i].params_off] + (if check.farr_is_packed(a, a.fns[i].ret): 1 else: 0)
        let symnm : str = symbols.fn_symbol(&a, &toks, src, f)
        // Every function is lowered, including one whose code is about
        // to be copied rather than written: lowering is what puts a
        // string literal in the table, and the table is what .rodata
        // is.  A build that lowered only the changed functions would
        // produce a different .rodata, every address in the copied
        // code would be wrong, and the mode would fall back every
        // time.  What an unchanged function skips is emission.  A
        // generic no call shaped gets a stub: an empty body stands in.
        let ir := if chk.skipfn[i] = 1: lower.lower_stub_fn(&lw, np) else: lower.lower_fn(&lw, &a, &chk, f)
        // A function an earlier build moved lives past .text, which is
        // past where the runtime is about to be written: it is written
        // with the rest of the overflow.  Emitting it here first is
        // how its runtime calls are found out in time; the bytes are
        // thrown away again.
        let away : bool = incr.mode = 2 and incr.at_of(symnm) >= incr_m.incr_text_size(&incr)
        if away:
            if incr.fresh[i]:
                let mk0 := em.mark()
                arch_x86_64.emit_fn(&em, ir, np, lw.strs, privs[i], privs)
                incr_m.incr_harvest(em, mk0, &dfr_rt)
                em.rewind(mk0)
            dfr_fn.push(f)
            dfr_at.push(incr.at_of(symnm))
            dfr_np.push(np)
            dfr_ir.push(ir)
            em.fn_off.push(0)
            continue
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, symnm))
        em.fn_off.push(em.here())
        let began : i64 = em.here()
        if incr.mode = 2 and incr_why = "" and not incr.fresh[i]:
            incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_copy(&em, &incr, symnm))
        else:
            let mk := em.mark()
            arch_x86_64.emit_fn(&em, ir, np, lw.strs, privs[i], privs)
            // It did not fit where it stood.  The slot stays where it
            // is, trapped, and the body goes past the region the last
            // build used, where its callers -- which are written again
            // whenever it is -- will call it.
            if incr.mode = 2 and em.here() > incr.end_of(symnm):
                incr_m.incr_harvest(em, mk, &dfr_rt)
                em.rewind(mk)
                dfr_fn.push(f)
                dfr_at.push(⁻1)
                dfr_np.push(np)
                dfr_ir.push(ir)
                em.fn_off[i] ← 0
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, symnm, began))
    if ninit > 0:
        let gir := lower_ginit(&lw, &a, &chk)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, "<globals>"))
        em.fn_off.push(em.here())
        let b1 : i64 = em.here()
        arch_x86_64.emit_fn(&em, gir, 0, lw.strs, 0, privs)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, "<globals>", b1))
    let fir := lower_argsfilter(&lw)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, "<args>"))
    em.fn_off.push(em.here())
    let b2 : i64 = em.here()
    arch_x86_64.emit_fn(&em, fir, 0, lw.strs, 0, privs)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, "<args>", b2))
    let dir := lower_testdriver(&lw, &a)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, "<tests>"))
    em.fn_off.push(em.here())
    let b3 : i64 = em.here()
    arch_x86_64.emit_fn(&em, dir, 0, lw.strs, 0, privs)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, "<tests>", b3))
    foreach j := 0…#chk.lams:
        let lir := lower.lower_lambda_fn(&lw, &a, &chk, @dropunit(j))
        let lnm : str = "λ#" ⧺ tokens.i64_str(@dropunit(j))
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, lnm))
        em.fn_off.push(em.here())
        let b4 : i64 = em.here()
        let lnp : i64 = a.extra[a.na[chk.lams[j] × 1¤ptrdiff] × 1¤ptrdiff]
        arch_x86_64.emit_fn(&em, lir, lnp + 1, lw.strs, 0, privs)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, lnm, b4))
    foreach j := 0…#chk.psfn:
        let sir := lower.lower_shim_fn(&lw, &chk, @dropunit(j))
        let pnm : str = "partial#" ⧺ tokens.i64_str(@dropunit(j))
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, pnm))
        em.fn_off.push(em.here())
        let b5 : i64 = em.here()
        arch_x86_64.emit_fn(&em, sir, chk.psnp[j] - chk.psk[j] + 1, lw.strs, 0, privs)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, pnm, b5))
    // every function was emitted and left its offset behind
    assert(@dropunit(#em.fn_off) = nfns + g1 + 2 + @dropunit(#chk.lams) + @dropunit(#chk.psfn), "one code offset per function")
    // What the program calls, and what that calls in turn.  Everything
    // emitted so far is the program's own; the calls it made name the
    // runtime it needs, and the edge list closes over the rest.
    let nrt : i64 ¤ptrdiff = 73
    foreach _ := 0…nrt:
        em.rt_need.push(0)
        em.rt_off.push(⁻1)
    // Which routines a build carries is read off the calls it emitted,
    // and a build that copies a function instead of emitting it sees
    // none of that function's calls.  So a build lining up with a
    // previous one starts from the routines that build had: the old
    // symbol table names them, they sit after the program's own code
    // in the order of their ids, and code copied out of the old .text
    // calls them where they stood.  A routine this build needs and the
    // old one lacked still goes in -- and moves the ones after it,
    // which the check on the symbol table then catches.
    if incr.mode = 2:
        let rtn0 := emit.RT_NAMES
        foreach i := 0…nrt:
            if incr.at_of(rtn0[i]) >= 0:
                em.rt_need[i] ← 1
    // what the functions written after the runtime reach, found out
    // before the set is closed rather than after it is written
    foreach t := dfr_rt:
        em.rt_need[(0 - t - 1) × 1¤ptrdiff] ← 1
    foreach i := 0…#em.cf_target:
        let t : i64 = em.cf_target[i]
        if t < 0:
            em.rt_need[(0 - t - 1) × 1¤ptrdiff] ← 1
    let edges := emit.RT_EDGES
    let npair : i64 = @dropunit(#edges) ÷ 2 ?? 0
    let changed : mut bool = true
    while changed:
        changed ← false
        foreach e := 0…npair:
            // the pairs hold the routines' ids as positive numbers, and
            // a routine's place in the list is one less than its id
            let from : i64 = edges[(e × 2) × 1¤ptrdiff] - 1
            let to : i64 = edges[(e × 2 + 1) × 1¤ptrdiff] - 1
            if em.rt_need[from × 1¤ptrdiff] = 1 and em.rt_need[to × 1¤ptrdiff] = 0:
                em.rt_need[to × 1¤ptrdiff] ← 1
                changed ← true
    rt_x86_64.emit_runtime(&em, &tgt, &lw, alloc_off, args_off, relro_size)
    em.skipping ← 0
    if #em.rt_off > 0:
        foreach i := 0…nrt:
            assert(em.rt_off[i] ≠ ⁻1 or em.rt_need[i] = 0, "a needed routine was emitted")

    // ---------------------------------------------------------------
    // The overflow: what would not fit where it stood
    // ---------------------------------------------------------------
    //
    // .text ends here, at the size the previous build had.  Past it
    // are the sections that build wrote for the functions it had to
    // move; a function in one of them is written where it is, in the
    // order it is in, since code that calls it and was not written
    // again calls it there.  Past all of them is this build's own
    // section, holding what this build had to move.  Nothing needs a
    // jump left behind: a function that names one that moved is a
    // function this build writes again, and it calls the new address.
    let tx_ends : mut i64[] = []
    tx_ends.push(em.here())
    // the sections the previous build wrote past .text, written again
    // with the bounds they had
    if incr.mode = 2:
        foreach ov_e := incr.tx_ends:
            if ov_e > tx_ends[0¤ptrdiff]:
                tx_ends.push(ov_e)
    let placed : mut i64[] = []
    if #dfr_fn > 0:
        // the ones already out there first, in the order they are out
        // there; the plainest sort, for the handful there ever are
        let ov_ord : mut i64[] = []
        foreach ov_k := 0…#dfr_fn:
            if dfr_at[ov_k] >= 0:
                let ov_at : i64 = dfr_at[ov_k]
                let ov_j : mut i64 ¤ptrdiff = #ov_ord
                ov_ord.push(@dropunit(ov_k))
                while ov_j > 0¤ptrdiff and dfr_at[ov_ord[ov_j - 1¤ptrdiff] × 1¤ptrdiff] > ov_at:
                    let ov_t : i64 = ov_ord[ov_j - 1¤ptrdiff]
                    ov_ord[ov_j - 1¤ptrdiff] ← ov_ord[ov_j]
                    ov_ord[ov_j] ← ov_t
                    ov_j ← ov_j - 1¤ptrdiff
        let ov_late : mut i64[] = []
        foreach ov_kk := ov_ord:
            let ov_i : i64 ¤ptrdiff = ov_kk × 1¤ptrdiff
            let ov_f : i64 = dfr_fn[ov_i]
            let ov_nm : str = symbols.fn_symbol(&a, &toks, src, ov_f)
            incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, ov_nm))
            em.fn_off[ov_f × 1¤ptrdiff] ← em.here()
            let ov_beg : i64 = em.here()
            if not incr.fresh[ov_f × 1¤ptrdiff]:
                incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_copy(&em, &incr, ov_nm))
            else:
                let ov_mark := em.mark()
                arch_x86_64.emit_fn(&em, dfr_ir[ov_i], dfr_np[ov_i], lw.strs, privs[ov_f × 1¤ptrdiff], privs)
                // it has outgrown even the room it was moved into, so
                // it moves again, into this build's own section
                if em.here() > incr.end_of(ov_nm):
                    em.rewind(ov_mark)
                    ov_late.push(ov_kk)
                    em.fn_off[ov_f × 1¤ptrdiff] ← 0
            incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, ov_nm, ov_beg))
            if em.fn_off[ov_f × 1¤ptrdiff] ≠ 0:
                placed.push(ov_f)
        // then everything this build had to move, after the last of
        // the sections the previous build wrote
        foreach ov_k := 0…#dfr_fn:
            if dfr_at[ov_k] < 0:
                ov_late.push(@dropunit(ov_k))
        if #ov_late > 0:
            assert(em.here() <= incr_m.incr_text_end(&incr), "the overflow begins past what the last build used")
            while em.here() < incr_m.incr_text_end(&incr):
                em.b1(incr.fill)
            foreach ov_kk := ov_late:
                let ov_i : i64 ¤ptrdiff = ov_kk × 1¤ptrdiff
                let ov_f : i64 = dfr_fn[ov_i]
                em.fn_off[ov_f × 1¤ptrdiff] ← em.here()
                let ov_beg2 : i64 = em.here()
                arch_x86_64.emit_fn(&em, dfr_ir[ov_i], dfr_np[ov_i], lw.strs, privs[ov_f × 1¤ptrdiff], privs)
                // room of its own, so the build after this one can
                // write it again where it now stands
                let ov_pad : i64 = @dropunit(incr_m.incr_padding((em.here() - ov_beg2) × 1¤byte))
                foreach _ := 0…ov_pad:
                    em.b1(incr.fill)
                placed.push(ov_f)
            tx_ends.push(em.here())
    // calls resolve now that every target has a place
    foreach i := 0…#em.cf_pos:
        let pos : i64 = em.cf_pos[i]
        let t : i64 = em.cf_target[i]
        let dest : i64 = if t >= 0: em.fn_off[t × 1¤ptrdiff] else: em.rt_off[(0 - t - 1) × 1¤ptrdiff]
        // a call whose target was passed over means the edge list
        // does not say everything the emitter does
        assert(dest ≠ ⁻1, "every call reaches a routine that was emitted")
        em.patch32(pos, dest - (pos + 4))
    // rodata: the strings' bytes, then their descriptors
    let text_size : i64 = em.here()
    // What the text region is given, which is where the read-only
    // data begins; see incr_room_text for why this is not #code.
    let text_room : i64 ¤byte = incr_m.incr_room_text(&incr, text_size × 1¤byte)
    let ro_vaddr : i64 = elf.IMAGE_BASE + elf.align_up(elf.PAGE + @dropunit(text_room), elf.PAGE)
    // The pool holds every literal the source wrote, and .rodata holds
    // the ones something reads.  A message an @expect names, a line in
    // a function nobody calls: no instruction refers to either, so the
    // bytes would sit in the image saying nothing.  What refers to a
    // string is a pointer patch or a descriptor patch, and those are
    // the two lists asked here.
    let used : i64[] = if incr.mode = 0: emit.str_uses(&em, @dropunit(#lw.strs)) else: incr_m.incr_all_used(#lw.strs)
    let stroffs : mut i64[] = []
    let descidx : mut i64[] = []
    let acc : mut i64 = 0
    let nstr : mut i64 = 0
    foreach i := 0…#lw.strs:
        stroffs.push(acc)
        descidx.push(nstr)
        if used[i] = 1:
            acc ← acc + emit.str_len(lw.strs[i])
            nstr ← nstr + 1
    let descbase : i64 = elf.align_up(acc, 8)
    foreach i := 0…#em.sf_pos:
        em.patch64(em.sf_pos[i], ro_vaddr + stroffs[em.sf_str[i] × 1¤ptrdiff])
    foreach i := 0…#em.sd_pos:
        em.patch64(em.sd_pos[i], ro_vaddr + descbase + 16 × descidx[em.sd_str[i] × 1¤ptrdiff])
    assert(#stroffs = #lw.strs, "one offset per string")
    let rodata : mut u8[] = []
    foreach i := 0…#lw.strs:
        if used[i] = 1:
            foreach c := lw.strs[i]:
                rodata.push(c.ord() & 255)
    while @dropunit(#rodata) < descbase:
        rodata.push(0)
    foreach i := 0…#lw.strs:
        if used[i] = 1:
            elf.push64(&rodata, ro_vaddr + stroffs[i])
            elf.push64(&rodata, emit.str_len(lw.strs[i]))
    // the constant tables the runtime reads: the UTF-8 decoder's byte
    // classes, then its transition words, one to a class
    let rx_base : i64 = @dropunit(#rodata)
    foreach b := emit.utf8_class_bytes():
        rodata.push(b)
    foreach w := emit.UTF8_DFA_WORDS:
        elf.push64(&rodata, w)
    foreach i := 0…#em.rx_pos:
        em.patch64(em.rx_pos[i], ro_vaddr + rx_base + em.rx_off[i])
    // The table a backtrace reads: where every function of the program
    // begins, how far it runs, and what it is called.  Built here
    // because here is where all three are known, and read by RT_BT,
    // which is the one thing that asks where it is -- so the list of
    // places that ask is also the answer to whether to build it at
    // all.  A program with no way to stop itself carries no RT_BT, and
    // then these bytes would sit in the image saying nothing.
    let bt_at : mut i64 = 0
    let bt_to : mut i64 = 0
    if #em.bt_pos > 0:
        let bt_base : i64 = elf.align_up(@dropunit(#rodata), 8)
        while @dropunit(#rodata) < bt_base:
            rodata.push(0)
        bt_at ← bt_base
        // in the order the code is laid out, which is not the order
        // the functions were parsed in once one of them has moved
        let bt_nm0 : str[] = incr_m.incr_reorder_names(rt_backtrace.bt_fn_names(&a, ninit, @dropunit(#chk.lams), @dropunit(#chk.psfn)), placed)
        let bt_of0 : i64[] = incr_m.incr_reorder(em.fn_off, placed)
        let bt_nm : str[] = incr_m.bt_keep_names(bt_nm0, bt_of0)
        let bt_of : i64[] = incr_m.bt_keep_offs(bt_of0)
        foreach c := rt_backtrace.bt_bytes(&tgt, elf.IMAGE_BASE + elf.PAGE, bt_nm, bt_of,
                              rt_backtrace.bt_sizes(bt_of, @dropunit(#placed),
                                       rt_backtrace.bt_text_end(em, text_size), text_size)):
            rodata.push(c)
        foreach i := 0…#em.bt_pos:
            em.patch64(em.bt_pos[i], ro_vaddr + bt_base)
        bt_to ← @dropunit(#rodata)
    // the globals that are never written ride here, past the tables
    let gro_base : i64 = @dropunit(#rodata)
    if nglobals > 0:
        foreach i := 0…nglobals:
            if em.gseg[i] = 0:
                elf.push64(&rodata, chk.gvals[i])
    let gro_end : i64 = @dropunit(#rodata)
    foreach i := 0…#em.gr_pos:
        em.patch64(em.gr_pos[i], ro_vaddr + gro_base + em.gr_off[i])
    // A jump table holds code addresses, a value table its data, and
    // both come last: see incr_jt_prefix for why the end is where they
    // have to be.
    let jt_base : i64 = elf.align_up(@dropunit(#rodata), 8)
    while @dropunit(#rodata) < jt_base:
        rodata.push(0)
    let jt_kept : i64 = incr_m.incr_jt_prefix(&rodata, &incr, jt_base)
    foreach i := 0…#em.jt_pos:
        em.patch64(em.jt_pos[i], ro_vaddr + jt_base + jt_kept + 8 × em.jt_starts[em.jt_id[i] × 1¤ptrdiff])
    foreach t := 0…#em.jt_starts:
        let lo2 : i64 = em.jt_starts[t]
        let hi2 : i64 = if t + 1 < #em.jt_starts: em.jt_starts[t + 1] else: @dropunit(#em.jt_entries)
        let base2 : i64 = if em.jt_is_code[t] = 1: elf.IMAGE_BASE + elf.PAGE else: 0
        foreach e3 := lo2…hi2:
            elf.push64(&rodata, base2 + em.jt_entries[e3 × 1¤ptrdiff])
    // data: what is written before @start and then sealed, then what
    // stays writable throughout
    let ro_room : i64 ¤byte = incr_m.incr_room_ro(&incr, #rodata)
    let d_vaddr : i64 = elf.IMAGE_BASE + elf.align_up(ro_vaddr - elf.IMAGE_BASE + @dropunit(ro_room), elf.PAGE)
    foreach i := 0…#em.df_pos:
        em.patch64(em.df_pos[i], d_vaddr + em.df_off[i])
    let data : mut u8[] = []
    if nglobals > 0:
        foreach i := 0…nglobals:
            if em.gseg[i] = 1 and em.gmap[i] < relro_size:
                elf.push64(&data, chk.gvals[i])
    // argc, argv, envp, the auxiliary vector and the guard's two
    // bounds, then the page's rest
    foreach _ := 0…emit.KB_SIZE:
        data.push(0)
    while @dropunit(#data) < relro_size:
        data.push(0)
    // the structures the kernel is handed when the handler is installed
    foreach _ := 0…emit.SIG_SIZE:
        data.push(0)
    if nglobals > 0:
        foreach i := 0…nglobals:
            if em.gseg[i] = 1 and em.gmap[i] >= relro_size:
                elf.push64(&data, chk.gvals[i])
    // the allocator's bump pointer, the limit it runs to, and the
    // free lists a block given back is put on
    foreach _ := 0…emit.AL_SIZE:
        data.push(0)
    assert(@dropunit(#data) = alloc_off + emit.AL_SIZE, "the data segment is as long as it was planned")
    // A frame deeper than the guard could be claimed in one 'sub rsp'
    // that steps clean over it, and the overflow would land on
    // whatever lies below instead of faulting.  The compiler knows
    // every frame it laid down, so it says so here rather than leaving
    // it to be discovered.
    let cdiags : mut diag.Diag[] = []
    if em.max_frame > guard_size:
        cdiags.push(diag.Diag{line: 1¤"line", col: 1¤"col",
                         msg: "a function claims " ⧺ tokens.i64_str(em.max_frame) ⧺ " bytes of stack, more than the " ⧺ tokens.i64_str(guard_size) ⧺ "-byte guard below it, which it could step over; raise --guard-size", level: diag.Level.error, code: diag.DIAG_NONE})
    if em.max_frame >= stack_size:
        cdiags.push(diag.Diag{line: 1¤"line", col: 1¤"col",
                         msg: "a function claims " ⧺ tokens.i64_str(em.max_frame) ⧺ " bytes of stack, and the whole stack is " ⧺ tokens.i64_str(stack_size) ⧺ "; raise --stack-size", level: diag.Level.error, code: diag.DIAG_NONE})
    // The symbols, in the order the code lays them out: the entry
    // point, the program's own functions, the ones the compiler
    // synthesized behind them, and the runtime last, which is where
    // the emitter puts it so that a routine nobody reached can be left
    // out.  Each symbol runs until the next begins, and the last runs
    // to the end of the text, so this list has to be in address order
    // or a size comes out as the distance to somewhere behind it.
    let sname : mut str[] = []
    let soffs : mut i64[] = []
    let sglob : mut bool[] = []
    sname.push("_start")
    soffs.push(0)
    sglob.push(false)
    // A function this build had to move is not in address order here:
    // it is out past the runtime.  It is left out of this run and
    // added after the runtime's own symbols, which is where it is, so
    // that each symbol's size can go on being the distance to the
    // next one.
    foreach i := 0…#a.fns:
        // a function nothing reached is in no binary, and so is no
        // symbol either -- as a runtime routine nobody reached is not
        if not incr_m.incr_moved(placed, @dropunit(i)) and em.fn_off[i] ≠ ⁻1:
            sname.push(symbols.fn_symbol(&a, &toks, src, @dropunit(i)))
            soffs.push(em.fn_off[i])
            sglob.push(a.fns[i].is_export)
    let synth : mut str[] = []
    if ninit > 0:
        synth.push("<globals>")
    synth.push("<args>")
    synth.push("<tests>")
    foreach j := 0…#chk.lams:
        synth.push("λ#" ⧺ tokens.i64_str(@dropunit(j)))
    foreach j := 0…#chk.psfn:
        synth.push("partial#" ⧺ tokens.i64_str(@dropunit(j)))
    foreach j := 0…#synth:
        sname.push(synth[j])
        soffs.push(em.fn_off[(nfns + @dropunit(j)) × 1¤ptrdiff])
        sglob.push(false)
    // The runtime comes last in the text, but a routine's id is its
    // place in the list rather than its place in the code -- the two
    // agreed until a routine was written next to the one it belongs
    // beside instead of at the end.  Rather than depend on that
    // agreement, the routines that survived are put in address order
    // here.  There are a few dozen of them, so the plainest sort is
    // the right one.
    let rtn := emit.RT_NAMES
    assert(@dropunit(#rtn) = nrt, "one name for every runtime routine")
    let rname : mut str[] = []
    let roff : mut i64[] = []
    foreach i := 0…#em.rt_off:
        // a routine nobody reached is in no binary, and so is no
        // symbol either
        if em.rt_off[i] ≠ ⁻1:
            let at : i64 = em.rt_off[i]
            let nm : str = rtn[i]
            let k : mut i64 = @dropunit(#roff)
            rname.push(nm)
            roff.push(at)
            while k > 0 and roff[(k - 1) × 1¤ptrdiff] > at:
                rname[k × 1¤ptrdiff] ← rname[(k - 1) × 1¤ptrdiff]
                roff[k × 1¤ptrdiff] ← roff[(k - 1) × 1¤ptrdiff]
                k ← k - 1
            rname[k × 1¤ptrdiff] ← nm
            roff[k × 1¤ptrdiff] ← at
    foreach i := 0…#roff:
        sname.push(rname[i])
        soffs.push(roff[i])
        sglob.push(false)
    // and the moved ones last, in the order they were laid out there
    foreach mv := placed:
        sname.push(symbols.fn_symbol(&a, &toks, src, mv))
        soffs.push(em.fn_off[mv × 1¤ptrdiff])
        sglob.push(a.fns[mv × 1¤ptrdiff].is_export)
    assert(#sname = #soffs and #sname = #sglob, "one of each per symbol")
    let syms : mut elf.Sym[] = []
    foreach i := 0…#sname:
        let here : i64 ¤byte = soffs[i]
        let next : i64 ¤byte = if i + 1 < #soffs: soffs[i + 1] else: text_size
        // in address order, so a symbol's size is the distance to the
        // next one and never a distance backwards
        assert(next >= here, "the symbols run up the text")
        syms.push(elf.Sym{name: sname[i], value: here, size: next - here,
                      is_global: sglob[i]})
    // what the convention analysis decided, then what the lowering did
    let dlog : mut str[] = []
    foreach l := ab.log:
        dlog.push(l)
    foreach l := lw.dlog:
        dlog.push(l)
    Compiled{incr_why: incr_why, ro_fixed: descbase × 1¤byte,
             text_room: text_room, ro_room: ro_room, tx_ends: tx_ends,
             ro_vals: gro_base × 1¤byte, ro_vals_end: gro_end × 1¤byte,
             ro_bt: bt_at × 1¤byte, ro_bt_end: bt_to × 1¤byte, code: em.code, rodata: rodata, data: data,
             relro_size: relro_size, syms: syms,
             log: dlog, diags: cdiags}
