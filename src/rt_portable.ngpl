// ===========================================================================
// The portable runtime: written once as IR, for the five that share it
// ===========================================================================
//
// The same routines rt_x86_64.ngpl writes out as machine code, in a
// spelling no target owns: tdriver.ngpl compiles them for whichever is
// asked for, so aarch64, arm, i386, riscv64 and riscv32 have one
// runtime between them rather than five.  That is why there is no
// rt_aarch64.ngpl -- there is no aarch64 runtime to put in it.
//
// The pioneer keeps its hand-tuned routines, and the conformance suite
// holds the two spellings to one behaviour.

struct RtB:
    op : i64[]
    ia : i64[]
    ib : i64[]
    ic : i64[]
    idd : i64[]
    iww : i64[]
    extra : i64[]
    ntmp : i64
    nlab : i64

fn rtb(np : i64) → RtB:
    (RtB{op: [], ia: [], ib: [], ic: [], idd: [], iww: [], extra: [],
         ntmp: np, nlab: 0})

impl RtB:
    fn o(&mut self, op : i64, a : i64, b : i64, c : i64, d : i64, w : i64):
        self.op.push(op)
        self.ia.push(a)
        self.ib.push(b)
        self.ic.push(c)
        self.idd.push(d)
        self.iww.push(w)

    fn t(&mut self) → i64:
        self.ntmp ← self.ntmp + 1
        self.ntmp - 1

    fn l(&mut self) → i64:
        self.nlab ← self.nlab + 1
        self.nlab - 1

    fn cst(&mut self, v : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_CONST, v, 0, 0, d, 0)
        d

    fn mov(&mut self, dst : i64, src : i64):
        self.o(IR_MOV, src, 0, 0, dst, 0)

    fn add(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_ADDW, a, b, 0, d, 64 + 256)
        d

    fn sub(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_SUBW, a, b, 0, d, 64 + 256)
        d

    fn mul(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_MULW, a, b, 0, d, 64 + 256)
        d

    fn band(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_BAND, a, b, 0, d, 64 + 256)
        d

    fn bor(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_BORR, a, b, 0, d, 64 + 256)
        d

    fn shl(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_SHLL, a, b, 0, d, 64)
        d

    fn shr(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_SHRR, a, b, 0, d, 64)
        d

    // unsigned division and remainder; the divisor is never zero here,
    // so the default lane is fed the dividend and cannot be taken
    fn udiv(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_DIVV, a, b, a, d, 64)
        d

    fn umod(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_MODD, a, b, a, d, 64)
        d

    // comparisons, unsigned unless said otherwise
    fn ceq(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_CEQ, a, b, 0, d, 64)
        d

    fn cne(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_CNE, a, b, 0, d, 64)
        d

    fn cltu(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_CLT, a, b, 0, d, 64)
        d

    fn cgeu(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_CGE, a, b, 0, d, 64)
        d

    fn clts(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_CLT, a, b, 0, d, 64 + 256)
        d

    fn sel(&mut self, c : i64, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_SEL, c, a, b, d, 0)
        d

    fn jz(&mut self, v : i64, lab : i64):
        self.o(IR_JZ, v, lab, 0, 0, 0)

    fn jnz(&mut self, v : i64, lab : i64):
        self.o(IR_JNZ, v, lab, 0, 0, 0)

    fn jmp(&mut self, lab : i64):
        self.o(IR_JMP, lab, 0, 0, 0, 0)

    fn lab(&mut self, l : i64):
        self.o(IR_LABEL, l, 0, 0, 0, 0)

    // The same four at thirty-two bits.  A width narrower than the
    // machine's costs nothing extra here -- the driver's t_canon
    // narrows what the operation widened, which is the mask a hash
    // would otherwise have to write out at every step -- and it says
    // in the IR what the arithmetic actually is.
    fn add32(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_ADDW, a, b, 0, d, 32)
        d

    fn shl32(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_SHLL, a, b, 0, d, 32)
        d

    // no narrowing follows a right shift, so what goes in must already
    // be a thirty-two bit value; everything here is
    fn shr32(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_SHRR, a, b, 0, d, 32)
        d

    fn bnot32(&mut self, a : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_BNOTT, a, 0, 0, d, 32)
        d

    // raw memory, the runtime's own privilege
    fn bxor(&mut self, a : i64, b : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_BXORR, a, b, 0, d, 64 + 256)
        d

    fn bnot(&mut self, a : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_BNOTT, a, 0, 0, d, 64 + 256)
        d

    fn ldn(&mut self, base : i64, off : i64, w : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_LDN, base, off, 0, d, w)
        d

    fn stn(&mut self, base : i64, off : i64, v : i64, w : i64):
        self.o(IR_STN, base, off, v, 0, w)

    // the address of a runtime routine, for the one thing that wants
    // one rather than a jump to it: handing a handler to the kernel
    fn faddr(&mut self, target : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_FADDR, target, 0, 0, d, 0)
        d

    fn kaddr(&mut self, which : i64, off : i64) → i64:
        let d : i64 = self.t()
        self.o(IR_KADDR, which, off, 0, d, 0)
        d

    // calls into the rest of the runtime
    fn call0(&mut self, target : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(0)
        self.o(IR_CALL, target, off, 0, d, 0)
        d

    fn call1(&mut self, target : i64, a0 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(a0)
        self.o(IR_CALL, target, off, 0, d, 0)
        d

    fn call2(&mut self, target : i64, a0 : i64, a1 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(2)
        self.extra.push(a0)
        self.extra.push(a1)
        self.o(IR_CALL, target, off, 0, d, 0)
        d

    fn call3(&mut self, target : i64, a0 : i64, a1 : i64, a2 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(3)
        self.extra.push(a0)
        self.extra.push(a1)
        self.extra.push(a2)
        self.o(IR_CALL, target, off, 0, d, 0)
        d

    // the kernel; up to six arguments from slots
    fn sys1(&mut self, id : i64, a0 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(a0)
        self.o(IR_SYSC, id, off, 0, d, 0)
        d

    fn sys2(&mut self, id : i64, a0 : i64, a1 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(2)
        self.extra.push(a0)
        self.extra.push(a1)
        self.o(IR_SYSC, id, off, 0, d, 0)
        d

    fn sys3(&mut self, id : i64, a0 : i64, a1 : i64, a2 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(3)
        self.extra.push(a0)
        self.extra.push(a1)
        self.extra.push(a2)
        self.o(IR_SYSC, id, off, 0, d, 0)
        d

    fn sys4(&mut self, id : i64, a0 : i64, a1 : i64, a2 : i64, a3 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(4)
        self.extra.push(a0)
        self.extra.push(a1)
        self.extra.push(a2)
        self.extra.push(a3)
        self.o(IR_SYSC, id, off, 0, d, 0)
        d

    fn sys5(&mut self, id : i64, a0 : i64, a1 : i64, a2 : i64, a3 : i64, a4 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(5)
        self.extra.push(a0)
        self.extra.push(a1)
        self.extra.push(a2)
        self.extra.push(a3)
        self.extra.push(a4)
        self.o(IR_SYSC, id, off, 0, d, 0)
        d

    fn sys6(&mut self, id : i64, a0 : i64, a1 : i64, a2 : i64, a3 : i64, a4 : i64, a5 : i64) → i64:
        let d : i64 = self.t()
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(6)
        self.extra.push(a0)
        self.extra.push(a1)
        self.extra.push(a2)
        self.extra.push(a3)
        self.extra.push(a4)
        self.extra.push(a5)
        self.o(IR_SYSC, id, off, 0, d, 0)
        d

    fn ret(&mut self, v : i64):
        self.o(IR_RET, v, 0, 0, 0, 0)

    fn retn(&mut self):
        self.o(IR_RET, ⁻1, 0, 0, 0, 0)

    fn abort_msg(&mut self, strid : i64):
        self.o(IR_ABORT, strid, 0, 0, 0, 0)

    // the same message, on the error stream, without the leaving
    fn eprint_msg(&mut self, strid : i64):
        self.o(IR_EPRINTS, strid, 0, 0, 0, 0)

fn rtb_fn(b : RtB) → IrFn:
    (IrFn{op: b.op, ia: b.ia, ib: b.ib, ic: b.ic, id: b.idd, iw: b.iww,
          extra: b.extra, nvregs: b.ntmp, nlabels: b.nlab, fbytes: 0¤byte})

// each runtime routine, one builder; the id picks it
fn rt_build(id : i64, tg : Target, lw : &mut Lower) → IrFn:
    // the routines every target takes from here, the pioneer with the
    // rest: rt_hash.ngpl and rt_sha256.ngpl write them, and nobody
    // writes them twice
    if id = RT_HSTART: return rt_hstart_ir()
    if id = RT_HUPDATE: return rt_hupdate_ir(&lw)
    if id = RT_HFINAL: return rt_hfinal_ir(&lw)
    if id = RT_SHA256INIT: return rt_sha256init_ir()
    if id = RT_SHA256BLK: return rt_sha256blk_ir()
    if id = RT_SHA256FIN: return rt_sha256fin_ir()
    if id = RT_SIGINIT: return rt_siginit_ir(tg)
    if id = RT_SEGV: return rt_segv_ir(tg, &lw)
    if id = RT_WRITE1 or id = RT_WRITE2:
        // (buf, len): the loop puts every byte down or dies trying
        let b : mut RtB = rtb(2)
        let fd : i64 = b.cst(1 if id = RT_WRITE1 else 2)
        let done : i64 = b.t()
        let z : i64 = b.cst(0)
        b.mov(done, z)
        let ltop : i64 = b.l()
        let lend : i64 = b.l()
        b.lab(ltop)
        let left : i64 = b.sub(1, done)
        b.jz(left, lend)
        let at : i64 = b.add(0, done)
        let r : i64 = b.sys3(SC_WRITE, fd, at, left)
        let bad : i64 = b.clts(r, b.cst(1))
        b.jnz(bad, lend)
        let nd : i64 = b.add(done, r)
        b.mov(done, nd)
        b.jmp(ltop)
        b.lab(lend)
        b.retn()
        return rtb_fn(b)
    if id = RT_ABORT:
        // (buf, len): say it, then leave through exit with a status
        // rather than through a signal
        let b : mut RtB = rtb(2)
        _ ← b.call2(RT_WRITE2, 0, 1)
        _ ← b.sys1(SC_EXIT, b.cst(EXIT_STOP))
        let spin : i64 = b.l()
        b.lab(spin)
        b.jmp(spin)
        return rtb_fn(b)
    if id = RT_OV or id = RT_SHIFT or id = RT_BOUNDS or id = RT_OOM or id = RT_BADCHAR or id = RT_BADFIT:
        let b : mut RtB = rtb(0)
        let msg : mut str = "integer overflow\n"
        if id = RT_SHIFT:
            msg ← "shift count is past the type\n"
        elif id = RT_BOUNDS:
            msg ← "index out of range\n"
        elif id = RT_OOM:
            msg ← "out of memory\n"
        elif id = RT_BADCHAR:
            msg ← "chr: the value is not a code point\n"
        elif id = RT_BADFIT:
            msg ← "the value does not fit the type it meets\n"
        b.abort_msg(lw.intern(msg))
        return rtb_fn(b)
    if id = RT_ALLOC:
        // (size) → address; sixteen-aligned bump over mmap regions
        let b : mut RtB = rtb(1)
        let fifteen : i64 = b.cst(15)
        let mask : i64 = b.cst(⁻16)
        let sz : i64 = b.band(b.add(0, fifteen), mask)
        let k : i64 = b.kaddr(1, 0)
        let nxt : i64 = b.ldn(k, 0, 8)
        let lim : i64 = b.ldn(k, 8, 8)
        let want : i64 = b.add(nxt, sz)
        let fits : i64 = b.cltu(lim, want)
        let lmap : i64 = b.l()
        b.jnz(fits, lmap)
        b.stn(k, 0, want, 8)
        b.ret(nxt)
        b.lab(lmap)
        // a fresh region: at least a mebibyte, whole pages
        let p4 : i64 = b.cst(4095)
        let pmask : i64 = b.cst(⁻4096)
        let len : i64 = b.band(b.add(sz, p4), pmask)
        let meg : i64 = b.cst(1048576)
        let small : i64 = b.cltu(len, meg)
        let len2 : i64 = b.sel(small, meg, len)
        let z2 : i64 = b.cst(0)
        let prot : i64 = b.cst(3)
        let fl : i64 = b.cst(34)
        let m1 : i64 = b.cst(⁻1)
        let r : i64 = b.sys6(SC_MMAP, z2, len2, prot, fl, m1, z2)
        let neg : i64 = b.clts(r, z2)
        let lok : i64 = b.l()
        b.jz(neg, lok)
        _ ← b.call0(RT_OOM)
        b.lab(lok)
        let e : i64 = b.add(r, len2)
        b.stn(k, 8, e, 8)
        let n2 : i64 = b.add(r, sz)
        b.stn(k, 0, n2, 8)
        b.ret(r)
        return rtb_fn(b)
    if id = RT_ARRNEW:
        // (cap) → descriptor {slots, len, cap}, the slots in line
        let b : mut RtB = rtb(1)
        let three : i64 = b.cst(3)
        let hdr : i64 = b.cst(24)
        let sz : i64 = b.add(b.shl(0, three), hdr)
        let h : i64 = b.call1(RT_ALLOC, sz)
        let slots : i64 = b.add(h, hdr)
        b.stn(h, 0, slots, 8)
        let z : i64 = b.cst(0)
        b.stn(h, 8, z, 8)
        b.stn(h, 16, 0, 8)
        b.ret(h)
        return rtb_fn(b)
    if id = RT_ARRPUSH:
        // (h, v): the array grows by doubling when it must
        let b : mut RtB = rtb(2)
        let len : i64 = b.ldn(0, 8, 8)
        let cap : i64 = b.ldn(0, 16, 8)
        let full : i64 = b.ceq(len, cap)
        let lroom : i64 = b.l()
        b.jz(full, lroom)
        let two : i64 = b.cst(2)
        let four : i64 = b.cst(4)
        let ncap0 : i64 = b.mul(cap, two)
        let small : i64 = b.cltu(ncap0, four)
        let ncap : i64 = b.sel(small, four, ncap0)
        let three : i64 = b.cst(3)
        let nb : i64 = b.call1(RT_ALLOC, b.shl(ncap, three))
        let old : i64 = b.ldn(0, 0, 8)
        let ix : i64 = b.t()
        let z : i64 = b.cst(0)
        b.mov(ix, z)
        let lcp : i64 = b.l()
        let lcpe : i64 = b.l()
        b.lab(lcp)
        let more : i64 = b.cltu(ix, len)
        b.jz(more, lcpe)
        let o8 : i64 = b.shl(ix, three)
        let v9 : i64 = b.ldn(b.add(old, o8), 0, 8)
        b.stn(b.add(nb, o8), 0, v9, 8)
        let one : i64 = b.cst(1)
        b.mov(ix, b.add(ix, one))
        b.jmp(lcp)
        b.lab(lcpe)
        b.stn(0, 0, nb, 8)
        b.stn(0, 16, ncap, 8)
        b.lab(lroom)
        let slots : i64 = b.ldn(0, 0, 8)
        let three2 : i64 = b.cst(3)
        b.stn(b.add(slots, b.shl(len, three2)), 0, 1, 8)
        let one2 : i64 = b.cst(1)
        b.stn(0, 8, b.add(len, one2), 8)
        b.retn()
        return rtb_fn(b)
    if id = RT_CONCAT:
        // (a, b) → the joined string, bytes then a fresh descriptor
        let b : mut RtB = rtb(2)
        let la : i64 = b.ldn(0, 8, 8)
        let lb : i64 = b.ldn(1, 8, 8)
        let n : i64 = b.add(la, lb)
        let one : i64 = b.cst(1)
        let small : i64 = b.cltu(n, one)
        let n1 : i64 = b.sel(small, one, n)
        let p : i64 = b.call1(RT_ALLOC, n1)
        let pa : i64 = b.ldn(0, 0, 8)
        rt_copy_bytes(&b, pa, p, la)
        let pb : i64 = b.ldn(1, 0, 8)
        rt_copy_bytes(&b, pb, b.add(p, la), lb)
        let dsc : i64 = b.call1(RT_ALLOC, b.cst(16))
        b.stn(dsc, 0, p, 8)
        b.stn(dsc, 8, n, 8)
        b.ret(dsc)
        return rtb_fn(b)
    if id = RT_STREQ:
        let b : mut RtB = rtb(2)
        let la : i64 = b.ldn(0, 8, 8)
        let lb : i64 = b.ldn(1, 8, 8)
        let same : i64 = b.ceq(la, lb)
        let lno : i64 = b.l()
        b.jz(same, lno)
        let pa : i64 = b.ldn(0, 0, 8)
        let pb : i64 = b.ldn(1, 0, 8)
        let ix : i64 = b.t()
        let z : i64 = b.cst(0)
        b.mov(ix, z)
        let ltop : i64 = b.l()
        let lyes : i64 = b.l()
        b.lab(ltop)
        let more : i64 = b.cltu(ix, la)
        b.jz(more, lyes)
        let ca : i64 = b.ldn(b.add(pa, ix), 0, 1)
        let cb : i64 = b.ldn(b.add(pb, ix), 0, 1)
        let df : i64 = b.cne(ca, cb)
        b.jnz(df, lno)
        let one : i64 = b.cst(1)
        b.mov(ix, b.add(ix, one))
        b.jmp(ltop)
        b.lab(lyes)
        b.ret(b.cst(1))
        b.lab(lno)
        b.ret(b.cst(0))
        return rtb_fn(b)
    if id = RT_STRCHARS:
        // (s) → how many characters: the bytes that begin one
        let b : mut RtB = rtb(1)
        let p : i64 = b.ldn(0, 0, 8)
        let n : i64 = b.ldn(0, 8, 8)
        let cnt : i64 = b.t()
        let ix : i64 = b.t()
        let z : i64 = b.cst(0)
        b.mov(cnt, z)
        b.mov(ix, z)
        let ltop : i64 = b.l()
        let lend : i64 = b.l()
        b.lab(ltop)
        let more : i64 = b.cltu(ix, n)
        b.jz(more, lend)
        let c : i64 = b.ldn(b.add(p, ix), 0, 1)
        let m : i64 = b.cst(192)
        let cont : i64 = b.ceq(b.band(c, m), b.cst(128))
        let one : i64 = b.cst(1)
        let add1 : i64 = b.sel(cont, z, one)
        b.mov(cnt, b.add(cnt, add1))
        b.mov(ix, b.add(ix, one))
        b.jmp(ltop)
        b.lab(lend)
        b.ret(cnt)
        return rtb_fn(b)
    if id = RT_PRINTSTR:
        let b : mut RtB = rtb(1)
        let p : i64 = b.ldn(0, 0, 8)
        let n : i64 = b.ldn(0, 8, 8)
        _ ← b.call2(RT_WRITE1, p, n)
        b.retn()
        return rtb_fn(b)
    if id = RT_PRINTI or id = RT_PRINTU:
        // (v): decimal onto fd 1, built least digit first
        let b : mut RtB = rtb(1)
        let buf : i64 = b.call1(RT_ALLOC, b.cst(24))
        let z : i64 = b.cst(0)
        let neg : mut i64 = z
        if id = RT_PRINTI:
            neg ← b.clts(0, z)
            let nv : i64 = b.sub(z, 0)
            b.mov(0, b.sel(neg, nv, 0))
        let ix : i64 = b.t()
        b.mov(ix, b.cst(24))
        let ten : i64 = b.cst(10)
        let one : i64 = b.cst(1)
        let ltop : i64 = b.l()
        b.lab(ltop)
        let dgt : i64 = b.umod(0, ten)
        b.mov(0, b.udiv(0, ten))
        b.mov(ix, b.sub(ix, one))
        b.stn(b.add(buf, ix), 0, b.add(dgt, b.cst(48)), 1)
        b.jnz(0, ltop)
        if id = RT_PRINTI:
            let lpos : i64 = b.l()
            b.jz(neg, lpos)
            b.mov(ix, b.sub(ix, one))
            b.stn(b.add(buf, ix), 0, b.cst(45), 1)
            b.lab(lpos)
        let n24 : i64 = b.cst(24)
        _ ← b.call2(RT_WRITE1, b.add(buf, ix), b.sub(n24, ix))
        b.retn()
        return rtb_fn(b)
    rt_build2(id, tg, &lw)

// a byte copy the builders above lean on: src, dst, n as vregs
fn rt_copy_bytes(b : &mut RtB, src : i64, dst : i64, n : i64):
    let ix : i64 = b.t()
    let z : i64 = b.cst(0)
    b.mov(ix, z)
    let ltop : i64 = b.l()
    let lend : i64 = b.l()
    b.lab(ltop)
    let more : i64 = b.cltu(ix, n)
    b.jz(more, lend)
    let c : i64 = b.ldn(b.add(src, ix), 0, 1)
    b.stn(b.add(dst, ix), 0, c, 1)
    let one : i64 = b.cst(1)
    b.mov(ix, b.add(ix, one))
    b.jmp(ltop)
    b.lab(lend)

// the rest of the runtime: hashes, characters, the kernel block,
// files, and the array helpers
fn rt_build2(id : i64, tg : Target, lw : &mut Lower) → IrFn:
    if id = RT_HNEW:
        // (cap, iskeystr) → {iskeystr, pairs, count, cap, index, icap}
        let b : mut RtB = rtb(2)
        let h : i64 = b.call1(RT_ALLOC, b.cst(48))
        b.stn(h, 0, 1, 8)
        let four : i64 = b.cst(4)
        let pairs : i64 = b.call1(RT_ALLOC, b.shl(0, four))
        b.stn(h, 8, pairs, 8)
        let z : i64 = b.cst(0)
        b.stn(h, 16, z, 8)
        b.stn(h, 24, 0, 8)
        let one : i64 = b.cst(1)
        let icap : i64 = b.shl(0, one)
        let three : i64 = b.cst(3)
        let idx : i64 = b.call1(RT_ALLOC, b.shl(icap, three))
        rt_zero_words(&b, idx, icap)
        b.stn(h, 32, idx, 8)
        b.stn(h, 40, icap, 8)
        b.ret(h)
        return rtb_fn(b)
    if id = RT_HFIND:
        // (h, key) → (slot « 1) | found: where the key sits in the
        // index, or where it would go
        let b : mut RtB = rtb(2)
        let iskey : i64 = b.ldn(0, 0, 8)
        let hv : i64 = b.t()
        let lraw : i64 = b.l()
        let lgo : i64 = b.l()
        b.jz(iskey, lraw)
        b.mov(hv, rt_hash_str(&b, 1))
        b.jmp(lgo)
        b.lab(lraw)
        // a number's bits, stirred a little
        let k1 : i64 = b.cst(⁻7046029254386353131)
        b.mov(hv, b.mul(1, k1))
        let s33 : i64 = b.cst(33)
        b.mov(hv, b.bor(b.shr(hv, s33), hv))
        b.lab(lgo)
        let icap : i64 = b.ldn(0, 40, 8)
        let one : i64 = b.cst(1)
        let mask : i64 = b.sub(icap, one)
        let pos : i64 = b.t()
        b.mov(pos, b.band(hv, mask))
        let pairs : i64 = b.ldn(0, 8, 8)
        let idx : i64 = b.ldn(0, 32, 8)
        let three : i64 = b.cst(3)
        let four : i64 = b.cst(4)
        let ltop : i64 = b.l()
        let lmiss : i64 = b.l()
        let lnext : i64 = b.l()
        b.lab(ltop)
        let e : i64 = b.ldn(b.add(idx, b.shl(pos, three)), 0, 8)
        b.jz(e, lmiss)
        let pe : i64 = b.add(pairs, b.shl(b.sub(e, one), four))
        let ke : i64 = b.ldn(pe, 0, 8)
        let same : i64 = b.t()
        let lcmp2 : i64 = b.l()
        let lcmpd : i64 = b.l()
        b.jz(iskey, lcmp2)
        b.mov(same, b.call2(RT_STREQ, ke, 1))
        b.jmp(lcmpd)
        b.lab(lcmp2)
        b.mov(same, b.ceq(ke, 1))
        b.lab(lcmpd)
        b.jz(same, lnext)
        b.ret(b.bor(b.shl(pos, one), one))
        b.lab(lnext)
        b.mov(pos, b.band(b.add(pos, one), mask))
        b.jmp(ltop)
        b.lab(lmiss)
        b.ret(b.shl(pos, one))
        return rtb_fn(b)
    if id = RT_HGET:
        let b : mut RtB = rtb(2)
        let f : i64 = b.call2(RT_HFIND, 0, 1)
        let one : i64 = b.cst(1)
        let found : i64 = b.band(f, one)
        let lno : i64 = b.l()
        b.jz(found, lno)
        let v : i64 = rt_hentry_val(&b, f)
        let box : i64 = b.call1(RT_ALLOC, b.cst(8))
        b.stn(box, 0, v, 8)
        b.ret(box)
        b.lab(lno)
        b.ret(b.cst(0))
        return rtb_fn(b)
    if id = RT_HELEM:
        let b : mut RtB = rtb(2)
        let f : i64 = b.call2(RT_HFIND, 0, 1)
        let one : i64 = b.cst(1)
        b.ret(b.band(f, one))
        return rtb_fn(b)
    if id = RT_HPUT:
        let b : mut RtB = rtb(3)
        let f : i64 = b.t()
        b.mov(f, b.call2(RT_HFIND, 0, 1))
        let one : i64 = b.cst(1)
        let found : i64 = b.band(f, one)
        let lnew : i64 = b.l()
        b.jz(found, lnew)
        // only the value changes; the key keeps its place
        let pairs : i64 = b.ldn(0, 8, 8)
        let idx : i64 = b.ldn(0, 32, 8)
        let three : i64 = b.cst(3)
        let four : i64 = b.cst(4)
        let e : i64 = b.ldn(b.add(idx, b.shl(b.shr(f, one), three)), 0, 8)
        b.stn(b.add(pairs, b.shl(b.sub(e, one), four)), 8, 2, 8)
        b.retn()
        b.lab(lnew)
        // grow the index before it clogs: past seven eighths full
        let cnt : i64 = b.ldn(0, 16, 8)
        let icap : i64 = b.ldn(0, 40, 8)
        let three2 : i64 = b.cst(3)
        let lhs : i64 = b.shl(b.add(cnt, b.cst(1)), three2)
        let seven : i64 = b.cst(7)
        let rhs : i64 = b.mul(icap, seven)
        let tight : i64 = b.cltu(rhs, lhs)
        let lroom : i64 = b.l()
        b.jz(tight, lroom)
        _ ← b.call1(RT_HGROW, 0)
        b.mov(f, b.call2(RT_HFIND, 0, 1))
        b.lab(lroom)
        // the pairs block doubles as it fills
        let cnt2 : i64 = b.ldn(0, 16, 8)
        let pcap : i64 = b.ldn(0, 24, 8)
        let lpair : i64 = b.l()
        let full : i64 = b.ceq(cnt2, pcap)
        b.jz(full, lpair)
        let two : i64 = b.cst(2)
        let eight : i64 = b.cst(8)
        let ncap0 : i64 = b.mul(pcap, two)
        let smallp : i64 = b.cltu(ncap0, eight)
        let ncap : i64 = b.sel(smallp, eight, ncap0)
        let four2 : i64 = b.cst(4)
        let np : i64 = b.call1(RT_ALLOC, b.shl(ncap, four2))
        let op : i64 = b.ldn(0, 8, 8)
        rt_zero_words(&b, np, b.cst(0))
        rt_copy_words(&b, op, np, b.shl(cnt2, b.cst(1)))
        b.stn(0, 8, np, 8)
        b.stn(0, 24, ncap, 8)
        b.lab(lpair)
        let pairs2 : i64 = b.ldn(0, 8, 8)
        let four3 : i64 = b.cst(4)
        let pe : i64 = b.add(pairs2, b.shl(cnt2, four3))
        b.stn(pe, 0, 1, 8)
        b.stn(pe, 8, 2, 8)
        let idx2 : i64 = b.ldn(0, 32, 8)
        let three3 : i64 = b.cst(3)
        b.stn(b.add(idx2, b.shl(b.shr(f, b.cst(1)), three3)), 0, b.add(cnt2, b.cst(1)), 8)
        b.stn(0, 16, b.add(cnt2, b.cst(1)), 8)
        b.retn()
        return rtb_fn(b)
    if id = RT_HGROW:
        // (h): a wider index, every entry re-homed by its key
        let b : mut RtB = rtb(1)
        let one : i64 = b.cst(1)
        let three : i64 = b.cst(3)
        let icap : i64 = b.ldn(0, 40, 8)
        let ncap : i64 = b.shl(icap, one)
        let idx : i64 = b.call1(RT_ALLOC, b.shl(ncap, three))
        rt_zero_words(&b, idx, ncap)
        b.stn(0, 32, idx, 8)
        b.stn(0, 40, ncap, 8)
        let cnt : i64 = b.ldn(0, 16, 8)
        let pairs : i64 = b.ldn(0, 8, 8)
        let four : i64 = b.cst(4)
        let e : i64 = b.t()
        let z : i64 = b.cst(0)
        b.mov(e, z)
        let ltop : i64 = b.l()
        let lend : i64 = b.l()
        b.lab(ltop)
        let more : i64 = b.cltu(e, cnt)
        b.jz(more, lend)
        let ke : i64 = b.ldn(b.add(pairs, b.shl(e, four)), 0, 8)
        let f : i64 = b.call2(RT_HFIND, 0, ke)
        b.stn(b.add(idx, b.shl(b.shr(f, one), three)), 0, b.add(e, one), 8)
        b.mov(e, b.add(e, one))
        b.jmp(ltop)
        b.lab(lend)
        b.retn()
        return rtb_fn(b)
    if id = RT_STRIDX or id = RT_STRNEXT:
        // (s, i): the character at a position -- counted in characters
        // for STRIDX, begun at a byte for STRNEXT, which also answers
        // where the next begins, packed above the code point
        let b : mut RtB = rtb(2)
        let p : i64 = b.ldn(0, 0, 8)
        let n : i64 = b.ldn(0, 8, 8)
        let at : i64 = b.t()
        let z : i64 = b.cst(0)
        let one : i64 = b.cst(1)
        if id = RT_STRIDX:
            b.mov(at, z)
            // skip as many characters as the position names
            let want : i64 = b.t()
            b.mov(want, 1)
            let lskip : i64 = b.l()
            let lgot : i64 = b.l()
            b.lab(lskip)
            b.jz(want, lgot)
            let inb : i64 = b.cltu(at, n)
            let lok : i64 = b.l()
            b.jnz(inb, lok)
            _ ← b.call0(RT_BOUNDS)
            b.lab(lok)
            b.mov(at, b.add(at, rt_charlen(&b, p, at)))
            b.mov(want, b.sub(want, one))
            b.jmp(lskip)
            b.lab(lgot)
            let inb2 : i64 = b.cltu(at, n)
            let lok2 : i64 = b.l()
            b.jnz(inb2, lok2)
            _ ← b.call0(RT_BOUNDS)
            b.lab(lok2)
            b.ret(rt_decode(&b, p, at))
        else:
            b.mov(at, 1)
            let cp : i64 = rt_decode(&b, p, at)
            let nxt : i64 = b.add(at, rt_charlen(&b, p, at))
            let s32 : i64 = b.cst(32)
            b.ret(b.bor(b.shl(nxt, s32), cp))
        return rtb_fn(b)
    if id = RT_CHARS:
        let b : mut RtB = rtb(1)
        let p : i64 = b.ldn(0, 0, 8)
        let n : i64 = b.ldn(0, 8, 8)
        let out : i64 = b.call1(RT_ARRNEW, b.cst(4))
        let at : i64 = b.t()
        let z : i64 = b.cst(0)
        b.mov(at, z)
        let ltop : i64 = b.l()
        let lend : i64 = b.l()
        b.lab(ltop)
        let more : i64 = b.cltu(at, n)
        b.jz(more, lend)
        _ ← b.call2(RT_ARRPUSH, out, rt_decode(&b, p, at))
        b.mov(at, b.add(at, rt_charlen(&b, p, at)))
        b.jmp(ltop)
        b.lab(lend)
        b.ret(out)
        return rtb_fn(b)
    if id = RT_CHARSTR:
        // (cp) → a fresh one-character string
        let b : mut RtB = rtb(1)
        let p : i64 = b.call1(RT_ALLOC, b.cst(4))
        let nlen : i64 = b.t()
        let l1 : i64 = b.l()
        let l2 : i64 = b.l()
        let l3 : i64 = b.l()
        let ldone : i64 = b.l()
        let a80 : i64 = b.cst(128)
        let small1 : i64 = b.cltu(0, a80)
        b.jz(small1, l1)
        b.stn(p, 0, 0, 1)
        b.mov(nlen, b.cst(1))
        b.jmp(ldone)
        b.lab(l1)
        let a800 : i64 = b.cst(2048)
        let small2 : i64 = b.cltu(0, a800)
        b.jz(small2, l2)
        let six : i64 = b.cst(6)
        let m3f : i64 = b.cst(63)
        b.stn(p, 0, b.bor(b.cst(192), b.shr(0, six)), 1)
        b.stn(p, 1, b.bor(a80, b.band(0, m3f)), 1)
        b.mov(nlen, b.cst(2))
        b.jmp(ldone)
        b.lab(l2)
        let a10000 : i64 = b.cst(65536)
        let small3 : i64 = b.cltu(0, a10000)
        b.jz(small3, l3)
        let six2 : i64 = b.cst(6)
        let twelve : i64 = b.cst(12)
        let m3f2 : i64 = b.cst(63)
        b.stn(p, 0, b.bor(b.cst(224), b.shr(0, twelve)), 1)
        b.stn(p, 1, b.bor(a80, b.band(b.shr(0, six2), m3f2)), 1)
        b.stn(p, 2, b.bor(a80, b.band(0, m3f2)), 1)
        b.mov(nlen, b.cst(3))
        b.jmp(ldone)
        b.lab(l3)
        let six3 : i64 = b.cst(6)
        let twelve2 : i64 = b.cst(12)
        let e18 : i64 = b.cst(18)
        let m3f3 : i64 = b.cst(63)
        b.stn(p, 0, b.bor(b.cst(240), b.shr(0, e18)), 1)
        b.stn(p, 1, b.bor(a80, b.band(b.shr(0, twelve2), m3f3)), 1)
        b.stn(p, 2, b.bor(a80, b.band(b.shr(0, six3), m3f3)), 1)
        b.stn(p, 3, b.bor(a80, b.band(0, m3f3)), 1)
        b.mov(nlen, b.cst(4))
        b.lab(ldone)
        let dsc : i64 = b.call1(RT_ALLOC, b.cst(16))
        b.stn(dsc, 0, p, 8)
        b.stn(dsc, 8, nlen, 8)
        b.ret(dsc)
        return rtb_fn(b)
    rt_build3(id, tg, &lw)

// how many bytes the character at p+at occupies, from its lead byte
fn rt_charlen(b : &mut RtB, p : i64, at : i64) → i64:
    let c : i64 = b.ldn(b.add(p, at), 0, 1)
    let one : i64 = b.cst(1)
    let n : i64 = b.t()
    b.mov(n, one)
    let l1 : i64 = b.l()
    let c1 : i64 = b.cltu(c, b.cst(128))
    b.jnz(c1, l1)
    b.mov(n, b.cst(2))
    let c2 : i64 = b.cltu(c, b.cst(224))
    b.jnz(c2, l1)
    b.mov(n, b.cst(3))
    let c3 : i64 = b.cltu(c, b.cst(240))
    b.jnz(c3, l1)
    b.mov(n, b.cst(4))
    b.lab(l1)
    n

// the code point beginning at p+at, the input already known valid
fn rt_decode(b : &mut RtB, p : i64, at : i64) → i64:
    let c : i64 = b.ldn(b.add(p, at), 0, 1)
    let cp : i64 = b.t()
    let l1 : i64 = b.l()
    let l2 : i64 = b.l()
    let l3 : i64 = b.l()
    let ldone : i64 = b.l()
    let six : i64 = b.cst(6)
    let m3f : i64 = b.cst(63)
    let one : i64 = b.cst(1)
    let two : i64 = b.cst(2)
    let three : i64 = b.cst(3)
    let c1 : i64 = b.cltu(c, b.cst(128))
    b.jz(c1, l1)
    b.mov(cp, c)
    b.jmp(ldone)
    b.lab(l1)
    let b1 : i64 = b.band(b.ldn(b.add(b.add(p, at), one), 0, 1), m3f)
    let c2 : i64 = b.cltu(c, b.cst(224))
    b.jz(c2, l2)
    b.mov(cp, b.bor(b.shl(b.band(c, b.cst(31)), six), b1))
    b.jmp(ldone)
    b.lab(l2)
    let b2 : i64 = b.band(b.ldn(b.add(b.add(p, at), two), 0, 1), m3f)
    let c3 : i64 = b.cltu(c, b.cst(240))
    b.jz(c3, l3)
    b.mov(cp, b.bor(b.bor(b.shl(b.band(c, b.cst(15)), b.cst(12)), b.shl(b1, six)), b2))
    b.jmp(ldone)
    b.lab(l3)
    let b3 : i64 = b.band(b.ldn(b.add(b.add(p, at), three), 0, 1), m3f)
    b.mov(cp, b.bor(b.bor(b.bor(b.shl(b.band(c, b.cst(7)), b.cst(18)), b.shl(b1, b.cst(12))), b.shl(b2, six)), b3))
    b.lab(ldone)
    cp

// FNV-1a over a descriptor's bytes; the descriptor rides slot `slot`
fn rt_hash_str(b : &mut RtB, slot : i64) → i64:
    let p : i64 = b.ldn(slot, 0, 8)
    let n : i64 = b.ldn(slot, 8, 8)
    let h : i64 = b.t()
    b.mov(h, b.cst(⁻3750763034362895579))
    let ix : i64 = b.t()
    let z : i64 = b.cst(0)
    b.mov(ix, z)
    let prime : i64 = b.cst(1099511628211)
    let one : i64 = b.cst(1)
    let ltop : i64 = b.l()
    let lend : i64 = b.l()
    b.lab(ltop)
    let more : i64 = b.cltu(ix, n)
    b.jz(more, lend)
    let c : i64 = b.ldn(b.add(p, ix), 0, 1)
    let x : i64 = b.t()
    b.o(IR_BXORR, h, c, 0, x, 64 + 256)
    b.mov(h, b.mul(x, prime))
    b.mov(ix, b.add(ix, one))
    b.jmp(ltop)
    b.lab(lend)
    h

// n zero words at p
fn rt_zero_words(b : &mut RtB, p : i64, n : i64):
    let ix : i64 = b.t()
    let z : i64 = b.cst(0)
    b.mov(ix, z)
    let three : i64 = b.cst(3)
    let one : i64 = b.cst(1)
    let ltop : i64 = b.l()
    let lend : i64 = b.l()
    b.lab(ltop)
    let more : i64 = b.cltu(ix, n)
    b.jz(more, lend)
    b.stn(b.add(p, b.shl(ix, three)), 0, z, 8)
    b.mov(ix, b.add(ix, one))
    b.jmp(ltop)
    b.lab(lend)

// n words from src to dst
fn rt_copy_words(b : &mut RtB, src : i64, dst : i64, n : i64):
    let ix : i64 = b.t()
    let z : i64 = b.cst(0)
    b.mov(ix, z)
    let three : i64 = b.cst(3)
    let one : i64 = b.cst(1)
    let ltop : i64 = b.l()
    let lend : i64 = b.l()
    b.lab(ltop)
    let more : i64 = b.cltu(ix, n)
    b.jz(more, lend)
    let o8 : i64 = b.shl(ix, three)
    b.stn(b.add(dst, o8), 0, b.ldn(b.add(src, o8), 0, 8), 8)
    b.mov(ix, b.add(ix, one))
    b.jmp(ltop)
    b.lab(lend)

// the value half of the pair a find answered
fn rt_hentry_val(b : &mut RtB, f : i64) → i64:
    let one : i64 = b.cst(1)
    let three : i64 = b.cst(3)
    let four : i64 = b.cst(4)
    let idx : i64 = b.ldn(0, 32, 8)
    let e : i64 = b.ldn(b.add(idx, b.shl(b.shr(f, one), three)), 0, 8)
    let pairs : i64 = b.ldn(0, 8, 8)
    b.ldn(b.add(pairs, b.shl(b.sub(e, one), four)), 8, 8)

// the last of the runtime: the kernel block, files, directories, and
// the array helpers
fn rt_build3(id : i64, tg : Target, lw : &mut Lower) → IrFn:
    let pw : i64 = tg.ptr
    if id = RT_ARGS or id = RT_ENVN:
        let b : mut RtB = rtb(0)
        let k : i64 = b.kaddr(0, 0)
        let out : i64 = b.call1(RT_ARRNEW, b.cst(4))
        let vptr : i64 = b.t()
        b.mov(vptr, b.ldn(k, 8 if id = RT_ARGS else 16, 8))
        let left : i64 = b.t()
        if id = RT_ARGS:
            b.mov(left, b.ldn(k, 0, 8))
        let pwc : i64 = b.cst(pw)
