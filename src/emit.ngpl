let arch_x86_64 := @import("./arch_x86_64.ngpl")

// ===========================================================================
// The emitter: the buffer every backend writes its code into
// ===========================================================================
//
// What is here belongs to no architecture.  `Emit` is the output
// buffer -- bytes, labels, the patches a forward jump leaves behind,
// the offsets a symbol is taken from -- and all six backends write
// through it, the hand-tuned x86-64 emitter and the shared driver
// alike.  So are the runtime routines' identities, which name the same
// routine whether it is spelled by hand or built as IR, and the tables
// the UTF-8 decoder runs on, which are data rather than code.


@export
let R_AX : i64 = 0
@export
let R_CX : i64 = 1
@export
let R_DX : i64 = 2
@export
let R_SI : i64 = 6
@export
let R_DI : i64 = 7
@export
let R_R8 : i64 = 8
@export
let R_R9 : i64 = 9
@export
let R_R10 : i64 = 10
@export
let R_R11 : i64 = 11

// runtime routine ids, call targets below the user functions
@export
let RT_PRINTI : i64 = ⁻1
@export
let RT_WRITE1 : i64 = ⁻2
@export
let RT_ABORT : i64 = ⁻3
@export
let RT_OV : i64 = ⁻4
@export
let RT_SHIFT : i64 = ⁻5
@export
let RT_BOUNDS : i64 = ⁻6
@export
let RT_OOM : i64 = ⁻7
@export
let RT_ALLOC : i64 = ⁻8
@export
let RT_ARRNEW : i64 = ⁻9
@export
let RT_ARRPUSH : i64 = ⁻10
@export
let RT_CONCAT : i64 = ⁻11
@export
let RT_STREQ : i64 = ⁻12
@export
let RT_STRCHARS : i64 = ⁻13
@export
let RT_PRINTSTR : i64 = ⁻14
@export
let RT_PRINTU : i64 = ⁻15
@export
let RT_HNEW : i64 = ⁻16
@export
let RT_HFIND : i64 = ⁻17
@export
let RT_HGET : i64 = ⁻18
@export
let RT_HPUT : i64 = ⁻19
@export
let RT_HELEM : i64 = ⁻20
@export
let RT_HGROW : i64 = ⁻21
@export
let RT_BADCHAR : i64 = ⁻22
@export
let RT_STRIDX : i64 = ⁻23
@export
let RT_CHARS : i64 = ⁻24
@export
let RT_CHARSTR : i64 = ⁻25
@export
let RT_ARGS : i64 = ⁻26
@export
let RT_FOPEN : i64 = ⁻27
@export
let RT_FCREATE : i64 = ⁻28
@export
let RT_FREAD : i64 = ⁻29
@export
let RT_FWRITE : i64 = ⁻30
@export
let RT_BADFIT : i64 = ⁻31
@export
let RT_WRITE2 : i64 = ⁻32
@export
let RT_AFIND : i64 = ⁻33
@export
let RT_ASLICE : i64 = ⁻34
@export
let RT_AFILL : i64 = ⁻35
@export
let RT_ACYC : i64 = ⁻36
@export
let RT_ACAT : i64 = ⁻37
@export
let RT_SBYTES : i64 = ⁻38
@export
let RT_DENTS : i64 = ⁻39
@export
let RT_ENVN : i64 = ⁻40
@export
let RT_ENVG : i64 = ⁻41
@export
let RT_AUXV : i64 = ⁻42
@export
let RT_EXECFN : i64 = ⁻43
@export
let RT_RELRO : i64 = ⁻44
@export
let RT_STRNEXT : i64 = ⁻45
@export
let RT_TORAW : i64 = ⁻46
@export
let RT_WRITEV : i64 = ⁻47
// the software arithmetic a 32-bit target leans on; a 64-bit target
// never calls these and never carries them
@export
let RT_DIVU64 : i64 = ⁻48
@export
let RT_MODU64 : i64 = ⁻49
@export
let RT_DIVS64 : i64 = ⁻50
@export
let RT_MODS64 : i64 = ⁻51
@export
let RT_MULOV64 : i64 = ⁻52
// Digests.  Unlike every routine above them these are written as IR
// for all six targets rather than twice -- rt_hash.ngpl and
// rt_sha256.ngpl hold them, and the pioneer compiles the same IR the
// other five do.  The first three are what a program reaches; the last
// three are SHA-256's own, and are where a second algorithm would add
// its own three.
@export
let RT_HSTART : i64 = ⁻53
@export
let RT_HUPDATE : i64 = ⁻54
@export
let RT_HFINAL : i64 = ⁻55
@export
let RT_SHA256INIT : i64 = ⁻56
@export
let RT_SHA256BLK : i64 = ⁻57
@export
let RT_SHA256FIN : i64 = ⁻58
// The stack running out, told from any other fault by the address it
// happened at, and the trampoline the kernel needs to return through.
@export
let RT_SEGV : i64 = ⁻59
@export
let RT_SIGRET : i64 = ⁻60
@export
let RT_SIGINIT : i64 = ⁻61
@export
let RT_FREE : i64 = ⁻62      // give a block back to the allocator
// int, the arbitrary-precision integer: rt_bigint.ngpl writes these
@export
let RT_BIGFROM : i64 = ⁻63   // (v) → the int v is
@export
let RT_BIGCMP : i64 = ⁻64    // (a, b) → ⁻1, 0 or 1
@export
let RT_BIGADD : i64 = ⁻65    // (a, b, negb) → a + b, or a - b
@export
let RT_BIGMUL : i64 = ⁻66    // (a, b) → a × b
@export
let RT_BIGPRINT : i64 = ⁻67  // (a) → written to stdout
// The call stack a stopped program leaves behind: rt_backtrace.ngpl
// writes it, and every stop goes through RT_ABORT to reach it.
@export
let RT_BT : i64 = ⁻68        // () → the program's own frames, on the error stream
// (s, lo, hi) → the characters of s from lo up to hi, as a string of
// their own.  A string is immutable, so the cut shares the bytes.
@export
let RT_SSLICE : i64 = ⁻69

// (fd, which) → what says which file this is: the device it is on
// where `which` is 0, its number on that device where `which` is 1.
// Two names answer for one file exactly when both agree.
@export
let RT_FIDENT : i64 = ⁻70

// ---------------------------------------------------------------------------
// What the allocator keeps
// ---------------------------------------------------------------------------
//
// A bump pointer and its limit, and then a table of free lists so that
// a block given back can be handed out again.  The table is direct
// mapped by size -- slot (size ÷ 16) mod AL_SLOTS -- and a block that
// lands in a slot beside a block of another size is simply not reused,
// since every hand-out checks the size it finds against the size it
// wants.  A wrong answer here is a block used as two things at once,
// so the check is exact and never a range.
//
// A free block holds its own list: the next block at its first word
// and its own size at the second, which is why nothing smaller than
// two words is ever given back.
let AL_NEXT : i64 = 0        // the bump pointer
let AL_LIM : i64 = 8         // …and where the region ends
@export
let AL_FREE : i64 = 16       // the free lists begin here
@export
let AL_SLOTS : i64 = 256
// Which slot a size takes.  Not the size itself: the sizes that matter
// are an array's capacities, which double, so taking the low bits of
// them sends every large one to the same slot and large blocks are
// what a program has most of.  A multiply and a shift spread the
// doubling sizes over the whole table -- twenty of them to twenty
// slots, where the low bits gave seven and then a pile.
@export
let AL_MIX : i64 = 625093777      // 0x2545F491, odd, and fits an imm32
@export
let AL_SHIFT : i64 = 20
@export
let AL_SIZE : i64 = 2064     // AL_FREE + 8 × AL_SLOTS
@export
let FB_NEXT : i64 = 0        // in a free block: the next one
@export
let FB_SIZE : i64 = 8        // …and how big this one is

// ---------------------------------------------------------------------------
// The data a program keeps beside its code
// ---------------------------------------------------------------------------
//
// The kernel block first: four cells of what the kernel handed over,
// then the three the stack is described by.  A program that runs out
// of stack faults on the guard, and the handler tells that fault from
// any other by asking whether the address it was given lies between
// the first two.  The third says where the stack ends, which is what
// bounds the walk a backtrace makes over the frames.  All seven are
// written once at startup and sealed with the rest of the relro, so
// nothing the program does afterwards can move the goalposts.
let KB_ARGC : i64 = 0
let KB_ARGV : i64 = 8
let KB_ENVP : i64 = 16
let KB_AUXV : i64 = 24
@export
let KB_GLO : i64 = 32       // the foot of the reservation: the guard begins
@export
let KB_GHI : i64 = 40       // …and ends, where the usable stack begins
@export
let KB_STOP : i64 = 48      // …and one past the top of that stack
@export
let KB_SIZE : i64 = 56

// And in the writable data, the two structures the kernel is handed at
// startup.  Writable rather than sealed because the handler writes the
// first of them again: a fault that is not the guard puts the default
// action back and returns, so the program dies of it exactly as it
// would have, core dump and all.
@export
let SIG_ACT : i64 = 0       // struct sigaction
@export
let SIG_ALT : i64 = 32      // stack_t
@export
let SIG_SIZE : i64 = 64

// The stack the handler runs on.  The one that ran out is no place to
// put a frame, which is the whole reason sigaltstack exists.
@export
let SIGALT_BYTES : i64 = 16384
@export
let SIGSEGV_NO : i64 = 11
// SA_SIGINFO, which asks for the faulting address, with SA_ONSTACK,
// and SA_RESTORER where the architecture wants one
@export
let SA_FLAGS_R : i64 = 201326596
@export
let SA_FLAGS_N : i64 = 134217732

// ---------------------------------------------------------------------------
// How a program stops
// ---------------------------------------------------------------------------
//
// A program the runtime stops leaves through exit with a status, never
// through a signal.  A signal is not a status: a shell reports it as
// 128 plus the number, which collides with whatever a program might
// have chosen to exit with, and a caller has to know to look for it.
// Sixty-four through a hundred and twenty-seven are reserved for these
// stops, which leaves 0…63 to the program and 128… to signals a
// program really did die of.
//
// Sixty-four is the general one, for a stop with no more particular
// number yet.  A particular stop takes 64 plus its place in the
// std.errors runtime block, so stack exhaustion -- std.errors
// .stack_overflow, which is 102 -- is 66.
@export
let EXIT_STOP : i64 = 64
@export
let EXIT_STACK_OVERFLOW : i64 = 66

// what a program says when its stack runs out
@export
fn stack_overflow_msg() → str:
    "stack overflow: the program ran past the bottom of its stack\n"

@export
struct Emit:
    code : u8[]
    cf_pos : i64[]       // rel32 fixups against functions/runtime
    cf_target : i64[]
    sf_pos : i64[]       // abs64 fixups against a string's bytes
    sf_str : i64[]
    sd_pos : i64[]       // abs64 fixups against a string's descriptor
    sd_str : i64[]
    df_pos : i64[]       // abs64 fixups against the data segment
    df_off : i64[]
    labels : i64[]
    lf_pos : i64[]
    lf_label : i64[]
    fn_off : i64[]
    rt_off : i64[]
    // which vreg's value rax is known to hold, ⁻1 for none: the
    // cheapest of register allocations, one register deep
    rax_slot : i64
    // A slot whose store is to be dropped rather than written: the
    // emitter has been told that nothing will read it from memory, so
    // rax holding it is enough.  Set for one operation at a time by
    // whoever can see that far, and cleared as soon as it is used.
    drop_slot : i64
    // The slot whose value is sitting in the accumulator and was never
    // written to memory, for the five targets that have no memo of
    // their own.  Set when a store is dropped and read by the load that
    // follows it, which the drop was only allowed because it knew.
    hold_slot : i64
    // Which parameters are still sitting in the register they arrived
    // in, one entry per argument register.  A parameter whose every
    // read happens before anything can have written over that register
    // never needs the spill the prologue would make for it.
    pkeep : i64[]
    // whether the function being emitted takes the private convention,
    // which decides where its own parameters arrived
    self_priv : i64
    // jump tables: abs64 fixups, and the resolved code offsets the
    // tables hold, flattened with a start index per table
    jt_pos : i64[]
    jt_id : i64[]
    jt_count : i64
    jt_starts : i64[]
    jt_is_code : i64[]
    jt_entries : i64[]
    pj_id : i64[]
    pj_start : i64[]
    pj_len : i64[]
    // the deepest frame any function claims: the guard below the stack
    // must be at least this, or one 'sub rsp' could step over it
    max_frame : i64
    // where each global lives: gseg 0 for the read-only segment and 1
    // for the writable one, gmap the offset within it
    gmap : i64[]
    gseg : i64[]
    gr_pos : i64[]       // abs64 fixups against a global held in rodata
    gr_off : i64[]
    skipping : i64       // 1 while a routine nobody calls goes by
    rt_need : i64[]      // which runtime routines the program reaches
    rx : u8[]            // constant tables the runtime reads, in rodata
    rx_pos : i64[]       // abs64 fixups against them
    rx_off : i64[]
    bt_pos : i64[]       // abs fixups against the backtrace table
    // one stub per way a function reports a stop, and the label it got
    ab_kind : i64[]
    ab_lab : i64[]
    pj_labels : i64[]
    // the retargetable driver's fixups: local branches with their
    // instruction form, and function-address materializations
    tf_pos : i64[]
    tf_lab : i64[]
    tf_form : i64[]
    ff_pos : i64[]
    ff_fn : i64[]
    // where the kernel block, the allocator's cells and the signal
    // structures sit in the data segment, for IR_KADDR
    k_args : i64
    k_alloc : i64
    k_sig : i64

// Where the emitter had got to, in every list it goes on appending to
// past the end of a function.  Taken before a function is written and
// given back when it turns out not to fit where it was written: the
// bytes go, and so does every fixup they asked for, and the function
// is written again somewhere it does fit.
//
// The per-function lists are not here.  Labels, their fixups, the
// pending jump tables and the abort stubs are all emptied by the time
// a function ends, so there is nothing of them left to give back.
@export
struct Emark:
    code : i64
    cf : i64
    sf : i64
    sd : i64
    df : i64
    jt : i64
    jts : i64
    jte : i64
    jtn : i64
    gr : i64
    rx : i64
    bt : i64
    ff : i64

impl Emit:
    // One word of a fixed-width instruction set, little-endian;
    // respects the skipping switch.  It lives with the emitter rather
    // than with the architecture that writes them, because a method
    // belongs to the type it is a method of: a module names its own.
    fn aw(&mut self, w : i64):
        self.w32(w)

    // a local branch on such a machine: the word goes down with a zero
    // displacement and the form says which immediate field the
    // resolver fills
    fn a64_bfix(&mut self, word : i64, lab : i64, form : i64):
        self.tf_pos.push(self.here())
        self.tf_lab.push(lab)
        self.tf_form.push(form)
        self.aw(word)

    fn here(&self) → i64:
        @dropunit(#self.code)

    fn mark(&self) → Emark:
        (Emark{code: @dropunit(#self.code), cf: @dropunit(#self.cf_pos),
               sf: @dropunit(#self.sf_pos), sd: @dropunit(#self.sd_pos),
               df: @dropunit(#self.df_pos), jt: @dropunit(#self.jt_pos),
               jts: @dropunit(#self.jt_starts), jte: @dropunit(#self.jt_entries),
               jtn: self.jt_count, gr: @dropunit(#self.gr_pos),
               rx: @dropunit(#self.rx_pos), bt: @dropunit(#self.bt_pos),
               ff: @dropunit(#self.ff_pos)})

    // Everything written since the mark, unwritten.  Each list is
    // appended to in order, so its length at the mark is a position in
    // it and truncating back to that length is exact.
    @pre(m.code <= @dropunit(#self.code))
    fn rewind(&mut self, m : Emark):
        while @dropunit(#self.code) > m.code:
            _ ← self.code.pop() ?? 0
        while @dropunit(#self.cf_pos) > m.cf:
            _ ← self.cf_pos.pop() ?? 0
            _ ← self.cf_target.pop() ?? 0
        while @dropunit(#self.sf_pos) > m.sf:
            _ ← self.sf_pos.pop() ?? 0
            _ ← self.sf_str.pop() ?? 0
        while @dropunit(#self.sd_pos) > m.sd:
            _ ← self.sd_pos.pop() ?? 0
            _ ← self.sd_str.pop() ?? 0
        while @dropunit(#self.df_pos) > m.df:
            _ ← self.df_pos.pop() ?? 0
            _ ← self.df_off.pop() ?? 0
        while @dropunit(#self.jt_pos) > m.jt:
            _ ← self.jt_pos.pop() ?? 0
            _ ← self.jt_id.pop() ?? 0
        while @dropunit(#self.jt_starts) > m.jts:
            _ ← self.jt_starts.pop() ?? 0
            _ ← self.jt_is_code.pop() ?? 0
        while @dropunit(#self.jt_entries) > m.jte:
            _ ← self.jt_entries.pop() ?? 0
        self.jt_count ← m.jtn
        while @dropunit(#self.gr_pos) > m.gr:
            _ ← self.gr_pos.pop() ?? 0
            _ ← self.gr_off.pop() ?? 0
        while @dropunit(#self.rx_pos) > m.rx:
            _ ← self.rx_pos.pop() ?? 0
            _ ← self.rx_off.pop() ?? 0
        while @dropunit(#self.bt_pos) > m.bt:
            _ ← self.bt_pos.pop() ?? 0
        while @dropunit(#self.ff_pos) > m.ff:
            _ ← self.ff_pos.pop() ?? 0
            _ ← self.ff_fn.pop() ?? 0
        assert(@dropunit(#self.code) = m.code, "the cursor is back where the mark was")

    // A routine the program never calls is emitted nowhere: while this
    // is set, every byte and every fixup the emitter is handed goes
    // into the ground.  Nothing else has to know.
    fn b1(&mut self, a : i64):
        if self.skipping = 1:
            return
        self.code.push(a & 255)

    fn b2(&mut self, a : i64, b : i64):
        self.b1(a)
        self.b1(b)

    fn b3(&mut self, a : i64, b : i64, c : i64):
        self.b1(a)
        self.b1(b)
        self.b1(c)

    fn b4(&mut self, a : i64, b : i64, c : i64, d : i64):
        self.b1(a)
        self.b1(b)
        self.b1(c)
        self.b1(d)

    fn w32(&mut self, v : i64):
        self.b1(v)
        self.b1(v » 8)
        self.b1(v » 16)
        self.b1(v » 24)

    fn w64(&mut self, v : i64):
        self.w32(v)
        self.w32(v » 32)

    fn patch32(&mut self, pos : i64, v : i64):
        // A fixup is as much a byte the emitter was handed as a byte
        // is: while a routine nobody calls goes by, the place it would
        // have patched was never written either.
        if self.skipping = 1:
            return
        self.code[pos × 1¤byte] ← v & 255
        self.code[(pos + 1) × 1¤byte] ← (v » 8) & 255
        self.code[(pos + 2) × 1¤byte] ← (v » 16) & 255
        self.code[(pos + 3) × 1¤byte] ← (v » 24) & 255

    fn patch64(&mut self, pos : i64, v : i64):
        if self.skipping = 1:
            return
        self.patch32(pos, v)
        self.patch32(pos + 4, v » 32)

    // Forget that any parameter is in reg, reg having just been written
    fn pkill(&mut self, reg : i64):
        if #self.pkeep > 0:
            foreach j := 0…#self.pkeep:
                if arch_x86_64.arg_reg_p(@dropunit(j), self.self_priv) = reg:
                    self.pkeep[j] ← 0

    fn pclear(&mut self):
        while #self.pkeep > 0:
            _ ← self.pkeep.pop() ?? 0

    fn load(&mut self, reg : i64, slot : i64):
        // A parameter still in the register it came in: a move from
        // there, or nothing at all where it is already where it is
        // wanted.  The prologue skipped its spill on the strength of
        // this, so the two decide the same way or neither is right.
        if slot >= 0 and slot < @dropunit(#self.pkeep) and self.pkeep[slot × 1¤ptrdiff] = 1:
            let src : i64 = arch_x86_64.arg_reg_p(slot, self.self_priv)
            if src ≠ reg:
                self.b1(72 + (if src >= 8: 4 else: 0) + (if reg >= 8: 1 else: 0))
                self.b1(137)
                self.b1(192 + ((src & 7) « 3) + (reg & 7))
                // whatever had been in the register it was moved into is
                // gone; where nothing was written, nothing is gone, and
                // a parameter read twice is still there for the second
                self.pkill(reg)
            if reg = 0:
                self.rax_slot ← slot
            return
        if reg = 0:
            if self.rax_slot = slot:
                return
            self.rax_slot ← slot
        self.b1(72 + (if reg >= 8: 4 else: 0))
        self.b1(139)
        self.b1(133 + ((reg & 7) « 3))
        self.w32(0 - 8 × (slot + 1))

    fn store(&mut self, reg : i64, slot : i64):
        // A store nothing will read is a store not worth making.  rax
        // goes on holding the value, which is where the one operation
        // that wants it is about to look.
        if reg = 0 and slot = self.drop_slot:
            self.rax_slot ← slot
            self.drop_slot ← ⁻1
            return
        if reg = 0:
            self.rax_slot ← slot
        elif slot = self.rax_slot:
            // another register overwrites the slot rax mirrors
            self.rax_slot ← ⁻1
        self.b1(72 + (if reg >= 8: 4 else: 0))
        self.b1(137)
        self.b1(133 + ((reg & 7) « 3))
        self.w32(0 - 8 × (slot + 1))

    // anything that may change rax or be jumped to forgets the memo
    fn raxbar(&mut self):
        self.rax_slot ← ⁻1

    fn movimm(&mut self, reg : i64, v : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        self.w64(v)

    fn jlocal(&mut self, opcode2 : i64, l : i64):
        if opcode2 = ⁻1:
            self.b1(233)
        else:
            self.b2(15, opcode2)
        if self.skipping = 0:
            self.lf_pos.push(self.here())
            self.lf_label.push(l)
        self.w32(0)

    // The displacement of a RIP-relative reference to a routine, for
    // the one thing that wants a routine's address rather than a jump
    // to it: handing a handler to the kernel.  It rides the same
    // fixups a call does, and so drags the routine in behind it the
    // same way -- a handler nobody reaches would otherwise be left
    // out, and the address would resolve to nowhere.
    fn gref_code(&mut self, target : i64):
        if self.skipping = 0:
            self.cf_pos.push(self.here())
            self.cf_target.push(target)
        self.w32(0)

    fn jglobal(&mut self, opcode : i64, opcode2 : i64, target : i64):
        if opcode2 = ⁻1 and opcode = 232:
            // a call clobbers rax
            self.raxbar()
        if opcode2 = ⁻1:
            self.b1(opcode)
        else:
            self.b2(15, opcode2)
        if self.skipping = 0:
            self.cf_pos.push(self.here())
            self.cf_target.push(target)
        self.w32(0)

    // The failing side of a check jumps to a stub of its own rather
    // than straight at the routine that reports it.  The stub is one
    // call, laid at the end of the function where nothing runs into
    // it, and what it buys is a return address: a backtrace reads the
    // chain of frames, and a jump out of a function leaves no return
    // address, so the function it jumped out of -- the one the stop
    // happened in, the one a reader wants first -- would be the one
    // name missing.  The hot path is what it was, one conditional jump
    // that is not taken, only now to a nearer place.  One stub serves
    // every check in a function that reports the same way.
    fn jabort(&mut self, opcode2 : i64, target : i64):
        let at : mut i64 = ⁻1
        if #self.ab_kind > 0:
            foreach i := 0…#self.ab_kind:
                if self.ab_kind[i] = target:
                    at ← self.ab_lab[i]
        if at = ⁻1:
            self.labels.push(⁻1)
            at ← @dropunit(#self.labels) - 1
            self.ab_kind.push(target)
            self.ab_lab.push(at)
        self.jlocal(opcode2, at)

    // …and the stubs themselves, once the body is behind them.
    // Nothing returns from one, so a call is the whole of it.
    fn abort_stubs(&mut self):
        if #self.ab_kind > 0:
            foreach i := 0…#self.ab_kind:
                self.set_label(self.ab_lab[i])
                self.jglobal(232, ⁻1, self.ab_kind[i])
        while #self.ab_kind > 0:
            _ ← self.ab_kind.pop() ?? 0
            _ ← self.ab_lab.pop() ?? 0

    fn set_label(&mut self, l : i64):
        // a label is a join point; what rax held on one way in says
        // nothing about the others
        self.raxbar()
        self.labels[l × 1¤ptrdiff] ← self.here()

    fn resolve_locals(&mut self):
        if #self.lf_pos > 0:
            foreach i := 0…#self.lf_pos:
                let pos : i64 = self.lf_pos[i]
                let target : i64 = self.labels[self.lf_label[i] × 1¤ptrdiff]
                // an unset label once escaped this path as begin_fn(1)
                // against a routine that used two
                assert(target ≠ ⁻1, "every jumped-to label was placed")
                self.patch32(pos, target - (pos + 4))
        while #self.lf_pos > 0:
            _ ← self.lf_pos.pop() ?? 0
            _ ← self.lf_label.pop() ?? 0

    fn begin_fn(&mut self, nlabels : i64):
        self.raxbar()
        while #self.labels > 0:
            _ ← self.labels.pop() ?? 0
        foreach i := 0…nlabels:
            self.labels.push(⁻1)

    fn sref(&mut self, reg : i64, stridx : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.sf_pos.push(self.here())
            self.sf_str.push(stridx)
        self.w64(0)

    fn sdref(&mut self, reg : i64, stridx : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.sd_pos.push(self.here())
            self.sd_str.push(stridx)
        self.w64(0)

    fn jtref(&mut self, reg : i64, id : i64):
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.jt_pos.push(self.here())
            self.jt_id.push(id)
        self.w64(0)

    fn resolve_jtabs(&mut self):
        if #self.pj_id > 0:
            foreach i := 0…#self.pj_id:
                self.jt_starts.push(@dropunit(#self.jt_entries))
                let n0 : i64 = self.pj_len[i]
                let st : i64 = self.pj_start[i]
                if n0 < 0:
                    // a value table: the entries are the data itself
                    let n : i64 = 0 - n0
                    self.jt_is_code.push(0)
                    foreach j := 0…n:
                        self.jt_entries.push(self.pj_labels[(st + j) × 1¤ptrdiff])
                    continue
                self.jt_is_code.push(1)
                let n : i64 = n0
                foreach j := 0…n:
                    let off2 : i64 = self.labels[self.pj_labels[(st + j) × 1¤ptrdiff] × 1¤ptrdiff]
                    assert(off2 ≠ ⁻1, "every table target was placed")
                    self.jt_entries.push(off2)
        while #self.pj_id > 0:
            _ ← self.pj_id.pop() ?? 0
            _ ← self.pj_start.pop() ?? 0
            _ ← self.pj_len.pop() ?? 0
        while #self.pj_labels > 0:
            _ ← self.pj_labels.pop() ?? 0

    // A runtime routine is found through its negative id, which indexes
    // this list -- so each one says which it is and is written where it
    // belongs, rather than wherever it happened to be emitted.  One the
    // program never reaches is passed over: the switch stays on until
    // the next routine says otherwise, and everything between goes
    // nowhere.
    fn rt_begin(&mut self, id : i64):
        let k : i64 = 0 - id - 1
        assert(k >= 0 and k < @dropunit(#self.rt_off), """a runtime routine's id is one of the
                " list's""")
        assert(self.rt_off[k × 1¤ptrdiff] = ⁻1, "a runtime routine was emitted twice")
        self.skipping ← 1 - self.rt_need[k × 1¤ptrdiff]
        // a routine that is passed over is left without a place, so a
        // call that somehow reaches for it has nowhere to land and the
        // resolution says so
        if self.skipping = 0:
            self.rt_off[k × 1¤ptrdiff] ← self.here()

    fn dref(&mut self, reg : i64, off : i64):
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.df_pos.push(self.here())
            self.df_off.push(off)
        self.w64(0)

    // a table the runtime reads is constant, so it rides in rodata
    // beside the strings; this is where its address is asked for
    fn rxref(&mut self, reg : i64, off : i64):
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.rx_pos.push(self.here())
            self.rx_off.push(off)
        self.w64(0)

    // the backtrace table rides in rodata too, and there is one of it,
    // so where it is asked for is all that has to be written down
    fn btref(&mut self, reg : i64):
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.bt_pos.push(self.here())
        self.w64(0)

    // a global that is never written lives with the other read-only
    // things, so its address is fixed against rodata instead
    fn groref(&mut self, reg : i64, off : i64):
        self.b1(72 + (if reg >= 8: 1 else: 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.gr_pos.push(self.here())
            self.gr_off.push(off)
        self.w64(0)

    // whichever of the two a global asks for
    fn gref(&mut self, reg : i64, g : i64):
        if self.gseg[g × 1¤ptrdiff] = 0:
            self.groref(reg, self.gmap[g × 1¤ptrdiff])
        else:
            self.dref(reg, self.gmap[g × 1¤ptrdiff])

    // The same arithmetic, at the width the type actually has.
    //
    // Asked at 64 bits, a narrow type's overflow is a question the
    // machine cannot answer: the flags describe the 64-bit result,
    // which never overflows for anything narrower.  So it had to be
    // answered by comparing against the range instead -- for a signed
    // type five instructions and two ten-byte constants.  Asked at its
    // own width, the machine sets the very flag the type wants and one
    // branch reads it.
    //
    // What the narrower width costs is the shape of the answer: a
    // 32-bit operation zero-extends into rax and a narrower one leaves
    // the rest of the register as it was, so canon() has to put the
    // value back into the form a slot holds.  One instruction against
    // the five.
    //
    // The encodings run in a line: 8-bit is the opcode below, 16-bit
    // takes the operand-size prefix, 32-bit is bare and 64-bit takes
    // REX.W.  add, sub, neg and mul all obey it.
    @pre(bits = 8 or bits = 16 or bits = 32 or bits = 64)
    fn opw(&mut self, bits : i64, opcode : i64, modrm : i64):
        if bits = 8:
            self.b2(opcode - 1, modrm)
        elif bits = 16:
            self.b3(102, opcode, modrm)
        elif bits = 32:
            self.b2(opcode, modrm)
        else:
            self.b3(72, opcode, modrm)

    // imul is two bytes of opcode and has no 8-bit two-operand form,
    // so it does not fit the line above and is spelled out.
    @pre(bits = 16 or bits = 32 or bits = 64)
    fn imulw(&mut self, bits : i64):
        if bits = 16:
            self.b4(102, 15, 175, 193)
        elif bits = 32:
            self.b3(15, 175, 193)
        else:
            self.b4(72, 15, 175, 193)

    // The canonical form of a value an operation just made at its own
    // width.
    //
    // A slot holds the canonical form -- sign- or zero-extended to the
    // word -- and everything downstream is built on that: a widening
    // emits nothing at all, because the wider read of a narrower slot
    // is already right.  So canon is not decoration and cannot simply
    // be dropped.
    //
    // One case of it is free.  A 32-bit operation on this machine
    // zero-extends into the whole register, so for an unsigned 32-bit
    // type the answer is already canonical and the `mov eax, eax` that
    // would say so says nothing.  A signed one still needs its movslq,
    // and 8 and 16 bits need theirs either way, those widths leaving
    // the rest of the register as it was.
    @pre(done_at = 8 or done_at = 16 or done_at = 32 or done_at = 64)
    fn canon_at(&mut self, w : i64, done_at : i64):
        let bits : i64 = w & 255
        if done_at = bits and bits = 32 and (w » 8) = 0:
            return
        self.canon(w)

    // narrow the canonical 64-bit value in rax back into its width
    fn canon(&mut self, w : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if bits = 64:
            return
        if sgn = 0:
            if bits = 32:
                self.b2(137, 192)            // mov eax, eax
            elif bits = 16:
                self.b4(72, 15, 183, 192)    // movzx rax, ax
            else:
                self.b4(72, 15, 182, 192)    // movzx rax, al
        else:
            if bits = 32:
                self.b3(72, 99, 192)         // movsxd rax, eax
            elif bits = 16:
                self.b4(72, 15, 191, 192)    // movsx rax, ax
            else:
                self.b4(72, 15, 190, 192)    // movsx rax, al

    // canon, for a register the answer is not in.  Division wants both
    // its operands brought up together, and only the one in rax has a
    // form of its own.
    @pre(reg = 0 or reg = 1 or reg = 2 or reg = 6 or reg = 7)
    fn canon_reg(&mut self, w : i64, reg : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        let rr : i64 = 192 + 8 × (reg & 7) + (reg & 7)
        if bits = 64:
            return
        if sgn = 0:
            if bits = 32:
                self.b2(137, rr)             // mov r32, r32
            elif bits = 16:
                self.b4(72, 15, 183, rr)     // movzx r64, r16
            else:
                self.b4(72, 15, 182, rr)     // movzx r64, r8
        else:
            if bits = 32:
                self.b3(72, 99, rr)          // movsxd r64, r32
            elif bits = 16:
                self.b4(72, 15, 191, rr)     // movsx r64, r16
            else:
                self.b4(72, 15, 190, rr)     // movsx r64, r8

    // the checked-arithmetic backstop: overflow leaves for the abort,
    // a branch never taken by a correct program
    fn range_check(&mut self, w : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if bits = 64:
            return
        if sgn = 0:
            self.movimm(R_R11, (1 « bits) - 1)
            self.b3(76, 57, 216)             // cmp rax, r11
            self.jglobal(0, 135, RT_OV)      // ja
        else:
            self.movimm(R_R10, 0 - (1 « (bits - 1)))
            self.b3(72, 137, 194)            // mov rdx, rax
            self.b3(76, 41, 210)             // sub rdx, r10
            self.movimm(R_R11, (1 « bits) - 1)
            self.b3(76, 57, 218)             // cmp rdx, r11
            self.jglobal(0, 135, RT_OV)      // ja

@export
@post(r: r >= 0)
fn str_len(s : str) → i64:
    @dropunit(#s)

// the runtime's own routines, in the order their ids run, so a symbol
// table can name the code they occupy
// Which strings of the pool something in the image reads.  A pointer
// patch names one, and so does a descriptor patch; a literal no patch
// names is a literal nothing reads, and its bytes need not be in the
// image at all.  Answers one flag per string, in the pool's own order.
@export
fn str_uses(em : &Emit, n : i64) → i64[]:
    let used : mut i64[] = []
    foreach i := 0…n:
        used.push(0)
    if #em.sf_str > 0:
        foreach k := 0…#em.sf_str:
            used[em.sf_str[k] × 1¤ptrdiff] ← 1
    if #em.sd_str > 0:
        foreach k := 0…#em.sd_str:
            used[em.sd_str[k] × 1¤ptrdiff] ← 1
    used

