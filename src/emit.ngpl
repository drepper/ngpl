// The UTF-8 decoder is Hoehrmann's DFA in the shift form the design
// researched: nine states, twelve byte classes, and a step that is one
// table read, one shift and one mask instead of a ladder of compares.
// A state is kept already multiplied by six -- its field's place in the
// word -- so the step needs no multiply: state = T[class] >> state & 63.
//
// One byte to a class, as the DFA has them.
@export
fn utf8_class_bytes() → u8[]:
    let t : mut u8[] = []
    foreach b := 0…256:
        let c : i64 = 0
        let k : mut i64 = 0
        if b < 128: k ← 0
        elif b < 144: k ← 1
        elif b < 160: k ← 9
        elif b < 192: k ← 7
        elif b < 194: k ← 8
        elif b < 224: k ← 2
        elif b < 225: k ← 10
        elif b < 237: k ← 3
        elif b < 238: k ← 4
        elif b < 240: k ← 3
        elif b < 241: k ← 11
        elif b < 244: k ← 6
        elif b < 245: k ← 5
        else: k ← 8
        _ ← c
        t.push(k & 255)
    t

// One word to a class: the whole transition row packed six bits to a
// state, each field holding where that state goes next.
@export
fn utf8_dfa_words() → i64[]:
    [1715657000903040, 5146139723563398, 1715657000903052, 1715657000903058,
     1715657000903070, 1715657000903088, 1715657000903082, 1769258294968710,
     1715657000903046, 1769264636756358, 1715657000903064, 1715657000903076]

// Which runtime routine calls which, as pairs: the caller, then what it
// calls.  A routine the program reaches drags its callees in after it,
// and nothing else is emitted.  Getting this wrong cannot pass quietly:
// a call whose target was never emitted stops the compiler where the
// calls are resolved.
@export
fn rt_edges() → i64[]:
    [4, 3, 5, 3, 6, 3, 7, 3, 8, 7, 9, 8, 10, 8, 11, 8, 16, 8, 17, 12, 18, 8, 18, 17, 19, 17, 19, 21, 20, 17, 21, 8, 21, 17, 22, 3, 23, 6, 24, 9, 25, 8, 26, 8, 26, 9, 27, 8, 28, 3, 28, 8, 29, 3, 29, 8, 29, 9, 30, 3, 30, 8, 31, 3, 33, 8, 33, 12, 34, 6, 34, 9, 35, 6, 35, 9, 36, 6, 36, 9, 37, 9, 38, 9, 39, 8, 39, 9, 39, 10, 40, 8, 40, 9, 41, 8, 43, 8, 43, 42, 44, 42, 46, 8, 47, 3, 47, 8, 53, 8, 53, 56, 54, 3, 54, 5, 54, 57, 55, 3, 55, 58, 57, 5, 58, 5, 58, 8, 58, 9, 58, 10, 58, 57, 59, 3, 61, 59, 8, 62, 10, 62, 63, 8, 63, 5, 64, 5, 65, 8, 65, 64, 65, 5, 66, 8, 66, 5, 67, 8, 67, 2, 67, 4, 67, 5, 3, 68, 68, 32, 69, 8, 69, 6, 70, 8, 70, 3]

