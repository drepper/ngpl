// ---------------------------------------------------------------------------
// i386: the 32-bit x86 instruction layer
//
// A 32-bit machine carries the 8-byte data model in pairs.  Here the
// abstract registers are not registers at all: they are four 8-byte
// cells at the top of the frame, and every operation loads its pairs
// into eax:edx and ecx:ebx, computes, and puts the result back.  The
// real registers never hold anything across two operations, which
// costs memory traffic and buys a layer simple enough to trust.
// Arguments travel on the stack, eight bytes each; the syscall is
// int 0x80 with the six arguments staged below it.
// ---------------------------------------------------------------------------

let elf := @import("elf")
let emit := @import("emit")
let lower := @import("lower")
let machine := @import("machine")

// the cells: A, B, C, T at [ebp-8], [ebp-16], [ebp-24], [ebp-32]


fn i3_cello(r : i64) → i64:
    0 - 8 × (r + 1)

// slot s lives at [ebp - 32 - 8×(s+1)]
fn i3_sloto(slot : i64) → i64:
    0 - 32 - 8 × (slot + 1)

// opcode + modrm(10, reg, 101) + disp32: the [ebp+disp] form
fn i3_rm(em : &mut emit.Emit, op : i64, reg : i64, disp : i64):
    em.b2(op, 128 + reg × 8 + 5)
    em.w32(disp)

// a pair into (lo, hi) registers, and back
fn i3_ldpair(em : &mut emit.Emit, lo : i64, hi : i64, disp : i64):
    i3_rm(&em, 139, lo, disp)
    i3_rm(&em, 139, hi, disp + 4)

fn i3_stpair(em : &mut emit.Emit, lo : i64, hi : i64, disp : i64):
    i3_rm(&em, 137, lo, disp)
    i3_rm(&em, 137, hi, disp + 4)

@export
fn i3_movimm(em : &mut emit.Emit, reg : i64, v : i64):
    em.b1(184 + reg)
    em.w32(v)

@export
fn i3g_lds(em : &mut emit.Emit, tg : &elf.Target, r : i64, slot : i64):
    i3_ldpair(&em, 0, 2, i3_sloto(slot))
    i3_stpair(&em, 0, 2, i3_cello(r))

@export
fn i3g_sts(em : &mut emit.Emit, tg : &elf.Target, r : i64, slot : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    i3_stpair(&em, 0, 2, i3_sloto(slot))

@export
fn i3g_const(em : &mut emit.Emit, tg : &elf.Target, r : i64, v : i64):
    // straight into the cell, no register needed
    em.b2(199, 128 + 5)
    em.w32(i3_cello(r))
    em.w32(v & 4294967295)
    em.b2(199, 128 + 5)
    em.w32(i3_cello(r) + 4)
    em.w32(@wrap(v » 32) & 4294967295)

@export
fn i3g_mov2(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    i3_stpair(&em, 0, 2, i3_cello(rd))

// the pair ALU: x in eax:edx, y in ecx:ebx, result in eax:edx
// The same arithmetic at a width this machine has natively.  Its
// registers are 32 bits, so anything that narrow is one instruction
// where a pair would be two, and the flag it sets is about the value
// the type actually holds.
@pre(bits = 8 or bits = 16 or bits = 32)
fn i3_opw(em : &mut emit.Emit, bits : i64, opcode : i64, modrm : i64):
    if bits = 8:
        em.b2(opcode - 1, modrm)
    elif bits = 16:
        em.b3(102, opcode, modrm)
    else:
        em.b2(opcode, modrm)

fn i3_binprep(em : &mut emit.Emit, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_ldpair(&em, 1, 3, i3_cello(ry))

@export
fn i3g_add3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(1, 200)                    // add eax, ecx
    em.b2(17, 218)                   // adc edx, ebx
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_sub3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(41, 200)                   // sub eax, ecx
    em.b2(25, 218)                   // sbb edx, ebx
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_and3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(33, 200)
    em.b2(33, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_or3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(9, 200)
    em.b2(9, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_xor3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(49, 200)
    em.b2(49, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_not2(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    em.b2(247, 208)                  // not eax
    em.b2(247, 210)                  // not edx
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_neg2(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    em.b2(247, 208)
    em.b2(247, 210)
    em.b3(131, 192, 1)               // add eax, 1
    em.b3(131, 210, 0)               // adc edx, 0
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_mul3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    // x in esi:edi, y in ecx:ebx; the three half-products
    i3_ldpair(&em, 6, 7, i3_cello(rx))
    i3_ldpair(&em, 1, 3, i3_cello(ry))
    em.b3(15, 175, 249)              // imul edi, ecx: x_hi × y_lo
    em.b3(15, 175, 222)              // imul ebx, esi: y_hi × x_lo
    em.b2(1, 223)                    // add edi, ebx
    em.b2(137, 240)                  // mov eax, esi
    em.b2(247, 225)                  // mul ecx: edx:eax = x_lo × y_lo
    em.b2(1, 250)                    // add edx, edi
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_shl3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_rm(&em, 139, 1, i3_cello(ry))     // mov ecx, count
    em.b3(128, 249, 32)              // cmp cl, 32
    em.b2(114, 11)                   // jb small (+11)
    em.b2(137, 194)                  // mov edx, eax
    em.b2(49, 192)                   // xor eax, eax
    em.b3(128, 233, 32)              // sub cl, 32
    em.b2(211, 226)                  // shl edx, cl
    em.b2(235, 5)                    // jmp done (+5)
    em.b4(15, 165, 194, 211)         // shld edx, eax, cl; shl eax, cl (starts)
    em.b1(224)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_shr3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_rm(&em, 139, 1, i3_cello(ry))
    em.b3(128, 249, 32)              // cmp cl, 32
    em.b2(114, 11)                   // jb small (+11)
    em.b2(137, 208)                  // mov eax, edx
    em.b2(49, 210)                   // xor edx, edx
    em.b3(128, 233, 32)              // sub cl, 32
    em.b2(211, 232)                  // shr eax, cl
    em.b2(235, 5)                    // jmp done (+5)
    em.b4(15, 173, 208, 211)         // shrd eax, edx, cl; shr edx, cl
    em.b1(234)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_sar3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_rm(&em, 139, 1, i3_cello(ry))
    em.b3(128, 249, 32)              // cmp cl, 32
    em.b2(114, 12)                   // jb small (+12)
    em.b2(137, 208)                  // mov eax, edx
    em.b3(193, 250, 31)              // sar edx, 31
    em.b3(128, 233, 32)              // sub cl, 32
    em.b2(211, 248)                  // sar eax, cl
    em.b2(235, 5)                    // jmp done (+5)
    em.b4(15, 173, 208, 211)         // shrd eax, edx, cl; sar edx, cl
    em.b1(250)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_shl3i(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rs : i64, imm : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    // the driver only asks for small shifts; the pair form is shld
    em.b4(15, 164, 194, imm)         // shld edx, eax, imm
    em.b3(193, 224, imm)             // shl eax, imm
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_cmp3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64, bits : i64):
    i3_binprep(&em, rx, ry)
    if cond = machine.CC_EQ or cond = machine.CC_NE:
        em.b2(49, 200)               // xor eax, ecx
        em.b2(49, 218)               // xor edx, ebx
        em.b2(9, 208)                // or eax, edx
        em.b3(15, if cond = machine.CC_EQ: 148 else: 149, 192)
        em.b4(15, 182, 192, 144)     // movzx eax, al; nop
    else:
        // the swapped pair asks the mirrored question
        let flip : bool = cond = machine.CC_GT or cond = machine.CC_LE
        if flip:
            em.b2(135, 200)          // xchg eax, ecx
            em.b2(135, 218)          // xchg edx, ebx
        em.b2(57, 218)               // cmp edx, ebx
        em.b2(117, 7)                // jne past-the-low (+7)
        em.b2(57, 200)               // cmp eax, ecx
        em.b3(15, 146, 192)          // setb al: the low words decide
        em.b2(235, 4)                // jmp join (+4)
        em.b3(15, if sgn = 1: 156 else: 146, 192)   // setl / setb on the high
        em.b1(144)                   // nop
        em.b4(15, 182, 192, 144)     // movzx eax, al; nop
        if cond = machine.CC_GE or cond = machine.CC_LE:
            em.b2(52, 1)             // xor al, 1
    em.b2(49, 210)                   // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_sel4(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rc : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rc))
    em.b2(9, 208)                    // or eax, edx
    em.b2(117, 14)                   // jnz take-rx (+14)
    i3_ldpair(&em, 0, 2, i3_cello(ry))
    em.b2(235, 12)                   // jmp join (+12)
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_div3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    i3_helper2(&em, rd, rx, ry, if sgn = 1: emit.RT_DIVS64 else: emit.RT_DIVU64)

@export
fn i3g_mod3(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    i3_helper2(&em, rd, rx, ry, if sgn = 1: emit.RT_MODS64 else: emit.RT_MODU64)

// a two-argument helper call: the cells staged, the answer stored
fn i3_helper2(em : &mut emit.Emit, rd : i64, rx : i64, ry : i64, target : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    em.b3(137, 68, 36)
    em.b1(0)                         // mov [esp], eax
    em.b3(137, 84, 36)
    em.b1(4)                         // mov [esp+4], edx
    i3_ldpair(&em, 0, 2, i3_cello(ry))
    em.b3(137, 68, 36)
    em.b1(8)
    em.b3(137, 84, 36)
    em.b1(12)
    i3_call(&em, target)
    i3_stpair(&em, 0, 2, i3_cello(rd))

// The result is stored before the branch: a move does not touch the
// flags, so what the arithmetic said is still there to be read.
@export
fn i3g_addchk(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    i3_binprep(&em, rx, ry)
    if bits < 64:
        i3_opw(&em, bits, 1, 200)
    else:
        em.b2(1, 200)
        em.b2(17, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))
    i3_jcc(&em, if sgn = 1: 129 else: 131, lab)      // jno / jnc

@export
fn i3g_subchk(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    i3_binprep(&em, rx, ry)
    if bits < 64:
        i3_opw(&em, bits, 41, 200)
    else:
        em.b2(41, 200)
        em.b2(25, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))
    i3_jcc(&em, if sgn = 1: 129 else: 131, lab)      // jno / jnc

@export
fn i3g_addov(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    i3_binprep(&em, rx, ry)
    if bits < 64:
        // one instruction at the type's own width, and the high word of
        // the pair is put right by the canonicalising that follows
        i3_opw(&em, bits, 1, 200)
    else:
        em.b2(1, 200)                    // add eax, ecx
        em.b2(17, 218)                   // adc edx, ebx
    em.b3(15, if sgn = 1: 144 else: 146, 193)   // seto cl / setb cl
    em.b4(15, 182, 201, 144)         // movzx ecx, cl
    em.b2(49, 219)                   // xor ebx, ebx
    i3_stpair(&em, 0, 2, i3_cello(rd))
    i3_stpair(&em, 1, 3, i3_cello(rf))

@export
fn i3g_subov(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    i3_binprep(&em, rx, ry)
    if bits < 64:
        // one instruction at the type's own width, and the high word of
        // the pair is put right by the canonicalising that follows
        i3_opw(&em, bits, 41, 200)
    else:
        em.b2(41, 200)                   // sub eax, ecx
        em.b2(25, 218)                   // sbb edx, ebx
    em.b3(15, if sgn = 1: 144 else: 146, 193)
    em.b4(15, 182, 201, 144)
    em.b2(49, 219)
    i3_stpair(&em, 0, 2, i3_cello(rd))
    i3_stpair(&em, 1, 3, i3_cello(rf))

@export
fn i3g_mulov(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    // the helper's arguments staged, the product computed and parked
    // past them, the flag fetched, and only then the cells written --
    // the driver aliases the flag's cell with an operand's
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    em.b3(137, 68, 36)
    em.b1(0)
    em.b3(137, 84, 36)
    em.b1(4)
    i3_ldpair(&em, 0, 2, i3_cello(ry))
    em.b3(137, 68, 36)
    em.b1(8)
    em.b3(137, 84, 36)
    em.b1(12)
    em.b3(199, 68, 36)
    em.b1(16)
    em.w32(sgn)                      // mov dword [esp+16], sgn
    em.b3(199, 68, 36)
    em.b1(20)
    em.w32(0)
    // the wrapped product, into the parking pair at [esp+24]
    i3_ldpair(&em, 6, 7, i3_cello(rx))
    i3_ldpair(&em, 1, 3, i3_cello(ry))
    em.b3(15, 175, 249)              // imul edi, ecx
    em.b3(15, 175, 222)              // imul ebx, esi
    em.b2(1, 223)                    // add edi, ebx
    em.b2(137, 240)                  // mov eax, esi
    em.b2(247, 225)                  // mul ecx
    em.b2(1, 250)                    // add edx, edi
    em.b3(137, 68, 36)
    em.b1(24)
    em.b3(137, 84, 36)
    em.b1(28)
    i3_call(&em, emit.RT_MULOV64)
    i3_stpair(&em, 0, 2, i3_cello(rf))
    em.b3(139, 68, 36)
    em.b1(24)
    em.b3(139, 84, 36)
    em.b1(28)
    i3_stpair(&em, 0, 2, i3_cello(rd))

@export
fn i3g_ext2(em : &mut emit.Emit, tg : &elf.Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    i3_ldpair(&em, 0, 2, i3_cello(r))
    if bits = 8:
        em.b3(15, if sgn = 1: 190 else: 182, 192)   // movsx/movzx eax, al
    elif bits = 16:
        em.b3(15, if sgn = 1: 191 else: 183, 192)   // movsx/movzx eax, ax
    if sgn = 1:
        em.b1(153)                   // cdq
    else:
        em.b2(49, 210)               // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(r))

@export
fn i3g_ldo(em : &mut emit.Emit, tg : &elf.Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    i3_rm(&em, 139, 0, i3_cello(rbase))       // mov eax, base.lo
    if off ≠ 0:
        em.b1(5)
        em.w32(off)                  // add eax, off
    if wd = 8:
        em.b2(139, 72)
        em.b1(0)                     // mov ecx, [eax]
        em.b2(139, 88)
        em.b1(4)                     // mov ebx, [eax+4]
    elif wd = 4:
        em.b2(139, 8)                // mov ecx, [eax]
        if sgn = 1:
            em.b2(137, 203)          // mov ebx, ecx
            em.b3(193, 251, 31)      // sar ebx, 31
        else:
            em.b2(49, 219)
    elif wd = 2:
        em.b3(15, if sgn = 1: 191 else: 183, 8)     // movsx/movzx ecx, word [eax]
        if sgn = 1:
            em.b2(137, 203)
            em.b3(193, 251, 31)
        else:
            em.b2(49, 219)
    else:
        em.b3(15, if sgn = 1: 190 else: 182, 8)     // …byte [eax]
        if sgn = 1:
            em.b2(137, 203)
            em.b3(193, 251, 31)
        else:
            em.b2(49, 219)
    i3_stpair(&em, 1, 3, i3_cello(rd))

@export
fn i3g_sto(em : &mut emit.Emit, tg : &elf.Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    i3_rm(&em, 139, 0, i3_cello(rbase))
    if off ≠ 0:
        em.b1(5)
        em.w32(off)
    i3_ldpair(&em, 1, 3, i3_cello(rs))
    if wd = 8:
        em.b2(137, 8)                // mov [eax], ecx
        em.b2(137, 88)
        em.b1(4)                     // mov [eax+4], ebx
    elif wd = 4:
        em.b2(137, 8)
    elif wd = 2:
        em.b3(102, 137, 8)           // mov [eax], cx
    else:
        em.b2(136, 8)                // mov [eax], cl

let I3F_REL : i64 = 32

@export
fn i3g_jmp(em : &mut emit.Emit, tg : &elf.Target, lab : i64):
    em.tf_pos.push(em.here() + 1)
    em.tf_lab.push(lab)
    em.tf_form.push(I3F_REL)
    em.b1(233)                       // jmp rel32
    em.w32(0)

@export
fn i3_jcc(em : &mut emit.Emit, cc : i64, lab : i64):
    em.tf_pos.push(em.here() + 2)
    em.tf_lab.push(lab)
    em.tf_form.push(I3F_REL)
    em.b2(15, cc)
    em.w32(0)

@export
fn i3g_jz(em : &mut emit.Emit, tg : &elf.Target, r : i64, lab : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    em.b2(9, 208)                    // or eax, edx
    i3_jcc(&em, 132, lab)

@export
fn i3g_jnz(em : &mut emit.Emit, tg : &elf.Target, r : i64, lab : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    em.b2(9, 208)
    i3_jcc(&em, 133, lab)

@export
fn i3g_label(em : &mut emit.Emit, tg : &elf.Target, lab : i64):
    em.set_label(lab)

@export
fn i3_call(em : &mut emit.Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here() + 1)
    em.cf_target.push(target)
    em.b1(232)                       // call rel32
    em.w32(0)

@export
fn i3g_call(em : &mut emit.Emit, tg : &elf.Target, target : i64):
    i3_call(&em, target)

@export
fn i3g_calli(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    i3_rm(&em, 139, 0, i3_cello(r))
    em.b2(255, 208)                  // call eax

@export
fn i3g_ijmp(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    i3_rm(&em, 139, 0, i3_cello(r))
    em.b2(255, 224)                  // jmp eax

// The pairs a private function's first arguments travel in.  i386's
// abstract registers are cells in the frame rather than registers --
// every operation goes memory, eax:edx, memory -- so eax:edx is the
// only pair the body ever touches and ecx, ebx, esi and edi are free
// from one end of a function to the other.  Three arguments fit there,
// which is three more than this target's own convention allows.
//
// Nothing has to be preserved for them.  A caller keeps nothing in a
// register across a call, having nowhere to keep it, so a callee that
// does not put ebx, esi and edi back is a callee nobody misses.
@pre(k >= 0 and k < 3)
fn i3_argreg_lo(k : i64) → i64:
    if k = 0: return 0              // eax
    if k = 1: return 1              // ecx
    6                               // esi

@pre(k >= 0 and k < 3)
fn i3_argreg_hi(k : i64) → i64:
    if k = 0: return 2              // edx
    if k = 1: return 3              // ebx
    7                               // edi

// argument k of a private function, straight into the pair it travels
// in.  The stack arguments go down first, since they travel through
// eax:edx, which is where argument 0 is about to sit.
@export
@pre(k >= 0 and k < 3)
fn i3g_argreg(em : &mut emit.Emit, tg : &elf.Target, k : i64, slot : i64):
    i3_ldpair(&em, i3_argreg_lo(k), i3_argreg_hi(k), i3_sloto(slot))

@export
fn i3g_argld(em : &mut emit.Emit, tg : &elf.Target, k : i64, slot : i64):
    i3_ldpair(&em, 0, 2, i3_sloto(slot))
    em.b3(137, 68, 36)
    em.b1(8 × k)
    em.b3(137, 84, 36)
    em.b1(8 × k + 4)

@export
fn i3g_argconst(em : &mut emit.Emit, tg : &elf.Target, k : i64, v : i64):
    em.b3(199, 68, 36)
    em.b1(8 × k)
    em.w32(v & 4294967295)
    em.b3(199, 68, 36)
    em.b1(8 × k + 4)
    em.w32(@wrap(v » 32) & 4294967295)

@export
fn i3g_argmov(em : &mut emit.Emit, tg : &elf.Target, k : i64, r : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    em.b3(137, 68, 36)
    em.b1(8 × k)
    em.b3(137, 84, 36)
    em.b1(8 × k + 4)

@export
fn i3g_retst(em : &mut emit.Emit, tg : &elf.Target, slot : i64):
    i3_stpair(&em, 0, 2, i3_sloto(slot))

@export
fn i3g_retld(em : &mut emit.Emit, tg : &elf.Target, slot : i64):
    i3_ldpair(&em, 0, 2, i3_sloto(slot))

@export
fn i3g_retmov(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))

// ebp is the frame pointer, and an address on a 32-bit machine is the
// low half of the pair a value is kept in
@export
fn i3g_fptr(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    em.b2(137, 232)                  // mov eax, ebp
    em.b2(49, 210)                   // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(r))

@export
fn i3g_absref(em : &mut emit.Emit, tg : &elf.Target, r : i64) → i64:
    let pos : i64 = em.here() + 1
    i3_movimm(&em, 0, 0)             // mov eax, imm32
    em.b2(49, 210)                   // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(r))
    pos

@export
fn i3g_absref_arg(em : &mut emit.Emit, tg : &elf.Target, k : i64) → i64:
    let pos : i64 = em.here() + 1
    i3_movimm(&em, 0, 0)
    em.b3(137, 68, 36)
    em.b1(8 × k)
    em.b3(199, 68, 36)
    em.b1(8 × k + 4)
    em.w32(0)
    pos

// the kernel: the six arguments staged low in the outgoing area as
// 4-byte words, then gathered into the registers int 0x80 reads
@export
fn i3g_sysarg(em : &mut emit.Emit, tg : &elf.Target, k : i64, slot : i64):
    i3_rm(&em, 139, 0, i3_sloto(slot))
    em.b3(137, 68, 36)
    em.b1(4 × k)

@export
fn i3g_sysimm(em : &mut emit.Emit, tg : &elf.Target, k : i64, v : i64):
    em.b3(199, 68, 36)
    em.b1(4 × k)
    em.w32(v)

@export
fn i3g_sysmov(em : &mut emit.Emit, tg : &elf.Target, k : i64, r : i64):
    i3_rm(&em, 139, 0, i3_cello(r))
    em.b3(137, 68, 36)
    em.b1(4 × k)

@export
fn i3g_syscall(em : &mut emit.Emit, tg : &elf.Target, scid : i64):
    i3_movimm(&em, 0, machine.sc_at(&tg, scid))
    em.b1(85)                        // push ebp
    em.b3(139, 92, 36)
    em.b1(4)                         // mov ebx, [esp+4]
    em.b3(139, 76, 36)
    em.b1(8)
    em.b3(139, 84, 36)
    em.b1(12)
    em.b3(139, 116, 36)
    em.b1(16)
    em.b3(139, 124, 36)
    em.b1(20)
    em.b3(139, 108, 36)
    em.b1(24)                        // mov ebp, [esp+24]
    em.b2(205, 128)                  // int 0x80
    em.b1(93)                        // pop ebp
    // only the errno band is negative; an address above 2G is not
    em.b2(49, 210)                   // xor edx, edx
    em.b1(61)
    em.w32(⁻4096)                    // cmp eax, -4096
    em.b2(114, 5)                    // jb done (+5)
    i3_movimm(&em, 2, ⁻1)            // mov edx, -1: a real error

@export
fn i3g_sysret(em : &mut emit.Emit, tg : &elf.Target, r : i64):
    i3_stpair(&em, 0, 2, i3_cello(r))

// The address of the frame's object region, plus off.  The region
// takes the slots just past the vregs; here the slots run downward
// from ebp, so the region's lowest address is the last of them.  A
// pointer is half a cell wide, and the high half is nought.
@export
@pre(off >= 0)
fn i3g_frameaddr(em : &mut emit.Emit, tg : &elf.Target, nvregs : i64, nobj : i64, off : i64, r : i64):
    let at : i64 = 0 - 32 - 8 × (nvregs + nobj) + off
    em.b2(141, 133)                  // lea eax, [ebp+disp32]
    em.w32(at)
    i3_movimm(&em, 2, 0)
    i3_stpair(&em, 0, 2, i3_cello(r))

@export
fn i3g_prologue(em : &mut emit.Emit, tg : &elf.Target, nvregs : i64, np : i64, nreg : i64):
    let frame : i64 = 32 + 8 × nvregs + 128
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.b1(85)                        // push ebp
    em.b2(137, 229)                  // mov ebp, esp
    em.b2(129, 236)
    em.w32(frame)                    // sub esp, frame
    foreach j := 0…np:
        if j < nreg:
            // it arrived in a pair; it goes to its slot and the pair is
            // free again before a single instruction of the body runs
            i3_stpair(&em, i3_argreg_lo(j), i3_argreg_hi(j), i3_sloto(j))
        else:
            i3_ldpair(&em, 0, 2, 8 + 8 × j)
            i3_stpair(&em, 0, 2, i3_sloto(j))

@export
fn i3g_epilogue(em : &mut emit.Emit, tg : &elf.Target):
    em.b2(137, 236)                  // mov esp, ebp
    em.b1(93)                        // pop ebp
    em.b1(195)                       // ret

@export
fn i3g_resolve(em : &mut emit.Emit, tg : &elf.Target):
    foreach i := 0…#em.tf_pos:
        let pos : i64 = em.tf_pos[i]
        em.patch32(pos, em.labels[em.tf_lab[i] × 1¤ptrdiff] - (pos + 4))
    em.tf_pos ← []
    em.tf_lab ← []
    em.tf_form ← []

@export
fn i3g_patch_abs(em : &mut emit.Emit, tg : &elf.Target, pos : i64, v : i64):
    em.patch32(pos, v)

@export
fn i3g_patch_call(em : &mut emit.Emit, tg : &elf.Target, pos : i64, dest : i64):
    em.patch32(pos, dest - (pos + 4))

// the door on 32-bit x86: the kernel's words are four bytes, the
// cells they land in stay eight
@export
fn i3_startup(em : &mut emit.Emit, lw : &mut lower.Lower, tg : &elf.Target, args_off : i64,
              stack_size : i64, guard_size : i64, ginit : i64,
              tdriver : i64, start_fn : i64, sret : bool):
    em.begin_fn(4)
    let pos : i64 = em.here() + 1
    i3_movimm(&em, 6, 0)             // mov esi, args-block (patched)
    em.df_pos.push(pos)
    em.df_off.push(args_off)
    em.b3(139, 4, 36)                // mov eax, [esp]: argc
    em.b2(137, 6)                    // mov [esi], eax
    em.b3(199, 70, 4)
    em.w32(0)                        // the cell's high half is zero
    em.b4(141, 76, 36, 4)            // lea ecx, [esp+4]: argv
    em.b3(137, 78, 8)                // mov [esi+8], ecx
    em.b3(199, 70, 12)
    em.w32(0)
    em.b4(141, 76, 132, 8)           // lea ecx, [esp+eax*4+8]: envp
    em.b3(137, 78, 16)
    em.b3(199, 70, 20)
    em.w32(0)
    em.set_label(0)                  // walk to the env's end
    em.b2(139, 17)                   // mov edx, [ecx]
    em.b3(131, 193, 4)               // add ecx, 4
    em.b2(133, 210)                  // test edx, edx
    i3_jcc(&em, 133, 0)              // jnz
    em.b3(137, 78, 24)               // mov [esi+24], ecx: auxv
    em.b3(199, 70, 28)
    em.w32(0)
    // the stack: mmap2, then the top opened, then the move
    i3_movimm(&em, 0, machine.sc_number(&tg, machine.Sc.mmap))
    em.b2(49, 219)                   // xor ebx, ebx
    i3_movimm(&em, 1, guard_size + stack_size)
    em.b2(49, 210)                   // xor edx, edx: PROT_NONE
    i3_movimm(&em, 6, 147490)
    i3_movimm(&em, 7, ⁻1)
    em.b1(85)                        // push ebp
    em.b2(49, 237)                   // xor ebp, ebp: page offset 0
    em.b2(205, 128)                  // int 0x80
    em.b1(93)                        // pop ebp
    em.b1(61)
    em.w32(⁻4096)                    // cmp eax, -4096
    i3_jcc(&em, 131, 1)              // jae: the kernel refused
    em.b2(137, 199)                  // mov edi, eax: the region's foot
    i3_movimm(&em, 0, machine.sc_number(&tg, machine.Sc.mprot))
    em.b2(137, 251)                  // mov ebx, edi
    em.b2(129, 195)
    em.w32(guard_size)               // add ebx, guard
    i3_movimm(&em, 1, stack_size)
    i3_movimm(&em, 2, 3)
    em.b2(205, 128)
    em.b1(61)
    em.w32(⁻4096)
    i3_jcc(&em, 131, 1)
    em.b2(137, 252)                  // mov esp, edi
    em.b2(129, 196)
    em.w32(guard_size + stack_size)  // add esp, the whole reservation
    i3g_jmp(&em, &tg, 2)
    em.set_label(1)
    em.b2(131, 236)
    em.b1(16)                       // sub esp, 16: room for the message
    let smsg : i64 = lw.intern("the stack could not be reserved\n")
    let spos : i64 = em.here() + 1
    i3_movimm(&em, 0, 0)
    em.sf_pos.push(spos)
    em.sf_str.push(smsg)
    em.b3(137, 4, 36)                // mov [esp], eax
    em.b3(199, 68, 36)
    em.b1(4)
    em.w32(0)
    em.b3(199, 68, 36)
    em.b1(8)
    em.w32(emit.str_len("the stack could not be reserved\n"))
    em.b3(199, 68, 36)
    em.b1(12)
    em.w32(0)
    i3_call(&em, emit.RT_ABORT)
    em.set_label(2)
    em.b2(131, 236)
    em.b1(96)                        // sub esp, 96: the door's own outgoing area
    // Where the guard is, for the handler to compare a faulting
    // address against, and then the handler itself.  Both before the
    // relro is sealed: the bounds live in it.
    let gpos : i64 = em.here() + 1
    i3_movimm(&em, 6, 0)             // mov esi, args-block (patched)
    em.df_pos.push(gpos)
    em.df_off.push(args_off)
    em.b3(137, 126, emit.KB_GLO)          // mov [esi+KB_GLO], edi
    em.b3(199, 70, emit.KB_GLO + 4)
    em.w32(0)                        // the cell's high half
    em.b2(137, 248)                  // mov eax, edi
    em.b1(5)
    em.w32(guard_size)               // add eax, guard
    em.b3(137, 70, emit.KB_GHI)           // mov [esi+KB_GHI], eax
    em.b3(199, 70, emit.KB_GHI + 4)
    em.w32(0)
    em.b2(137, 248)                  // mov eax, edi
    em.b1(5)
    em.w32(guard_size + stack_size)  // add eax, guard + stack
    em.b3(137, 70, emit.KB_STOP)          // mov [esi+KB_STOP], eax
    em.b3(199, 70, emit.KB_STOP + 4)
    em.w32(0)
    i3_call(&em, emit.RT_SIGINIT)
    if ginit >= 0:
        i3_call(&em, ginit)
    i3_call(&em, emit.RT_RELRO)
    i3_call(&em, tdriver)
    if start_fn >= 0:
        i3_call(&em, start_fn)
    if sret:
        em.b2(137, 195)              // mov ebx, eax: the status
    else:
        em.b2(49, 219)
    i3_movimm(&em, 0, machine.sc_number(&tg, machine.Sc.exit))
    em.b2(205, 128)
    i3g_resolve(&em, &tg)
