// ===========================================================================
// SHA-256, for the bill of materials
// ===========================================================================
//
// FIPS 180-4.  Written out in core-2 -- explicit indices, explicit
// rounds -- rather than in the array vocabulary tests/sha256.ngpl uses,
// since the compiler is written in the subset it compiles.
//
// What it is for is naming things: the sources a program was built
// from, and the program itself.  A hash is a name that cannot be
// forged, which is the only kind worth writing into a binary.

// The round constants: the first thirty-two bits of the fractional
// parts of the cube roots of the first sixty-four primes.  A function
// rather than a global, since a global begins at a constant the
// compiler can see and an array is not one.
fn sha_k() → u32[]:
    [1116352408, 1899447441, 3049323471, 3921009573,
      961987163, 1508970993, 2453635748, 2870763221,
     3624381080,  310598401,  607225278, 1426881987,
     1925078388, 2162078206, 2614888103, 3248222580,
     3835390401, 4022224774,  264347078,  604807628,
      770255983, 1249150122, 1555081692, 1996064986,
     2554220882, 2821834349, 2952996808, 3210313671,
     3336571891, 3584528711,  113926993,  338241895,
      666307205,  773529912, 1294757372, 1396182291,
     1695183700, 1986661051, 2177026350, 2456956037,
     2730485921, 2820302411, 3259730800, 3345764771,
     3516065817, 3600352804, 4094571909,  275423344,
      430227734,  506948616,  659060556,  883997877,
      958139571, 1322822218, 1537002063, 1747873779,
     1955562222, 2024104815, 2227730452, 2361852424,
     2428436474, 2756734187, 3204031479, 3329325298]

// the first thirty-two bits of the fractional parts of the square
// roots of the first eight primes
fn sha_h0() → u32[]:
    [1779033703, 3144134277, 1013904242, 2773480762,
     1359893119, 2600822924,  528734635, 1541459225]

// x turned right by n places, which SHA-256 does and a shift does not
@pre(n >= 1 and n <= 31)
fn rotr32(x : u32, n : i64) → u32:
    (x » n) | @wrap(x « (32 - n))

// The byte at `off` of the padded message: the message, then one bit
// set, then zeros, then the length in bits as eight bytes.  Reading the
// padding rather than building it keeps the message where it already is.
@pre(off >= 0)
@post(r: r >= 0 and r <= 255)
fn sha_byte(data : byte[], off ¤byte : i64, total ¤byte : i64) → i64:
    let n ¤byte : i64 = #data
    if off < n:
        return data[off]
    if off = n:
        return 128
    let len_at ¤byte : i64 = total - 8
    if off < len_at:
        return 0
    // the length in bits, most significant byte first
    let idx : i64 = @dropunit(off - len_at)
    let bits : i64 = @dropunit(n) × 8
    (bits » ((7 - idx) × 8)) & 255

// The digest of a run of bytes, as the eight words it is made of.
@post(r: #r = 8)
fn sha256_words(data : byte[]) → u32[]:
    let n ¤byte : i64 = #data
    // the message, the one bit, the length, rounded up to whole blocks
    let total ¤byte : i64 = ((@dropunit(n) + 9 + 63) ÷ 64 ?? 0) × 64
    let k : u32[] = sha_k()
    let h : mut u32[] = sha_h0()
    let w : mut u32[] = []
    let z : mut i64 = 0
    while z < 64:
        w.push(0)
        z ← z + 1
    let blk ¤byte : mut i64 = 0
    while blk < total:
        // the first sixteen words are the block, big-endian
        let i : mut i64 = 0
        while i < 16:
            let at ¤byte : i64 = blk + (i × 4) × 1¤byte
            let b0 : u32 = sha_byte(data, at, total)
            let b1 : u32 = sha_byte(data, at + 1¤byte, total)
            let b2 : u32 = sha_byte(data, at + 2¤byte, total)
            let b3 : u32 = sha_byte(data, at + 3¤byte, total)
            w[i × 1¤ptrdiff] ← @wrap(b0 « 24) | @wrap(b1 « 16) | @wrap(b2 « 8) | b3
            i ← i + 1
        // and the rest are worked out from them
        let j : mut i64 = 16
        while j < 64:
            let a15 : u32 = w[(j - 15) × 1¤ptrdiff]
            let a2 : u32 = w[(j - 2) × 1¤ptrdiff]
            let s0 : u32 = rotr32(a15, 7) ^ rotr32(a15, 18) ^ (a15 » 3)
            let s1 : u32 = rotr32(a2, 17) ^ rotr32(a2, 19) ^ (a2 » 10)
            w[j × 1¤ptrdiff] ← @wrap(w[(j - 16) × 1¤ptrdiff] + s0 + w[(j - 7) × 1¤ptrdiff] + s1)
            j ← j + 1
        let va : mut u32 = h[0 × 1¤ptrdiff]
        let vb : mut u32 = h[1 × 1¤ptrdiff]
        let vc : mut u32 = h[2 × 1¤ptrdiff]
        let vd : mut u32 = h[3 × 1¤ptrdiff]
        let ve : mut u32 = h[4 × 1¤ptrdiff]
        let vf : mut u32 = h[5 × 1¤ptrdiff]
        let vg : mut u32 = h[6 × 1¤ptrdiff]
        let vh : mut u32 = h[7 × 1¤ptrdiff]
        let t : mut i64 = 0
        while t < 64:
            let big1 : u32 = rotr32(ve, 6) ^ rotr32(ve, 11) ^ rotr32(ve, 25)
            let ch : u32 = (ve & vf) ^ (~ve & vg)
            let t1 : u32 = @wrap(vh + big1 + ch + k[t × 1¤ptrdiff] + w[t × 1¤ptrdiff])
            let big0 : u32 = rotr32(va, 2) ^ rotr32(va, 13) ^ rotr32(va, 22)
            let maj : u32 = (va & vb) ^ (va & vc) ^ (vb & vc)
            let t2 : u32 = @wrap(big0 + maj)
            vh ← vg
            vg ← vf
            vf ← ve
            ve ← @wrap(vd + t1)
            vd ← vc
            vc ← vb
            vb ← va
            va ← @wrap(t1 + t2)
            t ← t + 1
        h[0 × 1¤ptrdiff] ← @wrap(h[0 × 1¤ptrdiff] + va)
        h[1 × 1¤ptrdiff] ← @wrap(h[1 × 1¤ptrdiff] + vb)
        h[2 × 1¤ptrdiff] ← @wrap(h[2 × 1¤ptrdiff] + vc)
        h[3 × 1¤ptrdiff] ← @wrap(h[3 × 1¤ptrdiff] + vd)
        h[4 × 1¤ptrdiff] ← @wrap(h[4 × 1¤ptrdiff] + ve)
        h[5 × 1¤ptrdiff] ← @wrap(h[5 × 1¤ptrdiff] + vf)
        h[6 × 1¤ptrdiff] ← @wrap(h[6 × 1¤ptrdiff] + vg)
        h[7 × 1¤ptrdiff] ← @wrap(h[7 × 1¤ptrdiff] + vh)
        blk ← blk + 64¤byte
    h

// the digest as the sixty-four lowercase hex characters that name it
@post(r: #r = 64)
fn sha256_hex(data : byte[]) → str:
    let h : u32[] = sha256_words(data)
    let digits : str = "0123456789abcdef"
    let cs := digits.chars()
    let out : mut str = ""
    let i : mut i64 = 0
    while i < 8:
        let v : i64 = h[i × 1¤ptrdiff]
        let s : mut i64 = 28
        while s >= 0:
            out ← out ⧺ cs[((v » s) & 15) × 1¤ptrdiff]
            s ← s - 4
        i ← i + 1
    out
