// ===========================================================================
// SHA-256, for the bill of materials
// ===========================================================================
//
// FIPS 180-4.  The rounds themselves are not here: std.hash does
// them, which under the interpreter is the host's own implementation
// and in a compiled compiler is the runtime written as IR once in
// rt_hash.ngpl and rt_sha256.ngpl and compiled for all six targets.  A bill of
// materials over this compiler's own sources is a quarter of a
// megabyte of hashing, and doing it in the language cost forty minutes
// under the interpreter -- which is what made the bill an option
// rather than what a build simply does.
//
// What stays here is the two tables, because rt_sha256.ngpl reads them
// to build its IR, and the hex spelling, because a digest is written
// down far more often than it is computed.

// The round constants: the first thirty-two bits of the fractional
// parts of the cube roots of the first sixty-four primes.  A function
// rather than a global, since a global begins at a constant the
// compiler can see and an array is not one.
fn sha_k() → u32[]:
    [1116352408, 1899447441, 3049323471, 3921009573,
      961987163, 1508970993, 2453635748, 2870763221,
     3624381080,  310598401,  607225278, 1426881987,
     1925078388, 2162078206, 2614888103, 3248222580,
     3835390401, 4022224774,  264347078,  604807628,
      770255983, 1249150122, 1555081692, 1996064986,
     2554220882, 2821834349, 2952996808, 3210313671,
     3336571891, 3584528711,  113926993,  338241895,
      666307205,  773529912, 1294757372, 1396182291,
     1695183700, 1986661051, 2177026350, 2456956037,
     2730485921, 2820302411, 3259730800, 3345764771,
     3516065817, 3600352804, 4094571909,  275423344,
      430227734,  506948616,  659060556,  883997877,
      958139571, 1322822218, 1537002063, 1747873779,
     1955562222, 2024104815, 2227730452, 2361852424,
     2428436474, 2756734187, 3204031479, 3329325298]

// the first thirty-two bits of the fractional parts of the square
// roots of the first eight primes
fn sha_h0() → u32[]:
    [1779033703, 3144134277, 1013904242, 2773480762,
     1359893119, 2600822924,  528734635, 1541459225]

// A digest as the sixty-four lowercase hex characters that name it.
// Separate from computing one, because a digest fed a piece at a time
// is spelled out at the end just the same.
//
// The parameter is u8[32] and not u8[], because a digest is a fixed
// width and its type says so.  The two are laid out differently -- the
// one its elements packed, the other a header and a slot apiece -- so
// one does not go where the other is wanted.  The precondition below
// is now something the type already carries; it stays as the statement
// of what this depends on.
@pre(@dropunit(#d) = 32)
@post(r: #r = 64)
fn hex_digest(d : u8[32]) → str:
    let digits : str = "0123456789abcdef"
    let out : mut str = ""
    foreach v := d:
        out ← out ⧺ digits[((v » 4) & 15) × 1¤ptrdiff] ⧺ digits[(v & 15) × 1¤ptrdiff]
    out

// the same, for a message already in hand
@post(r: #r = 64)
fn sha256_hex(data : byte[]) → str:
    hex_digest(std.hash.sha256.digest(data))
