let tokens := @import("./tokens.ngpl")

// ===========================================================================
// Reading a program: what a file is written against
// ===========================================================================
//
// A file says at its head which other files it is written against:
//
//     @import("./tokens.ngpl")
//
// and each of those is read in ahead of it, so that everything a file
// names has been said before the file says anything.  That is what
// makes the order of a program's sources the program's own business
// rather than the command line's: the compiler is handed one file and
// finds the rest.
//
// What a name says decides where it is looked for.  One that begins
// with `/` says where it is and is taken as it stands.  One that holds
// a `/` says where it is beside this file.  One that says neither is
// looked for beside this file, then along the search path --path gave,
// then where the library lives.  Each of those is tried as written and
// then with `.ngpl` after it, so that a file may be asked for by the
// name it is known by rather than by the name it is stored under.
//
// A file goes in once however many files ask for it, since what they
// are asking for is that it be there.  Asking for the same file twice
// in one file is a mistake rather than a request, and is refused --
// what is compared is the file each name answered to, so two spellings
// of one file are still one file.  Files that import one another in a
// ring are refused, because no order of them can put each after what
// it needs.
//
// The imports are read off the head of the file, before it has been
// lexed -- the text has to be assembled before there is anything to
// lex.  So the head is where they have to be: the reader stops at the
// first line that is neither blank, nor a comment, nor an @import, and
// nothing further down can be mistaken for one.  The lines themselves
// stay in the text, where the parser reads past them: a file that says
// what it needs should go on saying it, and leaving them in means no
// line number moves.



let IMP_TAB : i64 = 9
let IMP_NL : i64 = 10
let IMP_SP : i64 = 32
let IMP_QUOTE : i64 = 34

// Whether the source at `at` begins with this text.  The wanted text
// is ASCII -- `@import(`, `//` -- so a byte answers for a character.
fn imp_has(b : byte[], at : i64 ¤byte, want : str) → bool:
    let i : mut i64 ¤byte = at
    foreach c := want:
        if i >= #b or b[i] ≠ c.ord():
            return false
        i ← i + 1¤byte
    true

// The end of the line beginning at `at`: the newline, or the end of
// the file where the last line has none.
@post(r: r >= at)
fn imp_line_end(b : byte[], at : i64 ¤byte) → i64 ¤byte:
    let i : mut i64 ¤byte = at
    while i < #b and b[i] ≠ IMP_NL:
        i ← i + 1¤byte
    i

// Whether everything from `at` to `hi` is blank.
fn imp_blank(b : byte[], at : i64 ¤byte, hi : i64 ¤byte) → bool:
    let i : mut i64 ¤byte = at
    while i < hi:
        if b[i] ≠ IMP_SP and b[i] ≠ IMP_TAB:
            return false
        i ← i + 1¤byte
    true

// How many bytes the character beginning with this one is written in.
// A byte that begins nothing stands for itself, so a name this does
// not understand is still read to its end rather than run off it.
@post(r: r >= 1 and r <= 4)
fn imp_utf8_len(lead : i64) → i64:
    if lead < 194: return 1
    if lead < 224: return 2
    if lead < 240: return 3
    if lead < 245: return 4
    1

// The character those bytes spell: the low bits of the lead byte, then
// six from each byte that follows.
fn imp_utf8_at(b : byte[], at : i64 ¤byte, n : i64) → i64:
    let lead : i64 = b[at]
    if n = 1:
        return lead
    let keep : i64 = if n = 2: 31 elif n = 3: 15 else: 7
    let v : mut i64 = lead & keep
    let i : mut i64 = 1
    while i < n:
        v ← (v « 6) | (b[at + i × 1¤byte] & 63)
        i ← i + 1
    v

// The text between `at` and `hi`, read as UTF-8.  A file name is text
// and is opened and printed as text, so it is read as text rather than
// a byte at a time.
fn imp_str(b : byte[], at : i64 ¤byte, hi : i64 ¤byte) → str:
    let s : mut str = ""
    let i : mut i64 ¤byte = at
    while i < hi:
        let n : i64 = imp_utf8_len(b[i])
        if i + n × 1¤byte > hi:
            return s
        s ← s ⧺ imp_utf8_at(b, i, n).chr()
        i ← i + n × 1¤byte
    s

// What one @import line names, or "" where the line is not one this
// reader can follow.  The line has to be exactly `@import("...")` and
// nothing else, which is what the head of a file is allowed to hold.
fn imp_named(b : byte[], at : i64 ¤byte, hi : i64 ¤byte) → str:
    if not imp_has(b, at, "@import(\""):
        return ""
    let lo : i64 ¤byte = at + 9¤byte
    let i : mut i64 ¤byte = lo
    while i < hi and b[i] ≠ IMP_QUOTE:
        i ← i + 1¤byte
    if i >= hi or not imp_has(b, i, "\")") or not imp_blank(b, i + 2¤byte, hi):
        return ""
    imp_str(b, lo, i)

// `let m := @import("x")` written at the head of a line: the name it
// binds, or "" where the line is not one.  A bound import is the file
// becoming a module of its own, which nothing but that name reaches.
fn imp_bound_name(b : byte[], at : i64 ¤byte, hi : i64 ¤byte) → str:
    if not imp_has(b, at, "let "):
        return ""
    let lo : i64 ¤byte = at + 4¤byte
    let i : mut i64 ¤byte = lo
    while i < hi and b[i] ≠ IMP_SP:
        i ← i + 1¤byte
    if i >= hi or not imp_has(b, i, " := @import(\""):
        return ""
    imp_str(b, lo, i)

// the file such a line names
fn imp_bound_file(b : byte[], at : i64 ¤byte, hi : i64 ¤byte) → str:
    let i : mut i64 ¤byte = at
    while i < hi and not imp_has(b, i, "@import(\""):
        i ← i + 1¤byte
    if i >= hi:
        return ""
    imp_named(b, i, hi)

// What a program is made of: the text of every file, in the order the
// imports put them, and where each one begins.  `why` is empty while
// the program could be read and says what stopped it otherwise.
//
// A module is a file and everything it reads in plainly; a bound
// import starts another.  `fmod` says which module each file belongs
// to, and the three binding arrays say what name reaches what module
// from where.
struct Program:
    why : str
    src : byte[]
    names : str[]
    offs : i64 ¤byte[]
    fmod : i64[]
    mroot : str[]
    bname : str[]
    bmod : i64[]
    bowner : i64[]

// the directory a path names something in, "" when it names something
// in the working directory
@export
fn dir_of(path : str) → str:
    let cut : mut i64 ¤ptrdiff = ⁻1¤ptrdiff
    foreach i := 0…#path:
        if path[i] = '/':
            cut ← i
    if cut < 0:
        return ""
    path[0¤ptrdiff…cut]

// Where a name that says nothing about where it lives is looked for
// after everything nearer has been tried.  One constant, so that a
// distributor says where a library lives by building the compiler.
fn import_lib_dir() → str:
    "/usr/share/ngpl/lib"

// Whether a name says anything about the directory it lives in.
fn imp_has_slash(name : str) → bool:
    foreach c := name:
        if c = '/':
            return true
    false

// What a module is called: the file it is rooted in, less its
// directory and less the suffix a source file is stored under.  It is
// what qualifies the module's names, and what a symbol in the binary
// carries, so it is the file's own name and not a number.
fn imp_stem(path : str) → str:
    let d : str = dir_of(path)
    let base : mut str = if d = "": path else: path[#d + 1¤ptrdiff…#path]
    if #base > 5¤ptrdiff and base[#base - 5¤ptrdiff…#base] = ".ngpl":
        base ← base[0¤ptrdiff…#base - 5¤ptrdiff]
    base

// The name each module is qualified by: the one a program is rooted in
// takes none, so a program that binds nothing is exactly what it was.
// A stem two modules share is told apart by which one it is.
@export
fn mod_names(roots : str[]) → str[]:
    let out : mut str[] = []
    foreach i := 0¤ptrdiff…#roots:
        if i = 0¤ptrdiff:
            out.push("")
        else:
            let stem : str = imp_stem(roots[i])
            let dup : mut bool = false
            foreach j := 0¤ptrdiff…i:
                if out[j] = stem:
                    dup ← true
            out.push(if dup: stem ⧺ tokens.i64_str(@dropunit(i)) else: stem)
    out

// A name joined to the directory it is looked for in.  A name that
// begins './' has already said "beside", so the two characters are cut
// and the file is known by the path it would have had anyway.
fn imp_join(base : str, name : str) → str:
    let bare : str = if "./" ⊑ name: name[2¤ptrdiff…#name] else: name
    if base = "": bare else: base ⧺ "/" ⧺ bare

// Whether there is a file there to be read.  Asking costs an open and
// a close, which is what reading it would have cost anyway; the answer
// is asked for once per candidate and a candidate that answers is the
// one that is then read.
@impure
fn imp_readable(p : str) → bool:
    match std.fs.cwd().open_file(p):
        ⊨(file):
            file.close()
            true
        ∅:
            false

// A name looked for in one directory, as written and then with the
// suffix a source file has.  "" where neither is there.
@impure
fn imp_try(base : str, name : str) → str:
    let p : str = imp_join(base, name)
    if imp_readable(p):
        return p
    let q : str = p ⧺ ".ngpl"
    if imp_readable(q):
        return q
    ""

// The file a name asks for, or "" where nothing answers to it.  What
// the name says decides where it is looked for: one that begins with a
// slash says where it is, one that holds a slash says where it is
// beside this file, and one that says neither is looked for beside this
// file, then along the search path the command line gave, then where
// the library lives.
@impure
fn imp_resolve(name : str, base : str, paths : str[]) → str:
    if "/" ⊑ name:
        return imp_try("", name)
    if imp_has_slash(name):
        return imp_try(base, name)
    let here : str = imp_try(base, name)
    if here ≠ "":
        return here
    foreach d := paths:
        let p : str = imp_try(d, name)
        if p ≠ "":
            return p
    imp_try(import_lib_dir(), name)

// where a name that answered to nothing was looked for, said in the
// diagnostic so that the rule is read where it was applied
fn imp_looked(name : str) → str:
    if "/" ⊑ name:
        return """; a name beginning with '/' is taken as it stands, with or without
                 " '.ngpl'"""
    if imp_has_slash(name):
        return """; a name holding a '/' is looked for beside this file, with or without
                 " '.ngpl'"""
    """; a bare name is looked for beside this file, then along --path, then in
     " """ ⧺ import_lib_dir() ⧺ ", with or without '.ngpl'"

struct Reader:
    why : str
    paths : str[]        // where --path said to look, in the order it said
    src : byte[]
    names : str[]
    offs : i64 ¤byte[]
    fmod : i64[]         // the module each file belongs to
    done : str[]         // every file already read, as "module:path"
    stack : str[]        // every file being read, the innermost last
    cur : i64            // the module being read into
    mroot : str[]        // the file each module is rooted in
    // bindings met while reading, waiting to be followed
    pend_name : str[]
    pend_file : str[]
    pend_from : str[]
    pend_owner : i64[]
    bname : str[]
    bmod : i64[]
    bowner : i64[]

fn imp_holds(v : str[], want : str) → bool:
    foreach s := v:
        if s = want:
            return true
    false

fn imp_ring(stack : str[], last : str) → str:
    let s : mut str = ""
    foreach f := stack:
        s ← s ⧺ f ⧺ " imports "
    s ⧺ last

impl Reader:
    // Read this file and everything it is written against, the things
    // it names first.  Anything that stops it is written down and the
    // reading gives up: one reason is what a caller can act on, and
    // the first is the one that explains the rest.
    @impure
    fn take(&mut self, path : str, asked : str):
        if self.why ≠ "":
            return
        if imp_holds(self.stack, path):
            self.why ← "these files import one another: " ⧺ imp_ring(self.stack, path)
            return
        // a file is read once into each module that asks for it: what
        // one module reads in plainly is that module's own
        let mark : str = tokens.i64_str(self.cur) ⧺ ":" ⧺ path
        if imp_holds(self.done, mark):
            return
        match std.fs.cwd().open_file(path):
            ⊨(file):
                let alloc := std.arena.allocator()
                let text : mut byte[] = file.read_file(alloc)
                file.close()
                // a file ends its last line before the next one begins,
                // or the two run together into a line spanning them
                let n : i64 = @dropunit(#text)
                if n > 0 and text[(n - 1) × 1¤byte] ≠ IMP_NL:
                    text.push(IMP_NL)
                // what this file asks for, off its head
                let want : mut str[] = []
                let wline : mut i64[] = []
                let at : mut i64 ¤byte = 0¤byte
                let ln : mut i64 = 1
                let reading : mut bool = true
                while reading and at < #text:
                    let hi : i64 ¤byte = imp_line_end(text, at)
                    if imp_blank(text, at, hi) or imp_has(text, at, "//"):
                        at ← hi + 1¤byte
                        ln ← ln + 1
                        continue
                    if not imp_has(text, at, "@import"):
                        reading ← false
                        continue
                    let nm : str = imp_named(text, at, hi)
                    if nm = "":
                        self.why ← path ⧺ ":" ⧺ tokens.i64_str(ln) ⧺ """: @import takes one file name in
                                    " quotes and nothing else, as @import(\"./tokens.ngpl\")"""
                        return
                    let found : str = imp_resolve(nm, dir_of(path), self.paths)
                    if found = "":
                        self.why ← path ⧺ ":" ⧺ tokens.i64_str(ln) ⧺ ": cannot find '" ⧺ nm ⧺ "'" ⧺ imp_looked(nm)
                        return
                    // the same file twice under two spellings is still
                    // the same file, so what is compared is what each
                    // one answered to
                    if imp_holds(want, found):
                        self.why ← path ⧺ ":" ⧺ tokens.i64_str(ln) ⧺ ": '" ⧺ nm ⧺ "' is imported here and already above; once is what it means"
                        return
                    want.push(found)
                    wline.push(ln)
                    at ← hi + 1¤byte
                    ln ← ln + 1
                self.stack.push(path)
                foreach i := 0¤ptrdiff…#want:
                    self.take(want[i], path ⧺ ":" ⧺ tokens.i64_str(wline[i]))
                    if self.why ≠ "":
                        return
                _ ← self.stack.pop() ?? ""
                self.names.push(path)
                self.offs.push(#self.src)
                self.fmod.push(self.cur)
                // What the file binds: a module of its own, reached by
                // the name and nothing else.  A binding is a top-level
                // let, so the line begins where the line begins.
                let m2 : mut i64 ¤byte = 0¤byte
                let ln2 : mut i64 = 1
                while m2 < #text:
                    let hi2 : i64 ¤byte = imp_line_end(text, m2)
                    let bn : str = imp_bound_name(text, m2, hi2)
                    if bn ≠ "":
                        let bf : str = imp_bound_file(text, m2, hi2)
                        if bf = "":
                            self.why ← path ⧺ ":" ⧺ tokens.i64_str(ln2) ⧺ """: @import takes one file name
                                        " in quotes and nothing else, as
                                        " @import(\"./tokens.ngpl\")"""
                            return
                        self.pend_name.push(bn)
                        self.pend_file.push(bf)
                        self.pend_from.push(path)
                        self.pend_owner.push(self.cur)
                    m2 ← hi2 + 1¤byte
                    ln2 ← ln2 + 1
                self.src ← self.src ⧺ text
                self.done.push(mark)
            ∅:
                let where : str = if asked = "": "" else: asked ⧺ ": "
                self.why ← where ⧺ "cannot open '" ⧺ path ⧺ "': no such file or it cannot be read"

// The whole program, from the file it is rooted in.  Naming several
// files still means what it always did -- each is read in turn, and
// nothing twice -- so a program that has not been given imports yet is
// read as it was.
impl Reader:
    // One module: the file it is rooted in and everything that file
    // reads in plainly.  Answers which module it is, so that the name
    // it was bound to can reach it.
    @impure
    fn take_module(&mut self, root : str, asked : str) → i64:
        // a module is loaded once however many bindings name it, so
        // that its types are one type and its globals one storage
        foreach i := 0¤ptrdiff…#self.mroot:
            if self.mroot[i] = root:
                return @dropunit(i)
        let me : i64 = @dropunit(#self.mroot)
        self.mroot.push(root)
        let outer : i64 = self.cur
        self.cur ← me
        self.take(root, asked)
        self.cur ← outer
        me

    // Every module the program is made of, the root one first.  A
    // binding met while reading is followed after the module holding
    // it has been read, so that a ring of them is two modules and not
    // a loop: a bound import asks that the file be there, not that it
    // be read ahead of anything.
    @impure
    fn take_all(&mut self, roots : str[]):
        foreach nm := roots:
            _ ← self.take_module(nm, "")
            if self.why ≠ "":
                return
        let at : mut i64 ¤ptrdiff = 0¤ptrdiff
        while at < #self.pend_name:
            let nm : str = self.pend_file[at]
            let from : str = self.pend_from[at]
            let where : str = imp_resolve(nm, dir_of(from), self.paths)
            if where = "":
                self.why ← from ⧺ ": cannot find '" ⧺ nm ⧺ "'" ⧺ imp_looked(nm)
                return
            let target : i64 = self.take_module(where, from)
            if self.why ≠ "":
                return
            self.bname.push(self.pend_name[at])
            self.bmod.push(target)
            self.bowner.push(self.pend_owner[at])
            at ← at + 1¤ptrdiff

@export
@impure
fn read_program(roots : str[], paths : str[]) → Program:
    let r : mut Reader = (Reader{why: "", paths: paths, src: [], names: [],
                                 offs: [], fmod: [], done: [], stack: [],
                                 cur: 0, mroot: [], pend_name: [],
                                 pend_file: [], pend_from: [],
                                 pend_owner: [], bname: [], bmod: [],
                                 bowner: []})
    r.take_all(roots)
    (Program{why: r.why, src: r.src, names: r.names, offs: r.offs,
             fmod: r.fmod, mroot: r.mroot, bname: r.bname, bmod: r.bmod,
             bowner: r.bowner})
