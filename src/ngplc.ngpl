        elif o = IR_HNEW:
            em.movimm(R_DI, a)
            em.movimm(R_SI, b)
            em.jglobal(232, ⁻1, RT_HNEW)
            em.store(R_AX, d)
        elif o = IR_HPUT:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.load(R_DX, c)
