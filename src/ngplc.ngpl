    em.b4(68, 136, 81, 1)           // mov [rcx+1], r10b
    em.b3(77, 137, 226)             // mov r10, r12
    em.b4(73, 131, 226, 63)         // and r10, 63
    em.b3(65, 129, 202)
    em.w32(128)                     // or r10d, 0x80
    em.b4(68, 136, 81, 2)           // mov [rcx+2], r10b
    em.movimm(R_DX, 3)
    em.jlocal(⁻1, 3)
    em.set_label(1)                 // two bytes
