            let p1 : i64 = em.here()
            em.w32(0)
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            em.load(R_AX, c)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_ALEN:
            em.load(R_AX, a)
