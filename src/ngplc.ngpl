    em.b3(72, 199, 194)
    em.w32(255)                     // mov rdx, 255
    em.b3(76, 137, 193)             // mov rcx, r8
    em.b3(72, 211, 234)             // shr rdx, cl
    em.b3(72, 199, 193)
    em.w32(63)                      // mov rcx, 63
    em.b3(77, 133, 210)             // test r10, r10
