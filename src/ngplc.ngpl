                self.derr(tok, "the literal misses field '" ⧺ self.text(ftok) ⧺ "'")
            m ← m + 1
        self.set_type(id, mk_sty(sidx))

    fn check_field(&mut self, id : i64, tok : i64, na : i64):
        // Name.alignof, where Name is a struct's: the layout answers,
        // and does so before anything is evaluated
        let lsi : i64 = self.type_named(na)
        if lsi ≠ ⁻1:
            if self.text(tok) ≠ "alignof":
                self.derr(tok, "a struct type answers alignof and offsetof; '" ⧺ self.text(tok) ⧺ "' is a field, which an instance has")
                self.fold_bytes(id, 0)
                return
            let (asz, aal) := c_struct_layout(self.a, lsi, 0)
            _ ← asz
            if aal = ⁻1:
                self.layout_err(tok, lsi, "aligned")
                self.fold_bytes(id, 0)
                return
            self.fold_bytes(id, aal)
            return
