    em.b3(73, 199, 193)
    em.w32(1)                       // mov r9, 1
    em.b3(77, 49, 192)              // xor r8, r8
    em.b2(60, 192)                  // cmp al, 0xC0
    em.b4(65, 15, 147, 192)         // setae r8b
    em.b3(77, 1, 193)               // add r9, r8
    em.b2(60, 224)                  // cmp al, 0xE0
    em.b4(65, 15, 147, 192)         // setae r8b
    em.b3(77, 1, 193)               // add r9, r8
    em.b2(60, 240)                  // cmp al, 0xF0
    em.b4(65, 15, 147, 192)         // setae r8b
    em.b3(77, 1, 193)               // add r9, r8
    em.b3(77, 1, 202)               // add r10, r9
    em.b3(72, 255, 206)             // dec rsi
    em.jlocal(⁻1, 0)
