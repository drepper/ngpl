        let t : i64 = ty_strip_ref(self.ty_of(na))
        if t = TY_ENTRY:
            self.check_entry_field(id, tok)
            return
        if ty_is_mat(t):
            if self.text(tok) = "shape":
                self.set_type(id, mk_aty(ty_with_unit(TY_I64, UNIT_PTRDIFF)))
            else:
                self.derr(tok, "a matrix answers shape; '" ⧺ self.text(tok) ⧺ "' it does not have")
                self.set_type(id, TY_I64)
            return
        if not ty_is_struct(t):
            self.derr(tok, "only a struct has fields; this is " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
