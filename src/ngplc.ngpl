        a64g_sts(&em, tg, r, slot)
        return
    if tg.id = TGT_RV64:
        rvg_sts(&em, tg, r, slot)
        return
    if tg.id = TGT_I386:
        i3g_sts(&em, tg, r, slot)
        return
    if tg.id = TGT_A32:
        a32g_sts(&em, tg, r, slot)
        return
    r32g_sts(&em, tg, r, slot)

