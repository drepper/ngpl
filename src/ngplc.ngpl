        if ty_is_var(callee.ret):
            let rix : i64 = callee.ret - 194048
            if vmap[rix × 1¤ptrdiff] ≠ ⁻1:
                self.a.fns[f × 1¤ptrdiff].ret ← vmap[rix × 1¤ptrdiff]
        // the caller's scopes are parked while the shaped body checks
        let sv_names : mut str[] = []
        foreach v := self.snames:
            sv_names.push(v)
        let sv_type : mut i64[] = []
        foreach v := self.stype:
            sv_type.push(v)
        let sv_mut : mut i64[] = []
        foreach v := self.smut:
            sv_mut.push(v)
        let sv_slot : mut i64[] = []
        foreach v := self.sslot:
            sv_slot.push(v)
        let sv_marks : mut i64[] = []
        foreach v := self.marks:
            sv_marks.push(v)
        let sv_nslots : i64 = self.nslots
        let sv_cur : i64 = self.cur_fn
        let sv_loop : i64 = self.loop_depth
        let sv_floor : i64 = self.scope_floor
        let sv_inc : bool = self.in_contract
        self.scope_floor ← 0
        self.fdone[f × 1¤ptrdiff] ← 2
        self.check_fn(f)
        while #self.snames > 0:
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0
        while #self.marks > 0:
            _ ← self.marks.pop() ?? 0
        foreach v := sv_names:
            self.snames.push(v)
        foreach v := sv_type:
            self.stype.push(v)
        foreach v := sv_mut:
            self.smut.push(v)
        foreach v := sv_slot:
            self.sslot.push(v)
        foreach v := sv_marks:
            self.marks.push(v)
        self.nslots ← sv_nslots
        self.cur_fn ← sv_cur
        self.loop_depth ← sv_loop
        self.scope_floor ← sv_floor
        self.in_contract ← sv_inc
        let shaped := self.a.fns[f × 1¤ptrdiff]
        if ty_is_var(shaped.ret):
            self.derr(tok, "'" ⧺ shaped.name ⧺ "' never settles what it answers")
            self.set_type(id, TY_I64)
            return
        self.set_type(id, shaped.ret)

    // calling through a global's box: as through a binding's, with the
    // box loaded from the global's slot
    fn check_glcall(&mut self, id : i64, tok : i64, args_off : i64,
                    argc : i64, g : i64):
        let lt : i64 = self.a.globals[g × 1¤ptrdiff].ty
        let np : i64 = self.lam_np(lt)
        if argc > np:
            self.derr(tok, "this function wants " ⧺ i64_str(np) ⧺ " arguments, not " ⧺ i64_str(argc))
            self.set_type(id, self.lam_ret(lt))
            return
        if argc > 0:
            foreach j := 0…argc - 1:
                let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
                let pt : i64 = self.lam_pt(lt, j)
                self.check_expr(arg, pt)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, pt)
                elif not self.fit_arg(arg, pt):
                    self.derr(tok, "argument " ⧺ i64_str(j + 1) ⧺ " is " ⧺ type_name(self.ty_of(arg)) ⧺ ", but the function takes " ⧺ type_name(pt))
        if argc = np:
            self.a.nc[id × 1¤ptrdiff] ← 6
            self.nslot[id × 1¤ptrdiff] ← g
            self.set_type(id, self.lam_ret(lt))
            return
        if argc = 0:
            self.a.nc[id × 1¤ptrdiff] ← 7
            self.nslot[id × 1¤ptrdiff] ← g
            self.set_type(id, lt)
            return
        let rem : mut i64[] = []
        foreach j := argc…np - 1:
            rem.push(self.lam_pt(lt, j))
        self.a.nc[id × 1¤ptrdiff] ← 8
        self.a.nb[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.nslot[id × 1¤ptrdiff] ← g
        self.psfn.push(⁻1)
        self.psk.push(argc)
        self.psnp.push(np)
        self.set_type(id, mk_lty(self.lam_intern(rem, self.lam_ret(lt))))

    fn check_lcall(&mut self, id : i64, tok : i64, args_off : i64,
                   argc : i64, vs : i64):
        let lt : i64 = ty_strip_ref(self.stype[vs × 1¤ptrdiff])
        let np : i64 = self.lam_np(lt)
        if argc > np:
            self.derr(tok, "this function wants " ⧺ i64_str(np) ⧺ " arguments, not " ⧺ i64_str(argc))
            self.set_type(id, self.lam_ret(lt))
            return
        if argc > 0:
            foreach j := 0…argc - 1:
                let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
                let pt : i64 = self.lam_pt(lt, j)
                self.check_expr(arg, pt)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, pt)
                elif not self.fit_arg(arg, pt):
                    self.derr(tok, "argument " ⧺ i64_str(j + 1) ⧺ " is " ⧺ type_name(self.ty_of(arg)) ⧺ ", but the function takes " ⧺ type_name(pt))
        if argc = np:
            self.a.nc[id × 1¤ptrdiff] ← 1
            self.nslot[id × 1¤ptrdiff] ← self.sslot[vs × 1¤ptrdiff]
            self.set_type(id, self.lam_ret(lt))
            return
        if argc = 0:
            // applying nothing changes nothing: the box itself answers
            self.a.nc[id × 1¤ptrdiff] ← 5
            self.nslot[id × 1¤ptrdiff] ← self.sslot[vs × 1¤ptrdiff]
            self.set_type(id, lt)
            return
        // some arguments: bind them now, wait for the rest
        let rem : mut i64[] = []
        foreach j := argc…np - 1:
            rem.push(self.lam_pt(lt, j))
        self.a.nc[id × 1¤ptrdiff] ← 4
        self.a.nb[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.nslot[id × 1¤ptrdiff] ← self.sslot[vs × 1¤ptrdiff]
        self.psfn.push(⁻1)
        self.psk.push(argc)
        self.psnp.push(np)
        self.set_type(id, mk_lty(self.lam_intern(rem, self.lam_ret(lt))))

    // generate(f, r): f maps each of the range's steps to an element
    fn check_generate(&mut self, id : i64, tok : i64, args_off : i64, argc : i64):
        if argc ≠ 2:
            self.derr(tok, "generate takes the function and the range")
            self.set_type(id, mk_aty(TY_I64))
            return
        let fe : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        let re : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
        self.check_expr(fe, TY_UNIT)
        let ft : i64 = self.ty_of(fe)
        if not ty_is_lam(ft):
            self.derr(tok, "generate's first argument is a function; this is " ⧺ type_name(ft))
            self.check_expr(re, TY_UNIT)
            self.set_type(id, mk_aty(TY_I64))
            return
        if self.lam_np(ft) ≠ 1:
            self.derr(tok, "generate maps one value at a time; this function takes " ⧺ i64_str(self.lam_np(ft)))
            self.check_expr(re, TY_UNIT)
            self.set_type(id, mk_aty(self.lam_ret(ft)))
            return
        let pt : i64 = self.lam_pt(ft, 0)
        if not ty_is_int(pt):
            self.derr(tok, "generate walks a range, so the function takes a number; this one takes " ⧺ type_name(pt))
        self.check_expr(re, pt)
        let rt : i64 = self.ty_of(re)
        if not ty_is_rg(rt):
            self.derr(tok, "generate's second argument must be a range; this is " ⧺ type_name(rt))
        elif ty_rgelem(rt) ≠ pt:
            self.derr(tok, "the range counts " ⧺ type_name(ty_rgelem(rt)) ⧺ ", but the function takes " ⧺ type_name(pt))
        self.a.nc[id × 1¤ptrdiff] ← 2
        self.set_type(id, mk_aty(self.lam_ret(ft)))

    // (expr)(args): the callee is a value, so the box travels as the
    // expression's own answer rather than out of a named slot
    fn check_callv(&mut self, id : i64, tok : i64, na : i64, args_off : i64):
        self.check_expr(na, TY_UNIT)
        let lt : i64 = self.ty_of(na)
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if not ty_is_lam(lt):
            self.derr(tok, "only a function value is applied; this is " ⧺ type_name(lt))
            if argc > 0:
                foreach j := 0…argc - 1:
                    self.check_expr(self.a.extra[(args_off + 1 + j) × 1¤ptrdiff], TY_UNIT)
            self.set_type(id, TY_I64)
            return
        let np : i64 = self.lam_np(lt)
        if argc > np:
            self.derr(tok, "this function wants " ⧺ i64_str(np) ⧺ " arguments, not " ⧺ i64_str(argc))
            self.set_type(id, self.lam_ret(lt))
            return
        if argc > 0:
            foreach j := 0…argc - 1:
                let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
                let pt : i64 = self.lam_pt(lt, j)
                self.check_expr(arg, pt)
                if self.is_open(self.ty_of(arg)):
                    self.adopt(arg, pt)
                elif not self.fit_arg(arg, pt):
                    self.derr(tok, "argument " ⧺ i64_str(j + 1) ⧺ " is " ⧺ type_name(self.ty_of(arg)) ⧺ ", but the function takes " ⧺ type_name(pt))
        if argc = np:
            self.a.nc[id × 1¤ptrdiff] ← 1
            self.set_type(id, self.lam_ret(lt))
            return
        if argc = 0:
            self.a.nc[id × 1¤ptrdiff] ← 5
            self.set_type(id, lt)
            return
        let rem : mut i64[] = []
        foreach j := argc…np - 1:
            rem.push(self.lam_pt(lt, j))
        self.a.nc[id × 1¤ptrdiff] ← 4
        self.nslot[id × 1¤ptrdiff] ← @dropunit(#self.psfn)
        self.psfn.push(⁻1)
        self.psk.push(argc)
        self.psnp.push(np)
        self.set_type(id, mk_lty(self.lam_intern(rem, self.lam_ret(lt))))

    fn check_one_arg(&mut self, tok : i64, name : str, num : i64,
                     arg : i64, pty : i64):
        let rk : i64 = ty_ref_kind(pty)
        let base : i64 = ty_strip_ref(pty)
        if rk = 1 or rk = 2:
            if self.kind_of(arg) ≠ NK_REF:
                self.derr(tok, "parameter " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' borrows; write &name")
            else:
                self.check_ref_arg(arg, base, rk)
        else:
            if self.kind_of(arg) = NK_REF:
                self.derr(tok, "parameter " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' takes a value, not a borrow")
            else:
                self.check_expr(arg, base)
                let at : i64 = self.ty_of(arg)
                if self.is_open(at):
                    self.adopt(arg, base)
                elif not self.fit_arg(arg, base):
                    self.derr(tok, "argument " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' is " ⧺ type_name(at) ⧺ ", but the parameter says " ⧺ type_name(base))

    fn check_ref_arg(&mut self, arg : i64, base : i64, rk : i64):
        let inner : i64 = self.a.na[arg × 1¤ptrdiff]
        let atok : i64 = self.a.ntok[arg × 1¤ptrdiff]
        self.check_expr(inner, TY_UNIT)
        if self.ty_of(inner) ≠ base:
            self.derr(atok, "the borrow hands over " ⧺ type_name(self.ty_of(inner)) ⧺ ", but the parameter says " ⧺ type_name(base))
        if rk = 2:
            let name := self.text(self.a.ntok[inner × 1¤ptrdiff])
            let s : i64 = self.lookup(name)
            if s ≠ ⁻1 and self.smut[s × 1¤ptrdiff] = 0 and ty_ref_kind(self.stype[s × 1¤ptrdiff]) ≠ 2:
                self.derr(atok, "'" ⧺ name ⧺ "' is not mut, so &mut cannot hand it over")
        self.set_type(arg, base)

    fn check_assert(&mut self, id : i64, tok : i64, args_off : i64, argc : i64,
                    is_eq : bool):
        if is_eq:
            if argc ≠ 2:
                self.derr(tok, "assert_eq takes the expected and the actual value")
            else:
                let x : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                let y : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                self.check_expr(x, TY_UNIT)
                self.check_expr(y, self.ty_of(x))
                let tl : i64 = self.ty_of(x)
                let tr : i64 = self.ty_of(y)
                if tl = TY_UNT and tr ≠ TY_UNT:
                    self.adopt(x, tr)
                elif tr = TY_UNT and tl ≠ TY_UNT:
                    self.adopt(y, tl)
                elif tl = TY_UNT and tr = TY_UNT:
                    self.adopt(x, TY_I64)
                    self.adopt(y, TY_I64)
                // a string compares by what it holds, which the
                // lowering has always known how to ask
                if ty_is_arr(self.ty_of(x)) or ty_is_hash(self.ty_of(x)) or ty_is_tup(self.ty_of(x)) or ty_is_mat(self.ty_of(x)) or ty_is_rg(self.ty_of(x)) or ty_is_lam(self.ty_of(x)):
                    self.derr(tok, "assert_eq compares numbers, truth values, characters and strings in core-2")
                elif not self.try_fit(x, self.ty_of(y)):
                    self.derr(tok, "assert_eq compares two of the same type")
        else:
            if argc < 1 or argc > 2:
                self.derr(tok, "assert takes the condition and possibly a message")
            if argc >= 1:
                let c : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "assert")
            if argc = 2:
                let m : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                self.check_expr(m, TY_UNIT)
                if self.kind_of(m) ≠ NK_STR:
                    self.derr(tok, "assert's message is a string literal")
        self.set_type(id, TY_UNIT)

    fn count_fields(&self, s : str) → i64:
        let cs := s.chars()
        let n : mut i64 = 0
        let i ¤ptrdiff : mut i64 = 0
        while i + 1 < #cs:
            if cs[i] = '{' and cs[i + 1] = '}':
                n ← n + 1
                i ← i + 2
            else:
                i ← i + 1
        n

    fn check_scall(&mut self, id : i64, tok : i64, sb : i64, args_off : i64):
        if sb = SB_PROC:
            // the member's own index rides where an argument list would;
            // what it answers cannot change, so reading it is pure
            if args_off = PROC_PAGESIZE:
                self.set_type(id, ty_with_unit(TY_I64, UNIT_BYTE))
            elif args_off = PROC_SECURE:
                self.set_type(id, TY_BOOL)
            elif args_off = PROC_EXECFN:
                self.set_type(id, TY_STR)
            else:
                self.set_type(id, TY_U32)
            return
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if sb = SB_EXIT:
            if argc ≠ 1:
                self.derr(tok, "std.exit takes the exit code")
            else:
                let c : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(c, TY_I64)
                if self.ty_of(c) = TY_UNT:
                    self.adopt(c, TY_I64)
                elif not ty_is_int(self.ty_of(c)):
                    self.derr(tok, "the exit code is a number")
            self.set_type(id, TY_UNIT)
            return
        if sb = SB_ARGS:
            if argc ≠ 0:
                self.derr(tok, "std.args.all takes nothing")
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "reading the arguments is impure; the function wants @impure")
            self.set_type(id, mk_aty(TY_STR))
            return
        if sb = SB_ENVN or sb = SB_ENVG or sb = SB_ENVH:
            // the environment is the process's own, and reading it is
            // as impure as reading the arguments
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "reading the environment is impure; the function wants @impure")
            if sb = SB_ENVN:
                if argc ≠ 0:
                    self.derr(tok, "std.env.names takes nothing")
                self.set_type(id, mk_aty(TY_STR))
                return
            if argc ≠ 1:
                self.derr(tok, "std.env." ⧺ ("get" if sb = SB_ENVG else "has") ⧺ " takes the variable's name")
            else:
                let nv : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(nv, TY_STR)
                if self.ty_of(nv) ≠ TY_STR:
                    self.derr(tok, "a variable's name is a string, not " ⧺ type_name(self.ty_of(nv)))
            self.set_type(id, mk_oty(TY_STR) if sb = SB_ENVG else TY_BOOL)
            return
        if sb = SB_CWD:
            // looking at a directory writes nothing; only opening and
            // creating files want @impure
            self.set_type(id, TY_DIR)
            return
        if sb = SB_BYTES:
            if argc ≠ 1:
                self.derr(tok, "std.bytes takes the string")
            else:
                let bs : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(bs, TY_STR)
                if self.ty_of(bs) ≠ TY_STR:
                    self.derr(tok, "std.bytes reads a string, not " ⧺ type_name(self.ty_of(bs)))
            self.set_type(id, mk_aty(TY_U8))
            return
        if sb = SB_IOV:
            if argc ≠ 1:
                self.derr(tok, "std.iov takes the one thing it is to write")
            else:
                let iv : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(iv, TY_UNIT)
                self.iov_source_ok(tok, ty_strip_ref(self.ty_of(iv)))
            self.set_type(id, TY_IOVEC)
            return
        if sb = SB_ALLOCATOR:
            if argc ≠ 0:
                self.derr(tok, "std.arena.allocator takes nothing")
            self.set_type(id, TY_ALLOC)
            return
        if sb = SB_OPEN or sb = SB_CREATE:
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "touching files is impure; the function wants @impure")
            if self.in_contract:
                self.derr(tok, "a contract's condition is pure and touches nothing")
            if argc < 1:
                self.derr(tok, "the path comes first")
                self.set_type(id, mk_oty(TY_FILE) if sb = SB_OPEN else TY_FILE)
                return
            let pth : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
            self.check_expr(pth, TY_STR)
            if self.ty_of(pth) ≠ TY_STR:
                self.derr(tok, "the path is a string, not " ⧺ type_name(self.ty_of(pth)))
            if sb = SB_OPEN:
                if argc ≠ 1:
                    self.derr(tok, "open_file takes the path alone")
                self.set_type(id, mk_oty(TY_FILE))
                return
            if argc ≠ 2:
                self.derr(tok, "create_file takes the path and the mode")
            else:
                let md : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                self.check_expr(md, TY_I64)
                if self.ty_of(md) = TY_UNT:
                    self.adopt(md, TY_I64)
                elif not ty_is_int(self.ty_of(md)):
                    self.derr(tok, "the mode is a number")
            self.set_type(id, TY_FILE)
            return
        if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "writing output is impure; the function wants @impure")
        if self.in_contract:
            self.derr(tok, "a contract's condition is pure and writes nothing")
        if argc < 1:
            self.derr(tok, "the first argument is the format string")
            self.set_type(id, TY_UNIT)
            return
        let fmt : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        self.check_expr(fmt, TY_UNIT)
        if self.kind_of(fmt) ≠ NK_STR:
            self.derr(tok, "the format is a string literal in core-1")
            self.set_type(id, TY_UNIT)
            return
        let fields : i64 = self.count_fields(self.a.strs[self.a.na[fmt × 1¤ptrdiff] × 1¤ptrdiff])
        if fields ≠ argc - 1:
            self.derr(tok, "the format's {} fields and the arguments after it disagree in number")
        let i : mut i64 = 2
        while i <= argc:
            let arg : i64 = self.a.extra[(args_off + i) × 1¤ptrdiff]
            self.check_expr(arg, TY_UNIT)
            let t : i64 = self.ty_of(arg)
            if t = TY_UNT:
                self.adopt(arg, TY_I64)
            elif not ty_is_int(t) and t ≠ TY_BOOL and t ≠ TY_STR and t ≠ TY_CHAR:
                self.derr(tok, "println writes numbers, truth values, characters and strings; this is " ⧺ type_name(t))
            i ← i + 1
        self.set_type(id, TY_UNIT)

    // T.offsetof("f"): where the named field begins, settled here and
    // folded, so nothing of it survives into the run
    fn check_offsetof(&mut self, id : i64, tok : i64, si : i64, args_off : i64):
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if argc ≠ 1:
            self.derr(tok, "offsetof names one field, written out as a string")
            self.fold_bytes(id, 0)
            return
        let ae : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        if self.kind_of(ae) ≠ NK_STR:
            self.check_expr(ae, TY_STR)
            self.derr(tok, "offsetof names the field with a written-out string, since the answer is settled before the run")
            self.fold_bytes(id, 0)
            return
        self.set_type(ae, TY_STR)
        let fname := self.a.strs[self.a.na[ae × 1¤ptrdiff] × 1¤ptrdiff]
        let (fidx, fty) := self.field_of(si, fname)
        _ ← fty
        if fidx = ⁻1:
            self.derr(tok, "'" ⧺ self.a.structs[si × 1¤ptrdiff].name ⧺ "' has no field '" ⧺ fname ⧺ "'")
            self.fold_bytes(id, 0)
            return
        let off : i64 = c_field_offset(self.a, si, fidx)
        if off = ⁻1:
            self.layout_err(tok, si, "placed")
            self.fold_bytes(id, 0)
            return
        self.fold_bytes(id, off)

    fn check_mcall(&mut self, id : i64, tok : i64, na : i64, args_off : i64,
                   under_default : bool):
        let m := self.text(tok)
        // the base naming a struct type is a static call, unless a
        // variable shadows the name
        if self.kind_of(na) = NK_VAR:
            let bname := self.text(self.a.ntok[na × 1¤ptrdiff])
            if self.lookup(bname) = ⁻1 and self.struct_index(bname) ≠ ⁻1:
                if m = "offsetof":
                    self.check_offsetof(id, tok, self.struct_index(bname), args_off)
                    return
                self.check_smethod(id, tok, na, args_off, bname, m, false)
                return
        self.check_expr(na, TY_UNIT)
        let t : i64 = self.ty_of(na)
        if ty_is_struct(ty_strip_ref(t)):
            let sname := self.a.structs[ty_sidx(ty_strip_ref(t)) × 1¤ptrdiff].name
            self.check_smethod(id, tok, na, args_off, sname, m, true)
            return
        let argc0 : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if (ty_is_int(t) or t = TY_UNT) and m = "chr":
            if argc0 ≠ 0:
                self.derr(tok, "chr takes nothing")
            if self.kind_of(na) = NK_INT:
                // a literal's character is judged and folded here, with
                // the same three refusals the runtime check makes
                let v : i64 = self.a.na[na × 1¤ptrdiff]
                if v < 0 or self.a.nb[na × 1¤ptrdiff] ≠ 0:
                    self.derr(tok, "chr: the value is not a code point; a character is numbered from 0")
                elif v > 1114111:
                    self.derr(tok, "chr: " ⧺ i64_str(v) ⧺ " is past the last code point, 0x10FFFF")
                elif v >= 55296 and v <= 57343:
                    self.derr(tok, "chr: " ⧺ i64_str(v) ⧺ " is a surrogate, which encodes half of a character in UTF-16 rather than being one")
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.na[id × 1¤ptrdiff] ← v
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_CHAR)
                return
            if t = TY_UNT:
                self.adopt(na, TY_I64)
            self.a.nc[id × 1¤ptrdiff] ← MID_CHR
            self.set_type(id, TY_CHAR)
            return
        if ty_is_enum(t) and m = "ord":
            // the number an enumerator stands for, in the enum's own
            // underlying type -- for a @flag enum, the bit set
            if argc0 ≠ 0:
                self.derr(tok, "ord takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_ORD
            self.set_type(id, self.a.ewidth[ty_eidx(t) × 1¤ptrdiff])
            return
        if t = TY_CHAR and m = "ord":
            if argc0 ≠ 0:
                self.derr(tok, "ord takes nothing")
            if self.kind_of(na) = NK_INT:
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.na[id × 1¤ptrdiff] ← self.a.na[na × 1¤ptrdiff]
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_U32)
                return
            self.a.nc[id × 1¤ptrdiff] ← MID_ORD
            self.set_type(id, TY_U32)
            return
        if t = TY_FILE and m = "writev":
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "touching files is impure; the function wants @impure")
            if self.a.extra[args_off × 1¤ptrdiff] ≠ 1:
                self.derr(tok, "writev takes the runs to write, as one array of std.iovec")
            else:
                let pe : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(pe, mk_aty(TY_IOVEC))
                if ty_strip_ref(self.ty_of(pe)) ≠ mk_aty(TY_IOVEC):
                    self.derr(tok, "writev writes runs of bytes; std.iov makes one, and this is " ⧺ type_name(self.ty_of(pe)))
            self.a.nc[id × 1¤ptrdiff] ← MID_WRITEV
            self.set_type(id, TY_UNIT)
            return
        if t = TY_FILE and (m = "read_file" or m = "write" or m = "close"):
            if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                self.derr(tok, "touching files is impure; the function wants @impure")
            if m = "read_file":
                if argc0 ≠ 1:
                    self.derr(tok, "read_file takes the allocator")
                else:
                    let al : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                    self.check_expr(al, TY_UNIT)
                    if self.ty_of(al) ≠ TY_ALLOC:
                        self.derr(tok, "read_file reads through an allocator; std.arena.allocator() answers one")
                self.a.nc[id × 1¤ptrdiff] ← MID_READF
                self.set_type(id, mk_aty(TY_U8))
                return
            if m = "write":
                if argc0 ≠ 1:
                    self.derr(tok, "write takes the bytes to put down")
                else:
                    let bs : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                    self.check_expr(bs, TY_UNIT)
                    if self.ty_of(bs) ≠ mk_aty(TY_U8):
                        self.derr(tok, "write puts down bytes, not " ⧺ type_name(self.ty_of(bs)))
                self.a.nc[id × 1¤ptrdiff] ← MID_WRITEF
                self.set_type(id, TY_UNIT)
                return
            if argc0 ≠ 0:
                self.derr(tok, "close takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_CLOSEF
            self.set_type(id, TY_UNIT)
            return
        if t = TY_DIR and m = "iterate":
            if argc0 ≠ 0:
                self.derr(tok, "iterate takes nothing")
            let de : i64 = TY_ENTRY
            let di : mut i64 = ⁻1
            let dm : i64 = @dropunit(#self.ite)
            let ds : mut i64 = 0
            while ds < dm:
                if self.ite[ds × 1¤ptrdiff] = de:
                    di ← ds
                ds ← ds + 1
            if di = ⁻1:
                di ← dm
                self.ite.push(de)
            self.a.nc[id × 1¤ptrdiff] ← MID_DIRITER
            self.set_type(id, 30720 + di)
            return
        if ty_is_arr(t) and m = "iterate":
            if argc0 ≠ 0:
                self.derr(tok, "iterate takes nothing")
            let ie : i64 = self.elem_of(t)
            let ii : mut i64 = ⁻1
            let mi : i64 = @dropunit(#self.ite)
            let si : mut i64 = 0
            while si < mi:
                if self.ite[si × 1¤ptrdiff] = ie:
                    ii ← si
                si ← si + 1
            if ii = ⁻1:
                ii ← mi
                self.ite.push(ie)
            self.a.nc[id × 1¤ptrdiff] ← MID_ITER
            self.set_type(id, 30720 + ii)
            return
        if ty_is_iter(t) and m = "next":
            if argc0 ≠ 0:
                self.derr(tok, "next takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_NEXT
            let ne : i64 = self.ite[ty_iidx(t) × 1¤ptrdiff]
            self.set_type(id, ne if under_default else mk_oty(ne))
            return
        if t = TY_STR and m = "chars":
            if argc0 ≠ 0:
                self.derr(tok, "chars takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_CHARS
            self.set_type(id, mk_aty(TY_CHAR))
            return
        if not ty_is_arr(t):
            self.derr(tok, "'" ⧺ m ⧺ "' is asked of an array, a struct, a string, a character or a number; this is " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if ty_is_row(t) and (m = "push" or m = "pop" or m = "insert" or m = "remove"):
            self.derr(tok, "a matrix's row keeps its length; the matrix said it")
            self.set_type(id, TY_UNIT if m = "push" else self.elem_of(t))
            return
        if ty_is_farr(t) and (m = "push" or m = "pop"):
            self.derr(tok, "a sized array holds its size; push and pop change none")
            self.set_type(id, TY_UNIT if m = "push" else self.elem_of(t))
            return
        if m = "push":
            self.require_mut_base(na, tok)
            if argc ≠ 1:
                self.derr(tok, "push takes the one element to append")
            else:
                let arg : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(arg, self.elem_of(t))
                if self.ty_of(arg) = TY_UNT:
                    self.adopt(arg, self.elem_of(t))
                elif not self.try_fit(arg, self.elem_of(t)):
                    self.derr(tok, "the array holds " ⧺ type_name(self.elem_of(t)) ⧺ ", not " ⧺ type_name(self.ty_of(arg)))
            self.a.nc[id × 1¤ptrdiff] ← MID_PUSH
            self.set_type(id, TY_UNIT)
        elif m = "pop":
            self.require_mut_base(na, tok)
            if argc ≠ 0:
                self.derr(tok, "pop takes nothing")
            self.a.nc[id × 1¤ptrdiff] ← MID_POP
            // under ?? the default stands in and the value is bare;
            // anywhere else the absence is the answer, and it is boxed
            // as any optional is
            self.set_type(id, self.elem_of(t) if under_default else mk_oty(self.elem_of(t)))
        elif m = "get":
            if argc ≠ 1:
                self.derr(tok, "get takes the index to look at")
            else:
                self.check_index_expr(tok, t, self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.a.nc[id × 1¤ptrdiff] ← MID_GET
            self.set_type(id, self.elem_of(t) if under_default else mk_oty(self.elem_of(t)))
        else:
            self.derr(tok, "'" ⧺ m ⧺ "' is not a core-1 array method; push, pop and get are")
            self.set_type(id, TY_I64)

    fn check_smethod(&mut self, id : i64, tok : i64, na : i64, args_off : i64,
                     sname : str, m : str, instance : bool):
        let fname : str = sname ⧺ "." ⧺ m
        let f : i64 = self.fn_index(fname)
        if f = ⁻1:
            self.derr(tok, "'" ⧺ sname ⧺ "' has no method '" ⧺ m ⧺ "'")
            self.set_type(id, TY_I64)
            return
        let callee := self.a.fns[f × 1¤ptrdiff]
        if callee.is_impure and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "'" ⧺ fname ⧺ "' is @impure, and impurity travels to the caller")
        if self.in_contract and callee.is_impure:
            self.derr(tok, "a contract's condition is pure; '" ⧺ fname ⧺ "' is not")
        let np : i64 = self.a.extra[callee.params_off × 1¤ptrdiff]
        let self_n : i64 = 1 if instance else 0
        if instance:
            if np = 0 or not ty_is_struct(ty_strip_ref(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff])):
                self.derr(tok, "'" ⧺ fname ⧺ "' is a static method; ask it of the struct's name")
                self.set_type(id, callee.ret)
                return
            let srk : i64 = ty_ref_kind(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff])
            if srk = 2:
                self.require_mut_base(na, tok)
        elif np > 0 and ty_is_struct(ty_strip_ref(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff])) and ty_ref_kind(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff]) ≠ 0:
            self.derr(tok, "'" ⧺ fname ⧺ "' works an instance; ask it of a value, not the name")
            self.set_type(id, callee.ret)
            return
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if argc ≠ np - self_n:
            self.derr(tok, "'" ⧺ fname ⧺ "' wants " ⧺ i64_str(np - self_n) ⧺ " arguments, not " ⧺ i64_str(argc))
            self.set_type(id, callee.ret)
            return
        let j : mut i64 = 0
        while j < argc:
            let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
            let pty : i64 = self.a.extra[(callee.params_off + 2 + (j + self_n) × 2) × 1¤ptrdiff]
            self.check_one_arg(tok, fname, j + 1, arg, pty)
            j ← j + 1
        // lowering finds the function and whether a receiver travels
        self.a.nc[id × 1¤ptrdiff] ← 1000 + 2 × f + (1 if instance else 0)
        self.set_type(id, callee.ret)

    fn is_ignored_name(&self, name : str) → bool:
        if #self.a.ignored > 0:
            foreach n := self.a.ignored:
                if n = name:
                    return true
        false

    fn call_noreturn(&self, e : i64) → bool:
        let f : i64 = self.fn_index(self.text(self.a.ntok[e × 1¤ptrdiff]))
        f ≠ ⁻1 and self.a.fns[f × 1¤ptrdiff].is_noreturn

    fn require_mut_base(&mut self, base : i64, tok : i64):
        if self.kind_of(base) = NK_FIELD or self.kind_of(base) = NK_INDEX:
            self.require_mut_base(self.a.na[base × 1¤ptrdiff], tok)
            return
        if self.kind_of(base) ≠ NK_VAR:
            self.derr(tok, "what is being changed is named directly in core-2")
            return
        let name := self.text(self.a.ntok[base × 1¤ptrdiff])
        let s : i64 = self.lookup(name)
        if s = ⁻1:
            let g : i64 = self.global_index(name)
            if g ≠ ⁻1 and not self.a.globals[g × 1¤ptrdiff].is_mut:
                self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may change it")
            return
        let pt : i64 = self.stype[s × 1¤ptrdiff]
        if ty_ref_kind(pt) = 1:
            self.derr(tok, "'" ⧺ name ⧺ "' is a shared borrow; & reads and &mut changes")
        elif ty_ref_kind(pt) = 0 and self.smut[s × 1¤ptrdiff] = 0:
            self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may change it")

    // a bare ÷ or % answering into an optional: the zero divisor is ∅
    fn check_retdiv(&mut self, na : i64, want : i64):
        let base : i64 = ty_opt_base(want)
        let dl : i64 = self.a.na[na × 1¤ptrdiff]
        let dr : i64 = self.a.nb[na × 1¤ptrdiff]
        self.check_expr(dl, base)
        self.check_expr(dr, base)
        if self.ty_of(dl) = TY_UNT and self.ty_of(dr) = TY_UNT:
            self.adopt(dl, base if ty_is_int(base) else TY_I64)
            self.adopt(dr, base if ty_is_int(base) else TY_I64)
        let t : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, self.kind_of(na), self.ty_of(dl), self.ty_of(dr))
        self.set_type(na, t if t ≠ TY_UNT else TY_I64)
        if self.ty_of(na) ≠ base:
            self.derr(self.a.ntok[na × 1¤ptrdiff], "the function answers " ⧺ type_name(want) ⧺ ", but the division works " ⧺ type_name(self.ty_of(na)))

    fn check_default(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        let ik : i64 = self.kind_of(na)
        if ik = NK_DIV or ik = NK_MOD:
            let dl : i64 = self.a.na[na × 1¤ptrdiff]
            let dr : i64 = self.a.nb[na × 1¤ptrdiff]
            self.check_expr(dl, want)
            self.check_expr(dr, want)
            let tl : i64 = self.ty_of(dl)
            let tr : i64 = self.ty_of(dr)
            if tl = TY_UNT and tr = TY_UNT:
                let w : i64 = want if ty_is_int(want) else TY_I64
                self.adopt(dl, w)
                self.adopt(dr, w)
            let t : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, ik,
                                           self.ty_of(dl), self.ty_of(dr))
            self.set_type(na, t if t ≠ TY_UNT else TY_I64)
        elif ik = NK_MCALL:
            self.check_mcall(na, self.a.ntok[na × 1¤ptrdiff],
                             self.a.na[na × 1¤ptrdiff],
                             self.a.nb[na × 1¤ptrdiff], true)
        else:
            let ow : i64 = mk_oty(want) if want ≠ TY_UNIT and (ty_is_int(want) or want = TY_BOOL or want = TY_STR or ty_is_struct(want)) else TY_UNIT
            self.check_expr(na, ow)
            if ty_is_opt(self.ty_of(na)):
                let base : i64 = ty_opt_base(self.ty_of(na))
                if self.kind_of(nb) = NK_CALL and self.call_noreturn(nb):
                    // the default never answers; the held value's type
                    // stands alone
                    self.check_expr(nb, TY_UNIT)
                    self.set_type(id, base)
                    return
                self.check_expr(nb, base)
                if self.is_open(self.ty_of(nb)):
                    self.adopt(nb, base)
                elif not self.try_fit(nb, base):
                    self.derr(tok, "the default answers for the value, so it is " ⧺ type_name(base) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
                self.set_type(id, base)
                return
            self.derr(tok, "?? follows what answers a result or an optional")
        let t : i64 = self.ty_of(na)
        self.check_expr(nb, t)
        if self.ty_of(nb) = TY_UNT:
            self.adopt(nb, t)
        elif not self.try_fit(nb, t):
            self.derr(tok, "the default answers for the value, so it is " ⧺ type_name(t) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
        self.set_type(id, t)

    // ------------------------------------------------------------------
    // Statements
    // ------------------------------------------------------------------

    fn check_block(&mut self, blk : i64, is_fn_body : bool):
        self.push_scope()
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let s : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let trailing : bool = is_fn_body and i = n - 1
            self.check_stmt(s, trailing)
            i ← i + 1
        self.pop_scope()

    fn check_stmt(&mut self, id : i64, trailing : bool):
        let k : i64 = self.kind_of(id)
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_HINTED:
            // the hint says nothing about what is checked
            self.check_stmt(na, trailing)
            return
        if k = NK_EXPECTS:
            // A statement expected to draw an error is parsed and left
            // alone, as a definition marked the same way is: it does
            // not check, so there is nothing to check it against, and
            // which diagnostic it was is the interpreter's to say.
            // One expecting only a warning is an ordinary statement
            // here -- core-2 has no warnings to draw -- so it is
            // checked and reported on as any other, rather than having
            // its refusals quietly swallowed.
            if nb = 0:
                self.check_stmt(na, false)
            return
        if k = NK_LET:
            if nc = ⁻1:
                // := and : mut =: the right side says the type; what
                // it does not say is refused with the stated-form cure
                self.check_expr(na, TY_UNIT)
                let it : i64 = self.ty_of(na)
                if it = TY_UNT:
                    self.derr(tok, "a binding with no type written down settles on 'int'; state a sized type, as 'let " ⧺ self.text(tok) ⧺ " : i64 = …'")
                    _ ← self.declare(tok, TY_I64, nb)
                    return
                if it = TY_EMPTY:
                    self.derr(tok, "∅ alone says no type; state the optional, as 'let " ⧺ self.text(tok) ⧺ " : i64? = ∅'")
                    _ ← self.declare(tok, mk_oty(TY_I64), nb)
                    return
                if it = TY_UNIT:
                    self.derr(tok, "the right side answers nothing; there is nothing to bind")
                    _ ← self.declare(tok, TY_I64, nb)
                    return
                if ty_is_hash(it) and nb = 1 and self.kind_of(na) ≠ NK_HLIT:
                    self.derr(tok, "a mut hash binding is born from its literal; borrow with &mut to change a shared one")
                    _ ← self.declare(tok, it, nb)
                    return
                if ty_is_arr(it) and nb = 1 and self.kind_of(na) ≠ NK_ARRLIT and self.kind_of(na) ≠ NK_CALL and self.kind_of(na) ≠ NK_MCALL and self.kind_of(na) ≠ NK_RESHAPE and self.kind_of(na) ≠ NK_CCAT and self.kind_of(na) ≠ NK_SLICE and self.kind_of(na) ≠ NK_SCALL:
                    self.derr(tok, "a mut array binding is born fresh, from its literal or a call; borrow with &mut to change a shared one")
                    _ ← self.declare(tok, it, nb)
                    return
                if ty_is_struct(it) and nb = 1 and not self.is_fresh_struct(na):
                    self.derr(tok, "a mut struct binding is born fresh, from its literal or a call; borrow with &mut to change a shared one")
                let islot : i64 = self.declare(tok, it, nb)
                self.nslot[id × 1¤ptrdiff] ← islot
                return
            if ty_is_hash(nc):
                if nb = 1 and self.kind_of(na) ≠ NK_HLIT:
                    self.derr(tok, "a mut hash binding is born from its literal; borrow with &mut to change a shared one")
                self.check_expr(na, nc)
                if self.kind_of(na) ≠ NK_HLIT and self.ty_of(na) ≠ nc:
                    self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
                let slot1 : i64 = self.declare(tok, nc, nb)
                self.nslot[id × 1¤ptrdiff] ← slot1
                return
            if ty_is_struct(nc):
                // a struct value is a reference, as the bootstrap has
                // it: a read-only binding may name one held anywhere;
                // only a mut binding must be born fresh, so a mutable
                // alias cannot arise from a let
                if nb = 1 and not self.is_fresh_struct(na):
                    self.derr(tok, "a mut struct binding is born fresh, from its literal or a call; borrow with &mut to change a shared one")
                self.check_expr(na, nc)
                if self.ty_of(na) ≠ nc and not ty_is_arr(self.ty_of(na)):
                    if self.ty_of(na) ≠ TY_I64:
                        self.derr(tok, "the binding says " ⧺ self.sname_of(nc) ⧺ " but the value is " ⧺ self.sname_of(self.ty_of(na)))
                let slot0 : i64 = self.declare(tok, nc, nb)
                self.nslot[id × 1¤ptrdiff] ← slot0
                return
            if ty_is_arr(nc):
                if self.kind_of(na) = NK_CCAT:
                    self.check_expr(na, nc)
                    if self.ty_of(na) ≠ nc and not ty_is_farr(nc):
                        self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
                    let slot8 : i64 = self.declare(tok, nc, nb)
                    self.nslot[id × 1¤ptrdiff] ← slot8
                    return
                if self.kind_of(na) = NK_RESHAPE:
                    self.check_expr(na, nc)
                    let slot9 : i64 = self.declare(tok, nc, nb)
                    self.nslot[id × 1¤ptrdiff] ← slot9
                    return
                if self.kind_of(na) ≠ NK_ARRLIT:
                    // a call answers a fresh array; any other right side
                    // names a shared one, which a mut binding may not
                    self.check_expr(na, nc)
                    if nb = 1 and self.kind_of(na) ≠ NK_CALL and self.kind_of(na) ≠ NK_MCALL:
                        self.derr(tok, "a mut array binding is born fresh, from its literal or a call; borrow with &mut to change a shared one")
                    if self.ty_of(na) ≠ nc:
                        self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
                else:
                    self.check_expr(na, nc)
                    if self.ty_of(na) ≠ nc and self.a.extra[self.a.na[na × 1¤ptrdiff] × 1¤ptrdiff] > 0:
                        self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
                    self.set_type(na, nc)
            else:
                self.check_expr(na, nc)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, nc)
                elif not self.try_fit(na, nc):
                    self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
            let slot : i64 = self.declare(tok, nc, nb)
            self.nslot[id × 1¤ptrdiff] ← slot
        elif k = NK_LETT:
            let n : i64 = self.a.extra[nc × 1¤ptrdiff]
            let styp : i64 = self.a.extra[(nc + 1) × 1¤ptrdiff]
            self.check_expr(na, styp if styp ≠ ⁻1 else TY_UNIT)
            let it : i64 = self.ty_of(na)
            if not ty_is_tup(it):
                self.derr(tok, "the names take a tuple apart; the right side is " ⧺ type_name(it))
                let j : mut i64 = 0
                while j < n:
                    let tj : i64 = self.a.extra[(nc + 2 + j) × 1¤ptrdiff]
                    if self.text(tj) ≠ "_":
                        _ ← self.declare(tj, TY_I64, nb)
                    j ← j + 1
                return
            if styp ≠ ⁻1 and it ≠ styp:
                self.derr(tok, "the binding says " ⧺ type_name(styp) ⧺ " but the value is " ⧺ type_name(it))
            if self.tup_len(it) ≠ n:
                self.derr(tok, "the tuple holds " ⧺ i64_str(self.tup_len(it)) ⧺ " elements; " ⧺ i64_str(n) ⧺ " names try to take it")
                let j2 : mut i64 = 0
                while j2 < n:
                    let tj2 : i64 = self.a.extra[(nc + 2 + j2) × 1¤ptrdiff]
                    if self.text(tj2) ≠ "_":
                        _ ← self.declare(tj2, self.tup_elem(it, j2) if j2 < self.tup_len(it) else TY_I64, nb)
                    j2 ← j2 + 1
                return
            let slot0 : mut i64 = ⁻1
            let i : mut i64 = 0
            while i < n:
                let t2 : i64 = self.a.extra[(nc + 2 + i) × 1¤ptrdiff]
                let sl : mut i64 = 0
                if self.text(t2) = "_":
                    // '_' takes no name but keeps the row of slots whole
                    sl ← self.nslots
                    self.nslots ← self.nslots + 1
                else:
                    sl ← self.declare(t2, self.tup_elem(it, i), nb)
                if i = 0:
                    slot0 ← sl
                i ← i + 1
            assert(self.nslots = slot0 + n, "the names' slots sit side by side")
            self.nslot[id × 1¤ptrdiff] ← slot0
        elif k = NK_ASSIGN:
            let name := self.text(tok)
            let s : i64 = self.lookup(name)
            if s = ⁻1:
                let g : i64 = self.global_index(name)
                if g = ⁻1:
                    self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
                    self.check_expr(na, TY_UNIT)
                    return
                let gd := self.a.globals[g × 1¤ptrdiff]
                if not gd.is_mut:
                    self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may be stored into it")
                if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                    self.derr(tok, "writing a global is an effect; the function wants @impure")
                self.check_expr(na, gd.ty)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, gd.ty)
                elif not self.try_fit(na, gd.ty):
                    self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ type_name(gd.ty) ⧺ ", not " ⧺ type_name(self.ty_of(na)))
                self.nslot[id × 1¤ptrdiff] ← 0 - g - 2
                return
            let st : i64 = self.stype[s × 1¤ptrdiff]
            if ty_ref_kind(st) = 2 and not ty_is_arr(ty_strip_ref(st)) and not ty_is_hash(ty_strip_ref(st)) and not ty_is_struct(ty_strip_ref(st)):
                // through the element's address, back into the array
                self.check_expr(na, ty_strip_ref(st))
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, ty_strip_ref(st))
                elif not self.try_fit(na, ty_strip_ref(st)):
                    self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ type_name(ty_strip_ref(st)) ⧺ ", not " ⧺ type_name(self.ty_of(na)))
                self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
                self.a.nb[id × 1¤ptrdiff] ← 1
                self.set_type(id, TY_UNIT)
                return
            if ty_ref_kind(st) = 1 and not ty_is_arr(ty_strip_ref(st)) and not ty_is_hash(ty_strip_ref(st)) and not ty_is_struct(ty_strip_ref(st)):
                self.derr(tok, "'" ⧺ name ⧺ "' is a shared borrow; & reads and &mut changes")
                self.check_expr(na, TY_UNIT)
                return
            if ty_is_struct(ty_strip_ref(st)) and not self.is_fresh_struct(na):
                self.derr(tok, "a struct binding takes a fresh struct; the fields change in place")
            if ty_is_hash(ty_strip_ref(st)):
                self.derr(tok, "a core-2 hash is built once and changed in place")
            if (ty_is_arr(ty_strip_ref(st)) or ty_is_mat(ty_strip_ref(st))) and not (self.kind_of(na) = NK_ARRLIT or self.kind_of(na) = NK_CALL or self.kind_of(na) = NK_MCALL or self.kind_of(na) = NK_RESHAPE or self.kind_of(na) = NK_CCAT or self.kind_of(na) = NK_SLICE):
                self.derr(tok, "a mut array binding takes a fresh array; borrow with &mut to change a shared one")
            if self.smut[s × 1¤ptrdiff] = 0:
                self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may be stored into it")
            self.check_expr(na, ty_strip_ref(st))
            if self.is_open(self.ty_of(na)):
                self.adopt(na, ty_strip_ref(st))
            elif not self.try_fit(na, ty_strip_ref(st)):
                self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ type_name(ty_strip_ref(st)) ⧺ ", not " ⧺ type_name(self.ty_of(na)))
            self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
        elif k = NK_STOREIDXP:
            self.check_expr(na, TY_UNIT)
            let bt0 : i64 = ty_strip_ref(self.ty_of(na))
            if ty_is_hash(bt0):
                self.require_mut_base(na, tok)
                self.check_hash_key(tok, bt0, nb)
                let vt : i64 = ty_hval(bt0)
                self.check_expr(nc, vt)
                if self.is_open(self.ty_of(nc)):
                    self.adopt(nc, vt)
                elif not self.try_fit(nc, vt):
                    self.derr(tok, "the hash holds " ⧺ type_name(vt) ⧺ ", not " ⧺ type_name(self.ty_of(nc)))
                self.set_type(id, bt0)
                return
            if ty_is_tup(bt0):
                self.derr(tok, "a tuple's element is fixed at its birth")
                self.check_expr(nc, TY_UNIT)
                return
            if bt0 = TY_STR:
                self.derr(tok, "a string cannot be written through; build the one that is wanted with ⧺")
                self.check_expr(nc, TY_UNIT)
                return
            if ty_is_mat(bt0):
                self.require_mut_base(na, tok)
                self.check_index_expr(tok, bt0, nb)
                if self.mat_cc(bt0) = ⁻1:
                    self.derr(tok, "the matrix leaves its row length open, so a stored row has nothing to be measured against; state the extent in the type")
                    self.check_expr(nc, TY_UNIT)
                    return
                if self.kind_of(nc) ≠ NK_ARRLIT:
                    self.derr(tok, "a stored row is written out, so its length is seen where it is stored")
                    self.check_expr(nc, TY_UNIT)
                    return
                let rl9 : i64 = self.a.extra[self.a.na[nc × 1¤ptrdiff] × 1¤ptrdiff]
                if rl9 ≠ self.mat_cc(bt0):
                    self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(self.mat_cc(bt0)) ⧺ ", got " ⧺ i64_str(rl9))
                self.check_expr(nc, mk_aty(self.mat_elem(bt0)))
                self.set_type(id, bt0)
                return
            if not ty_is_arr(bt0):
                self.derr(tok, "only an array or a hash is written by element; this is " ⧺ type_name(bt0))
                self.check_expr(nc, TY_UNIT)
                return
            self.require_mut_base(na, tok)
            self.check_index_expr(tok, bt0, nb)
            self.check_expr(nc, self.elem_of(bt0))
            if self.ty_of(nc) = TY_UNT:
                self.adopt(nc, self.elem_of(bt0))
            elif not self.try_fit(nc, self.elem_of(bt0)):
                self.derr(tok, "the array holds " ⧺ type_name(self.elem_of(bt0)) ⧺ ", not " ⧺ type_name(self.ty_of(nc)))
            self.set_type(id, bt0)
        elif k = NK_STOREFLD:
            self.check_expr(na, TY_UNIT)
            let bt : i64 = ty_strip_ref(self.ty_of(na))
            if not ty_is_struct(bt):
                self.derr(tok, "only a struct's field is stored into; this is " ⧺ type_name(bt))
                self.check_expr(nb, TY_UNIT)
                return
            self.require_mut_base(na, tok)
            let (fidx, fty) := self.field_of(ty_sidx(bt), self.text(tok))
            if fidx = ⁻1:
                self.derr(tok, "'" ⧺ self.sname_of(bt) ⧺ "' has no field '" ⧺ self.text(tok) ⧺ "'")
                self.check_expr(nb, TY_UNIT)
                return
            self.a.nc[id × 1¤ptrdiff] ← fidx
            self.check_expr(nb, fty)
            if self.is_open(self.ty_of(nb)):
                self.adopt(nb, fty)
            elif not self.try_fit(nb, fty):
                self.derr(tok, "field '" ⧺ self.text(tok) ⧺ "' holds " ⧺ type_name(fty) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
        elif k = NK_DISCARD:
            if self.kind_of(na) = NK_MCALL:
                self.check_mcall(na, self.a.ntok[na × 1¤ptrdiff],
                                 self.a.na[na × 1¤ptrdiff],
                                 self.a.nb[na × 1¤ptrdiff], true)
            else:
                self.check_expr(na, TY_UNIT)
            if self.ty_of(na) = TY_UNT:
                self.adopt(na, TY_I64)
        elif k = NK_IF:
            self.check_expr(na, TY_UNIT)
            self.want_truthy(na, "the condition")
            self.check_block(nb, false)
            if nc ≠ ⁻1:
                self.check_block(nc, false)
        elif k = NK_WHILE:
            self.check_expr(na, TY_UNIT)
            self.want_truthy(na, "the condition")
            self.loop_depth ← self.loop_depth + 1
            self.check_block(nb, false)
            self.loop_depth ← self.loop_depth - 1
        elif k = NK_MATCH:
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if not ty_is_opt(t):
                self.derr(tok, "match asks an optional which it is; this is " ⧺ type_name(t))
                return
            let some_blk : i64 = self.a.extra[nb × 1¤ptrdiff]
            let empty_blk : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
            self.push_scope()
            let slot : i64 = self.declare(tok, ty_opt_base(t), 0)
            self.nslot[id × 1¤ptrdiff] ← slot
            // a trailing match hands each arm's value on as the
            // function's answer
            self.check_block(some_blk, trailing)
            self.pop_scope()
            self.check_block(empty_blk, trailing)
            if trailing and self.a.fns[self.cur_fn × 1¤ptrdiff].ret ≠ TY_UNIT:
                if not self.block_yields(some_blk):
                    self.derr(tok, "the ∃ arm answers nothing on some path")
                if not self.block_yields(empty_blk):
                    self.derr(tok, "the ∅ arm answers nothing on some path")
        elif k = NK_FOREACH:
            self.check_foreach(id, tok, na, nb)
        elif k = NK_WHILEB:
            // pop unwraps here the way ?? unwraps it: the loop's own
            // test is what a default would be
            let ismc : bool = self.kind_of(na) = NK_MCALL
            if ismc:
                self.check_mcall(na, self.a.ntok[na × 1¤ptrdiff],
                                 self.a.na[na × 1¤ptrdiff],
                                 self.a.nb[na × 1¤ptrdiff], true)
            else:
                self.check_expr(na, TY_UNIT)
            let wct : i64 = self.ty_of(na)
            let wmid : i64 = self.a.nc[na × 1¤ptrdiff] if ismc else 0
            let wbt : mut i64 = TY_I64
            if ismc and (wmid = MID_POP or wmid = MID_NEXT or wmid = MID_GET):
                wbt ← wct
            elif ty_is_opt(wct):
                wbt ← ty_opt_base(wct)
            elif (ty_is_int(wct) and ty_unit(wct) = 0) or wct = TY_BOOL:
                // a number loops while it is not zero, a truth while it
                // holds; the binding is the value itself
                wbt ← wct
            else:
                self.derr(tok, "a while binding loops while a value is there; this answers " ⧺ type_name(wct) ⧺ ", not an optional")
            let wmut : i64 = self.a.extra[nc × 1¤ptrdiff]
            if wmut = 1 and not (ismc and wmid = MID_NEXT):
                // only an iterator's next hands an element to write
                // back through; everything else hands values
                self.derr(tok, "a mut while binding writes back through the element; this loop hands values")
            let wsty : i64 = self.a.extra[(nc + 1) × 1¤ptrdiff]
            if wsty ≠ ⁻1 and wsty ≠ wbt:
                self.derr(tok, "the binding says " ⧺ type_name(wsty) ⧺ " but the loop answers " ⧺ type_name(wbt))
            self.push_scope()
            let wdty : i64 = wbt + 262144 × 2 if wmut = 1 and ismc and wmid = MID_NEXT else wbt
            let wslot : i64 = self.declare(tok, wdty, wmut)
            self.nslot[id × 1¤ptrdiff] ← wslot
            self.loop_depth ← self.loop_depth + 1
            self.check_block(nb, false)
            self.loop_depth ← self.loop_depth - 1
            self.pop_scope()
        elif k = NK_FOREACHA:
            let frk : mut i64 = 0
            let fiter : mut i64 = na
            if self.kind_of(na) = NK_REF:
                frk ← self.a.nb[na × 1¤ptrdiff]
                fiter ← self.a.na[na × 1¤ptrdiff]
                self.check_expr(fiter, TY_UNIT)
                let ft0 : i64 = self.ty_of(fiter)
                if not ty_is_arr(ft0):
                    self.derr(tok, "a borrowed walk lends an array's elements; this is " ⧺ type_name(ft0))
                    return
                if ty_is_struct(self.elem_of(ft0)):
                    self.derr(tok, "a struct element is already shared; change its fields in place")
                    return
                if frk = 2:
                    self.require_mut_base(fiter, tok)
                self.a.na[id × 1¤ptrdiff] ← fiter
                self.a.nc[id × 1¤ptrdiff] ← frk
                self.push_scope()
                let rslot : i64 = self.declare(tok, self.elem_of(ft0) + 262144 × frk, 1 if frk = 2 else 0)
                self.nslot[id × 1¤ptrdiff] ← rslot
                self.loop_depth ← self.loop_depth + 1
                self.check_block(nb, false)
                self.loop_depth ← self.loop_depth - 1
                self.pop_scope()
                return
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if not ty_is_arr(t) and t ≠ TY_STR and not ty_is_mat(t) and not ty_is_rg(t):
                self.derr(tok, "foreach walks an array, a string or a range; this is " ⧺ type_name(t))
                return
            self.push_scope()
            let slot : i64 = self.declare(tok, TY_CHAR if t = TY_STR else (ty_rgelem(t) if ty_is_rg(t) else self.elem_of(t)), 0)
            self.nslot[id × 1¤ptrdiff] ← slot
            self.loop_depth ← self.loop_depth + 1
            self.check_block(nb, false)
            self.loop_depth ← self.loop_depth - 1
            self.pop_scope()
        elif k = NK_RETURN:
            if self.lam_ret ≠ ⁻1:
                // inside a lambda's block a return answers the lambda
                let lwant : i64 = self.lam_ret
                if na = ⁻1:
                    self.derr(tok, "the lambda answers " ⧺ type_name(lwant) ⧺ "; a bare return does not")
                    return
                if ty_is_opt(lwant) and (self.kind_of(na) = NK_DIV or self.kind_of(na) = NK_MOD):
                    self.check_retdiv(na, lwant)
                    return
                self.check_expr(na, lwant)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, lwant)
                elif not self.try_fit(na, lwant):
                    if not (ty_is_opt(lwant) and self.try_fit(na, ty_opt_base(lwant))):
                        self.derr(tok, "the lambda answers " ⧺ type_name(lwant) ⧺ ", not " ⧺ type_name(self.ty_of(na)))
                return
            if ty_is_var(self.a.fns[self.cur_fn × 1¤ptrdiff].ret) and na ≠ ⁻1:
                // the first answer settles a T' return
                self.check_expr(na, TY_UNIT)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, TY_I64)
                self.a.fns[self.cur_fn × 1¤ptrdiff].ret ← self.ty_of(na)
                return
            let want : i64 = self.a.fns[self.cur_fn × 1¤ptrdiff].ret
            if na = ⁻1:
                if want ≠ TY_UNIT:
                    self.derr(tok, "the function answers " ⧺ type_name(want) ⧺ "; a bare return does not")
            elif ty_is_opt(want) and (self.kind_of(na) = NK_DIV or self.kind_of(na) = NK_MOD):
                self.check_retdiv(na, want)
            else:
                self.check_expr(na, want)
                if want = TY_UNIT:
                    self.derr(tok, "the function answers nothing, but this return carries a value")
                elif self.is_open(self.ty_of(na)):
                    self.adopt(na, want)
                elif not self.try_fit(na, want):
                    if not (ty_is_opt(want) and self.try_fit(na, ty_opt_base(want))):
                        self.derr(tok, "the function answers " ⧺ self.sname_of(want) ⧺ ", not " ⧺ self.sname_of(self.ty_of(na)))
        elif k = NK_BREAK or k = NK_CONTINUE:
            if self.loop_depth = 0:
                self.derr(tok, "there is no loop here to act on")
        elif k = NK_EXPRSTMT:
            if trailing and self.lam_ret ≠ ⁻1:
                let lwant : i64 = self.lam_ret
                if ty_is_opt(lwant) and (self.kind_of(na) = NK_DIV or self.kind_of(na) = NK_MOD):
                    self.check_retdiv(na, lwant)
                    return
                self.check_expr(na, lwant)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, lwant)
                elif not self.try_fit(na, lwant):
                    if not (ty_is_opt(lwant) and self.try_fit(na, ty_opt_base(lwant))):
                        self.derr(tok, "the lambda answers " ⧺ type_name(lwant) ⧺ ", but its last expression is " ⧺ type_name(self.ty_of(na)))
                return
            if trailing and ty_is_var(self.a.fns[self.cur_fn × 1¤ptrdiff].ret):
                // the trailing value settles a T' return
                self.check_expr(na, TY_UNIT)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, TY_I64)
                self.a.fns[self.cur_fn × 1¤ptrdiff].ret ← self.ty_of(na)
                return
            let want : i64 = self.a.fns[self.cur_fn × 1¤ptrdiff].ret
            if trailing and want ≠ TY_UNIT and ty_is_opt(want) and (self.kind_of(na) = NK_DIV or self.kind_of(na) = NK_MOD):
                self.check_retdiv(na, want)
            elif trailing and want ≠ TY_UNIT:
                self.check_expr(na, want)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, want)
                elif not self.try_fit(na, want):
                    if not (ty_is_opt(want) and self.try_fit(na, ty_opt_base(want))):
                        self.derr(tok, "the function answers " ⧺ self.sname_of(want) ⧺ ", but its last expression is " ⧺ self.sname_of(self.ty_of(na)))
            else:
                self.check_expr(na, TY_UNIT)
                let t : i64 = self.ty_of(na)
                if t ≠ TY_UNIT and self.kind_of(na) ≠ NK_EMPTYV:
                    // a bare ∅ says "nothing here", which is exactly
                    // what a unit position holds
                    self.derr(tok, "the value of this statement is not used; bind it or write '_ ← …'")
        else:
            self.derr(tok, "this statement kind escaped the checker; that is an ngplc bug")

    fn check_foreach(&mut self, id : i64, tok : i64, na : i64, body : i64):
        let lo : i64 = self.a.extra[na × 1¤ptrdiff]
        let step : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi : i64 = self.a.extra[(na + 2) × 1¤ptrdiff]
        self.check_expr(lo, TY_UNIT)
        self.check_expr(hi, self.ty_of(lo))
        if step ≠ ⁻1:
            self.check_expr(step, self.ty_of(lo))
        // the variable's type is what the bounds agree on
        let tl : i64 = self.ty_of(lo)
        let th : i64 = self.ty_of(hi)
        let vt : mut i64 = TY_I64
        if tl ≠ TY_UNT:
            vt ← tl
        elif th ≠ TY_UNT:
            vt ← th
        elif step ≠ ⁻1 and self.ty_of(step) ≠ TY_UNT:
            vt ← self.ty_of(step)
        if not ty_is_int(vt):
            self.derr(tok, "a range walks numbers; this is " ⧺ type_name(vt))
            vt ← TY_I64
        self.adopt(lo, vt)
        self.adopt(hi, vt)
        if self.ty_of(lo) ≠ vt or self.ty_of(hi) ≠ vt:
            self.derr(tok, "the range's ends say one type between them")
        if step ≠ ⁻1:
            self.adopt(step, vt)
            if self.ty_of(step) ≠ vt:
                self.derr(tok, "the step follows the range's type")
        self.push_scope()
        let slot : i64 = self.declare(tok, vt, 0)
        self.nslot[id × 1¤ptrdiff] ← slot
        self.loop_depth ← self.loop_depth + 1
        self.check_block(body, false)
        self.loop_depth ← self.loop_depth - 1
        self.pop_scope()

    // ------------------------------------------------------------------
    // Whether execution can only leave this statement by returning
    // ------------------------------------------------------------------

    fn always_returns(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        if k = NK_RETURN:
            return true
        if k = NK_EXPRSTMT:
            let e : i64 = self.a.na[id × 1¤ptrdiff]
            let ek : i64 = self.kind_of(e)
            if ek = NK_SCALL and self.a.na[e × 1¤ptrdiff] = SB_EXIT:
                return true
            if ek = NK_CALL:
                let f : i64 = self.fn_index(self.text(self.a.ntok[e × 1¤ptrdiff]))
                if f ≠ ⁻1:
                    return self.a.fns[f × 1¤ptrdiff].is_noreturn
            return false
        if k = NK_IF:
            let nc : i64 = self.a.nc[id × 1¤ptrdiff]
            if nc = ⁻1:
                return false
            return self.block_returns(self.a.nb[id × 1¤ptrdiff]) and self.block_returns(nc)
        if k = NK_MATCH:
            let nb : i64 = self.a.nb[id × 1¤ptrdiff]
            return self.block_returns(self.a.extra[nb × 1¤ptrdiff]) and self.block_returns(self.a.extra[(nb + 1) × 1¤ptrdiff])
        if k = NK_BLOCK:
            return self.block_returns(id)
        false

    // whether a block's last statement hands a value on or returns
    fn block_yields(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
        self.kind_of(last) = NK_EXPRSTMT or self.kind_of(last) = NK_MATCH or self.always_returns(last)

    fn block_returns(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        self.always_returns(self.a.extra[(off + n) × 1¤ptrdiff])

    // ------------------------------------------------------------------
    // Functions and globals
    // ------------------------------------------------------------------

    fn fn_is_generic(&self, f : i64) → bool:
        let d := self.a.fns[f × 1¤ptrdiff]
        if ty_is_var(d.ret):
            return true
        let np : i64 = self.a.extra[d.params_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < np:
            if ty_is_var(ty_strip_ref(self.a.extra[(d.params_off + 2 + i × 2) × 1¤ptrdiff])):
                return true
            i ← i + 1
        false

    fn check_fn(&mut self, f : i64):
        self.cur_fn ← f
        self.nslots ← 0
        self.loop_depth ← 0
        while #self.snames > 0:
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0
        while #self.marks > 0:
            _ ← self.marks.pop() ?? 0
        let d := self.a.fns[f × 1¤ptrdiff]
        self.push_scope()
        let np : i64 = self.a.extra[d.params_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < np:
            let ptok : i64 = self.a.extra[(d.params_off + 1 + i × 2) × 1¤ptrdiff]
            let pty : i64 = self.a.extra[(d.params_off + 2 + i × 2) × 1¤ptrdiff]
            _ ← self.declare(ptok, pty, 1 if ty_ref_kind(pty) = 2 or ty_ref_kind(pty) = 3 else 0)
            i ← i + 1
        assert(self.nslots >= np, "every parameter took a slot")
        if np > 12:
            self.derr(d.tok, "more than twelve parameters is not core-2 yet")
        let pi : mut i64 = 0
        while pi < np:
            let pty : i64 = self.a.extra[(d.params_off + 2 + pi × 2) × 1¤ptrdiff]
            pi ← pi + 1
        self.in_contract ← true
        if d.pre_off ≠ ⁻1:
            let n : i64 = self.a.extra[d.pre_off × 1¤ptrdiff]
            let j : mut i64 = 0
            while j < n:
                let c : i64 = self.a.extra[(d.pre_off + 1 + j) × 1¤ptrdiff]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "@pre")
                j ← j + 1
        if d.post_off ≠ ⁻1:
            let n : i64 = self.a.extra[d.post_off × 1¤ptrdiff]
            self.push_scope()
            if n > 0:
                let rtok : i64 = self.a.extra[(d.post_off + 1) × 1¤ptrdiff]
                if d.ret = TY_UNIT:
                    self.derr(rtok, "@post names a result, but the function answers nothing")
                else:
                    _ ← self.declare(rtok, d.ret, 0)
            let j : mut i64 = 0
            while j < n:
                let c : i64 = self.a.extra[(d.post_off + 2 + j × 2) × 1¤ptrdiff]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "@post")
                j ← j + 1
            self.pop_scope()
        self.in_contract ← false
        self.check_block(d.body, true)
        self.pop_scope()
        if d.ret ≠ TY_UNIT:
            let off : i64 = self.a.na[d.body × 1¤ptrdiff]
            let n : i64 = self.a.extra[off × 1¤ptrdiff]
            let last_is_value : mut bool = false
            if n > 0:
                let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
                if self.kind_of(last) = NK_EXPRSTMT or self.kind_of(last) = NK_MATCH:
                    last_is_value ← true
            if not last_is_value and not self.block_returns(d.body):
                self.derr(d.tok, "'" ⧺ d.name ⧺ "' answers " ⧺ type_name(d.ret) ⧺ " but not on every path")
        self.fslots[f × 1¤ptrdiff] ← self.nslots
        self.fdone[f × 1¤ptrdiff] ← 1

    fn check_global(&mut self, g : i64):
        let gd := self.a.globals[g × 1¤ptrdiff]
        if gd.ty = ⁻1:
            // := at the top level: the right side says the type
            self.check_expr(gd.init, TY_UNIT)
            if self.ty_of(gd.init) = TY_UNT:
                self.adopt(gd.init, TY_I64)
            let it : i64 = self.ty_of(gd.init)
            self.a.globals[g × 1¤ptrdiff].ty ← it
            if ty_is_lam(it):
                // the box is built by init code before @start runs
                if gd.is_mut:
                    self.derr(gd.tok, "a global function value is immutable")
                self.gvals.push(0)
                self.ginit.push(g)
                return
            let ik0 : i64 = self.kind_of(gd.init)
            if (ty_is_int(it) or it = TY_BOOL) and (ik0 = NK_INT or ik0 = NK_BOOL):
                self.gvals.push(self.a.na[gd.init × 1¤ptrdiff])
                return
            self.derr(gd.tok, "a global begins at a constant the compiler can see")
            self.gvals.push(0)
            return
        if ty_is_hash(gd.ty):
            // an immutable hash global: its literal of constants is
            // built by init code before the start function runs
            if gd.is_mut:
                self.derr(gd.tok, "a global hash is immutable; build a mut one where it is used")
            if self.kind_of(gd.init) ≠ NK_HLIT:
                self.derr(gd.tok, "a global hash is born from its literal")
                self.gvals.push(0)
                return
            self.check_expr(gd.init, gd.ty)
            let hoff : i64 = self.a.na[gd.init × 1¤ptrdiff]
            let hn : i64 = self.a.extra[hoff × 1¤ptrdiff]
            let hi : mut i64 = 0
            while hi < hn:
                let ke : i64 = self.a.extra[(hoff + 1 + hi × 2) × 1¤ptrdiff]
                let ve : i64 = self.a.extra[(hoff + 2 + hi × 2) × 1¤ptrdiff]
                if self.kind_of(ke) ≠ NK_INT and self.kind_of(ke) ≠ NK_STR:
                    self.derr(gd.tok, "a global hash holds constants the compiler can see")
                if self.kind_of(ve) ≠ NK_INT and self.kind_of(ve) ≠ NK_STR and self.kind_of(ve) ≠ NK_BOOL:
                    self.derr(gd.tok, "a global hash holds constants the compiler can see")
                hi ← hi + 1
            self.gvals.push(0)
            self.ginit.push(g)
            return
        if ty_is_arr(gd.ty) or gd.ty = TY_STR or ty_is_tup(gd.ty):
            self.derr(gd.tok, "a core-2 global is a number, a truth value or a hash of constants")
            self.gvals.push(0)
            return
        // fold the initializer to the constant the image carries
        self.check_expr(gd.init, gd.ty)
        if self.ty_of(gd.init) = TY_UNT:
            self.adopt(gd.init, gd.ty)
        elif self.ty_of(gd.init) ≠ gd.ty:
            self.derr(gd.tok, "the binding says " ⧺ type_name(gd.ty) ⧺ " but the value is " ⧺ type_name(self.ty_of(gd.init)))
        let ik : i64 = self.kind_of(gd.init)
        if ik = NK_INT or ik = NK_BOOL:
            self.gvals.push(self.a.na[gd.init × 1¤ptrdiff])
        else:
            self.derr(gd.tok, "a global begins at a constant the compiler can see")
            self.gvals.push(0)

fn check(a : Ast, toks : Toks, src : byte[]) → Chk:
    let fnames : mut str[] = []
    foreach f := a.fns:
        fnames.push(f.name)
    let gnames : mut str[] = []
    foreach g := a.globals:
        gnames.push(g.name)
    let nnodes : i64 = @dropunit(#a.nkind)
    let ntype : mut i64[] = []
    let nslot : mut i64[] = []
    let ncvt : mut i64[] = []
    let zi : mut i64 = 0
    while zi < nnodes:
        ntype.push(0)
        nslot.push(⁻1)
        ncvt.push(0)
        zi ← zi + 1
    let c : mut Checker = (Checker{a: a, toks: toks, src: src, fnames: fnames,
                                   gnames: gnames, gvals: [], ginit: [], ite: [],
                                   ntype: ntype, nslot: nslot, ncvt: ncvt,
                                   fslots: [],
                                   diags: [], snames: [], stype: [], smut: [],
                                   sslot: [], marks: [], nslots: 0,
                                   loop_depth: 0, cur_fn: 0,
                                   in_contract: false,
                                   scope_floor: 0, lams: [], lamns: [],
                                   psfn: [], psk: [], psnp: [],
                                   fdone: [], skipfn: [], lam_ret: ⁻1})
    if #a.structs > 0:
        foreach i := 0…#a.structs - 1:
            let sd := a.structs[i]
            foreach j := 0…#a.structs - 1:
                if j > i and a.structs[j].name = sd.name:
                    c.derr(a.structs[j].tok, "'" ⧺ sd.name ⧺ "' is already defined")
            let nf : i64 = a.extra[sd.fields_off × 1¤ptrdiff]
            let x : mut i64 = 0
            while x < nf:
                let y : mut i64 = x + 1
                while y < nf:
                    let tx : i64 = a.extra[(sd.fields_off + 1 + x × 2) × 1¤ptrdiff]
                    let ty0 : i64 = a.extra[(sd.fields_off + 1 + y × 2) × 1¤ptrdiff]
                    if c.text(tx) = c.text(ty0):
                        c.derr(ty0, "'" ⧺ sd.name ⧺ "' names field '" ⧺ c.text(tx) ⧺ "' twice")
                    y ← y + 1
                x ← x + 1
            // a @repr(C) struct is held to what C can represent where
            // it is written, not where its size is first asked for, so
            // the complaint points at the offending field
            if sd.is_repr_c:
                let bad : i64 = c_bad_field(a, @dropunit(i))
                if bad ≠ ⁻1:
                    let btok : i64 = a.extra[(sd.fields_off + 1 + bad × 2) × 1¤ptrdiff]
                    let bty : i64 = a.extra[(sd.fields_off + 2 + bad × 2) × 1¤ptrdiff]
                    c.derr(btok, "in @repr(C) struct '" ⧺ sd.name ⧺ "', field '" ⧺ c.text(btok) ⧺ "': " ⧺ type_name(bty) ⧺ " has no defined C representation")
    let starts : mut i64 = 0
    if #a.fns > 0:
      foreach i := 0…#a.fns - 1:
        let f := a.fns[i]
        foreach j := 0…#a.fns - 1:
            if j > i and a.fns[j].name = f.name:
                c.derr(a.fns[j].tok, "'" ⧺ f.name ⧺ "' is already defined")
        if f.name = "assert" or f.name = "assert_eq":
            c.derr(f.tok, "'" ⧺ f.name ⧺ "' is the built-in check's name")
        if f.is_test:
            if a.extra[f.params_off × 1¤ptrdiff] ≠ 0:
                c.derr(f.tok, "a @test function takes no parameters")
            if f.ret ≠ TY_UNIT:
                c.derr(f.tok, "a @test function answers nothing; assert is how it speaks")
            if f.is_start:
                c.derr(f.tok, "@test and @start name different duties; one function carries one")
        if f.is_start:
            starts ← starts + 1
            if a.extra[f.params_off × 1¤ptrdiff] ≠ 0:
                c.derr(f.tok, "the @start function takes no parameters")
            if f.ret ≠ TY_UNIT and not (ty_is_int(f.ret) and ty_unit(f.ret) = 0):
                c.derr(f.tok, "the @start function answers the exit status, a plain integer, or nothing")

    // per-function state first: a global's initializer may call, and
    // the call consults it
    if #a.fns > 0:
        foreach i := 0…#a.fns - 1:
            c.fslots.push(0)
            c.fdone.push(0)
            c.skipfn.push(0)
    if #a.globals > 0:
        foreach i := 0…#a.globals - 1:
            foreach j := 0…#a.globals - 1:
                if j > i and a.globals[j].name = a.globals[i].name:
                    c.derr(a.globals[j].tok, "'" ⧺ a.globals[i].name ⧺ "' is already defined")
            c.check_global(@dropunit(i))
    let ntests : mut i64 = 0
    foreach f2 := a.fns:
        if f2.is_test:
            ntests ← ntests + 1
    if starts = 0 and ntests = 0 and #a.igtests = 0:
        c.diags.push(Diag{line: 1, col: 1, msg: "no @start function and no @test; nothing would run"})
    if starts > 1:
        c.diags.push(Diag{line: 1, col: 1, msg: "more than one @start function"})
    if #a.fns > 0:
        foreach i := 0…#a.fns - 1:
            if not c.fn_is_generic(@dropunit(i)):
                c.check_fn(@dropunit(i))
        // a generic no call reached is never shaped; a stub stands in
        foreach i := 0…#a.fns - 1:
            if c.fdone[i] = 0:
                c.skipfn[i] ← 1
    if #c.diags = 0:
        assert(#c.fslots = #a.fns, "one slot count per function")
        assert(#c.gvals = #a.globals, "one folded value per global")
    (Chk{ntype: c.ntype, nslot: c.nslot, ncvt: c.ncvt, fslots: c.fslots,
         gvals: c.gvals, ginit: c.ginit, lams: c.lams, lamns: c.lamns,
         psfn: c.psfn, psk: c.psk, psnp: c.psnp, skipfn: c.skipfn,
         diags: c.diags})

// ===========================================================================
// The IR: linear three-address code over virtual registers
// ===========================================================================
//
// Every operation carries the width it works at: w = bits + 256×sgn.
// Checked arithmetic aborts on overflow -- a cold, never-taken branch,
// which is what production checkers emit and costs nothing on the hot
// path; @wrap variants mask instead.  Comparisons materialize their
// answer with setcc; selection is a conditional move.

let IR_CONST : i64 = 1     // d ← imm a
let IR_MOV : i64 = 2       // d ← vreg a
let IR_ADD : i64 = 10
let IR_SUB : i64 = 11
let IR_MUL : i64 = 12
let IR_ADDW : i64 = 13
let IR_SUBW : i64 = 14
let IR_MULW : i64 = 15
let IR_NEG : i64 = 16
let IR_NEGW : i64 = 17
let IR_BAND : i64 = 18
let IR_BORR : i64 = 19
let IR_BXORR : i64 = 20
let IR_BNOTT : i64 = 21
let IR_SHLL : i64 = 22
let IR_SHRR : i64 = 23
let IR_DIVV : i64 = 24     // d ← a ÷ b, c the default when b = 0
let IR_MODD : i64 = 25
let IR_MAXX : i64 = 26     // d ← the larger of a and b, by cmov
let IR_MINN : i64 = 27
let IR_SEL : i64 = 28      // d ← b when a is true, else c, by cmov
let IR_CEQ : i64 = 30
let IR_CNE : i64 = 31
let IR_CLT : i64 = 32
let IR_CLE : i64 = 33
let IR_CGT : i64 = 34
let IR_CGE : i64 = 35
let IR_JMP : i64 = 40      // a = label
let IR_JZ : i64 = 41       // a = vreg, b = label
let IR_JNZ : i64 = 42
let IR_LABEL : i64 = 43    // a = label
let IR_CALL : i64 = 44     // d ← call fn a, args at extra b: [argc, vreg…]
let IR_RET : i64 = 45      // a = vreg, ⁻1 for none
let IR_PRINTS : i64 = 46   // a = string index (its bytes)
let IR_PRINTI : i64 = 47   // a = vreg, signed decimal
let IR_PRINTU : i64 = 48   // a = vreg, unsigned decimal
let IR_EXIT : i64 = 49     // a = vreg
let IR_ABORT : i64 = 50    // a = string index of the message
let IR_GLOAD : i64 = 51    // d ← global a
let IR_GSTORE : i64 = 52   // global a ← vreg b
let IR_ANEW : i64 = 53     // d ← a fresh array, capacity imm a
let IR_APUSH : i64 = 54    // array a grows by vreg b
let IR_AIDX : i64 = 55     // d ← a[b], bounds-checked
let IR_ASTO : i64 = 56     // a[b] ← c, bounds-checked
let IR_APOP : i64 = 57     // d ← a's last, or b when empty
let IR_AGET : i64 = 58     // d ← a[b], or c when out of range
let IR_ALEN : i64 = 59     // d ← how many a holds
let IR_SC : i64 = 60       // d ← the descriptor of string literal a
let IR_SCCAT : i64 = 61    // d ← a ⧺ b
let IR_SEQV : i64 = 62     // d ← a = b, for strings
let IR_SLENV : i64 = 63    // d ← how many characters a holds
let IR_PRINTSV : i64 = 64  // a = vreg holding a string
let IR_JTAB : i64 = 65     // a = vreg, b = extra [min, span, Ldef, L…]
let IR_VTAB : i64 = 69     // d ← value table: a = vreg, b = extra [min, span, default, v…]
let IR_HNEW : i64 = 70     // d ← a fresh hash: a = capacity, b = 1 for str keys
let IR_HPUT : i64 = 71     // hash a takes key b → value c
let IR_HGET : i64 = 72     // d ← hash a asked for key b, an optional
let IR_HELEM : i64 = 73    // d ← whether hash a holds key b
let IR_HLEN : i64 = 74     // d ← how many hash a holds
let IR_CHR : i64 = 75      // d ← a as a character, judged first
let IR_SIDX : i64 = 76     // d ← string a's character at position b
let IR_CHARS : i64 = 77    // d ← string a's characters, an array
let IR_CHARSTR : i64 = 78  // d ← character a as a fresh string
let IR_ARGS : i64 = 80     // d ← the program's arguments, a str[]
let IR_FOPEN : i64 = 81    // d ← the file at path a, an optional
let IR_FCREATE : i64 = 82  // d ← a fresh file at path a with mode b
let IR_FREAD : i64 = 83    // d ← file a's bytes, a u8[]
let IR_FWRITE : i64 = 84   // file a takes the bytes of array b
let IR_FCLOSE : i64 = 85   // file a closes
let IR_NARROW : i64 = 86   // d ← a, stopped unless it fits width w
let IR_EPRINTS : i64 = 87  // string a on the error stream
let IR_AFIND : i64 = 88    // d ← where b sits in array a (c: str elems)
let IR_ASLICE : i64 = 89   // d ← array a's elements b…c, a fresh array
let IR_SATADD : i64 = 90   // d ← a + b, held at width w's edge
let IR_SATSUB : i64 = 91   // d ← a - b, held at the edge
let IR_SATMUL : i64 = 92   // d ← a × b, held at the edge
let IR_AFILL : i64 = 93    // d ← a copies of scalar b, a fresh array
let IR_ACYC : i64 = 94     // d ← array b's elements cycled to count a
let IR_ACAT : i64 = 95     // d ← arrays a then b, one fresh array
let IR_SBYTES : i64 = 96   // d ← string a's bytes, a u8[]
let IR_AREF : i64 = 97     // d ← the address of array a's element b
let IR_DENTS : i64 = 98    // d ← the working directory's entries
let IR_ENVN : i64 = 101    // d ← the environment's names, a str[]
let IR_ENVG : i64 = 102    // d ← the value of the variable named a, a str?
let IR_SDEC : i64 = 105    // d ← the character at a's byte b, c ← the byte after it
let IR_AUXV : i64 = 103    // d ← the auxiliary vector's entry for key a
let IR_EXECFN : i64 = 104  // d ← AT_EXECFN as a string
let IR_FADDR : i64 = 99    // d ← the code address of function a
let IR_TORAW : i64 = 106   // d ← a raw byte run holding what the u8[] a says
let IR_WRITEV : i64 = 107  // file a takes the runs held in array b
let IR_CALLI : i64 = 100   // d ← call the address in vreg a, args at extra b
let IR_SNEW : i64 = 66     // d ← a fresh struct of a fields
let IR_FLD : i64 = 67      // d ← field b of struct a
let IR_FSTO : i64 = 68     // field b of struct a ← c

struct IrFn:
    op : i64[]
    ia : i64[]
    ib : i64[]
    ic : i64[]
    id : i64[]
    iw : i64[]
    extra : i64[]
    nvregs : i64
    nlabels : i64

// ===========================================================================
// Lowering: Ast + Chk → IrFn per function
// ===========================================================================

struct Lower:
    a : Ast
    toks : Toks
    src : byte[]
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    strs : str[]
    op : i64[]
    ia : i64[]
    ib : i64[]
    ic : i64[]
    idd : i64[]
    iww : i64[]
    extra : i64[]
    tbase : i64
    tnext : i64
    tmax : i64
    nlabels : i64
    breaks : i64[]
    conts : i64[]
    in_wrap : i64
    argsfix : i64
    lambase : i64        // the first lambda's function index
    shimbase : i64       // the first partial-application shim's        // the argument filter's index, ⁻1 for raw
    cur_ret : i64
    post_label : i64
    res_vreg : i64
    cur_fname : str
    dlog : str[]         // one JSON line per code-shaping decision

@post(r: (r & 255) >= 8 and (r & 255) <= 64)
fn width_of(t : i64) → i64:
    // the width an operation on this type runs at, bits + 256×sgn
    if t = TY_BOOL: return 64 + 256
    if not ty_is_int(t): return 64 + 256
    ty_bits(t) + 256 × ty_sgn(t)

impl Lower:
    fn ir(&mut self, o : i64, a : i64, b : i64, c : i64, d : i64, w : i64):
        self.op.push(o)
        self.ia.push(a)
        self.ib.push(b)
        self.ic.push(c)
        self.idd.push(d)
        self.iww.push(w)

    fn tmp(&mut self) → i64:
        let v : i64 = self.tnext
        self.tnext ← self.tnext + 1
        if self.tnext > self.tmax:
            self.tmax ← self.tnext
        v

    fn label(&mut self) → i64:
        let l : i64 = self.nlabels
        self.nlabels ← self.nlabels + 1
        l

    fn intern(&mut self, s : str) → i64:
        // a program without one string literal arrives here empty, and
        // 0…⁻1 would walk down; the guard keeps the range ascending
        if #self.strs > 0:
            foreach i := 0…#self.strs - 1:
                if self.strs[i] = s:
                    return @dropunit(i)
        let idx : i64 = @dropunit(#self.strs)
        self.strs.push(s)
        idx

    fn fname_index(&self, name : str) → i64:
        foreach i := 0…#self.a.fns - 1:
            if self.a.fns[i].name = name:
                return @dropunit(i)
        ⁻1

    fn text(&self, tok : i64) → str:
        run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    fn tok_line(&self, tok : i64) → i64:
        self.toks.line[tok × 1¤ptrdiff]

    // what was decided and where, for the log a program can read
    fn decide(&mut self, line : i64, what : str, detail : str):
        self.dlog.push("{\"function\": \"" ⧺ self.cur_fname ⧺ "\", \"line\": " ⧺ i64_str(line) ⧺ ", \"decision\": \"" ⧺ what ⧺ "\"" ⧺ detail ⧺ "}")

    fn tof(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kof(&self, id : i64) → i64:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // What may be read without being asked: no effects, no faults.
    // Checked arithmetic can abort, so only @wrap arithmetic passes;
    // loads from arrays are bounds-checked, so they do not.  This is
    // the speculation-legality rule if-conversion runs on.
    // ------------------------------------------------------------------

    fn speculatable(&self, id : i64) → bool:
        let k : i64 = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_INT or k = NK_BOOL or k = NK_STR or k = NK_VAR or k = NK_EMPTYV:
            return true
        if k = NK_NOT or k = NK_BNOT:
            return self.speculatable(na)
        if k = NK_LEN or k = NK_FIELD:
            return self.speculatable(na)
        if k = NK_WRAP:
            return self.wrap_speculatable(na)
        if k = NK_EQ or k = NK_NE or k = NK_LT or k = NK_LE or k = NK_GT or k = NK_GE or k = NK_LAND or k = NK_LOR or k = NK_AND or k = NK_OR or k = NK_MAXOP or k = NK_MINOP:
            return self.speculatable(na) and self.speculatable(nb)
        if k = NK_COND:
            return self.speculatable(na) and self.speculatable(nb) and self.speculatable(nc)
        false

    fn wrap_speculatable(&self, id : i64) → bool:
        // inside @wrap the arithmetic cannot abort; shifts still can
        let k : i64 = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if k = NK_ADD or k = NK_SUB or k = NK_MUL or k = NK_BAND or k = NK_BOR or k = NK_BXOR:
            return self.wrap_speculatable(na) and self.wrap_speculatable(nb)
        if k = NK_NEG or k = NK_BNOT:
            return self.wrap_speculatable(na)
        self.speculatable(id)

    // ------------------------------------------------------------------
    // Expressions
    // ------------------------------------------------------------------

    fn lower_expr(&mut self, nid : i64) → i64:
        let v : i64 = self.lower_expr_i(nid)
        let cw : i64 = self.ncvt[nid × 1¤ptrdiff]
        if cw = 0:
            return v
        // the checker admitted a narrowing or sign-crossing here; the
        // run stops where a value does not fit, as the interpreter does
        let d : i64 = self.tmp()
        self.ir(IR_NARROW, v, 0, 0, d, width_of(cw))
        d

    fn lower_expr_i(&mut self, nid : i64) → i64:
        let k : i64 = self.kof(nid)
        let tok : i64 = self.a.ntok[nid × 1¤ptrdiff]
        let na : i64 = self.a.na[nid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[nid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[nid × 1¤ptrdiff]
        let w : i64 = width_of(self.tof(nid))
        if k = NK_INT or k = NK_BOOL:
            let d : i64 = self.tmp()
            self.ir(IR_CONST, na, 0, 0, d, w)
            return d
        if k = NK_STR:
            let d : i64 = self.tmp()
            self.ir(IR_SC, na, 0, 0, d, w)
            return d
        if k = NK_VAR:
            let slot : i64 = self.nslot[nid × 1¤ptrdiff]
            if slot <= ⁻2:
                let d : i64 = self.tmp()
                self.ir(IR_GLOAD, 0 - slot - 2, 0, 0, d, w)
                return d
            if self.a.nb[nid × 1¤ptrdiff] = 1:
                // an element reference: the slot holds the address
                let d : i64 = self.tmp()
                self.ir(IR_FLD, slot, 0, 0, d, w)
                return d
            return slot
        if k = NK_ARRLIT:
            return self.lower_arrlit(nid, na)
        if k = NK_HLIT:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            // a group is sixteen slots wide, so a table is at least one
            let cap : mut i64 = 16
            while cap × 7 < (n + 1) × 8:
                cap ← cap × 2
            let keystr : i64 = 1 if ty_hkey(self.tof(nid)) = TY_STR else 0
            let d : i64 = self.tmp()
            self.ir(IR_HNEW, cap, keystr, 0, d, 0)
            let i : mut i64 = 0
            while i < n:
                let kv : i64 = self.lower_expr(self.a.extra[(na + 1 + i × 2) × 1¤ptrdiff])
                let vv : i64 = self.lower_expr(self.a.extra[(na + 2 + i × 2) × 1¤ptrdiff])
                self.ir(IR_HPUT, d, kv, vv, 0, 0)
                i ← i + 1
            return d
        if k = NK_DROPU:
            return self.lower_expr(na)
        if k = NK_MSLICE:
            return self.lower_mslice(nid, na, nb, nc)
        if k = NK_SLICE:
            let av : i64 = self.lower_expr(na)
            let lo : i64 = self.lower_expr(nb)
            let hi : i64 = self.lower_expr(nc)
            let d : i64 = self.tmp()
            self.ir(IR_ASLICE, av, lo, hi, d, 0)
            return d
        if k = NK_RESHAPE:
            if ty_is_mat(self.tof(nid)):
                return self.lower_mreshape(nid, na, nb)
            let nv : i64 = self.lower_expr(na)
            if ty_is_rg(self.tof(nb)):
                let fvr : i64 = self.lower_rg_arr(nb)
                let dr : i64 = self.tmp()
                self.ir(IR_ACYC, nv, fvr, 0, dr, 0)
                return dr
            let fv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            if ty_is_arr(self.tof(nb)):
                self.ir(IR_ACYC, nv, fv, 0, d, 0)
            else:
                self.ir(IR_AFILL, nv, fv, 0, d, 0)
            return d
        if k = NK_TUPLE:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, n, 0, 0, d, 0)
            let i : mut i64 = 0
            while i < n:
                let ev : i64 = self.lower_expr(self.a.extra[(na + 1 + i) × 1¤ptrdiff])
                self.ir(IR_FSTO, d, i, ev, 0, 0)
                i ← i + 1
            return d
        if k = NK_SLIT:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, n, 0, 0, d, 0)
            let i : mut i64 = 0
            while i < n:
                let fidx : i64 = self.a.extra[(na + 1 + i × 2) × 1¤ptrdiff]
                let ev : i64 = self.lower_expr(self.a.extra[(na + 2 + i × 2) × 1¤ptrdiff])
                self.ir(IR_FSTO, d, fidx, ev, 0, 0)
                i ← i + 1
            return d
        if k = NK_LAMBDA:
            let loff : i64 = na
            let np9 : i64 = self.a.extra[loff × 1¤ptrdiff]
            let ncap9 : i64 = self.a.extra[(loff + 1 + np9 × 2) × 1¤ptrdiff]
            let ord9 : i64 = self.nslot[nid × 1¤ptrdiff]
            let d9l : i64 = self.tmp()
            self.ir(IR_SNEW, 1 + ncap9, 0, 0, d9l, 0)
            let av9 : i64 = self.tmp()
            self.ir(IR_FADDR, self.lambase + ord9, 0, 0, av9, 0)
            self.ir(IR_FSTO, d9l, 0, av9, 0, 0)
            let ci9 : mut i64 = 0
            while ci9 < ncap9:
                // the capture cell holds the outer slot -- or, below
                // zero, a function whose value-box is built here
                let cell9 : i64 = self.a.extra[(loff + 2 + np9 × 2 + ci9) × 1¤ptrdiff]
                if cell9 < 0:
                    let fb9 : i64 = self.tmp()
                    self.ir(IR_SNEW, 1, 0, 0, fb9, 0)
                    let fa9 : i64 = self.tmp()
                    self.ir(IR_FADDR, 0 - cell9 - 1, 0, 0, fa9, 0)
                    self.ir(IR_FSTO, fb9, 0, fa9, 0, 0)
                    self.ir(IR_FSTO, d9l, 1 + ci9, fb9, 0, 0)
                else:
                    self.ir(IR_FSTO, d9l, 1 + ci9, cell9, 0, 0)
                ci9 ← ci9 + 1
            return d9l
        if k = NK_FNVAL:
            let d9f : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, d9f, 0)
            let av9f : i64 = self.tmp()
            self.ir(IR_FADDR, na, 0, 0, av9f, 0)
            self.ir(IR_FSTO, d9f, 0, av9f, 0, 0)
            return d9f
        if k = NK_TRY:
            if self.kof(na) = NK_DIV or self.kof(na) = NK_MOD:
                // the zero divisor answers the function early with ∅
                let av9t : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let bv9t : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
                let lok9 : i64 = self.label()
                self.ir(IR_JNZ, bv9t, lok9, 0, 0, 0)
                let zn9 : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, zn9, 0)
                self.lower_ret(zn9)
                self.ir(IR_LABEL, lok9, 0, 0, 0, 0)
                let zd9 : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, zd9, 0)
                let dq9 : i64 = self.tmp()
                self.ir(IR_DIVV if self.kof(na) = NK_DIV else IR_MODD, av9t, bv9t, zd9, dq9, width_of(self.tof(na)))
                return dq9
            let bx9 : i64 = self.lower_expr(na)
            let lok9b : i64 = self.label()
            self.ir(IR_JNZ, bx9, lok9b, 0, 0, 0)
            let zn9b : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, zn9b, 0)
            self.lower_ret(zn9b)
            self.ir(IR_LABEL, lok9b, 0, 0, 0, 0)
            let du9 : i64 = self.tmp()
            self.ir(IR_FLD, bx9, 0, 0, du9, 0)
            return du9
        if k = NK_RANGEV:
            let lov9 : i64 = self.lower_expr(na)
            let hiv9 : i64 = self.lower_expr(nb)
            let stv9 : i64 = self.tmp()
            if nc = ⁻1:
                // no step written: the direction follows the bounds
                let c9 : i64 = self.tmp()
                self.ir(IR_CLE, lov9, hiv9, 0, c9, 64 + 256)
                let one9 : i64 = self.tmp()
                self.ir(IR_CONST, 1, 0, 0, one9, 0)
                let mone9 : i64 = self.tmp()
                self.ir(IR_CONST, ⁻1, 0, 0, mone9, 0)
                self.ir(IR_SEL, c9, one9, mone9, stv9, 0)
            else:
                let sv9 : i64 = self.lower_expr(nc)
                self.ir(IR_MOV, sv9, 0, 0, stv9, 0)
            let d9r : i64 = self.tmp()
            self.ir(IR_SNEW, 3, 0, 0, d9r, 0)
            self.ir(IR_FSTO, d9r, 0, lov9, 0, 0)
            self.ir(IR_FSTO, d9r, 1, stv9, 0, 0)
            self.ir(IR_FSTO, d9r, 2, hiv9, 0, 0)
            return d9r
        if k = NK_FIELD:
            if ty_is_mat(ty_strip_ref(self.tof(na))):
                // shape: the row count and the first row's length; a
                // matrix is never empty, so the first row is there
                let mv : i64 = self.lower_expr(na)
                let d9 : i64 = self.tmp()
                self.ir(IR_ANEW, 4, 0, 0, d9, 0)
                let rl9 : i64 = self.tmp()
                self.ir(IR_ALEN, mv, 0, 0, rl9, 0)
                self.ir(IR_APUSH, d9, rl9, 0, 0, 0)
                let z9 : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, z9, 0)
                let r09 : i64 = self.tmp()
                self.ir(IR_AIDX, mv, z9, 0, r09, 0)
                let cl9 : i64 = self.tmp()
                self.ir(IR_ALEN, r09, 0, 0, cl9, 0)
                self.ir(IR_APUSH, d9, cl9, 0, 0, 0)
                if self.mat_rank(ty_strip_ref(self.tof(na))) = 3:
                    // a cube's planes are matrices, so one step further
                    // in reaches the row whose length is the last extent
                    let r19 : i64 = self.tmp()
                    self.ir(IR_AIDX, r09, z9, 0, r19, 0)
                    let dl9 : i64 = self.tmp()
                    self.ir(IR_ALEN, r19, 0, 0, dl9, 0)
                    self.ir(IR_APUSH, d9, dl9, 0, 0, 0)
                return d9
            let bv : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_FLD, bv, nb, 0, d, 0)
            return d
        if k = NK_SOME:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, d, 0)
            self.ir(IR_FSTO, d, 0, v, 0, 0)
            return d
        if k = NK_EMPTYV:
            let d : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, d, 0)
            return d
        if k = NK_INDEX:
            if ty_is_tup(self.tof(na)):
                let av0 : i64 = self.lower_expr(na)
                let d0 : i64 = self.tmp()
                self.ir(IR_FLD, av0, self.a.na[nb × 1¤ptrdiff], 0, d0, w)
                return d0
            if self.tof(na) = TY_STR:
                let av1 : i64 = self.lower_expr(na)
                let iv1 : i64 = self.lower_expr(nb)
                let d1 : i64 = self.tmp()
                self.ir(IR_SIDX, av1, iv1, 0, d1, w)
                return d1
            let av : i64 = self.lower_expr(na)
            let iv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            if ty_is_hash(self.tof(na)):
                self.ir(IR_HGET, av, iv, 0, d, 0)
            else:
                self.ir(IR_AIDX, av, iv, 0, d, w)
            return d
        if k = NK_LEN:
            let av : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            if self.tof(na) = TY_STR:
                self.ir(IR_SLENV, av, 0, 0, d, w)
            elif ty_is_hash(self.tof(na)):
                self.ir(IR_HLEN, av, 0, 0, d, w)
            elif ty_is_tup(self.tof(na)):
                self.ir(IR_CONST, self.tup_len(self.tof(na)), 0, 0, d, w)
            else:
                self.ir(IR_ALEN, av, 0, 0, d, w)
            return d
        if k = NK_CALL:
            return self.lower_call(nid, tok, na)
        if k = NK_CALLV:
            let bx9 : i64 = self.lower_expr(na)
            let cargc : i64 = self.a.extra[nb × 1¤ptrdiff]
            if self.a.nc[nid × 1¤ptrdiff] = 5:
                return bx9
            let cav : mut i64[] = []
            let cj : mut i64 = 0
            while cj < cargc:
                cav.push(self.lower_expr(self.a.extra[(nb + 1 + cj) × 1¤ptrdiff]))
                cj ← cj + 1
            if self.a.nc[nid × 1¤ptrdiff] = 1:
                let coff : i64 = @dropunit(#self.extra)
                self.extra.push(cargc + 1)
                foreach v := cav:
                    self.extra.push(v)
                self.extra.push(bx9)
                let cad : i64 = self.tmp()
                self.ir(IR_FLD, bx9, 0, 0, cad, 0)
                let cd : i64 = self.tmp()
                self.ir(IR_CALLI, cad, coff, 0, cd, 0)
                return cd
            // a partial of the value: bind now, keep the source box
            let dp : i64 = self.tmp()
            self.ir(IR_SNEW, 1 + cargc + 1, 0, 0, dp, 0)
            let ap : i64 = self.tmp()
            self.ir(IR_FADDR, self.shimbase + self.nslot[nid × 1¤ptrdiff], 0, 0, ap, 0)
            self.ir(IR_FSTO, dp, 0, ap, 0, 0)
            let ck : mut i64 = 0
            while ck < cargc:
                self.ir(IR_FSTO, dp, 1 + ck, cav[ck × 1¤ptrdiff], 0, 0)
                ck ← ck + 1
            self.ir(IR_FSTO, dp, 1 + cargc, bx9, 0, 0)
            return dp
        if k = NK_SCALL:
            if na = SB_ARGS:
                let d : i64 = self.tmp()
                if self.argsfix >= 0:
                    let coff : i64 = @dropunit(#self.extra)
                    self.extra.push(0)
                    self.ir(IR_CALL, self.argsfix, coff, 0, d, 0)
                else:
                    self.ir(IR_ARGS, 0, 0, 0, d, 0)
                return d
            if na = SB_OPEN:
                let pv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(IR_FOPEN, pv, 0, 0, d, 0)
                return d
            if na = SB_CREATE:
                let pv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let mv : i64 = self.lower_expr(self.a.extra[(nb + 2) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(IR_FCREATE, pv, mv, 0, d, 0)
                return d
            if na = SB_CWD:
                let d : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, d, 0)
                return d
            if na = SB_BYTES:
                let sv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(IR_SBYTES, sv, 0, 0, d, 0)
                return d
            if na = SB_IOV:
                return self.lower_iov(self.a.extra[(nb + 1) × 1¤ptrdiff])
            if na = SB_ALLOCATOR:
                let d : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, d, 0)
                return d
            if na = SB_PROC:
                if nb = PROC_EXECFN:
                    let d : i64 = self.tmp()
                    self.ir(IR_EXECFN, 0, 0, 0, d, 0)
                    return d
                let v : i64 = self.tmp()
                self.ir(IR_AUXV, proc_key(nb), 0, 0, v, 0)
                if nb ≠ PROC_SECURE:
                    return v
                // secure is what the kernel set, said as a truth value
                let z : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, z, 0)
                let b : i64 = self.tmp()
                self.ir(IR_CNE, v, z, 0, b, 64)
                return b
            if na = SB_ENVN:
                let d : i64 = self.tmp()
                self.ir(IR_ENVN, 0, 0, 0, d, 0)
                return d
            if na = SB_ENVG or na = SB_ENVH:
                let nv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(IR_ENVG, nv, 0, 0, d, 0)
                if na = SB_ENVG:
                    return d
                // has: the box is there, or it is not
                let z : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, z, 0)
                let b : i64 = self.tmp()
                self.ir(IR_CNE, d, z, 0, b, 64)
                return b
            self.lower_scall(nid, tok, na, nb)
            return ⁻1
        if k = NK_MCALL:
            return self.lower_mcall(nid, ⁻1)
        if k = NK_REF:
            return self.lower_expr(na)
        if k = NK_NEG:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_NEGW if self.in_wrap > 0 else IR_NEG, v, 0, 0, d, w)
            return d
        if k = NK_BNOT:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            let t9 : i64 = ty_strip_ref(self.tof(nid))
            if ty_is_enum(t9):
                // the complement stays within the set's own bits
                let ei : i64 = ty_eidx(t9)
                let st : i64 = self.a.estart[ei × 1¤ptrdiff]
                let nm : i64 = self.a.ecount[ei × 1¤ptrdiff]
                let msk : mut i64 = 0
                let mi : mut i64 = 0
                while mi < nm:
                    msk ← msk | self.a.evalues[(st + mi) × 1¤ptrdiff]
                    mi ← mi + 1
                let flipped : i64 = self.tmp()
                self.ir(IR_BNOTT, v, 0, 0, flipped, 64)
                let mv : i64 = self.tmp()
                self.ir(IR_CONST, msk, 0, 0, mv, 0)
                self.ir(IR_BAND, flipped, mv, 0, d, 64)
                return d
            self.ir(IR_BNOTT, v, 0, 0, d, w)
            return d
        if k = NK_NOT:
            // the operand is a bool, 0 or 1; flipping it is one xor
            let v : i64 = self.lower_expr(na)
            let one : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one, 64)
            let d : i64 = self.tmp()
            self.ir(IR_BXORR, v, one, 0, d, 64)
            return d
        if k = NK_WRAP:
            self.in_wrap ← self.in_wrap + 1
            let v : i64 = self.lower_expr(na)
            self.in_wrap ← self.in_wrap - 1
            return v
        if k = NK_COND:
            return self.lower_cond(nid, na, nb, nc, w)
        if k = NK_DEFAULT:
            return self.lower_default(nid, na, nb)
        if k = NK_AND or k = NK_OR:
            return self.lower_andor(nid, k, na, nb)
        if k = NK_ELEMOF:
            let kv2 : i64 = self.lower_expr(na)
            let hv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_HELEM, hv, kv2, 0, d, 0)
            return d
        if k = NK_CCAT:
            if ty_is_arr(self.tof(nid)):
                let aav : i64 = self.lower_expr(na)
                let abv : i64 = self.lower_expr(nb)
                let ad : i64 = self.tmp()
                self.ir(IR_ACAT, aav, abv, 0, ad, 0)
                return ad
            let av0 : i64 = self.lower_expr(na)
            let av : mut i64 = av0
            if self.tof(na) = TY_CHAR:
                let ta : i64 = self.tmp()
                self.ir(IR_CHARSTR, av0, 0, 0, ta, 0)
                av ← ta
            let bv0 : i64 = self.lower_expr(nb)
            let bv : mut i64 = bv0
            if self.tof(nb) = TY_CHAR:
                let tb : i64 = self.tmp()
                self.ir(IR_CHARSTR, bv0, 0, 0, tb, 0)
                bv ← tb
            let d : i64 = self.tmp()
            self.ir(IR_SCCAT, av, bv, 0, d, w)
            return d
        if k = NK_EQ or k = NK_NE:
            if ty_is_opt(self.tof(na)) and ty_is_opt(self.tof(nb)):
                let d0 : i64 = self.lower_opt_eq(na, nb)
                if k = NK_NE:
                    let zz : i64 = self.tmp()
                    self.ir(IR_CONST, 0, 0, 0, zz, 64)
                    let d1 : i64 = self.tmp()
                    self.ir(IR_CEQ, d0, zz, 0, d1, 64)
                    return d1
                return d0
            if self.tof(na) = TY_STR:
                let av : i64 = self.lower_expr(na)
                let bv : i64 = self.lower_expr(nb)
                let d : i64 = self.tmp()
                self.ir(IR_SEQV, av, bv, 0, d, 64)
                if k = NK_NE:
                    let z : i64 = self.tmp()
                    self.ir(IR_CONST, 0, 0, 0, z, 64)
                    let d2 : i64 = self.tmp()
                    self.ir(IR_CEQ, d, z, 0, d2, 64)
                    return d2
                return d
        // the remaining family evaluates both sides
        let av : i64 = self.lower_expr(na)
        let bv : i64 = self.lower_expr(nb)
        let d : i64 = self.tmp()
        let owa : i64 = width_of(self.tof(na))
        let owb : i64 = width_of(self.tof(nb))
        // mixed sides compare at the wider width; where signedness
        // mixes the checker admitted only unsigned-narrower-than-
        // signed, and the signed side's width carries the compare
        let ow : mut i64 = owa
        if (owa » 8) ≠ (owb » 8):
            ow ← owa if (owa » 8) = 1 else owb
        elif (owb & 255) > (owa & 255):
            ow ← owb
        if k = NK_ADD:
            self.ir(IR_ADDW if self.in_wrap > 0 else IR_ADD, av, bv, 0, d, w)
        elif k = NK_SUB:
            self.ir(IR_SUBW if self.in_wrap > 0 else IR_SUB, av, bv, 0, d, w)
        elif k = NK_MUL:
            self.ir(IR_MULW if self.in_wrap > 0 else IR_MUL, av, bv, 0, d, w)
        elif k = NK_SHL:
            self.ir(IR_SHLL, av, bv, 0, d, w)
        elif k = NK_SHR:
            self.ir(IR_SHRR, av, bv, 0, d, w)
        elif k = NK_BAND:
            self.ir(IR_BAND, av, bv, 0, d, w)
        elif k = NK_BOR:
            self.ir(IR_BORR, av, bv, 0, d, w)
        elif k = NK_BXOR:
            self.ir(IR_BXORR, av, bv, 0, d, w)
        elif k = NK_EQ:
            self.ir(IR_CEQ, av, bv, 0, d, ow)
        elif k = NK_NE:
            self.ir(IR_CNE, av, bv, 0, d, ow)
        elif k = NK_LT:
            self.ir(IR_CLT, av, bv, 0, d, ow)
        elif k = NK_LE:
            self.ir(IR_CLE, av, bv, 0, d, ow)
        elif k = NK_GT:
            self.ir(IR_CGT, av, bv, 0, d, ow)
        elif k = NK_GE:
            self.ir(IR_CGE, av, bv, 0, d, ow)
        elif k = NK_LAND or k = NK_LOR:
            // both sides are bools already; one and or or does it
            self.ir(IR_BAND if k = NK_LAND else IR_BORR, av, bv, 0, d, 64)
        elif k = NK_LXOR:
            self.ir(IR_CNE, av, bv, 0, d, 64)
        elif k = NK_LNAND or k = NK_LNOR:
            let tt : i64 = self.tmp()
            self.ir(IR_BAND if k = NK_LNAND else IR_BORR, av, bv, 0, tt, 64)
            let c1 : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, c1, 64)
            self.ir(IR_BXORR, tt, c1, 0, d, 64)
        elif k = NK_IOTA:
            let sf : i64 = 1 if self.elem_of(self.tof(na)) = TY_STR else 0
            self.ir(IR_AFIND, av, bv, sf, d, 0)
        elif k = NK_SATADD:
            self.ir(IR_SATADD, av, bv, 0, d, w)
        elif k = NK_SATSUB:
            self.ir(IR_SATSUB, av, bv, 0, d, w)
        elif k = NK_SATMUL:
            self.ir(IR_SATMUL, av, bv, 0, d, w)
        elif k = NK_MAXOP:
            self.ir(IR_MAXX, av, bv, 0, d, w)
        elif k = NK_MINOP:
            self.ir(IR_MINN, av, bv, 0, d, w)
        return d

    fn lower_cond(&mut self, nid : i64, na : i64, nb : i64, nc : i64, w : i64) → i64:
        // a select when both sides may be read; branches otherwise
        self.decide(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]),
                    "select" if self.speculatable(na) and self.speculatable(nc) else "branched-conditional", "")
        if self.speculatable(na) and self.speculatable(nc):
            let cv : i64 = self.lower_expr(nb)
            let tv : i64 = self.lower_expr(na)
            let ev : i64 = self.lower_expr(nc)
            let d : i64 = self.tmp()
            self.ir(IR_SEL, cv, tv, ev, d, w)
            return d
        let d : i64 = self.tmp()
        let lelse : i64 = self.label()
        let lend : i64 = self.label()
        let cv : i64 = self.lower_expr(nb)
        self.ir(IR_JZ, cv, lelse, 0, 0, 0)
        let tv : i64 = self.lower_expr(na)
        self.ir(IR_MOV, tv, 0, 0, d, 0)
        self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
        let ev : i64 = self.lower_expr(nc)
        self.ir(IR_MOV, ev, 0, 0, d, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    fn lower_andor(&mut self, nid : i64, k : i64, na : i64, nb : i64) → i64:
        // a pure, fault-free right side may be read eagerly, and the
        // whole answer becomes three straight-line instructions
        self.decide(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]),
                    "eager-logic" if self.speculatable(nb) else "short-circuit", "")
        if self.speculatable(nb):
            let av : i64 = self.lower_expr(na)
            let bv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_BAND if k = NK_AND else IR_BORR, av, bv, 0, d, 64)
            return d
        let d : i64 = self.tmp()
        let lend : i64 = self.label()
        let av : i64 = self.lower_expr(na)
        self.ir(IR_CONST, 0 if k = NK_AND else 1, 0, 0, d, 64)
        self.ir(IR_JZ if k = NK_AND else IR_JNZ, av, lend, 0, 0, 0)
        let bv : i64 = self.lower_expr(nb)
        self.ir(IR_MOV, bv, 0, 0, d, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    // two optionals: the shape first -- both absent is true, one
    // absent is false -- and the contents only when both are there
    fn lower_opt_eq(&mut self, na : i64, nb : i64) → i64:
        let ob : i64 = ty_opt_base(self.tof(na))
        let av : i64 = self.lower_expr(na)
        let bv : i64 = self.lower_expr(nb)
        let d : i64 = self.tmp()
        let ltrue : i64 = self.label()
        let lfalse : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        let z : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, z, 64)
        let pa : i64 = self.tmp()
        self.ir(IR_CNE, av, z, 0, pa, 64)
        let pb : i64 = self.tmp()
        self.ir(IR_CNE, bv, z, 0, pb, 64)
        let same : i64 = self.tmp()
        self.ir(IR_CEQ, pa, pb, 0, same, 64)
        self.ir(IR_JZ, same, lfalse, 0, 0, 0)
        self.ir(IR_JZ, pa, ltrue, 0, 0, 0)
        self.ir(IR_JMP, lcont, 0, 0, 0, 0)
        self.ir(IR_LABEL, lcont, 0, 0, 0, 0)
        let la : i64 = self.tmp()
        self.ir(IR_FLD, av, 0, 0, la, 0)
        let lb : i64 = self.tmp()
        self.ir(IR_FLD, bv, 0, 0, lb, 0)
        if ob = TY_STR:
            self.ir(IR_SEQV, la, lb, 0, d, 64)
        else:
            self.ir(IR_CEQ, la, lb, 0, d, width_of(ob))
        self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, ltrue, 0, 0, 0, 0)
        self.ir(IR_CONST, 1, 0, 0, d, 64)
        self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, lfalse, 0, 0, 0, 0)
        self.ir(IR_CONST, 0, 0, 0, d, 64)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    fn lower_default(&mut self, nid : i64, na : i64, nb : i64) → i64:
        let ik : i64 = self.kof(na)
        if ik = NK_DIV or ik = NK_MOD:
            let av : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
            let bv : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
            let dv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_DIVV if ik = NK_DIV else IR_MODD, av, bv, dv, d,
                    width_of(self.tof(na)))
            return d
        if ik = NK_MCALL and self.a.nc[na × 1¤ptrdiff] < 1000:
            return self.lower_mcall(na, nb)
        // any optional: absent takes the default, present unwraps
        let v : i64 = self.lower_expr(na)
        let d : i64 = self.tmp()
        let ldef : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_JZ, v, ldef, 0, 0, 0)
        self.ir(IR_FLD, v, 0, 0, d, 0)
        self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, ldef, 0, 0, 0, 0)
        let dv : i64 = self.lower_expr(nb)
        self.ir(IR_MOV, dv, 0, 0, d, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    fn lower_mcall(&mut self, nid : i64, defnode : i64) → i64:
        let mid : i64 = self.a.nc[nid × 1¤ptrdiff]
        let base : i64 = self.a.na[nid × 1¤ptrdiff]
        let args_off : i64 = self.a.nb[nid × 1¤ptrdiff]
        if mid >= 1000:
            // a struct's method is a function with the receiver first
            let f : i64 = ((mid - 1000) ÷ 2) ?? 0
            let inst : i64 = (mid - 1000) & 1
            let vregs : mut i64[] = []
            if inst = 1:
                vregs.push(self.lower_expr(base))
            let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
            let i : mut i64 = 0
            while i < argc:
                vregs.push(self.lower_expr(self.a.extra[(args_off + 1 + i) × 1¤ptrdiff]))
                i ← i + 1
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(@dropunit(#vregs))
            foreach v := vregs:
                self.extra.push(v)
            let d : i64 = self.tmp()
            self.ir(IR_CALL, f, off, 0, d, 0)
            return d
        let av : i64 = self.lower_expr(base)
        let w : i64 = width_of(self.tof(nid))
        if mid = MID_CHR:
            let d : i64 = self.tmp()
            self.ir(IR_CHR, av, 0, 0, d, w)
            return d
        if mid = MID_ORD:
            let d : i64 = self.tmp()
            self.ir(IR_MOV, av, 0, 0, d, w)
            return d
        if mid = MID_CHARS:
            let d : i64 = self.tmp()
            self.ir(IR_CHARS, av, 0, 0, d, 0)
            return d
        if mid = MID_READF:
            _ ← self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            let d : i64 = self.tmp()
            self.ir(IR_FREAD, av, 0, 0, d, 0)
            return d
        if mid = MID_WRITEF:
            let bv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_FWRITE, av, bv, 0, 0, 0)
            return ⁻1
        if mid = MID_CLOSEF:
            self.ir(IR_FCLOSE, av, 0, 0, 0, 0)
            return ⁻1
        if mid = MID_WRITEV:
            let pv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_WRITEV, av, pv, 0, 0, 0)
            return ⁻1
        if mid = MID_DIRITER:
            let earr : i64 = self.tmp()
            self.ir(IR_DENTS, 0, 0, 0, earr, 0)
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, 2, 0, 0, d, 0)
            self.ir(IR_FSTO, d, 0, earr, 0, 0)
            let z8 : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, z8, 0)
            self.ir(IR_FSTO, d, 1, z8, 0, 0)
            return d
        if mid = MID_ITER:
            // {the array, the position}: a fresh two-slot box
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, 2, 0, 0, d, 0)
            self.ir(IR_FSTO, d, 0, av, 0, 0)
            let z9 : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, z9, 0)
            self.ir(IR_FSTO, d, 1, z9, 0, 0)
            return d
        if mid = MID_NEXT and defnode = ⁻1 and ty_is_opt(self.tof(nid)):
            // outside ?? and the while binding: the step is boxed as
            // any optional is, the end the null
            let dscb : i64 = self.tmp()
            self.ir(IR_FLD, av, 0, 0, dscb, 0)
            let posb : i64 = self.tmp()
            self.ir(IR_FLD, av, 1, 0, posb, 0)
            let nb9 : i64 = self.tmp()
            self.ir(IR_ALEN, dscb, 0, 0, nb9, 0)
            let cb9 : i64 = self.tmp()
            self.ir(IR_CLT, posb, nb9, 0, cb9, 64 + 256)
            let d : i64 = self.tmp()
            let labs : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, cb9, labs, 0, 0, 0)
            let ev9 : i64 = self.tmp()
            self.ir(IR_AIDX, dscb, posb, 0, ev9, 0)
            let ob9 : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, ob9, 0)
            self.ir(IR_FSTO, ob9, 0, ev9, 0, 0)
            let one8 : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one8, 0)
            let np8 : i64 = self.tmp()
            self.ir(IR_ADDW, posb, one8, 0, np8, 64 + 256)
            self.ir(IR_FSTO, av, 1, np8, 0, 0)
            self.ir(IR_MOV, ob9, 0, 0, d, 0)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, labs, 0, 0, 0, 0)
            self.ir(IR_CONST, 0, 0, 0, d, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
            return d
        if mid = MID_NEXT:
            // position under length answers the element and steps; the
            // end answers the default, as pop does under ??
            let dsc : i64 = self.tmp()
            self.ir(IR_FLD, av, 0, 0, dsc, 0)
            let pos : i64 = self.tmp()
            self.ir(IR_FLD, av, 1, 0, pos, 0)
            let n9 : i64 = self.tmp()
            self.ir(IR_ALEN, dsc, 0, 0, n9, 0)
            let c9 : i64 = self.tmp()
            self.ir(IR_CLT, pos, n9, 0, c9, 64 + 256)
            let d : i64 = self.tmp()
            let ldef : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, c9, ldef, 0, 0, 0)
            self.ir(IR_AIDX, dsc, pos, 0, d, 0)
            let one9 : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one9, 0)
            let np9 : i64 = self.tmp()
            self.ir(IR_ADDW, pos, one9, 0, np9, 64 + 256)
            self.ir(IR_FSTO, av, 1, np9, 0, 0)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, ldef, 0, 0, 0, 0)
            let dv9 : i64 = self.lower_expr(defnode)
            self.ir(IR_MOV, dv9, 0, 0, d, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
            return d
        if mid = MID_PUSH:
            let vv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_APUSH, av, vv, 0, 0, 0)
            return ⁻1
        if mid = MID_POP and defnode = ⁻1 and ty_is_opt(self.tof(nid)):
            // outside ??: an empty array answers the null, and a value
            // answers boxed, as ∃ boxes
            let n9 : i64 = self.tmp()
            self.ir(IR_ALEN, av, 0, 0, n9, 0)
            let d9 : i64 = self.tmp()
            let lno : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, n9, lno, 0, 0, 0)
            let z9 : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, z9, 0)
            let e9 : i64 = self.tmp()
            self.ir(IR_APOP, av, z9, 0, e9, width_of(ty_opt_base(self.tof(nid))))
            let b9 : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, b9, 0)
            self.ir(IR_FSTO, b9, 0, e9, 0, 0)
            self.ir(IR_MOV, b9, 0, 0, d9, 0)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, lno, 0, 0, 0, 0)
            self.ir(IR_CONST, 0, 0, 0, d9, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
            return d9
        if mid = MID_POP:
            let dv : mut i64 = 0
            if defnode = ⁻1:
                dv ← self.tmp()
                self.ir(IR_CONST, 0, 0, 0, dv, 0)
            else:
                dv ← self.lower_expr(defnode)
            let d : i64 = self.tmp()
            self.ir(IR_APOP, av, dv, 0, d, w)
            return d
        if defnode = ⁻1 and ty_is_opt(self.tof(nid)):
            // get, outside ??: past the end answers the null
            let iv9 : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            let n8 : i64 = self.tmp()
            self.ir(IR_ALEN, av, 0, 0, n8, 0)
            let c8 : i64 = self.tmp()
            self.ir(IR_CLT, iv9, n8, 0, c8, 64 + 256)
            let d8 : i64 = self.tmp()
            let lno8 : i64 = self.label()
            let lend8 : i64 = self.label()
            self.ir(IR_JZ, c8, lno8, 0, 0, 0)
            let e8 : i64 = self.tmp()
            self.ir(IR_AIDX, av, iv9, 0, e8, 0)
            let b8 : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, b8, 0)
            self.ir(IR_FSTO, b8, 0, e8, 0, 0)
            self.ir(IR_MOV, b8, 0, 0, d8, 0)
            self.ir(IR_JMP, lend8, 0, 0, 0, 0)
            self.ir(IR_LABEL, lno8, 0, 0, 0, 0)
            self.ir(IR_CONST, 0, 0, 0, d8, 0)
            self.ir(IR_LABEL, lend8, 0, 0, 0, 0)
            return d8
        // get
        let iv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
        let dv : i64 = self.lower_expr(defnode)
        let d : i64 = self.tmp()
        self.ir(IR_AGET, av, iv, dv, d, w)
        d

    // a range written out as the array of its steps, for the places
    // that cycle an array: the walk is the foreach's own
    fn lower_rg_arr(&mut self, nb : i64) → i64:
        let rv : i64 = self.lower_expr(nb)
        let lo9 : i64 = self.tmp()
        self.ir(IR_FLD, rv, 0, 0, lo9, 0)
        let st9 : i64 = self.tmp()
        self.ir(IR_FLD, rv, 1, 0, st9, 0)
        let hi9 : i64 = self.tmp()
        self.ir(IR_FLD, rv, 2, 0, hi9, 0)
        let lz9 : i64 = self.label()
        self.ir(IR_JNZ, st9, lz9, 0, 0, 0)
        let m9 : i64 = self.intern("range step must not be zero\n")
        self.ir(IR_ABORT, m9, 0, 0, 0, 0)
        self.ir(IR_LABEL, lz9, 0, 0, 0, 0)
        let d : i64 = self.tmp()
        self.ir(IR_ANEW, 4, 0, 0, d, 0)
        let iv : i64 = self.tmp()
        self.ir(IR_MOV, lo9, 0, 0, iv, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let c : i64 = self.range_alive(iv, hi9, st9)
        self.ir(IR_JZ, c, lend, 0, 0, 0)
        self.ir(IR_APUSH, d, iv, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(IR_ADDW, iv, st9, 0, ni, 64 + 256)
        self.ir(IR_MOV, ni, 0, 0, iv, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    // m[rows, cols] and m[rows, i]: the rows are walked and each is cut
    // to what was asked for.  A row the matrix holds cannot be handed
    // back narrowed, so every row of the answer is built, and the answer
    // shares nothing with what it was cut from.
    fn lower_mslice(&mut self, nid : i64, na : i64, off : i64, iscol : i64) → i64:
        let mv : i64 = self.lower_expr(na)
        let rlo : i64 = self.lower_expr(self.a.extra[off × 1¤ptrdiff])
        let rhi : i64 = self.lower_expr(self.a.extra[(off + 1) × 1¤ptrdiff])
        let clo : i64 = self.lower_expr(self.a.extra[(off + 2) × 1¤ptrdiff])
        let chin : i64 = self.a.extra[(off + 3) × 1¤ptrdiff]
        let chi : mut i64 = 0
        if chin ≠ ⁻1:
            chi ← self.lower_expr(chin)
        let out : i64 = self.tmp()
        self.ir(IR_ANEW, 4, 0, 0, out, 0)
        let r : i64 = self.tmp()
        self.ir(IR_MOV, rlo, 0, 0, r, 0)
        let one : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let cnd : i64 = self.tmp()
        self.ir(IR_CLE, r, rhi, 0, cnd, 64 + 256)
        self.ir(IR_JZ, cnd, lend, 0, 0, 0)
        let row : i64 = self.tmp()
        self.ir(IR_AIDX, mv, r, 0, row, 0)
        let piece : i64 = self.tmp()
        if iscol = 1:
            self.ir(IR_AIDX, row, clo, 0, piece, 0)
        else:
            self.ir(IR_ASLICE, row, clo, chi, piece, 0)
        self.ir(IR_APUSH, out, piece, 0, 0, 0)
        let nr : i64 = self.tmp()
        self.ir(IR_ADDW, r, one, 0, nr, 64 + 256)
        self.ir(IR_MOV, nr, 0, 0, r, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        out

    fn lower_mreshape(&mut self, nid : i64, na : i64, nb : i64) → i64:
        // the flat filler cycles across the row seam, then is cut into
        // rows, each row its own fresh array
        let toff : i64 = self.a.na[na × 1¤ptrdiff]
        let rank : i64 = self.a.extra[toff × 1¤ptrdiff]
        let r : i64 = self.a.na[self.a.extra[(toff + 1) × 1¤ptrdiff] × 1¤ptrdiff]
        let c : i64 = self.a.na[self.a.extra[(toff + 2) × 1¤ptrdiff] × 1¤ptrdiff]
        // a cube is planes of rows: the last two extents make the plane,
        // and the first counts them
        let d3 : i64 = 1 if rank = 2 else self.a.na[self.a.extra[(toff + 3) × 1¤ptrdiff] × 1¤ptrdiff]
        let nall : i64 = self.tmp()
        self.ir(IR_CONST, r × c × d3, 0, 0, nall, 0)
        let flat : i64 = self.tmp()
        if ty_is_rg(self.tof(nb)):
            let fvr : i64 = self.lower_rg_arr(nb)
            self.ir(IR_ACYC, nall, fvr, 0, flat, 0)
        elif ty_is_arr(self.tof(nb)):
            let fv : i64 = self.lower_expr(nb)
            self.ir(IR_ACYC, nall, fv, 0, flat, 0)
        else:
            let fv : i64 = self.lower_expr(nb)
            self.ir(IR_AFILL, nall, fv, 0, flat, 0)
        // the outermost dimension counts what the level below builds:
        // rows for a matrix, planes for a cube.  Either way the cutting
        // is the same loop, so a cube runs it twice, once nested.
        let d : i64 = self.cut_up(flat, r, c × d3)
        if rank = 2:
            return d
        let cube : i64 = self.tmp()
        self.ir(IR_ANEW, r ⌈ 4, 0, 0, cube, 0)
        let pi : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, pi, 0)
        let pn : i64 = self.tmp()
        self.ir(IR_CONST, r, 0, 0, pn, 0)
        let pone : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, pone, 0)
        let ptop : i64 = self.label()
        let pend : i64 = self.label()
        self.ir(IR_LABEL, ptop, 0, 0, 0, 0)
        let pc : i64 = self.tmp()
        self.ir(IR_CLT, pi, pn, 0, pc, 64 + 256)
        self.ir(IR_JZ, pc, pend, 0, 0, 0)
        let plane : i64 = self.tmp()
        self.ir(IR_AIDX, d, pi, 0, plane, 0)
        let pm : i64 = self.cut_up(plane, c, d3)
        self.ir(IR_APUSH, cube, pm, 0, 0, 0)
        let pnx : i64 = self.tmp()
        self.ir(IR_ADDW, pi, pone, 0, pnx, 64 + 256)
        self.ir(IR_MOV, pnx, 0, 0, pi, 0)
        self.ir(IR_JMP, ptop, 0, 0, 0, 0)
        self.ir(IR_LABEL, pend, 0, 0, 0, 0)
        cube

    // n slices of width w, cut off the front of flat and pushed into a
    // fresh array; the slices share with what they were cut from
    fn cut_up(&mut self, flat : i64, n : i64, w : i64) → i64:
        let d : i64 = self.tmp()
        self.ir(IR_ANEW, n ⌈ 4, 0, 0, d, 0)
        let i : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, i, 0)
        let rv : i64 = self.tmp()
        self.ir(IR_CONST, n, 0, 0, rv, 0)
        let cv : i64 = self.tmp()
        self.ir(IR_CONST, w, 0, 0, cv, 0)
        let one : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let cnd : i64 = self.tmp()
        self.ir(IR_CLT, i, rv, 0, cnd, 64 + 256)
        self.ir(IR_JZ, cnd, lend, 0, 0, 0)
        let lo : i64 = self.tmp()
        self.ir(IR_MULW, i, cv, 0, lo, 64 + 256)
        let hi : i64 = self.tmp()
        self.ir(IR_ADDW, lo, cv, 0, hi, 64 + 256)
        let hi1 : i64 = self.tmp()
        self.ir(IR_SUBW, hi, one, 0, hi1, 64 + 256)
        let row : i64 = self.tmp()
        self.ir(IR_ASLICE, flat, lo, hi1, row, 0)
        self.ir(IR_APUSH, d, row, 0, 0, 0)
        let nxt : i64 = self.tmp()
        self.ir(IR_ADDW, i, one, 0, nxt, 64 + 256)
        self.ir(IR_MOV, nxt, 0, 0, i, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    // std.iov(x): the run of bytes x amounts to, made here and held as
    // a base and a length.  A byte array is already its own bytes; a
    // struct with a layout is written out one field at a time, at the
    // offsets the layout gives, with what the layout skips written as
    // zeros so the same program twice produces the same file.
    fn lower_iov(&mut self, pe : i64) → i64:
        let pt : i64 = ty_strip_ref(self.tof(pe))
        let pv : i64 = self.lower_expr(pe)
        let bytes : mut i64 = pv
        if pt ≠ mk_aty(TY_U8):
            bytes ← self.pack_piece(pt, pv)
        let raw : i64 = self.tmp()
        self.ir(IR_TORAW, bytes, 0, 0, raw, 0)
        let n : i64 = self.tmp()
        self.ir(IR_ALEN, bytes, 0, 0, n, 0)
        // the two slots the kernel wants, in the order it wants them,
        // so a run needs no rearranging when it is handed over
        let d : i64 = self.tmp()
        self.ir(IR_SNEW, 2, 0, 0, d, 0)
        self.ir(IR_FSTO, d, 0, raw, 0, 0)
        self.ir(IR_FSTO, d, 1, n, 0, 0)
        d

    // the bytes of one piece that is not already bytes: a struct, or a
    // table of them walked one entry at a time
    fn pack_piece(&mut self, pt : i64, pv : i64) → i64:
        let buf : i64 = self.tmp()
        self.ir(IR_ANEW, 4, 0, 0, buf, 0)
        if not ty_is_arr(pt):
            _ ← self.pack_val(buf, pt, pv, 0)
            return buf
        // a table: the same static sequence inside a loop, since how
        // many entries there are is not known until it runs
        let et : i64 = self.elem_of(pt)
        let n : i64 = self.tmp()
        self.ir(IR_ALEN, pv, 0, 0, n, 0)
        let ix : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, ix, 0)
        let one : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let c : i64 = self.tmp()
        self.ir(IR_CLT, ix, n, 0, c, 64 + 256)
        self.ir(IR_JZ, c, lend, 0, 0, 0)
        let e : i64 = self.tmp()
        self.ir(IR_AIDX, pv, ix, 0, e, 0)
        _ ← self.pack_val(buf, et, e, 0)
        let nx : i64 = self.tmp()
        self.ir(IR_ADDW, ix, one, 0, nx, 64 + 256)
        self.ir(IR_MOV, nx, 0, 0, ix, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        buf

    // push one byte, whose value the caller has already reduced
    fn pack_byte(&mut self, buf : i64, v : i64):
        self.ir(IR_APUSH, buf, v, 0, 0, 0)

    // zeros up to the offset the layout wants next
    fn pack_pad(&mut self, buf : i64, from : i64, to : i64):
        if to > from:
            let z : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, z, 0)
            foreach _ := from…to - 1:
                self.pack_byte(buf, z)

    // one value of type ty appended to buf; answers how far along the
    // piece the writing has got, so the caller can pad to the next
    // field without counting the bytes again
    fn pack_val(&mut self, buf : i64, ty0 : i64, v : i64, pos0 : i64) → i64:
        let ty : i64 = ty_drop_unit(ty_strip_ref(ty0))
        let pos : mut i64 = pos0
        if ty_is_struct(ty):
            let si : i64 = ty_sidx(ty)
            let d := self.a.structs[si × 1¤ptrdiff]
            let nf : i64 = self.a.extra[d.fields_off × 1¤ptrdiff]
            let (ssz, sal) := c_struct_layout(self.a, si, 0)
            _ ← sal
            if nf > 0:
                foreach fi := 0…nf - 1:
                    let fty : i64 = self.a.extra[(d.fields_off + 2 + fi × 2) × 1¤ptrdiff]
                    self.pack_pad(buf, pos, pos0 + c_field_offset(self.a, si, @dropunit(fi)))
                    pos ← pos0 + c_field_offset(self.a, si, @dropunit(fi))
                    let fv : i64 = self.tmp()
                    self.ir(IR_FLD, v, fi, 0, fv, 0)
                    pos ← self.pack_val(buf, fty, fv, pos)
            // the tail padding is part of the struct, so an array of
            // it keeps every element where the layout says
            self.pack_pad(buf, pos, pos0 + ssz)
            return pos0 + ssz
        if ty_is_farr(ty):
            // a sized array is its elements one after the other, and
            // how many there are is part of the type
            let et : i64 = self.a.fae[ty_fidx(ty) × 1¤ptrdiff]
            let cnt : i64 = self.a.fas[ty_fidx(ty) × 1¤ptrdiff]
            if cnt > 0:
                foreach ei := 0…cnt - 1:
                    let ix : i64 = self.tmp()
                    self.ir(IR_CONST, @dropunit(ei), 0, 0, ix, 0)
                    let ev : i64 = self.tmp()
                    self.ir(IR_AIDX, v, ix, 0, ev, 0)
                    pos ← self.pack_val(buf, et, ev, pos)
            return pos
        // a scalar: its own width, least significant byte first, which
        // is the target's order
        let (sz, al) := c_layout(self.a, ty, 0)
        _ ← al
        let m : i64 = self.tmp()
        self.ir(IR_CONST, 255, 0, 0, m, 0)
        foreach bi := 0…sz - 1:
            let sh : i64 = self.tmp()
            self.ir(IR_CONST, 8 × @dropunit(bi), 0, 0, sh, 0)
            let shifted : i64 = self.tmp()
            self.ir(IR_SHRR, v, sh, 0, shifted, 64 + 256)
            let low : i64 = self.tmp()
            self.ir(IR_BAND, shifted, m, 0, low, 64 + 256)
            self.pack_byte(buf, low)
        pos + sz

    // generate(f, r): the range written out, then one call per step
    fn lower_generate(&mut self, nid : i64, args_off : i64) → i64:
        let fe : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        let re : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
        let fv : i64 = self.lower_expr(fe)
        let rga : i64 = self.lower_rg_arr(re)
        let out : i64 = self.tmp()
        self.ir(IR_ANEW, 4, 0, 0, out, 0)
        let n9 : i64 = self.tmp()
        self.ir(IR_ALEN, rga, 0, 0, n9, 0)
        let ix9 : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, ix9, 0)
        let one9 : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, one9, 0)
        let ad9 : i64 = self.tmp()
        self.ir(IR_FLD, fv, 0, 0, ad9, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let c9 : i64 = self.tmp()
        self.ir(IR_CLT, ix9, n9, 0, c9, 64 + 256)
        self.ir(IR_JZ, c9, lend, 0, 0, 0)
        let x9 : i64 = self.tmp()
        self.ir(IR_AIDX, rga, ix9, 0, x9, 0)
        let off9 : i64 = @dropunit(#self.extra)
        self.extra.push(2)
        self.extra.push(x9)
        self.extra.push(fv)
        let r9 : i64 = self.tmp()
        self.ir(IR_CALLI, ad9, off9, 0, r9, 0)
        self.ir(IR_APUSH, out, r9, 0, 0, 0)
        let ni9 : i64 = self.tmp()
        self.ir(IR_ADDW, ix9, one9, 0, ni9, 64 + 256)
        self.ir(IR_MOV, ni9, 0, 0, ix9, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        out

    fn lower_arrlit(&mut self, nid : i64, off : i64) → i64:
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let d : i64 = self.tmp()
        self.ir(IR_ANEW, n ⌈ 4, 0, 0, d, 0)
        let i : mut i64 = 0
        while i < n:
            let ev : i64 = self.lower_expr(self.a.extra[(off + 1 + i) × 1¤ptrdiff])
            self.ir(IR_APUSH, d, ev, 0, 0, 0)
            i ← i + 1
        d

    fn lower_call(&mut self, nid : i64, tok : i64, args_off : i64) → i64:
        let name := self.text(tok)
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if name = "static_assert" or name = "static_assert_eq":
            return ⁻1
        if name = "assert" or name = "assert_eq":
            self.lower_assert(nid, tok, args_off, name = "assert_eq")
            return ⁻1
        if self.a.nc[nid × 1¤ptrdiff] = 2:
            return self.lower_generate(nid, args_off)
        if self.a.nc[nid × 1¤ptrdiff] >= 6 and self.a.nc[nid × 1¤ptrdiff] <= 8:
            let gb9 : i64 = self.tmp()
            self.ir(IR_GLOAD, self.nslot[nid × 1¤ptrdiff], 0, 0, gb9, 0)
            if self.a.nc[nid × 1¤ptrdiff] = 7:
                return gb9
            if self.a.nc[nid × 1¤ptrdiff] = 6:
                let gv9 : mut i64[] = []
                let gi9 : mut i64 = 0
                while gi9 < argc:
                    gv9.push(self.lower_expr(self.a.extra[(args_off + 1 + gi9) × 1¤ptrdiff]))
                    gi9 ← gi9 + 1
                let go9 : i64 = @dropunit(#self.extra)
                self.extra.push(argc + 1)
                foreach v := gv9:
                    self.extra.push(v)
                self.extra.push(gb9)
                let ga9 : i64 = self.tmp()
                self.ir(IR_FLD, gb9, 0, 0, ga9, 0)
                let gd9 : i64 = self.tmp()
                self.ir(IR_CALLI, ga9, go9, 0, gd9, 0)
                return gd9
            let gv8 : mut i64[] = []
            let gi8 : mut i64 = 0
            while gi8 < argc:
                gv8.push(self.lower_expr(self.a.extra[(args_off + 1 + gi8) × 1¤ptrdiff]))
                gi8 ← gi8 + 1
            let gp8 : i64 = self.tmp()
            self.ir(IR_SNEW, 1 + argc + 1, 0, 0, gp8, 0)
            let gf8 : i64 = self.tmp()
            self.ir(IR_FADDR, self.shimbase + self.a.nb[nid × 1¤ptrdiff], 0, 0, gf8, 0)
            self.ir(IR_FSTO, gp8, 0, gf8, 0, 0)
            let gk8 : mut i64 = 0
            while gk8 < argc:
                self.ir(IR_FSTO, gp8, 1 + gk8, gv8[gk8 × 1¤ptrdiff], 0, 0)
                gk8 ← gk8 + 1
            self.ir(IR_FSTO, gp8, 1 + argc, gb9, 0, 0)
            return gp8
        if self.a.nc[nid × 1¤ptrdiff] = 5:
            // an empty application answers the box unchanged
            return self.nslot[nid × 1¤ptrdiff]
        if self.a.nc[nid × 1¤ptrdiff] = 3 or self.a.nc[nid × 1¤ptrdiff] = 4:
            // a partial: the shim's address, then the bound values,
            // then -- for a closure source -- the source box itself
            let isclo : i64 = 1 if self.a.nc[nid × 1¤ptrdiff] = 4 else 0
            let vb9 : mut i64[] = []
            let bi9 : mut i64 = 0
            while bi9 < argc:
                vb9.push(self.lower_expr(self.a.extra[(args_off + 1 + bi9) × 1¤ptrdiff]))
                bi9 ← bi9 + 1
            let d9p : i64 = self.tmp()
            self.ir(IR_SNEW, 1 + argc + isclo, 0, 0, d9p, 0)
            let av9p : i64 = self.tmp()
            self.ir(IR_FADDR, self.shimbase + self.a.nb[nid × 1¤ptrdiff], 0, 0, av9p, 0)
            self.ir(IR_FSTO, d9p, 0, av9p, 0, 0)
            let ci9p : mut i64 = 0
            while ci9p < argc:
                self.ir(IR_FSTO, d9p, 1 + ci9p, vb9[ci9p × 1¤ptrdiff], 0, 0)
                ci9p ← ci9p + 1
            if isclo = 1:
                self.ir(IR_FSTO, d9p, 1 + argc, self.nslot[nid × 1¤ptrdiff], 0, 0)
            return d9p
        if self.a.nc[nid × 1¤ptrdiff] = 1:
            // through the binding's box: the address in slot 0, the
            // box itself riding along as the hidden last argument
            let box9 : i64 = self.nslot[nid × 1¤ptrdiff]
            let vr9 : mut i64[] = []
            let ix9 : mut i64 = 0
            while ix9 < argc:
                vr9.push(self.lower_expr(self.a.extra[(args_off + 1 + ix9) × 1¤ptrdiff]))
                ix9 ← ix9 + 1
            let off9 : i64 = @dropunit(#self.extra)
            self.extra.push(argc + 1)
            foreach v := vr9:
                self.extra.push(v)
            self.extra.push(box9)
            let ad9 : i64 = self.tmp()
            self.ir(IR_FLD, box9, 0, 0, ad9, 0)
            let d9 : i64 = self.tmp()
            self.ir(IR_CALLI, ad9, off9, 0, d9, 0)
            return d9
        let vregs : mut i64[] = []
        let i : mut i64 = 0
        while i < argc:
            vregs.push(self.lower_expr(self.a.extra[(args_off + 1 + i) × 1¤ptrdiff]))
            i ← i + 1
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(argc)
        foreach v := vregs:
            self.extra.push(v)
        let f : i64 = self.fname_index(name)
        let d : i64 = self.tmp()
        self.ir(IR_CALL, f, off, 0, d, 0)
        d

    fn lower_assert(&mut self, nid : i64, tok : i64, args_off : i64, is_eq : bool):
        let line : i64 = self.tok_line(tok)
        let lok : i64 = self.label()
        if is_eq:
            let x : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
            let y : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
            let c : mut i64 = 0
            if ty_is_opt(self.tof(x)) and ty_is_opt(self.tof(y)):
                c ← self.lower_opt_eq(x, y)
            elif self.tof(x) = TY_STR:
                let av0 : i64 = self.lower_expr(x)
                let bv0 : i64 = self.lower_expr(y)
                c ← self.tmp()
                self.ir(IR_SEQV, av0, bv0, 0, c, 64)
            else:
                let av : i64 = self.lower_expr(x)
                let bv : i64 = self.lower_expr(y)
                c ← self.tmp()
                self.ir(IR_CEQ, av, bv, 0, c, width_of(self.tof(x)))
            self.ir(IR_JNZ, c, lok, 0, 0, 0)
            let m : i64 = self.intern("assertion does not hold (line " ⧺ i64_str(line) ⧺ ")\n")
            self.ir(IR_ABORT, m, 0, 0, 0, 0)
        else:
            let cv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_JNZ, cv, lok, 0, 0, 0)
            let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
            let msg : mut str = "assertion does not hold (line " ⧺ i64_str(line) ⧺ ")\n"
            if argc = 2:
                let marg : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                msg ← "assertion does not hold (line " ⧺ i64_str(line) ⧺ "): " ⧺ self.a.strs[self.a.na[marg × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\n"
            let m : i64 = self.intern(msg)
            self.ir(IR_ABORT, m, 0, 0, 0, 0)
        self.ir(IR_LABEL, lok, 0, 0, 0, 0)

    fn lower_scall(&mut self, nid : i64, tok : i64, sb : i64, args_off : i64):
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if sb = SB_EXIT:
            let v : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_EXIT, v, 0, 0, 0, 0)
            return
        let fmt : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        let cs := self.a.strs[self.a.na[fmt × 1¤ptrdiff] × 1¤ptrdiff].chars()
        let chunk : mut str = ""
        let argi : mut i64 = 2
        let i ¤ptrdiff : mut i64 = 0
        while i < #cs:
            if i + 1 < #cs and cs[i] = '{' and cs[i + 1] = '}':
                if chunk ≠ "":
                    let m : i64 = self.intern(chunk)
                    self.ir(IR_PRINTS, m, 0, 0, 0, 0)
                    chunk ← ""
                let arg : i64 = self.a.extra[(args_off + argi) × 1¤ptrdiff]
                self.lower_print_arg(arg)
                argi ← argi + 1
                i ← i + 2
            else:
                chunk ← chunk ⧺ cs[i]
                i ← i + 1
        if sb = SB_PRINTLN:
            chunk ← chunk ⧺ (10).chr()
        if chunk ≠ "":
            let m : i64 = self.intern(chunk)
            self.ir(IR_PRINTS, m, 0, 0, 0, 0)

    fn lower_print_arg(&mut self, arg : i64):
        let t : i64 = self.tof(arg)
        if t = TY_STR:
            if self.kof(arg) = NK_STR:
                let m : i64 = self.intern(self.a.strs[self.a.na[arg × 1¤ptrdiff] × 1¤ptrdiff])
                self.ir(IR_PRINTS, m, 0, 0, 0, 0)
            else:
                let v : i64 = self.lower_expr(arg)
                self.ir(IR_PRINTSV, v, 0, 0, 0, 0)
        elif t = TY_CHAR:
            let v : i64 = self.lower_expr(arg)
            let sv : i64 = self.tmp()
            self.ir(IR_CHARSTR, v, 0, 0, sv, 0)
            self.ir(IR_PRINTSV, sv, 0, 0, 0, 0)
        elif t = TY_BOOL:
            let v : i64 = self.lower_expr(arg)
            let mt : i64 = self.intern("true")
            let mf : i64 = self.intern("false")
            let lfalse : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, v, lfalse, 0, 0, 0)
            self.ir(IR_PRINTS, mt, 0, 0, 0, 0)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, lfalse, 0, 0, 0, 0)
            self.ir(IR_PRINTS, mf, 0, 0, 0, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        else:
            let v : i64 = self.lower_expr(arg)
            if ty_sgn(t) = 1:
                self.ir(IR_PRINTI, v, 0, 0, 0, 0)
            else:
                self.ir(IR_PRINTU, v, 0, 0, 0, 0)
            // a measured value prints its measure, as the interpreter does
            let u : i64 = ty_unit(t)
            if u ≠ UNIT_NONE:
                self.ir(IR_PRINTS, self.intern(" " ⧺ self.a.umarks[u × 1¤ptrdiff]), 0, 0, 0, 0)

    // ------------------------------------------------------------------
    // Statements
    // ------------------------------------------------------------------

    fn lower_block(&mut self, blk : i64, is_fn_body : bool, ret_ty : i64):
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let s : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let trailing : bool = is_fn_body and i = n - 1
            self.lower_stmt(s, trailing, ret_ty)
            i ← i + 1

    // what a return hands over: a bare value under an optional answer
    // boxes itself, and a bare ÷ or % answers ∅ for the zero divisor
    fn lower_ret_value(&mut self, na : i64):
        if ty_is_opt(self.cur_ret) and (self.kof(na) = NK_DIV or self.kof(na) = NK_MOD) and not ty_is_opt(self.tof(na)):
            let av9 : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
            let bv9 : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
            let lok9 : i64 = self.label()
            self.ir(IR_JNZ, bv9, lok9, 0, 0, 0)
            let zn9 : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, zn9, 0)
            self.lower_ret(zn9)
            self.ir(IR_LABEL, lok9, 0, 0, 0, 0)
            let zd9 : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, zd9, 0)
            let q9 : i64 = self.tmp()
            self.ir(IR_DIVV if self.kof(na) = NK_DIV else IR_MODD, av9, bv9, zd9, q9, width_of(self.tof(na)))
            let bb9 : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, bb9, 0)
            self.ir(IR_FSTO, bb9, 0, q9, 0, 0)
            self.lower_ret(bb9)
            return
        let v : i64 = self.lower_expr(na)
        if ty_is_opt(self.cur_ret) and not ty_is_opt(self.tof(na)):
            let b9 : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, b9, 0)
            self.ir(IR_FSTO, b9, 0, v, 0, 0)
            self.lower_ret(b9)
            return
        self.lower_ret(v)

    fn lower_ret(&mut self, v : i64):
        if self.post_label ≠ ⁻1:
            self.ir(IR_MOV, v, 0, 0, self.res_vreg, 0)
            self.ir(IR_JMP, self.post_label, 0, 0, 0, 0)
        else:
            self.ir(IR_RET, v, 0, 0, 0, 0)

    // An if, laid out so the way it is expected to go is the way that
    // falls through.  Without a hint the then-block falls through;
    // @unlikely says otherwise, and where there is an else the two swap
    // for nothing -- the same instructions, with the cold block out of
    // the straight line.  With no else there is nothing to swap it
    // with, and the layout stands as it was.
    fn lower_if(&mut self, sid : i64, unlikely : i64, trailing : bool, ret_ty : i64):
        if self.try_jtab(sid, ret_ty):
            return
        let na : i64 = self.a.na[sid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[sid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[sid × 1¤ptrdiff]
        let lelse : i64 = self.label()
        let cv : i64 = self.lower_expr(na)
        if unlikely = 1 and nc ≠ ⁻1:
            let lend2 : i64 = self.label()
            self.ir(IR_JNZ, cv, lelse, 0, 0, 0)
            self.lower_block(nc, false, ret_ty)
            self.ir(IR_JMP, lend2, 0, 0, 0, 0)
            self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
            self.lower_block(nb, false, ret_ty)
            self.ir(IR_LABEL, lend2, 0, 0, 0, 0)
            return
        self.ir(IR_JZ, cv, lelse, 0, 0, 0)
        self.lower_block(nb, false, ret_ty)
        if nc = ⁻1:
            self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
        else:
            let lend : i64 = self.label()
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
            self.lower_block(nc, false, ret_ty)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)

    fn lower_stmt(&mut self, sid : i64, trailing : bool, ret_ty : i64):
        self.tnext ← self.tbase
        let k : i64 = self.kof(sid)
        let tok : i64 = self.a.ntok[sid × 1¤ptrdiff]
        let na : i64 = self.a.na[sid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[sid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[sid × 1¤ptrdiff]
        if k = NK_EXPECTS:
            // one that drew what it was marked to draw did not check,
            // and there is nothing of it to emit; one that drew nothing
            // is an ordinary statement and is emitted as one
            if nb = 0:
                self.lower_stmt(na, trailing, ret_ty)
        elif k = NK_LET:
            let v : i64 = self.lower_expr(na)
            self.ir(IR_MOV, v, 0, 0, self.nslot[sid × 1¤ptrdiff], 0)
        elif k = NK_LETT:
            let n : i64 = self.a.extra[nc × 1¤ptrdiff]
            let v : i64 = self.lower_expr(na)
            let slot0 : i64 = self.nslot[sid × 1¤ptrdiff]
            let i : mut i64 = 0
            while i < n:
                self.ir(IR_FLD, v, i, 0, slot0 + i, 0)
                i ← i + 1
        elif k = NK_ASSIGN:
            let v : i64 = self.lower_expr(na)
            let slot : i64 = self.nslot[sid × 1¤ptrdiff]
            if slot <= ⁻2:
                self.ir(IR_GSTORE, 0 - slot - 2, v, 0, 0, 0)
            elif self.a.nb[sid × 1¤ptrdiff] = 1:
                // through the element's address, back into the array
                self.ir(IR_FSTO, slot, 0, v, 0, 0)
            else:
                self.ir(IR_MOV, v, 0, 0, slot, 0)
        elif k = NK_STOREFLD:
            let bv : i64 = self.lower_expr(na)
            let vv : i64 = self.lower_expr(nb)
            self.ir(IR_FSTO, bv, nc, vv, 0, 0)
        elif k = NK_STOREIDXP:
            let bv : i64 = self.lower_expr(na)
            let iv : i64 = self.lower_expr(nb)
            let vv : i64 = self.lower_expr(nc)
            if ty_is_hash(self.tof(sid)):
                self.ir(IR_HPUT, bv, iv, vv, 0, 0)
            else:
                self.ir(IR_ASTO, bv, iv, vv, 0, 0)
        elif k = NK_DISCARD:
            _ ← self.lower_expr(na)
        elif k = NK_EXPRSTMT:
            if trailing and ret_ty ≠ TY_UNIT:
                self.lower_ret_value(na)
            else:
                _ ← self.lower_expr(na)
        elif k = NK_RETURN:
            if na = ⁻1:
                self.ir(IR_RET, ⁻1, 0, 0, 0, 0)
            else:
                self.lower_ret_value(na)
        elif k = NK_HINTED:
            self.lower_if(na, nb, trailing, ret_ty)
        elif k = NK_IF:
            self.lower_if(sid, 0, trailing, ret_ty)
        elif k = NK_WHILE:
            let ltop : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
            let cv : i64 = self.lower_expr(na)
            self.ir(IR_JZ, cv, lend, 0, 0, 0)
            self.breaks.push(lend)
            self.conts.push(ltop)
            self.lower_block(nb, false, ret_ty)
            _ ← self.breaks.pop() ?? 0
            _ ← self.conts.pop() ?? 0
            self.ir(IR_JMP, ltop, 0, 0, 0, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        elif k = NK_MATCH:
            let v : i64 = self.lower_expr(na)
            let bind : i64 = self.nslot[sid × 1¤ptrdiff]
            let lempty : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, v, lempty, 0, 0, 0)
            self.ir(IR_FLD, v, 0, 0, bind, 0)
            self.lower_block(self.a.extra[nb × 1¤ptrdiff], trailing, ret_ty)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, lempty, 0, 0, 0, 0)
            self.lower_block(self.a.extra[(nb + 1) × 1¤ptrdiff], trailing, ret_ty)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        elif k = NK_FOREACH:
            self.lower_foreach(sid, tok, na, nb, ret_ty)
        elif k = NK_WHILEB:
            let evar : i64 = self.nslot[sid × 1¤ptrdiff]
            let ltop : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
            if self.kof(na) = NK_MCALL and self.a.nc[na × 1¤ptrdiff] = MID_POP:
                // pop's own emptiness is the loop's test
                let av9 : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let n9 : i64 = self.tmp()
                self.ir(IR_ALEN, av9, 0, 0, n9, 0)
                self.ir(IR_JZ, n9, lend, 0, 0, 0)
                let dz : i64 = self.tmp()
                self.ir(IR_CONST, 0, 0, 0, dz, 0)
                self.ir(IR_APOP, av9, dz, 0, evar, width_of(self.tof(na)))
            elif self.kof(na) = NK_MCALL and self.a.nc[na × 1¤ptrdiff] = MID_GET:
                // the place is asked afresh each turn; absence ends it
                let avg : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let ivg : i64 = self.lower_expr(self.a.extra[(self.a.nb[na × 1¤ptrdiff] + 1) × 1¤ptrdiff])
                let ng : i64 = self.tmp()
                self.ir(IR_ALEN, avg, 0, 0, ng, 0)
                let cg : i64 = self.tmp()
                self.ir(IR_CLT, ivg, ng, 0, cg, 64)
                self.ir(IR_JZ, cg, lend, 0, 0, 0)
                self.ir(IR_AIDX, avg, ivg, 0, evar, 0)
            elif self.kof(na) = NK_MCALL and self.a.nc[na × 1¤ptrdiff] = MID_NEXT:
                // the iterator's position against its array's length
                let itv : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let dsc9 : i64 = self.tmp()
                self.ir(IR_FLD, itv, 0, 0, dsc9, 0)
                let pos9 : i64 = self.tmp()
                self.ir(IR_FLD, itv, 1, 0, pos9, 0)
                let len9 : i64 = self.tmp()
                self.ir(IR_ALEN, dsc9, 0, 0, len9, 0)
                let cc9 : i64 = self.tmp()
                self.ir(IR_CLT, pos9, len9, 0, cc9, 64 + 256)
                self.ir(IR_JZ, cc9, lend, 0, 0, 0)
                if self.a.extra[nc × 1¤ptrdiff] = 1:
                    // the element's address, to write back through
                    self.ir(IR_AREF, dsc9, pos9, 0, evar, 0)
                else:
                    self.ir(IR_AIDX, dsc9, pos9, 0, evar, 0)
                let on9 : i64 = self.tmp()
                self.ir(IR_CONST, 1, 0, 0, on9, 0)
                let npp : i64 = self.tmp()
                self.ir(IR_ADDW, pos9, on9, 0, npp, 64 + 256)
                self.ir(IR_FSTO, itv, 1, npp, 0, 0)
            else:
                let v9 : i64 = self.lower_expr(na)
                self.ir(IR_JZ, v9, lend, 0, 0, 0)
                if ty_is_opt(self.tof(na)):
                    self.ir(IR_FLD, v9, 0, 0, evar, 0)
                else:
                    self.ir(IR_MOV, v9, 0, 0, evar, 0)
            self.breaks.push(lend)
            self.conts.push(ltop)
            self.lower_block(nb, false, ret_ty)
            _ ← self.breaks.pop() ?? 0
            _ ← self.conts.pop() ?? 0
            self.ir(IR_JMP, ltop, 0, 0, 0, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        elif k = NK_FOREACHA:
            self.lower_foreacha(sid, tok, na, nb, ret_ty)
        elif k = NK_BREAK:
            self.ir(IR_JMP, self.breaks[#self.breaks - 1], 0, 0, 0, 0)
        elif k = NK_CONTINUE:
            self.ir(IR_JMP, self.conts[#self.conts - 1], 0, 0, 0, 0)

    // ------------------------------------------------------------------
    // Dense dispatch becomes a jump table.  An if/elif ladder testing
    // one variable against integer constants is one decision, not
    // many; with at least four cases and a span within three times
    // their count (the profitability window real compilers use), the
    // ladder lowers to a bounds check and one indirect jump through a
    // table of code addresses in rodata.
    // ------------------------------------------------------------------

    fn try_jtab(&mut self, sid : i64, ret_ty : i64) → bool:
        let ks : mut i64[] = []
        let blks : mut i64[] = []
        let xslot : mut i64 = ⁻1
        let default_blk : mut i64 = ⁻1
        let cur : mut i64 = sid
        let good : mut bool = true
        while true:
            let cond : i64 = self.a.na[cur × 1¤ptrdiff]
            if self.kof(cond) ≠ NK_EQ:
                good ← false
                break
            let l : i64 = self.a.na[cond × 1¤ptrdiff]
            let r : i64 = self.a.nb[cond × 1¤ptrdiff]
            let vn : mut i64 = ⁻1
            let kn : mut i64 = ⁻1
            if self.kof(l) = NK_VAR and self.kof(r) = NK_INT:
                vn ← l
                kn ← r
            elif self.kof(r) = NK_VAR and self.kof(l) = NK_INT:
                vn ← r
                kn ← l
            else:
                good ← false
                break
            let slot : i64 = self.nslot[vn × 1¤ptrdiff]
            if slot < 0 or self.a.nb[kn × 1¤ptrdiff] ≠ 0:
                // a global, or a constant past i64: leave it a ladder
                good ← false
                break
            if xslot = ⁻1:
                xslot ← slot
            elif slot ≠ xslot:
                good ← false
                break
            ks.push(self.a.na[kn × 1¤ptrdiff])
            blks.push(self.a.nb[cur × 1¤ptrdiff])
            let els : i64 = self.a.nc[cur × 1¤ptrdiff]
            if els = ⁻1:
                break
            // an elif chain is an else block holding exactly one if
            let off : i64 = self.a.na[els × 1¤ptrdiff]
            if self.a.extra[off × 1¤ptrdiff] = 1 and self.kof(self.a.extra[(off + 1) × 1¤ptrdiff]) = NK_IF:
                cur ← self.a.extra[(off + 1) × 1¤ptrdiff]
            else:
                default_blk ← els
                break
        assert(#ks = #blks, "one arm per case")
        if not good or #ks < 4:
            return false
        let lo : mut i64 = ks[0]
        let hi : mut i64 = ks[0]
        foreach k := ks:
            lo ← lo ⌊ k
            hi ← hi ⌈ k
        let span : i64 = hi - lo + 1
        let shape : str = ", \"cases\": " ⧺ i64_str(@dropunit(#ks)) ⧺ ", \"span\": " ⧺ i64_str(span)
        if span > 3 × @dropunit(#ks) or span > 1024:
            self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "ladder-kept", shape)
            return false
        // distinct cases; a repeat would silently shadow, so leave a
        // repeat to the ladder the checker saw
        foreach i := 0…#ks - 1:
            foreach j := 0…#ks - 1:
                if j > i and ks[i] = ks[j]:
                    return false
        // a ladder whose every arm returns a constant, default
        // included, is not control flow at all: it folds to one load
        // from a table of values and one select against the default
        if default_blk ≠ ⁻1 and self.post_label = ⁻1:
            let vals : mut i64[] = []
            let all_const : mut bool = true
            foreach b := blks:
                let cv : i64 = self.block_ret_const(b)
                if cv = ⁻4611686018427387904:
                    all_const ← false
                vals.push(cv)
            let defv : i64 = self.block_ret_const(default_blk)
            if defv = ⁻4611686018427387904:
                all_const ← false
            if all_const:
                let off0 : i64 = @dropunit(#self.extra)
                self.extra.push(lo)
                self.extra.push(span)
                self.extra.push(defv)
                let si : mut i64 = 0
                while si < span:
                    let entry : mut i64 = defv
                    foreach i := 0…#ks - 1:
                        if ks[i] = lo + si:
                            entry ← vals[i]
                    self.extra.push(entry)
                    si ← si + 1
                let xv0 : i64 = xslot
                let d : i64 = self.tmp()
                self.ir(IR_VTAB, xv0, off0, 0, d, 0)
                self.ir(IR_RET, d, 0, 0, 0, 0)
                self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "value-table", shape)
                return true
        // labels: one per case, the default, the join
        let ldef : i64 = self.label()
        let lend : i64 = self.label()
        let case_labels : mut i64[] = []
        foreach _ := 0…#ks - 1:
            case_labels.push(self.label())
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(lo)
        self.extra.push(span)
        self.extra.push(ldef)
        let s : mut i64 = 0
        while s < span:
            let target : mut i64 = ldef
            foreach i := 0…#ks - 1:
                if ks[i] = lo + s:
                    target ← case_labels[i]
            self.extra.push(target)
            s ← s + 1
        self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "jump-table", shape)
        self.ir(IR_JTAB, xslot, off, 0, 0, 0)
        foreach i := 0…#ks - 1:
            self.ir(IR_LABEL, case_labels[i], 0, 0, 0, 0)
            self.lower_block(blks[i], false, ret_ty)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, ldef, 0, 0, 0, 0)
        if default_blk ≠ ⁻1:
            self.lower_block(default_blk, false, ret_ty)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        true

    // the constant a block returns, or the impossible sentinel
    fn block_ret_const(&self, blk : i64) → i64:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        if self.a.extra[off × 1¤ptrdiff] ≠ 1:
            return ⁻4611686018427387904
        let st : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        if self.kof(st) ≠ NK_RETURN:
            return ⁻4611686018427387904
        let e : i64 = self.a.na[st × 1¤ptrdiff]
        if e = ⁻1:
            return ⁻4611686018427387904
        let ek : i64 = self.kof(e)
        if ek ≠ NK_INT and ek ≠ NK_BOOL:
            return ⁻4611686018427387904
        // a constant that happens to be the sentinel itself simply
        // does not fold; the jump table serves it instead
        self.a.na[e × 1¤ptrdiff]

    fn elem_of(&self, t : i64) → i64:
        if ty_is_mat(t):
            return self.a.minner[ty_midx(t) × 1¤ptrdiff]
        self.a.fae[ty_fidx(t) × 1¤ptrdiff] if ty_is_farr(t) else ty_elem(t)

    fn farr_size(&self, t : i64) → i64:
        self.a.fas[ty_fidx(t) × 1¤ptrdiff]

    fn mat_elem(&self, t : i64) → i64:
        self.a.mel[ty_midx(t) × 1¤ptrdiff]

    fn mat_rr(&self, t : i64) → i64:
        self.a.mrr[ty_midx(t) × 1¤ptrdiff]

    fn mat_cc(&self, t : i64) → i64:
        self.a.mcc[ty_midx(t) × 1¤ptrdiff]

    fn mat_dd(&self, t : i64) → i64:
        self.a.mdd[ty_midx(t) × 1¤ptrdiff]

    fn mat_rank(&self, t : i64) → i64:
        2 if self.a.mdd[ty_midx(t) × 1¤ptrdiff] = ⁻2 else 3

    fn tup_len(&self, t : i64) → i64:
        self.a.ttl[ty_tidx(t) × 1¤ptrdiff]

    fn lower_foreach(&mut self, sid : i64, tok : i64, na : i64, body : i64,
                     ret_ty : i64):
        let lo_n : i64 = self.a.extra[na × 1¤ptrdiff]
        let step_n : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi_n : i64 = self.a.extra[(na + 2) × 1¤ptrdiff]
        let lov : i64 = self.lower_expr(lo_n)
        let hiv0 : i64 = self.lower_expr(hi_n)
        let hiv : i64 = self.tmp()
        self.ir(IR_MOV, hiv0, 0, 0, hiv, 0)
        let dirv : i64 = self.tmp()
        if step_n = ⁻1:
            // without a step the direction follows the bounds: a cmov,
            // not a branch
            let c : i64 = self.tmp()
            self.ir(IR_CLE, lov, hiv, 0, c, 64 + 256)
            let one : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one, 0)
            let mone : i64 = self.tmp()
            self.ir(IR_CONST, ⁻1, 0, 0, mone, 0)
            self.ir(IR_SEL, c, one, mone, dirv, 0)
        else:
            let sv : i64 = self.lower_expr(step_n)
            self.ir(IR_MOV, sv, 0, 0, dirv, 0)
            let lz : i64 = self.label()
            self.ir(IR_JNZ, dirv, lz, 0, 0, 0)
            let m : i64 = self.intern("a foreach step of zero never arrives (line " ⧺ i64_str(self.tok_line(tok)) ⧺ ")\n")
            self.ir(IR_ABORT, m, 0, 0, 0, 0)
            self.ir(IR_LABEL, lz, 0, 0, 0, 0)
        self.lower_range_loop(sid, lov, hiv, dirv, body, ret_ty)

    // still inside: (dir > 0 ∧ i ≤ hi) ∨ (dir < 0 ∧ i ≥ hi) --
    // materialized comparisons, no branches until the one decision
    fn range_alive(&mut self, ivar : i64, hiv : i64, dirv : i64) → i64:
        let z : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, z, 0)
        let up : i64 = self.tmp()
        self.ir(IR_CGT, dirv, z, 0, up, 64 + 256)
        let le : i64 = self.tmp()
        self.ir(IR_CLE, ivar, hiv, 0, le, 64 + 256)
        let c1 : i64 = self.tmp()
        self.ir(IR_BAND, up, le, 0, c1, 64)
        let down : i64 = self.tmp()
        self.ir(IR_CLT, dirv, z, 0, down, 64 + 256)
        let ge : i64 = self.tmp()
        self.ir(IR_CGE, ivar, hiv, 0, ge, 64 + 256)
        let c2 : i64 = self.tmp()
        self.ir(IR_BAND, down, ge, 0, c2, 64)
        let c : i64 = self.tmp()
        self.ir(IR_BORR, c1, c2, 0, c, 64)
        c

    fn lower_range_loop(&mut self, sid : i64, lov : i64, hiv : i64,
                        dirv : i64, body : i64, ret_ty : i64):
        let ivar : i64 = self.nslot[sid × 1¤ptrdiff]
        self.ir(IR_MOV, lov, 0, 0, ivar, 0)
        let saved_base : i64 = self.tbase
        self.tbase ← self.tnext
        let ltop : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let c : i64 = self.range_alive(ivar, hiv, dirv)
        self.ir(IR_JZ, c, lend, 0, 0, 0)
        self.breaks.push(lend)
        self.conts.push(lcont)
        self.lower_block(body, false, ret_ty)
        _ ← self.breaks.pop() ?? 0
        _ ← self.conts.pop() ?? 0
        self.ir(IR_LABEL, lcont, 0, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(IR_ADDW, ivar, dirv, 0, ni, 64 + 256)
        self.ir(IR_MOV, ni, 0, 0, ivar, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        self.tbase ← saved_base

    fn lower_foreacha(&mut self, sid : i64, tok : i64, arr : i64, body : i64,
                      ret_ty : i64):
        if ty_is_rg(self.tof(arr)):
            let rv : i64 = self.lower_expr(arr)
            let lo9 : i64 = self.tmp()
            self.ir(IR_FLD, rv, 0, 0, lo9, 0)
            let st9 : i64 = self.tmp()
            self.ir(IR_FLD, rv, 1, 0, st9, 0)
            let hi9 : i64 = self.tmp()
            self.ir(IR_FLD, rv, 2, 0, hi9, 0)
            let lz9 : i64 = self.label()
            self.ir(IR_JNZ, st9, lz9, 0, 0, 0)
            let m9 : i64 = self.intern("range step must not be zero (line " ⧺ i64_str(self.tok_line(tok)) ⧺ ")\n")
            self.ir(IR_ABORT, m9, 0, 0, 0, 0)
            self.ir(IR_LABEL, lz9, 0, 0, 0, 0)
            self.lower_range_loop(sid, lo9, hi9, st9, body, ret_ty)
            return
        let evar : i64 = self.nslot[sid × 1¤ptrdiff]
        if self.tof(arr) = TY_STR:
            // A string is walked where it lies.  Laying its characters
            // out first would cost eight bytes for every byte read, and
            // the arena does not take them back -- a walk repeated is a
            // walk that grows.  Each turn decodes one character and says
            // where the next one begins.
            let sv : i64 = self.lower_expr(arr)
            let sb : i64 = self.tmp()
            self.ir(IR_FLD, sv, 1, 0, sb, 0)
            let si : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, si, 0)
            let sbase : i64 = self.tbase
            self.tbase ← self.tnext
            let stop : i64 = self.label()
            let scont : i64 = self.label()
            let send : i64 = self.label()
            self.ir(IR_LABEL, stop, 0, 0, 0, 0)
            let sc : i64 = self.tmp()
            self.ir(IR_CLT, si, sb, 0, sc, 64 + 256)
            self.ir(IR_JZ, sc, send, 0, 0, 0)
            let snext : i64 = self.tmp()
            self.ir(IR_SDEC, sv, si, snext, evar, 0)
            // the position moves before the body, so a continue leaves
            // the walk where the next character begins
            self.ir(IR_MOV, snext, 0, 0, si, 0)
            self.breaks.push(send)
            self.conts.push(scont)
            self.lower_block(body, false, ret_ty)
            _ ← self.breaks.pop() ?? 0
            _ ← self.conts.pop() ?? 0
            self.ir(IR_LABEL, scont, 0, 0, 0, 0)
            self.ir(IR_JMP, stop, 0, 0, 0, 0)
            self.ir(IR_LABEL, send, 0, 0, 0, 0)
            self.tbase ← sbase
            return
        let av0 : i64 = self.lower_expr(arr)
        let av : mut i64 = av0
        let desc : i64 = self.tmp()
        self.ir(IR_MOV, av, 0, 0, desc, 0)
        let iv : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, iv, 0)
        let saved_base : i64 = self.tbase
        self.tbase ← self.tnext
        let ltop : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let n : i64 = self.tmp()
        self.ir(IR_ALEN, desc, 0, 0, n, 0)
        let c : i64 = self.tmp()
        self.ir(IR_CLT, iv, n, 0, c, 64 + 256)
        self.ir(IR_JZ, c, lend, 0, 0, 0)
        if self.a.nc[sid × 1¤ptrdiff] ≠ 0:
            self.ir(IR_AREF, desc, iv, 0, evar, 0)
        else:
            self.ir(IR_AIDX, desc, iv, 0, evar, 0)
        self.breaks.push(lend)
        self.conts.push(lcont)
        self.lower_block(body, false, ret_ty)
        _ ← self.breaks.pop() ?? 0
        _ ← self.conts.pop() ?? 0
        self.ir(IR_LABEL, lcont, 0, 0, 0, 0)
        let one : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, one, 0)
        let ni : i64 = self.tmp()
        self.ir(IR_ADDW, iv, one, 0, ni, 64 + 256)
        self.ir(IR_MOV, ni, 0, 0, iv, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        self.tbase ← saved_base

// one λ becomes one function: the parameters arrive in the argument
// registers, the box rides behind them, and the captures come out of
// the box into the slots the body reads
fn lower_lambda_fn(lw : &mut Lower, a : Ast, chk : Chk, j : i64) → IrFn:
    while #lw.op > 0:
        _ ← lw.op.pop() ?? 0
        _ ← lw.ia.pop() ?? 0
        _ ← lw.ib.pop() ?? 0
        _ ← lw.ic.pop() ?? 0
        _ ← lw.idd.pop() ?? 0
        _ ← lw.iww.pop() ?? 0
    while #lw.extra > 0:
        _ ← lw.extra.pop() ?? 0
    lw.nlabels ← 0
    let nid : i64 = chk.lams[j × 1¤ptrdiff]
    let loff : i64 = a.na[nid × 1¤ptrdiff]
    let np : i64 = a.extra[loff × 1¤ptrdiff]
    let ncap : i64 = a.extra[(loff + 1 + np × 2) × 1¤ptrdiff]
    let ret : i64 = a.extra[(loff + 2 + np × 2 + ncap) × 1¤ptrdiff]
    lw.tbase ← chk.lamns[j × 1¤ptrdiff] ⌈ (np + 2)
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← ret
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← "λ"
    // the prologue put argument k in slot k, and the checker's slots
    // for the parameters may overlap those very cells -- so everything
    // incoming is parked in fresh temporaries first, then placed
    let parked : mut i64[] = []
    let pi : mut i64 = 0
    while pi < np:
        let pt9 : i64 = lw.tmp()
        lw.ir(IR_MOV, pi, 0, 0, pt9, 0)
        parked.push(pt9)
        pi ← pi + 1
    let boxt : i64 = lw.tmp()
    lw.ir(IR_MOV, np, 0, 0, boxt, 0)
    let pj : mut i64 = 0
    while pj < np:
        lw.ir(IR_MOV, parked[pj × 1¤ptrdiff], 0, 0, a.extra[(loff + 1 + pj × 2) × 1¤ptrdiff], 0)
        pj ← pj + 1
    let pslot0 : i64 = a.extra[(loff + 1) × 1¤ptrdiff]
    let ci : mut i64 = 0
    while ci < ncap:
        lw.ir(IR_FLD, boxt, 1 + ci, 0, pslot0 + np + ci, 0)
        ci ← ci + 1
    let bodyn : i64 = a.nb[nid × 1¤ptrdiff]
    if a.nkind[bodyn × 1¤ptrdiff] = NK_BLOCK:
        // statements, ending in a trailing value or a return; both go
        // through lower_ret_value, which boxes under an optional answer
        lw.lower_block(bodyn, true, ret)
    else:
        let rv : i64 = lw.lower_expr(bodyn)
        if ty_is_opt(ret) and not ty_is_opt(lw.tof(bodyn)):
            // a bare value under an optional answer boxes itself
            let bb : i64 = lw.tmp()
            lw.ir(IR_SNEW, 1, 0, 0, bb, 0)
            lw.ir(IR_FSTO, bb, 0, rv, 0, 0)
            lw.ir(IR_RET, bb, 0, 0, 0, 0)
        else:
            lw.ir(IR_RET, rv, 0, 0, 0, 0)
    let opc : mut i64[] = []
    let iac : mut i64[] = []
    let ibc : mut i64[] = []
    let icc : mut i64[] = []
    let idc : mut i64[] = []
    let iwc : mut i64[] = []
    let exc : mut i64[] = []
    foreach v := lw.op:
        opc.push(v)
    foreach v := lw.ia:
        iac.push(v)
    foreach v := lw.ib:
        ibc.push(v)
    foreach v := lw.ic:
        icc.push(v)
    foreach v := lw.idd:
        idc.push(v)
    foreach v := lw.iww:
        iwc.push(v)
    if #lw.extra > 0:
        foreach v := lw.extra:
            exc.push(v)
    (IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
          extra: exc, nvregs: lw.tmax, nlabels: lw.nlabels})

// one partial-application site becomes one shim: the remaining
// arguments arrive in registers, the box rides behind them, and the
// bound values come out of the box in front
fn lower_shim_fn(lw : &mut Lower, chk : Chk, j : i64) → IrFn:
    while #lw.op > 0:
        _ ← lw.op.pop() ?? 0
        _ ← lw.ia.pop() ?? 0
        _ ← lw.ib.pop() ?? 0
        _ ← lw.ic.pop() ?? 0
        _ ← lw.idd.pop() ?? 0
        _ ← lw.iww.pop() ?? 0
    while #lw.extra > 0:
        _ ← lw.extra.pop() ?? 0
    lw.nlabels ← 0
    let target : i64 = chk.psfn[j × 1¤ptrdiff]
    let k : i64 = chk.psk[j × 1¤ptrdiff]
    let np : i64 = chk.psnp[j × 1¤ptrdiff]
    let rem : i64 = np - k
    let box9 : i64 = rem
    lw.tbase ← rem + 2
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← TY_I64
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← "λ"
    let bound : mut i64[] = []
    let bi : mut i64 = 0
    while bi < k:
        let bv : i64 = lw.tmp()
        lw.ir(IR_FLD, box9, 1 + bi, 0, bv, 0)
        bound.push(bv)
        bi ← bi + 1
    let off : i64 = @dropunit(#lw.extra)
    if target >= 0:
        lw.extra.push(np)
    else:
        lw.extra.push(np + 1)
    foreach v := bound:
        lw.extra.push(v)
    let ri : mut i64 = 0
    while ri < rem:
        lw.extra.push(ri)
        ri ← ri + 1
    let d : i64 = lw.tmp()
    if target >= 0:
        lw.ir(IR_CALL, target, off, 0, d, 0)
    else:
        let src : i64 = lw.tmp()
        lw.ir(IR_FLD, box9, 1 + k, 0, src, 0)
        lw.extra.push(src)
        let ad : i64 = lw.tmp()
        lw.ir(IR_FLD, src, 0, 0, ad, 0)
        lw.ir(IR_CALLI, ad, off, 0, d, 0)
    lw.ir(IR_RET, d, 0, 0, 0, 0)
    let opc : mut i64[] = []
    let iac : mut i64[] = []
    let ibc : mut i64[] = []
    let icc : mut i64[] = []
    let idc : mut i64[] = []
    let iwc : mut i64[] = []
    let exc : mut i64[] = []
    foreach v := lw.op:
        opc.push(v)
    foreach v := lw.ia:
        iac.push(v)
    foreach v := lw.ib:
        ibc.push(v)
    foreach v := lw.ic:
        icc.push(v)
    foreach v := lw.idd:
        idc.push(v)
    foreach v := lw.iww:
        iwc.push(v)
    if #lw.extra > 0:
        foreach v := lw.extra:
            exc.push(v)
    (IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
          extra: exc, nvregs: lw.tmax, nlabels: lw.nlabels})

fn lower_stub_fn(lw : &mut Lower, np : i64) → IrFn:
    while #lw.op > 0:
        _ ← lw.op.pop() ?? 0
        _ ← lw.ia.pop() ?? 0
        _ ← lw.ib.pop() ?? 0
        _ ← lw.ic.pop() ?? 0
        _ ← lw.idd.pop() ?? 0
        _ ← lw.iww.pop() ?? 0
    while #lw.extra > 0:
        _ ← lw.extra.pop() ?? 0
    lw.nlabels ← 0
    lw.tbase ← np + 1
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.ir(IR_RET, ⁻1, 0, 0, 0, 0)
    let opc : mut i64[] = []
    let iac : mut i64[] = []
    let ibc : mut i64[] = []
    let icc : mut i64[] = []
    let idc : mut i64[] = []
    let iwc : mut i64[] = []
    foreach v := lw.op:
        opc.push(v)
    foreach v := lw.ia:
        iac.push(v)
    foreach v := lw.ib:
        ibc.push(v)
    foreach v := lw.ic:
        icc.push(v)
    foreach v := lw.idd:
        idc.push(v)
    foreach v := lw.iww:
        iwc.push(v)
    (IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
          extra: [], nvregs: lw.tmax, nlabels: 0})

fn lower_fn(lw : &mut Lower, a : Ast, chk : Chk, f : i64) → IrFn:
    let d := a.fns[f × 1¤ptrdiff]
    while #lw.op > 0:
        _ ← lw.op.pop() ?? 0
        _ ← lw.ia.pop() ?? 0
        _ ← lw.ib.pop() ?? 0
        _ ← lw.ic.pop() ?? 0
        _ ← lw.idd.pop() ?? 0
        _ ← lw.iww.pop() ?? 0
    while #lw.extra > 0:
        _ ← lw.extra.pop() ?? 0
    lw.nlabels ← 0
    lw.tbase ← chk.fslots[f × 1¤ptrdiff]
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← d.ret
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← d.name
    if d.pre_off ≠ ⁻1:
        let n : i64 = a.extra[d.pre_off × 1¤ptrdiff]
        let j : mut i64 = 0
        while j < n:
            lw.tnext ← lw.tbase
            let c : i64 = a.extra[(d.pre_off + 1 + j) × 1¤ptrdiff]
            let cv : i64 = lw.lower_expr(c)
            let lok : i64 = lw.label()
            lw.ir(IR_JNZ, cv, lok, 0, 0, 0)
            let m : i64 = lw.intern("precondition of '" ⧺ d.name ⧺ "' does not hold\n")
            lw.ir(IR_ABORT, m, 0, 0, 0, 0)
            lw.ir(IR_LABEL, lok, 0, 0, 0, 0)
            j ← j + 1
    if d.post_off ≠ ⁻1 and d.ret ≠ TY_UNIT:
        lw.post_label ← lw.label()
        // the checker gave the result's name the slot after the
        // parameters, so the value is put where the conditions read it
        lw.res_vreg ← a.extra[d.params_off × 1¤ptrdiff]
    lw.lower_block(d.body, true, d.ret)
    if d.ret = TY_UNIT:
        lw.ir(IR_RET, ⁻1, 0, 0, 0, 0)
    if lw.post_label ≠ ⁻1:
        lw.ir(IR_LABEL, lw.post_label, 0, 0, 0, 0)
        let n : i64 = a.extra[d.post_off × 1¤ptrdiff]
        let j : mut i64 = 0
        while j < n:
            lw.tnext ← lw.tbase
            let c : i64 = a.extra[(d.post_off + 2 + j × 2) × 1¤ptrdiff]
            let cv : i64 = lw.lower_expr(c)
            let lok : i64 = lw.label()
            lw.ir(IR_JNZ, cv, lok, 0, 0, 0)
            let m : i64 = lw.intern("postcondition of '" ⧺ d.name ⧺ "' does not hold\n")
            lw.ir(IR_ABORT, m, 0, 0, 0, 0)
            lw.ir(IR_LABEL, lok, 0, 0, 0, 0)
            j ← j + 1
        lw.ir(IR_RET, lw.res_vreg, 0, 0, 0, 0)
    let opc : mut i64[] = []
    let iac : mut i64[] = []
    let ibc : mut i64[] = []
    let icc : mut i64[] = []
    let idc : mut i64[] = []
    let iwc : mut i64[] = []
    let exc : mut i64[] = []
    foreach v := lw.op:
        opc.push(v)
    foreach v := lw.ia:
        iac.push(v)
    foreach v := lw.ib:
        ibc.push(v)
    foreach v := lw.ic:
        icc.push(v)
    foreach v := lw.idd:
        idc.push(v)
    foreach v := lw.iww:
        iwc.push(v)
    if #lw.extra > 0:
        foreach v := lw.extra:
            exc.push(v)
    assert(#opc = #iac and #opc = #ibc and #opc = #icc, "ir arrays in step")
    assert(#opc = #idc and #opc = #iwc, "ir arrays in step")
    assert(lw.tmax >= chk.fslots[f × 1¤ptrdiff], "the frame covers the locals")
    (IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc, extra: exc,
          nvregs: lw.tmax, nlabels: lw.nlabels})

// ===========================================================================
// Code generation: IR → x86-64 machine code
// ===========================================================================

let R_AX : i64 = 0
let R_CX : i64 = 1
let R_DX : i64 = 2
let R_SI : i64 = 6
let R_DI : i64 = 7
let R_R8 : i64 = 8
let R_R9 : i64 = 9
let R_R10 : i64 = 10
let R_R11 : i64 = 11

// runtime routine ids, call targets below the user functions
let RT_PRINTI : i64 = ⁻1
let RT_WRITE1 : i64 = ⁻2
let RT_ABORT : i64 = ⁻3
let RT_OV : i64 = ⁻4
let RT_SHIFT : i64 = ⁻5
let RT_BOUNDS : i64 = ⁻6
let RT_OOM : i64 = ⁻7
let RT_ALLOC : i64 = ⁻8
let RT_ARRNEW : i64 = ⁻9
let RT_ARRPUSH : i64 = ⁻10
let RT_CONCAT : i64 = ⁻11
let RT_STREQ : i64 = ⁻12
let RT_STRCHARS : i64 = ⁻13
let RT_PRINTSTR : i64 = ⁻14
let RT_PRINTU : i64 = ⁻15
let RT_HNEW : i64 = ⁻16
let RT_HFIND : i64 = ⁻17
let RT_HGET : i64 = ⁻18
let RT_HPUT : i64 = ⁻19
let RT_HELEM : i64 = ⁻20
let RT_HGROW : i64 = ⁻21
let RT_BADCHAR : i64 = ⁻22
let RT_STRIDX : i64 = ⁻23
let RT_CHARS : i64 = ⁻24
let RT_CHARSTR : i64 = ⁻25
let RT_ARGS : i64 = ⁻26
let RT_FOPEN : i64 = ⁻27
let RT_FCREATE : i64 = ⁻28
let RT_FREAD : i64 = ⁻29
let RT_FWRITE : i64 = ⁻30
let RT_BADFIT : i64 = ⁻31
let RT_WRITE2 : i64 = ⁻32
let RT_AFIND : i64 = ⁻33
let RT_ASLICE : i64 = ⁻34
let RT_AFILL : i64 = ⁻35
let RT_ACYC : i64 = ⁻36
let RT_ACAT : i64 = ⁻37
let RT_SBYTES : i64 = ⁻38
let RT_DENTS : i64 = ⁻39
let RT_ENVN : i64 = ⁻40
let RT_ENVG : i64 = ⁻41
let RT_AUXV : i64 = ⁻42
let RT_EXECFN : i64 = ⁻43
let RT_RELRO : i64 = ⁻44
let RT_STRNEXT : i64 = ⁻45
let RT_TORAW : i64 = ⁻46
let RT_WRITEV : i64 = ⁻47
// the software arithmetic a 32-bit target leans on; a 64-bit target
// never calls these and never carries them
let RT_DIVU64 : i64 = ⁻48
let RT_MODU64 : i64 = ⁻49
let RT_DIVS64 : i64 = ⁻50
let RT_MODS64 : i64 = ⁻51
let RT_MULOV64 : i64 = ⁻52

struct Emit:
    code : u8[]
    cf_pos : i64[]       // rel32 fixups against functions/runtime
    cf_target : i64[]
    sf_pos : i64[]       // abs64 fixups against a string's bytes
    sf_str : i64[]
    sd_pos : i64[]       // abs64 fixups against a string's descriptor
    sd_str : i64[]
    df_pos : i64[]       // abs64 fixups against the data segment
    df_off : i64[]
    labels : i64[]
    lf_pos : i64[]
    lf_label : i64[]
    fn_off : i64[]
    rt_off : i64[]
    // which vreg's value rax is known to hold, ⁻1 for none: the
    // cheapest of register allocations, one register deep
    rax_slot : i64
    // jump tables: abs64 fixups, and the resolved code offsets the
    // tables hold, flattened with a start index per table
    jt_pos : i64[]
    jt_id : i64[]
    jt_count : i64
    jt_starts : i64[]
    jt_is_code : i64[]
    jt_entries : i64[]
    pj_id : i64[]
    pj_start : i64[]
    pj_len : i64[]
    // the deepest frame any function claims: the guard below the stack
    // must be at least this, or one 'sub rsp' could step over it
    max_frame : i64
    // where each global lives: gseg 0 for the read-only segment and 1
    // for the writable one, gmap the offset within it
    gmap : i64[]
    gseg : i64[]
    gr_pos : i64[]       // abs64 fixups against a global held in rodata
    gr_off : i64[]
    skipping : i64       // 1 while a routine nobody calls goes by
    rt_need : i64[]      // which runtime routines the program reaches
    rx : u8[]            // constant tables the runtime reads, in rodata
    rx_pos : i64[]       // abs64 fixups against them
    rx_off : i64[]
    pj_labels : i64[]
    // the retargetable driver's fixups: local branches with their
    // instruction form, and function-address materializations
    tf_pos : i64[]
    tf_lab : i64[]
    tf_form : i64[]
    ff_pos : i64[]
    ff_fn : i64[]
    // where the kernel block and the allocator's cells sit in the
    // data segment, for IR_KADDR
    k_args : i64
    k_alloc : i64

impl Emit:
    fn here(&self) → i64:
        @dropunit(#self.code)

    // A routine the program never calls is emitted nowhere: while this
    // is set, every byte and every fixup the emitter is handed goes
    // into the ground.  Nothing else has to know.
    fn b1(&mut self, a : i64):
        if self.skipping = 1:
            return
        self.code.push(a & 255)

    fn b2(&mut self, a : i64, b : i64):
        self.b1(a)
        self.b1(b)

    fn b3(&mut self, a : i64, b : i64, c : i64):
        self.b1(a)
        self.b1(b)
        self.b1(c)

    fn b4(&mut self, a : i64, b : i64, c : i64, d : i64):
        self.b1(a)
        self.b1(b)
        self.b1(c)
        self.b1(d)

    fn w32(&mut self, v : i64):
        self.b1(v)
        self.b1(v » 8)
        self.b1(v » 16)
        self.b1(v » 24)

    fn w64(&mut self, v : i64):
        self.w32(v)
        self.w32(v » 32)

    fn patch32(&mut self, pos : i64, v : i64):
        self.code[pos × 1¤byte] ← v & 255
        self.code[(pos + 1) × 1¤byte] ← (v » 8) & 255
        self.code[(pos + 2) × 1¤byte] ← (v » 16) & 255
        self.code[(pos + 3) × 1¤byte] ← (v » 24) & 255

    fn patch64(&mut self, pos : i64, v : i64):
        self.patch32(pos, v)
        self.patch32(pos + 4, v » 32)

    fn load(&mut self, reg : i64, slot : i64):
        if reg = 0:
            if self.rax_slot = slot:
                return
            self.rax_slot ← slot
        self.b1(72 + (4 if reg >= 8 else 0))
        self.b1(139)
        self.b1(133 + ((reg & 7) « 3))
        self.w32(0 - 8 × (slot + 1))

    fn store(&mut self, reg : i64, slot : i64):
        if reg = 0:
            self.rax_slot ← slot
        elif slot = self.rax_slot:
            // another register overwrites the slot rax mirrors
            self.rax_slot ← ⁻1
        self.b1(72 + (4 if reg >= 8 else 0))
        self.b1(137)
        self.b1(133 + ((reg & 7) « 3))
        self.w32(0 - 8 × (slot + 1))

    // anything that may change rax or be jumped to forgets the memo
    fn raxbar(&mut self):
        self.rax_slot ← ⁻1

    fn movimm(&mut self, reg : i64, v : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        self.w64(v)

    fn jlocal(&mut self, opcode2 : i64, l : i64):
        if opcode2 = ⁻1:
            self.b1(233)
        else:
            self.b2(15, opcode2)
        if self.skipping = 0:
            self.lf_pos.push(self.here())
            self.lf_label.push(l)
        self.w32(0)

    fn jglobal(&mut self, opcode : i64, opcode2 : i64, target : i64):
        if opcode2 = ⁻1 and opcode = 232:
            // a call clobbers rax
            self.raxbar()
        if opcode2 = ⁻1:
            self.b1(opcode)
        else:
            self.b2(15, opcode2)
        if self.skipping = 0:
            self.cf_pos.push(self.here())
            self.cf_target.push(target)
        self.w32(0)

    fn set_label(&mut self, l : i64):
        // a label is a join point; what rax held on one way in says
        // nothing about the others
        self.raxbar()
        self.labels[l × 1¤ptrdiff] ← self.here()

    fn resolve_locals(&mut self):
        if #self.lf_pos > 0:
            foreach i := 0…#self.lf_pos - 1:
                let pos : i64 = self.lf_pos[i]
                let target : i64 = self.labels[self.lf_label[i] × 1¤ptrdiff]
                // an unset label once escaped this path as begin_fn(1)
                // against a routine that used two
                assert(target ≠ ⁻1, "every jumped-to label was placed")
                self.patch32(pos, target - (pos + 4))
        while #self.lf_pos > 0:
            _ ← self.lf_pos.pop() ?? 0
            _ ← self.lf_label.pop() ?? 0

    fn begin_fn(&mut self, nlabels : i64):
        self.raxbar()
        while #self.labels > 0:
            _ ← self.labels.pop() ?? 0
        let i : mut i64 = 0
        while i < nlabels:
            self.labels.push(⁻1)
            i ← i + 1

    fn sref(&mut self, reg : i64, stridx : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.sf_pos.push(self.here())
            self.sf_str.push(stridx)
        self.w64(0)

    fn sdref(&mut self, reg : i64, stridx : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.sd_pos.push(self.here())
            self.sd_str.push(stridx)
        self.w64(0)

    fn jtref(&mut self, reg : i64, id : i64):
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.jt_pos.push(self.here())
            self.jt_id.push(id)
        self.w64(0)

    fn resolve_jtabs(&mut self):
        if #self.pj_id > 0:
            foreach i := 0…#self.pj_id - 1:
                self.jt_starts.push(@dropunit(#self.jt_entries))
                let n0 : i64 = self.pj_len[i]
                let st : i64 = self.pj_start[i]
                if n0 < 0:
                    // a value table: the entries are the data itself
                    let n : i64 = 0 - n0
                    self.jt_is_code.push(0)
                    let j : mut i64 = 0
                    while j < n:
                        self.jt_entries.push(self.pj_labels[(st + j) × 1¤ptrdiff])
                        j ← j + 1
                    continue
                self.jt_is_code.push(1)
                let n : i64 = n0
                let j : mut i64 = 0
                while j < n:
                    let off2 : i64 = self.labels[self.pj_labels[(st + j) × 1¤ptrdiff] × 1¤ptrdiff]
                    assert(off2 ≠ ⁻1, "every table target was placed")
                    self.jt_entries.push(off2)
                    j ← j + 1
        while #self.pj_id > 0:
            _ ← self.pj_id.pop() ?? 0
            _ ← self.pj_start.pop() ?? 0
            _ ← self.pj_len.pop() ?? 0
        while #self.pj_labels > 0:
            _ ← self.pj_labels.pop() ?? 0

    // A runtime routine is found through its negative id, which indexes
    // this list -- so each one says which it is and is written where it
    // belongs, rather than wherever it happened to be emitted.  One the
    // program never reaches is passed over: the switch stays on until
    // the next routine says otherwise, and everything between goes
    // nowhere.
    fn rt_begin(&mut self, id : i64):
        let k : i64 = 0 - id - 1
        assert(k >= 0 and k < @dropunit(#self.rt_off), "a runtime routine's id is one of the list's")
        assert(self.rt_off[k × 1¤ptrdiff] = ⁻1, "a runtime routine was emitted twice")
        self.skipping ← 1 - self.rt_need[k × 1¤ptrdiff]
        // a routine that is passed over is left without a place, so a
        // call that somehow reaches for it has nowhere to land and the
        // resolution says so
        if self.skipping = 0:
            self.rt_off[k × 1¤ptrdiff] ← self.here()

    fn dref(&mut self, reg : i64, off : i64):
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.df_pos.push(self.here())
            self.df_off.push(off)
        self.w64(0)

    // a table the runtime reads is constant, so it rides in rodata
    // beside the strings; this is where its address is asked for
    fn rxref(&mut self, reg : i64, off : i64):
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.rx_pos.push(self.here())
            self.rx_off.push(off)
        self.w64(0)

    // a global that is never written lives with the other read-only
    // things, so its address is fixed against rodata instead
    fn groref(&mut self, reg : i64, off : i64):
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        if self.skipping = 0:
            self.gr_pos.push(self.here())
            self.gr_off.push(off)
        self.w64(0)

    // whichever of the two a global asks for
    fn gref(&mut self, reg : i64, g : i64):
        if self.gseg[g × 1¤ptrdiff] = 0:
            self.groref(reg, self.gmap[g × 1¤ptrdiff])
        else:
            self.dref(reg, self.gmap[g × 1¤ptrdiff])

    // narrow the canonical 64-bit value in rax back into its width
    fn canon(&mut self, w : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if bits = 64:
            return
        if sgn = 0:
            if bits = 32:
                self.b2(137, 192)            // mov eax, eax
            elif bits = 16:
                self.b4(72, 15, 183, 192)    // movzx rax, ax
            else:
                self.b4(72, 15, 182, 192)    // movzx rax, al
        else:
            if bits = 32:
                self.b3(72, 99, 192)         // movsxd rax, eax
            elif bits = 16:
                self.b4(72, 15, 191, 192)    // movsx rax, ax
            else:
                self.b4(72, 15, 190, 192)    // movsx rax, al

    // the checked-arithmetic backstop: overflow leaves for the abort,
    // a branch never taken by a correct program
    fn range_check(&mut self, w : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if bits = 64:
            return
        if sgn = 0:
            self.movimm(R_R11, (1 « bits) - 1)
            self.b3(76, 57, 216)             // cmp rax, r11
            self.jglobal(0, 135, RT_OV)      // ja
        else:
            self.movimm(R_R10, 0 - (1 « (bits - 1)))
            self.b3(72, 137, 194)            // mov rdx, rax
            self.b3(76, 41, 210)             // sub rdx, r10
            self.movimm(R_R11, (1 « bits) - 1)
            self.b3(76, 57, 218)             // cmp rdx, r11
            self.jglobal(0, 135, RT_OV)      // ja

@pre(j >= 0 and j <= 5)
fn arg_reg(j : i64) → i64:
    if j = 0: return R_DI
    if j = 1: return R_SI
    if j = 2: return R_DX
    if j = 3: return R_CX
    if j = 4: return R_R8
    R_R9

@post(r: r >= 0)
fn str_len(s : str) → i64:
    @dropunit(#s)

// the setcc condition for a comparison at a signedness
@pre(sgn = 0 or sgn = 1)
@post(r: r >= 146 and r <= 159)
fn cc_of(o : i64, sgn : i64) → i64:
    if o = IR_CEQ: return 148
    if o = IR_CNE: return 149
    if sgn = 1:
        if o = IR_CLT: return 156
        if o = IR_CLE: return 158
        if o = IR_CGT: return 159
        return 157
    if o = IR_CLT: return 146
    if o = IR_CLE: return 150
    if o = IR_CGT: return 151
    147

fn emit_fn(em : &mut Emit, ir : IrFn, np : i64, strs : str[]):
    assert(ir.nvregs >= np, "the frame covers the spilled arguments")
    em.begin_fn(ir.nlabels)
    em.b1(85)                       // push rbp
    em.b3(72, 137, 229)             // mov rbp, rsp
    em.b3(72, 129, 236)             // sub rsp, imm32
    let frame : i64 = 8 × ir.nvregs + 8
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.w32(frame)
    let j : mut i64 = 0
    while j < np:
        if j < 6:
            em.store(arg_reg(j), j)
        else:
            em.b3(72, 139, 133)
            em.w32(16 + 8 × (j - 6))    // mov rax, [rbp+…]: a stack argument
            em.store(R_AX, j)
        j ← j + 1
    let n : i64 = @dropunit(#ir.op)
    let i : mut i64 = 0
    while i < n:
        let o : i64 = ir.op[i × 1¤ptrdiff]
        let a : i64 = ir.ia[i × 1¤ptrdiff]
        let b : i64 = ir.ib[i × 1¤ptrdiff]
        let c : i64 = ir.ic[i × 1¤ptrdiff]
        let d : i64 = ir.id[i × 1¤ptrdiff]
        let w : i64 = ir.iw[i × 1¤ptrdiff]
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if o = IR_CONST:
            em.movimm(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_MOV:
            em.load(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_ADD or o = IR_ADDW or o = IR_SUB or o = IR_SUBW:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if o = IR_ADD or o = IR_ADDW:
                em.b3(72, 1, 200)   // add rax, rcx
            else:
                em.b3(72, 41, 200)  // sub rax, rcx
            if o = IR_ADD or o = IR_SUB:
                if bits = 64:
                    em.jglobal(0, 128 if sgn = 1 else 130, RT_OV)  // jo / jc
                else:
                    em.range_check(w)
            else:
                em.canon(w)
            em.store(R_AX, d)
        elif o = IR_MUL or o = IR_MULW:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if sgn = 1 or o = IR_MULW:
                em.b4(72, 15, 175, 193)      // imul rax, rcx
                if o = IR_MUL:
                    if bits = 64:
                        em.jglobal(0, 128, RT_OV)
                    else:
                        em.range_check(w)
                else:
                    em.canon(w)
            else:
                em.b3(72, 247, 225)          // mul rcx
                em.jglobal(0, 130, RT_OV)    // jc: past 64 bits
                if bits ≠ 64:
                    em.range_check(w)
            em.store(R_AX, d)
        elif o = IR_NEG or o = IR_NEGW:
            em.load(R_AX, a)
            em.b3(72, 247, 216)              // neg rax
            if o = IR_NEG:
                if sgn = 1:
                    if bits = 64:
                        em.jglobal(0, 128, RT_OV)
                    else:
                        em.range_check(w)
                else:
                    // a negated unsigned is only 0; nonzero sets carry
                    if bits = 64:
                        em.jglobal(0, 130, RT_OV)
                    else:
                        em.range_check(w)
            else:
                em.canon(w)
            em.store(R_AX, d)
        elif o = IR_BAND or o = IR_BORR or o = IR_BXORR:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if o = IR_BAND:
                em.b3(72, 33, 200)
            elif o = IR_BORR:
                em.b3(72, 9, 200)
            else:
                em.b3(72, 49, 200)
            em.store(R_AX, d)
        elif o = IR_BNOTT:
            em.load(R_AX, a)
            em.b3(72, 247, 208)              // not rax
            em.canon(w)
            em.store(R_AX, d)
        elif o = IR_SHLL or o = IR_SHRR:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 131, 249)              // cmp rcx, value-bits
            em.b1(bits - sgn)
            em.jglobal(0, 131, RT_SHIFT)     // jae
            if o = IR_SHLL:
                em.b3(72, 211, 224)          // shl rax, cl
                em.canon(w)
            else:
                if sgn = 1:
                    em.b3(72, 211, 248)      // sar rax, cl
                else:
                    em.b3(72, 211, 232)      // shr rax, cl
            em.store(R_AX, d)
        elif o >= IR_CEQ and o <= IR_CGE:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 57, 200)               // cmp rax, rcx
            em.b3(15, cc_of(o, sgn), 192)    // setcc al
            em.b4(72, 15, 182, 192)          // movzx rax, al
            em.store(R_AX, d)
        elif o = IR_MAXX or o = IR_MINN:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 57, 200)               // cmp rax, rcx
            let cmov : mut i64 = 0
            if o = IR_MAXX:
                cmov ← 76 if sgn = 1 else 66     // cmovl / cmovb
            else:
                cmov ← 79 if sgn = 1 else 71     // cmovg / cmova
            em.b4(72, 15, cmov, 193)             // cmovcc rax, rcx
            em.store(R_AX, d)
        elif o = IR_SEL:
            em.load(R_R10, a)
            em.load(R_AX, b)
            em.load(R_CX, c)
            em.b3(77, 133, 210)              // test r10, r10
            em.b4(72, 15, 68, 193)           // cmovz rax, rcx
            em.store(R_AX, d)
        elif o = IR_DIVV or o = IR_MODD:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 133, 201)              // test rcx, rcx
            em.b2(15, 133)                   // jnz over the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.load(R_AX, c)
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            if sgn = 1:
                if bits = 64:
                    em.movimm(R_R10, ⁻9223372036854775807 - 1)
                    em.b3(76, 57, 208)       // cmp rax, r10
                    em.b2(15, 133)           // jne
                    let p3 : i64 = em.here()
                    em.w32(0)
                    em.b3(72, 131, 249)      // cmp rcx, ⁻1
                    em.b1(255)
                    em.jglobal(0, 132, RT_OV)    // je
                    em.patch32(p3, em.here() - (p3 + 4))
                em.b2(72, 153)               // cqo
                em.b3(72, 247, 249)          // idiv rcx
            else:
                em.b2(49, 210)               // xor edx, edx
                em.b3(72, 247, 241)          // div rcx
            if o = IR_MODD:
                em.b3(72, 137, 208)          // mov rax, rdx
            if sgn = 1 and bits ≠ 64:
                em.range_check(w)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_JMP:
            em.jlocal(⁻1, a)
        elif o = IR_JZ or o = IR_JNZ:
            em.load(R_AX, a)
            em.b3(72, 133, 192)
            em.jlocal(132 if o = IR_JZ else 133, b)
        elif o = IR_LABEL:
            em.set_label(a)
        elif o = IR_CALL:
            let argc : i64 = ir.extra[b × 1¤ptrdiff]
            if argc > 6:
                // the seventh argument onward rides the stack, pushed
                // last-first so the seventh sits at [rbp+16]
                let x : mut i64 = argc - 1
                while x >= 6:
                    em.load(R_AX, ir.extra[(b + 1 + x) × 1¤ptrdiff])
                    em.b1(80)                    // push rax
                    x ← x - 1
            let k : mut i64 = 0
            while k < (argc ⌊ 6):
                em.load(arg_reg(k), ir.extra[(b + 1 + k) × 1¤ptrdiff])
                k ← k + 1
            em.jglobal(232, ⁻1, a)
            if argc > 6:
                em.b3(72, 129, 196)
                em.w32(8 × (argc - 6))           // add rsp: the ride is over
            em.store(R_AX, d)
        elif o = IR_FADDR:
            em.raxbar()
            em.b2(72, 141)                   // lea rax, [rip+disp32]
            em.jglobal(5, ⁻1, a)
            em.store(R_AX, d)
        elif o = IR_CALLI:
            let argci : i64 = ir.extra[b × 1¤ptrdiff]
            let ki : mut i64 = 0
            while ki < argci:
                em.load(arg_reg(ki), ir.extra[(b + 1 + ki) × 1¤ptrdiff])
                ki ← ki + 1
            em.load(R_R11, a)
            em.raxbar()
            em.b3(65, 255, 211)              // call r11
            em.store(R_AX, d)
        elif o = IR_RET:
            if a ≠ ⁻1:
                em.load(R_AX, a)
            em.b1(201)
            em.b1(195)
        elif o = IR_PRINTS:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_WRITE1)
        elif o = IR_EPRINTS:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_WRITE2)
        elif o = IR_PRINTI:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTI)
        elif o = IR_PRINTU:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTU)
        elif o = IR_EXIT:
            em.load(R_DI, a)
            em.movimm(R_AX, 60)
            em.b2(15, 5)
        elif o = IR_ABORT:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_ABORT)
        elif o = IR_GLOAD:
            em.gref(R_R11, a)
            em.b3(73, 139, 3)                // mov rax, [r11]
            em.store(R_AX, d)
        elif o = IR_GSTORE:
            em.load(R_AX, b)
            em.gref(R_R11, a)
            em.b3(73, 137, 3)                // mov [r11], rax
        elif o = IR_ANEW:
            em.movimm(R_DI, a)
            em.jglobal(232, ⁻1, RT_ARRNEW)
            em.store(R_AX, d)
        elif o = IR_APUSH:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_ARRPUSH)
        elif o = IR_AIDX:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.jglobal(0, 131, RT_BOUNDS)    // jae
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.store(R_AX, d)
        elif o = IR_DENTS:
            em.jglobal(232, ⁻1, RT_DENTS)
            em.store(R_AX, d)
        elif o = IR_AREF:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.jglobal(0, 131, RT_BOUNDS)    // jae
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 141, 4, 202)           // lea rax, [rdx+rcx*8]
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_ASTO:
            em.load(R_R10, a)
            em.load(R_CX, b)
            em.b4(73, 59, 74, 8)             // cmp rcx, [r10+8]
            em.jglobal(0, 131, RT_BOUNDS)
            em.b3(73, 139, 18)               // mov rdx, [r10]
            em.load(R_AX, c)
            em.b4(72, 137, 4, 202)           // mov [rdx+rcx*8], rax
        elif o = IR_APOP:
            em.load(R_AX, a)
            em.b4(72, 139, 72, 8)            // mov rcx, [rax+8]
            em.b3(72, 133, 201)              // test rcx, rcx
            em.b2(15, 132)                   // jz to the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.b3(72, 255, 201)              // dec rcx
            em.b4(72, 137, 72, 8)            // mov [rax+8], rcx
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
