    em.b4(73, 193, 234, 18)         // shr r10, 18
    em.b3(65, 129, 202)
    em.w32(240)                     // or r10d, 0xF0
    em.b3(68, 136, 17)              // mov [rcx], r10b
    em.b3(77, 137, 226)             // mov r10, r12
    em.b4(73, 193, 234, 12)         // shr r10, 12
    em.b4(73, 131, 226, 63)         // and r10, 63
    em.b3(65, 129, 202)
    em.w32(128)                     // or r10d, 0x80
    em.b4(68, 136, 81, 1)           // mov [rcx+1], r10b
    em.b3(77, 137, 226)             // mov r10, r12
    em.b4(73, 193, 234, 6)          // shr r10, 6
    em.b4(73, 131, 226, 63)         // and r10, 63
    em.b3(65, 129, 202)
    em.w32(128)                     // or r10d, 0x80
    em.b4(68, 136, 81, 2)           // mov [rcx+2], r10b
    em.b3(77, 137, 226)             // mov r10, r12
    em.b4(73, 131, 226, 63)         // and r10, 63
    em.b3(65, 129, 202)
