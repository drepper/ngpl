                if vmap[vix × 1¤ptrdiff] = ⁻1:
                    vmap[vix × 1¤ptrdiff] ← at9
                elif vmap[vix × 1¤ptrdiff] ≠ at9:
                    self.derr(tok, "one type variable, one type; it is handed " ⧺ type_name(vmap[vix × 1¤ptrdiff]) ⧺ " and " ⧺ type_name(at9) ⧺ " at once")
                self.a.extra[(callee.params_off + 2 + j × 2) × 1¤ptrdiff] ← vmap[vix × 1¤ptrdiff]
            else:
                self.check_one_arg(tok, callee.name, j + 1, arg, pty)
