    em.b4(68, 136, 81, 3)           // mov [rcx+3], r10b
    em.movimm(R_DX, 4)
    em.jlocal(⁻1, 3)                // jmp Ldone
    em.set_label(2)                 // three bytes
    em.b3(77, 137, 226)             // mov r10, r12
    em.b4(73, 193, 234, 12)         // shr r10, 12
    em.b3(65, 129, 202)
    em.w32(224)                     // or r10d, 0xE0
    em.b3(68, 136, 17)              // mov [rcx], r10b
    em.b3(77, 137, 226)             // mov r10, r12
    em.b4(73, 193, 234, 6)          // shr r10, 6
    em.b4(73, 131, 226, 63)         // and r10, 63
