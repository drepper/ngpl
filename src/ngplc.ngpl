// ngplc — the NGPL compiler, attempt 2.
//
// Written in the bootstrap subset of NGPL and run by the Python
// interpreter; compiles the core-1 subset described in DESIGN.md to
// static x86-64 Linux ELF executables that speak only to the kernel.
//
// Usage (through the bootstrap interpreter):
//     python -m interp src/ngplc.ngpl -- program.ngpl [-o out]
//                      [--dump-tokens] [--dump-ast] [--diag=json]
//
// The pipeline is a chain of pure functions over flat arrays:
//     bytes → lex → Toks → parse → Ast → check → lower → Ir
//           → emit → code bytes → elf → a.out (or the -o name)
//
// Control flow policy (CLAUDE.md): decisions are data.  The lexer runs
// on a byte-class table and two glyph hashes rather than a branch
// tree; the code generator materializes comparisons (setcc), selects
// with conditional moves where both sides are safe to read, and turns
// dense dispatch into jump tables.  Branches that remain are cold
// paths (aborts) or semantically required (short-circuit with an
// effectful right side).

// ===========================================================================
// Token kinds
// ===========================================================================

let TK_EOF : i64 = 0
let TK_NL : i64 = 1
let TK_INDENT : i64 = 2
let TK_DEDENT : i64 = 3
let TK_IDENT : i64 = 10
let TK_INT : i64 = 11
let TK_STR : i64 = 12
// keywords core-1 parses
let TK_FN : i64 = 20
let TK_LET : i64 = 21
let TK_MUT : i64 = 22
let TK_IF : i64 = 23
let TK_ELIF : i64 = 24
let TK_ELSE : i64 = 25
let TK_WHILE : i64 = 26
let TK_FOREACH : i64 = 27
let TK_RETURN : i64 = 28
let TK_BREAK : i64 = 29
let TK_CONTINUE : i64 = 30
let TK_TRUE : i64 = 31
let TK_FALSE : i64 = 32
let TK_AND : i64 = 33
let TK_OR : i64 = 34
let TK_NOT : i64 = 35
let TK_STRUCT : i64 = 36
let TK_IMPL : i64 = 37
// punctuation and operators
let TK_LPAR : i64 = 40
let TK_RPAR : i64 = 41
let TK_COLON : i64 = 42
let TK_COMMA : i64 = 43
let TK_DOT : i64 = 44
let TK_ARROW : i64 = 45      // → or ->
let TK_ASSIGN : i64 = 46     // ← or <-
let TK_DEFINE : i64 = 47     // :=
let TK_ELLIPSIS : i64 = 48   // …
let TK_AT : i64 = 49         // @
let TK_PLUS : i64 = 50
let TK_MINUS : i64 = 51      // binary -
let TK_NEG : i64 = 52        // unary ⁻
let TK_MULT : i64 = 53       // ×
let TK_DIVIDE : i64 = 54     // ÷
let TK_MOD : i64 = 55
let TK_EQ : i64 = 56         // =
let TK_NE : i64 = 57         // ≠
let TK_LT : i64 = 58
let TK_GT : i64 = 59
let TK_LE : i64 = 60
let TK_GE : i64 = 61
let TK_SHL : i64 = 62        // « or <<
let TK_SHR : i64 = 63        // » or >>
let TK_BAND : i64 = 64       // & (also the borrow marker)
let TK_BOR : i64 = 65
let TK_BXOR : i64 = 66
let TK_BNOT : i64 = 67       // ~
let TK_LAND : i64 = 68       // ∧
let TK_LOR : i64 = 69        // ∨
let TK_LNOT : i64 = 70       // ¬
let TK_MAX : i64 = 71        // ⌈
let TK_MIN : i64 = 72        // ⌊
let TK_COALESCE : i64 = 73   // ??
let TK_LBRACK : i64 = 74
let TK_RBRACK : i64 = 75
let TK_CURRENCY : i64 = 76   // ¤
let TK_HASH : i64 = 77       // #
let TK_CONCAT : i64 = 78     // ⧺
let TK_LBRACE : i64 = 79
let TK_RBRACE : i64 = 80
let TK_QMARK : i64 = 81      // ? as a type's suffix
let TK_EXISTS : i64 = 82     // ∃
let TK_EMPTY : i64 = 83      // ∅
let TK_LHASH : i64 = 84      // ⸨
let TK_RHASH : i64 = 85      // ⸩
let TK_ELEM : i64 = 86       // ∊
let TK_IOTA : i64 = 87       // ⍳
let TK_SATADD : i64 = 88     // ⊞
let TK_SATSUB : i64 = 89     // ⊟
let TK_SATMUL : i64 = 90     // ⊠
let TK_LXOR : i64 = 91       // ⊕
let TK_LNAND : i64 = 92      // ⊼
let TK_LNOR : i64 = 93       // ⊽
let TK_RESHAPE : i64 = 94    // ⍴
let TK_MATCH : i64 = 38
let TK_RESERVED : i64 = 99   // a word the bootstrap reserves and core-1 does not use
let TK_LAMBDA : i64 = 100    // λ
let TK_BANG : i64 = 101      // ! -- the expected suffix on a type
let TK_SEMI : i64 = 102      // ; -- between statements in a brace block
let TK_TYPE : i64 = 103      // type: a name standing for a type
let TK_ENUM : i64 = 104      // enum
let TK_UNIT : i64 = 105      // unit: a measure the file gives a name

// The keyword table: one hash probe replaces a comparison ladder.  A
// word the bootstrap language reserves but core-1 gives no meaning is
// mapped to TK_RESERVED, so it is refused wherever a name is expected
// rather than quietly accepted -- the strict-subset rule.
let KEYWORDS : std.hash(str, i64) = (⸨
    "fn": 20, "let": 21, "mut": 22, "if": 23, "elif": 24, "else": 25,
    "while": 26, "foreach": 27, "return": 28, "break": 29, "continue": 30,
    "true": 31, "false": 32, "and": 33, "or": 34, "not": 35,
    "struct": 36, "impl": 37, "match": 38,
    "opt": 99, "is": 99, "import": 99, "some": 99,
    "start": 99, "test": 99, "expect": 99, "wrap": 99, "enum": 104,
    "flag": 99, "replaceable": 99, "catch": 99, "comptime": 99,
    "type": 103, "unit": 105, "impure": 99, "enumerate": 99,
    "macro": 99⸩)

// The multi-byte glyphs, keyed by their UTF-8 bytes packed into one
// number: b0×256+b1 for two-byte glyphs, b0×65536+b1×256+b2 for three.
// One hash probe per glyph instead of a branch tree over byte values.
let GLYPHS2 : std.hash(i64, i64) = (⸨
    49835: 62,      // « shl
    49851: 63,      // » shr
    49836: 70,      // ¬
    49828: 76,      // ¤
    50071: 53,      // ×
    50103: 54,      // ÷
    52923: 100⸩)    // λ

let GLYPHS3 : std.hash(i64, i64) = (⸨
    14847411: 87,   // ⍳
    14847412: 94,   // ⍴
    14846622: 88,   // ⊞
    14846623: 89,   // ⊟
    14846624: 90,   // ⊠
    14846613: 91,   // ⊕
    14846652: 92,   // ⊼
    14846653: 93,   // ⊽
    14845584: 46,   // ←
    14845586: 45,   // →
    14844347: 52,   // ⁻
    14844070: 48,   // …
    14846368: 57,   // ≠
    14846119: 68,   // ∧
    14846120: 69,   // ∨
    14847112: 71,   // ⌈
    14847114: 72,   // ⌊
    14854074: 78,   // ⧺
    14846083: 82,   // ∃
    14846085: 83,   // ∅
    14858408: 84,   // ⸨
    14858409: 85,   // ⸩
    14846090: 86⸩)  // ∊

// ===========================================================================
// Small helpers
// ===========================================================================

@post(r: #r > 0)
fn i64_str(n : i64) → str:
    if n = 0: return "0"
    let neg : bool = n < 0
    // work below zero, where every i64 has a home; the remainders come
    // out non-positive and are flipped digit by digit
    let v : mut i64 = n if neg else @wrap(0 - n)
    let s : mut str = ""
    while v ≠ 0:
        let digit : i64 = @wrap(0 - (v % 10 ?? 0))
        s ← (48 + digit).chr() ⧺ s
        v ← (v ÷ 10 ?? 0)
    ("-" ⧺ s) if neg else s

// The text of a byte run, for identifiers, keywords and messages.
@pre(off >= 0 and n >= 0)
fn run_str(src : byte[], off : i64, n : i64) → str:
    let s : mut str = ""
    let i : mut i64 = 0
    while i < n:
        let b : i64 = src[(off + i) × 1¤byte]
        s ← s ⧺ b.chr()
        i ← i + 1
    s

// ===========================================================================
// Types: one integer encodes what a value is
// ===========================================================================
//
//   0                unit (∅ -- a function that answers nothing)
//   2                bool
//   3                str
//   8                an untyped integer literal, not yet committed
//   16 + s + 2b + 256u   an integer type: s = 1 when signed, b = bits,
//                        u = 0 none, 1 ¤ptrdiff, 2 ¤byte
//   1024 + i         the struct whose definition came i-th
//   2048 + base      an optional holding a base-typed value, or ∅
//   4096 + elem      an array of elem-typed things (integers, structs)
//   8192 + 2048k + v a hash from key-palette entry k to v-typed values
//
// A parameter's type may add 262144×r: r = 1 for a & borrow, 2 for &mut.

let TY_UNIT : i64 = 0
let TY_BOOL : i64 = 2
let TY_STR : i64 = 3
let TY_CHAR : i64 = 4       // one Unicode scalar value, UCS-4 in a slot
let TY_U32 : i64 = 20       // what .ord() answers
let TY_FILE : i64 = 5       // an open file, its descriptor inside
let TY_ALLOC : i64 = 6      // std.arena.allocator(): a token, nothing more
let TY_DIR : i64 = 7        // std.fs.cwd(): a directory, a token likewise
let TY_ENTRY : i64 = 10     // one directory entry: a name and a kind
// 11 was std.filetype, which is an enumeration now and needs no
// type code of its own

// std.filetype is an enumeration like any other, and the first one
// every file holds.  It is reached through std, never by its bare
// name, so the two lookups that read a written name skip past it.
let EI_FILETYPE : i64 = 0
let NBUILTIN_ENUMS : i64 = 1

fn builtin_enum_names() → str[]:
    ["filetype"]

fn builtin_enum_widths() → i64[]:
    [TY_U32]

// the S_IF* constants from <sys/stat.h>, as the interpreter holds
// them; the kernel's d_type is this value shifted right twelve
fn builtin_enum_members() → str[]:
    ["unknown", "fifo", "chr", "dir", "blk", "reg", "lnk", "sock"]

fn builtin_enum_values() → i64[]:
    [0, 4096, 8192, 16384, 24576, 32768, 40960, 49152]
let TY_IOVEC : i64 = 12     // one run of bytes waiting to be written: a base and a length
let TY_UNT : i64 = 8
let TY_EMPTY : i64 = 9       // a bare ∅, not yet settled on its optional
let TY_U64 : i64 = 22        // 16 + 0 + 2×3, the widest unsigned
let TY_I64 : i64 = 23        // 16 + 1 + 2×3, the widest signed
let TY_U8 : i64 = 16         // 16 + 0 + 2×0, the narrowest unsigned
let TY_U16 : i64 = 18        // 16 + 0 + 2×1

let UNIT_NONE : i64 = 0
let UNIT_PTRDIFF : i64 = 1
let UNIT_BYTE : i64 = 2

// The measures a file starts with, in the order their indexes run.  A
// name is what the program writes; the spelling beside it is what a
// printed value carries, and is the interpreter's for that measure.
// A unit the program defines is added after these.
fn unit_names() → str[]:
    ["", "ptrdiff", "byte", "meter", "second", "kilogram", "count",
     "distance", "kilometer", "centimeter", "millimeter", "millisecond",
     "microsecond", "minute", "hour", "gram", "milligram", "ampere",
     "kelvin", "mole", "candela", "kilobyte", "kibibyte", "megabyte",
     "mebibyte", "gigabyte", "gibibyte"]

fn unit_marks() → str[]:
    ["", "ptrdiff", "B", "m", "s", "kg", "count",
     "distance", "km", "cm", "mm", "ms",
     "μs", "min", "h", "g", "mg", "A",
     "K", "mol", "cd", "kB", "KiB", "MB",
     "MiB", "GB", "GiB"]

// core-2 holds four widths, so two bits say which; the five bits that
// spelling a width out used to take now say which measure the value
// carries, and a measure is an index into the file's list of them.
@pre(bits = 8 or bits = 16 or bits = 32 or bits = 64)
fn width_index(bits : i64) → i64:
    0 if bits = 8 else (1 if bits = 16 else (2 if bits = 32 else 3))

@pre(sgn = 0 or sgn = 1)
@pre(bits = 8 or bits = 16 or bits = 32 or bits = 64)
@pre(u >= 0 and u < 125)
fn mk_ity(sgn : i64, bits : i64, u : i64) → i64:
    16 + sgn + 2 × width_index(bits) + 8 × u

// ty_is_int and the accessors below run for every node the checker
// touches; the encoding invariants are enforced at mk_ity and the
// other constructors instead of per read -- the recorded exception
// the contract policy allows for measured hot paths.
fn ty_is_int(t : i64) → bool:
    t >= 16 and t < 1024

fn ty_is_struct(t : i64) → bool:
    t >= 1024 and t < 1792

// enums: 1792 + the file's index for the enum.  They sit beside the
// structs and below 2048 so an optional of one is its base and 2048,
// as an optional of anything else below there is.
fn ty_is_enum(t : i64) → bool:
    t >= 1792 and t < 2048

@pre(eidx >= 0 and eidx < 256)
@post(r: ty_is_enum(r))
fn mk_ety(eidx : i64) → i64:
    1792 + eidx

@pre(ty_is_enum(t))
fn ty_eidx(t : i64) → i64:
    t - 1792

// An optional is its base and 2048, which holds for a base below that:
// the scalars and the structs.  A tuple's code is far above it, so an
// optional tuple gets a band of its own past the type variables, and
// the three words below are the only ones that need to know.
fn ty_is_opt(t : i64) → bool:
    t >= 2048 and t < 4096 or (t >= 198176 and t < 202272)

fn mk_oty(base : i64) → i64:
    198176 + ty_tidx(base) if ty_is_tup(base) else 2048 + base

fn ty_opt_base(t : i64) → i64:
    mk_tty(t - 198176) if t >= 198176 else t - 2048

@pre(sidx >= 0 and sidx < 768)
@post(r: ty_is_struct(r))
fn mk_sty(sidx : i64) → i64:
    1024 + sidx

fn ty_sidx(t : i64) → i64:
    t - 1024

fn ty_sgn(t : i64) → i64:
    (t - 16) & 1

fn ty_bits(t : i64) → i64:
    8 « (((t - 16) » 1) & 3)

fn ty_unit(t : i64) → i64:
    (t - 16) » 3

fn ty_drop_unit(t : i64) → i64:
    t - 8 × ty_unit(t) if ty_is_int(t) else t

fn ty_with_unit(t : i64, u : i64) → i64:
    ty_drop_unit(t) + 8 × u

// arrays hold plain integers or structs, so the band closes below the
// hashes' 8192; keeping the two disjoint is what lets every ty_is_*
// answer alone, in any order
fn ty_is_arr(t : i64) → bool:
    t >= 4096 and t < 8192 or t >= 32768 and t < 65536

fn ty_elem(t : i64) → i64:
    t - 7168 if t >= 7168 and t < 8192 else t - 4096

@pre(elem >= 0 and elem < 4096)
fn mk_aty(elem : i64) → i64:
    4096 + elem

fn ty_is_hash(t : i64) → bool:
    t >= 8192 and t < 26624

// the key palette: 0..7 the integer family (sgn + width), 8 str
@pre(t = TY_STR or (ty_is_int(t) and ty_unit(t) = 0))
@post(r: r >= 0 and r <= 8)
fn hkey_index(t : i64) → i64:
    if t = TY_STR: return 8
    let b : i64 = ty_bits(t)
    ty_sgn(t) × 4 + (0 if b = 8 else (1 if b = 16 else (2 if b = 32 else 3)))

@pre(ki >= 0 and ki <= 8)
fn hkey_code(ki : i64) → i64:
    if ki = 8: return TY_STR
    mk_ity((ki ÷ 4) ?? 0, 8 « (ki & 3), 0)

@pre(v >= 0 and v < 2048)
@post(r: ty_is_hash(r))
fn mk_hty(k : i64, v : i64) → i64:
    8192 + hkey_index(k) × 2048 + v

fn ty_hkey(t : i64) → i64:
    hkey_code(((t - 8192) ÷ 2048) ?? 0)

fn ty_hval(t : i64) → i64:
    (t - 8192) % 2048 ?? 0

// tuples: 26624 + tidx into the Ast's interned shape table; the band
// sits between the hashes' end and the ref packing's 65536
fn ty_is_tup(t : i64) → bool:
    t >= 26624 and t < 30720

// iterators: 30720 + an interned element type; born of iterate(),
// stepped by next(), written down by no type syntax at all
fn ty_is_iter(t : i64) → bool:
    t >= 30720 and t < 32768

@pre(ty_is_iter(t))
fn ty_iidx(t : i64) → i64:
    t - 30720

// sized arrays: 32768 + fidx into the Ast's shape table (element and
// size); the band fills what is left below the ref packing
fn ty_is_farr(t : i64) → bool:
    t >= 32768 and t < 65536

@pre(ty_is_farr(t))
fn ty_fidx(t : i64) → i64:
    t - 32768

@pre(fidx >= 0 and fidx < 32768)
@post(r: ty_is_farr(r))
fn mk_fty(fidx : i64) → i64:
    32768 + fidx

// matrices: 65536 + midx into the Ast's matrix table (element and
// the two extents, ⁻1 where the type leaves one open); the band sits
// between the sized arrays' end and the ref packing's 262144
fn ty_is_mat(t : i64) → bool:
    t >= 65536 and t < 131072

@pre(ty_is_mat(t))
fn ty_midx(t : i64) → i64:
    t - 65536

@pre(midx >= 0 and midx < 65536)
@post(r: ty_is_mat(r))
fn mk_mty(midx : i64) → i64:
    65536 + midx

// ranges: 131072 + the element's own code, no table needed; a range
// is three numbers and a direction, not a container
fn ty_is_rg(t : i64) → bool:
    t >= 131072 and t < 132096

@pre(ty_is_rg(t))
fn ty_rgelem(t : i64) → i64:
    t - 131072

@pre(elem >= 16 and elem < 1024)
@post(r: ty_is_rg(r))
fn mk_rgty(elem : i64) → i64:
    131072 + elem

// lambdas: 132096 + lidx into the Ast's signature table; captures are
// the value's, not the type's
fn ty_is_lam(t : i64) → bool:
    t >= 132096 and t < 194048

// type variables: 194048 + the file-wide index of the spelling; they
// live in signatures and are gone by the time a body is checked
fn ty_is_var(t : i64) → bool:
    t >= 194048 and t < 194080

@pre(ty_is_lam(t))
fn ty_lidx(t : i64) → i64:
    t - 132096

@pre(lidx >= 0 and lidx < 61952)
@post(r: ty_is_lam(r))
fn mk_lty(lidx : i64) → i64:
    132096 + lidx

// a matrix's rows: arrays whose length is the matrix's to keep, so
// they read as any array does and refuse to be resized; the band
// borrows the top of the dynamic arrays' own
fn ty_is_row(t : i64) → bool:
    t >= 7168 and t < 8192

@pre(elem >= 0 and elem < 1024)
@post(r: ty_is_row(r))
fn mk_rty(elem : i64) → i64:
    7168 + elem

@pre(ty_is_tup(t))
fn ty_tidx(t : i64) → i64:
    t - 26624

@pre(tidx >= 0 and tidx < 4096)
@post(r: ty_is_tup(r))
fn mk_tty(tidx : i64) → i64:
    26624 + tidx

fn ty_ref_kind(t : i64) → i64:
    t » 18

fn ty_strip_ref(t : i64) → i64:
    t & 262143

// a function travels as a value when its answer is a plain scalar,
// or an optional of one -- absence rides the box either way
fn fnval_ret_ok(r : i64) → bool:
    let b : i64 = ty_opt_base(r) if ty_is_opt(r) else r
    (ty_is_int(b) and ty_unit(b) = 0) or b = TY_BOOL or b = TY_CHAR or b = TY_STR

// whether a name is the bootstrap's to keep: i or u and a nonzero
// width, however written -- the bootstrap claims them all
fn names_int_type(name : str) → bool:
    let cs := name.chars()
    if #cs < 2 or (cs[0] ≠ 'i' and cs[0] ≠ 'u'):
        return false
    let nz : mut bool = false
    foreach k := 1…#cs - 1:
        if cs[k] < '0' or cs[k] > '9':
            return false
        nz ← nz ∨ cs[k] ≠ '0'
    nz

// the name of a type, as a diagnostic writes it
@post(r: #r > 0)
fn type_name(t0 : i64) → str:
    let r : i64 = ty_ref_kind(t0)
    let t : i64 = ty_strip_ref(t0)
    let prefix : str = "" if r = 0 else ("&" if r = 1 else "&mut ")
    if t = TY_UNIT: return "∅"
    if t = TY_BOOL: return prefix ⧺ "bool"
    if t = TY_STR: return prefix ⧺ "str"
    if t = TY_CHAR: return prefix ⧺ "char"
    if t = TY_FILE: return prefix ⧺ "std.fs.File"
    if t = TY_ALLOC: return prefix ⧺ "std.arena.Allocator"
    if t = TY_DIR: return prefix ⧺ "std.fs.Dir"
    if t = TY_ENTRY: return prefix ⧺ "std.fs.Entry"
    if t = TY_IOVEC: return prefix ⧺ "std.iovec"
    if ty_is_mat(t): return prefix ⧺ "a matrix"
    if ty_is_rg(t): return prefix ⧺ "range"
    if ty_is_lam(t): return prefix ⧺ "a function"
    if ty_is_var(t): return prefix ⧺ "a type variable"
    if t = TY_UNT: return "untyped integer"
    if t = TY_EMPTY: return "∅"
    if ty_is_struct(t): return prefix ⧺ "struct #" ⧺ i64_str(ty_sidx(t))
    if ty_is_enum(t):
        // a builtin enum has a name every file knows; a file's own is
        // named by its place, since this function has no file to ask
        let bn := builtin_enum_names()
        return prefix ⧺ (bn[ty_eidx(t) × 1¤ptrdiff] if ty_eidx(t) < @dropunit(#bn) else "enum #" ⧺ i64_str(ty_eidx(t)))
    if ty_is_tup(t): return prefix ⧺ "a tuple"
    if ty_is_opt(t): return prefix ⧺ type_name(ty_opt_base(t)) ⧺ "?"
    if ty_is_arr(t) and not ty_is_farr(t): return prefix ⧺ type_name(ty_elem(t)) ⧺ "[]"
    if ty_is_hash(t): return prefix ⧺ "std.hash(" ⧺ type_name(ty_hkey(t)) ⧺ ", " ⧺ type_name(ty_hval(t)) ⧺ ")"
    if ty_is_tup(t): return prefix ⧺ "tuple #" ⧺ i64_str(ty_tidx(t))
    if ty_is_farr(t): return prefix ⧺ "sized array #" ⧺ i64_str(ty_fidx(t))
    if ty_is_iter(t): return prefix ⧺ "iterator #" ⧺ i64_str(ty_iidx(t))
    let base : str = ("i" if ty_sgn(t) = 1 else "u") ⧺ i64_str(ty_bits(t))
    let u : i64 = ty_unit(t)
    if u = 0:
        return base
    // the marks the language ships with are spelled; a measure the
    // file defined is named by its index, since this function has no
    // file to ask
    let marks := unit_marks()
    base ⧺ " ¤" ⧺ (marks[u × 1¤ptrdiff] if u < @dropunit(#marks) else "unit#" ⧺ i64_str(u))

// ===========================================================================
// Diagnostics
// ===========================================================================

struct Diag:
    line : i64
    col : i64
    msg : str

// the text of source line n, decoded, for the excerpt under a diagnostic
@pre(want >= 1)
fn line_str(src : byte[], want : i64) → str:
    let n : i64 = @dropunit(#src)
    let line : mut i64 = 1
    let i : mut i64 = 0
    let out : mut str = ""
    while i < n:
        let b : i64 = src[i × 1¤byte]
        if b = 10:
            if line = want:
                return out
            line ← line + 1
            i ← i + 1
            out ← ""
        elif line < want:
            i ← i + 1
        elif b < 128:
            out ← out ⧺ b.chr()
            i ← i + 1
        elif b < 224:
            let b1 : i64 = src[(i + 1) × 1¤byte] if i + 1 < n else 0
            out ← out ⧺ ((b - 192) × 64 + (b1 & 63)).chr()
            i ← i + 2
        elif b < 240:
            let b1 : i64 = src[(i + 1) × 1¤byte] if i + 1 < n else 0
            let b2 : i64 = src[(i + 2) × 1¤byte] if i + 2 < n else 0
            out ← out ⧺ ((b - 224) × 4096 + (b1 & 63) × 64 + (b2 & 63)).chr()
            i ← i + 3
        else:
            let b1 : i64 = src[(i + 1) × 1¤byte] if i + 1 < n else 0
            let b2 : i64 = src[(i + 2) × 1¤byte] if i + 2 < n else 0
            let b3 : i64 = src[(i + 3) × 1¤byte] if i + 3 < n else 0
            out ← out ⧺ ((b - 240) × 262144 + (b1 & 63) × 4096 + (b2 & 63) × 64 + (b3 & 63)).chr()
            i ← i + 4
    out

// ===========================================================================
// Lexing: a byte-class table drives the scan
// ===========================================================================
//
// Every byte is classified once through a 256-entry table; the class
// either is the token (entries ≥ 100 carry the token kind directly) or
// names the one handler that reads the run.  Multi-byte glyphs go
// through the GLYPHS hashes.  This is the scalar, table-driven shape of
// the mask-pipeline design DESIGN.md describes: the classes here are
// the classes a SIMD or GPU lexer computes 64 bytes at a time.

let CL_INVALID : i64 = 0
let CL_WS : i64 = 1
let CL_NL : i64 = 2
let CL_DIGIT : i64 = 3
let CL_IDENT : i64 = 4
let CL_QUOTE : i64 = 5
let CL_SLASH : i64 = 6
let CL_MB2 : i64 = 7         // two-byte glyph lead (C2, C3, CE)
let CL_MB3 : i64 = 8         // three-byte glyph lead (E2)
let CL_TAB : i64 = 9
let CL_COLON : i64 = 10      // : or :=
let CL_LT : i64 = 11         // < <= << <-
let CL_GT : i64 = 12         // > >= >>
let CL_DASH : i64 = 13       // - or ->
let CL_QMARK : i64 = 14      // ??
let CL_APOS : i64 = 15       // a character literal

// The class table, built once per run.  An entry of kind+100 is a
// complete single-byte token.
@post(t: #t = 256)
fn mkcls() → i64[]:
    let t : mut i64[] = []
    foreach _ := 0…255:
        t.push(0)
    t[32] ← CL_WS
    t[10] ← CL_NL
    t[9] ← CL_TAB
    foreach d := 48…57:
        t[d × 1¤ptrdiff] ← CL_DIGIT
    foreach c := 97…122:
        t[c × 1¤ptrdiff] ← CL_IDENT
    foreach c := 65…90:
        t[c × 1¤ptrdiff] ← CL_IDENT
    t[95] ← CL_IDENT
    t[34] ← CL_QUOTE
    t[47] ← CL_SLASH
    t[194] ← CL_MB2
    t[195] ← CL_MB2
    t[206] ← CL_MB2
    t[33] ← 100 + TK_BANG
    t[59] ← 100 + TK_SEMI
    t[226] ← CL_MB3
    t[58] ← CL_COLON
    t[60] ← CL_LT
    t[62] ← CL_GT
    t[45] ← CL_DASH
    t[63] ← CL_QMARK
    t[39] ← CL_APOS
    t[40] ← 100 + TK_LPAR
    t[41] ← 100 + TK_RPAR
    t[44] ← 100 + TK_COMMA
    t[46] ← 100 + TK_DOT
    t[64] ← 100 + TK_AT
    t[43] ← 100 + TK_PLUS
    t[37] ← 100 + TK_MOD
    t[61] ← 100 + TK_EQ
    t[126] ← 100 + TK_BNOT
    t[38] ← 100 + TK_BAND
    t[124] ← 100 + TK_BOR
    t[94] ← 100 + TK_BXOR
    t[91] ← 100 + TK_LBRACK
    t[93] ← 100 + TK_RBRACK
    t[35] ← 100 + TK_HASH
    t[123] ← 100 + TK_LBRACE
    t[125] ← 100 + TK_RBRACE
    t

fn is_digit(b : i64) → bool:
    b >= 48 and b <= 57

@post(r: r >= ⁻1 and r <= 15)
fn hex_val(b : i64) → i64:
    if is_digit(b): return b - 48
    if b >= 97 and b <= 102: return b - 87
    if b >= 65 and b <= 70: return b - 55
    ⁻1

struct Toks:
    kind : i64[]
    off : i64[]
    len : i64[]
    line : i64[]
    col : i64[]
    val : i64[]      // value of TK_INT, string table index of TK_STR
    big : i64[]      // 1 when a TK_INT is in [2^63, 2^64), stored wrapped
    strs : str[]     // string literal table
    diags : Diag[]

struct Lexer:
    src : byte[]
    n : i64
    cls : i64[]
    pos : i64
    line : i64
    col : i64
    parens : i64
    kind : i64[]
    off : i64[]
    len : i64[]
    tline : i64[]
    tcol : i64[]
    val : i64[]
    big : i64[]
    strs : str[]
    indents : i64[]
    diags : Diag[]

impl Lexer:
    fn peek(&self, ahead : i64) → i64:
        if self.pos + ahead >= self.n: return ⁻1
        self.src[(self.pos + ahead) × 1¤byte]

    fn emit(&mut self, k : i64, o : i64, l : i64, c : i64, v : i64, b : i64):
        self.kind.push(k)
        self.off.push(o)
        self.len.push(l)
        self.tline.push(self.line)
        self.tcol.push(c)
        self.val.push(v)
        self.big.push(b)

    fn err(&mut self, m : str):
        self.diags.push(Diag{line: self.line, col: self.col, msg: m})
        self.pos ← self.n

    // one ASCII byte
    fn adv(&mut self):
        self.pos ← self.pos + 1
        self.col ← self.col + 1

    // a whole glyph of n bytes counts one column: columns are
    // characters, as the interpreter reports them
    fn advg(&mut self, n : i64):
        self.pos ← self.pos + n
        self.col ← self.col + 1

    fn skip_gaps(&mut self) → bool:
        while true:
            let b : i64 = self.peek(0)
            if b = ⁻1 or b = 10:
                return false
            let c : i64 = self.cls[b × 1¤ptrdiff]
            if c = CL_WS:
                self.adv()
            elif c = CL_TAB:
                self.err("tab in indentation or code; ngplc reads spaces only")
                return false
            elif c = CL_SLASH and self.peek(1) = 47:
                while self.peek(0) ≠ 10 and self.peek(0) ≠ ⁻1:
                    self.pos ← self.pos + 1
            elif c = CL_SLASH and self.peek(1) = 42:
                self.adv()
                self.adv()
                while true:
                    let d : i64 = self.peek(0)
                    if d = ⁻1:
                        self.err("unterminated block comment")
                        return false
                    if d = 42 and self.peek(1) = 47:
                        self.adv()
                        self.adv()
                        break
                    if d = 10:
                        self.pos ← self.pos + 1
                        self.line ← self.line + 1
                        self.col ← 1
                    else:
                        // any byte, including inside a multi-byte
                        // character; the column counts lead bytes only
                        self.pos ← self.pos + 1
                        self.col ← self.col + (0 if (d & 192) = 128 else 1)
            else:
                return true
        false

    fn handle_indent(&mut self):
        let width : i64 = self.col - 1
        let top : i64 = self.indents[#self.indents - 1]
        if width > top:
            self.indents.push(width)
            self.emit(TK_INDENT, self.pos, 0, self.col, 0, 0)
        else:
            while width < self.indents[#self.indents - 1]:
                _ ← self.indents.pop() ?? 0
                self.emit(TK_DEDENT, self.pos, 0, self.col, 0, 0)
            if width ≠ self.indents[#self.indents - 1]:
                self.err("indentation does not match any enclosing block")

    // whether appending decimal digit d to the wrapped value v walks
    // past 2^64-1, v being read through the unsigned lens
    fn too_big_dec(&self, v : i64, d : i64) → bool:
        if v < 0:
            // already ≥ 2^63; ×10 always overflows
            return true
        let lim : i64 = 1844674407370955161
        v > lim or (v = lim and d > 5)

    fn read_number(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        let v : mut i64 = 0
        let big : mut i64 = 0
        if self.peek(0) = 48 and (self.peek(1) = 120 or self.peek(1) = 88):
            self.adv()
            self.adv()
            if hex_val(self.peek(0)) = ⁻1:
                self.err("hexadecimal literal without digits")
                return
            // A u64 literal past i64 is meant to run negative: the
            // bit pattern is the value, and the sign is how the reader
            // below learns the literal is a big one.  This is the
            // wrapping the annotation is for.
            let digits : mut i64 = 0
            while hex_val(self.peek(0)) ≠ ⁻1:
                digits ← digits + 1
                if digits > 16:
                    self.err("integer literal does not fit u64, the widest core-1 has")
                    return
                v ← @wrap(v × 16 + hex_val(self.peek(0)))
                self.adv()
            if v < 0:
                big ← 1
        else:
            // …and the same for a decimal one
            while is_digit(self.peek(0)):
                let d : i64 = self.peek(0) - 48
                if self.too_big_dec(v, d):
                    self.err("integer literal does not fit u64, the widest core-1 has")
                    return
                v ← @wrap(v × 10 + d)
                self.adv()
            if v < 0:
                big ← 1
        let nb : i64 = self.peek(0)
        let st : mut i64 = ⁻1
        if nb ≠ ⁻1 and self.cls[nb × 1¤ptrdiff] = CL_IDENT:
            // i8…i64, u8…u64: the suffix says the literal's type, and
            // it rides in the big field as big + 2 × the type's code
            let sfx : mut str = ""
            while self.peek(0) ≠ ⁻1 and (self.cls[self.peek(0) × 1¤ptrdiff] = CL_IDENT or is_digit(self.peek(0))):
                sfx ← sfx ⧺ (self.peek(0)).chr()
                self.adv()
            st ← TYNAMES[sfx] ?? ⁻1
            if st = ⁻1 or not ty_is_int(st):
                self.err("'" ⧺ sfx ⧺ "' is not a width; a literal's suffix is i8…i64 or u8…u64")
                return
        if self.peek(0) = 194 and self.peek(1) = 164:
            // 1¤ptrdiff, 0¤byte: the literal states its measure, and
            // an unstated width settles on i64
            self.adv()
            self.adv()
            let usfx : mut str = ""
            while self.peek(0) ≠ ⁻1 and self.cls[self.peek(0) × 1¤ptrdiff] = CL_IDENT:
                usfx ← usfx ⧺ (self.peek(0)).chr()
                self.adv()
            // the lexer runs before any 'unit' definition is read, so
            // it knows the measures the language ships with and leaves
            // the rest to the parser
            let names := unit_names()
            let u : mut i64 = ⁻1
            foreach i := 1…#names - 1:
                if names[i] = usfx:
                    u ← @dropunit(i)
            if u = ⁻1:
                self.err("'¤" ⧺ usfx ⧺ "' is no measure the language ships with; a literal takes one of those")
                return
            st ← ty_with_unit(st if st ≠ ⁻1 else TY_I64, u)
        if st ≠ ⁻1:
            self.emit(TK_INT, spos, self.pos - spos, scol, v, big + st × 2)
            return
        self.emit(TK_INT, spos, self.pos - spos, scol, v, big)

    // 'a', 'λ', '\n', '\u{1F389}': one character between apostrophes.
    // The token is a TK_INT whose big field carries 2 × TY_CHAR, the
    // same closed-type ride a width suffix takes.
    fn read_char(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        self.adv()
        let b : i64 = self.peek(0)
        let code : mut i64 = 0
        if b = ⁻1 or b = 10:
            self.err("a character literal ends on the line it starts")
            return
        if b = 39:
            self.err("a character literal holds one character, and this one holds none; a string of no characters is written \"\"")
            return
        if b = 92:
            let e : i64 = self.peek(1)
            if e = 117:
                self.adv()
                self.adv()
                if self.peek(0) ≠ 123:
                    self.err("\\u opens its number with '{'")
                    return
                self.adv()
                let digits : mut i64 = 0
                while hex_val(self.peek(0)) ≠ ⁻1:
                    code ← code × 16 + hex_val(self.peek(0))
                    digits ← digits + 1
                    if digits > 6:
                        self.err("a code point has at most six hex digits")
                        return
                    self.adv()
                if digits = 0 or self.peek(0) ≠ 125:
                    self.err("\\u{…} holds hex digits up to '}'")
                    return
                self.adv()
            else:
                if e = 110: code ← 10
                elif e = 116: code ← 9
                elif e = 114: code ← 13
                elif e = 92: code ← 92
                elif e = 39: code ← 39
                elif e = 34: code ← 34
                else:
                    self.err("unknown escape in character literal")
                    return
                self.adv()
                self.adv()
        elif b < 128:
            code ← b
            self.adv()
        else:
            // one UTF-8 character, sized by its lead byte
            let extra : mut i64 = 0
            if b >= 240:
                code ← b & 7
                extra ← 3
            elif b >= 224:
                code ← b & 15
                extra ← 2
            elif b >= 194:
                code ← b & 31
                extra ← 1
            else:
                self.err("this byte begins no character")
                return
            self.adv()
            while extra > 0:
                let cb : i64 = self.peek(0)
                if cb < 128 or cb >= 192:
                    self.err("the character's encoding breaks off")
                    return
                code ← code × 64 + (cb & 63)
                self.adv()
                extra ← extra - 1
        if self.peek(0) ≠ 39:
            self.err("a character literal holds one character; ' closes it, and a string is written with double quotes")
            return
        self.adv()
        if code > 1114111:
            self.err("character literal: " ⧺ i64_str(code) ⧺ " is past the last code point, 0x10FFFF")
            return
        if code >= 55296 and code <= 57343:
            self.err("character literal: " ⧺ i64_str(code) ⧺ " is a surrogate, which encodes half of a character in UTF-16 rather than being one")
            return
        self.emit(TK_INT, spos, self.pos - spos, scol, code, TY_CHAR × 2)

    fn read_string(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        self.adv()
        let s : mut str = ""
        while true:
            let b : i64 = self.peek(0)
            if b = ⁻1 or b = 10:
                self.err("string literal does not end before the line does")
                return
            if b = 34:
                self.adv()
                break
            if b = 92:
                let e : i64 = self.peek(1)
                if e = 110: s ← s ⧺ (10).chr()
                elif e = 116: s ← s ⧺ (9).chr()
                elif e = 114: s ← s ⧺ (13).chr()
                elif e = 92: s ← s ⧺ (92).chr()
                elif e = 34: s ← s ⧺ (34).chr()
                else:
                    self.err("unknown escape in string literal")
                    return
                self.adv()
                self.adv()
            else:
                s ← s ⧺ b.chr()
                self.pos ← self.pos + 1
                self.col ← self.col + (0 if (b & 192) = 128 else 1)
        let idx : i64 = @dropunit(#self.strs)
        self.strs.push(s)
        self.emit(TK_STR, spos, self.pos - spos, scol, idx, 0)

    fn read_ident(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        while true:
            let b : i64 = self.peek(0)
            if b = ⁻1: break
            let c : i64 = self.cls[b × 1¤ptrdiff]
            if c ≠ CL_IDENT and c ≠ CL_DIGIT: break
            self.adv()
        if self.peek(0) = 39:
            // F', T': the prime rides the name; it spells a type variable
            self.adv()
        let text := run_str(self.src, spos, self.pos - spos)
        self.emit(KEYWORDS[text] ?? TK_IDENT, spos, self.pos - spos, scol, 0, 0)

    // the two-character ASCII operators, reached through their class
    fn read_op2(&mut self, c : i64):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        let b1 : i64 = self.peek(1)
        let k : mut i64 = ⁻1
        let w : mut i64 = 1
        if c = CL_COLON:
            k ← TK_COLON
            if b1 = 61:
                k ← TK_DEFINE
                w ← 2
        elif c = CL_LT:
            k ← TK_LT
            if b1 = 61:
                k ← TK_LE
                w ← 2
            elif b1 = 60:
                k ← TK_SHL
                w ← 2
            elif b1 = 45:
                k ← TK_ASSIGN
                w ← 2
        elif c = CL_GT:
            k ← TK_GT
            if b1 = 61:
                k ← TK_GE
                w ← 2
            elif b1 = 62:
                k ← TK_SHR
                w ← 2
        elif c = CL_DASH:
            k ← TK_MINUS
            if b1 = 62:
                k ← TK_ARROW
                w ← 2
        else:
            k ← TK_QMARK
            if b1 = 63:
                k ← TK_COALESCE
                w ← 2
        let i : mut i64 = 0
        while i < w:
            self.adv()
            i ← i + 1
        self.emit(k, spos, w, scol, 0, 0)

    fn read_glyph(&mut self, c : i64):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        if c = CL_MB2:
            let key : i64 = self.peek(0) × 256 + self.peek(1)
            let k : i64 = GLYPHS2[key] ?? ⁻1
            if k = ⁻1:
                self.err("this character begins nothing core-1 knows")
                return
            self.advg(2)
            self.emit(k, spos, 2, scol, 0, 0)
        else:
            let key : i64 = self.peek(0) × 65536 + self.peek(1) × 256 + self.peek(2)
            let k : i64 = GLYPHS3[key] ?? ⁻1
            if k = ⁻1:
                self.err("this character begins nothing core-1 knows")
                return
            if k = TK_LHASH:
                self.parens ← self.parens + 1
            if k = TK_RHASH and self.parens > 0:
                self.parens ← self.parens - 1
            self.advg(3)
            self.emit(k, spos, 3, scol, 0, 0)

fn lex(src : byte[]) → Toks:
    let lx : mut Lexer = (Lexer{src: src, n: @dropunit(#src), cls: mkcls(),
                                pos: 0, line: 1, col: 1, parens: 0,
                                kind: [], off: [], len: [], tline: [],
                                tcol: [], val: [], big: [], strs: [],
                                indents: [0], diags: []})
    let at_line_start : mut bool = true
    while lx.pos < lx.n and #lx.diags = 0:
        let more : bool = lx.skip_gaps()
        if not more:
            if lx.peek(0) = 10:
                if lx.parens = 0 and not at_line_start:
                    lx.emit(TK_NL, lx.pos, 1, lx.col, 0, 0)
                lx.pos ← lx.pos + 1
                lx.line ← lx.line + 1
                lx.col ← 1
                if lx.parens = 0:
                    at_line_start ← true
            continue
        if at_line_start:
            lx.handle_indent()
            at_line_start ← false
            if #lx.diags > 0:
                break
        let b : i64 = lx.peek(0)
        let c : i64 = lx.cls[b × 1¤ptrdiff]
        if c >= 100:
            let k : i64 = c - 100
            if k = TK_LPAR or k = TK_LBRACK or k = TK_LBRACE:
                lx.parens ← lx.parens + 1
            if (k = TK_RPAR or k = TK_RBRACK or k = TK_RBRACE) and lx.parens > 0:
                lx.parens ← lx.parens - 1
            lx.emit(k, lx.pos, 1, lx.col, 0, 0)
            lx.adv()
        elif c = CL_DIGIT:
            lx.read_number()
        elif c = CL_IDENT:
            lx.read_ident()
        elif c = CL_QUOTE:
            lx.read_string()
        elif c = CL_APOS:
            lx.read_char()
        elif c = CL_MB2 or c = CL_MB3:
            lx.read_glyph(c)
        elif c >= CL_COLON and c <= CL_QMARK:
            lx.read_op2(c)
        elif c = CL_SLASH:
            lx.err("'/' is not an operator; division is written ÷")
        else:
            lx.err("this byte begins nothing core-1 knows")
    if not at_line_start and #lx.diags = 0:
        lx.emit(TK_NL, lx.n, 0, lx.col, 0, 0)
    while #lx.indents > 1:
        _ ← lx.indents.pop() ?? 0
        lx.emit(TK_DEDENT, lx.n, 0, 1, 0, 0)
    lx.emit(TK_EOF, lx.n, 0, 1, 0, 0)
    // the token columns are parallel arrays; leaving out of step here
    // would surface as nonsense positions far away
    assert(#lx.kind = #lx.off and #lx.kind = #lx.len, "token arrays in step")
    assert(#lx.kind = #lx.tline and #lx.kind = #lx.val and #lx.kind = #lx.big,
           "token arrays in step")
    (Toks{kind: lx.kind, off: lx.off, len: lx.len, line: lx.tline,
          col: lx.tcol, val: lx.val, big: lx.big, strs: lx.strs,
          diags: lx.diags})

// ===========================================================================
// The AST: flat parallel arrays indexed by node id
// ===========================================================================

// expressions
let NK_INT : i64 = 1        // na = value (wrapped), nb = big flag
let NK_BOOL : i64 = 2       // na = 0 or 1
let NK_STR : i64 = 3        // na = string table index
let NK_VAR : i64 = 4        // name is the token
let NK_ARRLIT : i64 = 5     // na = extra [count, elem…]
let NK_INDEX : i64 = 6      // na = base, nb = index
let NK_LEN : i64 = 7        // na = base (# of an array or a string)
let NK_CALL : i64 = 10      // na = extra [argc, arg…]; callee token
let NK_SCALL : i64 = 11     // na = builtin id, nb = extra [argc, arg…]
let NK_MCALL : i64 = 12     // na = base, nb = extra [argc, arg…]; method token
let NK_REF : i64 = 13       // na = inner, nb = 1 shared or 2 mut
let NK_SLIT : i64 = 14      // na = extra [n, field-token, expr, …]; name token
let NK_FIELD : i64 = 15     // na = base; field token
let NK_SOME : i64 = 16      // na = the value ∃ carries
let NK_EMPTYV : i64 = 17    // a bare ∅
let NK_HLIT : i64 = 18      // na = extra [n, key, value, …]
let NK_TUPLE : i64 = 19     // na = extra [n, expr…]
let NK_DROPU : i64 = 45     // @dropunit: na = the measured value
let NK_IOTA : i64 = 46      // container ⍳ wanted: where it sits, if anywhere
let NK_SATADD : i64 = 47    // ⊞: the sum, held at the type's edge
let NK_SATSUB : i64 = 48    // ⊟
let NK_SATMUL : i64 = 49    // ⊠
let NK_LXOR : i64 = 53      // ⊕, both sides read
let NK_LNAND : i64 = 54     // ⊼
let NK_LNOR : i64 = 58      // ⊽
let NK_SLICE : i64 = 59     // v[a…b]: na = base, nb = lo, nc = hi
let NK_RESHAPE : i64 = 60   // n ⍴ x: na = the count, nb = the filler
let NK_WHILEB : i64 = 61    // while x := e: na = e, nb = body; name token
let NK_TYPEOF : i64 = 62    // @typeof(e): folds to the type's spelling
let NK_ELEMOF : i64 = 43    // key ∊ hash
let NK_ADD : i64 = 20
let NK_SUB : i64 = 21
let NK_MUL : i64 = 22
let NK_DIV : i64 = 23
let NK_MOD : i64 = 24
let NK_SHL : i64 = 25
let NK_SHR : i64 = 26
let NK_BAND : i64 = 27
let NK_BOR : i64 = 28
let NK_BXOR : i64 = 29
let NK_EQ : i64 = 30
let NK_NE : i64 = 31
let NK_LT : i64 = 32
let NK_LE : i64 = 33
let NK_GT : i64 = 34
let NK_GE : i64 = 35
let NK_AND : i64 = 36       // short-circuit
let NK_OR : i64 = 37        // short-circuit
let NK_LAND : i64 = 38      // ∧, both sides read
let NK_LOR : i64 = 39       // ∨
let NK_MAXOP : i64 = 40     // ⌈
let NK_MINOP : i64 = 41     // ⌊
let NK_CCAT : i64 = 42      // ⧺ on strings
let NK_NEG : i64 = 50       // ⁻
let NK_NOT : i64 = 51       // not, ¬
let NK_BNOT : i64 = 52      // ~
let NK_COND : i64 = 55      // na = then-value, nb = condition, nc = else-value
let NK_WRAP : i64 = 56      // na = inner
let NK_DEFAULT : i64 = 57   // na = the result-shaped thing, nb = default
// statements
let NK_LET : i64 = 70       // na = init, nb = 1 when mut, nc = type; name token
let NK_ASSIGN : i64 = 71    // na = value; target name token
let NK_DISCARD : i64 = 72   // na = value
let NK_IF : i64 = 73        // na = cond, nb = then block, nc = else block or ⁻1
let NK_WHILE : i64 = 74     // na = cond, nb = body
let NK_FOREACH : i64 = 75   // na = extra [lo, step or ⁻1, hi], nb = body; var token
let NK_FOREACHA : i64 = 76  // na = array expr, nb = body; var token
let NK_RETURN : i64 = 77    // na = value or ⁻1
let NK_BREAK : i64 = 78
let NK_CONTINUE : i64 = 79
let NK_EXPRSTMT : i64 = 80  // na = expr
let NK_BLOCK : i64 = 81     // na = extra [count, stmt…]
let NK_STOREFLD : i64 = 83  // na = base var, nb = value; field token
let NK_MATCH : i64 = 84     // na = subject, nb = extra [some-block, empty-block]; bind token
let NK_LETT : i64 = 85      // let (a, b) …: na = init, nb = 1 when mut, nc = extra [n, type or ⁻1, name-token…]
let NK_STOREIDXP : i64 = 86 // path[i] ← v: na = base expr, nb = index, nc = value
let NK_RANGEV : i64 = 87    // a…b and a…step…b as a value: na = lo, nb = hi, nc = step or ⁻1
let NK_LAMBDA : i64 = 88    // λ literal: na = extra [np, (tok,ty)…, ncap, tok…, ret], nb = body, nc = lambda index
let NK_FNVAL : i64 = 89     // a named function as a value: na = fn index
let NK_CALLV : i64 = 90     // applying a value: na = callee expr, nb = args
let NK_EXPECTS : i64 = 93   // @expect over one statement: na = it, nb = 1 when an error is expected
let NK_HINTED : i64 = 94    // @likely/@unlikely over an if: na = it, nb = 1 when unlikely
let NK_SIZEOF : i64 = 96    // @sizeof(T) or @sizeof(e): folds to a count of bytes
let NK_MSLICE : i64 = 95    // m[rows, cols]: na = matrix, nb = extra [rlo, rhi, clo, chi], nc = 1 for a column
let NK_TRY : i64 = 91       // e?: ∅ answers the function early, a value unwraps
let NK_BADLAM : i64 = 92    // a λ the checker refuses: na says why

// std builtins reachable from core-1
let SB_PRINTLN : i64 = 1
let SB_PRINT : i64 = 2
let SB_EXIT : i64 = 3
let SB_ARGS : i64 = 4       // std.args.all() → str[]
let SB_OPEN : i64 = 5       // std.fs.cwd().open_file(p) → File?
let SB_CREATE : i64 = 6     // std.fs.cwd().create_file(p, mode) → File
let SB_ALLOCATOR : i64 = 7  // std.arena.allocator()
let SB_BYTES : i64 = 8      // std.bytes(s) → the string's bytes, u8[]
let SB_CWD : i64 = 9        // std.fs.cwd() as a value
let SB_ENVN : i64 = 10      // std.env.names() → str[]
let SB_ENVG : i64 = 11      // std.env.get(name) → str?
let SB_ENVH : i64 = 12      // std.env.has(name) → bool
let SB_IOV : i64 = 14       // std.iov(x) → the bytes of x, ready to be written
let SB_PROC : i64 = 13      // std.process.<member>: nb names which

// what the auxiliary vector is asked for, and under which key
let PROC_PAGESIZE : i64 = 0
let PROC_UID : i64 = 1
let PROC_EUID : i64 = 2
let PROC_GID : i64 = 3
let PROC_EGID : i64 = 4
let PROC_SECURE : i64 = 5
let PROC_EXECFN : i64 = 6

@pre(m >= 0 and m <= 6)
fn proc_key(m : i64) → i64:
    if m = PROC_PAGESIZE: return 6
    if m = PROC_UID: return 11
    if m = PROC_EUID: return 12
    if m = PROC_GID: return 13
    if m = PROC_EGID: return 14
    if m = PROC_SECURE: return 23
    31

// the base type names, one probe instead of a ladder
let TYNAMES : std.hash(str, i64) = (⸨
    "i8": 17, "i16": 19, "i32": 21, "i64": 23,
    "u8": 16, "u16": 18, "u32": 20, "u64": 22,
    "bool": 2, "str": 3, "char": 4, "byte": 16⸩)

struct FnDef:
    name : str
    tok : i64
    params_off : i64     // extra: [n, name-token, type, …]
    ret : i64
    body : i64
    is_export : bool     // its symbol is one others may link against
    is_replaceable : bool
    is_impure : bool
    is_start : bool
    is_noreturn : bool
    is_test : bool
    pre_off : i64        // extra: [n, expr…] or ⁻1
    post_off : i64       // extra: [n, name-token, expr, …] or ⁻1

struct SDef:
    name : str
    tok : i64
    fields_off : i64     // extra: [n, field-token, type, …]
    is_repr_c : bool     // @repr(C): the fields sit where C would put them

struct GlobalDef:
    name : str
    tok : i64
    ty : i64
    is_mut : bool
    init : i64

struct Ast:
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    strs : str[]
    fns : FnDef[]
    globals : GlobalDef[]
    structs : SDef[]
    tts : i64[]          // tuple shapes: start into tte per shape
    ttl : i64[]          // … how many elements
    tte : i64[]          // … the element types, flattened
    fae : i64[]          // sized arrays: the element type per shape
    fas : i64[]          // … and the size
    mel : i64[]          // matrices: the element type per shape
    mrr : i64[]          // … the first extent, ⁻1 where the type leaves it open
    mcc : i64[]          // … the second, likewise
    mdd : i64[]          // … the third, or ⁻2 where the shape has only two
    minner : i64[]       // … and the type one subscript answers: a row for a
                         //   matrix, a matrix for a cube
    lts : i64[]          // lambda signatures: start into lte per shape
    ltl : i64[]          // … how many parameters
    lte : i64[]          // … the parameter types then the answer, flattened
    unames : str[]       // the measures the file knows
    umarks : str[]       // … and how each one prints
    enames : str[]       // enums: the name of each
    ewidth : i64[]       // … the integer type its values are held in
    estart : i64[]       // … where its enumerators begin in emembers
    ecount : i64[]       // … how many it has
    eflag : i64[]        // … and 1 where @flag makes it a bit set
    emembers : str[]     // … their names, flattened
    evalues : i64[]      // … and what each one stands for
    ignored : str[]      // names @expect left uncompiled
    igtests : str[]      // the @test names among them, in source order
    diags : Diag[]

// ===========================================================================
// Parsing: tokens → Ast
// ===========================================================================

struct Parser:
    toks : Toks
    src : byte[]
    pos : i64
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    fns : FnDef[]
    globals : GlobalDef[]
    structs : SDef[]
    tanames : str[]      // the names standing for types, and what they stand for
    tatypes : i64[]
    unames : str[]       // the measures this file knows, builtin then defined
    umarks : str[]       // … and how each one prints
    snames : str[]       // struct names, pre-scanned so a struct may
                         // be written below whatever names it
    tts : i64[]          // interned tuple shapes, moved into the Ast
    ttl : i64[]
    tte : i64[]
    fae : i64[]
    fas : i64[]
    mel : i64[]
    mrr : i64[]
    mcc : i64[]
    mdd : i64[]
    minner : i64[]
    lts : i64[]
    ltl : i64[]
    lte : i64[]
    enames : str[]
    ewidth : i64[]
    estart : i64[]
    ecount : i64[]
    eflag : i64[]
    emembers : str[]
    evalues : i64[]
    tvn : str[]          // type-variable spellings, interned file-wide
    braces : i64         // statements end at ';' inside a brace block
    ignored : str[]
    igtests : str[]
    diags : Diag[]
    poisoned : bool      // the statement at hand already misparsed

impl Parser:
    fn peek(&self) → i64:
        self.toks.kind[self.pos × 1¤ptrdiff]

    fn peek2(&self) → i64:
        self.toks.kind[(self.pos + 1) × 1¤ptrdiff]

    fn ttext(&self, at : i64) → str:
        run_str(self.src, self.toks.off[at × 1¤ptrdiff],
                self.toks.len[at × 1¤ptrdiff])

    fn failed(&self) → bool:
        self.poisoned

    fn err(&mut self, m : str):
        if not self.poisoned:
            let at ¤ptrdiff : i64 = self.pos
            self.diags.push(Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m})
        self.poisoned ← true
        if #self.diags >= 20:
            // enough; parking on the closing EOF stops everything
            self.pos ← @dropunit(#self.toks.kind) - 1

    // skip what is left of the misparsed statement and start clean on
    // the next line; the block structure survives through the
    // indentation tokens
    fn sync(&mut self):
        self.poisoned ← false
        while true:
            let k : i64 = self.peek()
            if k = TK_EOF or k = TK_DEDENT:
                return
            self.pos ← self.pos + 1
            if k = TK_NL:
                return

    fn eat(&mut self, k : i64, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() ≠ k:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // a name where the bootstrap's reserved words are refused by name
    fn eat_name(&mut self, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() = TK_RESERVED:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return at
        if self.peek() ≠ TK_IDENT:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // an annotation or std-member name: reserved words are fine here,
    // since @start and std.println spell some of them
    fn eat_word(&mut self, what : str) → i64:
        let at : i64 = self.pos
        // a member's or field's name may be any word, including one
        // the language keeps for itself elsewhere: 'type' names a type
        // at the top level and a directory entry's kind after a dot
        if self.peek() ≠ TK_IDENT and self.peek() ≠ TK_RESERVED and self.peek() ≠ TK_TYPE and self.peek() ≠ TK_ENUM:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    fn mknode(&mut self, k : i64, tok : i64, a : i64, b : i64, c : i64) → i64:
        let id : i64 = @dropunit(#self.nkind)
        self.nkind.push(k)
        self.ntok.push(tok)
        self.na.push(a)
        self.nb.push(b)
        self.nc.push(c)
        id

    fn push_list(&mut self, items : i64[]) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#items))
        foreach a := items:
            self.extra.push(a)
        off

    // ------------------------------------------------------------------
    // Types
    // ------------------------------------------------------------------

    // [&[mut]] base [¤unit] [[]]; refs are only meaningful on
    // parameters and the caller of parse_type says whether they may be
    fn parse_type(&mut self, allow_ref : bool) → i64:
        let refk : mut i64 = 0
        if self.peek() = TK_BAND:
            if not allow_ref:
                self.err("a borrow is written on a parameter, not here")
                return TY_I64
            self.pos ← self.pos + 1
            refk ← 1
            if self.peek() = TK_MUT:
                self.pos ← self.pos + 1
                refk ← 2
        if self.peek() = TK_LPAR:
            // (T1, T2, …): a tuple type
            self.pos ← self.pos + 1
            if refk ≠ 0:
                self.err("a core-2 tuple is not borrowed; it is returned and taken apart")
                return TY_I64
            let es : mut i64[] = []
            while true:
                let et : i64 = self.parse_type(false)
                if not ((ty_is_int(et) and ty_unit(et) = 0) or et = TY_BOOL or et = TY_STR or et = TY_CHAR or ty_is_struct(et) or ty_is_opt(et)):
                    self.err("a core-2 tuple holds plain integers, truth values, characters, strings, structs or optionals")
                    return TY_I64
                es.push(et)
                if self.failed():
                    return TY_I64
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
            _ ← self.eat(TK_RPAR, "')' closing the tuple type")
            if #es < 2:
                self.err("a tuple type holds at least two elements; (T) is just T")
                return TY_I64
            if self.peek() = TK_QMARK:
                // a tuple is a pointer to its elements, so an optional
                // one is that pointer in a box, as any optional is
                self.pos ← self.pos + 1
                return mk_oty(mk_tty(self.tup_intern(es)))
            if self.peek() = TK_LBRACK:
                self.err("an array of tuples is not core-2 yet")
                return TY_I64
            return mk_tty(self.tup_intern(es))
        if self.peek() = TK_INT:
            self.err("'" ⧺ self.ttext(self.pos) ⧺ "' does not name a type; a type is written by name, as i64")
            return TY_I64
        let name := self.ttext(self.pos)
        _ ← self.eat_name("a type name")
        let stdbase : mut i64 = ⁻1
        if name = "std":
            _ ← self.eat(TK_DOT, "'.' after std")
            let m := self.ttext(self.pos)
            _ ← self.eat_word("the std type's name")
            if m = "hash":
                _ ← self.eat(TK_LPAR, "'(' after std.hash")
                let kt : i64 = self.parse_type(false)
                _ ← self.eat(TK_COMMA, "',' between the key and value types")
                let vt : i64 = self.parse_type(false)
                _ ← self.eat(TK_RPAR, "')' closing std.hash")
                if not ((ty_is_int(kt) and ty_unit(kt) = 0) or kt = TY_STR):
                    self.err("a core-2 hash key is a plain integer or a string")
                    return TY_I64
                if not ((ty_is_int(vt) and ty_unit(vt) = 0) or vt = TY_BOOL or vt = TY_STR or ty_is_struct(vt)):
                    self.err("a core-2 hash holds integers, truth values, strings or structs")
                    return TY_I64
                if refk ≠ 0:
                    return mk_hty(kt, vt) + 262144 × refk
                return mk_hty(kt, vt)
            if m ≠ "iovec":
                self.err("'std." ⧺ m ⧺ "' is not a core-2 type; std.hash(K, V) and std.iovec are")
                return TY_I64
            // a run of bytes waiting to be written; what it holds is
            // settled where it is made, not where it is named, so the
            // name carries nothing with it
            stdbase ← TY_IOVEC
        if #name >= 2 and name[#name - 1] = '\'':
            // a type variable: whatever the call hands over
            let tv : mut i64 = ⁻1
            if #self.tvn > 0:
                foreach i := 0…#self.tvn - 1:
                    if self.tvn[i] = name:
                        tv ← 194048 + @dropunit(i)
            if tv = ⁻1:
                if #self.tvn >= 32:
                    self.err("this file spells more than 32 type variables")
                    return TY_I64
                tv ← 194048 + @dropunit(#self.tvn)
                self.tvn.push(name)
            if self.peek() = TK_LBRACK or self.peek() = TK_QMARK or self.peek() = TK_CURRENCY:
                self.err("a type variable stands alone; it carries no suffix")
                return TY_I64
            if refk ≠ 0:
                self.err("a type variable travels by value")
                return TY_I64
            return tv
        let base0 : i64 = stdbase if stdbase ≠ ⁻1 else (TYNAMES[name] ?? self.sindex_ty(name))
        if base0 = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a core-2 type")
            return TY_I64
        let base : mut i64 = base0
        if self.peek() = TK_CURRENCY:
            self.pos ← self.pos + 1
            let utok : i64 = self.pos
            let uname := self.ttext(utok)
            _ ← self.eat_word("the unit's name")
            if not ty_is_int(base):
                self.err("only an integer carries a unit")
            else:
                let uix : i64 = self.unit_index(uname)
                if uix ≠ ⁻1:
                    base ← ty_with_unit(base, uix)
                else:
                    self.err("'¤" ⧺ uname ⧺ "' is no measure this file knows")
        if self.peek() = TK_LBRACK:
            self.pos ← self.pos + 1
            if not ty_is_int(base) and not ty_is_struct(base) and not ty_is_enum(base) and base ≠ TY_CHAR and base ≠ TY_STR and base ≠ TY_BOOL and base ≠ TY_IOVEC:
                self.err("a core-2 array holds plain integers, truth values, characters, strings or structs")
                return TY_I64
            let d0 : mut i64 = ⁻1
            if self.peek() = TK_INT:
                // T[n]: the size is part of the type
                if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                    self.err("a sized array states its size as a plain number")
                    return TY_I64
                d0 ← self.toks.val[self.pos × 1¤ptrdiff]
                self.pos ← self.pos + 1
            if self.peek() = TK_COMMA:
                // T[,] and its sized kin: a matrix, its rows one type
                self.pos ← self.pos + 1
                if ty_is_struct(base):
                    self.err("a core-2 matrix holds plain integers, truth values, characters or strings")
                    return TY_I64
                let d1 : mut i64 = ⁻1
                if self.peek() = TK_INT:
                    if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                        self.err("a matrix states its extents as plain numbers")
                        return TY_I64
                    d1 ← self.toks.val[self.pos × 1¤ptrdiff]
                    self.pos ← self.pos + 1
                let d2 : mut i64 = ⁻2
                if self.peek() = TK_COMMA:
                    // T[,,]: a cube, its planes one matrix type
                    self.pos ← self.pos + 1
                    d2 ← ⁻1
                    if self.peek() = TK_INT:
                        if self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                            self.err("a matrix states its extents as plain numbers")
                            return TY_I64
                        d2 ← self.toks.val[self.pos × 1¤ptrdiff]
                        self.pos ← self.pos + 1
                    if self.peek() = TK_COMMA:
                        self.err("a rank-4 array is not core-2 yet")
                        return TY_I64
                _ ← self.eat(TK_RBRACK, "']' closing the matrix type")
                if d0 = 0 or d1 = 0 or d2 = 0:
                    self.err("a matrix has at least one row and one column")
                    return TY_I64
                base ← mk_mty(self.mat_intern(base, d0, d1, d2))
            elif d0 ≠ ⁻1:
                _ ← self.eat(TK_RBRACK, "']' closing the sized array type")
                base ← mk_fty(self.farr_intern(base, d0))
            else:
                _ ← self.eat(TK_RBRACK, "']' closing the array type")
                base ← mk_aty(base)
        if self.peek() = TK_QMARK or self.peek() = TK_BANG:
            // T? and T!: the expected rides the optional's box; what an
            // error carries beyond absence is not core-2 yet
            self.pos ← self.pos + 1
            if ty_is_mat(base):
                self.err("an optional matrix is not core-2 yet")
                return TY_I64
            if ty_is_arr(base):
                self.err("an optional array is not core-2 yet")
                return TY_I64
            if ty_is_hash(base):
                self.err("an optional hash is not core-2 yet")
                return TY_I64
            base ← mk_oty(base)
        if refk ≠ 0 and not ty_is_arr(base) and not ty_is_struct(base) and not ty_is_hash(base):
            self.err("core-2 borrows arrays, structs and hashes; a scalar travels by value")
            return TY_I64
        base + 262144 × refk

    // a tuple shape is interned so equal shapes share one type code,
    // and type equality stays one integer comparison
    fn tup_intern(&mut self, es : i64[]) → i64:
        let n : i64 = @dropunit(#es)
        let m : i64 = @dropunit(#self.tts)
        let sh : mut i64 = 0
        while sh < m:
            if self.ttl[sh × 1¤ptrdiff] = n:
                let st : i64 = self.tts[sh × 1¤ptrdiff]
                let same : mut bool = true
                let i : mut i64 = 0
                while i < n:
                    same ← same and self.tte[(st + i) × 1¤ptrdiff] = es[i × 1¤ptrdiff]
                    i ← i + 1
                if same:
                    return sh
            sh ← sh + 1
        self.tts.push(@dropunit(#self.tte))
        self.ttl.push(n)
        let j : mut i64 = 0
        while j < n:
            self.tte.push(es[j × 1¤ptrdiff])
            j ← j + 1
        m

    fn farr_intern(&mut self, elem : i64, size : i64) → i64:
        let m : i64 = @dropunit(#self.fae)
        let i : mut i64 = 0
        while i < m:
            if self.fae[i × 1¤ptrdiff] = elem and self.fas[i × 1¤ptrdiff] = size:
                return i
            i ← i + 1
        self.fae.push(elem)
        self.fas.push(size)
        m

    // equal lambda signatures share one type code, as tuple shapes do
    fn lam_intern(&mut self, pts : i64[], ret : i64) → i64:
        let n : i64 = @dropunit(#pts)
        let m : i64 = @dropunit(#self.ltl)
        let sh : mut i64 = 0
        while sh < m:
            if self.ltl[sh × 1¤ptrdiff] = n:
                let st : i64 = self.lts[sh × 1¤ptrdiff]
                let same : mut bool = self.lte[(st + n) × 1¤ptrdiff] = ret
                let i : mut i64 = 0
                while i < n:
                    same ← same and self.lte[(st + i) × 1¤ptrdiff] = pts[i × 1¤ptrdiff]
                    i ← i + 1
                if same:
                    return sh
            sh ← sh + 1
        self.lts.push(@dropunit(#self.lte))
        self.ltl.push(n)
        let j : mut i64 = 0
        while j < n:
            self.lte.push(pts[j × 1¤ptrdiff])
            j ← j + 1
        self.lte.push(ret)
        m

    // equal matrix shapes share one type code, as tuple shapes do
    fn mat_intern(&mut self, elem : i64, r : i64, c : i64, d : i64) → i64:
        let m : i64 = @dropunit(#self.mel)
        let i : mut i64 = 0
        while i < m:
            if self.mel[i × 1¤ptrdiff] = elem and self.mrr[i × 1¤ptrdiff] = r and self.mcc[i × 1¤ptrdiff] = c and self.mdd[i × 1¤ptrdiff] = d:
                return i
            i ← i + 1
        // What one subscript answers is settled here, where a shape may
        // still be interned, so that reading it later -- from a &self
        // that cannot intern -- is a plain lookup.
        let inner : mut i64 = mk_rty(elem)
        if d ≠ ⁻2:
            inner ← mk_mty(self.mat_intern(elem, c, d, ⁻2))
        // interning the plane may have grown the table, so where this
        // shape lands is asked again and not remembered from the scan
        let at : i64 = @dropunit(#self.mel)
        self.mel.push(elem)
        self.mrr.push(r)
        self.mcc.push(c)
        self.mdd.push(d)
        self.minner.push(inner)
        assert(#self.mel = #self.minner and #self.mel = #self.mdd, "shape table arrays in step")
        at

    // the pre-scanned struct names answer for a name TYNAMES does not
    fn sindex_ty(&self, name : str) → i64:
        // from NBUILTIN_ENUMS on: a builtin enum is a value under std,
        // not a type a program may write down, which is how the
        // interpreter has it
        if @dropunit(#self.enames) > NBUILTIN_ENUMS:
            foreach i := NBUILTIN_ENUMS × 1¤ptrdiff…#self.enames - 1:
                if self.enames[i] = name:
                    return mk_ety(@dropunit(i))
        // a name standing for a type answers what it stands for
        if #self.tanames > 0:
            foreach i := 0…#self.tanames - 1:
                if self.tanames[i] = name:
                    return self.tatypes[i]
        if #self.snames > 0:
            foreach i := 0…#self.snames - 1:
                if self.snames[i] = name:
                    return mk_sty(@dropunit(i))
        ⁻1

    // the ¤unit that may follow a binding's or parameter's name
    fn unit_index(&self, name : str) → i64:
        foreach i := 1…#self.unames - 1:
            if self.unames[i] = name:
                return @dropunit(i)
        ⁻1

    fn parse_name_unit(&mut self) → i64:
        if self.peek() ≠ TK_CURRENCY:
            return UNIT_NONE
        self.pos ← self.pos + 1
        // ¤name for one the language knows, ¤"name" for one the file
        // defined, as the specification writes them
        let uname : mut str = ""
        if self.peek() = TK_STR:
            uname ← self.toks.strs[self.toks.val[self.pos × 1¤ptrdiff] × 1¤ptrdiff]
            self.pos ← self.pos + 1
        else:
            uname ← self.ttext(self.pos)
            _ ← self.eat_word("the unit's name")
        let u : i64 = self.unit_index(uname)
        if u ≠ ⁻1:
            return u
        self.err("'¤" ⧺ uname ⧺ "' is no measure this file knows")
        UNIT_NONE

    // ------------------------------------------------------------------
    // Expressions, by precedence climbing
    // ------------------------------------------------------------------

    fn parse_args(&mut self) → i64:
        _ ← self.eat(TK_LPAR, "'('")
        let args : mut i64[] = []
        if self.peek() ≠ TK_RPAR:
            while true:
                if self.peek() = TK_BAND:
                    // &x hands the callee the array itself; whether it
                    // may write is the parameter's declaration
                    let at : i64 = self.pos
                    self.pos ← self.pos + 1
                    if self.peek() = TK_MUT:
                        self.err("a borrow at a call is written &name; &mut is the parameter's side")
                        return ⁻1
                    let vtok : i64 = self.pos
                    _ ← self.eat_name("the borrowed name")
                    let v : i64 = self.mknode(NK_VAR, vtok, 0, 0, 0)
                    args.push(self.mknode(NK_REF, at, v, 1, 0))
                else:
                    args.push(self.parse_expr())
                if self.failed(): return ⁻1
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(TK_RPAR, "')' after the arguments")
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#args))
        foreach a := args:
            self.extra.push(a)
        off

    // postfix: indexing and method calls chain off a primary
    // λx : T, y : T |cap| → R: expr — the captures are read where the
    // lambda is written, by value, and the body is one expression
    fn parse_lambda(&mut self, at : i64) → i64:
        self.pos ← self.pos + 1
        // shapes an @expect means to refuse still have to parse; the
        // checker is where they are refused, so 'bad' rides along
        let bad : mut i64 = 0
        let ptoks : mut i64[] = []
        let pts : mut i64[] = []
        while true:
            let ptok : i64 = self.pos
            _ ← self.eat_name("the parameter's name")
            if self.peek() ≠ TK_COLON:
                bad ← 2
                ptoks.push(ptok)
                pts.push(TY_I64)
            else:
                self.pos ← self.pos + 1
                let pt : i64 = self.parse_type(false)
                if not ((ty_is_int(pt) and ty_unit(pt) = 0) or pt = TY_BOOL or pt = TY_CHAR or pt = TY_STR):
                    self.err("a core-2 lambda takes plain integers, truth values, characters and strings")
                    return self.mknode(NK_INT, at, 0, 0, 0)
                ptoks.push(ptok)
                pts.push(pt)
            if self.failed():
                return self.mknode(NK_INT, at, 0, 0, 0)
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
            else:
                break
        if #pts > 5:
            self.err("a core-2 lambda takes at most five parameters")
            return self.mknode(NK_INT, at, 0, 0, 0)
        let caps : mut i64[] = []
        if self.peek() = TK_BOR:
            self.pos ← self.pos + 1
            while self.peek() ≠ TK_BOR and not self.failed():
                let ctok : i64 = self.pos
                _ ← self.eat_name("the captured name")
                caps.push(ctok)
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
            _ ← self.eat(TK_BOR, "'|' closing the capture list")
            if #caps = 0 and bad = 0:
                bad ← 1
        let ret : mut i64 = TY_UNIT
        if self.peek() ≠ TK_ARROW:
            if bad = 0:
                bad ← 3
            ret ← TY_I64
        else:
            self.pos ← self.pos + 1
            if self.peek() = TK_EMPTY:
                // parsed so an @expect may hold it; the checker refuses it
                self.pos ← self.pos + 1
            else:
                ret ← self.parse_type(false)
                let rb : i64 = ty_opt_base(ret) if ty_is_opt(ret) else ret
                if not ((ty_is_int(rb) and ty_unit(rb) = 0) or rb = TY_BOOL or rb = TY_CHAR or rb = TY_STR):
                    self.err("a core-2 lambda answers a plain integer, a truth value, a character or a string")
                    return self.mknode(NK_INT, at, 0, 0, 0)
        let body : mut i64 = ⁻1
        if self.peek() = TK_COLON and self.peek2() = TK_NL:
            // a layout block, statement by statement, as a function's
            body ← self.parse_block()
        elif self.peek() = TK_COLON and self.peek2() = TK_LBRACE:
            _ ← self.eat(TK_COLON, "':' and the lambda's body")
            body ← self.parse_brace_block()
        else:
            _ ← self.eat(TK_COLON, "':' and the lambda's body")
            body ← self.parse_expr()
        if bad ≠ 0:
            return self.mknode(NK_BADLAM, at, bad, 0, 0)
        let li : i64 = self.lam_intern(pts, ret)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#pts))
        foreach i := 0…#pts - 1:
            self.extra.push(ptoks[i])
            self.extra.push(pts[i])
        self.extra.push(@dropunit(#caps))
        if #caps > 0:
            foreach i := 0…#caps - 1:
                self.extra.push(caps[i])
        self.extra.push(ret)
        self.mknode(NK_LAMBDA, at, off, body, li)

    // { s; s; e }: the braces hold statements where layout cannot go,
    // inside parentheses; ';' separates them and the last is the value
    fn parse_brace_block(&mut self) → i64:
        _ ← self.eat(TK_LBRACE, "'{' opening the block")
        self.braces ← self.braces + 1
        let stmts : mut i64[] = []
        while self.peek() ≠ TK_RBRACE and not self.failed():
            stmts.push(self.parse_stmt())
        self.braces ← self.braces - 1
        _ ← self.eat(TK_RBRACE, "'}' closing the block")
        let off : i64 = self.push_list(stmts)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    fn parse_postfix(&mut self, base0 : i64) → i64:
        let e : mut i64 = base0
        while not self.failed():
            if self.peek() = TK_LBRACK:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let idx : i64 = self.parse_expr()
                if self.nkind[idx × 1¤ptrdiff] = NK_RANGEV:
                    // v[a…b]: both ends included, a fresh array answers
                    if self.nc[idx × 1¤ptrdiff] ≠ ⁻1:
                        self.err("a stepped slice is not core-2 yet")
                        return e
                    if self.peek() = TK_COMMA:
                        // m[rows, cols] and m[rows, i]: a range of rows
                        // cut down the other way.  Neither can hand back
                        // rows the matrix already holds, so both build
                        // what they answer.
                        self.pos ← self.pos + 1
                        let cidx : i64 = self.parse_expr()
                        if self.peek() = TK_COMMA:
                            self.err("a rank-3 subscript is not core-2 yet")
                            return e
                        _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                        let moff : i64 = @dropunit(#self.extra)
                        self.extra.push(self.na[idx × 1¤ptrdiff])
                        self.extra.push(self.nb[idx × 1¤ptrdiff])
                        if self.nkind[cidx × 1¤ptrdiff] = NK_RANGEV:
                            if self.nc[cidx × 1¤ptrdiff] ≠ ⁻1:
                                self.err("a stepped slice is not core-2 yet")
                                return e
                            self.extra.push(self.na[cidx × 1¤ptrdiff])
                            self.extra.push(self.nb[cidx × 1¤ptrdiff])
                            e ← self.mknode(NK_MSLICE, at, e, moff, 0)
                        else:
                            // one column: an element from each row, so
                            // what answers is an array and not a matrix
                            self.extra.push(cidx)
                            self.extra.push(⁻1)
                            e ← self.mknode(NK_MSLICE, at, e, moff, 1)
                        continue
                    _ ← self.eat(TK_RBRACK, "']' closing the slice")
                    e ← self.mknode(NK_SLICE, at, e, self.na[idx × 1¤ptrdiff], self.nb[idx × 1¤ptrdiff])
                elif self.peek() = TK_COMMA:
                    // m[i, j] and m[i, a…b] reach the row and ask it,
                    // so the pair is the chain m[i][j] written short
                    self.pos ← self.pos + 1
                    e ← self.mknode(NK_INDEX, at, e, idx, 0)
                    let jdx : i64 = self.parse_expr()
                    if self.peek() = TK_COMMA and self.nkind[jdx × 1¤ptrdiff] ≠ NK_RANGEV:
                        // c[i, j, k]: one step further in, one more link
                        self.pos ← self.pos + 1
                        e ← self.mknode(NK_INDEX, at, e, jdx, 0)
                        let kdx : i64 = self.parse_expr()
                        if self.peek() = TK_COMMA:
                            self.err("a rank-4 subscript is not core-2 yet")
                            return e
                        if self.nkind[kdx × 1¤ptrdiff] = NK_RANGEV:
                            if self.nc[kdx × 1¤ptrdiff] ≠ ⁻1:
                                self.err("a stepped slice is not core-2 yet")
                                return e
                            _ ← self.eat(TK_RBRACK, "']' closing the slice")
                            e ← self.mknode(NK_SLICE, at, e, self.na[kdx × 1¤ptrdiff], self.nb[kdx × 1¤ptrdiff])
                        else:
                            _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                            e ← self.mknode(NK_INDEX, at, e, kdx, 0)
                        continue
                    if self.peek() = TK_COMMA:
                        self.err("a rank-3 subscript is not core-2 yet")
                        return e
                    if self.nkind[jdx × 1¤ptrdiff] = NK_RANGEV:
                        if self.nc[jdx × 1¤ptrdiff] ≠ ⁻1:
                            self.err("a stepped slice is not core-2 yet")
                            return e
                        _ ← self.eat(TK_RBRACK, "']' closing the slice")
                        e ← self.mknode(NK_SLICE, at, e, self.na[jdx × 1¤ptrdiff], self.nb[jdx × 1¤ptrdiff])
                    else:
                        _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                        e ← self.mknode(NK_INDEX, at, e, jdx, 0)
                else:
                    _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                    e ← self.mknode(NK_INDEX, at, e, idx, 0)
            elif self.peek() = TK_LPAR:
                // (…) after a value: the value is applied
                let at : i64 = self.pos
                let coff : i64 = self.parse_args()
                e ← self.mknode(NK_CALLV, at, e, coff, 0)
            elif self.peek() = TK_QMARK:
                // e?: absence answers the function early
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                e ← self.mknode(NK_TRY, at, e, 0, 0)
            elif self.peek() = TK_DOT:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let mtok : i64 = self.pos
                _ ← self.eat_word("the member's name")
                if self.peek() = TK_LPAR:
                    let off : i64 = self.parse_args()
                    e ← self.mknode(NK_MCALL, mtok, e, off, 0)
                else:
                    e ← self.mknode(NK_FIELD, mtok, e, 0, 0)
            else:
                break
        e

    fn parse_primary(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = TK_LAMBDA:
            return self.parse_lambda(at)
        if k = TK_INT:
            self.pos ← self.pos + 1
            let lit : i64 = self.mknode(NK_INT, at, self.toks.val[at × 1¤ptrdiff],
                                        self.toks.big[at × 1¤ptrdiff], 0)
            // 'a'.ord() reads on; a number's method wants parentheses,
            // as the bootstrap has it
            if self.toks.big[at × 1¤ptrdiff] » 1 = TY_CHAR:
                return self.parse_postfix(lit)
            return lit
        if k = TK_TRUE or k = TK_FALSE:
            self.pos ← self.pos + 1
            return self.mknode(NK_BOOL, at, 1 if k = TK_TRUE else 0, 0, 0)
        if k = TK_STR:
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(NK_STR, at, self.toks.val[at × 1¤ptrdiff], 0, 0))
        if k = TK_NEG:
            self.pos ← self.pos + 1
            // ⁻ against a literal is part of it, as the language says
            if self.peek() = TK_INT:
                let vt : i64 = self.pos
                self.pos ← self.pos + 1
                if self.toks.big[vt × 1¤ptrdiff] & 1 = 1:
                    self.err("the literal is past i64; ⁻ has nothing to negate")
                    return 0
                if self.toks.big[vt × 1¤ptrdiff] » 1 = TY_CHAR:
                    self.err("⁻ negates a number, not a character")
                    return 0
                // the refusal above keeps the value inside i64, so
                // nothing wraps today; the annotation is what makes
                // that still true if ⁻9223372036854775808 is ever
                // admitted, which is the one value that would
                return self.mknode(NK_INT, vt,
                                   @wrap(0 - self.toks.val[vt × 1¤ptrdiff]),
                                   self.toks.big[vt × 1¤ptrdiff], 0)
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_NEG, at, e, 0, 0)
        if k = TK_BNOT:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_BNOT, at, e, 0, 0)
        if k = TK_NOT or k = TK_LNOT:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_NOT, at, e, 0, 0)
        if k = TK_EXISTS:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_LPAR, "'(' after ∃")
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing ∃")
            return self.mknode(NK_SOME, at, e, 0, 0)
        if k = TK_EMPTY:
            self.pos ← self.pos + 1
            return self.mknode(NK_EMPTYV, at, 0, 0, 0)
        if k = TK_LHASH:
            self.pos ← self.pos + 1
            let items : mut i64[] = []
            if self.peek() ≠ TK_RHASH:
                while true:
                    items.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() ≠ TK_COLON:
                        self.err("a set is not core-2 yet; a hash writes key: value")
                        return 0
                    self.pos ← self.pos + 1
                    items.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = TK_COMMA:
                        self.pos ← self.pos + 1
                    else:
                        break
            _ ← self.eat(TK_RHASH, "'⸩' closing the hash literal")
            let off : i64 = @dropunit(#self.extra)
            self.extra.push((@dropunit(#items) ÷ 2) ?? 0)
            foreach it := items:
                self.extra.push(it)
            return self.mknode(NK_HLIT, at, off, 0, 0)
        if k = TK_HASH:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_LEN, at, e, 0, 0)
        if k = TK_LPAR:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_expr()
            if self.peek() = TK_COMMA:
                // (a, b, …): a tuple literal
                let elems : mut i64[] = [e]
                while self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                _ ← self.eat(TK_RPAR, "')' closing the tuple")
                let toff : i64 = self.push_list(elems)
                return self.mknode(NK_TUPLE, at, toff, 0, 0)
            _ ← self.eat(TK_RPAR, "')' closing the parenthesis")
            return self.parse_postfix(e)
        if k = TK_LBRACK:
            self.pos ← self.pos + 1
            let elems : mut i64[] = []
            if self.peek() ≠ TK_RBRACK:
                while true:
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = TK_COMMA:
                        self.pos ← self.pos + 1
                        if self.peek() = TK_RBRACK:
                            break
                    else:
                        break
            _ ← self.eat(TK_RBRACK, "']' closing the array literal")
            let off : i64 = self.push_list(elems)
            return self.mknode(NK_ARRLIT, at, off, 0, 0)
        if k = TK_AT:
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            if name = "typeof":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_LPAR, "'(' after @typeof")
                let te : i64 = self.parse_expr()
                _ ← self.eat(TK_RPAR, "')' closing @typeof")
                return self.mknode(NK_TYPEOF, at, te, 0, 0)
            if name = "sizeof":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_LPAR, "'(' after @sizeof")
                let se : i64 = self.parse_expr()
                _ ← self.eat(TK_RPAR, "')' closing @sizeof")
                return self.mknode(NK_SIZEOF, at, se, 0, 0)
            if name = "dropunit":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_LPAR, "'(' after @dropunit")
                let e0 : i64 = self.parse_expr()
                _ ← self.eat(TK_RPAR, "')' closing @dropunit")
                return self.mknode(NK_DROPU, at, e0, 0, 0)
            if name ≠ "wrap":
                self.err("'@" ⧺ name ⧺ "' is not core-2; @wrap, @dropunit and @sizeof are the expression annotations")
                return 0
            self.pos ← self.pos + 1
            _ ← self.eat(TK_LPAR, "'(' after @wrap")
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing @wrap")
            return self.mknode(NK_WRAP, at, e, 0, 0)
        if k = TK_IDENT:
            let name := self.ttext(at)
            if name = "std":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_DOT, "'.' after std")
                let mtok : i64 = self.pos
                let m := self.ttext(mtok)
                _ ← self.eat_word("the std member's name")
                if m = "implementation":
                    return self.parse_implementation(at)
                if m = "args":
                    _ ← self.eat(TK_DOT, "'.' after std.args")
                    if self.ttext(self.pos) ≠ "all":
                        self.err("'std.args." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; all() is")
                        return 0
                    self.pos ← self.pos + 1
                    let aoff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_ARGS, aoff, 0)
                if m = "process":
                    return self.parse_process(at)
                if m = "env":
                    _ ← self.eat(TK_DOT, "'.' after std.env")
                    let em0 := self.ttext(self.pos)
                    let esb : mut i64 = ⁻1
                    if em0 = "names": esb ← SB_ENVN
                    elif em0 = "get": esb ← SB_ENVG
                    elif em0 = "has": esb ← SB_ENVH
                    else:
                        self.err("'std.env." ⧺ em0 ⧺ "' is not core-2; names(), get() and has() are")
                        return 0
                    self.pos ← self.pos + 1
                    let eoff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, esb, eoff, 0)
                if m = "arena":
                    _ ← self.eat(TK_DOT, "'.' after std.arena")
                    if self.ttext(self.pos) ≠ "allocator":
                        self.err("'std.arena." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; allocator() is")
                        return 0
                    self.pos ← self.pos + 1
                    let loff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_ALLOCATOR, loff, 0)
                if m = "fs":
                    _ ← self.eat(TK_DOT, "'.' after std.fs")
                    if self.ttext(self.pos) ≠ "cwd":
                        self.err("'std.fs." ⧺ self.ttext(self.pos) ⧺ "' is not core-2; cwd() is")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(TK_LPAR, "'(' after cwd")
                    _ ← self.eat(TK_RPAR, "')' after cwd(")
                    if self.peek() ≠ TK_DOT:
                        // the directory itself, a value to iterate
                        let coff0 : i64 = @dropunit(#self.extra)
                        self.extra.push(0)
                        return self.mknode(NK_SCALL, at, SB_CWD, coff0, 0)
                    _ ← self.eat(TK_DOT, "'.' and what cwd() is asked")
                    let fm := self.ttext(self.pos)
                    self.pos ← self.pos + 1
                    if fm = "open_file":
                        let ooff : i64 = self.parse_args()
                        return self.mknode(NK_SCALL, at, SB_OPEN, ooff, 0)
                    if fm = "create_file":
                        let coff : i64 = self.parse_args()
                        return self.mknode(NK_SCALL, at, SB_CREATE, coff, 0)
                    self.err("'" ⧺ fm ⧺ "' is not core-2; cwd() answers open_file and create_file")
                    return 0
                if m = "filetype":
                    _ ← self.eat(TK_DOT, "'.' after std.filetype")
                    let fname := self.ttext(self.pos)
                    self.pos ← self.pos + 1
                    // the enumerator's own value, from the builtin
                    // enum the file already holds
                    let st9 : i64 = self.estart[EI_FILETYPE × 1¤ptrdiff]
                    let n9 : i64 = self.ecount[EI_FILETYPE × 1¤ptrdiff]
                    let fv : mut i64 = ⁻1
                    let k9 : mut i64 = 0
                    while k9 < n9:
                        if self.emembers[(st9 + k9) × 1¤ptrdiff] = fname:
                            fv ← self.evalues[(st9 + k9) × 1¤ptrdiff]
                        k9 ← k9 + 1
                    if fv = ⁻1:
                        self.err("'std.filetype." ⧺ fname ⧺ "' names no kind of file")
                        return 0
                    // an enumerator is a value like any other, so what
                    // may follow one may follow this: .ord() above all
                    return self.parse_postfix(self.mknode(NK_INT, at, fv, mk_ety(EI_FILETYPE) × 2, 0))
                if m = "bytes":
                    let boff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_BYTES, boff, 0)
                if m = "iov":
                    let ioff : i64 = self.parse_args()
                    return self.mknode(NK_SCALL, at, SB_IOV, ioff, 0)
                let sb : mut i64 = ⁻1
                if m = "println": sb ← SB_PRINTLN
                elif m = "print": sb ← SB_PRINT
                elif m = "exit": sb ← SB_EXIT
                else:
                    self.err("'std." ⧺ m ⧺ "' is not core-2; println, print, exit, args, fs, arena, iov and implementation are")
                    return 0
                let off : i64 = self.parse_args()
                return self.mknode(NK_SCALL, at, sb, off, 0)
            if self.peek2() = TK_LPAR:
                self.pos ← self.pos + 1
                let off : i64 = self.parse_args()
                return self.parse_postfix(self.mknode(NK_CALL, at, off, 0, 0))
            if self.peek2() = TK_LBRACE:
                self.pos ← self.pos + 2
                let items : mut i64[] = []
                if self.peek() ≠ TK_RBRACE:
                    while true:
                        items.push(self.pos)
                        _ ← self.eat_name("a field's name")
                        _ ← self.eat(TK_COLON, "':' after the field's name")
                        items.push(self.parse_expr())
                        if self.failed(): return 0
                        if self.peek() = TK_COMMA:
                            self.pos ← self.pos + 1
                        else:
                            break
                _ ← self.eat(TK_RBRACE, "'}' closing the struct literal")
                let off : i64 = @dropunit(#self.extra)
                self.extra.push(@dropunit(#items) ÷ 2 ?? 0)
                foreach it := items:
                    self.extra.push(it)
                return self.parse_postfix(self.mknode(NK_SLIT, at, off, 0, 0))
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(NK_VAR, at, 0, 0, 0))
        if k = TK_RESERVED:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return 0
        self.err("this token begins no core-2 expression")
        0

    fn parse_unary_operand(&mut self) → i64:
        self.parse_primary()

    // std.implementation says which implementation this is; ngplc
    // answers about itself, folded to constants before anything runs,
    // so a comptime check reads them for free
    fn impl_str(&mut self, s : str) → i64:
        if #self.toks.strs > 0:
            foreach i := 0…#self.toks.strs - 1:
                if self.toks.strs[i] = s:
                    return @dropunit(i)
        let idx : i64 = @dropunit(#self.toks.strs)
        self.toks.strs.push(s)
        idx

    // std.process.<member>: what the kernel recorded at exec, read as a
    // member rather than called, since none of it can change
    fn parse_process(&mut self, at : i64) → i64:
        _ ← self.eat(TK_DOT, "'.' after std.process")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        let idx : mut i64 = ⁻1
        if m = "pagesize": idx ← PROC_PAGESIZE
        elif m = "uid": idx ← PROC_UID
        elif m = "euid": idx ← PROC_EUID
        elif m = "gid": idx ← PROC_GID
        elif m = "egid": idx ← PROC_EGID
        elif m = "secure": idx ← PROC_SECURE
        elif m = "exec_filename": idx ← PROC_EXECFN
        else:
            self.err("'std.process." ⧺ m ⧺ "' is not a member; pagesize, uid, euid, gid, egid, secure and exec_filename are")
            return 0
        self.mknode(NK_SCALL, at, SB_PROC, idx, 0)

    fn parse_implementation(&mut self, at : i64) → i64:
        _ ← self.eat(TK_DOT, "'.' after std.implementation")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        if m = "interpreter":
            return self.mknode(NK_BOOL, at, 0, 0, 0)
        if m = "compiled":
            return self.mknode(NK_BOOL, at, 1, 0, 0)
        if m = "name":
            return self.mknode(NK_STR, at, self.impl_str("ngplc"), 0, 0)
        if m = "language":
            return self.mknode(NK_STR, at, self.impl_str("core-1"), 0, 0)
        self.err("'std.implementation." ⧺ m ⧺ "' is not a member; name, language, interpreter and compiled are")
        0

    // binding power of a binary operator token; ⁻1 when it is none.
    // The numbers follow the bootstrap parser's ladder.
    fn bin_bp(&self, k : i64) → i64:
        if k = TK_OR or k = TK_COALESCE: return 2
        if k = TK_AND: return 3
        if k = TK_LOR: return 4
        if k = TK_LAND: return 6
        if k = TK_LXOR or k = TK_LNAND or k = TK_LNOR: return 5
        if k = TK_EQ or k = TK_NE or k = TK_LT or k = TK_GT or k = TK_LE or k = TK_GE: return 7
        if k = TK_MAX or k = TK_MIN or k = TK_ELEM or k = TK_IOTA: return 9
        if k = TK_SHL or k = TK_SHR: return 10
        if k = TK_BOR: return 11
        if k = TK_BXOR: return 12
        if k = TK_BAND: return 13
        if k = TK_PLUS or k = TK_MINUS or k = TK_SATADD or k = TK_SATSUB: return 14
        if k = TK_CONCAT: return 15
        if k = TK_MULT or k = TK_DIVIDE or k = TK_MOD or k = TK_SATMUL: return 16
        if k = TK_RESHAPE: return 17
        ⁻1

    fn bin_nk(&self, k : i64) → i64:
        if k = TK_OR: return NK_OR
        if k = TK_COALESCE: return NK_DEFAULT
        if k = TK_AND: return NK_AND
        if k = TK_LOR: return NK_LOR
        if k = TK_LAND: return NK_LAND
        if k = TK_EQ: return NK_EQ
        if k = TK_NE: return NK_NE
        if k = TK_LT: return NK_LT
        if k = TK_GT: return NK_GT
        if k = TK_LE: return NK_LE
        if k = TK_GE: return NK_GE
        if k = TK_MAX: return NK_MAXOP
        if k = TK_MIN: return NK_MINOP
        if k = TK_ELEM: return NK_ELEMOF
        if k = TK_IOTA: return NK_IOTA
        if k = TK_SATADD: return NK_SATADD
        if k = TK_SATSUB: return NK_SATSUB
        if k = TK_SATMUL: return NK_SATMUL
        if k = TK_LXOR: return NK_LXOR
        if k = TK_LNAND: return NK_LNAND
        if k = TK_LNOR: return NK_LNOR
        if k = TK_RESHAPE: return NK_RESHAPE
        if k = TK_SHL: return NK_SHL
        if k = TK_SHR: return NK_SHR
        if k = TK_BOR: return NK_BOR
        if k = TK_BXOR: return NK_BXOR
        if k = TK_BAND: return NK_BAND
        if k = TK_PLUS: return NK_ADD
        if k = TK_MINUS: return NK_SUB
        if k = TK_CONCAT: return NK_CCAT
        if k = TK_MULT: return NK_MUL
        if k = TK_DIVIDE: return NK_DIV
        if k = TK_MOD: return NK_MOD
        0

    fn parse_bin(&mut self, min_bp : i64) → i64:
        let lhs : mut i64 = self.parse_primary()
        while not self.failed():
            let k : i64 = self.peek()
            if k = TK_ELLIPSIS and min_bp <= 8:
                // a…b, and a…step…b when a second … follows: the range
                // binds tighter than comparison, looser than arithmetic
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(9)
                if self.nkind[lhs × 1¤ptrdiff] = NK_RANGEV:
                    if self.nc[lhs × 1¤ptrdiff] ≠ ⁻1:
                        self.err("a range is lo…hi or lo…step…hi; a fourth part names nothing")
                        return lhs
                    // what stood as the end steps aside to be the step
                    lhs ← self.mknode(NK_RANGEV, at, self.na[lhs × 1¤ptrdiff], rhs, self.nb[lhs × 1¤ptrdiff])
                else:
                    lhs ← self.mknode(NK_RANGEV, at, lhs, rhs, ⁻1)
            else:
                let bp : i64 = self.bin_bp(k)
                if bp = ⁻1 or bp < min_bp:
                    break
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let rhs : i64 = self.parse_bin(bp + 1)
                lhs ← self.mknode(self.bin_nk(k), at, lhs, rhs, 0)
        lhs

    fn parse_expr(&mut self) → i64:
        let v : i64 = self.parse_bin(2)
        if self.failed(): return v
        if self.peek() ≠ TK_IF:
            return v
        // v if cond else w — only the side taken is read
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_bin(2)
        _ ← self.eat(TK_ELSE, "'else' after the condition of a conditional expression")
        let w : i64 = self.parse_expr()
        self.mknode(NK_COND, at, v, cond, w)

    // ------------------------------------------------------------------
    // Statements and blocks
    // ------------------------------------------------------------------

    fn parse_block(&mut self) → i64:
        _ ← self.eat(TK_COLON, "':' beginning the block")
        let stmts : mut i64[] = []
        if self.peek() ≠ TK_NL:
            stmts.push(self.parse_stmt())
        else:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_INDENT, "an indented block")
            while self.peek() ≠ TK_DEDENT and self.peek() ≠ TK_EOF:
                stmts.push(self.parse_stmt())
                if self.poisoned:
                    // this statement is lost; the next line starts over
                    _ ← stmts.pop() ?? 0
                    self.sync()
                    if self.peek() = TK_INDENT:
                        // a block hangs off the broken statement;
                        // nothing owns it now, so it is skipped whole
                        self.skip_block()
            _ ← self.eat(TK_DEDENT, "the end of the block")
        let off : i64 = self.push_list(stmts)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    // step over a balanced INDENT…DEDENT run
    fn skip_block(&mut self):
        let depth : mut i64 = 0
        while self.peek() ≠ TK_EOF:
            if self.peek() = TK_INDENT:
                depth ← depth + 1
            elif self.peek() = TK_DEDENT:
                depth ← depth - 1
                if depth = 0:
                    self.pos ← self.pos + 1
                    return
            self.pos ← self.pos + 1

    fn end_stmt(&mut self):
        if self.braces > 0:
            // inside { }: ';' separates, and '}' closes the last
            if self.peek() = TK_SEMI:
                self.pos ← self.pos + 1
            elif self.peek() ≠ TK_RBRACE:
                self.err("';' separates the statements of a brace block")
            return
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        elif self.peek() = TK_DEDENT or self.peek() = TK_EOF:
            let keep : i64 = 0
        elif self.pos > 0 and self.toks.kind[(self.pos - 1) × 1¤ptrdiff] = TK_DEDENT:
            // a lambda's layout body closed the line already
            let keep : i64 = 0
        else:
            self.err("the statement has ended but the line has more on it")

    fn parse_let(&mut self) → i64:
        self.pos ← self.pos + 1
        if self.peek() = TK_LPAR:
            return self.parse_let_tuple()
        let name_tok : i64 = self.pos
        _ ← self.eat_name("the name the let binds")
        let u : i64 = self.parse_name_unit()
        if self.peek() = TK_DEFINE:
            // := takes the type from the right side, which must state it
            if u ≠ UNIT_NONE:
                self.err("a unit measures a stated type; write 'let x ¤ptrdiff : i64 = …'")
                return 0
            self.pos ← self.pos + 1
            let init0 : i64 = self.parse_expr()
            self.end_stmt()
            return self.mknode(NK_LET, name_tok, init0, 0, ⁻1)
        _ ← self.eat(TK_COLON, "':' and the type of the binding")
        let is_mut : mut i64 = 0
        if self.peek() = TK_MUT:
            is_mut ← 1
            self.pos ← self.pos + 1
            if self.peek() = TK_EQ:
                // let x : mut = e -- mut, the type still inferred
                if u ≠ UNIT_NONE:
                    self.err("a unit measures a stated type; write 'let x ¤ptrdiff : mut i64 = …'")
                    return 0
                self.pos ← self.pos + 1
                let init1 : i64 = self.parse_expr()
                self.end_stmt()
                return self.mknode(NK_LET, name_tok, init1, 1, ⁻1)
        let ty0 : i64 = self.parse_type(false)
        let ty : mut i64 = ty0
        if u ≠ UNIT_NONE:
            // a measure written by the name measures what an array
            // holds, as it measures a bare number: 'let d ¤meter :
            // i64[]' is an array of lengths
            if ty_is_arr(ty) and not ty_is_farr(ty) and ty_is_int(ty_elem(ty)):
                if ty_unit(ty_elem(ty)) ≠ 0 and ty_unit(ty_elem(ty)) ≠ u:
                    self.err("the name and the type say different units")
                else:
                    ty ← mk_aty(ty_with_unit(ty_elem(ty), u))
            elif not ty_is_int(ty):
                self.err("only an integer carries a unit")
            elif ty_unit(ty) ≠ 0 and ty_unit(ty) ≠ u:
                self.err("the name and the type say different units")
            else:
                ty ← ty_with_unit(ty, u)
        _ ← self.eat(TK_EQ, "'=' and the initial value")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        self.mknode(NK_LET, name_tok, init, is_mut, ty)

    // let (a, b) := f()  or  let (a, b) : mut (i64, str) = …; the
    // names, '_' among them, take a tuple apart
    fn parse_let_tuple(&mut self) → i64:
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let ntoks : mut i64[] = []
        while true:
            ntoks.push(self.pos)
            _ ← self.eat_name("a name the let binds")
            if self.failed():
                return 0
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
            else:
                break
        _ ← self.eat(TK_RPAR, "')' closing the names")
        if #ntoks < 2:
            self.err("a destructuring let takes at least two names")
            return 0
        let is_mut : mut i64 = 0
        let ty : mut i64 = ⁻1
        if self.peek() = TK_COLON:
            self.pos ← self.pos + 1
            if self.peek() = TK_MUT:
                is_mut ← 1
                self.pos ← self.pos + 1
            ty ← self.parse_type(false)
            if not ty_is_tup(ty):
                self.err("the names take a tuple apart; the stated type is not a tuple")
                return 0
            _ ← self.eat(TK_EQ, "'=' and the initial value")
        else:
            _ ← self.eat(TK_DEFINE, "':=' (or ': (…) =') and the tuple taken apart")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        let toff : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ntoks))
        self.extra.push(ty)
        foreach t2 := ntoks:
            self.extra.push(t2)
        self.mknode(NK_LETT, name_tok, init, is_mut, toff)

    fn parse_stmt(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = TK_AT and (self.ttext(self.pos + 1) = "likely" or self.ttext(self.pos + 1) = "unlikely"):
            // @likely and @unlikely say which way a condition is
            // expected to go.  They belong to the if that follows and
            // to nothing else, and they never change what is computed
            // -- only where the compiler puts the code.
            let hname := self.ttext(self.pos + 1)
            self.pos ← self.pos + 2
            while self.peek() = TK_NL:
                self.pos ← self.pos + 1
            if self.peek() = TK_AT and (self.ttext(self.pos + 1) = "likely" or self.ttext(self.pos + 1) = "unlikely"):
                let second := self.ttext(self.pos + 1)
                if second = hname:
                    self.err("@" ⧺ hname ⧺ " is given twice on the same condition")
                else:
                    self.err("@" ⧺ second ⧺ " contradicts @" ⧺ hname ⧺ " on the same condition")
                return 0
            if self.peek() ≠ TK_IF:
                self.err("@" ⧺ hname ⧺ " applies to an if statement, but none follows")
                return 0
            let inner : i64 = self.parse_stmt()
            return self.mknode(NK_HINTED, at, inner, 1 if hname = "unlikely" else 0, 0)
        if k = TK_AT and self.ttext(self.pos + 1) = "expect":
            // @expect level "pattern" over the one statement that
            // follows: what it says is expected to be drawn, so what
            // it draws is caught and kept from the report.  Which
            // diagnostic it was is the interpreter's to check, as it
            // is for a definition marked the same way.
            let wants_err : mut i64 = 0
            while self.peek() = TK_AT and self.ttext(self.pos + 1) = "expect" and not self.failed():
                self.pos ← self.pos + 2
                let lvl := self.ttext(self.pos)
                if lvl ≠ "error" and lvl ≠ "warning":
                    self.err("@expect names a level, error or warning")
                    return 0
                if lvl = "error":
                    wants_err ← 1
                self.pos ← self.pos + 1
                if self.peek() ≠ TK_STR:
                    self.err("@expect states the message it expects, as a string")
                    return 0
                self.pos ← self.pos + 1
                while self.peek() = TK_NL:
                    self.pos ← self.pos + 1
            let inner : i64 = self.parse_stmt()
            return self.mknode(NK_EXPECTS, at, inner, wants_err, 0)
        if k = TK_LET:
            return self.parse_let()
        if k = TK_IF:
            self.pos ← self.pos + 1
            let cond : i64 = self.parse_expr()
            let then_blk : i64 = self.parse_block()
            let else_blk : mut i64 = ⁻1
            if self.peek() = TK_ELIF:
                else_blk ← self.parse_elif_chain()
            elif self.peek() = TK_ELSE:
                self.pos ← self.pos + 1
                else_blk ← self.parse_block()
            return self.mknode(NK_IF, at, cond, then_blk, else_blk)
        if k = TK_WHILE:
            self.pos ← self.pos + 1
            if self.peek() = TK_IDENT and (self.peek2() = TK_DEFINE or (self.peek2() = TK_COLON and self.toks.kind[(self.pos + 2) × 1¤ptrdiff] ≠ TK_NL)):
                // while x := e, while x : mut = e, while x : T = e --
                // the loop runs while e answers a value, x naming it
                let wname_tok : i64 = self.pos
                let wmut : mut i64 = 0
                let wty : mut i64 = ⁻1
                if self.peek2() = TK_DEFINE:
                    self.pos ← self.pos + 2
                else:
                    self.pos ← self.pos + 2
                    if self.peek() = TK_MUT:
                        wmut ← 1
                        self.pos ← self.pos + 1
                    if self.peek() ≠ TK_EQ:
                        wty ← self.parse_type(false)
                    _ ← self.eat(TK_EQ, "'=' and what the loop asks")
                let wcond : i64 = self.parse_expr()
                let wbody : i64 = self.parse_block()
                let woff : i64 = @dropunit(#self.extra)
                self.extra.push(wmut)
                self.extra.push(wty)
                return self.mknode(NK_WHILEB, wname_tok, wcond, wbody, woff)
            let cond : i64 = self.parse_expr()
            let body : i64 = self.parse_block()
            return self.mknode(NK_WHILE, at, cond, body, 0)
        if k = TK_FOREACH:
            self.pos ← self.pos + 1
            let name_tok : i64 = self.pos
            if self.peek() = TK_IDENT or self.peek() = TK_RESERVED:
                _ ← self.eat_name("the loop variable")
            else:
                self.err("expected the loop variable")
                return 0
            _ ← self.eat(TK_DEFINE, "':=' before what the loop walks")
            if self.peek() = TK_BAND:
                // foreach x := &v / &mut v: the elements are lent
                self.pos ← self.pos + 1
                let brk : mut i64 = 1
                if self.peek() = TK_MUT:
                    brk ← 2
                    self.pos ← self.pos + 1
                let btok : i64 = self.pos
                _ ← self.eat_name("the borrowed array's name")
                let bvar : i64 = self.mknode(NK_VAR, btok, 0, 0, 0)
                let bref : i64 = self.mknode(NK_REF, btok, bvar, brk, 0)
                let bbody : i64 = self.parse_block()
                return self.mknode(NK_FOREACHA, name_tok, bref, bbody, 0)
            let e1 : i64 = self.parse_bin(2)
            if self.nkind[e1 × 1¤ptrdiff] ≠ NK_RANGEV:
                // walking a container's elements, or a range that
                // arrives as a value
                let body : i64 = self.parse_block()
                return self.mknode(NK_FOREACHA, name_tok, e1, body, 0)
            let body : i64 = self.parse_block()
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(self.na[e1 × 1¤ptrdiff])
            self.extra.push(self.nc[e1 × 1¤ptrdiff])
            self.extra.push(self.nb[e1 × 1¤ptrdiff])
            return self.mknode(NK_FOREACH, name_tok, off, body, 0)
        if k = TK_MATCH:
            self.pos ← self.pos + 1
            let subject : i64 = self.parse_expr()
            _ ← self.eat(TK_COLON, "':' after the subject")
            _ ← self.eat(TK_NL, "the arms on their own lines")
            _ ← self.eat(TK_INDENT, "an indented arm list")
            let some_blk : mut i64 = ⁻1
            let empty_blk : mut i64 = ⁻1
            let bind_tok : mut i64 = ⁻1
            while self.peek() ≠ TK_DEDENT and not self.failed():
                if self.peek() = TK_EXISTS:
                    if some_blk ≠ ⁻1:
                        self.err("match repeats the ∃ pattern")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(TK_LPAR, "'(' after ∃")
                    bind_tok ← self.pos
                    _ ← self.eat_name("the name ∃ binds")
                    _ ← self.eat(TK_RPAR, "')' closing the pattern")
                    some_blk ← self.parse_block()
                elif self.peek() = TK_EMPTY:
                    if empty_blk ≠ ⁻1:
                        self.err("match repeats the ∅ pattern")
                        return 0
                    self.pos ← self.pos + 1
                    empty_blk ← self.parse_block()
                elif self.peek() = TK_NL:
                    self.pos ← self.pos + 1
                else:
                    self.err("a core-2 match arm is ∃(name) or ∅")
                    return 0
            _ ← self.eat(TK_DEDENT, "the end of the match")
            if some_blk = ⁻1:
                self.err("match has no arm for ∃")
                return 0
            if empty_blk = ⁻1:
                self.err("match has no arm for ∅")
                return 0
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(some_blk)
            self.extra.push(empty_blk)
            return self.mknode(NK_MATCH, bind_tok, subject, off, 0)
        if k = TK_RETURN:
            self.pos ← self.pos + 1
            let v : mut i64 = ⁻1
            if self.peek() ≠ TK_NL and self.peek() ≠ TK_DEDENT:
                v ← self.parse_expr()
            self.end_stmt()
            return self.mknode(NK_RETURN, at, v, 0, 0)
        if k = TK_BREAK:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(NK_BREAK, at, 0, 0, 0)
        if k = TK_CONTINUE:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(NK_CONTINUE, at, 0, 0, 0)
        if k = TK_IDENT and self.peek2() = TK_ASSIGN:
            let name := self.ttext(at)
            self.pos ← self.pos + 2
            let v : i64 = self.parse_expr()
            self.end_stmt()
            if name = "_":
                return self.mknode(NK_DISCARD, at, v, 0, 0)
            return self.mknode(NK_ASSIGN, at, v, 0, 0)
        // any postfix path may be a store target: the expression is
        // parsed first, and a following ← turns it into the store its
        // shape names -- a field, an element, or nothing storable
        let e : i64 = self.parse_expr()
        if self.peek() = TK_ASSIGN:
            self.pos ← self.pos + 1
            let v : i64 = self.parse_expr()
            self.end_stmt()
            let ek : i64 = self.nkind[e × 1¤ptrdiff]
            if ek = NK_FIELD:
                return self.mknode(NK_STOREFLD, self.ntok[e × 1¤ptrdiff],
                                   self.na[e × 1¤ptrdiff], v, 0)
            if ek = NK_INDEX:
                return self.mknode(NK_STOREIDXP, at, self.na[e × 1¤ptrdiff],
                                   self.nb[e × 1¤ptrdiff], v)
            self.err("this is not a place a value can be stored into")
            return 0
        self.end_stmt()
        self.mknode(NK_EXPRSTMT, at, e, 0, 0)

    fn parse_elif_chain(&mut self) → i64:
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_expr()
        let then_blk : i64 = self.parse_block()
        let else_blk : mut i64 = ⁻1
        if self.peek() = TK_ELIF:
            else_blk ← self.parse_elif_chain()
        elif self.peek() = TK_ELSE:
            self.pos ← self.pos + 1
            else_blk ← self.parse_block()
        let ifn : i64 = self.mknode(NK_IF, at, cond, then_blk, else_blk)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(ifn)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    // ------------------------------------------------------------------
    // Definitions
    // ------------------------------------------------------------------

    // mods: bit 0 says @replaceable, bit 1 says @export -- two bits
    // rather than two parameters, the subset holding a signature to
    // twelve of them
    fn parse_fn(&mut self, imp : bool, is_start : bool, is_noreturn : bool,
                is_test : bool, mods : i64, ignored : bool,
                pres : i64[], post_toks : i64[], posts : i64[],
                prefix : str, self_sty : i64):
        _ ← self.eat(TK_FN, "'fn'")
        let name_tok : i64 = self.pos
        let name0 := self.ttext(name_tok)
        let name : str = name0 if prefix = "" else prefix ⧺ "." ⧺ name0
        _ ← self.eat_name("the function's name")
        _ ← self.eat(TK_LPAR, "'(' and the parameters")
        let ptoks : mut i64[] = []
        let ptypes : mut i64[] = []
        if self_sty ≠ 0 and self.peek() = TK_BAND:
            // the receiver: &self reads, &mut self changes
            self.pos ← self.pos + 1
            let srk : mut i64 = 1
            if self.peek() = TK_MUT:
                self.pos ← self.pos + 1
                srk ← 2
            let stok : i64 = self.pos
            if self.ttext(stok) ≠ "self":
                self.err("a method's receiver is spelled &self or &mut self")
                return
            self.pos ← self.pos + 1
            ptoks.push(stok)
            ptypes.push(self_sty + 262144 × srk)
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
        if self.peek() ≠ TK_RPAR:
            while true:
                ptoks.push(self.pos)
                _ ← self.eat_name("a parameter name")
                let u : i64 = self.parse_name_unit()
                _ ← self.eat(TK_COLON, "':' and the parameter's type")
                let pmut : mut i64 = 0
                if self.peek() = TK_MUT:
                    self.pos ← self.pos + 1
                    pmut ← 1
                let ty0a : i64 = self.parse_type(true)
                let ty0 : mut i64 = ty0a
                if pmut = 1:
                    if ty_ref_kind(ty0a) ≠ 0:
                        self.err("mut before a borrow says nothing; &mut already changes")
                    elif ty_is_arr(ty0a) or ty_is_hash(ty0a) or ty_is_mat(ty0a):
                        self.err("a mut container parameter changes the caller's own; write &mut")
                    else:
                        ty0 ← ty0a + 262144 × 3
                let ty : mut i64 = ty0
                if u ≠ UNIT_NONE:
                    if not ty_is_int(ty_strip_ref(ty)):
                        self.err("only an integer carries a unit")
                    else:
                        ty ← ty_with_unit(ty_strip_ref(ty), u) + 262144 × ty_ref_kind(ty)
                if ty_is_tup(ty_strip_ref(ty)):
                    self.err("a core-2 tuple is returned and taken apart; it does not travel as a parameter")
                ptypes.push(ty)
                if self.failed(): return
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(TK_RPAR, "')' after the parameters")
        let ret : mut i64 = TY_UNIT
        if self.peek() = TK_ARROW:
            self.pos ← self.pos + 1
            ret ← self.parse_type(false)
        let body : i64 = self.parse_block()
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        let params_off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ptoks))
        if #ptoks > 0:
            foreach i := 0…#ptoks - 1:
                self.extra.push(ptoks[i])
                self.extra.push(ptypes[i])
        let pre_off : mut i64 = ⁻1
        if #pres > 0:
            pre_off ← self.push_list(pres)
        let post_off : mut i64 = ⁻1
        if #posts > 0:
            post_off ← @dropunit(#self.extra)
            self.extra.push(@dropunit(#posts))
            foreach i := 0…#posts - 1:
                self.extra.push(post_toks[i])
                self.extra.push(posts[i])
        if ignored:
            // @expect: the definition is expected to draw diagnostics,
            // so it is not checked, not compiled, and not run --
            // remembered only so a reference to it can say why
            self.ignored.push(name)
            // every @expect'd function is reported as a test of the
            // expectation itself, @test or not, as the interpreter
            // reports them
            self.igtests.push(name)
            return
        self.fns.push(FnDef{name: name, tok: name_tok, params_off: params_off,
                            ret: ret, body: body, is_export: (mods » 1) & 1 = 1,
                            is_replaceable: mods & 1 = 1,
                            is_impure: imp,
                            is_start: is_start, is_noreturn: is_noreturn,
                            is_test: is_test,
                            pre_off: pre_off, post_off: post_off})

    // enum Name [: width]: one enumerator to a line.  What a value
    // holds is its place in the list; what it is called is kept so a
    // diagnostic and a printed value can say it.
    fn parse_enum(&mut self, is_flag : bool):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the enum's name")
        if (TYNAMES[name] ?? ⁻1) ≠ ⁻1 or self.sindex_ty(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already names a type")
            return
        let w : mut i64 = TY_I64
        if self.peek() = TK_COLON and self.peek2() ≠ TK_NL:
            self.pos ← self.pos + 1
            w ← self.parse_type(false)
            if not (ty_is_int(w) and ty_unit(w) = 0):
                self.err("an enum's values are held in a plain integer type")
                return
        _ ← self.eat(TK_COLON, "':' beginning the enumerators")
        _ ← self.eat(TK_NL, "the enumerators on their own lines")
        _ ← self.eat(TK_INDENT, "an indented list of enumerators")
        let first : i64 = @dropunit(#self.emembers)
        // a flag's members are bits, so the automatic values double
        // where an ordinary enum's count on
        let next_val : mut i64 = 1 if is_flag else 0
        while self.peek() ≠ TK_DEDENT and self.peek() ≠ TK_EOF and not self.failed():
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
                continue
            let mname := self.ttext(self.pos)
            _ ← self.eat_name("an enumerator's name")
            let m : mut i64 = first
            while m < @dropunit(#self.emembers):
                if self.emembers[m × 1¤ptrdiff] = mname:
                    self.err("'" ⧺ mname ⧺ "' is named twice in this enum")
                    return
                m ← m + 1
            // an enumerator may say what it stands for; the ones that
            // follow count on from there, as they count from zero
            if self.peek() = TK_EQ:
                self.pos ← self.pos + 1
                let neg : mut i64 = 1
                if self.peek() = TK_NEG:
                    self.pos ← self.pos + 1
                    neg ← ⁻1
                if self.peek() ≠ TK_INT or self.toks.big[self.pos × 1¤ptrdiff] ≠ 0:
                    self.err("an enumerator stands for a written-out number")
                    return
                next_val ← neg × self.toks.val[self.pos × 1¤ptrdiff]
                self.pos ← self.pos + 1
            self.emembers.push(mname)
            self.evalues.push(next_val)
            if is_flag:
                next_val ← @wrap(next_val « 1) if next_val ≠ 0 else 1
            else:
                next_val ← next_val + 1
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        _ ← self.eat(TK_DEDENT, "the end of the enumerators")
        if is_flag:
            // a flag set holds the empty combination under 'nil'
            // unless some member already stands for zero
            let has0 : mut bool = false
            let z : mut i64 = first
            while z < @dropunit(#self.emembers):
                if self.evalues[z × 1¤ptrdiff] = 0:
                    has0 ← true
                z ← z + 1
            if not has0:
                self.emembers.push("nil")
                self.evalues.push(0)
        // every member fits the type the values are stored in
        let bits : i64 = ty_bits(w)
        let sgn : i64 = ty_sgn(w)
        let f : mut i64 = first
        while f < @dropunit(#self.emembers):
            let v : i64 = self.evalues[f × 1¤ptrdiff]
            let lo : i64 = 0 - (1 « (bits - 1)) if sgn = 1 and bits < 64 else (⁻9223372036854775807 - 1 if sgn = 1 else 0)
            // a shift of 63 is past what a signed count allows, so the
            // top of the range is written out where it would be needed
            let hi : i64 = 9223372036854775807 if bits - sgn >= 63 else (1 « (bits - sgn)) - 1
            if v < lo or (bits - sgn < 64 and v > hi):
                self.err("enumerator '" ⧺ self.emembers[f × 1¤ptrdiff] ⧺ "' is " ⧺ i64_str(v) ⧺ ", which does not fit " ⧺ type_name(w) ⧺ ", the type the values are stored in")
                return
            f ← f + 1
        let n : i64 = @dropunit(#self.emembers) - first
        if n = 0:
            self.err("an enum names at least one of what it holds")
            return
        if @dropunit(#self.enames) >= 256:
            self.err("this file names more than 256 enums")
            return
        self.enames.push(name)
        self.ewidth.push(w)
        self.estart.push(first)
        self.ecount.push(n)
        self.eflag.push(1 if is_flag else 0)

    // unit name: a measure of the file's own, standing for nothing but
    // itself.  It is written ¤"name" where a shipped one is written
    // ¤name, as the specification has it.  A measure derived from
    // others -- a ratio of them, or a product -- is not core-2 yet:
    // what core-2 does with a measure is keep it apart from the
    // others, and that needs only its name.
    fn parse_unit_def(&mut self):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the measure's name")
        if self.unit_index(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already names a measure")
            return
        if self.peek() = TK_EQ:
            self.err("a measure derived from others is not core-2 yet; 'unit " ⧺ name ⧺ "' names one of its own")
            return
        if @dropunit(#self.unames) >= 125:
            self.err("this file names more than 125 measures")
            return
        self.unames.push(name)
        self.umarks.push(name)
        self.end_stmt()

    // type Name = T: a name standing for a type, and nothing more --
    // what it stands for is what it is, everywhere the name is written
    fn parse_type_alias(&mut self):
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the name being given to a type")
        if (TYNAMES[name] ?? ⁻1) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' is already a type's name")
            return
        if self.sindex_ty(name) ≠ ⁻1:
            self.err("'" ⧺ name ⧺ "' already stands for something")
            return
        _ ← self.eat(TK_EQ, "'=' and the type the name stands for")
        let t : i64 = self.parse_type(false)
        if self.failed(): return
        self.tanames.push(name)
        self.tatypes.push(t)
        self.end_stmt()

    fn parse_struct(&mut self, repr_c : bool):
        _ ← self.eat(TK_STRUCT, "'struct'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        _ ← self.eat(TK_COLON, "':' after the struct's name")
        _ ← self.eat(TK_NL, "the fields on their own lines")
        _ ← self.eat(TK_INDENT, "an indented field list")
        let ftoks : mut i64[] = []
        let ftypes : mut i64[] = []
        while self.peek() ≠ TK_DEDENT and not self.failed():
            ftoks.push(self.pos)
            _ ← self.eat_name("a field's name")
            // a field may state a unit the way a binding does:
            // name ¤unit : type
            let fu : i64 = self.parse_name_unit()
            _ ← self.eat(TK_COLON, "':' and the field's type")
            let ty : mut i64 = self.parse_type(false)
            if fu ≠ 0:
                if not ty_is_int(ty):
                    self.err("only an integer field carries a unit")
                elif ty_unit(ty) ≠ 0:
                    self.err("one unit per field: it is stated after the name or after the type, not both")
                else:
                    ty ← ty_with_unit(ty, fu)
            if ty_is_tup(ty):
                self.err("a tuple inside a struct is not core-2 yet")
            ftypes.push(ty)
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        _ ← self.eat(TK_DEDENT, "the end of the struct")
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ftoks))
        if #ftoks > 0:
            foreach i := 0…#ftoks - 1:
                self.extra.push(ftoks[i])
                self.extra.push(ftypes[i])
        self.structs.push(SDef{name: name, tok: name_tok, fields_off: off,
                               is_repr_c: repr_c})

    fn parse_impl(&mut self):
        _ ← self.eat(TK_IMPL, "'impl'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        let sty : i64 = self.sindex_ty(name)
        if sty = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a struct this program defines")
            return
        _ ← self.eat(TK_COLON, "':' after the name")
        _ ← self.eat(TK_NL, "the methods on their own lines")
        _ ← self.eat(TK_INDENT, "an indented method list")
        while self.peek() ≠ TK_DEDENT and not self.failed():
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
                continue
            let imp : mut bool = false
            let is_noreturn : mut bool = false
            let pres : mut i64[] = []
            let post_toks : mut i64[] = []
            let posts : mut i64[] = []
            while self.peek() = TK_AT and not self.failed():
                self.pos ← self.pos + 1
                let aname := self.ttext(self.pos)
                _ ← self.eat_word("the annotation's name")
                if aname = "impure":
                    imp ← true
                elif aname = "noreturn":
                    is_noreturn ← true
                elif aname = "pre":
                    _ ← self.eat(TK_LPAR, "'(' after @pre")
                    pres.push(self.parse_expr())
                    _ ← self.eat(TK_RPAR, "')' closing @pre")
                elif aname = "post":
                    _ ← self.eat(TK_LPAR, "'(' after @post")
                    post_toks.push(self.pos)
                    _ ← self.eat_name("the name @post gives the result")
                    _ ← self.eat(TK_COLON, "':' after the result's name")
                    posts.push(self.parse_expr())
                    _ ← self.eat(TK_RPAR, "')' closing @post")
                elif aname = "hot" or aname = "cold":
                    // how often a method is expected to run: noted, as
                    // the interpreter notes it
                    let mnoted : i64 = 0
                    _ ← mnoted
                else:
                    self.err("'@" ⧺ aname ⧺ "' is not core-2 on a method")
                    return
                if self.peek() = TK_NL:
                    self.pos ← self.pos + 1
            if self.peek() = TK_FN:
                self.parse_fn(imp, false, is_noreturn, false, 0, false,
                              pres, post_toks, posts, name, sty)
            else:
                self.err("an impl block holds methods and nothing else")
        _ ← self.eat(TK_DEDENT, "the end of the impl block")
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1

    fn parse_global(&mut self, ignored : bool):
        // a top-level let: the same shape a local has
        let stmt : i64 = self.parse_let()
        if self.failed(): return
        let tok : i64 = self.ntok[stmt × 1¤ptrdiff]
        if ignored:
            // @expect: parsed, remembered, left uncompiled
            self.ignored.push(self.ttext(tok))
            return
        self.globals.push(GlobalDef{name: self.ttext(tok), tok: tok,
                                    ty: self.nc[stmt × 1¤ptrdiff],
                                    is_mut: self.nb[stmt × 1¤ptrdiff] = 1,
                                    init: self.na[stmt × 1¤ptrdiff]})

    fn parse_toplevel(&mut self):
        let imp : mut bool = false
        let is_start : mut bool = false
        let is_noreturn : mut bool = false
        let is_test : mut bool = false
        let is_repl : mut bool = false
        let is_exp : mut bool = false
        let is_repr : mut bool = false
        let is_fl : mut bool = false
        let expects : mut i64 = 0
        let pres : mut i64[] = []
        let post_toks : mut i64[] = []
        let posts : mut i64[] = []
        while self.peek() = TK_AT and not self.failed():
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            _ ← self.eat_word("the annotation's name")
            if name = "impure":
                imp ← true
            elif name = "start":
                is_start ← true
            elif name = "noreturn":
                is_noreturn ← true
            elif name = "test":
                is_test ← true
            elif name = "replaceable":
                is_repl ← true
            elif name = "hot" or name = "cold":
                // how often a function is expected to run: noted and
                // not yet acted on, as the interpreter notes it.  It
                // says where to spend effort, never what to compute.
                let noted : i64 = 0
                _ ← noted
            elif name = "export":
                is_exp ← true
            elif name = "flag":
                // the enum below holds independent bits rather than a
                // count; its automatic values double and combine
                is_fl ← true
            elif name = "repr":
                // @repr(C): the one layout there is.  An unknown name
                // is refused rather than ignored, since accepting it
                // and laying the struct out some other way is the one
                // behaviour guaranteed to corrupt data.
                _ ← self.eat(TK_LPAR, "'(' after @repr")
                let kind := self.ttext(self.pos)
                _ ← self.eat_word("the layout's name")
                if kind ≠ "C":
                    self.err("'@repr(" ⧺ kind ⧺ ")' is not a layout core-2 defines; C is the one there is")
                    return
                _ ← self.eat(TK_RPAR, "')' closing @repr")
                is_repr ← true
            elif name = "expect":
                // @expect level "pattern": the definition is expected
                // to draw diagnostics, so it is parsed and then left
                // uncompiled; the interpreter is where the expectation
                // itself is verified
                let lvl := self.ttext(self.pos)
                if lvl ≠ "error" and lvl ≠ "warning":
                    self.err("@expect names a level, error or warning")
                    return
                self.pos ← self.pos + 1
                if self.peek() ≠ TK_STR:
                    self.err("@expect states the message it expects, as a string")
                    return
                self.pos ← self.pos + 1
                expects ← expects + 1
            elif name = "pre":
                _ ← self.eat(TK_LPAR, "'(' after @pre")
                pres.push(self.parse_expr())
                _ ← self.eat(TK_RPAR, "')' closing @pre")
            elif name = "post":
                _ ← self.eat(TK_LPAR, "'(' after @post")
                post_toks.push(self.pos)
                _ ← self.eat_name("the name @post gives the result")
                _ ← self.eat(TK_COLON, "':' after the result's name")
                posts.push(self.parse_expr())
                _ ← self.eat(TK_RPAR, "')' closing @post")
            else:
                self.err("'@" ⧺ name ⧺ "' is not core-1")
                return
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        if is_repr and self.peek() ≠ TK_STRUCT:
            self.err("@repr gives a struct its layout; nothing else has one")
            return
        if is_fl and self.peek() ≠ TK_ENUM:
            self.err("@flag makes an enum a bit set; nothing else combines")
            return
        if self.peek() = TK_FN:
            self.parse_fn(imp, is_start, is_noreturn, is_test,
                          (1 if is_repl else 0) + (2 if is_exp else 0),
                          expects > 0,
                          pres, post_toks, posts, "", 0)
        elif is_exp:
            self.err("@export names what others may link against, and only a function is a symbol yet")
            return
        elif self.peek() = TK_STRUCT or self.peek() = TK_IMPL:
            if imp or is_start or is_noreturn or is_test or #pres > 0 or #posts > 0:
                self.err("a struct carries no annotations")
            elif expects > 0:
                // a struct's expected errors are parse-time, which no
                // single pass can both report and ignore
                self.err("@expect covers functions and globals in core-2; an expected-error struct stays in the bootstrap suite")
            elif self.peek() = TK_STRUCT:
                self.parse_struct(is_repr)
            else:
                self.parse_impl()
        elif self.peek() = TK_UNIT:
            self.parse_unit_def()
        elif self.peek() = TK_TYPE:
            self.parse_type_alias()
        elif self.peek() = TK_ENUM:
            self.parse_enum(is_fl)
        elif self.peek() = TK_LET:
            if imp or is_start or is_noreturn or is_test or #pres > 0 or #posts > 0:
                self.err("a global binding carries no annotations")
            else:
                self.parse_global(expects > 0)
        else:
            self.err("core-2 has functions, structs, impl blocks, enums, type names and global bindings at the top level")

fn parse(toks : Toks, src : byte[]) → Ast:
    let p : mut Parser = (Parser{toks: toks, src: src, pos: 0,
                                 nkind: [], ntok: [], na: [], nb: [], nc: [],
                                 extra: [], fns: [], globals: [], structs: [],
                                 tanames: [], tatypes: [],
                                 unames: unit_names(), umarks: unit_marks(),
                                 snames: [], tts: [], ttl: [], tte: [],
                                 fae: [], fas: [],
                                 mel: [], mrr: [], mcc: [], mdd: [], minner: [],
                                 lts: [], ltl: [], lte: [],
                                 enames: builtin_enum_names(),
                                 ewidth: builtin_enum_widths(),
                                 estart: [0], ecount: [8], eflag: [0],
                                 emembers: builtin_enum_members(),
                                 evalues: builtin_enum_values(),
                                 tvn: [], braces: 0,
                                 ignored: [], igtests: [],
                                 diags: [], poisoned: false})
    // a struct may be written below whatever names it, so the names
    // are gathered in one sweep before anything is parsed
    let n : i64 = @dropunit(#toks.kind)
    let i : mut i64 = 0
    while i + 1 < n:
        if toks.kind[i × 1¤ptrdiff] = TK_STRUCT and toks.kind[(i + 1) × 1¤ptrdiff] = TK_IDENT:
            p.snames.push(run_str(src, toks.off[(i + 1) × 1¤ptrdiff],
                                  toks.len[(i + 1) × 1¤ptrdiff]))
        i ← i + 1
    while p.peek() ≠ TK_EOF:
        if p.peek() = TK_NL:
            p.pos ← p.pos + 1
        else:
            p.parse_toplevel()
            if p.poisoned:
                p.poisoned ← false
                // hunt for the next definition at the left margin
                while p.peek() ≠ TK_EOF:
                    let k2 : i64 = p.peek()
                    if k2 = TK_INDENT:
                        p.skip_block()
                    elif k2 = TK_FN or k2 = TK_STRUCT or k2 = TK_IMPL or k2 = TK_LET or k2 = TK_AT:
                        break
                    else:
                        p.pos ← p.pos + 1
    if #p.diags = 0:
        // the type table was built from the pre-scan; a parse that
        // succeeded must have seen the same structs in the same order
        assert(#p.structs = #p.snames, "every pre-scanned struct parsed")
        assert(#p.nkind = #p.ntok and #p.nkind = #p.na, "node arrays in step")
        assert(#p.nkind = #p.nb and #p.nkind = #p.nc, "node arrays in step")
    (Ast{nkind: p.nkind, ntok: p.ntok, na: p.na, nb: p.nb, nc: p.nc,
         extra: p.extra, strs: p.toks.strs, fns: p.fns, globals: p.globals,
         structs: p.structs, tts: p.tts, ttl: p.ttl, tte: p.tte,
         fae: p.fae, fas: p.fas,
         mel: p.mel, mrr: p.mrr, mcc: p.mcc, mdd: p.mdd, minner: p.minner,
         lts: p.lts, ltl: p.ltl, lte: p.lte,
         unames: p.unames, umarks: p.umarks,
         enames: p.enames, ewidth: p.ewidth, estart: p.estart,
         ecount: p.ecount, eflag: p.eflag, emembers: p.emembers,
         evalues: p.evalues,
         ignored: p.ignored, igtests: p.igtests, diags: p.diags})

// ===========================================================================
// AST dump, one node a line
// ===========================================================================

@impure
fn dump_node(a : Ast, id : i64, depth : i64, src : byte[], toks : Toks):
    let pad : mut str = ""
    let d : mut i64 = 0
    while d < depth:
        pad ← pad ⧺ "  "
        d ← d + 1
    let k : i64 = a.nkind[id × 1¤ptrdiff]
    let tok : i64 = a.ntok[id × 1¤ptrdiff]
    let na : i64 = a.na[id × 1¤ptrdiff]
    let nb : i64 = a.nb[id × 1¤ptrdiff]
    let nc : i64 = a.nc[id × 1¤ptrdiff]
    let ttext : str = run_str(src, toks.off[tok × 1¤ptrdiff], toks.len[tok × 1¤ptrdiff])
    if k = NK_INT:
        std.println("{}int {} big={}", pad, na, nb)
    elif k = NK_BOOL:
        std.println("{}bool {}", pad, na)
    elif k = NK_STR:
        std.println("{}str \"{}\"", pad, a.strs[na × 1¤ptrdiff])
    elif k = NK_VAR:
        std.println("{}var {}", pad, ttext)
    elif k = NK_ARRLIT:
        std.println("{}arrlit", pad)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_INDEX:
        std.println("{}index", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_LEN:
        std.println("{}len", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_CALL:
        std.println("{}call {}", pad, ttext)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_SCALL:
        std.println("{}scall {}", pad, na)
        let n : i64 = a.extra[nb × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(nb + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_MCALL:
        std.println("{}mcall {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        let n : i64 = a.extra[nb × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(nb + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_REF:
        std.println("{}ref {}", pad, nb)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_SLIT:
        std.println("{}slit {}", pad, ttext)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 2 + i × 2) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_FIELD:
        std.println("{}field {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_STOREFLD:
        std.println("{}storefld {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_BLOCK:
        std.println("{}block", pad)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_LET:
        std.println("{}let {} mut={} ty={}", pad, ttext, nb, type_name(nc))
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_ASSIGN:
        std.println("{}assign {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_STOREIDXP:
        std.println("{}storeidx", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
        dump_node(a, nc, depth + 1, src, toks)
    elif k = NK_DISCARD:
        std.println("{}discard", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_IF:
        std.println("{}if", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
        if nc ≠ ⁻1:
            std.println("{}else", pad)
            dump_node(a, nc, depth + 1, src, toks)
    elif k = NK_WHILE:
        std.println("{}while", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_FOREACH:
        std.println("{}foreach {}", pad, ttext)
        dump_node(a, a.extra[na × 1¤ptrdiff], depth + 1, src, toks)
        if a.extra[(na + 1) × 1¤ptrdiff] ≠ ⁻1:
            dump_node(a, a.extra[(na + 1) × 1¤ptrdiff], depth + 1, src, toks)
        dump_node(a, a.extra[(na + 2) × 1¤ptrdiff], depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_FOREACHA:
        std.println("{}foreacha {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_RETURN:
        std.println("{}return", pad)
        if na ≠ ⁻1:
            dump_node(a, na, depth + 1, src, toks)
    elif k = NK_BREAK:
        std.println("{}break", pad)
    elif k = NK_CONTINUE:
        std.println("{}continue", pad)
    elif k = NK_EXPRSTMT:
        std.println("{}exprstmt", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_COND:
        std.println("{}cond", pad)
        dump_node(a, nb, depth + 1, src, toks)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nc, depth + 1, src, toks)
    elif k = NK_WRAP:
        std.println("{}wrap", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_NEG or k = NK_NOT or k = NK_BNOT:
        std.println("{}unop {}", pad, k)
        dump_node(a, na, depth + 1, src, toks)
    else:
        std.println("{}binop {}", pad, k)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)

@impure
fn dump_ast(a : Ast, src : byte[], toks : Toks):
    foreach g := a.globals:
        std.println("global {} mut={} ty={}", g.name, g.is_mut, type_name(g.ty))
        dump_node(a, g.init, 1, src, toks)
    foreach f := a.fns:
        std.println("fn {} ret={} impure={} start={}", f.name,
                    type_name(f.ret), f.is_impure, f.is_start)
        let np : i64 = a.extra[f.params_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < np:
            let ptok : i64 = a.extra[(f.params_off + 1 + i × 2) × 1¤ptrdiff]
            let pty : i64 = a.extra[(f.params_off + 2 + i × 2) × 1¤ptrdiff]
            std.println("  param {} : {}", run_str(src, toks.off[ptok × 1¤ptrdiff], toks.len[ptok × 1¤ptrdiff]), type_name(pty))
            i ← i + 1
        dump_node(a, f.body, 1, src, toks)

// ===========================================================================
// Checking: names, types, widths, units, mutability, purity, returns
// ===========================================================================

// method ids the checker writes into an MCALL's nc
let MID_PUSH : i64 = 1
let MID_POP : i64 = 2
let MID_GET : i64 = 3
let MID_CHR : i64 = 4
let MID_ORD : i64 = 5
let MID_CHARS : i64 = 6
let MID_READF : i64 = 7
let MID_WRITEF : i64 = 8
let MID_CLOSEF : i64 = 9
let MID_ITER : i64 = 10
let MID_NEXT : i64 = 11
let MID_DIRITER : i64 = 12
let MID_WRITEV : i64 = 13

struct Chk:
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    fslots : i64[]
    gvals : i64[]        // the folded initial value of every global
    ginit : i64[]        // globals whose value is built as the run begins
    lams : i64[]         // every λ node, in the order lowered
    lamns : i64[]        // … and the slot count its frame must cover
    psfn : i64[]         // partial-application shims: target, bound, full count
    psk : i64[]
    psnp : i64[]
    skipfn : i64[]       // 1 where a generic was never shaped by a call
    diags : Diag[]

// ---------------------------------------------------------------------------
// The C layout of a @repr(C) struct
// ---------------------------------------------------------------------------
//
// The System V AMD64 psABI's rules, which are also every other
// mainstream C ABI's for these types: a field starts at the next
// offset that is a multiple of its own alignment, the struct aligns
// like its widest field, and its size rounds up to that alignment so
// an array of it keeps every element aligned.
//
// Size and alignment answer ⁻1 where C has no representation for the
// type.  Nothing here reports a diagnostic: the caller knows which
// field it asked about and can point at where that field was written,
// which is where the mistake is.

// how deep a @repr(C) struct may nest before the nesting is taken for
// a cycle.  A struct holding itself by value has no finite size, and
// the fixed ceiling says so without a set to carry around.
let C_NEST_MAX : i64 = 24

// what a type C has no representation for answers, and what a type
// one byte wide and one byte aligned answers.  Both are written out
// as bindings rather than as a bare pair: a tuple of plain numbers
// states no type, and the bootstrap will not let one settle on a type
// it does not have.
fn c_none() → (i64, i64):
    let m : i64 = ⁻1
    (m, m)

fn c_byte_wide() → (i64, i64):
    let one : i64 = 1
    (one, one)

fn c_layout(a : Ast, t0 : i64, depth : i64) → (i64, i64):
    if depth > C_NEST_MAX:
        return c_none()
    let t : i64 = ty_drop_unit(ty_strip_ref(t0))
    if ty_ref_kind(t0) ≠ 0:
        return c_none()
    if t = TY_BOOL:
        return c_byte_wide()
    if ty_is_int(t):
        let w : i64 = ty_bits(t) ÷ 8 ?? 1
        return (w, w)
    if ty_is_enum(t):
        // an enum is its underlying integer and lays out as one
        let w : i64 = ty_bits(a.ewidth[ty_eidx(t) × 1¤ptrdiff]) ÷ 8 ?? 1
        return (w, w)
    if ty_is_farr(t):
        // T[N] is N elements running one after the other, so it aligns
        // like one of them and is as long as all of them
        let (es, ea) := c_layout(a, a.fae[ty_fidx(t) × 1¤ptrdiff], depth + 1)
        if es = ⁻1:
            return c_none()
        return (es × a.fas[ty_fidx(t) × 1¤ptrdiff], ea)
    if ty_is_struct(t):
        return c_struct_layout(a, ty_sidx(t), depth)
    c_none()

@post(r: r[0] = ⁻1 or (r[1] >= 1 and (r[0] % r[1] ?? 1) = 0))
fn c_struct_layout(a : Ast, si : i64, depth : i64) → (i64, i64):
    let d := a.structs[si × 1¤ptrdiff]
    if not d.is_repr_c or depth > C_NEST_MAX:
        return c_none()
    let n : i64 = a.extra[d.fields_off × 1¤ptrdiff]
    let off : mut i64 = 0
    let al : mut i64 = 1
    if n > 0:
        foreach i := 0…n - 1:
            let fty : i64 = a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff]
            let (fs, fa) := c_layout(a, fty, depth + 1)
            if fs = ⁻1:
                return c_none()
            off ← align_up(off, fa) + fs
            al ← al ⌈ fa
    (align_up(off, al), al)

// where field k of a @repr(C) struct begins, or ⁻1 where the struct
// has no layout at all
fn c_field_offset(a : Ast, si : i64, k : i64) → i64:
    let d := a.structs[si × 1¤ptrdiff]
    if not d.is_repr_c:
        return ⁻1
    let n : i64 = a.extra[d.fields_off × 1¤ptrdiff]
    if k < 0 or k >= n:
        return ⁻1
    let off : mut i64 = 0
    foreach i := 0…k:
        let fty : i64 = a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff]
        let (fs, fa) := c_layout(a, fty, 1)
        if fs = ⁻1:
            return ⁻1
        off ← align_up(off, fa)
        if i < k:
            off ← off + fs
    off

// the first field whose type C cannot represent, so the diagnostic can
// point at the field rather than at the struct
fn c_bad_field(a : Ast, si : i64) → i64:
    let d := a.structs[si × 1¤ptrdiff]
    let n : i64 = a.extra[d.fields_off × 1¤ptrdiff]
    if n > 0:
        foreach i := 0…n - 1:
            let fty : i64 = a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff]
            let (fs, fa) := c_layout(a, fty, 1)
            _ ← fa
            if fs = ⁻1:
                return i
    ⁻1

struct Checker:
    a : Ast
    toks : Toks
    src : byte[]
    fnames : str[]
    gnames : str[]
    gvals : i64[]
    ginit : i64[]
    ite : i64[]          // iterators: the element type per interned kind
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    fslots : i64[]
    diags : Diag[]
    snames : str[]
    stype : i64[]
    smut : i64[]
    sslot : i64[]
    marks : i64[]
    nslots : i64
    loop_depth : i64
    cur_fn : i64
    in_contract : bool
    scope_floor : i64    // a lambda's body sees nothing below this
    lams : i64[]         // every λ node, in the order lowered
    lamns : i64[]        // … and the slot count its frame must cover
    psfn : i64[]         // partial-application shims: the named target, ⁻1 for a closure
    psk : i64[]          // … how many arguments the box binds
    psnp : i64[]         // … the target's full parameter count
    fdone : i64[]        // per function: 0 unchecked, 1 checked, 2 being checked
    skipfn : i64[]       // 1 where a generic was never shaped by a call
    lam_ret : i64        // the lambda under check answers this; ⁻1 outside

impl Checker:
    fn derr(&mut self, tok : i64, m : str):
        self.diags.push(Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m})

    fn text(&self, tok : i64) → str:
        run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    // @sizeof(T), T.alignof and T.offsetof(f) all answer a count of
    // bytes settled here, and all three fold into the literal the
    // lowering would have had to make anyway.
    fn fold_bytes(&mut self, id : i64, v : i64):
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← v
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.a.nc[id × 1¤ptrdiff] ← 0
        self.set_type(id, ty_with_unit(TY_I64, UNIT_BYTE))

    // the struct a name stands for, where the name is a type's and not
    // a binding's; ⁻1 for anything else
    fn type_named(&self, na : i64) → i64:
        if self.kind_of(na) ≠ NK_VAR:
            return ⁻1
        let nm := self.text(self.a.ntok[na × 1¤ptrdiff])
        ⁻1 if self.lookup(nm) ≠ ⁻1 else self.struct_index(nm)

    // a struct with no layout has no size a program may use: reporting
    // one would invite exactly the dependency the default prevents
    fn layout_err(&mut self, tok : i64, si : i64, what : str):
        let d := self.a.structs[si × 1¤ptrdiff]
        if not d.is_repr_c:
            self.derr(tok, "struct '" ⧺ d.name ⧺ "' has no defined layout; annotate it with @repr(C) to give it one")
            return
        let bad : i64 = c_bad_field(self.a, si)
        if bad = ⁻1:
            self.derr(tok, "struct '" ⧺ d.name ⧺ "' has no C layout")
            return
        let ftok : i64 = self.a.extra[(d.fields_off + 1 + bad × 2) × 1¤ptrdiff]
        let fty : i64 = self.a.extra[(d.fields_off + 2 + bad × 2) × 1¤ptrdiff]
        self.derr(ftok, "in @repr(C) struct '" ⧺ d.name ⧺ "', field '" ⧺ self.text(ftok) ⧺ "': " ⧺ type_name(fty) ⧺ " has no defined C representation")
        _ ← what

    // the type a name stands for where the name is a type's, so
    // @sizeof takes the type itself and not only a value of it
    fn named_type(&self, na : i64) → i64:
        if self.kind_of(na) ≠ NK_VAR:
            return ⁻1
        let nm := self.text(self.a.ntok[na × 1¤ptrdiff])
        if self.lookup(nm) ≠ ⁻1:
            return ⁻1
        let bt : i64 = TYNAMES[nm] ?? ⁻1
        if bt ≠ ⁻1:
            return bt
        let si : i64 = self.struct_index(nm)
        if si ≠ ⁻1:
            return mk_sty(si)
        let ei : i64 = self.enum_index(nm)
        ⁻1 if ei = ⁻1 else mk_ety(ei)

    // A run of bytes is made of one of three things: bytes as they
    // are, a struct whose layout says what its bytes are, or a table
    // of such structs, which C would lay out one after the other.
    fn iov_source_ok(&mut self, tok : i64, pt : i64):
        if pt = mk_aty(TY_U8):
            return
        let et : i64 = self.elem_of(pt) if ty_is_arr(pt) else pt
        if not ty_is_struct(et):
            self.derr(tok, "a run of bytes is made from bytes, a struct with a defined layout, or an array of them; this is " ⧺ type_name(pt))
            return
        let (psz, pal) := c_struct_layout(self.a, ty_sidx(et), 0)
        _ ← pal
        if psz = ⁻1:
            self.layout_err(tok, ty_sidx(et), "written")

    fn check_sizeof(&mut self, id : i64, tok : i64, na : i64):
        let named : i64 = self.named_type(na)
        let t : mut i64 = named
        if named = ⁻1:
            self.check_expr(na, TY_UNIT)
            t ← ty_strip_ref(self.ty_of(na))
        let (sz, al) := c_layout(self.a, t, 0)
        _ ← al
        if sz ≠ ⁻1:
            self.fold_bytes(id, sz)
            return
        // no size to give.  A struct knows why -- no layout asked for,
        // or a field C cannot represent -- and says so; anything else
        // has no C representation at all.
        if ty_is_struct(t):
            self.layout_err(tok, ty_sidx(t), "sized")
        else:
            self.derr(tok, "@sizeof measures what C can represent; " ⧺ type_name(t) ⧺ " it cannot")
        self.fold_bytes(id, 0)

    fn sname_of(&self, t : i64) → str:
        // a diagnostic writes the struct's name, not its number
        if ty_is_struct(ty_strip_ref(t)):
            return self.a.structs[ty_sidx(ty_strip_ref(t)) × 1¤ptrdiff].name
        type_name(t)

    fn struct_index(&self, name : str) → i64:
        if #self.a.structs > 0:
            foreach i := 0…#self.a.structs - 1:
                if self.a.structs[i].name = name:
                    return @dropunit(i)
        ⁻1

    // a field's position and type within a struct, by name; (⁻1, 0)
    // when the struct has no such field
    fn field_of(&self, sidx : i64, fname : str) → (i64, i64):
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let n : i64 = self.a.extra[d.fields_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let ftok : i64 = self.a.extra[(d.fields_off + 1 + i × 2) × 1¤ptrdiff]
            if self.text(ftok) = fname:
                return (i, self.a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff])
            i ← i + 1
        (⁻1i64, 0i64)

    // whether the expression builds a struct of its own rather than
    // naming one that already lives somewhere
    fn is_fresh_struct(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        k = NK_SLIT or k = NK_CALL or k = NK_MCALL

    fn fn_index(&self, name : str) → i64:
        foreach i := 0…#self.fnames - 1:
            if self.fnames[i] = name:
                return @dropunit(i)
        ⁻1

    fn global_index(&self, name : str) → i64:
        if #self.gnames > 0:
            foreach i := 0…#self.gnames - 1:
                if self.gnames[i] = name:
                    return @dropunit(i)
        ⁻1

    fn lookup(&self, name : str) → i64:
        let i : mut i64 = @dropunit(#self.snames) - 1
        while i >= self.scope_floor:
            if self.snames[i × 1¤ptrdiff] = name:
                return i
            i ← i - 1
        ⁻1

    fn declare(&mut self, tok : i64, ty : i64, is_mut : i64) → i64:
        let name := self.text(tok)
        if ty_is_var(ty_strip_ref(ty)):
            self.derr(tok, "a type variable belongs in a signature; a binding states what it holds")
        if names_int_type(name):
            self.derr(tok, "'" ⧺ name ⧺ "' names a type and cannot name a variable")
        let low : i64 = self.marks[#self.marks - 1]
        let i : mut i64 = @dropunit(#self.snames) - 1
        while i >= low:
            if self.snames[i × 1¤ptrdiff] = name:
                self.derr(tok, "'" ⧺ name ⧺ "' is already defined in this scope")
                return self.sslot[i × 1¤ptrdiff]
            i ← i - 1
        let slot : i64 = self.nslots
        self.nslots ← self.nslots + 1
        self.snames.push(name)
        self.stype.push(ty)
        self.smut.push(is_mut)
        self.sslot.push(slot)
        slot

    fn push_scope(&mut self):
        self.marks.push(@dropunit(#self.snames))

    fn pop_scope(&mut self):
        let low : i64 = self.marks.pop() ?? 0
        while @dropunit(#self.snames) > low:
            _ ← self.snames.pop() ?? ""
            _ ← self.stype.pop() ?? 0
            _ ← self.smut.pop() ?? 0
            _ ← self.sslot.pop() ?? 0

    fn is_open(&self, t : i64) → bool:
        t = TY_UNT or t = TY_EMPTY

    fn set_type(&mut self, id : i64, t : i64):
        self.ntype[id × 1¤ptrdiff] ← t

    fn ty_of(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kind_of(&self, id : i64) → i64:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // Untyped literals: folding, adoption, range checks
    // ------------------------------------------------------------------

    // whether the wrapped value v (big says ≥ 2^63) fits the type t
    fn lit_fits(&self, v : i64, big : i64, t : i64) → bool:
        let bits : i64 = ty_bits(t)
        let sgn : i64 = ty_sgn(t)
        if big = 1:
            return sgn = 0 and bits = 64
        if sgn = 0:
            if v < 0: return false
            if bits = 64: return true
            return v <= (1 « bits) - 1
        if bits = 64: return true
        let half : i64 = 1 « (bits - 1)
        v >= 0 - half and v <= half - 1

    // give an untyped node the type its context settled on
    // whether an integer value settles into the wanted integer type,
    // as the bootstrap has it: a value-preserving widening passes as
    // itself; a narrowing or sign-crossing is accepted with a fit
    // check the lowering emits, so a value that does not fit stops
    // the run exactly where the interpreter stops it.  Anything not
    // two integers answers plain type equality.
    // arguments are held tighter than bindings: a typed plain value
    // does not adopt a parameter's measure -- only an untyped literal
    // does -- which is the bootstrap's own rule
    fn fit_arg(&mut self, e : i64, want0 : i64) → bool:
        let t : i64 = self.ty_of(e)
        let want : i64 = ty_strip_ref(want0)
        if ty_is_int(t) and ty_is_int(want) and ty_unit(t) = 0 and ty_unit(want) ≠ 0:
            return false
        self.try_fit(e, want0)

    fn try_fit(&mut self, e : i64, want0 : i64) → bool:
        let t : i64 = self.ty_of(e)
        let want : i64 = ty_strip_ref(want0)
        if t = want:
            return true
        if ty_is_mat(t) and ty_is_mat(want):
            // a stated extent fits an open one; an open one fits only
            // openness, since nothing vouches for its size
            return self.mat_elem(t) = self.mat_elem(want) and self.mat_rank(t) = self.mat_rank(want) and (self.mat_rr(want) = ⁻1 or self.mat_rr(want) = self.mat_rr(t)) and (self.mat_cc(want) = ⁻1 or self.mat_cc(want) = self.mat_cc(t)) and (self.mat_dd(want) = ⁻1 or self.mat_dd(want) = self.mat_dd(t))
        if not (ty_is_int(t) and ty_is_int(want)):
            return false
        if ty_unit(t) ≠ ty_unit(want) and ty_unit(t) ≠ 0:
            // a measured value does not quietly drop or change its
            // measure; @dropunit is the word for parting with one
            return false
        let widening : bool = ty_bits(want) > ty_bits(t) and not (ty_sgn(t) = 1 and ty_sgn(want) = 0)
        if not widening:
            self.ncvt[e × 1¤ptrdiff] ← want
        true

    fn adopt(&mut self, id : i64, t : i64):
        if self.ty_of(id) = TY_EMPTY:
            if ty_is_opt(t):
                self.set_type(id, t)
            else:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "∅ is the absent optional; " ⧺ type_name(t) ⧺ " holds no absence")
            return
        if self.ty_of(id) ≠ TY_UNT:
            return
        if ty_is_enum(t) and self.kind_of(id) = NK_INT:
            // an enum holds exactly its members, so a written-out
            // number becomes one only where it names one
            let ei9 : i64 = ty_eidx(t)
            let st9 : i64 = self.a.estart[ei9 × 1¤ptrdiff]
            let n9 : i64 = self.a.ecount[ei9 × 1¤ptrdiff]
            let v9 : i64 = self.a.na[id × 1¤ptrdiff]
            let ok9 : mut bool = false
            let k9 : mut i64 = 0
            while k9 < n9:
                if self.a.evalues[(st9 + k9) × 1¤ptrdiff] = v9:
                    ok9 ← true
                k9 ← k9 + 1
            if not ok9:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "'" ⧺ self.a.enames[ei9 × 1¤ptrdiff] ⧺ "' holds exactly its members, and " ⧺ i64_str(v9) ⧺ " is not one of them")
            self.set_type(id, t)
            return
        if not ty_is_int(t):
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "a number cannot become " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
        if self.kind_of(id) = NK_INT:
            if not self.lit_fits(self.a.na[id × 1¤ptrdiff],
                                 self.a.nb[id × 1¤ptrdiff], t):
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "the literal does not fit " ⧺ type_name(t))
        elif self.kind_of(id) = NK_COND:
            // both sides were untyped; the context settles each
            self.adopt(self.a.na[id × 1¤ptrdiff], t)
            self.adopt(self.a.nc[id × 1¤ptrdiff], t)
        else:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "this untyped computation cannot settle; ngplc folds only literals")
        self.set_type(id, t)

    // fold an arithmetic node whose operands folded to literals; the
    // computation is exact, and one that leaves i64 is refused since
    // no run of the program could hold it either
    fn fold_bin(&mut self, id : i64, k : i64, tok : i64, l : i64, r : i64):
        let res : mut i64 = 0
        let bad : mut bool = false
        if k = NK_ADD:
            res ← @wrap(l + r)
            bad ← (l > 0 and r > 0 and res < 0) or (l < 0 and r < 0 and res >= 0)
        elif k = NK_SUB:
            res ← @wrap(l - r)
            bad ← (l >= 0 and r < 0 and res < 0) or (l < 0 and r > 0 and res >= 0)
        elif k = NK_MUL:
            res ← @wrap(l × r)
            if l ≠ 0:
                bad ← (res ÷ l ?? 0) ≠ r or (l = ⁻1 and r = 0 - 9223372036854775807 - 1)
        elif k = NK_SHL:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← @wrap(l « r)
                bad ← (res » r) ≠ l
        elif k = NK_SHR:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← l » r
        elif k = NK_BAND:
            res ← l & r
        elif k = NK_BOR:
            res ← l | r
        elif k = NK_BXOR:
            res ← l ^ r
        elif k = NK_MAXOP:
            res ← l ⌈ r
        elif k = NK_MINOP:
            res ← l ⌊ r
        else:
            // comparisons of two untyped numbers answer at once
            let b : mut i64 = 0
            if k = NK_EQ: b ← 1 if l = r else 0
            elif k = NK_NE: b ← 1 if l ≠ r else 0
            elif k = NK_LT: b ← 1 if l < r else 0
            elif k = NK_LE: b ← 1 if l <= r else 0
            elif k = NK_GT: b ← 1 if l > r else 0
            elif k = NK_GE: b ← 1 if l >= r else 0
            else:
                self.derr(tok, "these two untyped numbers cannot meet here; state a type")
                self.set_type(id, TY_I64)
                return
            self.a.nkind[id × 1¤ptrdiff] ← NK_BOOL
            self.a.na[id × 1¤ptrdiff] ← b
            self.set_type(id, TY_BOOL)
            return
        if bad:
            self.derr(tok, "this literal computation leaves i64, which no run could hold")
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← res
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, TY_UNT)

    // ------------------------------------------------------------------
    // Expression checking; `want` is the type the context asks for,
    // 0 (TY_UNIT) meaning it asks nothing
    // ------------------------------------------------------------------

    fn unify_arith(&mut self, tok : i64, id : i64, k : i64, tl : i64, tr : i64) → i64:
        // both integer operands; answers the operation's type
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if tl = TY_UNT and tr = TY_UNT:
            return TY_UNT
        if tl = TY_UNT:
            self.adopt(na, tr)
            return tr
        if tr = TY_UNT:
            // × of a scalar and a measured value keeps the measure, so
            // an untyped right side of × under a united left adopts the
            // bare type; everything else adopts in full
            self.adopt(nb, tl)
            return tl
        // two typed operands: wider wins, and what measure the result
        // carries is the operator's own business
        let ul : i64 = ty_unit(tl)
        let ur : i64 = ty_unit(tr)
        let ru : i64 = self.unit_meet(tok, k, tl, tr)
        if ty_sgn(tl) ≠ ty_sgn(tr):
            // an unsigned value narrower than the signed side widens
            // as itself, and the signed type carries the operation
            let sg : i64 = tl if ty_sgn(tl) = 1 else tr
            let un : i64 = tr if ty_sgn(tl) = 1 else tl
            if ty_bits(sg) > ty_bits(un):
                return ty_with_unit(ty_drop_unit(sg), ru)
            self.derr(tok, "signed and unsigned do not meet; " ⧺ type_name(tl) ⧺ " and " ⧺ type_name(tr))
            return tl
        let wide : i64 = tl if ty_bits(tl) >= ty_bits(tr) else tr
        ty_with_unit(ty_drop_unit(wide), ru)

    // What measure an operation's result carries, and whether the two
    // operands may meet at all.  A sum is of two of the same thing, so
    // its sides must be measured alike -- a plain number is not a
    // length, and the bootstrap refuses to add it to one.  A product
    // scales: one side measured and one plain keeps the measure, but
    // both measured makes a measure of its own (ptrdiff×ptrdiff),
    // which core-2 has no way to write down and so refuses.  A
    // quotient divides the measures out: alike, they cancel.
    fn unit_meet(&mut self, tok : i64, k : i64, tl : i64, tr : i64) → i64:
        let ul : i64 = ty_unit(tl)
        let ur : i64 = ty_unit(tr)
        if k = ⁻1:
            // a conditional is not an operation on its two sides; it
            // hands one of them on, and the bootstrap lets the binding
            // say what that is
            return ul ⌈ ur
        if k = NK_SHL or k = NK_SHR or k = NK_BAND or k = NK_BOR or k = NK_BXOR:
            // measured operands are refused outright further on
            return ul ⌈ ur
        if k = NK_MUL or k = NK_SATMUL:
            if ul ≠ 0 and ur ≠ 0:
                self.derr(tok, "multiplying " ⧺ type_name(tl) ⧺ " by " ⧺ type_name(tr) ⧺ " makes a measure of its own, which core-2 cannot write down")
                return 0
            return ul ⌈ ur
        if k = NK_DIV:
            if ul = ur:
                // the measures cancel and the answer is a bare count
                return 0
            if ur ≠ 0:
                self.derr(tok, "dividing " ⧺ type_name(tl) ⧺ " by " ⧺ type_name(tr) ⧺ " makes a measure of its own, which core-2 cannot write down")
                return 0
            return ul
        if k = NK_MOD:
            if ul = ur:
                // what is left over is measured as what was divided
                return ul
            if ur ≠ 0:
                self.derr(tok, "taking " ⧺ type_name(tl) ⧺ " modulo " ⧺ type_name(tr) ⧺ " makes a measure of its own, which core-2 cannot write down")
                return 0
            return ul
        // + - ⌈ ⌊ ⊞ ⊟: two of the same thing, or nothing
        if ul ≠ ur:
            self.derr(tok, "a value measured " ⧺ type_name(tl) ⧺ " does not meet one measured " ⧺ type_name(tr))
        ul

    fn check_expr(&mut self, id : i64, want : i64):
        let k : i64 = self.kind_of(id)
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_INT:
            if nb >= 2:
                // the width suffix -- or a character literal -- closed
                // the type at the lexer; only the big bit stays for
                // the fit check
                let st : i64 = nb » 1
                self.a.nb[id × 1¤ptrdiff] ← nb & 1
                if st = TY_CHAR:
                    self.set_type(id, TY_CHAR)
                    return
                if ty_is_enum(st):
                    self.set_type(id, st)
                    return
                self.set_type(id, TY_UNT)
                self.adopt(id, st)
            elif want ≠ TY_UNIT and ty_is_int(want):
                self.set_type(id, TY_UNT)
                self.adopt(id, want)
            else:
                self.set_type(id, TY_UNT)
        elif k = NK_BOOL:
            self.set_type(id, TY_BOOL)
        elif k = NK_STR:
            self.set_type(id, TY_STR)
        elif k = NK_VAR:
            self.check_var(id, tok)
        elif k = NK_ARRLIT:
            self.check_arrlit(id, tok, na, want)
        elif k = NK_HLIT:
            self.check_hlit(id, tok, na, want)
        elif k = NK_TUPLE:
            self.check_tuple(id, tok, na, want)
        elif k = NK_SIZEOF:
            self.check_sizeof(id, tok, na)
        elif k = NK_TYPEOF:
            self.check_expr(na, TY_UNIT)
            let tt : mut i64 = ty_strip_ref(self.ty_of(na))
            let tpre : mut str = ""
            if self.kind_of(na) = NK_VAR:
                let ts : i64 = self.lookup(self.text(self.a.ntok[na × 1¤ptrdiff]))
                if ts ≠ ⁻1:
                    let trk : i64 = ty_ref_kind(self.stype[ts × 1¤ptrdiff])
                    if trk = 1:
                        tpre ← "&"
                    elif trk = 2:
                        tpre ← "&mut "
            let sp0 : str = self.ty_spell(tt)
            let sp : str = "" if sp0 = "" else tpre ⧺ sp0
            if sp = "":
                self.derr(tok, "@typeof of " ⧺ type_name(tt) ⧺ " carries the value, not the type alone; it is not core-2")
                self.set_type(id, TY_STR)
                return
            // the spelling is a constant the way a literal is
            self.a.strs.push(sp)
            self.a.nkind[id × 1¤ptrdiff] ← NK_STR
            self.a.na[id × 1¤ptrdiff] ← @dropunit(#self.a.strs) - 1
            self.a.nb[id × 1¤ptrdiff] ← 0
            self.set_type(id, TY_STR)
        elif k = NK_DROPU:
            self.check_expr(na, TY_UNIT)
            let dt : i64 = self.ty_of(na)
            if dt = TY_UNT:
                self.adopt(na, TY_I64)
                self.set_type(id, TY_I64)
            elif not ty_is_int(dt):
                self.derr(tok, "@dropunit unmeasures a number, not " ⧺ type_name(dt))
                self.set_type(id, TY_I64)
            else:
                self.set_type(id, ty_drop_unit(dt))
        elif k = NK_SLIT:
            self.check_slit(id, tok, na)
        elif k = NK_FIELD:
            self.check_field(id, tok, na)
        elif k = NK_SOME:
            let iw : i64 = ty_opt_base(ty_strip_ref(want)) if ty_is_opt(ty_strip_ref(want)) else TY_UNIT
            self.check_expr(na, iw)
            if self.ty_of(na) = TY_UNT:
                self.adopt(na, iw if iw ≠ TY_UNIT and ty_is_int(iw) else TY_I64)
            let it : i64 = self.ty_of(na)
            if ty_is_arr(it):
                self.derr(tok, "an optional array is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            if ty_is_hash(it):
                self.derr(tok, "an optional hash is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            if ty_is_opt(it) or it = TY_EMPTY:
                self.derr(tok, "an optional of an optional is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            self.set_type(id, mk_oty(it))
        elif k = NK_EMPTYV:
            self.set_type(id, want if ty_is_opt(want) else TY_EMPTY)
        elif k = NK_INDEX:
            self.check_index(id, tok, na, nb)
        elif k = NK_LEN:
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if t = TY_STR:
                self.set_type(id, ty_with_unit(TY_I64, UNIT_PTRDIFF))
            elif ty_is_arr(t):
                let u : i64 = UNIT_BYTE if ty_drop_unit(self.elem_of(t)) = TY_U8 else UNIT_PTRDIFF
                self.set_type(id, ty_with_unit(TY_I64, u))
            elif ty_is_hash(t) or ty_is_tup(t) or ty_is_mat(t):
                self.set_type(id, ty_with_unit(TY_I64, UNIT_PTRDIFF))
            else:
                self.derr(tok, "# counts an array, a hash, a tuple or a string; this is " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_CALL:
            self.check_call(id, tok, na)
        elif k = NK_CALLV:
            self.check_callv(id, tok, na, nb)
        elif k = NK_SCALL:
            self.check_scall(id, tok, na, nb)
        elif k = NK_MCALL:
            self.check_mcall(id, tok, na, nb, false)
        elif k = NK_REF:
            self.derr(tok, "a borrow is an argument, not a value of its own")
            self.set_type(id, TY_I64)
        elif k = NK_NEG:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.set_type(id, TY_UNT)
                // the parser folds ⁻literal; reaching here means ⁻(expr)
                if self.kind_of(na) = NK_INT:
                    self.fold_neg(id, na)
            elif ty_is_int(t):
                self.set_type(id, t)
            else:
                self.derr(tok, "⁻ negates a number, not " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_BNOT:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.a.na[id × 1¤ptrdiff] ← ~(self.a.na[na × 1¤ptrdiff])
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_UNT)
            elif ty_is_int(t) and ty_unit(t) = 0:
                self.set_type(id, t)
            elif ty_is_enum(t) and self.enum_is_flag(t):
                // the complement within the set's own bits
                self.set_type(id, t)
            else:
                self.derr(tok, "~ flips the bits of a plain integer or a @flag enum, not " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_NOT:
            self.check_expr(na, TY_UNIT)
            self.want_bool(na, "¬")
            self.set_type(id, TY_BOOL)
        elif k = NK_COND:
            self.check_expr(nb, TY_UNIT)
            self.want_truthy(nb, "the condition")
            self.check_expr(na, want)
            self.check_expr(nc, want)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nc)
            if tl = TY_UNT and tr ≠ TY_UNT:
                self.adopt(na, tr)
            elif tr = TY_UNT and tl ≠ TY_UNT:
                self.adopt(nc, tl)
            elif tl = TY_UNT and tr = TY_UNT:
                self.set_type(id, TY_UNT)
                return
            let ta : i64 = self.ty_of(na)
            let tc : i64 = self.ty_of(nc)
            if ta = tc:
                self.set_type(id, ta)
            elif ty_is_int(ta) and ty_is_int(tc):
                let joint : i64 = self.unify_arith(tok, id, ⁻1, ta, tc)
                _ ← self.try_fit(na, joint)
                _ ← self.try_fit(nc, joint)
                self.set_type(id, joint)
            else:
                self.derr(tok, "the two sides of a conditional say one type between them")
                self.set_type(id, ta)
        elif k = NK_WRAP:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.derr(tok, "@wrap wants a width to wrap within; state a type")
                self.set_type(id, TY_I64)
            elif ty_is_int(t):
                self.set_type(id, t)
            else:
                self.derr(tok, "@wrap wraps integer arithmetic, not " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_DEFAULT:
            self.check_default(id, tok, na, nb, want)
        elif k = NK_DIV or k = NK_MOD:
            self.derr(tok, "÷ and % answer a result; write (a ÷ b) ?? default")
            self.check_expr(na, want)
            self.check_expr(nb, want)
            self.set_type(id, TY_I64)
        elif k = NK_EQ or k = NK_NE:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nb)
            if tl = TY_EMPTY or tr = TY_EMPTY:
                if tl = TY_EMPTY and tr = TY_EMPTY:
                    self.derr(tok, "∅ against ∅ says nothing; state which optional is asked")
                elif tl = TY_EMPTY:
                    if ty_is_opt(tr):
                        self.adopt(na, tr)
                    else:
                        self.derr(tok, "only an optional is asked about ∅; this is " ⧺ type_name(tr))
                elif ty_is_opt(tl):
                    self.adopt(nb, tl)
                else:
                    self.derr(tok, "only an optional is asked about ∅; this is " ⧺ type_name(tl))
                self.set_type(id, TY_BOOL)
                return
            if ty_is_opt(tl) or ty_is_opt(tr):
                let ob : i64 = ty_opt_base(tl if ty_is_opt(tl) else tr)
                if tl ≠ tr:
                    self.derr(tok, "an optional compares with its own kind or ∅; the sides are " ⧺ type_name(tl) ⧺ " and " ⧺ type_name(tr))
                elif not ((ty_is_int(ob) and ty_unit(ob) = 0) or ob = TY_BOOL or ob = TY_CHAR or ob = TY_STR):
                    self.derr(tok, "an optional of " ⧺ type_name(ob) ⧺ " is not compared whole; match takes it apart")
                self.set_type(id, TY_BOOL)
                return
            if tl = TY_STR and tr = TY_STR:
                self.set_type(id, TY_BOOL)
                return
            if tl = TY_BOOL and tr = TY_BOOL:
                self.set_type(id, TY_BOOL)
                return
            if ty_is_hash(tl) or ty_is_hash(tr) or ty_is_arr(tl) or ty_is_arr(tr) or ty_is_tup(tl) or ty_is_tup(tr) or ty_is_mat(tl) or ty_is_mat(tr) or ty_is_rg(tl) or ty_is_rg(tr):
                self.derr(tok, "core-2 does not compare " ⧺ type_name(tl) ⧺ " with " ⧺ type_name(tr) ⧺ "; ask the entries")
                self.set_type(id, TY_BOOL)
                return
            self.check_cmp_operands(id, tok, k, na, nb)
        elif k = NK_LT or k = NK_LE or k = NK_GT or k = NK_GE:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            self.check_cmp_operands(id, tok, k, na, nb)
        elif k = NK_RESHAPE:
            self.check_reshape(id, tok, na, nb, want)
        elif k = NK_IOTA:
            // where the wanted value sits in the container, if anywhere
            self.check_expr(na, TY_UNIT)
            let ct : i64 = self.ty_of(na)
            if not ty_is_arr(ct):
                self.derr(tok, "⍳ looks through an array; this is " ⧺ type_name(ct))
                self.check_expr(nb, TY_UNIT)
                self.set_type(id, mk_oty(ty_with_unit(TY_I64, UNIT_PTRDIFF)))
                return
            let et : i64 = self.elem_of(ct)
            self.check_expr(nb, et)
            if self.is_open(self.ty_of(nb)):
                self.adopt(nb, et)
            elif not self.try_fit(nb, et):
                self.derr(tok, "⍳: the container holds " ⧺ type_name(et) ⧺ ", and what is looked for is " ⧺ type_name(self.ty_of(nb)))
            self.set_type(id, mk_oty(ty_with_unit(TY_I64, UNIT_PTRDIFF)))
        elif k = NK_LAMBDA:
            let loff : i64 = na
            let np9 : i64 = self.a.extra[loff × 1¤ptrdiff]
            let ncap9 : i64 = self.a.extra[(loff + 1 + np9 × 2) × 1¤ptrdiff]
            let lret : i64 = self.a.extra[(loff + 2 + np9 × 2 + ncap9) × 1¤ptrdiff]
            if lret = TY_UNIT:
                self.derr(tok, "a lambda must not return ∅; it answers a value")
                self.set_type(id, TY_I64)
                return
            // captures resolve outside, before the floor closes: their
            // values are read where the lambda is written
            let couter : mut i64[] = []
            let ctoks : mut i64[] = []
            let ctys : mut i64[] = []
            if ncap9 > 0:
                foreach ci := 0…ncap9 - 1:
                    let ctok : i64 = self.a.extra[(loff + 2 + np9 × 2 + ci) × 1¤ptrdiff]
                    let cs : i64 = self.lookup(self.text(ctok))
                    if cs = ⁻1:
                        let cf : i64 = self.fn_index(self.text(ctok))
                        if cf = ⁻1:
                            self.derr(ctok, "'" ⧺ self.text(ctok) ⧺ "' is not here to capture")
                            self.set_type(id, TY_I64)
                            return
                        // a captured function is its value in the box,
                        // read now -- which is what @replaceable asks
                        if self.fn_is_generic(cf):
                            self.derr(ctok, "a generic function has no one shape to capture")
                            self.set_type(id, TY_I64)
                            return
                        let cd := self.a.fns[cf × 1¤ptrdiff]
                        let cnp : i64 = self.a.extra[cd.params_off × 1¤ptrdiff]
                        let cok : mut bool = cnp >= 1 and cnp <= 5 and fnval_ret_ok(cd.ret) and not cd.is_impure
                        let cpts : mut i64[] = []
                        foreach cpi := 0…cnp - 1:
                            let cpty : i64 = self.a.extra[(cd.params_off + 2 + cpi × 2) × 1¤ptrdiff]
                            cok ← cok and ty_ref_kind(cpty) = 0 and ((ty_is_int(cpty) and ty_unit(cpty) = 0) or cpty = TY_BOOL or cpty = TY_CHAR or cpty = TY_STR)
                            cpts.push(ty_strip_ref(cpty))
                        if not cok:
                            self.derr(ctok, "'" ⧺ self.text(ctok) ⧺ "' does not travel as a value; only a pure function of up to five plain scalars does")
                            self.set_type(id, TY_I64)
                            return
                        couter.push(0 - cf - 1)
                        ctoks.push(ctok)
                        ctys.push(mk_lty(self.lam_intern(cpts, cd.ret)))
                    else:
                        let cty0 : i64 = self.stype[cs × 1¤ptrdiff]
                        if ty_ref_kind(cty0) ≠ 0 or not (ty_is_int(cty0) or cty0 = TY_BOOL or cty0 = TY_CHAR or cty0 = TY_STR or ty_is_lam(cty0)):
                            self.derr(ctok, "a capture is one value read now; '" ⧺ self.text(ctok) ⧺ "' is " ⧺ type_name(cty0))
                            self.set_type(id, TY_I64)
                            return
                        couter.push(self.sslot[cs × 1¤ptrdiff])
                        ctoks.push(ctok)
                        ctys.push(cty0)
            self.push_scope()
            let floor9 : i64 = self.scope_floor
            self.scope_floor ← @dropunit(#self.snames)
            foreach pi := 0…np9 - 1:
                let ptok : i64 = self.a.extra[(loff + 1 + pi × 2) × 1¤ptrdiff]
                let pty : i64 = self.a.extra[(loff + 2 + pi × 2) × 1¤ptrdiff]
                let ps : i64 = self.declare(ptok, pty, 0)
                self.a.extra[(loff + 1 + pi × 2) × 1¤ptrdiff] ← ps
            if ncap9 > 0:
                foreach ci := 0…ncap9 - 1:
                    _ ← self.declare(ctoks[ci × 1¤ptrdiff], ctys[ci × 1¤ptrdiff], 0)
                    // the cell keeps the outer slot: the value's source
                    self.a.extra[(loff + 2 + np9 × 2 + ci) × 1¤ptrdiff] ← couter[ci × 1¤ptrdiff]
            let lr_saved : i64 = self.lam_ret
            self.lam_ret ← lret
            if self.kind_of(nb) = NK_BLOCK:
                let ld_saved : i64 = self.loop_depth
                self.loop_depth ← 0
                self.check_block(nb, true)
                self.loop_depth ← ld_saved
                let boff : i64 = self.a.na[nb × 1¤ptrdiff]
                let bn : i64 = self.a.extra[boff × 1¤ptrdiff]
                let last_is_value : mut bool = false
                if bn > 0:
                    let blast : i64 = self.a.extra[(boff + bn) × 1¤ptrdiff]
                    if self.kind_of(blast) = NK_EXPRSTMT or self.kind_of(blast) = NK_MATCH:
                        last_is_value ← true
                if not last_is_value and not self.block_returns(nb):
                    self.derr(tok, "the lambda answers " ⧺ type_name(lret) ⧺ " but not on every path")
            else:
                self.check_expr(nb, lret)
                if self.is_open(self.ty_of(nb)):
                    self.adopt(nb, lret)
                elif not self.try_fit(nb, lret):
                    // a bare value under an optional answer wraps itself
                    if not (ty_is_opt(lret) and self.try_fit(nb, ty_opt_base(lret))):
                        self.derr(tok, "the lambda answers " ⧺ type_name(lret) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
            self.lam_ret ← lr_saved
            self.scope_floor ← floor9
            self.pop_scope()
            self.lams.push(id)
            self.lamns.push(self.nslots)
            self.nslot[id × 1¤ptrdiff] ← @dropunit(#self.lams) - 1
            self.set_type(id, mk_lty(nc))
        elif k = NK_BADLAM:
            if na = 1:
                self.derr(tok, "an empty capture list says nothing; a lambda with no captures leaves the bars off")
            elif na = 2:
                self.derr(tok, "a lambda's parameter requires a type")
            else:
                self.derr(tok, "a lambda states its return type after '→'")
            self.set_type(id, TY_I64)
        elif k = NK_TRY:
            let rw9 : i64 = self.lam_ret if self.lam_ret ≠ ⁻1 else self.a.fns[self.cur_fn × 1¤ptrdiff].ret
            if not ty_is_opt(rw9):
                self.derr(tok, "'?' answers ∅ early, so the function must answer an optional")
            if self.kind_of(na) = NK_DIV or self.kind_of(na) = NK_MOD:
                // ÷ under ? answers the quotient, or ∅ for the zero
                let dl9 : i64 = self.a.na[na × 1¤ptrdiff]
                let dr9 : i64 = self.a.nb[na × 1¤ptrdiff]
                self.check_expr(dl9, TY_UNIT)
                self.check_expr(dr9, self.ty_of(dl9))
                if self.ty_of(dl9) = TY_UNT and self.ty_of(dr9) = TY_UNT:
                    self.adopt(dl9, TY_I64)
                    self.adopt(dr9, TY_I64)
                let dt9 : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, self.kind_of(na), self.ty_of(dl9), self.ty_of(dr9))
                self.set_type(na, dt9 if dt9 ≠ TY_UNT else TY_I64)
                self.set_type(id, self.ty_of(na))
            else:
                self.check_expr(na, TY_UNIT)
                let ot9 : i64 = self.ty_of(na)
                if not ty_is_opt(ot9):
                    self.derr(tok, "'?' asks an optional; this is " ⧺ type_name(ot9))
                    self.set_type(id, TY_I64)
                    return
                self.set_type(id, ty_opt_base(ot9))
        elif k = NK_RANGEV:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, self.ty_of(na))
            if nc ≠ ⁻1:
                self.check_expr(nc, self.ty_of(na))
            let tl9 : i64 = self.ty_of(na)
            let th9 : i64 = self.ty_of(nb)
            let vt : mut i64 = ⁻1
            if tl9 ≠ TY_UNT:
                vt ← tl9
            elif th9 ≠ TY_UNT:
                vt ← th9
            elif nc ≠ ⁻1 and self.ty_of(nc) ≠ TY_UNT:
                vt ← self.ty_of(nc)
            if vt = ⁻1:
                // ends that state nothing take the binding's element,
                // where one is stated, and i64 otherwise
                let w9 : i64 = ty_strip_ref(want)
                vt ← w9 if ty_is_int(w9) and ty_unit(w9) = 0 else TY_I64
            if not ty_is_int(vt) or ty_unit(vt) ≠ 0:
                self.derr(tok, "a range counts plain numbers; this is " ⧺ type_name(vt))
                vt ← TY_I64
            self.adopt(na, vt)
            self.adopt(nb, vt)
            if self.ty_of(na) ≠ vt or self.ty_of(nb) ≠ vt:
                self.derr(tok, "the range's ends say one type between them")
            if nc ≠ ⁻1:
                self.adopt(nc, vt)
                if self.ty_of(nc) ≠ vt:
                    self.derr(tok, "the step follows the range's type")
            self.set_type(id, mk_rgty(vt))
        elif k = NK_MSLICE:
            self.check_expr(na, TY_UNIT)
            let mt9 : i64 = self.ty_of(na)
            let rlo : i64 = self.a.extra[nb × 1¤ptrdiff]
            let rhi : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
            let clo : i64 = self.a.extra[(nb + 2) × 1¤ptrdiff]
            let chi : i64 = self.a.extra[(nb + 3) × 1¤ptrdiff]
            if ty_is_mat(mt9) and self.mat_rank(mt9) = 3:
                self.derr(tok, "cutting a rank-3 array with a range is not core-2 yet")
                self.check_expr(rlo, TY_UNIT)
                self.check_expr(rhi, TY_UNIT)
                self.check_expr(clo, TY_UNIT)
                self.set_type(id, mk_aty(TY_I64))
                return
            if not ty_is_mat(mt9):
                self.derr(tok, "two subscripts take a matrix apart; this is " ⧺ type_name(mt9))
                self.check_expr(rlo, TY_UNIT)
                self.check_expr(rhi, TY_UNIT)
                self.check_expr(clo, TY_UNIT)
                self.set_type(id, mk_aty(TY_I64))
                return
            self.check_index_expr(tok, mt9, rlo)
            self.check_index_expr(tok, mt9, rhi)
            let rowty : i64 = mk_aty(self.mat_elem(mt9))
            self.check_index_expr(tok, rowty, clo)
            if chi ≠ ⁻1:
                self.check_index_expr(tok, rowty, chi)
            if nc = 1:
                // one element from each row: an array of them
                self.set_type(id, mk_aty(self.mat_elem(mt9)))
            else:
                // neither extent is known before it is cut, so both open
                self.set_type(id, mk_mty(self.mat_intern(self.mat_elem(mt9), ⁻1, ⁻1, ⁻2)))
        elif k = NK_SLICE:
            self.check_expr(na, TY_UNIT)
            let bt2 : i64 = self.ty_of(na)
            if not ty_is_arr(bt2) and not ty_is_mat(bt2):
                self.derr(tok, "a slice takes an array apart; this is " ⧺ type_name(bt2))
                self.check_expr(nb, TY_UNIT)
                self.check_expr(nc, TY_UNIT)
                self.set_type(id, mk_aty(TY_I64))
                return
            self.check_index_expr(tok, bt2, nb)
            self.check_index_expr(tok, bt2, nc)
            if ty_is_mat(bt2):
                // fewer rows, the same rows: the row count opens, the
                // row length is still the type's to say
                self.set_type(id, mk_mty(self.mat_intern(self.mat_elem(bt2), ⁻1, self.mat_cc(bt2), self.mat_dd(bt2))))
                return
            self.set_type(id, mk_aty(self.elem_of(bt2)) if ty_is_farr(bt2) or ty_is_row(bt2) else bt2)
        elif k = NK_LXOR or k = NK_LNAND or k = NK_LNOR:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            if self.ty_of(na) ≠ TY_BOOL or self.ty_of(nb) ≠ TY_BOOL:
                self.derr(tok, "⊕, ⊼ and ⊽ take truth values on both sides")
            self.set_type(id, TY_BOOL)
        elif k = NK_AND or k = NK_OR or k = NK_LAND or k = NK_LOR:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            self.want_bool(na, "a logic operator")
            self.want_bool(nb, "a logic operator")
            self.set_type(id, TY_BOOL)
        elif k = NK_ELEMOF:
            self.check_expr(nb, TY_UNIT)
            let ht : i64 = self.ty_of(nb)
            if not ty_is_hash(ht):
                self.derr(tok, "∊ asks a hash in core-2; this is " ⧺ type_name(ht))
                self.check_expr(na, TY_UNIT)
                self.set_type(id, TY_BOOL)
                return
            self.check_hash_key(tok, ht, na)
            self.set_type(id, TY_BOOL)
        elif k = NK_CCAT:
            // the binding's array type reaches both sides, so a bare
            // literal operand settles the way a bound one does
            self.check_expr(na, want if ty_is_arr(ty_strip_ref(want)) else TY_UNIT)
            let cl : i64 = self.ty_of(na)
            if ty_is_arr(cl):
                let ce : i64 = self.elem_of(cl)
                self.check_expr(nb, mk_aty(ce))
                let cr0 : i64 = self.ty_of(nb)
                if not ty_is_arr(cr0):
                    self.derr(tok, "an array joins an array; the right side is " ⧺ type_name(cr0))
                elif self.elem_of(cr0) ≠ ce:
                    self.derr(tok, "one array holds one element type; " ⧺ type_name(ce) ⧺ " does not join " ⧺ type_name(self.elem_of(cr0)))
                self.set_type(id, mk_aty(ce))
                return
            self.check_expr(nb, TY_UNIT)
            let cr : i64 = self.ty_of(nb)
            if not ((cl = TY_STR or cl = TY_CHAR) and (cr = TY_STR or cr = TY_CHAR)):
                self.derr(tok, "⧺ joins strings, characters and arrays in core-2")
            self.set_type(id, TY_STR)
        else:
            // + - × ÷ % « » & | ^ ⌈ ⌊ over integers.  A sum is of two
            // of the same thing, so what is wanted of the whole is
            // wanted of each side; a product is not, and pushing the
            // wanted measure into its sides would have an untyped
            // number there come out measured -- which is how
            // 'n × 1¤ptrdiff' would end up adding a length to a count.
            let side : i64 = ty_drop_unit(want) if (k = NK_MUL or k = NK_SATMUL or k = NK_DIV or k = NK_MOD) and ty_is_int(want) else want
            self.check_expr(na, side)
            self.check_expr(nb, side)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nb)
            if ty_is_enum(tl) or ty_is_enum(tr):
                // a @flag enum is a set of bits, and the bit operators
                // are its set operations; anything else two enums
                // cannot do to each other
                if not (k = NK_BAND or k = NK_BOR or k = NK_BXOR):
                    self.derr(tok, "an enum is compared, not computed with")
                    self.set_type(id, TY_I64)
                    return
                if tl ≠ tr:
                    self.derr(tok, "the sides are " ⧺ type_name(tl) ⧺ " and " ⧺ type_name(tr) ⧺ "; a bit operation takes two of the same @flag enum")
                    self.set_type(id, tl if ty_is_enum(tl) else tr)
                    return
                if not self.enum_is_flag(tl):
                    self.derr(tok, "bit operations take a @flag enum; '" ⧺ self.a.enames[ty_eidx(tl) × 1¤ptrdiff] ⧺ "' counts rather than combines")
                self.set_type(id, tl)
                return
            if not (tl = TY_UNT or ty_is_int(tl)) or not (tr = TY_UNT or ty_is_int(tr)):
                self.derr(tok, "this operator works numbers; the sides are " ⧺ type_name(tl) ⧺ " and " ⧺ type_name(tr))
                self.set_type(id, TY_I64)
                return
            if tl = TY_UNT and tr = TY_UNT and self.kind_of(na) = NK_INT and self.kind_of(nb) = NK_INT and self.a.nb[na × 1¤ptrdiff] = 0 and self.a.nb[nb × 1¤ptrdiff] = 0 and k ≠ NK_SATADD and k ≠ NK_SATSUB and k ≠ NK_SATMUL:
                self.fold_bin(id, k, tok, self.a.na[na × 1¤ptrdiff],
                              self.a.na[nb × 1¤ptrdiff])
                return
            let t : i64 = self.unify_arith(tok, id, k, tl, tr)
            if (k = NK_SHL or k = NK_SHR or k = NK_BAND or k = NK_BOR or k = NK_BXOR) and t ≠ TY_UNT and ty_unit(t) ≠ 0:
                self.derr(tok, "bit operations work plain integers, not measured ones")
            if k = NK_SHL or k = NK_SHR:
                // the count is its own number; it does not widen the value
                self.set_type(id, tl if tl ≠ TY_UNT else t)
            else:
                self.set_type(id, t)

    // as above: the negation of a folded literal wraps rather than
    // reports, since the one value that would report is the one a
    // program is entitled to write
    fn fold_neg(&mut self, id : i64, na : i64):
        let v : i64 = self.a.na[na × 1¤ptrdiff]
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← @wrap(0 - v)
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, TY_UNT)

    fn check_cmp_operands(&mut self, id : i64, tok : i64, k : i64, na : i64, nb : i64):
        let tl : i64 = self.ty_of(na)
        let tr : i64 = self.ty_of(nb)
        if tl = TY_UNT and tr = TY_UNT:
            if self.kind_of(na) = NK_INT and self.kind_of(nb) = NK_INT:
                self.fold_bin(id, k, tok, self.a.na[na × 1¤ptrdiff],
                              self.a.na[nb × 1¤ptrdiff])
                return
            self.derr(tok, "these two untyped numbers cannot meet here; state a type")
            self.set_type(id, TY_BOOL)
            return
        // Asking is not storing.  An untyped number takes the other
        // side's type here as it does anywhere -- except against an
        // enum, where becoming one would refuse a value the enum does
        // not hold and the question is only whether it matches.  It
        // settles on the enum's own width instead and is compared by
        // value.
        if tl = TY_UNT:
            self.adopt(na, self.a.ewidth[ty_eidx(tr) × 1¤ptrdiff] if ty_is_enum(tr) else tr)
        elif tr = TY_UNT:
            self.adopt(nb, self.a.ewidth[ty_eidx(tl) × 1¤ptrdiff] if ty_is_enum(tl) else tl)
        let l : i64 = self.ty_of(na)
        let r : i64 = self.ty_of(nb)
        if l = TY_CHAR and r = TY_CHAR:
            // characters order by code point; the slots hold small
            // positive numbers, so the signed compare serves
            self.set_type(id, TY_BOOL)
            return
        if ty_is_enum(l) or ty_is_enum(r):
            let e9 : i64 = l if ty_is_enum(l) else r
            let o9 : i64 = r if ty_is_enum(l) else l
            // asking is not storing: a number may be compared with an
            // enum and simply not match, where assigning one would
            // make a value the enum does not hold
            let numeric : bool = ty_is_int(o9) and ty_unit(o9) = 0
            if l ≠ r and not numeric:
                self.derr(tok, "an enum is asked about its own kind; the sides are " ⧺ type_name(l) ⧺ " and " ⧺ type_name(r))
            elif l ≠ r and self.enum_is_flag(e9):
                // a flag enum's values are combinations, which no bare
                // number names
                self.derr(tok, "a @flag enum holds combinations; a bare number names none of them")
            elif not (k = NK_EQ or k = NK_NE):
                self.derr(tok, "an enum is asked which it is; it has no order")
            self.set_type(id, TY_BOOL)
            return
        if not ty_is_int(l) or not ty_is_int(r):
            self.derr(tok, "an ordering compares numbers; the sides are " ⧺ type_name(l) ⧺ " and " ⧺ type_name(r))
        elif ty_sgn(l) ≠ ty_sgn(r):
            let sg2 : i64 = l if ty_sgn(l) = 1 else r
            let un2 : i64 = r if ty_sgn(l) = 1 else l
            if ty_bits(sg2) <= ty_bits(un2):
                self.derr(tok, "signed and unsigned do not meet; " ⧺ type_name(l) ⧺ " and " ⧺ type_name(r))
        elif ty_unit(l) ≠ ty_unit(r):
            self.derr(tok, "a value measured " ⧺ type_name(l) ⧺ " does not meet one measured " ⧺ type_name(r))
        self.set_type(id, TY_BOOL)

    fn want_bool(&mut self, id : i64, what : str):
        if self.ty_of(id) ≠ TY_BOOL:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      what ⧺ " takes truth values, but this operand is " ⧺ type_name(self.ty_of(id)) ⧺ "; a number asks its question with a comparison, as 'x ≠ 0'")

    fn want_truthy(&mut self, id : i64, what : str):
        let t : i64 = self.ty_of(id)
        if t = TY_UNT:
            self.adopt(id, TY_I64)
            return
        if ty_is_opt(t):
            // an optional in a condition asks whether a value is there
            return
        if not ty_is_int(t) and t ≠ TY_BOOL:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      what ⧺ " wants a truth value, but this is " ⧺ type_name(t))

    fn check_var(&mut self, id : i64, tok : i64):
        let name := self.text(tok)
        if name = "_":
            self.derr(tok, "'_' holds nothing and cannot be read")
            self.set_type(id, TY_I64)
            return
        let s : i64 = self.lookup(name)
        if s ≠ ⁻1:
            let st0 : i64 = self.stype[s × 1¤ptrdiff]
            let base0 : i64 = ty_strip_ref(st0)
            self.set_type(id, base0)
            self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
            // an element reference holds the element's address: a read
            // of the name reaches through it
            if ty_ref_kind(st0) ≠ 0 and ty_ref_kind(st0) ≠ 3 and not ty_is_arr(base0) and not ty_is_hash(base0) and not ty_is_struct(base0):
                self.a.nb[id × 1¤ptrdiff] ← 1
            return
        let g : i64 = self.global_index(name)
        if g = ⁻1:
            let fidx : i64 = self.fn_index(name)
            if fidx ≠ ⁻1:
                // the function's name alone: it travels as a value
                let fd := self.a.fns[fidx × 1¤ptrdiff]
                let np : i64 = self.a.extra[fd.params_off × 1¤ptrdiff]
                let ok9 : mut bool = np >= 1 and np <= 5 and fnval_ret_ok(fd.ret) and not fd.is_impure and not fd.is_replaceable and not self.fn_is_generic(fidx)
                let pts9 : mut i64[] = []
                foreach pi := 0…np - 1:
                    let pty : i64 = self.a.extra[(fd.params_off + 2 + pi × 2) × 1¤ptrdiff]
                    ok9 ← ok9 and ty_ref_kind(pty) = 0 and ((ty_is_int(pty) and ty_unit(pty) = 0) or pty = TY_BOOL or pty = TY_CHAR or pty = TY_STR)
                    pts9.push(ty_strip_ref(pty))
                if not ok9:
                    self.derr(tok, "'" ⧺ name ⧺ "' does not travel as a value; only a pure function of up to five plain scalars does")
                    self.set_type(id, TY_I64)
                    return
                self.a.nkind[id × 1¤ptrdiff] ← NK_FNVAL
                self.a.na[id × 1¤ptrdiff] ← fidx
                self.set_type(id, mk_lty(self.lam_intern(pts9, fd.ret)))
                return
            if self.is_ignored_name(name):
                self.derr(tok, "'" ⧺ name ⧺ "' expects errors under @expect and was left uncompiled")
            else:
                self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
            self.set_type(id, TY_I64)
            return
        let gd := self.a.globals[g × 1¤ptrdiff]
        if gd.is_mut and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "a mutable global is an effect; reading '" ⧺ name ⧺ "' wants @impure")
        if gd.is_mut and self.in_contract:
            self.derr(tok, "a contract's condition is pure; '" ⧺ name ⧺ "' is mutable")
        self.set_type(id, gd.ty)
        self.nslot[id × 1¤ptrdiff] ← 0 - g - 2

    fn elem_of(&self, t : i64) → i64:
        if ty_is_mat(t):
            return self.a.minner[ty_midx(t) × 1¤ptrdiff]
        self.a.fae[ty_fidx(t) × 1¤ptrdiff] if ty_is_farr(t) else ty_elem(t)

    fn farr_size(&self, t : i64) → i64:
        self.a.fas[ty_fidx(t) × 1¤ptrdiff]

    // the checker interns a named function's signature when it turns
    // into a value, as the parser interns a written-out λ's
    fn lam_intern(&mut self, pts : i64[], ret : i64) → i64:
        let n : i64 = @dropunit(#pts)
        let m : i64 = @dropunit(#self.a.ltl)
        let sh : mut i64 = 0
        while sh < m:
            if self.a.ltl[sh × 1¤ptrdiff] = n:
                let st : i64 = self.a.lts[sh × 1¤ptrdiff]
                let same : mut bool = self.a.lte[(st + n) × 1¤ptrdiff] = ret
                let i : mut i64 = 0
                while i < n:
                    same ← same and self.a.lte[(st + i) × 1¤ptrdiff] = pts[i × 1¤ptrdiff]
                    i ← i + 1
                if same:
                    return sh
            sh ← sh + 1
        self.a.lts.push(@dropunit(#self.a.lte))
        self.a.ltl.push(n)
        let j : mut i64 = 0
        while j < n:
            self.a.lte.push(pts[j × 1¤ptrdiff])
            j ← j + 1
        self.a.lte.push(ret)
        m

    fn lam_np(&self, t : i64) → i64:
        self.a.ltl[ty_lidx(t) × 1¤ptrdiff]

    fn lam_pt(&self, t : i64, i : i64) → i64:
        self.a.lte[(self.a.lts[ty_lidx(t) × 1¤ptrdiff] + i) × 1¤ptrdiff]

    fn lam_ret(&self, t : i64) → i64:
        self.a.lte[(self.a.lts[ty_lidx(t) × 1¤ptrdiff] + self.a.ltl[ty_lidx(t) × 1¤ptrdiff]) × 1¤ptrdiff]

    // the checker interns shapes a slice invents, as the parser does
    fn mat_intern(&mut self, elem : i64, r : i64, c : i64, d : i64) → i64:
        let m : i64 = @dropunit(#self.a.mel)
        let i : mut i64 = 0
        while i < m:
            if self.a.mel[i × 1¤ptrdiff] = elem and self.a.mrr[i × 1¤ptrdiff] = r and self.a.mcc[i × 1¤ptrdiff] = c and self.a.mdd[i × 1¤ptrdiff] = d:
                return i
            i ← i + 1
        let inner : mut i64 = mk_rty(elem)
        if d ≠ ⁻2:
            inner ← mk_mty(self.mat_intern(elem, c, d, ⁻2))
        // interning the plane may have grown the table, so where this
        // shape lands is asked again and not remembered from the scan
        let at : i64 = @dropunit(#self.a.mel)
        self.a.mel.push(elem)
        self.a.mrr.push(r)
        self.a.mcc.push(c)
        self.a.mdd.push(d)
        self.a.minner.push(inner)
        assert(#self.a.mel = #self.a.minner and #self.a.mel = #self.a.mdd, "shape table arrays in step")
        at

    fn mat_elem(&self, t : i64) → i64:
        self.a.mel[ty_midx(t) × 1¤ptrdiff]

    fn mat_rr(&self, t : i64) → i64:
        self.a.mrr[ty_midx(t) × 1¤ptrdiff]

    fn mat_cc(&self, t : i64) → i64:
        self.a.mcc[ty_midx(t) × 1¤ptrdiff]

    fn mat_dd(&self, t : i64) → i64:
        self.a.mdd[ty_midx(t) × 1¤ptrdiff]

    // two extents or three
    fn mat_rank(&self, t : i64) → i64:
        2 if self.a.mdd[ty_midx(t) × 1¤ptrdiff] = ⁻2 else 3

    fn tup_len(&self, t : i64) → i64:
        self.a.ttl[ty_tidx(t) × 1¤ptrdiff]

    fn tup_elem(&self, t : i64, i : i64) → i64:
        self.a.tte[(self.a.tts[ty_tidx(t) × 1¤ptrdiff] + i) × 1¤ptrdiff]

    // a tuple literal takes its shape from where it is bound: the
    // stated binding type or the function's return type says it
    // a static assertion is judged as the file is checked: constant
    // operands only, and a failure is a diagnostic, not code
    fn check_static_assert(&mut self, id : i64, tok : i64, args_off : i64, is_eq : bool):
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        self.set_type(id, TY_UNIT)
        if is_eq:
            if argc ≠ 2:
                self.derr(tok, "static_assert_eq takes the two sides")
                return
            let x : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
            let y : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
            // a bare type name stands for its own spelling here
            self.sa_fold_typename(x)
            self.sa_fold_typename(y)
            self.check_expr(x, TY_UNIT)
            self.check_expr(y, TY_UNIT)
            let kx : i64 = self.kind_of(x)
            let ky : i64 = self.kind_of(y)
            if kx = NK_STR and ky = NK_STR:
                if self.a.strs[self.a.na[x × 1¤ptrdiff] × 1¤ptrdiff] ≠ self.a.strs[self.a.na[y × 1¤ptrdiff] × 1¤ptrdiff]:
                    self.derr(tok, "static assertion failed: \"" ⧺ self.a.strs[self.a.na[x × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\" is not \"" ⧺ self.a.strs[self.a.na[y × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\"")
                return
            if (kx = NK_INT or kx = NK_BOOL) and (ky = NK_INT or ky = NK_BOOL):
                if self.a.na[x × 1¤ptrdiff] ≠ self.a.na[y × 1¤ptrdiff]:
                    self.derr(tok, "static assertion failed: " ⧺ i64_str(self.a.na[x × 1¤ptrdiff]) ⧺ " is not " ⧺ i64_str(self.a.na[y × 1¤ptrdiff]))
                return
            self.derr(tok, "static_assert_eq reads what the compiler can see: literals, folded numbers, @typeof")
            return
        if argc ≠ 1:
            self.derr(tok, "static_assert takes the condition")
            return
        let c : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        self.check_expr(c, TY_UNIT)
        let kc : i64 = self.kind_of(c)
        if kc ≠ NK_BOOL and kc ≠ NK_INT:
            self.derr(tok, "static_assert reads what the compiler can see: a condition that folds")
            return
        if self.a.na[c × 1¤ptrdiff] = 0:
            self.derr(tok, "static assertion failed")

    // i64 written bare in a static assertion is the name of the type
    fn sa_fold_typename(&mut self, e : i64):
        if self.kind_of(e) ≠ NK_VAR:
            return
        let nm := self.text(self.a.ntok[e × 1¤ptrdiff])
        if self.lookup(nm) ≠ ⁻1:
            return
        let known : bool = (TYNAMES[nm] ?? ⁻1) ≠ ⁻1 or self.struct_index(nm) ≠ ⁻1
        if not known:
            return
        self.a.strs.push(nm)
        self.a.nkind[e × 1¤ptrdiff] ← NK_STR
        self.a.na[e × 1¤ptrdiff] ← @dropunit(#self.a.strs) - 1
        self.a.nb[e × 1¤ptrdiff] ← 0
        self.set_type(e, TY_STR)

    fn ty_spell(&self, t : i64) → str:
        if t = TY_BOOL: return "bool"
        if t = TY_STR: return "str"
        if t = TY_CHAR: return "char"
        if ty_is_enum(t): return self.a.enames[ty_eidx(t) × 1¤ptrdiff]
        if ty_is_struct(t): return self.sname_of(t)
        if ty_is_int(t) and ty_unit(t) = 0:
            return ("i" if ty_sgn(t) = 1 else "u") ⧺ i64_str(ty_bits(t))
        if ty_is_farr(t):
            let esp : str = self.ty_spell(self.a.fae[ty_fidx(t) × 1¤ptrdiff])
            if esp = "": return ""
            return esp ⧺ "[" ⧺ i64_str(self.farr_size(t)) ⧺ "]"
        if ty_is_tup(t):
            let n : i64 = self.tup_len(t)
            let sp : mut str = "("
            let i : mut i64 = 0
            while i < n:
                let e : str = self.ty_spell(self.tup_elem(t, i))
                if e = "": return ""
                sp ← sp ⧺ ("" if i = 0 else ", ") ⧺ e
                i ← i + 1
            return sp ⧺ ")"
        ""

    fn check_tuple(&mut self, id : i64, tok : i64, off : i64, want : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let w : i64 = ty_strip_ref(want)
        if not ty_is_tup(w):
            self.derr(tok, "a tuple literal takes its type from where it is bound; state it there")
            let i0 : mut i64 = 0
            while i0 < n:
                self.check_expr(self.a.extra[(off + 1 + i0) × 1¤ptrdiff], TY_UNIT)
                i0 ← i0 + 1
            self.set_type(id, TY_I64)
            return
        if self.tup_len(w) ≠ n:
            self.derr(tok, "the type says " ⧺ i64_str(self.tup_len(w)) ⧺ " elements; the literal holds " ⧺ i64_str(n))
            self.set_type(id, w)
            return
        let i : mut i64 = 0
        while i < n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let et : i64 = self.tup_elem(w, i)
            self.check_expr(e, et)
            if self.is_open(self.ty_of(e)):
                self.adopt(e, et)
            elif not self.try_fit(e, et):
                self.derr(tok, "element " ⧺ i64_str(i) ⧺ " is " ⧺ type_name(et) ⧺ ", not " ⧺ type_name(self.ty_of(e)))
            i ← i + 1
        self.set_type(id, w)

    // n ⍴ x: n copies of a scalar, or an array's elements cycled to
    // the count; the binding's type says what a sized array takes
    fn check_mreshape(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        let w : i64 = ty_strip_ref(want)
        if not ty_is_mat(w):
            self.derr(tok, "a pair of extents builds a matrix; state the matrix type where it is bound")
            self.set_type(id, mk_aty(TY_I64))
            return
        let toff : i64 = self.a.na[na × 1¤ptrdiff]
        let tn : i64 = self.a.extra[toff × 1¤ptrdiff]
        let rank : i64 = self.mat_rank(w)
        if tn ≠ rank:
            self.derr(tok, "a shape states as many extents as the binding has dimensions, " ⧺ i64_str(rank) if tn > 1 else "one extent is a count, not a shape")
            self.set_type(id, w)
            return
        let re : i64 = self.a.extra[(toff + 1) × 1¤ptrdiff]
        let ce : i64 = self.a.extra[(toff + 2) × 1¤ptrdiff]
        let de : i64 = self.a.extra[(toff + rank) × 1¤ptrdiff]
        if self.kind_of(re) ≠ NK_INT or self.kind_of(ce) ≠ NK_INT or self.kind_of(de) ≠ NK_INT or self.a.nb[re × 1¤ptrdiff] ≠ 0 or self.a.nb[ce × 1¤ptrdiff] ≠ 0 or self.a.nb[de × 1¤ptrdiff] ≠ 0:
            self.derr(tok, "a matrix ⍴ states its extents as written-out numbers")
            self.set_type(id, w)
            return
        self.set_type(re, TY_I64)
        self.set_type(ce, TY_I64)
        self.set_type(de, TY_I64)
        let r : i64 = self.a.na[re × 1¤ptrdiff]
        let c : i64 = self.a.na[ce × 1¤ptrdiff]
        let d3 : i64 = self.a.na[de × 1¤ptrdiff]
        if r < 1 or c < 1 or (rank = 3 and d3 < 1):
            self.derr(tok, "a matrix has at least one row and one column")
        if self.mat_rr(w) ≠ ⁻1 and r ≠ self.mat_rr(w):
            self.derr(tok, "array size mismatch: the type says " ⧺ i64_str(self.mat_rr(w)) ⧺ " rows, got " ⧺ i64_str(r))
        if self.mat_cc(w) ≠ ⁻1 and c ≠ self.mat_cc(w):
            self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(self.mat_cc(w)) ⧺ ", got " ⧺ i64_str(c))
        if rank = 3 and self.mat_dd(w) ≠ ⁻1 and d3 ≠ self.mat_dd(w):
            self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(self.mat_dd(w)) ⧺ ", got " ⧺ i64_str(d3))
        // the filler settles as it does for a one-dimensional ⍴
        let ew : i64 = self.mat_elem(w)
        if self.kind_of(nb) = NK_ARRLIT:
            self.check_expr(nb, mk_aty(ew))
        else:
            self.check_expr(nb, ew)
        let ft : i64 = self.ty_of(nb)
        if ty_is_rg(ft):
            if ty_rgelem(ft) ≠ ew:
                self.derr(tok, "the filler counts " ⧺ type_name(ty_rgelem(ft)) ⧺ ", but the binding wants " ⧺ type_name(ew))
        elif ty_is_arr(ft):
            if self.elem_of(ft) ≠ ew:
                self.derr(tok, "the filler holds " ⧺ type_name(self.elem_of(ft)) ⧺ ", but the binding wants " ⧺ type_name(ew))
        elif self.is_open(ft):
            self.adopt(nb, ew)
        elif not self.try_fit(nb, ew):
            self.derr(tok, "the filler is " ⧺ type_name(ft) ⧺ ", but the binding wants " ⧺ type_name(ew))
        self.set_type(id, w)

    fn check_reshape(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        if self.kind_of(na) = NK_TUPLE:
            self.check_mreshape(id, tok, na, nb, want)
            return
        self.check_expr(na, TY_UNIT)
        let ct : i64 = self.ty_of(na)
        if ct = TY_UNT:
            self.adopt(na, TY_I64)
        elif not ty_is_int(ct):
            self.derr(tok, "⍴ counts with a number; this is " ⧺ type_name(ct))
        let w : i64 = ty_strip_ref(want)
        let wantish : bool = ty_is_arr(w)
        let ew : i64 = self.elem_of(w) if wantish else TY_UNIT
        // an array-literal filler settles under the array want; a
        // scalar filler settles under the element's
        if wantish and self.kind_of(nb) = NK_ARRLIT:
            self.check_expr(nb, mk_aty(ew))
        else:
            self.check_expr(nb, ew if wantish else TY_UNIT)
        let ft : i64 = self.ty_of(nb)
        if ty_is_rg(ft):
            // a range's steps cycle to the count as elements do
            if wantish and ty_rgelem(ft) ≠ self.elem_of(w):
                self.derr(tok, "the filler counts " ⧺ type_name(ty_rgelem(ft)) ⧺ ", but the binding wants " ⧺ type_name(self.elem_of(w)))
            self.set_type(id, w if wantish else mk_aty(ty_rgelem(ft)))
        elif ty_is_arr(ft):
            // the filler's elements cycle to the count
            if wantish and self.elem_of(ft) ≠ self.elem_of(w):
                self.derr(tok, "the filler holds " ⧺ type_name(self.elem_of(ft)) ⧺ ", but the binding wants " ⧺ type_name(self.elem_of(w)))
            self.set_type(id, w if wantish else mk_aty(self.elem_of(ft)))
        else:
            if self.is_open(ft):
                if wantish:
                    self.adopt(nb, ew)
                else:
                    self.derr(tok, "the filler states no type; the binding must say it")
                    self.adopt(nb, TY_I64)
            elif wantish and not self.try_fit(nb, ew):
                self.derr(tok, "the filler is " ⧺ type_name(ft) ⧺ ", but the binding wants " ⧺ type_name(ew))
            self.set_type(id, w if wantish else mk_aty(self.ty_of(nb)))
        if ty_is_farr(w) and wantish:
            // a sized binding takes its size, stated as the count
            if self.kind_of(na) ≠ NK_INT:
                self.derr(tok, "a sized array's ⍴ states its size as a written-out number")
            elif self.a.na[na × 1¤ptrdiff] ≠ self.farr_size(w):
                self.derr(tok, "array size mismatch: declared " ⧺ i64_str(self.farr_size(w)) ⧺ ", got " ⧺ i64_str(self.a.na[na × 1¤ptrdiff]))

    // the length of a written-out plane's first row, or ⁻1 where the
    // literal does not say
    fn lit_cols(&self, poff : i64) → i64:
        if self.a.extra[poff × 1¤ptrdiff] = 0:
            return ⁻1
        let r0 : i64 = self.a.extra[(poff + 1) × 1¤ptrdiff]
        ⁻1 if self.kind_of(r0) ≠ NK_ARRLIT else self.a.extra[self.a.na[r0 × 1¤ptrdiff] × 1¤ptrdiff]

    fn check_matlit(&mut self, id : i64, tok : i64, off : i64, w : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let elem : i64 = self.mat_elem(w)
        if self.mat_rank(w) = 3:
            self.check_cubelit(id, tok, off, w)
            return
        if n = 0:
            self.derr(tok, "a matrix has at least one row")
            self.set_type(id, w)
            return
        if self.mat_rr(w) ≠ ⁻1 and n ≠ self.mat_rr(w):
            self.derr(tok, "array size mismatch: the type says " ⧺ i64_str(self.mat_rr(w)) ⧺ " rows, got " ⧺ i64_str(n))
        let cwant : i64 = self.mat_cc(w)
        let c0 : mut i64 = ⁻1
        let i : mut i64 = 0
        while i < n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            if self.kind_of(e) ≠ NK_ARRLIT:
                self.derr(tok, "a matrix literal writes its rows out; a computed row is not core-2 yet")
                self.check_expr(e, TY_UNIT)
            else:
                let rl : i64 = self.a.extra[self.a.na[e × 1¤ptrdiff] × 1¤ptrdiff]
                if rl = 0:
                    self.derr(tok, "a matrix has at least one column")
                elif cwant ≠ ⁻1 and rl ≠ cwant:
                    self.derr(tok, "array size mismatch: the type says rows of " ⧺ i64_str(cwant) ⧺ ", got " ⧺ i64_str(rl))
                elif c0 = ⁻1:
                    c0 ← rl
                elif rl ≠ c0:
                    self.derr(tok, "rows of differing lengths are not a dimension; " ⧺ i64_str(c0) ⧺ " then " ⧺ i64_str(rl))
                self.check_expr(e, mk_aty(elem))
            i ← i + 1
        self.set_type(id, w)

    // a cube's elements are its planes, each a matrix literal.  Where
    // the type leaves an extent open the first plane settles it, so a
    // ragged literal is still caught.
    fn check_cubelit(&mut self, id : i64, tok : i64, off : i64, w : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            self.derr(tok, "a matrix has at least one row")
            self.set_type(id, w)
            return
