        let vmap : mut i64[] = []
        foreach vi := 0…31:
            vmap.push(⁻1)
        let j : mut i64 = 0
        while j < np:
            let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
            let pty : i64 = self.a.extra[(callee.params_off + 2 + j × 2) × 1¤ptrdiff]
            if ty_is_var(ty_strip_ref(pty)):
                self.check_expr(arg, TY_UNIT)
