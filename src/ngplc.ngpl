// ngplc — the NGPL compiler, attempt 2.
//
// Written in the bootstrap subset of NGPL and run by the Python
// interpreter; compiles the core-1 subset described in DESIGN.md to
// static x86-64 Linux ELF executables that speak only to the kernel.
//
// Usage (through the bootstrap interpreter):
//     python -m interp src/ngplc.ngpl -- program.ngpl [-o out]
//                      [--dump-tokens] [--dump-ast] [--diag=json]
//
// The pipeline is a chain of pure functions over flat arrays:
//     bytes → lex → Toks → parse → Ast → check → lower → Ir
//           → emit → code bytes → elf → a.out (or the -o name)
//
// Control flow policy (CLAUDE.md): decisions are data.  The lexer runs
// on a byte-class table and two glyph hashes rather than a branch
// tree; the code generator materializes comparisons (setcc), selects
// with conditional moves where both sides are safe to read, and turns
// dense dispatch into jump tables.  Branches that remain are cold
// paths (aborts) or semantically required (short-circuit with an
// effectful right side).

// ===========================================================================
// Token kinds
// ===========================================================================

let TK_EOF : i64 = 0
let TK_NL : i64 = 1
let TK_INDENT : i64 = 2
let TK_DEDENT : i64 = 3
let TK_IDENT : i64 = 10
let TK_INT : i64 = 11
let TK_STR : i64 = 12
// keywords core-1 parses
let TK_FN : i64 = 20
let TK_LET : i64 = 21
let TK_MUT : i64 = 22
let TK_IF : i64 = 23
let TK_ELIF : i64 = 24
let TK_ELSE : i64 = 25
let TK_WHILE : i64 = 26
let TK_FOREACH : i64 = 27
let TK_RETURN : i64 = 28
let TK_BREAK : i64 = 29
let TK_CONTINUE : i64 = 30
let TK_TRUE : i64 = 31
let TK_FALSE : i64 = 32
let TK_AND : i64 = 33
let TK_OR : i64 = 34
let TK_NOT : i64 = 35
let TK_STRUCT : i64 = 36
let TK_IMPL : i64 = 37
// punctuation and operators
let TK_LPAR : i64 = 40
let TK_RPAR : i64 = 41
let TK_COLON : i64 = 42
let TK_COMMA : i64 = 43
let TK_DOT : i64 = 44
let TK_ARROW : i64 = 45      // → or ->
let TK_ASSIGN : i64 = 46     // ← or <-
let TK_DEFINE : i64 = 47     // :=
let TK_ELLIPSIS : i64 = 48   // …
let TK_AT : i64 = 49         // @
let TK_PLUS : i64 = 50
let TK_MINUS : i64 = 51      // binary -
let TK_NEG : i64 = 52        // unary ⁻
let TK_MULT : i64 = 53       // ×
let TK_DIVIDE : i64 = 54     // ÷
let TK_MOD : i64 = 55
let TK_EQ : i64 = 56         // =
let TK_NE : i64 = 57         // ≠
let TK_LT : i64 = 58
let TK_GT : i64 = 59
let TK_LE : i64 = 60
let TK_GE : i64 = 61
let TK_SHL : i64 = 62        // « or <<
let TK_SHR : i64 = 63        // » or >>
let TK_BAND : i64 = 64       // & (also the borrow marker)
let TK_BOR : i64 = 65
let TK_BXOR : i64 = 66
let TK_BNOT : i64 = 67       // ~
let TK_LAND : i64 = 68       // ∧
let TK_LOR : i64 = 69        // ∨
let TK_LNOT : i64 = 70       // ¬
let TK_MAX : i64 = 71        // ⌈
let TK_MIN : i64 = 72        // ⌊
let TK_COALESCE : i64 = 73   // ??
let TK_LBRACK : i64 = 74
let TK_RBRACK : i64 = 75
let TK_CURRENCY : i64 = 76   // ¤
let TK_HASH : i64 = 77       // #
let TK_CONCAT : i64 = 78     // ⧺
let TK_LBRACE : i64 = 79
let TK_RBRACE : i64 = 80
let TK_QMARK : i64 = 81      // ? as a type's suffix
let TK_EXISTS : i64 = 82     // ∃
let TK_EMPTY : i64 = 83      // ∅
let TK_MATCH : i64 = 38
let TK_RESERVED : i64 = 99   // a word the bootstrap reserves and core-1 does not use

// The keyword table: one hash probe replaces a comparison ladder.  A
// word the bootstrap language reserves but core-1 gives no meaning is
// mapped to TK_RESERVED, so it is refused wherever a name is expected
// rather than quietly accepted -- the strict-subset rule.
let KEYWORDS : std.hash(str, i64) = (⸨
    "fn": 20, "let": 21, "mut": 22, "if": 23, "elif": 24, "else": 25,
    "while": 26, "foreach": 27, "return": 28, "break": 29, "continue": 30,
    "true": 31, "false": 32, "and": 33, "or": 34, "not": 35,
    "struct": 36, "impl": 37, "match": 38,
    "opt": 99, "is": 99, "import": 99, "some": 99,
    "start": 99, "test": 99, "expect": 99, "wrap": 99, "enum": 99,
    "flag": 99, "replaceable": 99, "catch": 99, "comptime": 99,
    "type": 99, "unit": 99, "impure": 99, "enumerate": 99,
    "macro": 99⸩)

// The multi-byte glyphs, keyed by their UTF-8 bytes packed into one
// number: b0×256+b1 for two-byte glyphs, b0×65536+b1×256+b2 for three.
// One hash probe per glyph instead of a branch tree over byte values.
let GLYPHS2 : std.hash(i64, i64) = (⸨
    49835: 62,      // « shl
    49851: 63,      // » shr
    49836: 70,      // ¬
    49828: 76,      // ¤
    50071: 53,      // ×
    50103: 54⸩)     // ÷

let GLYPHS3 : std.hash(i64, i64) = (⸨
    14845584: 46,   // ←
    14845586: 45,   // →
    14844347: 52,   // ⁻
    14844070: 48,   // …
    14846368: 57,   // ≠
    14846119: 68,   // ∧
    14846120: 69,   // ∨
    14847112: 71,   // ⌈
    14847114: 72,   // ⌊
    14854074: 78,   // ⧺
    14846083: 82,   // ∃
    14846085: 83⸩)  // ∅

// ===========================================================================
// Small helpers
// ===========================================================================

@post(r: #r > 0)
fn i64_str(n : i64) → str:
    if n = 0: return "0"
    let neg : bool = n < 0
    // work below zero, where every i64 has a home; the remainders come
    // out non-positive and are flipped digit by digit
    let v : mut i64 = n if neg else @wrap(0 - n)
    let s : mut str = ""
    while v ≠ 0:
        let digit : i64 = @wrap(0 - (v % 10 ?? 0))
        s ← (48 + digit).chr() ⧺ s
        v ← (v ÷ 10 ?? 0)
    ("-" ⧺ s) if neg else s

// The text of a byte run, for identifiers, keywords and messages.
@pre(off >= 0 and n >= 0)
fn run_str(src : byte[], off : i64, n : i64) → str:
    let s : mut str = ""
    let i : mut i64 = 0
    while i < n:
        let b : i64 = src[(off + i) × 1¤byte]
        s ← s ⧺ b.chr()
        i ← i + 1
    s

// ===========================================================================
// Types: one integer encodes what a value is
// ===========================================================================
//
//   0                unit (∅ -- a function that answers nothing)
//   2                bool
//   3                str
//   8                an untyped integer literal, not yet committed
//   16 + s + 2b + 256u   an integer type: s = 1 when signed, b = bits,
//                        u = 0 none, 1 ¤ptrdiff, 2 ¤byte
//   1024 + i         the struct whose definition came i-th
//   2048 + base      an optional holding a base-typed value, or ∅
//   4096 + elem      an array whose elements are the integer type elem
//
// A parameter's type may add 65536×r: r = 1 for a & borrow, 2 for &mut.

let TY_UNIT : i64 = 0
let TY_BOOL : i64 = 2
let TY_STR : i64 = 3
let TY_UNT : i64 = 8
let TY_EMPTY : i64 = 9       // a bare ∅, not yet settled on its optional
let TY_U64 : i64 = 144       // 16 + 0 + 2×64
let TY_I64 : i64 = 145       // 16 + 1 + 2×64
let TY_U8 : i64 = 32         // 16 + 0 + 2×8

let UNIT_NONE : i64 = 0
let UNIT_PTRDIFF : i64 = 1
let UNIT_BYTE : i64 = 2

@pre(sgn = 0 or sgn = 1)
@pre(bits = 8 or bits = 16 or bits = 32 or bits = 64)
@pre(u >= 0 and u <= 2)
fn mk_ity(sgn : i64, bits : i64, u : i64) → i64:
    16 + sgn + 2 × bits + 256 × u

// ty_is_int and the accessors below run for every node the checker
// touches; the encoding invariants are enforced at mk_ity and the
// other constructors instead of per read -- the recorded exception
// the contract policy allows for measured hot paths.
fn ty_is_int(t : i64) → bool:
    t >= 16 and t < 1024

fn ty_is_struct(t : i64) → bool:
    t >= 1024 and t < 2048

fn ty_is_opt(t : i64) → bool:
    t >= 2048 and t < 4096

fn mk_oty(base : i64) → i64:
    2048 + base

fn ty_opt_base(t : i64) → i64:
    t - 2048

fn mk_sty(sidx : i64) → i64:
    1024 + sidx

fn ty_sidx(t : i64) → i64:
    t - 1024

fn ty_sgn(t : i64) → i64:
    (t - 16) & 1

fn ty_bits(t : i64) → i64:
    ((t - 16) » 1) & 127

fn ty_unit(t : i64) → i64:
    (t » 8) & 3

fn ty_drop_unit(t : i64) → i64:
    t - 256 × ty_unit(t) if ty_is_int(t) else t

fn ty_with_unit(t : i64, u : i64) → i64:
    ty_drop_unit(t) + 256 × u

fn ty_is_arr(t : i64) → bool:
    t >= 4096 and t < 65536

fn ty_elem(t : i64) → i64:
    t - 4096

fn mk_aty(elem : i64) → i64:
    4096 + elem

fn ty_ref_kind(t : i64) → i64:
    t » 16

fn ty_strip_ref(t : i64) → i64:
    t & 65535

// the name of a type, as a diagnostic writes it
@post(r: #r > 0)
fn type_name(t0 : i64) → str:
    let r : i64 = ty_ref_kind(t0)
    let t : i64 = ty_strip_ref(t0)
    let prefix : str = "" if r = 0 else ("&" if r = 1 else "&mut ")
    if t = TY_UNIT: return "∅"
    if t = TY_BOOL: return prefix ⧺ "bool"
    if t = TY_STR: return prefix ⧺ "str"
    if t = TY_UNT: return "untyped integer"
    if t = TY_EMPTY: return "∅"
    if ty_is_struct(t): return prefix ⧺ "struct #" ⧺ i64_str(ty_sidx(t))
    if ty_is_opt(t): return prefix ⧺ type_name(ty_opt_base(t)) ⧺ "?"
    if ty_is_arr(t): return prefix ⧺ type_name(ty_elem(t)) ⧺ "[]"
    let base : str = ("i" if ty_sgn(t) = 1 else "u") ⧺ i64_str(ty_bits(t))
    let u : i64 = ty_unit(t)
    base if u = 0 else (base ⧺ " ¤ptrdiff" if u = 1 else base ⧺ " ¤byte")

// ===========================================================================
// Diagnostics
// ===========================================================================

struct Diag:
    line : i64
    col : i64
    msg : str

// the text of source line n, decoded, for the excerpt under a diagnostic
@pre(want >= 1)
fn line_str(src : byte[], want : i64) → str:
    let n : i64 = @dropunit(#src)
    let line : mut i64 = 1
    let i : mut i64 = 0
    let out : mut str = ""
    while i < n:
        let b : i64 = src[i × 1¤byte]
        if b = 10:
            if line = want:
                return out
            line ← line + 1
            i ← i + 1
            out ← ""
        elif line < want:
            i ← i + 1
        elif b < 128:
            out ← out ⧺ b.chr()
            i ← i + 1
        elif b < 224:
            let b1 : i64 = src[(i + 1) × 1¤byte] if i + 1 < n else 0
            out ← out ⧺ ((b - 192) × 64 + (b1 & 63)).chr()
            i ← i + 2
        elif b < 240:
            let b1 : i64 = src[(i + 1) × 1¤byte] if i + 1 < n else 0
            let b2 : i64 = src[(i + 2) × 1¤byte] if i + 2 < n else 0
            out ← out ⧺ ((b - 224) × 4096 + (b1 & 63) × 64 + (b2 & 63)).chr()
            i ← i + 3
        else:
            let b1 : i64 = src[(i + 1) × 1¤byte] if i + 1 < n else 0
            let b2 : i64 = src[(i + 2) × 1¤byte] if i + 2 < n else 0
            let b3 : i64 = src[(i + 3) × 1¤byte] if i + 3 < n else 0
            out ← out ⧺ ((b - 240) × 262144 + (b1 & 63) × 4096 + (b2 & 63) × 64 + (b3 & 63)).chr()
            i ← i + 4
    out

// ===========================================================================
// Lexing: a byte-class table drives the scan
// ===========================================================================
//
// Every byte is classified once through a 256-entry table; the class
// either is the token (entries ≥ 100 carry the token kind directly) or
// names the one handler that reads the run.  Multi-byte glyphs go
// through the GLYPHS hashes.  This is the scalar, table-driven shape of
// the mask-pipeline design DESIGN.md describes: the classes here are
// the classes a SIMD or GPU lexer computes 64 bytes at a time.

let CL_INVALID : i64 = 0
let CL_WS : i64 = 1
let CL_NL : i64 = 2
let CL_DIGIT : i64 = 3
let CL_IDENT : i64 = 4
let CL_QUOTE : i64 = 5
let CL_SLASH : i64 = 6
let CL_MB2 : i64 = 7         // two-byte glyph lead (C2, C3)
let CL_MB3 : i64 = 8         // three-byte glyph lead (E2)
let CL_TAB : i64 = 9
let CL_COLON : i64 = 10      // : or :=
let CL_LT : i64 = 11         // < <= << <-
let CL_GT : i64 = 12         // > >= >>
let CL_DASH : i64 = 13       // - or ->
let CL_QMARK : i64 = 14      // ??

// The class table, built once per run.  An entry of kind+100 is a
// complete single-byte token.
@post(t: #t = 256)
fn mkcls() → i64[]:
    let t : mut i64[] = []
    foreach _ := 0…255:
        t.push(0)
    t[32] ← CL_WS
    t[10] ← CL_NL
    t[9] ← CL_TAB
    foreach d := 48…57:
        t[d × 1¤ptrdiff] ← CL_DIGIT
    foreach c := 97…122:
        t[c × 1¤ptrdiff] ← CL_IDENT
    foreach c := 65…90:
        t[c × 1¤ptrdiff] ← CL_IDENT
    t[95] ← CL_IDENT
    t[34] ← CL_QUOTE
    t[47] ← CL_SLASH
    t[194] ← CL_MB2
    t[195] ← CL_MB2
    t[226] ← CL_MB3
    t[58] ← CL_COLON
    t[60] ← CL_LT
    t[62] ← CL_GT
    t[45] ← CL_DASH
    t[63] ← CL_QMARK
    t[40] ← 100 + TK_LPAR
    t[41] ← 100 + TK_RPAR
    t[44] ← 100 + TK_COMMA
    t[46] ← 100 + TK_DOT
    t[64] ← 100 + TK_AT
    t[43] ← 100 + TK_PLUS
    t[37] ← 100 + TK_MOD
    t[61] ← 100 + TK_EQ
    t[126] ← 100 + TK_BNOT
    t[38] ← 100 + TK_BAND
    t[124] ← 100 + TK_BOR
    t[94] ← 100 + TK_BXOR
    t[91] ← 100 + TK_LBRACK
    t[93] ← 100 + TK_RBRACK
    t[35] ← 100 + TK_HASH
    t[123] ← 100 + TK_LBRACE
    t[125] ← 100 + TK_RBRACE
    t

fn is_digit(b : i64) → bool:
    b >= 48 and b <= 57

@post(r: r >= ⁻1 and r <= 15)
fn hex_val(b : i64) → i64:
    if is_digit(b): return b - 48
    if b >= 97 and b <= 102: return b - 87
    if b >= 65 and b <= 70: return b - 55
    ⁻1

struct Toks:
    kind : i64[]
    off : i64[]
    len : i64[]
    line : i64[]
    col : i64[]
    val : i64[]      // value of TK_INT, string table index of TK_STR
    big : i64[]      // 1 when a TK_INT is in [2^63, 2^64), stored wrapped
    strs : str[]     // string literal table
    diags : Diag[]

struct Lexer:
    src : byte[]
    n : i64
    cls : i64[]
    pos : i64
    line : i64
    col : i64
    parens : i64
    kind : i64[]
    off : i64[]
    len : i64[]
    tline : i64[]
    tcol : i64[]
    val : i64[]
    big : i64[]
    strs : str[]
    indents : i64[]
    diags : Diag[]

impl Lexer:
    fn peek(&self, ahead : i64) → i64:
        if self.pos + ahead >= self.n: return ⁻1
        self.src[(self.pos + ahead) × 1¤byte]

    fn emit(&mut self, k : i64, o : i64, l : i64, c : i64, v : i64, b : i64):
        self.kind.push(k)
        self.off.push(o)
        self.len.push(l)
        self.tline.push(self.line)
        self.tcol.push(c)
        self.val.push(v)
        self.big.push(b)

    fn err(&mut self, m : str):
        self.diags.push(Diag{line: self.line, col: self.col, msg: m})
        self.pos ← self.n

    // one ASCII byte
    fn adv(&mut self):
        self.pos ← self.pos + 1
        self.col ← self.col + 1

    // a whole glyph of n bytes counts one column: columns are
    // characters, as the interpreter reports them
    fn advg(&mut self, n : i64):
        self.pos ← self.pos + n
        self.col ← self.col + 1

    fn skip_gaps(&mut self) → bool:
        while true:
            let b : i64 = self.peek(0)
            if b = ⁻1 or b = 10:
                return false
            let c : i64 = self.cls[b × 1¤ptrdiff]
            if c = CL_WS:
                self.adv()
            elif c = CL_TAB:
                self.err("tab in indentation or code; ngplc reads spaces only")
                return false
            elif c = CL_SLASH and self.peek(1) = 47:
                while self.peek(0) ≠ 10 and self.peek(0) ≠ ⁻1:
                    self.pos ← self.pos + 1
            elif c = CL_SLASH and self.peek(1) = 42:
                self.adv()
                self.adv()
                while true:
                    let d : i64 = self.peek(0)
                    if d = ⁻1:
                        self.err("unterminated block comment")
                        return false
                    if d = 42 and self.peek(1) = 47:
                        self.adv()
                        self.adv()
                        break
                    if d = 10:
                        self.pos ← self.pos + 1
                        self.line ← self.line + 1
                        self.col ← 1
                    else:
                        // any byte, including inside a multi-byte
                        // character; the column counts lead bytes only
                        self.pos ← self.pos + 1
                        self.col ← self.col + (0 if (d & 192) = 128 else 1)
            else:
                return true
        false

    fn handle_indent(&mut self):
        let width : i64 = self.col - 1
        let top : i64 = self.indents[#self.indents - 1]
        if width > top:
            self.indents.push(width)
            self.emit(TK_INDENT, self.pos, 0, self.col, 0, 0)
        else:
            while width < self.indents[#self.indents - 1]:
                _ ← self.indents.pop()
                self.emit(TK_DEDENT, self.pos, 0, self.col, 0, 0)
            if width ≠ self.indents[#self.indents - 1]:
                self.err("indentation does not match any enclosing block")

    // whether appending decimal digit d to the wrapped value v walks
    // past 2^64-1, v being read through the unsigned lens
    fn too_big_dec(&self, v : i64, d : i64) → bool:
        if v < 0:
            // already ≥ 2^63; ×10 always overflows
            return true
        let lim : i64 = 1844674407370955161
        v > lim or (v = lim and d > 5)

    fn read_number(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        let v : mut i64 = 0
        let big : mut i64 = 0
        if self.peek(0) = 48 and (self.peek(1) = 120 or self.peek(1) = 88):
            self.adv()
            self.adv()
            if hex_val(self.peek(0)) = ⁻1:
                self.err("hexadecimal literal without digits")
                return
            let digits : mut i64 = 0
            while hex_val(self.peek(0)) ≠ ⁻1:
                digits ← digits + 1
                if digits > 16:
                    self.err("integer literal does not fit u64, the widest core-1 has")
                    return
                v ← @wrap(v × 16 + hex_val(self.peek(0)))
                self.adv()
            if v < 0:
                big ← 1
        else:
            while is_digit(self.peek(0)):
                let d : i64 = self.peek(0) - 48
                if self.too_big_dec(v, d):
                    self.err("integer literal does not fit u64, the widest core-1 has")
                    return
                v ← @wrap(v × 10 + d)
                self.adv()
            if v < 0:
                big ← 1
        let nb : i64 = self.peek(0)
        if nb ≠ ⁻1 and self.cls[nb × 1¤ptrdiff] = CL_IDENT:
            self.err("a width suffix on a literal is not core-1; the type comes from use")
            return
        self.emit(TK_INT, spos, self.pos - spos, scol, v, big)

    fn read_string(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        self.adv()
        let s : mut str = ""
        while true:
            let b : i64 = self.peek(0)
            if b = ⁻1 or b = 10:
                self.err("string literal does not end before the line does")
                return
            if b = 34:
                self.adv()
                break
            if b = 92:
                let e : i64 = self.peek(1)
                if e = 110: s ← s ⧺ (10).chr()
                elif e = 116: s ← s ⧺ (9).chr()
                elif e = 114: s ← s ⧺ (13).chr()
                elif e = 92: s ← s ⧺ (92).chr()
                elif e = 34: s ← s ⧺ (34).chr()
                else:
                    self.err("unknown escape in string literal")
                    return
                self.adv()
                self.adv()
            else:
                s ← s ⧺ b.chr()
                self.pos ← self.pos + 1
                self.col ← self.col + (0 if (b & 192) = 128 else 1)
        let idx : i64 = @dropunit(#self.strs)
        self.strs.push(s)
        self.emit(TK_STR, spos, self.pos - spos, scol, idx, 0)

    fn read_ident(&mut self):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        while true:
            let b : i64 = self.peek(0)
            if b = ⁻1: break
            let c : i64 = self.cls[b × 1¤ptrdiff]
            if c ≠ CL_IDENT and c ≠ CL_DIGIT: break
            self.adv()
        let text := run_str(self.src, spos, self.pos - spos)
        self.emit(KEYWORDS[text] ?? TK_IDENT, spos, self.pos - spos, scol, 0, 0)

    // the two-character ASCII operators, reached through their class
    fn read_op2(&mut self, c : i64):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        let b1 : i64 = self.peek(1)
        let k : mut i64 = ⁻1
        let w : mut i64 = 1
        if c = CL_COLON:
            k ← TK_COLON
            if b1 = 61:
                k ← TK_DEFINE
                w ← 2
        elif c = CL_LT:
            k ← TK_LT
            if b1 = 61:
                k ← TK_LE
                w ← 2
            elif b1 = 60:
                k ← TK_SHL
                w ← 2
            elif b1 = 45:
                k ← TK_ASSIGN
                w ← 2
        elif c = CL_GT:
            k ← TK_GT
            if b1 = 61:
                k ← TK_GE
                w ← 2
            elif b1 = 62:
                k ← TK_SHR
                w ← 2
        elif c = CL_DASH:
            k ← TK_MINUS
            if b1 = 62:
                k ← TK_ARROW
                w ← 2
        else:
            k ← TK_QMARK
            if b1 = 63:
                k ← TK_COALESCE
                w ← 2
        let i : mut i64 = 0
        while i < w:
            self.adv()
            i ← i + 1
        self.emit(k, spos, w, scol, 0, 0)

    fn read_glyph(&mut self, c : i64):
        let spos : i64 = self.pos
        let scol : i64 = self.col
        if c = CL_MB2:
            let key : i64 = self.peek(0) × 256 + self.peek(1)
            let k : i64 = GLYPHS2[key] ?? ⁻1
            if k = ⁻1:
                self.err("this character begins nothing core-1 knows")
                return
            self.advg(2)
            self.emit(k, spos, 2, scol, 0, 0)
        else:
            let key : i64 = self.peek(0) × 65536 + self.peek(1) × 256 + self.peek(2)
            let k : i64 = GLYPHS3[key] ?? ⁻1
            if k = ⁻1:
                self.err("this character begins nothing core-1 knows")
                return
            self.advg(3)
            self.emit(k, spos, 3, scol, 0, 0)

fn lex(src : byte[]) → Toks:
    let lx : mut Lexer = (Lexer{src: src, n: @dropunit(#src), cls: mkcls(),
                                pos: 0, line: 1, col: 1, parens: 0,
                                kind: [], off: [], len: [], tline: [],
                                tcol: [], val: [], big: [], strs: [],
                                indents: [0], diags: []})
    let at_line_start : mut bool = true
    while lx.pos < lx.n and #lx.diags = 0:
        let more : bool = lx.skip_gaps()
        if not more:
            if lx.peek(0) = 10:
                if lx.parens = 0 and not at_line_start:
                    lx.emit(TK_NL, lx.pos, 1, lx.col, 0, 0)
                lx.pos ← lx.pos + 1
                lx.line ← lx.line + 1
                lx.col ← 1
                if lx.parens = 0:
                    at_line_start ← true
            continue
        if at_line_start:
            lx.handle_indent()
            at_line_start ← false
            if #lx.diags > 0:
                break
        let b : i64 = lx.peek(0)
        let c : i64 = lx.cls[b × 1¤ptrdiff]
        if c >= 100:
            let k : i64 = c - 100
            if k = TK_LPAR or k = TK_LBRACK or k = TK_LBRACE:
                lx.parens ← lx.parens + 1
            if (k = TK_RPAR or k = TK_RBRACK or k = TK_RBRACE) and lx.parens > 0:
                lx.parens ← lx.parens - 1
            lx.emit(k, lx.pos, 1, lx.col, 0, 0)
            lx.adv()
        elif c = CL_DIGIT:
            lx.read_number()
        elif c = CL_IDENT:
            lx.read_ident()
        elif c = CL_QUOTE:
            lx.read_string()
        elif c = CL_MB2 or c = CL_MB3:
            lx.read_glyph(c)
        elif c >= CL_COLON and c <= CL_QMARK:
            lx.read_op2(c)
        elif c = CL_SLASH:
            lx.err("'/' is not an operator; division is written ÷")
        else:
            lx.err("this byte begins nothing core-1 knows")
    if not at_line_start and #lx.diags = 0:
        lx.emit(TK_NL, lx.n, 0, lx.col, 0, 0)
    while #lx.indents > 1:
        _ ← lx.indents.pop()
        lx.emit(TK_DEDENT, lx.n, 0, 1, 0, 0)
    lx.emit(TK_EOF, lx.n, 0, 1, 0, 0)
    // the token columns are parallel arrays; leaving out of step here
    // would surface as nonsense positions far away
    assert(#lx.kind = #lx.off and #lx.kind = #lx.len, "token arrays in step")
    assert(#lx.kind = #lx.tline and #lx.kind = #lx.val and #lx.kind = #lx.big,
           "token arrays in step")
    (Toks{kind: lx.kind, off: lx.off, len: lx.len, line: lx.tline,
          col: lx.tcol, val: lx.val, big: lx.big, strs: lx.strs,
          diags: lx.diags})

// ===========================================================================
// The AST: flat parallel arrays indexed by node id
// ===========================================================================

// expressions
let NK_INT : i64 = 1        // na = value (wrapped), nb = big flag
let NK_BOOL : i64 = 2       // na = 0 or 1
let NK_STR : i64 = 3        // na = string table index
let NK_VAR : i64 = 4        // name is the token
let NK_ARRLIT : i64 = 5     // na = extra [count, elem…]
let NK_INDEX : i64 = 6      // na = base, nb = index
let NK_LEN : i64 = 7        // na = base (# of an array or a string)
let NK_CALL : i64 = 10      // na = extra [argc, arg…]; callee token
let NK_SCALL : i64 = 11     // na = builtin id, nb = extra [argc, arg…]
let NK_MCALL : i64 = 12     // na = base, nb = extra [argc, arg…]; method token
let NK_REF : i64 = 13       // na = inner, nb = 1 shared or 2 mut
let NK_SLIT : i64 = 14      // na = extra [n, field-token, expr, …]; name token
let NK_FIELD : i64 = 15     // na = base; field token
let NK_SOME : i64 = 16      // na = the value ∃ carries
let NK_EMPTYV : i64 = 17    // a bare ∅
let NK_ADD : i64 = 20
let NK_SUB : i64 = 21
let NK_MUL : i64 = 22
let NK_DIV : i64 = 23
let NK_MOD : i64 = 24
let NK_SHL : i64 = 25
let NK_SHR : i64 = 26
let NK_BAND : i64 = 27
let NK_BOR : i64 = 28
let NK_BXOR : i64 = 29
let NK_EQ : i64 = 30
let NK_NE : i64 = 31
let NK_LT : i64 = 32
let NK_LE : i64 = 33
let NK_GT : i64 = 34
let NK_GE : i64 = 35
let NK_AND : i64 = 36       // short-circuit
let NK_OR : i64 = 37        // short-circuit
let NK_LAND : i64 = 38      // ∧, both sides read
let NK_LOR : i64 = 39       // ∨
let NK_MAXOP : i64 = 40     // ⌈
let NK_MINOP : i64 = 41     // ⌊
let NK_CCAT : i64 = 42      // ⧺ on strings
let NK_NEG : i64 = 50       // ⁻
let NK_NOT : i64 = 51       // not, ¬
let NK_BNOT : i64 = 52      // ~
let NK_COND : i64 = 55      // na = then-value, nb = condition, nc = else-value
let NK_WRAP : i64 = 56      // na = inner
let NK_DEFAULT : i64 = 57   // na = the result-shaped thing, nb = default
// statements
let NK_LET : i64 = 70       // na = init, nb = 1 when mut, nc = type; name token
let NK_ASSIGN : i64 = 71    // na = value; target name token
let NK_DISCARD : i64 = 72   // na = value
let NK_IF : i64 = 73        // na = cond, nb = then block, nc = else block or ⁻1
let NK_WHILE : i64 = 74     // na = cond, nb = body
let NK_FOREACH : i64 = 75   // na = extra [lo, step or ⁻1, hi], nb = body; var token
let NK_FOREACHA : i64 = 76  // na = array expr, nb = body; var token
let NK_RETURN : i64 = 77    // na = value or ⁻1
let NK_BREAK : i64 = 78
let NK_CONTINUE : i64 = 79
let NK_EXPRSTMT : i64 = 80  // na = expr
let NK_BLOCK : i64 = 81     // na = extra [count, stmt…]
let NK_STOREIDX : i64 = 82  // na = index, nb = value; array name token
let NK_STOREFLD : i64 = 83  // na = base var, nb = value; field token
let NK_MATCH : i64 = 84     // na = subject, nb = extra [some-block, empty-block]; bind token

// std builtins reachable from core-1
let SB_PRINTLN : i64 = 1
let SB_PRINT : i64 = 2
let SB_EXIT : i64 = 3

// the base type names, one probe instead of a ladder
let TYNAMES : std.hash(str, i64) = (⸨
    "i8": 33, "i16": 49, "i32": 81, "i64": 145,
    "u8": 32, "u16": 48, "u32": 80, "u64": 144,
    "bool": 2, "str": 3⸩)

struct FnDef:
    name : str
    tok : i64
    params_off : i64     // extra: [n, name-token, type, …]
    ret : i64
    body : i64
    is_impure : bool
    is_start : bool
    is_noreturn : bool
    pre_off : i64        // extra: [n, expr…] or ⁻1
    post_off : i64       // extra: [n, name-token, expr, …] or ⁻1

struct SDef:
    name : str
    tok : i64
    fields_off : i64     // extra: [n, field-token, type, …]

struct GlobalDef:
    name : str
    tok : i64
    ty : i64
    is_mut : bool
    init : i64

struct Ast:
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    strs : str[]
    fns : FnDef[]
    globals : GlobalDef[]
    structs : SDef[]
    diags : Diag[]

// ===========================================================================
// Parsing: tokens → Ast
// ===========================================================================

struct Parser:
    toks : Toks
    src : byte[]
    pos : i64
    nkind : i64[]
    ntok : i64[]
    na : i64[]
    nb : i64[]
    nc : i64[]
    extra : i64[]
    fns : FnDef[]
    globals : GlobalDef[]
    structs : SDef[]
    snames : str[]       // struct names, pre-scanned so a struct may
                         // be written below whatever names it
    diags : Diag[]
    poisoned : bool      // the statement at hand already misparsed

impl Parser:
    fn peek(&self) → i64:
        self.toks.kind[self.pos × 1¤ptrdiff]

    fn peek2(&self) → i64:
        self.toks.kind[(self.pos + 1) × 1¤ptrdiff]

    fn ttext(&self, at : i64) → str:
        run_str(self.src, self.toks.off[at × 1¤ptrdiff],
                self.toks.len[at × 1¤ptrdiff])

    fn failed(&self) → bool:
        self.poisoned

    fn err(&mut self, m : str):
        if not self.poisoned:
            let at ¤ptrdiff : i64 = self.pos
            self.diags.push(Diag{line: self.toks.line[at],
                                 col: self.toks.col[at], msg: m})
        self.poisoned ← true
        if #self.diags >= 20:
            // enough; parking on the closing EOF stops everything
            self.pos ← @dropunit(#self.toks.kind) - 1

    // skip what is left of the misparsed statement and start clean on
    // the next line; the block structure survives through the
    // indentation tokens
    fn sync(&mut self):
        self.poisoned ← false
        while true:
            let k : i64 = self.peek()
            if k = TK_EOF or k = TK_DEDENT:
                return
            self.pos ← self.pos + 1
            if k = TK_NL:
                return

    fn eat(&mut self, k : i64, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() ≠ k:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // a name where the bootstrap's reserved words are refused by name
    fn eat_name(&mut self, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() = TK_RESERVED:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return at
        if self.peek() ≠ TK_IDENT:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    // an annotation or std-member name: reserved words are fine here,
    // since @start and std.println spell some of them
    fn eat_word(&mut self, what : str) → i64:
        let at : i64 = self.pos
        if self.peek() ≠ TK_IDENT and self.peek() ≠ TK_RESERVED:
            self.err("expected " ⧺ what)
            return at
        self.pos ← self.pos + 1
        at

    fn mknode(&mut self, k : i64, tok : i64, a : i64, b : i64, c : i64) → i64:
        let id : i64 = @dropunit(#self.nkind)
        self.nkind.push(k)
        self.ntok.push(tok)
        self.na.push(a)
        self.nb.push(b)
        self.nc.push(c)
        id

    fn push_list(&mut self, items : i64[]) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#items))
        foreach a := items:
            self.extra.push(a)
        off

    // ------------------------------------------------------------------
    // Types
    // ------------------------------------------------------------------

    // [&[mut]] base [¤unit] [[]]; refs are only meaningful on
    // parameters and the caller of parse_type says whether they may be
    fn parse_type(&mut self, allow_ref : bool) → i64:
        let refk : mut i64 = 0
        if self.peek() = TK_BAND:
            if not allow_ref:
                self.err("a borrow is written on a parameter, not here")
                return TY_I64
            self.pos ← self.pos + 1
            refk ← 1
            if self.peek() = TK_MUT:
                self.pos ← self.pos + 1
                refk ← 2
        let name := self.ttext(self.pos)
        _ ← self.eat_name("a type name")
        let base0 : i64 = TYNAMES[name] ?? self.sindex_ty(name)
        if base0 = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a core-2 type")
            return TY_I64
        let base : mut i64 = base0
        if self.peek() = TK_CURRENCY:
            self.pos ← self.pos + 1
            let utok : i64 = self.pos
            let uname := self.ttext(utok)
            _ ← self.eat_word("the unit's name")
            if not ty_is_int(base):
                self.err("only an integer carries a unit")
            elif uname = "ptrdiff":
                base ← ty_with_unit(base, UNIT_PTRDIFF)
            elif uname = "byte":
                base ← ty_with_unit(base, UNIT_BYTE)
            else:
                self.err("'¤" ⧺ uname ⧺ "' is not a core-1 unit; ptrdiff and byte are")
        if self.peek() = TK_LBRACK:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_RBRACK, "']' closing the array type")
            if not (ty_is_int(base) and ty_unit(base) = 0) and not ty_is_struct(base):
                self.err("a core-2 array holds plain integers or structs")
                return TY_I64
            base ← mk_aty(base)
        if self.peek() = TK_QMARK:
            self.pos ← self.pos + 1
            if ty_is_arr(base):
                self.err("an optional array is not core-2 yet")
                return TY_I64
            base ← mk_oty(base)
        if refk ≠ 0 and not ty_is_arr(base) and not ty_is_struct(base):
            self.err("core-2 borrows arrays and structs; a scalar travels by value")
            return TY_I64
        base + 65536 × refk

    // the pre-scanned struct names answer for a name TYNAMES does not
    fn sindex_ty(&self, name : str) → i64:
        if #self.snames > 0:
            foreach i := 0…#self.snames - 1:
                if self.snames[i] = name:
                    return mk_sty(@dropunit(i))
        ⁻1

    // the ¤unit that may follow a binding's or parameter's name
    fn parse_name_unit(&mut self) → i64:
        if self.peek() ≠ TK_CURRENCY:
            return UNIT_NONE
        self.pos ← self.pos + 1
        let uname := self.ttext(self.pos)
        _ ← self.eat_word("the unit's name")
        if uname = "ptrdiff": return UNIT_PTRDIFF
        if uname = "byte": return UNIT_BYTE
        self.err("'¤" ⧺ uname ⧺ "' is not a core-1 unit; ptrdiff and byte are")
        UNIT_NONE

    // ------------------------------------------------------------------
    // Expressions, by precedence climbing
    // ------------------------------------------------------------------

    fn parse_args(&mut self) → i64:
        _ ← self.eat(TK_LPAR, "'('")
        let args : mut i64[] = []
        if self.peek() ≠ TK_RPAR:
            while true:
                if self.peek() = TK_BAND:
                    // &x hands the callee the array itself; whether it
                    // may write is the parameter's declaration
                    let at : i64 = self.pos
                    self.pos ← self.pos + 1
                    if self.peek() = TK_MUT:
                        self.err("a borrow at a call is written &name; &mut is the parameter's side")
                        return ⁻1
                    let vtok : i64 = self.pos
                    _ ← self.eat_name("the borrowed name")
                    let v : i64 = self.mknode(NK_VAR, vtok, 0, 0, 0)
                    args.push(self.mknode(NK_REF, at, v, 1, 0))
                else:
                    args.push(self.parse_expr())
                if self.failed(): return ⁻1
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(TK_RPAR, "')' after the arguments")
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#args))
        foreach a := args:
            self.extra.push(a)
        off

    // postfix: indexing and method calls chain off a primary
    fn parse_postfix(&mut self, base0 : i64) → i64:
        let e : mut i64 = base0
        while not self.failed():
            if self.peek() = TK_LBRACK:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let idx : i64 = self.parse_expr()
                _ ← self.eat(TK_RBRACK, "']' closing the subscript")
                e ← self.mknode(NK_INDEX, at, e, idx, 0)
            elif self.peek() = TK_DOT:
                let at : i64 = self.pos
                self.pos ← self.pos + 1
                let mtok : i64 = self.pos
                _ ← self.eat_word("the member's name")
                if self.peek() = TK_LPAR:
                    let off : i64 = self.parse_args()
                    e ← self.mknode(NK_MCALL, mtok, e, off, 0)
                else:
                    e ← self.mknode(NK_FIELD, mtok, e, 0, 0)
            else:
                break
        e

    fn parse_primary(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = TK_INT:
            self.pos ← self.pos + 1
            return self.mknode(NK_INT, at, self.toks.val[at × 1¤ptrdiff],
                               self.toks.big[at × 1¤ptrdiff], 0)
        if k = TK_TRUE or k = TK_FALSE:
            self.pos ← self.pos + 1
            return self.mknode(NK_BOOL, at, 1 if k = TK_TRUE else 0, 0, 0)
        if k = TK_STR:
            self.pos ← self.pos + 1
            return self.mknode(NK_STR, at, self.toks.val[at × 1¤ptrdiff], 0, 0)
        if k = TK_NEG:
            self.pos ← self.pos + 1
            // ⁻ against a literal is part of it, as the language says
            if self.peek() = TK_INT:
                let vt : i64 = self.pos
                self.pos ← self.pos + 1
                if self.toks.big[vt × 1¤ptrdiff] = 1:
                    self.err("the literal is past i64; ⁻ has nothing to negate")
                    return 0
                return self.mknode(NK_INT, vt,
                                   @wrap(0 - self.toks.val[vt × 1¤ptrdiff]), 0, 0)
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_NEG, at, e, 0, 0)
        if k = TK_BNOT:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_BNOT, at, e, 0, 0)
        if k = TK_NOT or k = TK_LNOT:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_NOT, at, e, 0, 0)
        if k = TK_EXISTS:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_LPAR, "'(' after ∃")
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing ∃")
            return self.mknode(NK_SOME, at, e, 0, 0)
        if k = TK_EMPTY:
            self.pos ← self.pos + 1
            return self.mknode(NK_EMPTYV, at, 0, 0, 0)
        if k = TK_HASH:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_unary_operand()
            return self.mknode(NK_LEN, at, e, 0, 0)
        if k = TK_LPAR:
            self.pos ← self.pos + 1
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing the parenthesis")
            return self.parse_postfix(e)
        if k = TK_LBRACK:
            self.pos ← self.pos + 1
            let elems : mut i64[] = []
            if self.peek() ≠ TK_RBRACK:
                while true:
                    elems.push(self.parse_expr())
                    if self.failed(): return 0
                    if self.peek() = TK_COMMA:
                        self.pos ← self.pos + 1
                        if self.peek() = TK_RBRACK:
                            break
                    else:
                        break
            _ ← self.eat(TK_RBRACK, "']' closing the array literal")
            let off : i64 = self.push_list(elems)
            return self.mknode(NK_ARRLIT, at, off, 0, 0)
        if k = TK_AT:
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            if name ≠ "wrap":
                self.err("'@" ⧺ name ⧺ "' is not core-1; @wrap is the one expression annotation")
                return 0
            self.pos ← self.pos + 1
            _ ← self.eat(TK_LPAR, "'(' after @wrap")
            let e : i64 = self.parse_expr()
            _ ← self.eat(TK_RPAR, "')' closing @wrap")
            return self.mknode(NK_WRAP, at, e, 0, 0)
        if k = TK_IDENT:
            let name := self.ttext(at)
            if name = "std":
                self.pos ← self.pos + 1
                _ ← self.eat(TK_DOT, "'.' after std")
                let mtok : i64 = self.pos
                let m := self.ttext(mtok)
                _ ← self.eat_word("the std member's name")
                if m = "implementation":
                    return self.parse_implementation(at)
                let sb : mut i64 = ⁻1
                if m = "println": sb ← SB_PRINTLN
                elif m = "print": sb ← SB_PRINT
                elif m = "exit": sb ← SB_EXIT
                else:
                    self.err("'std." ⧺ m ⧺ "' is not core-1; println, print, exit and implementation are")
                    return 0
                let off : i64 = self.parse_args()
                return self.mknode(NK_SCALL, at, sb, off, 0)
            if self.peek2() = TK_LPAR:
                self.pos ← self.pos + 1
                let off : i64 = self.parse_args()
                return self.parse_postfix(self.mknode(NK_CALL, at, off, 0, 0))
            if self.peek2() = TK_LBRACE:
                self.pos ← self.pos + 2
                let items : mut i64[] = []
                if self.peek() ≠ TK_RBRACE:
                    while true:
                        items.push(self.pos)
                        _ ← self.eat_name("a field's name")
                        _ ← self.eat(TK_COLON, "':' after the field's name")
                        items.push(self.parse_expr())
                        if self.failed(): return 0
                        if self.peek() = TK_COMMA:
                            self.pos ← self.pos + 1
                        else:
                            break
                _ ← self.eat(TK_RBRACE, "'}' closing the struct literal")
                let off : i64 = @dropunit(#self.extra)
                self.extra.push(@dropunit(#items) ÷ 2 ?? 0)
                foreach it := items:
                    self.extra.push(it)
                return self.parse_postfix(self.mknode(NK_SLIT, at, off, 0, 0))
            self.pos ← self.pos + 1
            return self.parse_postfix(self.mknode(NK_VAR, at, 0, 0, 0))
        if k = TK_RESERVED:
            self.err("'" ⧺ self.ttext(at) ⧺ "' is a word the language reserves")
            return 0
        self.err("this token begins no core-2 expression")
        0

    fn parse_unary_operand(&mut self) → i64:
        self.parse_primary()

    // std.implementation says which implementation this is; ngplc
    // answers about itself, folded to constants before anything runs,
    // so a comptime check reads them for free
    fn impl_str(&mut self, s : str) → i64:
        if #self.toks.strs > 0:
            foreach i := 0…#self.toks.strs - 1:
                if self.toks.strs[i] = s:
                    return @dropunit(i)
        let idx : i64 = @dropunit(#self.toks.strs)
        self.toks.strs.push(s)
        idx

    fn parse_implementation(&mut self, at : i64) → i64:
        _ ← self.eat(TK_DOT, "'.' after std.implementation")
        let mtok : i64 = self.pos
        let m := self.ttext(mtok)
        _ ← self.eat_word("the member's name")
        if m = "interpreter":
            return self.mknode(NK_BOOL, at, 0, 0, 0)
        if m = "compiled":
            return self.mknode(NK_BOOL, at, 1, 0, 0)
        if m = "name":
            return self.mknode(NK_STR, at, self.impl_str("ngplc"), 0, 0)
        if m = "language":
            return self.mknode(NK_STR, at, self.impl_str("core-1"), 0, 0)
        self.err("'std.implementation." ⧺ m ⧺ "' is not a member; name, language, interpreter and compiled are")
        0

    // binding power of a binary operator token; ⁻1 when it is none.
    // The numbers follow the bootstrap parser's ladder.
    fn bin_bp(&self, k : i64) → i64:
        if k = TK_OR or k = TK_COALESCE: return 2
        if k = TK_AND: return 3
        if k = TK_LOR: return 4
        if k = TK_LAND: return 6
        if k = TK_EQ or k = TK_NE or k = TK_LT or k = TK_GT or k = TK_LE or k = TK_GE: return 7
        if k = TK_MAX or k = TK_MIN: return 9
        if k = TK_SHL or k = TK_SHR: return 10
        if k = TK_BOR: return 11
        if k = TK_BXOR: return 12
        if k = TK_BAND: return 13
        if k = TK_PLUS or k = TK_MINUS: return 14
        if k = TK_CONCAT: return 15
        if k = TK_MULT or k = TK_DIVIDE or k = TK_MOD: return 16
        ⁻1

    fn bin_nk(&self, k : i64) → i64:
        if k = TK_OR: return NK_OR
        if k = TK_COALESCE: return NK_DEFAULT
        if k = TK_AND: return NK_AND
        if k = TK_LOR: return NK_LOR
        if k = TK_LAND: return NK_LAND
        if k = TK_EQ: return NK_EQ
        if k = TK_NE: return NK_NE
        if k = TK_LT: return NK_LT
        if k = TK_GT: return NK_GT
        if k = TK_LE: return NK_LE
        if k = TK_GE: return NK_GE
        if k = TK_MAX: return NK_MAXOP
        if k = TK_MIN: return NK_MINOP
        if k = TK_SHL: return NK_SHL
        if k = TK_SHR: return NK_SHR
        if k = TK_BOR: return NK_BOR
        if k = TK_BXOR: return NK_BXOR
        if k = TK_BAND: return NK_BAND
        if k = TK_PLUS: return NK_ADD
        if k = TK_MINUS: return NK_SUB
        if k = TK_CONCAT: return NK_CCAT
        if k = TK_MULT: return NK_MUL
        if k = TK_DIVIDE: return NK_DIV
        if k = TK_MOD: return NK_MOD
        0

    fn parse_bin(&mut self, min_bp : i64) → i64:
        let lhs : mut i64 = self.parse_primary()
        while not self.failed():
            let k : i64 = self.peek()
            let bp : i64 = self.bin_bp(k)
            if bp = ⁻1 or bp < min_bp:
                break
            let at : i64 = self.pos
            self.pos ← self.pos + 1
            let rhs : i64 = self.parse_bin(bp + 1)
            lhs ← self.mknode(self.bin_nk(k), at, lhs, rhs, 0)
        lhs

    fn parse_expr(&mut self) → i64:
        let v : i64 = self.parse_bin(2)
        if self.failed(): return v
        if self.peek() ≠ TK_IF:
            return v
        // v if cond else w — only the side taken is read
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_bin(2)
        _ ← self.eat(TK_ELSE, "'else' after the condition of a conditional expression")
        let w : i64 = self.parse_expr()
        self.mknode(NK_COND, at, v, cond, w)

    // ------------------------------------------------------------------
    // Statements and blocks
    // ------------------------------------------------------------------

    fn parse_block(&mut self) → i64:
        _ ← self.eat(TK_COLON, "':' beginning the block")
        let stmts : mut i64[] = []
        if self.peek() ≠ TK_NL:
            stmts.push(self.parse_stmt())
        else:
            self.pos ← self.pos + 1
            _ ← self.eat(TK_INDENT, "an indented block")
            while self.peek() ≠ TK_DEDENT and self.peek() ≠ TK_EOF:
                stmts.push(self.parse_stmt())
                if self.poisoned:
                    // this statement is lost; the next line starts over
                    _ ← stmts.pop()
                    self.sync()
                    if self.peek() = TK_INDENT:
                        // a block hangs off the broken statement;
                        // nothing owns it now, so it is skipped whole
                        self.skip_block()
            _ ← self.eat(TK_DEDENT, "the end of the block")
        let off : i64 = self.push_list(stmts)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    // step over a balanced INDENT…DEDENT run
    fn skip_block(&mut self):
        let depth : mut i64 = 0
        while self.peek() ≠ TK_EOF:
            if self.peek() = TK_INDENT:
                depth ← depth + 1
            elif self.peek() = TK_DEDENT:
                depth ← depth - 1
                if depth = 0:
                    self.pos ← self.pos + 1
                    return
            self.pos ← self.pos + 1

    fn end_stmt(&mut self):
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        elif self.peek() = TK_DEDENT or self.peek() = TK_EOF:
            let keep : i64 = 0
        else:
            self.err("the statement has ended but the line has more on it")

    fn parse_let(&mut self) → i64:
        self.pos ← self.pos + 1
        let name_tok : i64 = self.pos
        _ ← self.eat_name("the name the let binds")
        let u : i64 = self.parse_name_unit()
        if self.peek() = TK_DEFINE:
            self.err("core-1 asks for the type: 'let x : i64 = …'")
            return 0
        _ ← self.eat(TK_COLON, "':' and the type of the binding")
        let is_mut : mut i64 = 0
        if self.peek() = TK_MUT:
            is_mut ← 1
            self.pos ← self.pos + 1
        let ty0 : i64 = self.parse_type(false)
        let ty : mut i64 = ty0
        if u ≠ UNIT_NONE:
            if not ty_is_int(ty):
                self.err("only an integer carries a unit")
            elif ty_unit(ty) ≠ 0 and ty_unit(ty) ≠ u:
                self.err("the name and the type say different units")
            else:
                ty ← ty_with_unit(ty, u)
        _ ← self.eat(TK_EQ, "'=' and the initial value")
        let init : i64 = self.parse_expr()
        self.end_stmt()
        self.mknode(NK_LET, name_tok, init, is_mut, ty)

    fn parse_stmt(&mut self) → i64:
        let k : i64 = self.peek()
        let at : i64 = self.pos
        if k = TK_LET:
            return self.parse_let()
        if k = TK_IF:
            self.pos ← self.pos + 1
            let cond : i64 = self.parse_expr()
            let then_blk : i64 = self.parse_block()
            let else_blk : mut i64 = ⁻1
            if self.peek() = TK_ELIF:
                else_blk ← self.parse_elif_chain()
            elif self.peek() = TK_ELSE:
                self.pos ← self.pos + 1
                else_blk ← self.parse_block()
            return self.mknode(NK_IF, at, cond, then_blk, else_blk)
        if k = TK_WHILE:
            self.pos ← self.pos + 1
            let cond : i64 = self.parse_expr()
            let body : i64 = self.parse_block()
            return self.mknode(NK_WHILE, at, cond, body, 0)
        if k = TK_FOREACH:
            self.pos ← self.pos + 1
            let name_tok : i64 = self.pos
            if self.peek() = TK_IDENT or self.peek() = TK_RESERVED:
                _ ← self.eat_name("the loop variable")
            else:
                self.err("expected the loop variable")
                return 0
            _ ← self.eat(TK_DEFINE, "':=' before what the loop walks")
            let e1 : i64 = self.parse_bin(2)
            if self.peek() ≠ TK_ELLIPSIS:
                // walking an array's elements
                let body : i64 = self.parse_block()
                return self.mknode(NK_FOREACHA, name_tok, e1, body, 0)
            self.pos ← self.pos + 1
            let e2 : i64 = self.parse_bin(2)
            let step : mut i64 = ⁻1
            let hi : mut i64 = e2
            if self.peek() = TK_ELLIPSIS:
                self.pos ← self.pos + 1
                step ← e2
                hi ← self.parse_bin(2)
            let body : i64 = self.parse_block()
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(e1)
            self.extra.push(step)
            self.extra.push(hi)
            return self.mknode(NK_FOREACH, name_tok, off, body, 0)
        if k = TK_MATCH:
            self.pos ← self.pos + 1
            let subject : i64 = self.parse_expr()
            _ ← self.eat(TK_COLON, "':' after the subject")
            _ ← self.eat(TK_NL, "the arms on their own lines")
            _ ← self.eat(TK_INDENT, "an indented arm list")
            let some_blk : mut i64 = ⁻1
            let empty_blk : mut i64 = ⁻1
            let bind_tok : mut i64 = ⁻1
            while self.peek() ≠ TK_DEDENT and not self.failed():
                if self.peek() = TK_EXISTS:
                    if some_blk ≠ ⁻1:
                        self.err("match repeats the ∃ pattern")
                        return 0
                    self.pos ← self.pos + 1
                    _ ← self.eat(TK_LPAR, "'(' after ∃")
                    bind_tok ← self.pos
                    _ ← self.eat_name("the name ∃ binds")
                    _ ← self.eat(TK_RPAR, "')' closing the pattern")
                    some_blk ← self.parse_block()
                elif self.peek() = TK_EMPTY:
                    if empty_blk ≠ ⁻1:
                        self.err("match repeats the ∅ pattern")
                        return 0
                    self.pos ← self.pos + 1
                    empty_blk ← self.parse_block()
                elif self.peek() = TK_NL:
                    self.pos ← self.pos + 1
                else:
                    self.err("a core-2 match arm is ∃(name) or ∅")
                    return 0
            _ ← self.eat(TK_DEDENT, "the end of the match")
            if some_blk = ⁻1:
                self.err("match has no arm for ∃")
                return 0
            if empty_blk = ⁻1:
                self.err("match has no arm for ∅")
                return 0
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(some_blk)
            self.extra.push(empty_blk)
            return self.mknode(NK_MATCH, bind_tok, subject, off, 0)
        if k = TK_RETURN:
            self.pos ← self.pos + 1
            let v : mut i64 = ⁻1
            if self.peek() ≠ TK_NL and self.peek() ≠ TK_DEDENT:
                v ← self.parse_expr()
            self.end_stmt()
            return self.mknode(NK_RETURN, at, v, 0, 0)
        if k = TK_BREAK:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(NK_BREAK, at, 0, 0, 0)
        if k = TK_CONTINUE:
            self.pos ← self.pos + 1
            self.end_stmt()
            return self.mknode(NK_CONTINUE, at, 0, 0, 0)
        if k = TK_IDENT and self.peek2() = TK_ASSIGN:
            let name := self.ttext(at)
            self.pos ← self.pos + 2
            let v : i64 = self.parse_expr()
            self.end_stmt()
            if name = "_":
                return self.mknode(NK_DISCARD, at, v, 0, 0)
            return self.mknode(NK_ASSIGN, at, v, 0, 0)
        if k = TK_IDENT and self.peek2() = TK_DOT and self.toks.kind[(self.pos + 3) × 1¤ptrdiff] = TK_ASSIGN:
            let base : i64 = self.mknode(NK_VAR, at, 0, 0, 0)
            let ftok : i64 = self.pos + 2
            self.pos ← self.pos + 2
            _ ← self.eat_name("the field's name")
            _ ← self.eat(TK_ASSIGN, "'←' after the field")
            let v : i64 = self.parse_expr()
            self.end_stmt()
            return self.mknode(NK_STOREFLD, ftok, base, v, 0)
        if k = TK_IDENT and self.peek2() = TK_LBRACK:
            // a[i] ← v writes an element, a[i].f ← v a field of one;
            // anything else falls through to the expression path below
            let save : i64 = self.pos
            self.pos ← self.pos + 2
            let idx : i64 = self.parse_expr()
            if not self.failed() and self.peek() = TK_RBRACK and self.peek2() = TK_ASSIGN:
                self.pos ← self.pos + 2
                let v : i64 = self.parse_expr()
                self.end_stmt()
                return self.mknode(NK_STOREIDX, at, idx, v, 0)
            if not self.failed() and self.peek() = TK_RBRACK and self.peek2() = TK_DOT and self.toks.kind[(self.pos + 2) × 1¤ptrdiff] = TK_IDENT and self.toks.kind[(self.pos + 3) × 1¤ptrdiff] = TK_ASSIGN:
                let base : i64 = self.mknode(NK_VAR, at, 0, 0, 0)
                let elem : i64 = self.mknode(NK_INDEX, at, base, idx, 0)
                let ftok : i64 = self.pos + 2
                self.pos ← self.pos + 4
                let v : i64 = self.parse_expr()
                self.end_stmt()
                return self.mknode(NK_STOREFLD, ftok, elem, v, 0)
            self.pos ← save
        let e : i64 = self.parse_expr()
        self.end_stmt()
        self.mknode(NK_EXPRSTMT, at, e, 0, 0)

    fn parse_elif_chain(&mut self) → i64:
        let at : i64 = self.pos
        self.pos ← self.pos + 1
        let cond : i64 = self.parse_expr()
        let then_blk : i64 = self.parse_block()
        let else_blk : mut i64 = ⁻1
        if self.peek() = TK_ELIF:
            else_blk ← self.parse_elif_chain()
        elif self.peek() = TK_ELSE:
            self.pos ← self.pos + 1
            else_blk ← self.parse_block()
        let ifn : i64 = self.mknode(NK_IF, at, cond, then_blk, else_blk)
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(ifn)
        self.mknode(NK_BLOCK, 0, off, 0, 0)

    // ------------------------------------------------------------------
    // Definitions
    // ------------------------------------------------------------------

    fn parse_fn(&mut self, imp : bool, is_start : bool, is_noreturn : bool,
                pres : i64[], post_toks : i64[], posts : i64[],
                prefix : str, self_sty : i64):
        _ ← self.eat(TK_FN, "'fn'")
        let name_tok : i64 = self.pos
        let name0 := self.ttext(name_tok)
        let name : str = name0 if prefix = "" else prefix ⧺ "." ⧺ name0
        _ ← self.eat_name("the function's name")
        _ ← self.eat(TK_LPAR, "'(' and the parameters")
        let ptoks : mut i64[] = []
        let ptypes : mut i64[] = []
        if self_sty ≠ 0 and self.peek() = TK_BAND:
            // the receiver: &self reads, &mut self changes
            self.pos ← self.pos + 1
            let srk : mut i64 = 1
            if self.peek() = TK_MUT:
                self.pos ← self.pos + 1
                srk ← 2
            let stok : i64 = self.pos
            if self.ttext(stok) ≠ "self":
                self.err("a method's receiver is spelled &self or &mut self")
                return
            self.pos ← self.pos + 1
            ptoks.push(stok)
            ptypes.push(self_sty + 65536 × srk)
            if self.peek() = TK_COMMA:
                self.pos ← self.pos + 1
        if self.peek() ≠ TK_RPAR:
            while true:
                ptoks.push(self.pos)
                _ ← self.eat_name("a parameter name")
                let u : i64 = self.parse_name_unit()
                _ ← self.eat(TK_COLON, "':' and the parameter's type")
                let ty0 : i64 = self.parse_type(true)
                let ty : mut i64 = ty0
                if u ≠ UNIT_NONE:
                    if not ty_is_int(ty_strip_ref(ty)):
                        self.err("only an integer carries a unit")
                    else:
                        ty ← ty_with_unit(ty_strip_ref(ty), u) + 65536 × ty_ref_kind(ty)
                ptypes.push(ty)
                if self.failed(): return
                if self.peek() = TK_COMMA:
                    self.pos ← self.pos + 1
                else:
                    break
        _ ← self.eat(TK_RPAR, "')' after the parameters")
        let ret : mut i64 = TY_UNIT
        if self.peek() = TK_ARROW:
            self.pos ← self.pos + 1
            ret ← self.parse_type(false)
        let body : i64 = self.parse_block()
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        let params_off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ptoks))
        if #ptoks > 0:
            foreach i := 0…#ptoks - 1:
                self.extra.push(ptoks[i])
                self.extra.push(ptypes[i])
        let pre_off : mut i64 = ⁻1
        if #pres > 0:
            pre_off ← self.push_list(pres)
        let post_off : mut i64 = ⁻1
        if #posts > 0:
            post_off ← @dropunit(#self.extra)
            self.extra.push(@dropunit(#posts))
            foreach i := 0…#posts - 1:
                self.extra.push(post_toks[i])
                self.extra.push(posts[i])
        self.fns.push(FnDef{name: name, tok: name_tok, params_off: params_off,
                            ret: ret, body: body, is_impure: imp,
                            is_start: is_start, is_noreturn: is_noreturn,
                            pre_off: pre_off, post_off: post_off})

    fn parse_struct(&mut self):
        _ ← self.eat(TK_STRUCT, "'struct'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        _ ← self.eat(TK_COLON, "':' after the struct's name")
        _ ← self.eat(TK_NL, "the fields on their own lines")
        _ ← self.eat(TK_INDENT, "an indented field list")
        let ftoks : mut i64[] = []
        let ftypes : mut i64[] = []
        while self.peek() ≠ TK_DEDENT and not self.failed():
            ftoks.push(self.pos)
            _ ← self.eat_name("a field's name")
            _ ← self.eat(TK_COLON, "':' and the field's type")
            let ty : i64 = self.parse_type(false)
            if ty_is_int(ty) and ty_unit(ty) ≠ 0:
                self.err("a struct field carries no unit in the bootstrap")
            if ty_is_struct(ty):
                self.err("a struct inside a struct is not core-2 yet; an array of them works")
            ftypes.push(ty)
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        _ ← self.eat(TK_DEDENT, "the end of the struct")
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#ftoks))
        if #ftoks > 0:
            foreach i := 0…#ftoks - 1:
                self.extra.push(ftoks[i])
                self.extra.push(ftypes[i])
        self.structs.push(SDef{name: name, tok: name_tok, fields_off: off})

    fn parse_impl(&mut self):
        _ ← self.eat(TK_IMPL, "'impl'")
        let name_tok : i64 = self.pos
        let name := self.ttext(name_tok)
        _ ← self.eat_name("the struct's name")
        let sty : i64 = self.sindex_ty(name)
        if sty = ⁻1:
            self.err("'" ⧺ name ⧺ "' is not a struct this program defines")
            return
        _ ← self.eat(TK_COLON, "':' after the name")
        _ ← self.eat(TK_NL, "the methods on their own lines")
        _ ← self.eat(TK_INDENT, "an indented method list")
        while self.peek() ≠ TK_DEDENT and not self.failed():
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
                continue
            let imp : mut bool = false
            let is_noreturn : mut bool = false
            let pres : mut i64[] = []
            let post_toks : mut i64[] = []
            let posts : mut i64[] = []
            while self.peek() = TK_AT and not self.failed():
                self.pos ← self.pos + 1
                let aname := self.ttext(self.pos)
                _ ← self.eat_word("the annotation's name")
                if aname = "impure":
                    imp ← true
                elif aname = "noreturn":
                    is_noreturn ← true
                elif aname = "pre":
                    _ ← self.eat(TK_LPAR, "'(' after @pre")
                    pres.push(self.parse_expr())
                    _ ← self.eat(TK_RPAR, "')' closing @pre")
                elif aname = "post":
                    _ ← self.eat(TK_LPAR, "'(' after @post")
                    post_toks.push(self.pos)
                    _ ← self.eat_name("the name @post gives the result")
                    _ ← self.eat(TK_COLON, "':' after the result's name")
                    posts.push(self.parse_expr())
                    _ ← self.eat(TK_RPAR, "')' closing @post")
                else:
                    self.err("'@" ⧺ aname ⧺ "' is not core-2 on a method")
                    return
                if self.peek() = TK_NL:
                    self.pos ← self.pos + 1
            if self.peek() = TK_FN:
                self.parse_fn(imp, false, is_noreturn, pres, post_toks, posts,
                              name, sty)
            else:
                self.err("an impl block holds methods and nothing else")
        _ ← self.eat(TK_DEDENT, "the end of the impl block")
        if self.peek() = TK_NL:
            self.pos ← self.pos + 1

    fn parse_global(&mut self):
        // a top-level let: the same shape a local has
        let stmt : i64 = self.parse_let()
        if self.failed(): return
        let tok : i64 = self.ntok[stmt × 1¤ptrdiff]
        self.globals.push(GlobalDef{name: self.ttext(tok), tok: tok,
                                    ty: self.nc[stmt × 1¤ptrdiff],
                                    is_mut: self.nb[stmt × 1¤ptrdiff] = 1,
                                    init: self.na[stmt × 1¤ptrdiff]})

    fn parse_toplevel(&mut self):
        let imp : mut bool = false
        let is_start : mut bool = false
        let is_noreturn : mut bool = false
        let pres : mut i64[] = []
        let post_toks : mut i64[] = []
        let posts : mut i64[] = []
        while self.peek() = TK_AT and not self.failed():
            self.pos ← self.pos + 1
            let name := self.ttext(self.pos)
            _ ← self.eat_word("the annotation's name")
            if name = "impure":
                imp ← true
            elif name = "start":
                is_start ← true
            elif name = "noreturn":
                is_noreturn ← true
            elif name = "pre":
                _ ← self.eat(TK_LPAR, "'(' after @pre")
                pres.push(self.parse_expr())
                _ ← self.eat(TK_RPAR, "')' closing @pre")
            elif name = "post":
                _ ← self.eat(TK_LPAR, "'(' after @post")
                post_toks.push(self.pos)
                _ ← self.eat_name("the name @post gives the result")
                _ ← self.eat(TK_COLON, "':' after the result's name")
                posts.push(self.parse_expr())
                _ ← self.eat(TK_RPAR, "')' closing @post")
            else:
                self.err("'@" ⧺ name ⧺ "' is not core-1")
                return
            if self.peek() = TK_NL:
                self.pos ← self.pos + 1
        if self.peek() = TK_FN:
            self.parse_fn(imp, is_start, is_noreturn, pres, post_toks, posts,
                          "", 0)
        elif self.peek() = TK_STRUCT or self.peek() = TK_IMPL:
            if imp or is_start or is_noreturn or #pres > 0 or #posts > 0:
                self.err("a struct carries no annotations")
            elif self.peek() = TK_STRUCT:
                self.parse_struct()
            else:
                self.parse_impl()
        elif self.peek() = TK_LET:
            if imp or is_start or is_noreturn or #pres > 0 or #posts > 0:
                self.err("a global binding carries no annotations")
            else:
                self.parse_global()
        else:
            self.err("core-2 has functions, structs, impl blocks and global bindings at the top level")

fn parse(toks : Toks, src : byte[]) → Ast:
    let p : mut Parser = (Parser{toks: toks, src: src, pos: 0,
                                 nkind: [], ntok: [], na: [], nb: [], nc: [],
                                 extra: [], fns: [], globals: [], structs: [],
                                 snames: [], diags: [], poisoned: false})
    // a struct may be written below whatever names it, so the names
    // are gathered in one sweep before anything is parsed
    let n : i64 = @dropunit(#toks.kind)
    let i : mut i64 = 0
    while i + 1 < n:
        if toks.kind[i × 1¤ptrdiff] = TK_STRUCT and toks.kind[(i + 1) × 1¤ptrdiff] = TK_IDENT:
            p.snames.push(run_str(src, toks.off[(i + 1) × 1¤ptrdiff],
                                  toks.len[(i + 1) × 1¤ptrdiff]))
        i ← i + 1
    while p.peek() ≠ TK_EOF:
        if p.peek() = TK_NL:
            p.pos ← p.pos + 1
        else:
            p.parse_toplevel()
            if p.poisoned:
                p.poisoned ← false
                // hunt for the next definition at the left margin
                while p.peek() ≠ TK_EOF:
                    let k2 : i64 = p.peek()
                    if k2 = TK_INDENT:
                        p.skip_block()
                    elif k2 = TK_FN or k2 = TK_STRUCT or k2 = TK_IMPL or k2 = TK_LET or k2 = TK_AT:
                        break
                    else:
                        p.pos ← p.pos + 1
    if #p.diags = 0:
        // the type table was built from the pre-scan; a parse that
        // succeeded must have seen the same structs in the same order
        assert(#p.structs = #p.snames, "every pre-scanned struct parsed")
        assert(#p.nkind = #p.ntok and #p.nkind = #p.na, "node arrays in step")
        assert(#p.nkind = #p.nb and #p.nkind = #p.nc, "node arrays in step")
    (Ast{nkind: p.nkind, ntok: p.ntok, na: p.na, nb: p.nb, nc: p.nc,
         extra: p.extra, strs: p.toks.strs, fns: p.fns, globals: p.globals,
         structs: p.structs, diags: p.diags})

// ===========================================================================
// AST dump, one node a line
// ===========================================================================

@impure
fn dump_node(a : Ast, id : i64, depth : i64, src : byte[], toks : Toks):
    let pad : mut str = ""
    let d : mut i64 = 0
    while d < depth:
        pad ← pad ⧺ "  "
        d ← d + 1
    let k : i64 = a.nkind[id × 1¤ptrdiff]
    let tok : i64 = a.ntok[id × 1¤ptrdiff]
    let na : i64 = a.na[id × 1¤ptrdiff]
    let nb : i64 = a.nb[id × 1¤ptrdiff]
    let nc : i64 = a.nc[id × 1¤ptrdiff]
    let ttext : str = run_str(src, toks.off[tok × 1¤ptrdiff], toks.len[tok × 1¤ptrdiff])
    if k = NK_INT:
        std.println("{}int {} big={}", pad, na, nb)
    elif k = NK_BOOL:
        std.println("{}bool {}", pad, na)
    elif k = NK_STR:
        std.println("{}str \"{}\"", pad, a.strs[na × 1¤ptrdiff])
    elif k = NK_VAR:
        std.println("{}var {}", pad, ttext)
    elif k = NK_ARRLIT:
        std.println("{}arrlit", pad)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_INDEX:
        std.println("{}index", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_LEN:
        std.println("{}len", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_CALL:
        std.println("{}call {}", pad, ttext)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_SCALL:
        std.println("{}scall {}", pad, na)
        let n : i64 = a.extra[nb × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(nb + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_MCALL:
        std.println("{}mcall {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        let n : i64 = a.extra[nb × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(nb + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_REF:
        std.println("{}ref {}", pad, nb)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_SLIT:
        std.println("{}slit {}", pad, ttext)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 2 + i × 2) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_FIELD:
        std.println("{}field {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_STOREFLD:
        std.println("{}storefld {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_BLOCK:
        std.println("{}block", pad)
        let n : i64 = a.extra[na × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            dump_node(a, a.extra[(na + 1 + i) × 1¤ptrdiff], depth + 1, src, toks)
            i ← i + 1
    elif k = NK_LET:
        std.println("{}let {} mut={} ty={}", pad, ttext, nb, type_name(nc))
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_ASSIGN:
        std.println("{}assign {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_STOREIDX:
        std.println("{}storeidx {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_DISCARD:
        std.println("{}discard", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_IF:
        std.println("{}if", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
        if nc ≠ ⁻1:
            std.println("{}else", pad)
            dump_node(a, nc, depth + 1, src, toks)
    elif k = NK_WHILE:
        std.println("{}while", pad)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_FOREACH:
        std.println("{}foreach {}", pad, ttext)
        dump_node(a, a.extra[na × 1¤ptrdiff], depth + 1, src, toks)
        if a.extra[(na + 1) × 1¤ptrdiff] ≠ ⁻1:
            dump_node(a, a.extra[(na + 1) × 1¤ptrdiff], depth + 1, src, toks)
        dump_node(a, a.extra[(na + 2) × 1¤ptrdiff], depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_FOREACHA:
        std.println("{}foreacha {}", pad, ttext)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)
    elif k = NK_RETURN:
        std.println("{}return", pad)
        if na ≠ ⁻1:
            dump_node(a, na, depth + 1, src, toks)
    elif k = NK_BREAK:
        std.println("{}break", pad)
    elif k = NK_CONTINUE:
        std.println("{}continue", pad)
    elif k = NK_EXPRSTMT:
        std.println("{}exprstmt", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_COND:
        std.println("{}cond", pad)
        dump_node(a, nb, depth + 1, src, toks)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nc, depth + 1, src, toks)
    elif k = NK_WRAP:
        std.println("{}wrap", pad)
        dump_node(a, na, depth + 1, src, toks)
    elif k = NK_NEG or k = NK_NOT or k = NK_BNOT:
        std.println("{}unop {}", pad, k)
        dump_node(a, na, depth + 1, src, toks)
    else:
        std.println("{}binop {}", pad, k)
        dump_node(a, na, depth + 1, src, toks)
        dump_node(a, nb, depth + 1, src, toks)

@impure
fn dump_ast(a : Ast, src : byte[], toks : Toks):
    foreach g := a.globals:
        std.println("global {} mut={} ty={}", g.name, g.is_mut, type_name(g.ty))
        dump_node(a, g.init, 1, src, toks)
    foreach f := a.fns:
        std.println("fn {} ret={} impure={} start={}", f.name,
                    type_name(f.ret), f.is_impure, f.is_start)
        let np : i64 = a.extra[f.params_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < np:
            let ptok : i64 = a.extra[(f.params_off + 1 + i × 2) × 1¤ptrdiff]
            let pty : i64 = a.extra[(f.params_off + 2 + i × 2) × 1¤ptrdiff]
            std.println("  param {} : {}", run_str(src, toks.off[ptok × 1¤ptrdiff], toks.len[ptok × 1¤ptrdiff]), type_name(pty))
            i ← i + 1
        dump_node(a, f.body, 1, src, toks)

// ===========================================================================
// Checking: names, types, widths, units, mutability, purity, returns
// ===========================================================================

// method ids the checker writes into an MCALL's nc
let MID_PUSH : i64 = 1
let MID_POP : i64 = 2
let MID_GET : i64 = 3

struct Chk:
    ntype : i64[]
    nslot : i64[]
    fslots : i64[]
    gvals : i64[]        // the folded initial value of every global
    diags : Diag[]

struct Checker:
    a : Ast
    toks : Toks
    src : byte[]
    fnames : str[]
    gnames : str[]
    gvals : i64[]
    ntype : i64[]
    nslot : i64[]
    fslots : i64[]
    diags : Diag[]
    snames : str[]
    stype : i64[]
    smut : i64[]
    sslot : i64[]
    marks : i64[]
    nslots : i64
    loop_depth : i64
    cur_fn : i64
    in_contract : bool

impl Checker:
    fn derr(&mut self, tok : i64, m : str):
        self.diags.push(Diag{line: self.toks.line[tok × 1¤ptrdiff],
                             col: self.toks.col[tok × 1¤ptrdiff], msg: m})

    fn text(&self, tok : i64) → str:
        run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    fn sname_of(&self, t : i64) → str:
        // a diagnostic writes the struct's name, not its number
        if ty_is_struct(ty_strip_ref(t)):
            return self.a.structs[ty_sidx(ty_strip_ref(t)) × 1¤ptrdiff].name
        type_name(t)

    fn struct_index(&self, name : str) → i64:
        if #self.a.structs > 0:
            foreach i := 0…#self.a.structs - 1:
                if self.a.structs[i].name = name:
                    return @dropunit(i)
        ⁻1

    // a field's position and type within a struct, by name; (⁻1, 0)
    // when the struct has no such field
    fn field_of(&self, sidx : i64, fname : str) → (i64, i64):
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let n : i64 = self.a.extra[d.fields_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let ftok : i64 = self.a.extra[(d.fields_off + 1 + i × 2) × 1¤ptrdiff]
            if self.text(ftok) = fname:
                return (i, self.a.extra[(d.fields_off + 2 + i × 2) × 1¤ptrdiff])
            i ← i + 1
        (⁻1i64, 0i64)

    // whether the expression builds a struct of its own rather than
    // naming one that already lives somewhere
    fn is_fresh_struct(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        k = NK_SLIT or k = NK_CALL or k = NK_MCALL

    fn fn_index(&self, name : str) → i64:
        foreach i := 0…#self.fnames - 1:
            if self.fnames[i] = name:
                return @dropunit(i)
        ⁻1

    fn global_index(&self, name : str) → i64:
        if #self.gnames > 0:
            foreach i := 0…#self.gnames - 1:
                if self.gnames[i] = name:
                    return @dropunit(i)
        ⁻1

    fn lookup(&self, name : str) → i64:
        let i : mut i64 = @dropunit(#self.snames) - 1
        while i >= 0:
            if self.snames[i × 1¤ptrdiff] = name:
                return i
            i ← i - 1
        ⁻1

    fn declare(&mut self, tok : i64, ty : i64, is_mut : i64) → i64:
        let name := self.text(tok)
        let low : i64 = self.marks[#self.marks - 1]
        let i : mut i64 = @dropunit(#self.snames) - 1
        while i >= low:
            if self.snames[i × 1¤ptrdiff] = name:
                self.derr(tok, "'" ⧺ name ⧺ "' is already defined in this scope")
                return self.sslot[i × 1¤ptrdiff]
            i ← i - 1
        let slot : i64 = self.nslots
        self.nslots ← self.nslots + 1
        self.snames.push(name)
        self.stype.push(ty)
        self.smut.push(is_mut)
        self.sslot.push(slot)
        slot

    fn push_scope(&mut self):
        self.marks.push(@dropunit(#self.snames))

    fn pop_scope(&mut self):
        let low : i64 = self.marks.pop() ?? 0
        while @dropunit(#self.snames) > low:
            _ ← self.snames.pop()
            _ ← self.stype.pop()
            _ ← self.smut.pop()
            _ ← self.sslot.pop()

    fn is_open(&self, t : i64) → bool:
        t = TY_UNT or t = TY_EMPTY

    fn set_type(&mut self, id : i64, t : i64):
        self.ntype[id × 1¤ptrdiff] ← t

    fn ty_of(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kind_of(&self, id : i64) → i64:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // Untyped literals: folding, adoption, range checks
    // ------------------------------------------------------------------

    // whether the wrapped value v (big says ≥ 2^63) fits the type t
    fn lit_fits(&self, v : i64, big : i64, t : i64) → bool:
        let bits : i64 = ty_bits(t)
        let sgn : i64 = ty_sgn(t)
        if big = 1:
            return sgn = 0 and bits = 64
        if sgn = 0:
            if v < 0: return false
            if bits = 64: return true
            return v <= (1 « bits) - 1
        if bits = 64: return true
        let half : i64 = 1 « (bits - 1)
        v >= @wrap(0 - half) and v <= half - 1

    // give an untyped node the type its context settled on
    fn adopt(&mut self, id : i64, t : i64):
        if self.ty_of(id) = TY_EMPTY:
            if ty_is_opt(t):
                self.set_type(id, t)
            else:
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "∅ is the absent optional; " ⧺ type_name(t) ⧺ " holds no absence")
            return
        if self.ty_of(id) ≠ TY_UNT:
            return
        if not ty_is_int(t):
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "a number cannot become " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
        if self.kind_of(id) = NK_INT:
            if not self.lit_fits(self.a.na[id × 1¤ptrdiff],
                                 self.a.nb[id × 1¤ptrdiff], t):
                self.derr(self.a.ntok[id × 1¤ptrdiff],
                          "the literal does not fit " ⧺ type_name(t))
        elif self.kind_of(id) = NK_COND:
            // both sides were untyped; the context settles each
            self.adopt(self.a.na[id × 1¤ptrdiff], t)
            self.adopt(self.a.nc[id × 1¤ptrdiff], t)
        else:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      "this untyped computation cannot settle; ngplc folds only literals")
        self.set_type(id, t)

    // fold an arithmetic node whose operands folded to literals; the
    // computation is exact, and one that leaves i64 is refused since
    // no run of the program could hold it either
    fn fold_bin(&mut self, id : i64, k : i64, tok : i64, l : i64, r : i64):
        let res : mut i64 = 0
        let bad : mut bool = false
        if k = NK_ADD:
            res ← @wrap(l + r)
            bad ← (l > 0 and r > 0 and res < 0) or (l < 0 and r < 0 and res >= 0)
        elif k = NK_SUB:
            res ← @wrap(l - r)
            bad ← (l >= 0 and r < 0 and res < 0) or (l < 0 and r > 0 and res >= 0)
        elif k = NK_MUL:
            res ← @wrap(l × r)
            if l ≠ 0:
                bad ← (res ÷ l ?? 0) ≠ r or (l = ⁻1 and r = @wrap(0 - 9223372036854775807 - 1))
        elif k = NK_SHL:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← @wrap(l « r)
                bad ← (res » r) ≠ l
        elif k = NK_SHR:
            if r < 0 or r > 62:
                bad ← true
            else:
                res ← l » r
        elif k = NK_BAND:
            res ← l & r
        elif k = NK_BOR:
            res ← l | r
        elif k = NK_BXOR:
            res ← l ^ r
        elif k = NK_MAXOP:
            res ← l ⌈ r
        elif k = NK_MINOP:
            res ← l ⌊ r
        else:
            // comparisons of two untyped numbers answer at once
            let b : mut i64 = 0
            if k = NK_EQ: b ← 1 if l = r else 0
            elif k = NK_NE: b ← 1 if l ≠ r else 0
            elif k = NK_LT: b ← 1 if l < r else 0
            elif k = NK_LE: b ← 1 if l <= r else 0
            elif k = NK_GT: b ← 1 if l > r else 0
            elif k = NK_GE: b ← 1 if l >= r else 0
            else:
                self.derr(tok, "these two untyped numbers cannot meet here; state a type")
                self.set_type(id, TY_I64)
                return
            self.a.nkind[id × 1¤ptrdiff] ← NK_BOOL
            self.a.na[id × 1¤ptrdiff] ← b
            self.set_type(id, TY_BOOL)
            return
        if bad:
            self.derr(tok, "this literal computation leaves i64, which no run could hold")
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← res
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, TY_UNT)

    // ------------------------------------------------------------------
    // Expression checking; `want` is the type the context asks for,
    // 0 (TY_UNIT) meaning it asks nothing
    // ------------------------------------------------------------------

    fn unify_arith(&mut self, tok : i64, id : i64, k : i64, tl : i64, tr : i64) → i64:
        // both integer operands; answers the operation's type
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if tl = TY_UNT and tr = TY_UNT:
            return TY_UNT
        if tl = TY_UNT:
            self.adopt(na, tr)
            return tr
        if tr = TY_UNT:
            // × of a scalar and a measured value keeps the measure, so
            // an untyped right side of × under a united left adopts the
            // bare type; everything else adopts in full
            self.adopt(nb, tl)
            return tl
        // two typed operands: same signedness, wider wins, units meet
        if ty_sgn(tl) ≠ ty_sgn(tr):
            self.derr(tok, "signed and unsigned do not meet; " ⧺ type_name(tl) ⧺ " and " ⧺ type_name(tr))
            return tl
        let ul : i64 = ty_unit(tl)
        let ur : i64 = ty_unit(tr)
        let wide : i64 = tl if ty_bits(tl) >= ty_bits(tr) else tr
        if ul = ur:
            return wide
        if k = NK_MUL and (ul = 0 or ur = 0):
            // scalar multiplication keeps the measure
            return ty_with_unit(ty_drop_unit(wide), ul ⌈ ur)
        if (k = NK_DIV or k = NK_MOD) and ur = 0:
            return wide if ty_unit(wide) = ul else ty_with_unit(ty_drop_unit(wide), ul)
        self.derr(tok, "a value measured " ⧺ type_name(tl) ⧺ " does not meet one measured " ⧺ type_name(tr))
        wide

    fn check_expr(&mut self, id : i64, want : i64):
        let k : i64 = self.kind_of(id)
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_INT:
            if want ≠ TY_UNIT and ty_is_int(want):
                self.set_type(id, TY_UNT)
                self.adopt(id, want)
            else:
                self.set_type(id, TY_UNT)
        elif k = NK_BOOL:
            self.set_type(id, TY_BOOL)
        elif k = NK_STR:
            self.set_type(id, TY_STR)
        elif k = NK_VAR:
            self.check_var(id, tok)
        elif k = NK_ARRLIT:
            self.check_arrlit(id, tok, na, want)
        elif k = NK_SLIT:
            self.check_slit(id, tok, na)
        elif k = NK_FIELD:
            self.check_field(id, tok, na)
        elif k = NK_SOME:
            let iw : i64 = ty_opt_base(want) if ty_is_opt(want) else TY_UNIT
            self.check_expr(na, iw)
            if self.ty_of(na) = TY_UNT:
                self.adopt(na, iw if iw ≠ TY_UNIT and ty_is_int(iw) else TY_I64)
            let it : i64 = self.ty_of(na)
            if ty_is_arr(it):
                self.derr(tok, "an optional array is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            if ty_is_opt(it) or it = TY_EMPTY:
                self.derr(tok, "an optional of an optional is not core-2 yet")
                self.set_type(id, mk_oty(TY_I64))
                return
            self.set_type(id, mk_oty(it))
        elif k = NK_EMPTYV:
            self.set_type(id, want if ty_is_opt(want) else TY_EMPTY)
        elif k = NK_INDEX:
            self.check_index(id, tok, na, nb)
        elif k = NK_LEN:
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if t = TY_STR:
                self.set_type(id, ty_with_unit(TY_I64, UNIT_PTRDIFF))
            elif ty_is_arr(t):
                let u : i64 = UNIT_BYTE if ty_drop_unit(ty_elem(t)) = TY_U8 else UNIT_PTRDIFF
                self.set_type(id, ty_with_unit(TY_I64, u))
            else:
                self.derr(tok, "# counts an array or a string; this is " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_CALL:
            self.check_call(id, tok, na)
        elif k = NK_SCALL:
            self.check_scall(id, tok, na, nb)
        elif k = NK_MCALL:
            self.check_mcall(id, tok, na, nb, false)
        elif k = NK_REF:
            self.derr(tok, "a borrow is an argument, not a value of its own")
            self.set_type(id, TY_I64)
        elif k = NK_NEG:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.set_type(id, TY_UNT)
                // the parser folds ⁻literal; reaching here means ⁻(expr)
                if self.kind_of(na) = NK_INT:
                    self.fold_neg(id, na)
            elif ty_is_int(t):
                self.set_type(id, t)
            else:
                self.derr(tok, "⁻ negates a number, not " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_BNOT:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.a.na[id × 1¤ptrdiff] ← ~(self.a.na[na × 1¤ptrdiff])
                self.a.nkind[id × 1¤ptrdiff] ← NK_INT
                self.a.nb[id × 1¤ptrdiff] ← 0
                self.set_type(id, TY_UNT)
            elif ty_is_int(t) and ty_unit(t) = 0:
                self.set_type(id, t)
            else:
                self.derr(tok, "~ flips the bits of a plain integer, not " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_NOT:
            self.check_expr(na, TY_UNIT)
            self.want_bool(na, "¬")
            self.set_type(id, TY_BOOL)
        elif k = NK_COND:
            self.check_expr(nb, TY_UNIT)
            self.want_truthy(nb, "the condition")
            self.check_expr(na, want)
            self.check_expr(nc, want)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nc)
            if tl = TY_UNT and tr ≠ TY_UNT:
                self.adopt(na, tr)
            elif tr = TY_UNT and tl ≠ TY_UNT:
                self.adopt(nc, tl)
            elif tl = TY_UNT and tr = TY_UNT:
                self.set_type(id, TY_UNT)
                return
            if self.ty_of(na) ≠ self.ty_of(nc):
                self.derr(tok, "the two sides of a conditional say one type between them")
            self.set_type(id, self.ty_of(na))
        elif k = NK_WRAP:
            self.check_expr(na, want)
            let t : i64 = self.ty_of(na)
            if t = TY_UNT:
                self.derr(tok, "@wrap wants a width to wrap within; state a type")
                self.set_type(id, TY_I64)
            elif ty_is_int(t):
                self.set_type(id, t)
            else:
                self.derr(tok, "@wrap wraps integer arithmetic, not " ⧺ type_name(t))
                self.set_type(id, TY_I64)
        elif k = NK_DEFAULT:
            self.check_default(id, tok, na, nb, want)
        elif k = NK_DIV or k = NK_MOD:
            self.derr(tok, "÷ and % answer a result; write (a ÷ b) ?? default")
            self.check_expr(na, want)
            self.check_expr(nb, want)
            self.set_type(id, TY_I64)
        elif k = NK_EQ or k = NK_NE:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nb)
            if tl = TY_EMPTY or tr = TY_EMPTY:
                if tl = TY_EMPTY and tr = TY_EMPTY:
                    self.derr(tok, "∅ against ∅ says nothing; state which optional is asked")
                elif tl = TY_EMPTY:
                    if ty_is_opt(tr):
                        self.adopt(na, tr)
                    else:
                        self.derr(tok, "only an optional is asked about ∅; this is " ⧺ type_name(tr))
                elif ty_is_opt(tl):
                    self.adopt(nb, tl)
                else:
                    self.derr(tok, "only an optional is asked about ∅; this is " ⧺ type_name(tl))
                self.set_type(id, TY_BOOL)
                return
            if ty_is_opt(tl) or ty_is_opt(tr):
                self.derr(tok, "core-2 compares an optional only with ∅; take the value out with ?? or match")
                self.set_type(id, TY_BOOL)
                return
            if tl = TY_STR and tr = TY_STR:
                self.set_type(id, TY_BOOL)
                return
            if tl = TY_BOOL and tr = TY_BOOL:
                self.set_type(id, TY_BOOL)
                return
            self.check_cmp_operands(id, tok, k, na, nb)
        elif k = NK_LT or k = NK_LE or k = NK_GT or k = NK_GE:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            self.check_cmp_operands(id, tok, k, na, nb)
        elif k = NK_AND or k = NK_OR or k = NK_LAND or k = NK_LOR:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            self.want_bool(na, "a logic operator")
            self.want_bool(nb, "a logic operator")
            self.set_type(id, TY_BOOL)
        elif k = NK_CCAT:
            self.check_expr(na, TY_UNIT)
            self.check_expr(nb, TY_UNIT)
            if self.ty_of(na) ≠ TY_STR or self.ty_of(nb) ≠ TY_STR:
                self.derr(tok, "⧺ joins strings in core-1")
            self.set_type(id, TY_STR)
        else:
            // + - × ÷ % « » & | ^ ⌈ ⌊ over integers
            self.check_expr(na, want)
            self.check_expr(nb, want)
            let tl : i64 = self.ty_of(na)
            let tr : i64 = self.ty_of(nb)
            if not (tl = TY_UNT or ty_is_int(tl)) or not (tr = TY_UNT or ty_is_int(tr)):
                self.derr(tok, "this operator works numbers; the sides are " ⧺ type_name(tl) ⧺ " and " ⧺ type_name(tr))
                self.set_type(id, TY_I64)
                return
            if tl = TY_UNT and tr = TY_UNT and self.kind_of(na) = NK_INT and self.kind_of(nb) = NK_INT and self.a.nb[na × 1¤ptrdiff] = 0 and self.a.nb[nb × 1¤ptrdiff] = 0:
                self.fold_bin(id, k, tok, self.a.na[na × 1¤ptrdiff],
                              self.a.na[nb × 1¤ptrdiff])
                return
            let t : i64 = self.unify_arith(tok, id, k, tl, tr)
            if (k = NK_SHL or k = NK_SHR or k = NK_BAND or k = NK_BOR or k = NK_BXOR) and t ≠ TY_UNT and ty_unit(t) ≠ 0:
                self.derr(tok, "bit operations work plain integers, not measured ones")
            if k = NK_SHL or k = NK_SHR:
                // the count is its own number; it does not widen the value
                self.set_type(id, tl if tl ≠ TY_UNT else t)
            else:
                self.set_type(id, t)

    fn fold_neg(&mut self, id : i64, na : i64):
        let v : i64 = self.a.na[na × 1¤ptrdiff]
        self.a.nkind[id × 1¤ptrdiff] ← NK_INT
        self.a.na[id × 1¤ptrdiff] ← @wrap(0 - v)
        self.a.nb[id × 1¤ptrdiff] ← 0
        self.set_type(id, TY_UNT)

    fn check_cmp_operands(&mut self, id : i64, tok : i64, k : i64, na : i64, nb : i64):
        let tl : i64 = self.ty_of(na)
        let tr : i64 = self.ty_of(nb)
        if tl = TY_UNT and tr = TY_UNT:
            if self.kind_of(na) = NK_INT and self.kind_of(nb) = NK_INT:
                self.fold_bin(id, k, tok, self.a.na[na × 1¤ptrdiff],
                              self.a.na[nb × 1¤ptrdiff])
                return
            self.derr(tok, "these two untyped numbers cannot meet here; state a type")
            self.set_type(id, TY_BOOL)
            return
        if tl = TY_UNT:
            self.adopt(na, tr)
        elif tr = TY_UNT:
            self.adopt(nb, tl)
        let l : i64 = self.ty_of(na)
        let r : i64 = self.ty_of(nb)
        if not ty_is_int(l) or not ty_is_int(r):
            self.derr(tok, "an ordering compares numbers; the sides are " ⧺ type_name(l) ⧺ " and " ⧺ type_name(r))
        elif ty_sgn(l) ≠ ty_sgn(r):
            self.derr(tok, "signed and unsigned do not meet; " ⧺ type_name(l) ⧺ " and " ⧺ type_name(r))
        elif ty_unit(l) ≠ ty_unit(r):
            self.derr(tok, "a value measured " ⧺ type_name(l) ⧺ " does not meet one measured " ⧺ type_name(r))
        self.set_type(id, TY_BOOL)

    fn want_bool(&mut self, id : i64, what : str):
        if self.ty_of(id) ≠ TY_BOOL:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      what ⧺ " takes truth values, but this operand is " ⧺ type_name(self.ty_of(id)) ⧺ "; a number asks its question with a comparison, as 'x ≠ 0'")

    fn want_truthy(&mut self, id : i64, what : str):
        let t : i64 = self.ty_of(id)
        if t = TY_UNT:
            self.adopt(id, TY_I64)
            return
        if ty_is_opt(t):
            // an optional in a condition asks whether a value is there
            return
        if not ty_is_int(t) and t ≠ TY_BOOL:
            self.derr(self.a.ntok[id × 1¤ptrdiff],
                      what ⧺ " wants a truth value, but this is " ⧺ type_name(t))

    fn check_var(&mut self, id : i64, tok : i64):
        let name := self.text(tok)
        if name = "_":
            self.derr(tok, "'_' holds nothing and cannot be read")
            self.set_type(id, TY_I64)
            return
        let s : i64 = self.lookup(name)
        if s ≠ ⁻1:
            self.set_type(id, ty_strip_ref(self.stype[s × 1¤ptrdiff]))
            self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
            return
        let g : i64 = self.global_index(name)
        if g = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
            self.set_type(id, TY_I64)
            return
        let gd := self.a.globals[g × 1¤ptrdiff]
        if gd.is_mut and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "a mutable global is an effect; reading '" ⧺ name ⧺ "' wants @impure")
        if gd.is_mut and self.in_contract:
            self.derr(tok, "a contract's condition is pure; '" ⧺ name ⧺ "' is mutable")
        self.set_type(id, gd.ty)
        self.nslot[id × 1¤ptrdiff] ← @wrap(0 - g - 2)

    fn check_arrlit(&mut self, id : i64, tok : i64, off : i64, want : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let want_elem : mut i64 = TY_UNIT
        if ty_is_arr(ty_strip_ref(want)):
            want_elem ← ty_elem(ty_strip_ref(want))
        let settled : mut i64 = want_elem
        let i : mut i64 = 0
        while i < n:
            let e : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            self.check_expr(e, settled)
            if settled = TY_UNIT and self.ty_of(e) ≠ TY_UNT:
                settled ← self.ty_of(e)
            i ← i + 1
        if settled = TY_UNIT:
            if n > 0:
                self.derr(tok, "the elements state no type; the binding must say it")
            self.set_type(id, want if ty_is_arr(want) else mk_aty(TY_I64))
            return
        if not (ty_is_int(settled) and ty_unit(settled) = 0) and not ty_is_struct(settled):
            self.derr(tok, "a core-2 array holds plain integers or structs")
            self.set_type(id, mk_aty(TY_I64))
            return
        // every element meets the settled type
        let j : mut i64 = 0
        while j < n:
            let e : i64 = self.a.extra[(off + 1 + j) × 1¤ptrdiff]
            if self.ty_of(e) = TY_UNT:
                self.adopt(e, settled)
            elif self.ty_of(e) ≠ settled:
                self.derr(tok, "one array, one element type; " ⧺ type_name(self.ty_of(e)) ⧺ " is not " ⧺ type_name(settled))
            j ← j + 1
        self.set_type(id, mk_aty(settled))

    fn check_slit(&mut self, id : i64, tok : i64, off : i64):
        let name := self.text(tok)
        let sidx : i64 = self.struct_index(name)
        if sidx = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ "' is not a struct this program defines")
            self.set_type(id, TY_I64)
            return
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let nf : i64 = self.a.extra[d.fields_off × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let filled : mut i64[] = []
        let j : mut i64 = 0
        while j < nf:
            filled.push(0)
            j ← j + 1
        let i : mut i64 = 0
        while i < n:
            let ftok : i64 = self.a.extra[(off + 1 + i × 2) × 1¤ptrdiff]
            let e : i64 = self.a.extra[(off + 2 + i × 2) × 1¤ptrdiff]
            let (fidx, fty) := self.field_of(sidx, self.text(ftok))
            if fidx = ⁻1:
                self.derr(ftok, "'" ⧺ name ⧺ "' has no field '" ⧺ self.text(ftok) ⧺ "'")
                self.check_expr(e, TY_UNIT)
            else:
                if filled[fidx × 1¤ptrdiff] = 1:
                    self.derr(ftok, "the literal names '" ⧺ self.text(ftok) ⧺ "' twice")
                filled[fidx × 1¤ptrdiff] ← 1
                self.check_expr(e, fty)
                if self.is_open(self.ty_of(e)):
                    self.adopt(e, fty)
                elif self.ty_of(e) ≠ fty:
                    self.derr(ftok, "field '" ⧺ self.text(ftok) ⧺ "' holds " ⧺ type_name(fty) ⧺ ", not " ⧺ type_name(self.ty_of(e)))
                // the resolved position replaces the name for lowering
                self.a.extra[(off + 1 + i × 2) × 1¤ptrdiff] ← fidx
            i ← i + 1
        let m : mut i64 = 0
        while m < nf:
            if filled[m × 1¤ptrdiff] = 0:
                let ftok : i64 = self.a.extra[(d.fields_off + 1 + m × 2) × 1¤ptrdiff]
                self.derr(tok, "the literal misses field '" ⧺ self.text(ftok) ⧺ "'")
            m ← m + 1
        self.set_type(id, mk_sty(sidx))

    fn check_field(&mut self, id : i64, tok : i64, na : i64):
        self.check_expr(na, TY_UNIT)
        let t : i64 = ty_strip_ref(self.ty_of(na))
        if not ty_is_struct(t):
            self.derr(tok, "only a struct has fields; this is " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
        let (fidx, fty) := self.field_of(ty_sidx(t), self.text(tok))
        if fidx = ⁻1:
            self.derr(tok, "'" ⧺ self.sname_of(t) ⧺ "' has no field '" ⧺ self.text(tok) ⧺ "'")
            self.set_type(id, TY_I64)
            return
        self.a.nb[id × 1¤ptrdiff] ← fidx
        self.set_type(id, fty)

    fn index_unit_of(&self, arr_ty : i64) → i64:
        UNIT_BYTE if ty_drop_unit(ty_elem(arr_ty)) = TY_U8 else UNIT_PTRDIFF

    fn check_index_expr(&mut self, tok : i64, arr_ty : i64, idx : i64):
        // the subscript carries the array's measure, or is an untyped
        // literal, which is exempt as the spec has it
        self.check_expr(idx, ty_with_unit(TY_I64, self.index_unit_of(arr_ty)))
        let t : i64 = self.ty_of(idx)
        if t = TY_UNT:
            self.adopt(idx, TY_I64)
            return
        if not ty_is_int(t):
            self.derr(tok, "a subscript is a number, not " ⧺ type_name(t))
            return
        if ty_unit(t) ≠ self.index_unit_of(arr_ty):
            let uname : str = "¤byte" if self.index_unit_of(arr_ty) = UNIT_BYTE else "¤ptrdiff"
            self.derr(tok, "this array's subscript is measured " ⧺ uname ⧺ ", but the index is " ⧺ type_name(t))

    fn check_index(&mut self, id : i64, tok : i64, na : i64, nb : i64):
        self.check_expr(na, TY_UNIT)
        let t : i64 = self.ty_of(na)
        if not ty_is_arr(t):
            self.derr(tok, "only an array is subscripted; this is " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
        self.check_index_expr(tok, t, nb)
        self.set_type(id, ty_elem(t))

    fn check_call(&mut self, id : i64, tok : i64, args_off : i64):
        let name := self.text(tok)
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if name = "assert" or name = "assert_eq":
            self.check_assert(id, tok, args_off, argc, name = "assert_eq")
            return
        let f : i64 = self.fn_index(name)
        if f = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ "' is not a function this program defines")
            let i : mut i64 = 0
            while i < argc:
                self.check_expr(self.a.extra[(args_off + 1 + i) × 1¤ptrdiff], TY_UNIT)
                i ← i + 1
            self.set_type(id, TY_I64)
            return
        let callee := self.a.fns[f × 1¤ptrdiff]
        if callee.is_impure and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "'" ⧺ name ⧺ "' is @impure, and impurity travels to the caller")
        if self.in_contract and callee.is_impure:
            self.derr(tok, "a contract's condition is pure; '" ⧺ name ⧺ "' is not")
        let np : i64 = self.a.extra[callee.params_off × 1¤ptrdiff]
        if argc ≠ np:
            self.derr(tok, "'" ⧺ name ⧺ "' wants " ⧺ i64_str(np) ⧺ " arguments, not " ⧺ i64_str(argc))
            self.set_type(id, callee.ret)
            return
        let j : mut i64 = 0
        while j < np:
            let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
            let pty : i64 = self.a.extra[(callee.params_off + 2 + j × 2) × 1¤ptrdiff]
            self.check_one_arg(tok, name, j + 1, arg, pty)
            j ← j + 1
        self.set_type(id, callee.ret)

    fn check_one_arg(&mut self, tok : i64, name : str, num : i64,
                     arg : i64, pty : i64):
        let rk : i64 = ty_ref_kind(pty)
        let base : i64 = ty_strip_ref(pty)
        if rk ≠ 0:
            if self.kind_of(arg) ≠ NK_REF:
                self.derr(tok, "parameter " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' borrows; write &name")
            else:
                self.check_ref_arg(arg, base, rk)
        else:
            if self.kind_of(arg) = NK_REF:
                self.derr(tok, "parameter " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' takes a value, not a borrow")
            else:
                self.check_expr(arg, base)
                let at : i64 = self.ty_of(arg)
                if self.is_open(at):
                    self.adopt(arg, base)
                elif at ≠ base:
                    self.derr(tok, "argument " ⧺ i64_str(num) ⧺ " of '" ⧺ name ⧺ "' is " ⧺ type_name(at) ⧺ ", but the parameter says " ⧺ type_name(base))

    fn check_ref_arg(&mut self, arg : i64, base : i64, rk : i64):
        let inner : i64 = self.a.na[arg × 1¤ptrdiff]
        let atok : i64 = self.a.ntok[arg × 1¤ptrdiff]
        self.check_expr(inner, TY_UNIT)
        if self.ty_of(inner) ≠ base:
            self.derr(atok, "the borrow hands over " ⧺ type_name(self.ty_of(inner)) ⧺ ", but the parameter says " ⧺ type_name(base))
        if rk = 2:
            let name := self.text(self.a.ntok[inner × 1¤ptrdiff])
            let s : i64 = self.lookup(name)
            if s ≠ ⁻1 and self.smut[s × 1¤ptrdiff] = 0 and ty_ref_kind(self.stype[s × 1¤ptrdiff]) ≠ 2:
                self.derr(atok, "'" ⧺ name ⧺ "' is not mut, so &mut cannot hand it over")
        self.set_type(arg, base)

    fn check_assert(&mut self, id : i64, tok : i64, args_off : i64, argc : i64,
                    is_eq : bool):
        if is_eq:
            if argc ≠ 2:
                self.derr(tok, "assert_eq takes the expected and the actual value")
            else:
                let x : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                let y : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                self.check_expr(x, TY_UNIT)
                self.check_expr(y, self.ty_of(x))
                let tl : i64 = self.ty_of(x)
                let tr : i64 = self.ty_of(y)
                if tl = TY_UNT and tr ≠ TY_UNT:
                    self.adopt(x, tr)
                elif tr = TY_UNT and tl ≠ TY_UNT:
                    self.adopt(y, tl)
                elif tl = TY_UNT and tr = TY_UNT:
                    self.adopt(x, TY_I64)
                    self.adopt(y, TY_I64)
                if ty_is_arr(self.ty_of(x)) or self.ty_of(x) = TY_STR:
                    self.derr(tok, "assert_eq compares numbers in core-1")
                elif self.ty_of(x) ≠ self.ty_of(y):
                    self.derr(tok, "assert_eq compares two of the same type")
        else:
            if argc < 1 or argc > 2:
                self.derr(tok, "assert takes the condition and possibly a message")
            if argc >= 1:
                let c : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "assert")
            if argc = 2:
                let m : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                self.check_expr(m, TY_UNIT)
                if self.kind_of(m) ≠ NK_STR:
                    self.derr(tok, "assert's message is a string literal")
        self.set_type(id, TY_UNIT)

    fn count_fields(&self, s : str) → i64:
        let cs := s.chars()
        let n : mut i64 = 0
        let i ¤ptrdiff : mut i64 = 0
        while i + 1 < #cs:
            if cs[i] = '{' and cs[i + 1] = '}':
                n ← n + 1
                i ← i + 2
            else:
                i ← i + 1
        n

    fn check_scall(&mut self, id : i64, tok : i64, sb : i64, args_off : i64):
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if sb = SB_EXIT:
            if argc ≠ 1:
                self.derr(tok, "std.exit takes the exit code")
            else:
                let c : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(c, TY_I64)
                if self.ty_of(c) = TY_UNT:
                    self.adopt(c, TY_I64)
                elif not ty_is_int(self.ty_of(c)):
                    self.derr(tok, "the exit code is a number")
            self.set_type(id, TY_UNIT)
            return
        if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "writing output is impure; the function wants @impure")
        if self.in_contract:
            self.derr(tok, "a contract's condition is pure and writes nothing")
        if argc < 1:
            self.derr(tok, "the first argument is the format string")
            self.set_type(id, TY_UNIT)
            return
        let fmt : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        self.check_expr(fmt, TY_UNIT)
        if self.kind_of(fmt) ≠ NK_STR:
            self.derr(tok, "the format is a string literal in core-1")
            self.set_type(id, TY_UNIT)
            return
        let fields : i64 = self.count_fields(self.a.strs[self.a.na[fmt × 1¤ptrdiff] × 1¤ptrdiff])
        if fields ≠ argc - 1:
            self.derr(tok, "the format's {} fields and the arguments after it disagree in number")
        let i : mut i64 = 2
        while i <= argc:
            let arg : i64 = self.a.extra[(args_off + i) × 1¤ptrdiff]
            self.check_expr(arg, TY_UNIT)
            let t : i64 = self.ty_of(arg)
            if t = TY_UNT:
                self.adopt(arg, TY_I64)
            elif not ty_is_int(t) and t ≠ TY_BOOL and t ≠ TY_STR:
                self.derr(tok, "println writes numbers, truth values and strings; this is " ⧺ type_name(t))
            i ← i + 1
        self.set_type(id, TY_UNIT)

    fn check_mcall(&mut self, id : i64, tok : i64, na : i64, args_off : i64,
                   under_default : bool):
        let m := self.text(tok)
        // the base naming a struct type is a static call, unless a
        // variable shadows the name
        if self.kind_of(na) = NK_VAR:
            let bname := self.text(self.a.ntok[na × 1¤ptrdiff])
            if self.lookup(bname) = ⁻1 and self.struct_index(bname) ≠ ⁻1:
                self.check_smethod(id, tok, na, args_off, bname, m, false)
                return
        self.check_expr(na, TY_UNIT)
        let t : i64 = self.ty_of(na)
        if ty_is_struct(ty_strip_ref(t)):
            let sname := self.a.structs[ty_sidx(ty_strip_ref(t)) × 1¤ptrdiff].name
            self.check_smethod(id, tok, na, args_off, sname, m, true)
            return
        if not ty_is_arr(t):
            self.derr(tok, "'" ⧺ m ⧺ "' is asked of an array or a struct; this is " ⧺ type_name(t))
            self.set_type(id, TY_I64)
            return
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if m = "push":
            self.require_mut_base(na, tok)
            if argc ≠ 1:
                self.derr(tok, "push takes the one element to append")
            else:
                let arg : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
                self.check_expr(arg, ty_elem(t))
                if self.ty_of(arg) = TY_UNT:
                    self.adopt(arg, ty_elem(t))
                elif self.ty_of(arg) ≠ ty_elem(t):
                    self.derr(tok, "the array holds " ⧺ type_name(ty_elem(t)) ⧺ ", not " ⧺ type_name(self.ty_of(arg)))
            self.a.nc[id × 1¤ptrdiff] ← MID_PUSH
            self.set_type(id, TY_UNIT)
        elif m = "pop":
            self.require_mut_base(na, tok)
            if argc ≠ 0:
                self.derr(tok, "pop takes nothing")
            if not under_default:
                self.derr(tok, "pop answers an optional; write v.pop() ?? default")
            self.a.nc[id × 1¤ptrdiff] ← MID_POP
            self.set_type(id, ty_elem(t))
        elif m = "get":
            if argc ≠ 1:
                self.derr(tok, "get takes the index to look at")
            else:
                self.check_index_expr(tok, t, self.a.extra[(args_off + 1) × 1¤ptrdiff])
            if not under_default:
                self.derr(tok, "get answers an optional; write v.get(i) ?? default")
            self.a.nc[id × 1¤ptrdiff] ← MID_GET
            self.set_type(id, ty_elem(t))
        else:
            self.derr(tok, "'" ⧺ m ⧺ "' is not a core-1 array method; push, pop and get are")
            self.set_type(id, TY_I64)

    fn check_smethod(&mut self, id : i64, tok : i64, na : i64, args_off : i64,
                     sname : str, m : str, instance : bool):
        let fname : str = sname ⧺ "." ⧺ m
        let f : i64 = self.fn_index(fname)
        if f = ⁻1:
            self.derr(tok, "'" ⧺ sname ⧺ "' has no method '" ⧺ m ⧺ "'")
            self.set_type(id, TY_I64)
            return
        let callee := self.a.fns[f × 1¤ptrdiff]
        if callee.is_impure and not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
            self.derr(tok, "'" ⧺ fname ⧺ "' is @impure, and impurity travels to the caller")
        if self.in_contract and callee.is_impure:
            self.derr(tok, "a contract's condition is pure; '" ⧺ fname ⧺ "' is not")
        let np : i64 = self.a.extra[callee.params_off × 1¤ptrdiff]
        let self_n : i64 = 1 if instance else 0
        if instance:
            if np = 0 or not ty_is_struct(ty_strip_ref(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff])):
                self.derr(tok, "'" ⧺ fname ⧺ "' is a static method; ask it of the struct's name")
                self.set_type(id, callee.ret)
                return
            let srk : i64 = ty_ref_kind(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff])
            if srk = 2:
                self.require_mut_base(na, tok)
        elif np > 0 and ty_is_struct(ty_strip_ref(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff])) and ty_ref_kind(self.a.extra[(callee.params_off + 2) × 1¤ptrdiff]) ≠ 0:
            self.derr(tok, "'" ⧺ fname ⧺ "' works an instance; ask it of a value, not the name")
            self.set_type(id, callee.ret)
            return
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if argc ≠ np - self_n:
            self.derr(tok, "'" ⧺ fname ⧺ "' wants " ⧺ i64_str(np - self_n) ⧺ " arguments, not " ⧺ i64_str(argc))
            self.set_type(id, callee.ret)
            return
        let j : mut i64 = 0
        while j < argc:
            let arg : i64 = self.a.extra[(args_off + 1 + j) × 1¤ptrdiff]
            let pty : i64 = self.a.extra[(callee.params_off + 2 + (j + self_n) × 2) × 1¤ptrdiff]
            self.check_one_arg(tok, fname, j + 1, arg, pty)
            j ← j + 1
        // lowering finds the function and whether a receiver travels
        self.a.nc[id × 1¤ptrdiff] ← 1000 + 2 × f + (1 if instance else 0)
        self.set_type(id, callee.ret)

    fn require_mut_base(&mut self, base : i64, tok : i64):
        if self.kind_of(base) = NK_FIELD or self.kind_of(base) = NK_INDEX:
            self.require_mut_base(self.a.na[base × 1¤ptrdiff], tok)
            return
        if self.kind_of(base) ≠ NK_VAR:
            self.derr(tok, "what is being changed is named directly in core-2")
            return
        let name := self.text(self.a.ntok[base × 1¤ptrdiff])
        let s : i64 = self.lookup(name)
        if s = ⁻1:
            return
        let pt : i64 = self.stype[s × 1¤ptrdiff]
        if ty_ref_kind(pt) = 1:
            self.derr(tok, "'" ⧺ name ⧺ "' is a shared borrow; & reads and &mut changes")
        elif ty_ref_kind(pt) = 0 and self.smut[s × 1¤ptrdiff] = 0:
            self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may change it")

    fn check_default(&mut self, id : i64, tok : i64, na : i64, nb : i64, want : i64):
        let ik : i64 = self.kind_of(na)
        if ik = NK_DIV or ik = NK_MOD:
            let dl : i64 = self.a.na[na × 1¤ptrdiff]
            let dr : i64 = self.a.nb[na × 1¤ptrdiff]
            self.check_expr(dl, want)
            self.check_expr(dr, want)
            let tl : i64 = self.ty_of(dl)
            let tr : i64 = self.ty_of(dr)
            if tl = TY_UNT and tr = TY_UNT:
                let w : i64 = want if ty_is_int(want) else TY_I64
                self.adopt(dl, w)
                self.adopt(dr, w)
            let t : i64 = self.unify_arith(self.a.ntok[na × 1¤ptrdiff], na, ik,
                                           self.ty_of(dl), self.ty_of(dr))
            self.set_type(na, t if t ≠ TY_UNT else TY_I64)
        elif ik = NK_MCALL:
            self.check_mcall(na, self.a.ntok[na × 1¤ptrdiff],
                             self.a.na[na × 1¤ptrdiff],
                             self.a.nb[na × 1¤ptrdiff], true)
        else:
            let ow : i64 = mk_oty(want) if want ≠ TY_UNIT and (ty_is_int(want) or want = TY_BOOL or want = TY_STR or ty_is_struct(want)) else TY_UNIT
            self.check_expr(na, ow)
            if ty_is_opt(self.ty_of(na)):
                let base : i64 = ty_opt_base(self.ty_of(na))
                self.check_expr(nb, base)
                if self.is_open(self.ty_of(nb)):
                    self.adopt(nb, base)
                elif self.ty_of(nb) ≠ base:
                    self.derr(tok, "the default answers for the value, so it is " ⧺ type_name(base) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
                self.set_type(id, base)
                return
            self.derr(tok, "?? follows what answers a result or an optional")
        let t : i64 = self.ty_of(na)
        self.check_expr(nb, t)
        if self.ty_of(nb) = TY_UNT:
            self.adopt(nb, t)
        elif self.ty_of(nb) ≠ t:
            self.derr(tok, "the default answers for the value, so it is " ⧺ type_name(t) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
        self.set_type(id, t)

    // ------------------------------------------------------------------
    // Statements
    // ------------------------------------------------------------------

    fn check_block(&mut self, blk : i64, is_fn_body : bool):
        self.push_scope()
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let s : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let trailing : bool = is_fn_body and i = n - 1
            self.check_stmt(s, trailing)
            i ← i + 1
        self.pop_scope()

    fn check_stmt(&mut self, id : i64, trailing : bool):
        let k : i64 = self.kind_of(id)
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_LET:
            if ty_is_struct(nc):
                if not self.is_fresh_struct(na):
                    self.derr(tok, "a core-2 struct is born from its literal or a call; borrow with & to share one")
                self.check_expr(na, nc)
                if self.ty_of(na) ≠ nc and not ty_is_arr(self.ty_of(na)):
                    if self.ty_of(na) ≠ TY_I64:
                        self.derr(tok, "the binding says " ⧺ self.sname_of(nc) ⧺ " but the value is " ⧺ self.sname_of(self.ty_of(na)))
                let slot0 : i64 = self.declare(tok, nc, nb)
                self.nslot[id × 1¤ptrdiff] ← slot0
                return
            if ty_is_arr(nc):
                if self.kind_of(na) ≠ NK_ARRLIT:
                    self.derr(tok, "a core-1 array is born from its literal")
                    self.set_type(na, nc)
                else:
                    self.check_expr(na, nc)
                    if self.ty_of(na) ≠ nc and self.a.extra[self.a.na[na × 1¤ptrdiff] × 1¤ptrdiff] > 0:
                        self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
                    self.set_type(na, nc)
            else:
                self.check_expr(na, nc)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, nc)
                elif self.ty_of(na) ≠ nc:
                    self.derr(tok, "the binding says " ⧺ type_name(nc) ⧺ " but the value is " ⧺ type_name(self.ty_of(na)))
            let slot : i64 = self.declare(tok, nc, nb)
            self.nslot[id × 1¤ptrdiff] ← slot
        elif k = NK_ASSIGN:
            let name := self.text(tok)
            let s : i64 = self.lookup(name)
            if s = ⁻1:
                let g : i64 = self.global_index(name)
                if g = ⁻1:
                    self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
                    self.check_expr(na, TY_UNIT)
                    return
                let gd := self.a.globals[g × 1¤ptrdiff]
                if not gd.is_mut:
                    self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may be stored into it")
                if not self.a.fns[self.cur_fn × 1¤ptrdiff].is_impure:
                    self.derr(tok, "writing a global is an effect; the function wants @impure")
                self.check_expr(na, gd.ty)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, gd.ty)
                elif self.ty_of(na) ≠ gd.ty:
                    self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ type_name(gd.ty) ⧺ ", not " ⧺ type_name(self.ty_of(na)))
                self.nslot[id × 1¤ptrdiff] ← @wrap(0 - g - 2)
                return
            let st : i64 = self.stype[s × 1¤ptrdiff]
            if ty_is_struct(ty_strip_ref(st)) and not self.is_fresh_struct(na):
                self.derr(tok, "a struct binding takes a fresh struct; the fields change in place")
            if ty_is_arr(ty_strip_ref(st)):
                self.derr(tok, "a core-2 array is built once and changed in place")
            if self.smut[s × 1¤ptrdiff] = 0:
                self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may be stored into it")
            self.check_expr(na, ty_strip_ref(st))
            if self.is_open(self.ty_of(na)):
                self.adopt(na, ty_strip_ref(st))
            elif self.ty_of(na) ≠ ty_strip_ref(st):
                self.derr(tok, "'" ⧺ name ⧺ "' holds " ⧺ type_name(ty_strip_ref(st)) ⧺ ", not " ⧺ type_name(self.ty_of(na)))
            self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
        elif k = NK_STOREIDX:
            let name := self.text(tok)
            let s : i64 = self.lookup(name)
            if s = ⁻1:
                self.derr(tok, "'" ⧺ name ⧺ "' is not defined here")
                return
            let st : i64 = ty_strip_ref(self.stype[s × 1¤ptrdiff])
            if not ty_is_arr(st):
                self.derr(tok, "only an array is written by element; '" ⧺ name ⧺ "' is " ⧺ type_name(st))
                return
            let rk : i64 = ty_ref_kind(self.stype[s × 1¤ptrdiff])
            if rk = 1:
                self.derr(tok, "'" ⧺ name ⧺ "' is a shared borrow; & reads and &mut changes")
            elif rk = 0 and self.smut[s × 1¤ptrdiff] = 0:
                self.derr(tok, "'" ⧺ name ⧺ "' is not mut, so nothing may change it")
            self.check_index_expr(tok, st, na)
            self.check_expr(nb, ty_elem(st))
            if self.ty_of(nb) = TY_UNT:
                self.adopt(nb, ty_elem(st))
            elif self.ty_of(nb) ≠ ty_elem(st):
                self.derr(tok, "the array holds " ⧺ type_name(ty_elem(st)) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
            self.nslot[id × 1¤ptrdiff] ← self.sslot[s × 1¤ptrdiff]
        elif k = NK_STOREFLD:
            self.check_expr(na, TY_UNIT)
            let bt : i64 = ty_strip_ref(self.ty_of(na))
            if not ty_is_struct(bt):
                self.derr(tok, "only a struct's field is stored into; this is " ⧺ type_name(bt))
                self.check_expr(nb, TY_UNIT)
                return
            self.require_mut_base(na, tok)
            let (fidx, fty) := self.field_of(ty_sidx(bt), self.text(tok))
            if fidx = ⁻1:
                self.derr(tok, "'" ⧺ self.sname_of(bt) ⧺ "' has no field '" ⧺ self.text(tok) ⧺ "'")
                self.check_expr(nb, TY_UNIT)
                return
            self.a.nc[id × 1¤ptrdiff] ← fidx
            self.check_expr(nb, fty)
            if self.is_open(self.ty_of(nb)):
                self.adopt(nb, fty)
            elif self.ty_of(nb) ≠ fty:
                self.derr(tok, "field '" ⧺ self.text(tok) ⧺ "' holds " ⧺ type_name(fty) ⧺ ", not " ⧺ type_name(self.ty_of(nb)))
        elif k = NK_DISCARD:
            self.check_expr(na, TY_UNIT)
            if self.ty_of(na) = TY_UNT:
                self.adopt(na, TY_I64)
        elif k = NK_IF:
            self.check_expr(na, TY_UNIT)
            self.want_truthy(na, "the condition")
            self.check_block(nb, false)
            if nc ≠ ⁻1:
                self.check_block(nc, false)
        elif k = NK_WHILE:
            self.check_expr(na, TY_UNIT)
            self.want_truthy(na, "the condition")
            self.loop_depth ← self.loop_depth + 1
            self.check_block(nb, false)
            self.loop_depth ← self.loop_depth - 1
        elif k = NK_MATCH:
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if not ty_is_opt(t):
                self.derr(tok, "match asks an optional which it is; this is " ⧺ type_name(t))
                return
            let some_blk : i64 = self.a.extra[nb × 1¤ptrdiff]
            let empty_blk : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
            self.push_scope()
            let slot : i64 = self.declare(tok, ty_opt_base(t), 0)
            self.nslot[id × 1¤ptrdiff] ← slot
            // a trailing match hands each arm's value on as the
            // function's answer
            self.check_block(some_blk, trailing)
            self.pop_scope()
            self.check_block(empty_blk, trailing)
            if trailing and self.a.fns[self.cur_fn × 1¤ptrdiff].ret ≠ TY_UNIT:
                if not self.block_yields(some_blk):
                    self.derr(tok, "the ∃ arm answers nothing on some path")
                if not self.block_yields(empty_blk):
                    self.derr(tok, "the ∅ arm answers nothing on some path")
        elif k = NK_FOREACH:
            self.check_foreach(id, tok, na, nb)
        elif k = NK_FOREACHA:
            self.check_expr(na, TY_UNIT)
            let t : i64 = self.ty_of(na)
            if not ty_is_arr(t):
                self.derr(tok, "foreach walks an array or a range; this is " ⧺ type_name(t))
                return
            self.push_scope()
            let slot : i64 = self.declare(tok, ty_elem(t), 0)
            self.nslot[id × 1¤ptrdiff] ← slot
            self.loop_depth ← self.loop_depth + 1
            self.check_block(nb, false)
            self.loop_depth ← self.loop_depth - 1
            self.pop_scope()
        elif k = NK_RETURN:
            let want : i64 = self.a.fns[self.cur_fn × 1¤ptrdiff].ret
            if na = ⁻1:
                if want ≠ TY_UNIT:
                    self.derr(tok, "the function answers " ⧺ type_name(want) ⧺ "; a bare return does not")
            else:
                self.check_expr(na, want)
                if want = TY_UNIT:
                    self.derr(tok, "the function answers nothing, but this return carries a value")
                elif self.is_open(self.ty_of(na)):
                    self.adopt(na, want)
                elif self.ty_of(na) ≠ want:
                    self.derr(tok, "the function answers " ⧺ self.sname_of(want) ⧺ ", not " ⧺ self.sname_of(self.ty_of(na)))
                if ty_is_struct(want) and not self.is_fresh_struct(na):
                    self.derr(tok, "core-2 returns a struct it just built; borrow with & to share one")
        elif k = NK_BREAK or k = NK_CONTINUE:
            if self.loop_depth = 0:
                self.derr(tok, "there is no loop here to act on")
        elif k = NK_EXPRSTMT:
            let want : i64 = self.a.fns[self.cur_fn × 1¤ptrdiff].ret
            if trailing and want ≠ TY_UNIT:
                self.check_expr(na, want)
                if self.is_open(self.ty_of(na)):
                    self.adopt(na, want)
                elif self.ty_of(na) ≠ want:
                    self.derr(tok, "the function answers " ⧺ self.sname_of(want) ⧺ ", but its last expression is " ⧺ self.sname_of(self.ty_of(na)))
                if ty_is_struct(want) and not self.is_fresh_struct(na):
                    self.derr(tok, "core-2 returns a struct it just built; borrow with & to share one")
            else:
                self.check_expr(na, TY_UNIT)
                let t : i64 = self.ty_of(na)
                if t ≠ TY_UNIT:
                    self.derr(tok, "the value of this statement is not used; bind it or write '_ ← …'")
        else:
            self.derr(tok, "this statement kind escaped the checker; that is an ngplc bug")

    fn check_foreach(&mut self, id : i64, tok : i64, na : i64, body : i64):
        let lo : i64 = self.a.extra[na × 1¤ptrdiff]
        let step : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi : i64 = self.a.extra[(na + 2) × 1¤ptrdiff]
        self.check_expr(lo, TY_UNIT)
        self.check_expr(hi, self.ty_of(lo))
        if step ≠ ⁻1:
            self.check_expr(step, self.ty_of(lo))
        // the variable's type is what the bounds agree on
        let tl : i64 = self.ty_of(lo)
        let th : i64 = self.ty_of(hi)
        let vt : mut i64 = TY_I64
        if tl ≠ TY_UNT:
            vt ← tl
        elif th ≠ TY_UNT:
            vt ← th
        elif step ≠ ⁻1 and self.ty_of(step) ≠ TY_UNT:
            vt ← self.ty_of(step)
        if not ty_is_int(vt):
            self.derr(tok, "a range walks numbers; this is " ⧺ type_name(vt))
            vt ← TY_I64
        self.adopt(lo, vt)
        self.adopt(hi, vt)
        if self.ty_of(lo) ≠ vt or self.ty_of(hi) ≠ vt:
            self.derr(tok, "the range's ends say one type between them")
        if step ≠ ⁻1:
            self.adopt(step, vt)
            if self.ty_of(step) ≠ vt:
                self.derr(tok, "the step follows the range's type")
        self.push_scope()
        let slot : i64 = self.declare(tok, vt, 0)
        self.nslot[id × 1¤ptrdiff] ← slot
        self.loop_depth ← self.loop_depth + 1
        self.check_block(body, false)
        self.loop_depth ← self.loop_depth - 1
        self.pop_scope()

    // ------------------------------------------------------------------
    // Whether execution can only leave this statement by returning
    // ------------------------------------------------------------------

    fn always_returns(&self, id : i64) → bool:
        let k : i64 = self.kind_of(id)
        if k = NK_RETURN:
            return true
        if k = NK_EXPRSTMT:
            let e : i64 = self.a.na[id × 1¤ptrdiff]
            let ek : i64 = self.kind_of(e)
            if ek = NK_SCALL and self.a.na[e × 1¤ptrdiff] = SB_EXIT:
                return true
            if ek = NK_CALL:
                let f : i64 = self.fn_index(self.text(self.a.ntok[e × 1¤ptrdiff]))
                if f ≠ ⁻1:
                    return self.a.fns[f × 1¤ptrdiff].is_noreturn
            return false
        if k = NK_IF:
            let nc : i64 = self.a.nc[id × 1¤ptrdiff]
            if nc = ⁻1:
                return false
            return self.block_returns(self.a.nb[id × 1¤ptrdiff]) and self.block_returns(nc)
        if k = NK_MATCH:
            let nb : i64 = self.a.nb[id × 1¤ptrdiff]
            return self.block_returns(self.a.extra[nb × 1¤ptrdiff]) and self.block_returns(self.a.extra[(nb + 1) × 1¤ptrdiff])
        if k = NK_BLOCK:
            return self.block_returns(id)
        false

    // whether a block's last statement hands a value on or returns
    fn block_yields(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
        self.kind_of(last) = NK_EXPRSTMT or self.kind_of(last) = NK_MATCH or self.always_returns(last)

    fn block_returns(&self, blk : i64) → bool:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return false
        self.always_returns(self.a.extra[(off + n) × 1¤ptrdiff])

    // ------------------------------------------------------------------
    // Functions and globals
    // ------------------------------------------------------------------

    fn check_fn(&mut self, f : i64):
        self.cur_fn ← f
        self.nslots ← 0
        self.loop_depth ← 0
        while #self.snames > 0:
            _ ← self.snames.pop()
            _ ← self.stype.pop()
            _ ← self.smut.pop()
            _ ← self.sslot.pop()
        while #self.marks > 0:
            _ ← self.marks.pop()
        let d := self.a.fns[f × 1¤ptrdiff]
        self.push_scope()
        let np : i64 = self.a.extra[d.params_off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < np:
            let ptok : i64 = self.a.extra[(d.params_off + 1 + i × 2) × 1¤ptrdiff]
            let pty : i64 = self.a.extra[(d.params_off + 2 + i × 2) × 1¤ptrdiff]
            _ ← self.declare(ptok, pty, 1 if ty_ref_kind(pty) = 2 else 0)
            i ← i + 1
        assert(self.nslots >= np, "every parameter took a slot")
        if np > 6:
            self.derr(d.tok, "more than six parameters is not core-2 yet")
        let pi : mut i64 = 0
        while pi < np:
            let pty : i64 = self.a.extra[(d.params_off + 2 + pi × 2) × 1¤ptrdiff]
            if ty_is_struct(pty):
                self.derr(d.tok, "core-2 borrows structs; write &" ⧺ self.sname_of(pty) ⧺ " or &mut " ⧺ self.sname_of(pty))
            if ty_is_arr(pty):
                self.derr(d.tok, "core-2 borrows arrays; write &" ⧺ type_name(pty) ⧺ " or &mut " ⧺ type_name(pty))
            pi ← pi + 1
        if ty_is_arr(d.ret):
            self.derr(d.tok, "core-2 hands arrays around by borrow, not by return")
        self.in_contract ← true
        if d.pre_off ≠ ⁻1:
            let n : i64 = self.a.extra[d.pre_off × 1¤ptrdiff]
            let j : mut i64 = 0
            while j < n:
                let c : i64 = self.a.extra[(d.pre_off + 1 + j) × 1¤ptrdiff]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "@pre")
                j ← j + 1
        if d.post_off ≠ ⁻1:
            let n : i64 = self.a.extra[d.post_off × 1¤ptrdiff]
            self.push_scope()
            if n > 0:
                let rtok : i64 = self.a.extra[(d.post_off + 1) × 1¤ptrdiff]
                if d.ret = TY_UNIT:
                    self.derr(rtok, "@post names a result, but the function answers nothing")
                else:
                    _ ← self.declare(rtok, d.ret, 0)
            let j : mut i64 = 0
            while j < n:
                let c : i64 = self.a.extra[(d.post_off + 2 + j × 2) × 1¤ptrdiff]
                self.check_expr(c, TY_UNIT)
                self.want_truthy(c, "@post")
                j ← j + 1
            self.pop_scope()
        self.in_contract ← false
        self.check_block(d.body, true)
        self.pop_scope()
        if d.ret ≠ TY_UNIT:
            let off : i64 = self.a.na[d.body × 1¤ptrdiff]
            let n : i64 = self.a.extra[off × 1¤ptrdiff]
            let last_is_value : mut bool = false
            if n > 0:
                let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
                if self.kind_of(last) = NK_EXPRSTMT or self.kind_of(last) = NK_MATCH:
                    last_is_value ← true
            if not last_is_value and not self.block_returns(d.body):
                self.derr(d.tok, "'" ⧺ d.name ⧺ "' answers " ⧺ type_name(d.ret) ⧺ " but not on every path")
        self.fslots.push(self.nslots)

    fn check_global(&mut self, g : i64):
        let gd := self.a.globals[g × 1¤ptrdiff]
        if ty_is_arr(gd.ty) or gd.ty = TY_STR:
            self.derr(gd.tok, "a core-1 global is a number or a truth value")
            self.gvals.push(0)
            return
        // fold the initializer to the constant the image carries
        self.check_expr(gd.init, gd.ty)
        if self.ty_of(gd.init) = TY_UNT:
            self.adopt(gd.init, gd.ty)
        elif self.ty_of(gd.init) ≠ gd.ty:
            self.derr(gd.tok, "the binding says " ⧺ type_name(gd.ty) ⧺ " but the value is " ⧺ type_name(self.ty_of(gd.init)))
        let ik : i64 = self.kind_of(gd.init)
        if ik = NK_INT or ik = NK_BOOL:
            self.gvals.push(self.a.na[gd.init × 1¤ptrdiff])
        else:
            self.derr(gd.tok, "a global begins at a constant the compiler can see")
            self.gvals.push(0)

fn check(a : Ast, toks : Toks, src : byte[]) → Chk:
    let fnames : mut str[] = []
    foreach f := a.fns:
        fnames.push(f.name)
    let gnames : mut str[] = []
    foreach g := a.globals:
        gnames.push(g.name)
    let nnodes : i64 = @dropunit(#a.nkind)
    let ntype : i64[] = nnodes ⍴ [0i64]
    let nslot : i64[] = nnodes ⍴ [⁻1i64]
    let c : mut Checker = (Checker{a: a, toks: toks, src: src, fnames: fnames,
                                   gnames: gnames, gvals: [],
                                   ntype: ntype, nslot: nslot, fslots: [],
                                   diags: [], snames: [], stype: [], smut: [],
                                   sslot: [], marks: [], nslots: 0,
                                   loop_depth: 0, cur_fn: 0,
                                   in_contract: false})
    if #a.structs > 0:
        foreach i := 0…#a.structs - 1:
            let sd := a.structs[i]
            foreach j := 0…#a.structs - 1:
                if j > i and a.structs[j].name = sd.name:
                    c.derr(a.structs[j].tok, "'" ⧺ sd.name ⧺ "' is already defined")
            let nf : i64 = a.extra[sd.fields_off × 1¤ptrdiff]
            let x : mut i64 = 0
            while x < nf:
                let y : mut i64 = x + 1
                while y < nf:
                    let tx : i64 = a.extra[(sd.fields_off + 1 + x × 2) × 1¤ptrdiff]
                    let ty0 : i64 = a.extra[(sd.fields_off + 1 + y × 2) × 1¤ptrdiff]
                    if c.text(tx) = c.text(ty0):
                        c.derr(ty0, "'" ⧺ sd.name ⧺ "' names field '" ⧺ c.text(tx) ⧺ "' twice")
                    y ← y + 1
                x ← x + 1
    let starts : mut i64 = 0
    if #a.fns > 0:
      foreach i := 0…#a.fns - 1:
        let f := a.fns[i]
        foreach j := 0…#a.fns - 1:
            if j > i and a.fns[j].name = f.name:
                c.derr(a.fns[j].tok, "'" ⧺ f.name ⧺ "' is already defined")
        if f.name = "assert" or f.name = "assert_eq":
            c.derr(f.tok, "'" ⧺ f.name ⧺ "' is the built-in check's name")
        if f.is_start:
            starts ← starts + 1
            if a.extra[f.params_off × 1¤ptrdiff] ≠ 0:
                c.derr(f.tok, "the @start function takes no parameters")
            if f.ret ≠ TY_UNIT:
                c.derr(f.tok, "the @start function answers nothing in core-1")
            if not f.is_impure:
                c.derr(f.tok, "the @start function is where effects begin; it wants @impure")
    if #a.globals > 0:
        foreach i := 0…#a.globals - 1:
            foreach j := 0…#a.globals - 1:
                if j > i and a.globals[j].name = a.globals[i].name:
                    c.derr(a.globals[j].tok, "'" ⧺ a.globals[i].name ⧺ "' is already defined")
            c.check_global(@dropunit(i))
    if starts = 0:
        c.diags.push(Diag{line: 1, col: 1, msg: "no @start function; nothing would run"})
    if starts > 1:
        c.diags.push(Diag{line: 1, col: 1, msg: "more than one @start function"})
    if #a.fns > 0:
        foreach i := 0…#a.fns - 1:
            c.check_fn(@dropunit(i))
    if #c.diags = 0:
        assert(#c.fslots = #a.fns, "one slot count per function")
        assert(#c.gvals = #a.globals, "one folded value per global")
    (Chk{ntype: c.ntype, nslot: c.nslot, fslots: c.fslots, gvals: c.gvals,
         diags: c.diags})

// ===========================================================================
// The IR: linear three-address code over virtual registers
// ===========================================================================
//
// Every operation carries the width it works at: w = bits + 256×sgn.
// Checked arithmetic aborts on overflow -- a cold, never-taken branch,
// which is what production checkers emit and costs nothing on the hot
// path; @wrap variants mask instead.  Comparisons materialize their
// answer with setcc; selection is a conditional move.

let IR_CONST : i64 = 1     // d ← imm a
let IR_MOV : i64 = 2       // d ← vreg a
let IR_ADD : i64 = 10
let IR_SUB : i64 = 11
let IR_MUL : i64 = 12
let IR_ADDW : i64 = 13
let IR_SUBW : i64 = 14
let IR_MULW : i64 = 15
let IR_NEG : i64 = 16
let IR_NEGW : i64 = 17
let IR_BAND : i64 = 18
let IR_BORR : i64 = 19
let IR_BXORR : i64 = 20
let IR_BNOTT : i64 = 21
let IR_SHLL : i64 = 22
let IR_SHRR : i64 = 23
let IR_DIVV : i64 = 24     // d ← a ÷ b, c the default when b = 0
let IR_MODD : i64 = 25
let IR_MAXX : i64 = 26     // d ← the larger of a and b, by cmov
let IR_MINN : i64 = 27
let IR_SEL : i64 = 28      // d ← b when a is true, else c, by cmov
let IR_CEQ : i64 = 30
let IR_CNE : i64 = 31
let IR_CLT : i64 = 32
let IR_CLE : i64 = 33
let IR_CGT : i64 = 34
let IR_CGE : i64 = 35
let IR_JMP : i64 = 40      // a = label
let IR_JZ : i64 = 41       // a = vreg, b = label
let IR_JNZ : i64 = 42
let IR_LABEL : i64 = 43    // a = label
let IR_CALL : i64 = 44     // d ← call fn a, args at extra b: [argc, vreg…]
let IR_RET : i64 = 45      // a = vreg, ⁻1 for none
let IR_PRINTS : i64 = 46   // a = string index (its bytes)
let IR_PRINTI : i64 = 47   // a = vreg, signed decimal
let IR_PRINTU : i64 = 48   // a = vreg, unsigned decimal
let IR_EXIT : i64 = 49     // a = vreg
let IR_ABORT : i64 = 50    // a = string index of the message
let IR_GLOAD : i64 = 51    // d ← global a
let IR_GSTORE : i64 = 52   // global a ← vreg b
let IR_ANEW : i64 = 53     // d ← a fresh array, capacity imm a
let IR_APUSH : i64 = 54    // array a grows by vreg b
let IR_AIDX : i64 = 55     // d ← a[b], bounds-checked
let IR_ASTO : i64 = 56     // a[b] ← c, bounds-checked
let IR_APOP : i64 = 57     // d ← a's last, or b when empty
let IR_AGET : i64 = 58     // d ← a[b], or c when out of range
let IR_ALEN : i64 = 59     // d ← how many a holds
let IR_SC : i64 = 60       // d ← the descriptor of string literal a
let IR_SCCAT : i64 = 61    // d ← a ⧺ b
let IR_SEQV : i64 = 62     // d ← a = b, for strings
let IR_SLENV : i64 = 63    // d ← how many characters a holds
let IR_PRINTSV : i64 = 64  // a = vreg holding a string
let IR_JTAB : i64 = 65     // a = vreg, b = extra [min, span, Ldef, L…]
let IR_VTAB : i64 = 69     // d ← value table: a = vreg, b = extra [min, span, default, v…]
let IR_SNEW : i64 = 66     // d ← a fresh struct of a fields
let IR_FLD : i64 = 67      // d ← field b of struct a
let IR_FSTO : i64 = 68     // field b of struct a ← c

struct IrFn:
    op : i64[]
    ia : i64[]
    ib : i64[]
    ic : i64[]
    id : i64[]
    iw : i64[]
    extra : i64[]
    nvregs : i64
    nlabels : i64

// ===========================================================================
// Lowering: Ast + Chk → IrFn per function
// ===========================================================================

struct Lower:
    a : Ast
    toks : Toks
    src : byte[]
    ntype : i64[]
    nslot : i64[]
    strs : str[]
    op : i64[]
    ia : i64[]
    ib : i64[]
    ic : i64[]
    idd : i64[]
    iww : i64[]
    extra : i64[]
    tbase : i64
    tnext : i64
    tmax : i64
    nlabels : i64
    breaks : i64[]
    conts : i64[]
    in_wrap : i64
    cur_ret : i64
    post_label : i64
    res_vreg : i64
    cur_fname : str
    dlog : str[]         // one JSON line per code-shaping decision

@post(r: (r & 255) >= 8 and (r & 255) <= 64)
fn width_of(t : i64) → i64:
    // the width an operation on this type runs at, bits + 256×sgn
    if t = TY_BOOL: return 64 + 256
    if not ty_is_int(t): return 64 + 256
    ty_bits(t) + 256 × ty_sgn(t)

impl Lower:
    fn ir(&mut self, o : i64, a : i64, b : i64, c : i64, d : i64, w : i64):
        self.op.push(o)
        self.ia.push(a)
        self.ib.push(b)
        self.ic.push(c)
        self.idd.push(d)
        self.iww.push(w)

    fn tmp(&mut self) → i64:
        let v : i64 = self.tnext
        self.tnext ← self.tnext + 1
        if self.tnext > self.tmax:
            self.tmax ← self.tnext
        v

    fn label(&mut self) → i64:
        let l : i64 = self.nlabels
        self.nlabels ← self.nlabels + 1
        l

    fn intern(&mut self, s : str) → i64:
        foreach i := 0…#self.strs - 1:
            if self.strs[i] = s:
                return @dropunit(i)
        let idx : i64 = @dropunit(#self.strs)
        self.strs.push(s)
        idx

    fn fname_index(&self, name : str) → i64:
        foreach i := 0…#self.a.fns - 1:
            if self.a.fns[i].name = name:
                return @dropunit(i)
        ⁻1

    fn text(&self, tok : i64) → str:
        run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    fn tok_line(&self, tok : i64) → i64:
        self.toks.line[tok × 1¤ptrdiff]

    // what was decided and where, for the log a program can read
    fn decide(&mut self, line : i64, what : str, detail : str):
        self.dlog.push("{\"function\": \"" ⧺ self.cur_fname ⧺ "\", \"line\": " ⧺ i64_str(line) ⧺ ", \"decision\": \"" ⧺ what ⧺ "\"" ⧺ detail ⧺ "}")

    fn tof(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kof(&self, id : i64) → i64:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // What may be read without being asked: no effects, no faults.
    // Checked arithmetic can abort, so only @wrap arithmetic passes;
    // loads from arrays are bounds-checked, so they do not.  This is
    // the speculation-legality rule if-conversion runs on.
    // ------------------------------------------------------------------

    fn speculatable(&self, id : i64) → bool:
        let k : i64 = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = NK_INT or k = NK_BOOL or k = NK_STR or k = NK_VAR or k = NK_EMPTYV:
            return true
        if k = NK_NOT or k = NK_BNOT:
            return self.speculatable(na)
        if k = NK_LEN or k = NK_FIELD:
            return self.speculatable(na)
        if k = NK_WRAP:
            return self.wrap_speculatable(na)
        if k = NK_EQ or k = NK_NE or k = NK_LT or k = NK_LE or k = NK_GT or k = NK_GE or k = NK_LAND or k = NK_LOR or k = NK_AND or k = NK_OR or k = NK_MAXOP or k = NK_MINOP:
            return self.speculatable(na) and self.speculatable(nb)
        if k = NK_COND:
            return self.speculatable(na) and self.speculatable(nb) and self.speculatable(nc)
        false

    fn wrap_speculatable(&self, id : i64) → bool:
        // inside @wrap the arithmetic cannot abort; shifts still can
        let k : i64 = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if k = NK_ADD or k = NK_SUB or k = NK_MUL or k = NK_BAND or k = NK_BOR or k = NK_BXOR:
            return self.wrap_speculatable(na) and self.wrap_speculatable(nb)
        if k = NK_NEG or k = NK_BNOT:
            return self.wrap_speculatable(na)
        self.speculatable(id)

    // ------------------------------------------------------------------
    // Expressions
    // ------------------------------------------------------------------

    fn lower_expr(&mut self, nid : i64) → i64:
        let k : i64 = self.kof(nid)
        let tok : i64 = self.a.ntok[nid × 1¤ptrdiff]
        let na : i64 = self.a.na[nid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[nid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[nid × 1¤ptrdiff]
        let w : i64 = width_of(self.tof(nid))
        if k = NK_INT or k = NK_BOOL:
            let d : i64 = self.tmp()
            self.ir(IR_CONST, na, 0, 0, d, w)
            return d
        if k = NK_STR:
            let d : i64 = self.tmp()
            self.ir(IR_SC, na, 0, 0, d, w)
            return d
        if k = NK_VAR:
            let slot : i64 = self.nslot[nid × 1¤ptrdiff]
            if slot <= ⁻2:
                let d : i64 = self.tmp()
                self.ir(IR_GLOAD, @wrap(0 - slot - 2), 0, 0, d, w)
                return d
            return slot
        if k = NK_ARRLIT:
            return self.lower_arrlit(nid, na)
        if k = NK_SLIT:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, n, 0, 0, d, 0)
            let i : mut i64 = 0
            while i < n:
                let fidx : i64 = self.a.extra[(na + 1 + i × 2) × 1¤ptrdiff]
                let ev : i64 = self.lower_expr(self.a.extra[(na + 2 + i × 2) × 1¤ptrdiff])
                self.ir(IR_FSTO, d, fidx, ev, 0, 0)
                i ← i + 1
            return d
        if k = NK_FIELD:
            let bv : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_FLD, bv, nb, 0, d, 0)
            return d
        if k = NK_SOME:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_SNEW, 1, 0, 0, d, 0)
            self.ir(IR_FSTO, d, 0, v, 0, 0)
            return d
        if k = NK_EMPTYV:
            let d : i64 = self.tmp()
            self.ir(IR_CONST, 0, 0, 0, d, 0)
            return d
        if k = NK_INDEX:
            let av : i64 = self.lower_expr(na)
            let iv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_AIDX, av, iv, 0, d, w)
            return d
        if k = NK_LEN:
            let av : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            if self.tof(na) = TY_STR:
                self.ir(IR_SLENV, av, 0, 0, d, w)
            else:
                self.ir(IR_ALEN, av, 0, 0, d, w)
            return d
        if k = NK_CALL:
            return self.lower_call(nid, tok, na)
        if k = NK_SCALL:
            self.lower_scall(nid, tok, na, nb)
            return ⁻1
        if k = NK_MCALL:
            return self.lower_mcall(nid, ⁻1)
        if k = NK_REF:
            return self.lower_expr(na)
        if k = NK_NEG:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_NEGW if self.in_wrap > 0 else IR_NEG, v, 0, 0, d, w)
            return d
        if k = NK_BNOT:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(IR_BNOTT, v, 0, 0, d, w)
            return d
        if k = NK_NOT:
            // the operand is a bool, 0 or 1; flipping it is one xor
            let v : i64 = self.lower_expr(na)
            let one : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one, 64)
            let d : i64 = self.tmp()
            self.ir(IR_BXORR, v, one, 0, d, 64)
            return d
        if k = NK_WRAP:
            self.in_wrap ← self.in_wrap + 1
            let v : i64 = self.lower_expr(na)
            self.in_wrap ← self.in_wrap - 1
            return v
        if k = NK_COND:
            return self.lower_cond(nid, na, nb, nc, w)
        if k = NK_DEFAULT:
            return self.lower_default(nid, na, nb)
        if k = NK_AND or k = NK_OR:
            return self.lower_andor(nid, k, na, nb)
        if k = NK_CCAT:
            let av : i64 = self.lower_expr(na)
            let bv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_SCCAT, av, bv, 0, d, w)
            return d
        if k = NK_EQ or k = NK_NE:
            if self.tof(na) = TY_STR:
                let av : i64 = self.lower_expr(na)
                let bv : i64 = self.lower_expr(nb)
                let d : i64 = self.tmp()
                self.ir(IR_SEQV, av, bv, 0, d, 64)
                if k = NK_NE:
                    let z : i64 = self.tmp()
                    self.ir(IR_CONST, 0, 0, 0, z, 64)
                    let d2 : i64 = self.tmp()
                    self.ir(IR_CEQ, d, z, 0, d2, 64)
                    return d2
                return d
        // the remaining family evaluates both sides
        let av : i64 = self.lower_expr(na)
        let bv : i64 = self.lower_expr(nb)
        let d : i64 = self.tmp()
        let ow : i64 = width_of(self.tof(na))
        if k = NK_ADD:
            self.ir(IR_ADDW if self.in_wrap > 0 else IR_ADD, av, bv, 0, d, w)
        elif k = NK_SUB:
            self.ir(IR_SUBW if self.in_wrap > 0 else IR_SUB, av, bv, 0, d, w)
        elif k = NK_MUL:
            self.ir(IR_MULW if self.in_wrap > 0 else IR_MUL, av, bv, 0, d, w)
        elif k = NK_SHL:
            self.ir(IR_SHLL, av, bv, 0, d, w)
        elif k = NK_SHR:
            self.ir(IR_SHRR, av, bv, 0, d, w)
        elif k = NK_BAND:
            self.ir(IR_BAND, av, bv, 0, d, w)
        elif k = NK_BOR:
            self.ir(IR_BORR, av, bv, 0, d, w)
        elif k = NK_BXOR:
            self.ir(IR_BXORR, av, bv, 0, d, w)
        elif k = NK_EQ:
            self.ir(IR_CEQ, av, bv, 0, d, ow)
        elif k = NK_NE:
            self.ir(IR_CNE, av, bv, 0, d, ow)
        elif k = NK_LT:
            self.ir(IR_CLT, av, bv, 0, d, ow)
        elif k = NK_LE:
            self.ir(IR_CLE, av, bv, 0, d, ow)
        elif k = NK_GT:
            self.ir(IR_CGT, av, bv, 0, d, ow)
        elif k = NK_GE:
            self.ir(IR_CGE, av, bv, 0, d, ow)
        elif k = NK_LAND or k = NK_LOR:
            // both sides are bools already; one and or or does it
            self.ir(IR_BAND if k = NK_LAND else IR_BORR, av, bv, 0, d, 64)
        elif k = NK_MAXOP:
            self.ir(IR_MAXX, av, bv, 0, d, w)
        elif k = NK_MINOP:
            self.ir(IR_MINN, av, bv, 0, d, w)
        return d

    fn lower_cond(&mut self, nid : i64, na : i64, nb : i64, nc : i64, w : i64) → i64:
        // a select when both sides may be read; branches otherwise
        self.decide(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]),
                    "select" if self.speculatable(na) and self.speculatable(nc) else "branched-conditional", "")
        if self.speculatable(na) and self.speculatable(nc):
            let cv : i64 = self.lower_expr(nb)
            let tv : i64 = self.lower_expr(na)
            let ev : i64 = self.lower_expr(nc)
            let d : i64 = self.tmp()
            self.ir(IR_SEL, cv, tv, ev, d, w)
            return d
        let d : i64 = self.tmp()
        let lelse : i64 = self.label()
        let lend : i64 = self.label()
        let cv : i64 = self.lower_expr(nb)
        self.ir(IR_JZ, cv, lelse, 0, 0, 0)
        let tv : i64 = self.lower_expr(na)
        self.ir(IR_MOV, tv, 0, 0, d, 0)
        self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
        let ev : i64 = self.lower_expr(nc)
        self.ir(IR_MOV, ev, 0, 0, d, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    fn lower_andor(&mut self, nid : i64, k : i64, na : i64, nb : i64) → i64:
        // a pure, fault-free right side may be read eagerly, and the
        // whole answer becomes three straight-line instructions
        self.decide(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]),
                    "eager-logic" if self.speculatable(nb) else "short-circuit", "")
        if self.speculatable(nb):
            let av : i64 = self.lower_expr(na)
            let bv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_BAND if k = NK_AND else IR_BORR, av, bv, 0, d, 64)
            return d
        let d : i64 = self.tmp()
        let lend : i64 = self.label()
        let av : i64 = self.lower_expr(na)
        self.ir(IR_CONST, 0 if k = NK_AND else 1, 0, 0, d, 64)
        self.ir(IR_JZ if k = NK_AND else IR_JNZ, av, lend, 0, 0, 0)
        let bv : i64 = self.lower_expr(nb)
        self.ir(IR_MOV, bv, 0, 0, d, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    fn lower_default(&mut self, nid : i64, na : i64, nb : i64) → i64:
        let ik : i64 = self.kof(na)
        if ik = NK_DIV or ik = NK_MOD:
            let av : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
            let bv : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
            let dv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(IR_DIVV if ik = NK_DIV else IR_MODD, av, bv, dv, d,
                    width_of(self.tof(na)))
            return d
        if ik = NK_MCALL and self.a.nc[na × 1¤ptrdiff] < 1000:
            return self.lower_mcall(na, nb)
        // any optional: absent takes the default, present unwraps
        let v : i64 = self.lower_expr(na)
        let d : i64 = self.tmp()
        let ldef : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_JZ, v, ldef, 0, 0, 0)
        self.ir(IR_FLD, v, 0, 0, d, 0)
        self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, ldef, 0, 0, 0, 0)
        let dv : i64 = self.lower_expr(nb)
        self.ir(IR_MOV, dv, 0, 0, d, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        d

    fn lower_mcall(&mut self, nid : i64, defnode : i64) → i64:
        let mid : i64 = self.a.nc[nid × 1¤ptrdiff]
        let base : i64 = self.a.na[nid × 1¤ptrdiff]
        let args_off : i64 = self.a.nb[nid × 1¤ptrdiff]
        if mid >= 1000:
            // a struct's method is a function with the receiver first
            let f : i64 = ((mid - 1000) ÷ 2) ?? 0
            let inst : i64 = (mid - 1000) & 1
            let vregs : mut i64[] = []
            if inst = 1:
                vregs.push(self.lower_expr(base))
            let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
            let i : mut i64 = 0
            while i < argc:
                vregs.push(self.lower_expr(self.a.extra[(args_off + 1 + i) × 1¤ptrdiff]))
                i ← i + 1
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(@dropunit(#vregs))
            foreach v := vregs:
                self.extra.push(v)
            let d : i64 = self.tmp()
            self.ir(IR_CALL, f, off, 0, d, 0)
            return d
        let av : i64 = self.lower_expr(base)
        let w : i64 = width_of(self.tof(nid))
        if mid = MID_PUSH:
            let vv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_APUSH, av, vv, 0, 0, 0)
            return ⁻1
        if mid = MID_POP:
            let dv : i64 = self.lower_expr(defnode)
            let d : i64 = self.tmp()
            self.ir(IR_APOP, av, dv, 0, d, w)
            return d
        // get
        let iv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
        let dv : i64 = self.lower_expr(defnode)
        let d : i64 = self.tmp()
        self.ir(IR_AGET, av, iv, dv, d, w)
        d

    fn lower_arrlit(&mut self, nid : i64, off : i64) → i64:
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let d : i64 = self.tmp()
        self.ir(IR_ANEW, n ⌈ 4, 0, 0, d, 0)
        let i : mut i64 = 0
        while i < n:
            let ev : i64 = self.lower_expr(self.a.extra[(off + 1 + i) × 1¤ptrdiff])
            self.ir(IR_APUSH, d, ev, 0, 0, 0)
            i ← i + 1
        d

    fn lower_call(&mut self, nid : i64, tok : i64, args_off : i64) → i64:
        let name := self.text(tok)
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if name = "assert" or name = "assert_eq":
            self.lower_assert(nid, tok, args_off, name = "assert_eq")
            return ⁻1
        let vregs : mut i64[] = []
        let i : mut i64 = 0
        while i < argc:
            vregs.push(self.lower_expr(self.a.extra[(args_off + 1 + i) × 1¤ptrdiff]))
            i ← i + 1
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(argc)
        foreach v := vregs:
            self.extra.push(v)
        let f : i64 = self.fname_index(name)
        let d : i64 = self.tmp()
        self.ir(IR_CALL, f, off, 0, d, 0)
        d

    fn lower_assert(&mut self, nid : i64, tok : i64, args_off : i64, is_eq : bool):
        let line : i64 = self.tok_line(tok)
        let lok : i64 = self.label()
        if is_eq:
            let x : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
            let y : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
            let av : i64 = self.lower_expr(x)
            let bv : i64 = self.lower_expr(y)
            let c : i64 = self.tmp()
            self.ir(IR_CEQ, av, bv, 0, c, width_of(self.tof(x)))
            self.ir(IR_JNZ, c, lok, 0, 0, 0)
            let m : i64 = self.intern("assertion does not hold (line " ⧺ i64_str(line) ⧺ ")\n")
            self.ir(IR_ABORT, m, 0, 0, 0, 0)
        else:
            let cv : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_JNZ, cv, lok, 0, 0, 0)
            let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
            let msg : mut str = "assertion does not hold (line " ⧺ i64_str(line) ⧺ ")\n"
            if argc = 2:
                let marg : i64 = self.a.extra[(args_off + 2) × 1¤ptrdiff]
                msg ← "assertion does not hold (line " ⧺ i64_str(line) ⧺ "): " ⧺ self.a.strs[self.a.na[marg × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\n"
            let m : i64 = self.intern(msg)
            self.ir(IR_ABORT, m, 0, 0, 0, 0)
        self.ir(IR_LABEL, lok, 0, 0, 0, 0)

    fn lower_scall(&mut self, nid : i64, tok : i64, sb : i64, args_off : i64):
        let argc : i64 = self.a.extra[args_off × 1¤ptrdiff]
        if sb = SB_EXIT:
            let v : i64 = self.lower_expr(self.a.extra[(args_off + 1) × 1¤ptrdiff])
            self.ir(IR_EXIT, v, 0, 0, 0, 0)
            return
        let fmt : i64 = self.a.extra[(args_off + 1) × 1¤ptrdiff]
        let cs := self.a.strs[self.a.na[fmt × 1¤ptrdiff] × 1¤ptrdiff].chars()
        let chunk : mut str = ""
        let argi : mut i64 = 2
        let i ¤ptrdiff : mut i64 = 0
        while i < #cs:
            if i + 1 < #cs and cs[i] = '{' and cs[i + 1] = '}':
                if chunk ≠ "":
                    let m : i64 = self.intern(chunk)
                    self.ir(IR_PRINTS, m, 0, 0, 0, 0)
                    chunk ← ""
                let arg : i64 = self.a.extra[(args_off + argi) × 1¤ptrdiff]
                self.lower_print_arg(arg)
                argi ← argi + 1
                i ← i + 2
            else:
                chunk ← chunk ⧺ cs[i]
                i ← i + 1
        if sb = SB_PRINTLN:
            chunk ← chunk ⧺ (10).chr()
        if chunk ≠ "":
            let m : i64 = self.intern(chunk)
            self.ir(IR_PRINTS, m, 0, 0, 0, 0)

    fn lower_print_arg(&mut self, arg : i64):
        let t : i64 = self.tof(arg)
        if t = TY_STR:
            if self.kof(arg) = NK_STR:
                let m : i64 = self.intern(self.a.strs[self.a.na[arg × 1¤ptrdiff] × 1¤ptrdiff])
                self.ir(IR_PRINTS, m, 0, 0, 0, 0)
            else:
                let v : i64 = self.lower_expr(arg)
                self.ir(IR_PRINTSV, v, 0, 0, 0, 0)
        elif t = TY_BOOL:
            let v : i64 = self.lower_expr(arg)
            let mt : i64 = self.intern("true")
            let mf : i64 = self.intern("false")
            let lfalse : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, v, lfalse, 0, 0, 0)
            self.ir(IR_PRINTS, mt, 0, 0, 0, 0)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, lfalse, 0, 0, 0, 0)
            self.ir(IR_PRINTS, mf, 0, 0, 0, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        else:
            let v : i64 = self.lower_expr(arg)
            if ty_sgn(t) = 1:
                self.ir(IR_PRINTI, v, 0, 0, 0, 0)
            else:
                self.ir(IR_PRINTU, v, 0, 0, 0, 0)
            // a measured value prints its measure, as the interpreter does
            let u : i64 = ty_unit(t)
            if u = UNIT_PTRDIFF:
                self.ir(IR_PRINTS, self.intern(" ptrdiff"), 0, 0, 0, 0)
            elif u = UNIT_BYTE:
                self.ir(IR_PRINTS, self.intern(" B"), 0, 0, 0, 0)

    // ------------------------------------------------------------------
    // Statements
    // ------------------------------------------------------------------

    fn lower_block(&mut self, blk : i64, is_fn_body : bool, ret_ty : i64):
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let i : mut i64 = 0
        while i < n:
            let s : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let trailing : bool = is_fn_body and i = n - 1
            self.lower_stmt(s, trailing, ret_ty)
            i ← i + 1

    fn lower_ret(&mut self, v : i64):
        if self.post_label ≠ ⁻1:
            self.ir(IR_MOV, v, 0, 0, self.res_vreg, 0)
            self.ir(IR_JMP, self.post_label, 0, 0, 0, 0)
        else:
            self.ir(IR_RET, v, 0, 0, 0, 0)

    fn lower_stmt(&mut self, sid : i64, trailing : bool, ret_ty : i64):
        self.tnext ← self.tbase
        let k : i64 = self.kof(sid)
        let tok : i64 = self.a.ntok[sid × 1¤ptrdiff]
        let na : i64 = self.a.na[sid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[sid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[sid × 1¤ptrdiff]
        if k = NK_LET:
            let v : i64 = self.lower_expr(na)
            self.ir(IR_MOV, v, 0, 0, self.nslot[sid × 1¤ptrdiff], 0)
        elif k = NK_ASSIGN:
            let v : i64 = self.lower_expr(na)
            let slot : i64 = self.nslot[sid × 1¤ptrdiff]
            if slot <= ⁻2:
                self.ir(IR_GSTORE, @wrap(0 - slot - 2), v, 0, 0, 0)
            else:
                self.ir(IR_MOV, v, 0, 0, slot, 0)
        elif k = NK_STOREFLD:
            let bv : i64 = self.lower_expr(na)
            let vv : i64 = self.lower_expr(nb)
            self.ir(IR_FSTO, bv, nc, vv, 0, 0)
        elif k = NK_STOREFLD:
            let bv : i64 = self.lower_expr(na)
            let vv : i64 = self.lower_expr(nb)
            self.ir(IR_FSTO, bv, nc, vv, 0, 0)
        elif k = NK_STOREIDX:
            let slot : i64 = self.nslot[sid × 1¤ptrdiff]
            let iv : i64 = self.lower_expr(na)
            let vv : i64 = self.lower_expr(nb)
            self.ir(IR_ASTO, slot, iv, vv, 0, 0)
        elif k = NK_DISCARD:
            _ ← self.lower_expr(na)
        elif k = NK_EXPRSTMT:
            if trailing and ret_ty ≠ TY_UNIT:
                let v : i64 = self.lower_expr(na)
                self.lower_ret(v)
            else:
                _ ← self.lower_expr(na)
        elif k = NK_RETURN:
            if na = ⁻1:
                self.ir(IR_RET, ⁻1, 0, 0, 0, 0)
            else:
                let v : i64 = self.lower_expr(na)
                self.lower_ret(v)
        elif k = NK_IF:
            if self.try_jtab(sid, ret_ty):
                return
            let lelse : i64 = self.label()
            let cv : i64 = self.lower_expr(na)
            self.ir(IR_JZ, cv, lelse, 0, 0, 0)
            self.lower_block(nb, false, ret_ty)
            if nc = ⁻1:
                self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
            else:
                let lend : i64 = self.label()
                self.ir(IR_JMP, lend, 0, 0, 0, 0)
                self.ir(IR_LABEL, lelse, 0, 0, 0, 0)
                self.lower_block(nc, false, ret_ty)
                self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        elif k = NK_WHILE:
            let ltop : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
            let cv : i64 = self.lower_expr(na)
            self.ir(IR_JZ, cv, lend, 0, 0, 0)
            self.breaks.push(lend)
            self.conts.push(ltop)
            self.lower_block(nb, false, ret_ty)
            _ ← self.breaks.pop()
            _ ← self.conts.pop()
            self.ir(IR_JMP, ltop, 0, 0, 0, 0)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        elif k = NK_MATCH:
            let v : i64 = self.lower_expr(na)
            let bind : i64 = self.nslot[sid × 1¤ptrdiff]
            let lempty : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(IR_JZ, v, lempty, 0, 0, 0)
            self.ir(IR_FLD, v, 0, 0, bind, 0)
            self.lower_block(self.a.extra[nb × 1¤ptrdiff], trailing, ret_ty)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
            self.ir(IR_LABEL, lempty, 0, 0, 0, 0)
            self.lower_block(self.a.extra[(nb + 1) × 1¤ptrdiff], trailing, ret_ty)
            self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        elif k = NK_FOREACH:
            self.lower_foreach(sid, tok, na, nb, ret_ty)
        elif k = NK_FOREACHA:
            self.lower_foreacha(sid, tok, na, nb, ret_ty)
        elif k = NK_BREAK:
            self.ir(IR_JMP, self.breaks[#self.breaks - 1], 0, 0, 0, 0)
        elif k = NK_CONTINUE:
            self.ir(IR_JMP, self.conts[#self.conts - 1], 0, 0, 0, 0)

    // ------------------------------------------------------------------
    // Dense dispatch becomes a jump table.  An if/elif ladder testing
    // one variable against integer constants is one decision, not
    // many; with at least four cases and a span within three times
    // their count (the profitability window real compilers use), the
    // ladder lowers to a bounds check and one indirect jump through a
    // table of code addresses in rodata.
    // ------------------------------------------------------------------

    fn try_jtab(&mut self, sid : i64, ret_ty : i64) → bool:
        let ks : mut i64[] = []
        let blks : mut i64[] = []
        let xslot : mut i64 = ⁻1
        let default_blk : mut i64 = ⁻1
        let cur : mut i64 = sid
        let good : mut bool = true
        while true:
            let cond : i64 = self.a.na[cur × 1¤ptrdiff]
            if self.kof(cond) ≠ NK_EQ:
                good ← false
                break
            let l : i64 = self.a.na[cond × 1¤ptrdiff]
            let r : i64 = self.a.nb[cond × 1¤ptrdiff]
            let vn : mut i64 = ⁻1
            let kn : mut i64 = ⁻1
            if self.kof(l) = NK_VAR and self.kof(r) = NK_INT:
                vn ← l
                kn ← r
            elif self.kof(r) = NK_VAR and self.kof(l) = NK_INT:
                vn ← r
                kn ← l
            else:
                good ← false
                break
            let slot : i64 = self.nslot[vn × 1¤ptrdiff]
            if slot < 0 or self.a.nb[kn × 1¤ptrdiff] ≠ 0:
                // a global, or a constant past i64: leave it a ladder
                good ← false
                break
            if xslot = ⁻1:
                xslot ← slot
            elif slot ≠ xslot:
                good ← false
                break
            ks.push(self.a.na[kn × 1¤ptrdiff])
            blks.push(self.a.nb[cur × 1¤ptrdiff])
            let els : i64 = self.a.nc[cur × 1¤ptrdiff]
            if els = ⁻1:
                break
            // an elif chain is an else block holding exactly one if
            let off : i64 = self.a.na[els × 1¤ptrdiff]
            if self.a.extra[off × 1¤ptrdiff] = 1 and self.kof(self.a.extra[(off + 1) × 1¤ptrdiff]) = NK_IF:
                cur ← self.a.extra[(off + 1) × 1¤ptrdiff]
            else:
                default_blk ← els
                break
        assert(#ks = #blks, "one arm per case")
        if not good or #ks < 4:
            return false
        let lo : mut i64 = ks[0]
        let hi : mut i64 = ks[0]
        foreach k := ks:
            lo ← lo ⌊ k
            hi ← hi ⌈ k
        let span : i64 = hi - lo + 1
        let shape : str = ", \"cases\": " ⧺ i64_str(@dropunit(#ks)) ⧺ ", \"span\": " ⧺ i64_str(span)
        if span > 3 × @dropunit(#ks) or span > 1024:
            self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "ladder-kept", shape)
            return false
        // distinct cases; a repeat would silently shadow, so leave a
        // repeat to the ladder the checker saw
        foreach i := 0…#ks - 1:
            foreach j := 0…#ks - 1:
                if j > i and ks[i] = ks[j]:
                    return false
        // a ladder whose every arm returns a constant, default
        // included, is not control flow at all: it folds to one load
        // from a table of values and one select against the default
        if default_blk ≠ ⁻1 and self.post_label = ⁻1:
            let vals : mut i64[] = []
            let all_const : mut bool = true
            foreach b := blks:
                let cv : i64 = self.block_ret_const(b)
                if cv = ⁻4611686018427387904:
                    all_const ← false
                vals.push(cv)
            let defv : i64 = self.block_ret_const(default_blk)
            if defv = ⁻4611686018427387904:
                all_const ← false
            if all_const:
                let off0 : i64 = @dropunit(#self.extra)
                self.extra.push(lo)
                self.extra.push(span)
                self.extra.push(defv)
                let si : mut i64 = 0
                while si < span:
                    let entry : mut i64 = defv
                    foreach i := 0…#ks - 1:
                        if ks[i] = lo + si:
                            entry ← vals[i]
                    self.extra.push(entry)
                    si ← si + 1
                let xv0 : i64 = xslot
                let d : i64 = self.tmp()
                self.ir(IR_VTAB, xv0, off0, 0, d, 0)
                self.ir(IR_RET, d, 0, 0, 0, 0)
                self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "value-table", shape)
                return true
        // labels: one per case, the default, the join
        let ldef : i64 = self.label()
        let lend : i64 = self.label()
        let case_labels : mut i64[] = []
        foreach _ := 0…#ks - 1:
            case_labels.push(self.label())
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(lo)
        self.extra.push(span)
        self.extra.push(ldef)
        let s : mut i64 = 0
        while s < span:
            let target : mut i64 = ldef
            foreach i := 0…#ks - 1:
                if ks[i] = lo + s:
                    target ← case_labels[i]
            self.extra.push(target)
            s ← s + 1
        self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "jump-table", shape)
        self.ir(IR_JTAB, xslot, off, 0, 0, 0)
        foreach i := 0…#ks - 1:
            self.ir(IR_LABEL, case_labels[i], 0, 0, 0, 0)
            self.lower_block(blks[i], false, ret_ty)
            self.ir(IR_JMP, lend, 0, 0, 0, 0)
        self.ir(IR_LABEL, ldef, 0, 0, 0, 0)
        if default_blk ≠ ⁻1:
            self.lower_block(default_blk, false, ret_ty)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        true

    // the constant a block returns, or the impossible sentinel
    fn block_ret_const(&self, blk : i64) → i64:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        if self.a.extra[off × 1¤ptrdiff] ≠ 1:
            return ⁻4611686018427387904
        let st : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        if self.kof(st) ≠ NK_RETURN:
            return ⁻4611686018427387904
        let e : i64 = self.a.na[st × 1¤ptrdiff]
        if e = ⁻1:
            return ⁻4611686018427387904
        let ek : i64 = self.kof(e)
        if ek ≠ NK_INT and ek ≠ NK_BOOL:
            return ⁻4611686018427387904
        // a constant that happens to be the sentinel itself simply
        // does not fold; the jump table serves it instead
        self.a.na[e × 1¤ptrdiff]

    fn lower_foreach(&mut self, sid : i64, tok : i64, na : i64, body : i64,
                     ret_ty : i64):
        let lo_n : i64 = self.a.extra[na × 1¤ptrdiff]
        let step_n : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi_n : i64 = self.a.extra[(na + 2) × 1¤ptrdiff]
        let ivar : i64 = self.nslot[sid × 1¤ptrdiff]
        let lov : i64 = self.lower_expr(lo_n)
        let hiv0 : i64 = self.lower_expr(hi_n)
        let hiv : i64 = self.tmp()
        self.ir(IR_MOV, hiv0, 0, 0, hiv, 0)
        let dirv : i64 = self.tmp()
        if step_n = ⁻1:
            // without a step the direction follows the bounds: a cmov,
            // not a branch
            let c : i64 = self.tmp()
            self.ir(IR_CLE, lov, hiv, 0, c, 64 + 256)
            let one : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one, 0)
            let mone : i64 = self.tmp()
            self.ir(IR_CONST, ⁻1, 0, 0, mone, 0)
            self.ir(IR_SEL, c, one, mone, dirv, 0)
        else:
            let sv : i64 = self.lower_expr(step_n)
            self.ir(IR_MOV, sv, 0, 0, dirv, 0)
            let lz : i64 = self.label()
            self.ir(IR_JNZ, dirv, lz, 0, 0, 0)
            let m : i64 = self.intern("a foreach step of zero never arrives (line " ⧺ i64_str(self.tok_line(tok)) ⧺ ")\n")
            self.ir(IR_ABORT, m, 0, 0, 0, 0)
            self.ir(IR_LABEL, lz, 0, 0, 0, 0)
        self.ir(IR_MOV, lov, 0, 0, ivar, 0)
        let saved_base : i64 = self.tbase
        self.tbase ← self.tnext
        let ltop : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        // still inside: (dir > 0 ∧ i ≤ hi) ∨ (dir < 0 ∧ i ≥ hi) --
        // materialized comparisons, no branches until the one decision
        let z : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, z, 0)
        let up : i64 = self.tmp()
        self.ir(IR_CGT, dirv, z, 0, up, 64 + 256)
        let le : i64 = self.tmp()
        self.ir(IR_CLE, ivar, hiv, 0, le, 64 + 256)
        let c1 : i64 = self.tmp()
        self.ir(IR_BAND, up, le, 0, c1, 64)
        let down : i64 = self.tmp()
        self.ir(IR_CLT, dirv, z, 0, down, 64 + 256)
        let ge : i64 = self.tmp()
        self.ir(IR_CGE, ivar, hiv, 0, ge, 64 + 256)
        let c2 : i64 = self.tmp()
        self.ir(IR_BAND, down, ge, 0, c2, 64)
        let c : i64 = self.tmp()
        self.ir(IR_BORR, c1, c2, 0, c, 64)
        self.ir(IR_JZ, c, lend, 0, 0, 0)
        self.breaks.push(lend)
        self.conts.push(lcont)
        self.lower_block(body, false, ret_ty)
        _ ← self.breaks.pop()
        _ ← self.conts.pop()
        self.ir(IR_LABEL, lcont, 0, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(IR_ADDW, ivar, dirv, 0, ni, 64 + 256)
        self.ir(IR_MOV, ni, 0, 0, ivar, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        self.tbase ← saved_base

    fn lower_foreacha(&mut self, sid : i64, tok : i64, arr : i64, body : i64,
                      ret_ty : i64):
        let evar : i64 = self.nslot[sid × 1¤ptrdiff]
        let av : i64 = self.lower_expr(arr)
        let desc : i64 = self.tmp()
        self.ir(IR_MOV, av, 0, 0, desc, 0)
        let iv : i64 = self.tmp()
        self.ir(IR_CONST, 0, 0, 0, iv, 0)
        let saved_base : i64 = self.tbase
        self.tbase ← self.tnext
        let ltop : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(IR_LABEL, ltop, 0, 0, 0, 0)
        let n : i64 = self.tmp()
        self.ir(IR_ALEN, desc, 0, 0, n, 0)
        let c : i64 = self.tmp()
        self.ir(IR_CLT, iv, n, 0, c, 64 + 256)
        self.ir(IR_JZ, c, lend, 0, 0, 0)
        self.ir(IR_AIDX, desc, iv, 0, evar, 0)
        self.breaks.push(lend)
        self.conts.push(lcont)
        self.lower_block(body, false, ret_ty)
        _ ← self.breaks.pop()
        _ ← self.conts.pop()
        self.ir(IR_LABEL, lcont, 0, 0, 0, 0)
        let one : i64 = self.tmp()
        self.ir(IR_CONST, 1, 0, 0, one, 0)
        let ni : i64 = self.tmp()
        self.ir(IR_ADDW, iv, one, 0, ni, 64 + 256)
        self.ir(IR_MOV, ni, 0, 0, iv, 0)
        self.ir(IR_JMP, ltop, 0, 0, 0, 0)
        self.ir(IR_LABEL, lend, 0, 0, 0, 0)
        self.tbase ← saved_base

fn lower_fn(lw : &mut Lower, a : Ast, chk : Chk, f : i64) → IrFn:
    let d := a.fns[f × 1¤ptrdiff]
    while #lw.op > 0:
        _ ← lw.op.pop()
        _ ← lw.ia.pop()
        _ ← lw.ib.pop()
        _ ← lw.ic.pop()
        _ ← lw.idd.pop()
        _ ← lw.iww.pop()
    while #lw.extra > 0:
        _ ← lw.extra.pop()
    lw.nlabels ← 0
    lw.tbase ← chk.fslots[f × 1¤ptrdiff]
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← d.ret
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← d.name
    if d.pre_off ≠ ⁻1:
        let n : i64 = a.extra[d.pre_off × 1¤ptrdiff]
        let j : mut i64 = 0
        while j < n:
            lw.tnext ← lw.tbase
            let c : i64 = a.extra[(d.pre_off + 1 + j) × 1¤ptrdiff]
            let cv : i64 = lw.lower_expr(c)
            let lok : i64 = lw.label()
            lw.ir(IR_JNZ, cv, lok, 0, 0, 0)
            let m : i64 = lw.intern("precondition of '" ⧺ d.name ⧺ "' does not hold\n")
            lw.ir(IR_ABORT, m, 0, 0, 0, 0)
            lw.ir(IR_LABEL, lok, 0, 0, 0, 0)
            j ← j + 1
    if d.post_off ≠ ⁻1 and d.ret ≠ TY_UNIT:
        lw.post_label ← lw.label()
        // the checker gave the result's name the slot after the
        // parameters, so the value is put where the conditions read it
        lw.res_vreg ← a.extra[d.params_off × 1¤ptrdiff]
    lw.lower_block(d.body, true, d.ret)
    if d.ret = TY_UNIT:
        lw.ir(IR_RET, ⁻1, 0, 0, 0, 0)
    if lw.post_label ≠ ⁻1:
        lw.ir(IR_LABEL, lw.post_label, 0, 0, 0, 0)
        let n : i64 = a.extra[d.post_off × 1¤ptrdiff]
        let j : mut i64 = 0
        while j < n:
            lw.tnext ← lw.tbase
            let c : i64 = a.extra[(d.post_off + 2 + j × 2) × 1¤ptrdiff]
            let cv : i64 = lw.lower_expr(c)
            let lok : i64 = lw.label()
            lw.ir(IR_JNZ, cv, lok, 0, 0, 0)
            let m : i64 = lw.intern("postcondition of '" ⧺ d.name ⧺ "' does not hold\n")
            lw.ir(IR_ABORT, m, 0, 0, 0, 0)
            lw.ir(IR_LABEL, lok, 0, 0, 0, 0)
            j ← j + 1
        lw.ir(IR_RET, lw.res_vreg, 0, 0, 0, 0)
    let opc : mut i64[] = []
    let iac : mut i64[] = []
    let ibc : mut i64[] = []
    let icc : mut i64[] = []
    let idc : mut i64[] = []
    let iwc : mut i64[] = []
    let exc : mut i64[] = []
    foreach v := lw.op:
        opc.push(v)
    foreach v := lw.ia:
        iac.push(v)
    foreach v := lw.ib:
        ibc.push(v)
    foreach v := lw.ic:
        icc.push(v)
    foreach v := lw.idd:
        idc.push(v)
    foreach v := lw.iww:
        iwc.push(v)
    if #lw.extra > 0:
        foreach v := lw.extra:
            exc.push(v)
    assert(#opc = #iac and #opc = #ibc and #opc = #icc, "ir arrays in step")
    assert(#opc = #idc and #opc = #iwc, "ir arrays in step")
    assert(lw.tmax >= chk.fslots[f × 1¤ptrdiff], "the frame covers the locals")
    (IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc, extra: exc,
          nvregs: lw.tmax, nlabels: lw.nlabels})

// ===========================================================================
// Code generation: IR → x86-64 machine code
// ===========================================================================

let R_AX : i64 = 0
let R_CX : i64 = 1
let R_DX : i64 = 2
let R_SI : i64 = 6
let R_DI : i64 = 7
let R_R8 : i64 = 8
let R_R9 : i64 = 9
let R_R10 : i64 = 10
let R_R11 : i64 = 11

// runtime routine ids, call targets below the user functions
let RT_PRINTI : i64 = ⁻1
let RT_WRITE1 : i64 = ⁻2
let RT_ABORT : i64 = ⁻3
let RT_OV : i64 = ⁻4
let RT_SHIFT : i64 = ⁻5
let RT_BOUNDS : i64 = ⁻6
let RT_OOM : i64 = ⁻7
let RT_ALLOC : i64 = ⁻8
let RT_ARRNEW : i64 = ⁻9
let RT_ARRPUSH : i64 = ⁻10
let RT_CONCAT : i64 = ⁻11
let RT_STREQ : i64 = ⁻12
let RT_STRCHARS : i64 = ⁻13
let RT_PRINTSTR : i64 = ⁻14
let RT_PRINTU : i64 = ⁻15

struct Emit:
    code : u8[]
    cf_pos : i64[]       // rel32 fixups against functions/runtime
    cf_target : i64[]
    sf_pos : i64[]       // abs64 fixups against a string's bytes
    sf_str : i64[]
    sd_pos : i64[]       // abs64 fixups against a string's descriptor
    sd_str : i64[]
    df_pos : i64[]       // abs64 fixups against the data segment
    df_off : i64[]
    labels : i64[]
    lf_pos : i64[]
    lf_label : i64[]
    fn_off : i64[]
    rt_off : i64[]
    // which vreg's value rax is known to hold, ⁻1 for none: the
    // cheapest of register allocations, one register deep
    rax_slot : i64
    // jump tables: abs64 fixups, and the resolved code offsets the
    // tables hold, flattened with a start index per table
    jt_pos : i64[]
    jt_id : i64[]
    jt_count : i64
    jt_starts : i64[]
    jt_is_code : i64[]
    jt_entries : i64[]
    pj_id : i64[]
    pj_start : i64[]
    pj_len : i64[]
    pj_labels : i64[]

impl Emit:
    fn here(&self) → i64:
        @dropunit(#self.code)

    fn b1(&mut self, a : i64):
        self.code.push(@wrap(a) & 255)

    fn b2(&mut self, a : i64, b : i64):
        self.b1(a)
        self.b1(b)

    fn b3(&mut self, a : i64, b : i64, c : i64):
        self.b1(a)
        self.b1(b)
        self.b1(c)

    fn b4(&mut self, a : i64, b : i64, c : i64, d : i64):
        self.b1(a)
        self.b1(b)
        self.b1(c)
        self.b1(d)

    fn w32(&mut self, v : i64):
        self.b1(v)
        self.b1(v » 8)
        self.b1(v » 16)
        self.b1(v » 24)

    fn w64(&mut self, v : i64):
        self.w32(v)
        self.w32(v » 32)

    fn patch32(&mut self, pos : i64, v : i64):
        self.code[pos × 1¤byte] ← @wrap(v) & 255
        self.code[(pos + 1) × 1¤byte] ← @wrap(v » 8) & 255
        self.code[(pos + 2) × 1¤byte] ← @wrap(v » 16) & 255
        self.code[(pos + 3) × 1¤byte] ← @wrap(v » 24) & 255

    fn patch64(&mut self, pos : i64, v : i64):
        self.patch32(pos, v)
        self.patch32(pos + 4, v » 32)

    fn load(&mut self, reg : i64, slot : i64):
        if reg = 0:
            if self.rax_slot = slot:
                return
            self.rax_slot ← slot
        self.b1(72 + (4 if reg >= 8 else 0))
        self.b1(139)
        self.b1(133 + ((reg & 7) « 3))
        self.w32(@wrap(0 - 8 × (slot + 1)))

    fn store(&mut self, reg : i64, slot : i64):
        if reg = 0:
            self.rax_slot ← slot
        elif slot = self.rax_slot:
            // another register overwrites the slot rax mirrors
            self.rax_slot ← ⁻1
        self.b1(72 + (4 if reg >= 8 else 0))
        self.b1(137)
        self.b1(133 + ((reg & 7) « 3))
        self.w32(@wrap(0 - 8 × (slot + 1)))

    // anything that may change rax or be jumped to forgets the memo
    fn raxbar(&mut self):
        self.rax_slot ← ⁻1

    fn movimm(&mut self, reg : i64, v : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        self.w64(v)

    fn jlocal(&mut self, opcode2 : i64, l : i64):
        if opcode2 = ⁻1:
            self.b1(233)
        else:
            self.b2(15, opcode2)
        self.lf_pos.push(self.here())
        self.lf_label.push(l)
        self.w32(0)

    fn jglobal(&mut self, opcode : i64, opcode2 : i64, target : i64):
        if opcode2 = ⁻1 and opcode = 232:
            // a call clobbers rax
            self.raxbar()
        if opcode2 = ⁻1:
            self.b1(opcode)
        else:
            self.b2(15, opcode2)
        self.cf_pos.push(self.here())
        self.cf_target.push(target)
        self.w32(0)

    fn set_label(&mut self, l : i64):
        // a label is a join point; what rax held on one way in says
        // nothing about the others
        self.raxbar()
        self.labels[l × 1¤ptrdiff] ← self.here()

    fn resolve_locals(&mut self):
        if #self.lf_pos > 0:
            foreach i := 0…#self.lf_pos - 1:
                let pos : i64 = self.lf_pos[i]
                let target : i64 = self.labels[self.lf_label[i] × 1¤ptrdiff]
                // an unset label once escaped this path as begin_fn(1)
                // against a routine that used two
                assert(target ≠ ⁻1, "every jumped-to label was placed")
                self.patch32(pos, target - (pos + 4))
        while #self.lf_pos > 0:
            _ ← self.lf_pos.pop()
            _ ← self.lf_label.pop()

    fn begin_fn(&mut self, nlabels : i64):
        self.raxbar()
        while #self.labels > 0:
            _ ← self.labels.pop()
        let i : mut i64 = 0
        while i < nlabels:
            self.labels.push(⁻1)
            i ← i + 1

    fn sref(&mut self, reg : i64, stridx : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        self.sf_pos.push(self.here())
        self.sf_str.push(stridx)
        self.w64(0)

    fn sdref(&mut self, reg : i64, stridx : i64):
        if reg = 0:
            self.rax_slot ← ⁻1
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        self.sd_pos.push(self.here())
        self.sd_str.push(stridx)
        self.w64(0)

    fn jtref(&mut self, reg : i64, id : i64):
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        self.jt_pos.push(self.here())
        self.jt_id.push(id)
        self.w64(0)

    fn resolve_jtabs(&mut self):
        if #self.pj_id > 0:
            foreach i := 0…#self.pj_id - 1:
                self.jt_starts.push(@dropunit(#self.jt_entries))
                let n0 : i64 = self.pj_len[i]
                let st : i64 = self.pj_start[i]
                if n0 < 0:
                    // a value table: the entries are the data itself
                    let n : i64 = @wrap(0 - n0)
                    self.jt_is_code.push(0)
                    let j : mut i64 = 0
                    while j < n:
                        self.jt_entries.push(self.pj_labels[(st + j) × 1¤ptrdiff])
                        j ← j + 1
                    continue
                self.jt_is_code.push(1)
                let n : i64 = n0
                let j : mut i64 = 0
                while j < n:
                    let off2 : i64 = self.labels[self.pj_labels[(st + j) × 1¤ptrdiff] × 1¤ptrdiff]
                    assert(off2 ≠ ⁻1, "every table target was placed")
                    self.jt_entries.push(off2)
                    j ← j + 1
        while #self.pj_id > 0:
            _ ← self.pj_id.pop()
            _ ← self.pj_start.pop()
            _ ← self.pj_len.pop()
        while #self.pj_labels > 0:
            _ ← self.pj_labels.pop()

    fn dref(&mut self, reg : i64, off : i64):
        self.b1(72 + (1 if reg >= 8 else 0))
        self.b1(184 + (reg & 7))
        self.df_pos.push(self.here())
        self.df_off.push(off)
        self.w64(0)

    // narrow the canonical 64-bit value in rax back into its width
    fn canon(&mut self, w : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if bits = 64:
            return
        if sgn = 0:
            if bits = 32:
                self.b2(137, 192)            // mov eax, eax
            elif bits = 16:
                self.b4(72, 15, 183, 192)    // movzx rax, ax
            else:
                self.b4(72, 15, 182, 192)    // movzx rax, al
        else:
            if bits = 32:
                self.b3(72, 99, 192)         // movsxd rax, eax
            elif bits = 16:
                self.b4(72, 15, 191, 192)    // movsx rax, ax
            else:
                self.b4(72, 15, 190, 192)    // movsx rax, al

    // the checked-arithmetic backstop: overflow leaves for the abort,
    // a branch never taken by a correct program
    fn range_check(&mut self, w : i64):
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if bits = 64:
            return
        if sgn = 0:
            self.movimm(R_R11, (1 « bits) - 1)
            self.b3(76, 57, 216)             // cmp rax, r11
            self.jglobal(0, 135, RT_OV)      // ja
        else:
            self.movimm(R_R10, @wrap(0 - (1 « (bits - 1))))
            self.b3(72, 137, 194)            // mov rdx, rax
            self.b3(76, 41, 210)             // sub rdx, r10
            self.movimm(R_R11, (1 « bits) - 1)
            self.b3(76, 57, 218)             // cmp rdx, r11
            self.jglobal(0, 135, RT_OV)      // ja

@pre(j >= 0 and j <= 5)
fn arg_reg(j : i64) → i64:
    if j = 0: return R_DI
    if j = 1: return R_SI
    if j = 2: return R_DX
    if j = 3: return R_CX
    if j = 4: return R_R8
    R_R9

@post(r: r >= 0)
fn str_len(s : str) → i64:
    @dropunit(#s)

// the setcc condition for a comparison at a signedness
@pre(sgn = 0 or sgn = 1)
@post(r: r >= 146 and r <= 159)
fn cc_of(o : i64, sgn : i64) → i64:
    if o = IR_CEQ: return 148
    if o = IR_CNE: return 149
    if sgn = 1:
        if o = IR_CLT: return 156
        if o = IR_CLE: return 158
        if o = IR_CGT: return 159
        return 157
    if o = IR_CLT: return 146
    if o = IR_CLE: return 150
    if o = IR_CGT: return 151
    147

fn emit_fn(em : &mut Emit, ir : IrFn, np : i64, strs : str[]):
    assert(ir.nvregs >= np, "the frame covers the spilled arguments")
    em.begin_fn(ir.nlabels)
    em.b1(85)                       // push rbp
    em.b3(72, 137, 229)             // mov rbp, rsp
    em.b3(72, 129, 236)             // sub rsp, imm32
    em.w32(8 × ir.nvregs + 8)
    let j : mut i64 = 0
    while j < np:
        em.store(arg_reg(j), j)
        j ← j + 1
    let n : i64 = @dropunit(#ir.op)
    let i : mut i64 = 0
    while i < n:
        let o : i64 = ir.op[i × 1¤ptrdiff]
        let a : i64 = ir.ia[i × 1¤ptrdiff]
        let b : i64 = ir.ib[i × 1¤ptrdiff]
        let c : i64 = ir.ic[i × 1¤ptrdiff]
        let d : i64 = ir.id[i × 1¤ptrdiff]
        let w : i64 = ir.iw[i × 1¤ptrdiff]
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if o = IR_CONST:
            em.movimm(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_MOV:
            em.load(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_ADD or o = IR_ADDW or o = IR_SUB or o = IR_SUBW:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if o = IR_ADD or o = IR_ADDW:
                em.b3(72, 1, 200)   // add rax, rcx
            else:
                em.b3(72, 41, 200)  // sub rax, rcx
            if o = IR_ADD or o = IR_SUB:
                if bits = 64:
                    em.jglobal(0, 128 if sgn = 1 else 130, RT_OV)  // jo / jc
                else:
                    em.range_check(w)
            else:
                em.canon(w)
            em.store(R_AX, d)
        elif o = IR_MUL or o = IR_MULW:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if sgn = 1 or o = IR_MULW:
                em.b4(72, 15, 175, 193)      // imul rax, rcx
                if o = IR_MUL:
                    if bits = 64:
                        em.jglobal(0, 128, RT_OV)
                    else:
                        em.range_check(w)
                else:
                    em.canon(w)
            else:
                em.b3(72, 247, 225)          // mul rcx
                em.jglobal(0, 130, RT_OV)    // jc: past 64 bits
                if bits ≠ 64:
                    em.range_check(w)
            em.store(R_AX, d)
        elif o = IR_NEG or o = IR_NEGW:
            em.load(R_AX, a)
            em.b3(72, 247, 216)              // neg rax
            if o = IR_NEG:
                if sgn = 1:
                    if bits = 64:
                        em.jglobal(0, 128, RT_OV)
                    else:
                        em.range_check(w)
                else:
                    // a negated unsigned is only 0; nonzero sets carry
                    if bits = 64:
                        em.jglobal(0, 130, RT_OV)
                    else:
                        em.range_check(w)
            else:
                em.canon(w)
            em.store(R_AX, d)
        elif o = IR_BAND or o = IR_BORR or o = IR_BXORR:
            em.load(R_AX, a)
            em.load(R_CX, b)
            if o = IR_BAND:
                em.b3(72, 33, 200)
            elif o = IR_BORR:
                em.b3(72, 9, 200)
            else:
                em.b3(72, 49, 200)
            em.store(R_AX, d)
        elif o = IR_BNOTT:
            em.load(R_AX, a)
            em.b3(72, 247, 208)              // not rax
            em.canon(w)
            em.store(R_AX, d)
        elif o = IR_SHLL or o = IR_SHRR:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 131, 249)              // cmp rcx, value-bits
            em.b1(bits - sgn)
            em.jglobal(0, 131, RT_SHIFT)     // jae
            if o = IR_SHLL:
                em.b3(72, 211, 224)          // shl rax, cl
                em.canon(w)
            else:
                if sgn = 1:
                    em.b3(72, 211, 248)      // sar rax, cl
                else:
                    em.b3(72, 211, 232)      // shr rax, cl
            em.store(R_AX, d)
        elif o >= IR_CEQ and o <= IR_CGE:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 57, 200)               // cmp rax, rcx
            em.b3(15, cc_of(o, sgn), 192)    // setcc al
            em.b4(72, 15, 182, 192)          // movzx rax, al
            em.store(R_AX, d)
        elif o = IR_MAXX or o = IR_MINN:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 57, 200)               // cmp rax, rcx
            let cmov : mut i64 = 0
            if o = IR_MAXX:
                cmov ← 76 if sgn = 1 else 66     // cmovl / cmovb
            else:
                cmov ← 79 if sgn = 1 else 71     // cmovg / cmova
            em.b4(72, 15, cmov, 193)             // cmovcc rax, rcx
            em.store(R_AX, d)
        elif o = IR_SEL:
            em.load(R_R10, a)
            em.load(R_AX, b)
            em.load(R_CX, c)
            em.b3(77, 133, 210)              // test r10, r10
            em.b4(72, 15, 68, 193)           // cmovz rax, rcx
            em.store(R_AX, d)
        elif o = IR_DIVV or o = IR_MODD:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b3(72, 133, 201)              // test rcx, rcx
            em.b2(15, 133)                   // jnz over the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.load(R_AX, c)
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            if sgn = 1:
                if bits = 64:
                    em.movimm(R_R10, ⁻9223372036854775807 - 1)
                    em.b3(76, 57, 208)       // cmp rax, r10
                    em.b2(15, 133)           // jne
                    let p3 : i64 = em.here()
                    em.w32(0)
                    em.b3(72, 131, 249)      // cmp rcx, ⁻1
                    em.b1(255)
                    em.jglobal(0, 132, RT_OV)    // je
                    em.patch32(p3, em.here() - (p3 + 4))
                em.b2(72, 153)               // cqo
                em.b3(72, 247, 249)          // idiv rcx
            else:
                em.b2(49, 210)               // xor edx, edx
                em.b3(72, 247, 241)          // div rcx
            if o = IR_MODD:
                em.b3(72, 137, 208)          // mov rax, rdx
            if sgn = 1 and bits ≠ 64:
                em.range_check(w)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_JMP:
            em.jlocal(⁻1, a)
        elif o = IR_JZ or o = IR_JNZ:
            em.load(R_AX, a)
            em.b3(72, 133, 192)
            em.jlocal(132 if o = IR_JZ else 133, b)
        elif o = IR_LABEL:
            em.set_label(a)
        elif o = IR_CALL:
            let argc : i64 = ir.extra[b × 1¤ptrdiff]
            let k : mut i64 = 0
            while k < argc:
                em.load(arg_reg(k), ir.extra[(b + 1 + k) × 1¤ptrdiff])
                k ← k + 1
            em.jglobal(232, ⁻1, a)
            em.store(R_AX, d)
        elif o = IR_RET:
            if a ≠ ⁻1:
                em.load(R_AX, a)
            em.b1(201)
            em.b1(195)
        elif o = IR_PRINTS:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_WRITE1)
        elif o = IR_PRINTI:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTI)
        elif o = IR_PRINTU:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTU)
        elif o = IR_EXIT:
            em.load(R_DI, a)
            em.movimm(R_AX, 60)
            em.b2(15, 5)
        elif o = IR_ABORT:
            em.sref(R_SI, a)
            em.movimm(R_DX, str_len(strs[a × 1¤ptrdiff]))
            em.jglobal(232, ⁻1, RT_ABORT)
        elif o = IR_GLOAD:
            em.dref(R_R11, 8 × a)
            em.b3(73, 139, 3)                // mov rax, [r11]
            em.store(R_AX, d)
        elif o = IR_GSTORE:
            em.load(R_AX, b)
            em.dref(R_R11, 8 × a)
            em.b3(73, 137, 3)                // mov [r11], rax
        elif o = IR_ANEW:
            em.movimm(R_DI, a)
            em.jglobal(232, ⁻1, RT_ARRNEW)
            em.store(R_AX, d)
        elif o = IR_APUSH:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_ARRPUSH)
        elif o = IR_AIDX:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.jglobal(0, 131, RT_BOUNDS)    // jae
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.store(R_AX, d)
        elif o = IR_ASTO:
            em.load(R_R10, a)
            em.load(R_CX, b)
            em.b4(73, 59, 74, 8)             // cmp rcx, [r10+8]
            em.jglobal(0, 131, RT_BOUNDS)
            em.b3(73, 139, 18)               // mov rdx, [r10]
            em.load(R_AX, c)
            em.b4(72, 137, 4, 202)           // mov [rdx+rcx*8], rax
        elif o = IR_APOP:
            em.load(R_AX, a)
            em.b4(72, 139, 72, 8)            // mov rcx, [rax+8]
            em.b3(72, 133, 201)              // test rcx, rcx
            em.b2(15, 132)                   // jz to the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.b3(72, 255, 201)              // dec rcx
            em.b4(72, 137, 72, 8)            // mov [rax+8], rcx
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            em.load(R_AX, b)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_AGET:
            em.load(R_AX, a)
            em.load(R_CX, b)
            em.b4(72, 59, 72, 8)             // cmp rcx, [rax+8]
            em.b2(15, 131)                   // jae to the default
            let p1 : i64 = em.here()
            em.w32(0)
            em.b3(72, 139, 16)               // mov rdx, [rax]
            em.b4(72, 139, 4, 202)           // mov rax, [rdx+rcx*8]
            em.b1(233)
            let p2 : i64 = em.here()
            em.w32(0)
            em.patch32(p1, em.here() - (p1 + 4))
            em.load(R_AX, c)
            em.patch32(p2, em.here() - (p2 + 4))
            em.raxbar()
            em.store(R_AX, d)
        elif o = IR_ALEN:
            em.load(R_AX, a)
            em.b4(72, 139, 64, 8)            // mov rax, [rax+8]
            em.store(R_AX, d)
        elif o = IR_SC:
            em.sdref(R_AX, a)
            em.store(R_AX, d)
        elif o = IR_SCCAT:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_CONCAT)
            em.store(R_AX, d)
        elif o = IR_SEQV:
            em.load(R_DI, a)
            em.load(R_SI, b)
            em.jglobal(232, ⁻1, RT_STREQ)
            em.store(R_AX, d)
        elif o = IR_SLENV:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_STRCHARS)
            em.store(R_AX, d)
        elif o = IR_PRINTSV:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_PRINTSTR)
        elif o = IR_VTAB:
            let vmin : i64 = ir.extra[b × 1¤ptrdiff]
            let span : i64 = ir.extra[(b + 1) × 1¤ptrdiff]
            let defv : i64 = ir.extra[(b + 2) × 1¤ptrdiff]
            em.load(R_AX, a)
            em.movimm(R_R10, vmin)
            em.b3(76, 41, 208)               // sub rax, r10
            em.b3(72, 49, 201)               // xor rcx, rcx, before the flags matter
            em.movimm(R_R11, span)
            em.b3(76, 57, 216)               // cmp rax, r11
            em.b4(65, 15, 146, 194)          // setb r10b: inside the table
            em.b4(77, 15, 182, 210)          // movzx r10, r10b
            em.b4(72, 15, 67, 193)           // cmovae rax, rcx: clamp the load
            let id2 : i64 = em.jt_count
            em.jt_count ← em.jt_count + 1
            em.jtref(R_DX, id2)
            em.b4(72, 139, 4, 194)           // mov rax, [rdx+rax*8]
            em.movimm(R_CX, defv)
            em.b3(77, 133, 210)              // test r10, r10
            em.b4(72, 15, 68, 193)           // cmovz rax, rcx: outside answers the default
            em.store(R_AX, d)
            em.pj_id.push(id2)
            em.pj_start.push(@dropunit(#em.pj_labels))
            em.pj_len.push(@wrap(0 - span))  // negative: raw values, not labels
            let e2 : mut i64 = 0
            while e2 < span:
                em.pj_labels.push(ir.extra[(b + 3 + e2) × 1¤ptrdiff])
                e2 ← e2 + 1
        elif o = IR_SNEW:
            em.movimm(R_DI, 8 × a)
            em.jglobal(232, ⁻1, RT_ALLOC)
            em.store(R_AX, d)
        elif o = IR_FLD:
            em.load(R_AX, a)
            em.b3(72, 139, 128)              // mov rax, [rax+disp32]
            em.w32(8 × b)
            em.store(R_AX, d)
        elif o = IR_FSTO:
            em.load(R_R10, a)
            em.load(R_AX, c)
            em.b3(73, 137, 130)              // mov [r10+disp32], rax
            em.w32(8 × b)
        elif o = IR_JTAB:
            let jmin : i64 = ir.extra[b × 1¤ptrdiff]
            let span : i64 = ir.extra[(b + 1) × 1¤ptrdiff]
            let ldef : i64 = ir.extra[(b + 2) × 1¤ptrdiff]
            em.load(R_AX, a)
            em.movimm(R_R10, jmin)
            em.b3(76, 41, 208)               // sub rax, r10
            em.movimm(R_R11, span)
            em.b3(76, 57, 216)               // cmp rax, r11
            em.jlocal(131, ldef)             // jae: outside the table
            let id : i64 = em.jt_count
            em.jt_count ← em.jt_count + 1
            em.jtref(R_R10, id)
            em.b4(65, 255, 36, 194)          // jmp [r10 + rax*8]
            em.pj_id.push(id)
            em.pj_start.push(@dropunit(#em.pj_labels))
            em.pj_len.push(span)
            let e : mut i64 = 0
            while e < span:
                em.pj_labels.push(ir.extra[(b + 3 + e) × 1¤ptrdiff])
                e ← e + 1
        i ← i + 1
    em.resolve_locals()
    em.resolve_jtabs()

// ---------------------------------------------------------------------------
// The runtime: routines over raw syscalls, no libc
// ---------------------------------------------------------------------------

fn emit_runtime(em : &mut Emit, lw : &mut Lower, alloc_off : i64):
    // RT_PRINTI: rdi = signed value → decimal on fd 1
    em.rt_off.push(em.here())
    em.begin_fn(3)
    em.b4(72, 131, 236, 40)         // sub rsp, 40
    em.b3(76, 141, 76)
    em.b2(36, 39)                   // lea r9, [rsp+39]
    em.b3(77, 49, 210)              // xor r10, r10
    em.b3(72, 137, 248)             // mov rax, rdi
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(137, 0)               // jns L0
    em.b3(73, 199, 194)
    em.w32(1)                       // mov r10, 1
    em.b3(72, 247, 216)             // neg rax
    em.set_label(0)
    em.b3(72, 199, 193)
    em.w32(10)                      // mov rcx, 10
    em.set_label(1)
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.b3(72, 247, 241)             // div rcx
    em.b3(128, 194, 48)             // add dl, '0'
    em.b3(73, 255, 201)             // dec r9
    em.b3(65, 136, 17)              // mov [r9], dl
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(133, 1)               // jnz L1
    em.b3(77, 133, 210)             // test r10, r10
    em.jlocal(132, 2)               // jz L2
    em.b3(73, 255, 201)             // dec r9
    em.b4(65, 198, 1, 45)           // mov byte [r9], '-'
    em.set_label(2)
    em.b3(72, 141, 84)
    em.b2(36, 39)                   // lea rdx, [rsp+39]
    em.b3(76, 41, 202)              // sub rdx, r9
    em.b3(76, 137, 206)             // mov rsi, r9
    em.movimm(R_DI, 1)
    em.movimm(R_AX, 1)
    em.b2(15, 5)
    em.b4(72, 131, 196, 40)         // add rsp, 40
    em.b1(195)
    em.resolve_locals()

    // RT_WRITE1: rsi = buf, rdx = len
    em.rt_off.push(em.here())
    em.movimm(R_AX, 1)
    em.movimm(R_DI, 1)
    em.b2(15, 5)
    em.b1(195)

    // RT_ABORT: rsi = message, rdx = its length
    em.rt_off.push(em.here())
    em.movimm(R_AX, 1)
    em.movimm(R_DI, 2)
    em.b2(15, 5)
    em.movimm(R_AX, 39)
    em.b2(15, 5)
    em.b3(72, 137, 199)             // mov rdi, rax
    em.movimm(R_SI, 6)
    em.movimm(R_AX, 62)
    em.b2(15, 5)
    em.b2(15, 11)                   // ud2

    // RT_OV
    em.rt_off.push(em.here())
    let ovm : i64 = lw.intern("integer overflow\n")
    em.sref(R_SI, ovm)
    em.movimm(R_DX, str_len(lw.strs[ovm × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, RT_ABORT)

    // RT_SHIFT
    em.rt_off.push(em.here())
    let shm : i64 = lw.intern("shift count is past the type\n")
    em.sref(R_SI, shm)
    em.movimm(R_DX, str_len(lw.strs[shm × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, RT_ABORT)

    // RT_BOUNDS
    em.rt_off.push(em.here())
    let bdm : i64 = lw.intern("index out of range\n")
    em.sref(R_SI, bdm)
    em.movimm(R_DX, str_len(lw.strs[bdm × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, RT_ABORT)

    // RT_OOM
    em.rt_off.push(em.here())
    let oom : i64 = lw.intern("out of memory\n")
    em.sref(R_SI, oom)
    em.movimm(R_DX, str_len(lw.strs[oom × 1¤ptrdiff]))
    em.jglobal(233, ⁻1, RT_ABORT)

    // RT_ALLOC: rdi = size → rax; a bump pointer over mmap regions
    em.rt_off.push(em.here())
    em.begin_fn(1)
    em.b4(76, 141, 87, 15)          // lea r10, [rdi+15]
    em.b4(73, 131, 226, 240)        // and r10, -16
    em.dref(R_R11, alloc_off)
    em.b3(73, 139, 3)               // mov rax, [r11]
    em.b4(74, 141, 20, 16)          // lea rdx, [rax+r10]
    em.b4(73, 59, 83, 8)            // cmp rdx, [r11+8]
    em.jlocal(134, 0)               // jbe L0: it fits
    em.b2(65, 82)                   // push r10
    em.b3(73, 141, 178)
    em.w32(4095)                    // lea rsi, [r10+4095]
    em.b3(72, 129, 230)
    em.w32(@wrap(0 - 4096))         // and rsi, -4096
    em.movimm(R_CX, 1048576)
    em.b3(72, 57, 206)              // cmp rsi, rcx
    em.b4(72, 15, 66, 241)          // cmovb rsi, rcx
    em.b2(49, 255)                  // xor edi, edi
    em.movimm(R_DX, 3)
    em.movimm(R_R10, 34)
    em.movimm(R_R8, @wrap(0 - 1))
    em.b3(69, 49, 201)              // xor r9d, r9d
    em.movimm(R_AX, 9)
    em.b2(15, 5)                    // mmap
    em.b3(72, 133, 192)             // test rax, rax
    em.jglobal(0, 136, RT_OOM)      // js: the kernel said no
    em.b2(65, 90)                   // pop r10
    em.dref(R_R11, alloc_off)
    em.b3(73, 137, 3)               // mov [r11], rax
    em.b4(72, 141, 20, 48)          // lea rdx, [rax+rsi]
    em.b4(73, 137, 83, 8)           // mov [r11+8], rdx
    em.set_label(0)
    em.b3(73, 139, 3)               // mov rax, [r11]
    em.b4(74, 141, 20, 16)          // lea rdx, [rax+r10]
    em.b3(73, 137, 19)              // mov [r11], rdx
    em.b1(195)
    em.resolve_locals()

    // RT_ARRNEW: rdi = capacity in elements → rax = descriptor
    em.rt_off.push(em.here())
    em.b1(87)                       // push rdi
    em.b3(72, 141, 60)
    em.b4(253, 24, 0, 0)
    em.b1(0)                        // lea rdi, [rdi*8+24]
    em.jglobal(232, ⁻1, RT_ALLOC)
    em.b1(89)                       // pop rcx
    em.b2(49, 210)                  // xor edx, edx
    em.b4(72, 137, 80, 8)           // mov [rax+8], rdx
    em.b4(72, 137, 72, 16)          // mov [rax+16], rcx
    em.b4(72, 141, 80, 24)          // lea rdx, [rax+24]
    em.b3(72, 137, 16)              // mov [rax], rdx
    em.b1(195)

    // RT_ARRPUSH: rdi = descriptor, rsi = value
    em.rt_off.push(em.here())
    em.begin_fn(3)
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b4(72, 59, 79, 16)           // cmp rcx, [rdi+16]
    em.jlocal(130, 0)               // jb L0: room enough
    em.b1(87)                       // push rdi
    em.b1(86)                       // push rsi
    em.b4(72, 139, 119, 16)         // mov rsi, [rdi+16]
    em.b3(72, 1, 246)               // add rsi, rsi
    em.movimm(R_CX, 8)
    em.b3(72, 57, 206)              // cmp rsi, rcx
    em.b4(72, 15, 66, 241)          // cmovb rsi, rcx
    em.b1(86)                       // push rsi (the new capacity)
    em.b3(72, 141, 60)
    em.b4(245, 0, 0, 0)
    em.b1(0)                        // lea rdi, [rsi*8]
    em.jglobal(232, ⁻1, RT_ALLOC)
    em.b2(65, 89)                   // pop r9 (new capacity)
    em.b1(94)                       // pop rsi (value)
    em.b1(95)                       // pop rdi (descriptor)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(1)
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 2)               // jbe L2: copied
    em.b4(78, 139, 28, 210)         // mov r11, [rdx+r10*8]
    em.b4(78, 137, 28, 208)         // mov [rax+r10*8], r11
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 1)
    em.set_label(2)
    em.b3(72, 137, 7)               // mov [rdi], rax
    em.b4(76, 137, 79, 16)          // mov [rdi+16], r9
    em.set_label(0)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b4(72, 137, 52, 202)         // mov [rdx+rcx*8], rsi
    em.b3(72, 255, 193)             // inc rcx
    em.b4(72, 137, 79, 8)           // mov [rdi+8], rcx
    em.b1(195)
    em.resolve_locals()

    // RT_CONCAT: rdi, rsi = descriptors → rax = the joined string
    em.rt_off.push(em.here())
    em.begin_fn(4)
    em.b1(87)                       // push rdi
    em.b1(86)                       // push rsi
    em.b4(72, 139, 87, 8)           // mov rdx, [rdi+8]
    em.b4(72, 3, 86, 8)             // add rdx, [rsi+8]
    em.b1(82)                       // push rdx
    em.b4(72, 141, 122, 16)         // lea rdi, [rdx+16]
    em.jglobal(232, ⁻1, RT_ALLOC)
    em.b1(90)                       // pop rdx
    em.b4(72, 141, 72, 16)          // lea rcx, [rax+16]
    em.b3(72, 137, 8)               // mov [rax], rcx
    em.b4(72, 137, 80, 8)           // mov [rax+8], rdx
    em.b1(94)                       // pop rsi (b)
    em.b1(95)                       // pop rdi (a)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(76, 139, 71, 8)           // mov r8, [rdi+8]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(0)
    em.b3(77, 57, 208)              // cmp r8, r10
    em.jlocal(134, 1)               // jbe L1
    em.b4(70, 138, 28, 18)          // mov r11b, [rdx+r10]
    em.b4(70, 136, 28, 17)          // mov [rcx+r10], r11b
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 0)
    em.set_label(1)
    em.b3(76, 1, 193)               // add rcx, r8
    em.b3(72, 139, 22)              // mov rdx, [rsi]
    em.b4(76, 139, 70, 8)           // mov r8, [rsi+8]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(2)
    em.b3(77, 57, 208)              // cmp r8, r10
    em.jlocal(134, 3)               // jbe L3
    em.b4(70, 138, 28, 18)          // mov r11b, [rdx+r10]
    em.b4(70, 136, 28, 17)          // mov [rcx+r10], r11b
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 2)
    em.set_label(3)
    em.b1(195)
    em.resolve_locals()

    // RT_STREQ: rdi, rsi = descriptors → rax = 0 or 1
    em.rt_off.push(em.here())
    em.begin_fn(3)
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b4(72, 59, 78, 8)            // cmp rcx, [rsi+8]
    em.jlocal(133, 0)               // jne Lfalse
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b3(76, 139, 6)               // mov r8, [rsi]
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(1)
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 2)               // jbe Ltrue
    em.b4(70, 138, 12, 18)          // mov r9b, [rdx+r10]
    em.b4(71, 58, 12, 16)           // cmp r9b, [r8+r10]
    em.jlocal(133, 0)               // jne Lfalse
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 1)
    em.set_label(2)
    em.movimm(R_AX, 1)
    em.b1(195)
    em.set_label(0)
    em.b2(49, 192)                  // xor eax, eax
    em.b1(195)
    em.resolve_locals()

    // RT_STRCHARS: rdi = descriptor → rax = characters, counted by
    // lead bytes with a materialized test -- no branch in the body
    em.rt_off.push(em.here())
    em.begin_fn(2)
    em.b3(72, 139, 23)              // mov rdx, [rdi]
    em.b4(72, 139, 79, 8)           // mov rcx, [rdi+8]
    em.b2(49, 192)                  // xor eax, eax
    em.b3(77, 49, 210)              // xor r10, r10
    em.set_label(0)
    em.b3(76, 57, 209)              // cmp rcx, r10
    em.jlocal(134, 1)               // jbe done
    em.b4(70, 138, 12, 18)          // mov r9b, [rdx+r10]
    em.b4(65, 128, 225, 192)        // and r9b, 0xC0
    em.b4(65, 128, 249, 128)        // cmp r9b, 0x80
    em.b3(65, 15, 149)
    em.b1(193)                      // setne r9b
    em.b4(77, 15, 182, 201)         // movzx r9, r9b
    em.b3(76, 1, 200)               // add rax, r9
    em.b3(73, 255, 194)             // inc r10
    em.jlocal(⁻1, 0)
    em.set_label(1)
    em.b1(195)
    em.resolve_locals()

    // RT_PRINTSTR: rdi = descriptor
    em.rt_off.push(em.here())
    em.b3(72, 139, 119)
    em.b1(0)                        // mov rsi, [rdi]  (disp8 0)
    em.b4(72, 139, 87, 8)           // mov rdx, [rdi+8]
    em.movimm(R_DI, 1)
    em.movimm(R_AX, 1)
    em.b2(15, 5)
    em.b1(195)

    // RT_PRINTU: rdi = unsigned value → decimal on fd 1
    em.rt_off.push(em.here())
    em.begin_fn(1)
    em.b4(72, 131, 236, 40)         // sub rsp, 40
    em.b3(76, 141, 76)
    em.b2(36, 39)                   // lea r9, [rsp+39]
    em.b3(72, 137, 248)             // mov rax, rdi
    em.b3(72, 199, 193)
    em.w32(10)                      // mov rcx, 10
    em.set_label(0)
    em.b3(72, 49, 210)              // xor rdx, rdx
    em.b3(72, 247, 241)             // div rcx
    em.b3(128, 194, 48)             // add dl, '0'
    em.b3(73, 255, 201)             // dec r9
    em.b3(65, 136, 17)              // mov [r9], dl
    em.b3(72, 133, 192)             // test rax, rax
    em.jlocal(133, 0)               // jnz
    em.b3(72, 141, 84)
    em.b2(36, 39)                   // lea rdx, [rsp+39]
    em.b3(76, 41, 202)              // sub rdx, r9
    em.b3(76, 137, 206)             // mov rsi, r9
    em.movimm(R_DI, 1)
    em.movimm(R_AX, 1)
    em.b2(15, 5)
    em.b4(72, 131, 196, 40)         // add rsp, 40
    em.b1(195)
    em.resolve_locals()

// ---------------------------------------------------------------------------
// The ELF executable: text R+X, rodata R, data R+W
// ---------------------------------------------------------------------------

let IMAGE_BASE : i64 = 4194304
let PAGE : i64 = 4096

@pre(a > 0 and v >= 0)
@post(r: r >= v and (r % a ?? 1) = 0)
fn align_up(v : i64, a : i64) → i64:
    ((v + a - 1) ÷ a ?? 0) × a

fn push32(out : &mut u8[], v : i64):
    out.push(@wrap(v) & 255)
    out.push(@wrap(v » 8) & 255)
    out.push(@wrap(v » 16) & 255)
    out.push(@wrap(v » 24) & 255)

fn push64(out : &mut u8[], v : i64):
    push32(&out, v)
    push32(&out, v » 32)

@pre(#code > 0)
@post(r: #r > 4096)
fn build_elf(code : u8[], rodata : u8[], data : u8[]) → u8[]:
    let text_off : i64 = PAGE
    let text_vaddr : i64 = IMAGE_BASE + text_off
    let text_size : i64 = @dropunit(#code)
    let ro_off : i64 = align_up(text_off + text_size, PAGE)
    let ro_vaddr : i64 = IMAGE_BASE + ro_off
    let ro_size : i64 = @dropunit(#rodata)
    let d_off : i64 = align_up(ro_off + ro_size, PAGE)
    let d_vaddr : i64 = IMAGE_BASE + d_off
    let d_size : i64 = @dropunit(#data)
    let out : mut u8[] = []
    out.push(127)
    out.push(69)
    out.push(76)
    out.push(70)
    out.push(2)
    out.push(1)
    out.push(1)
    foreach _ := 1…9:
        out.push(0)
    push32(&out, 2 + (62 « 16))
    push32(&out, 1)
    push64(&out, text_vaddr)
    push64(&out, 64)
    push64(&out, 0)
    push32(&out, 0)
    push32(&out, 64 + (56 « 16))
    push32(&out, 3)
    push32(&out, 0)
    // text
    push32(&out, 1)
    push32(&out, 5)
    push64(&out, text_off)
    push64(&out, text_vaddr)
    push64(&out, text_vaddr)
    push64(&out, text_size)
    push64(&out, text_size)
    push64(&out, PAGE)
    // rodata
    push32(&out, 1)
    push32(&out, 4)
    push64(&out, ro_off)
    push64(&out, ro_vaddr)
    push64(&out, ro_vaddr)
    push64(&out, ro_size)
    push64(&out, ro_size)
    push64(&out, PAGE)
    // data
    push32(&out, 1)
    push32(&out, 6)
    push64(&out, d_off)
    push64(&out, d_vaddr)
    push64(&out, d_vaddr)
    push64(&out, d_size)
    push64(&out, d_size)
    push64(&out, PAGE)
    while @dropunit(#out) < text_off:
        out.push(0)
    foreach b := code:
        out.push(b)
    while @dropunit(#out) < ro_off:
        out.push(0)
    foreach b := rodata:
        out.push(b)
    while @dropunit(#out) < d_off:
        out.push(0)
    foreach b := data:
        out.push(b)
    out

// ---------------------------------------------------------------------------
// Putting the pieces together
// ---------------------------------------------------------------------------

struct Compiled:
    elf : u8[]
    log : str[]

fn codegen(a : Ast, toks : Toks, src : byte[], chk : Chk) → Compiled:
    let strs0 : mut str[] = []
    foreach s := a.strs:
        strs0.push(s)
    let lw : mut Lower = (Lower{a: a, toks: toks, src: src, ntype: chk.ntype,
                                nslot: chk.nslot, strs: strs0,
                                op: [], ia: [], ib: [], ic: [], idd: [],
                                iww: [], extra: [], tbase: 0, tnext: 0,
                                tmax: 0, nlabels: 0, breaks: [], conts: [],
                                in_wrap: 0, cur_ret: 0, post_label: ⁻1,
                                res_vreg: ⁻1, cur_fname: "", dlog: []})
    let em : mut Emit = (Emit{code: [], cf_pos: [], cf_target: [],
                              sf_pos: [], sf_str: [], sd_pos: [], sd_str: [],
                              df_pos: [], df_off: [], labels: [],
                              lf_pos: [], lf_label: [], fn_off: [],
                              rt_off: [], rax_slot: ⁻1,
                              jt_pos: [], jt_id: [], jt_count: 0,
                              jt_starts: [], jt_is_code: [], jt_entries: [],
                              pj_id: [],
                              pj_start: [], pj_len: [], pj_labels: []})
    let nglobals : i64 = @dropunit(#a.globals)
    let alloc_off : i64 = 8 × nglobals
    // _start: call the @start function, then exit 0
    let start_fn : mut i64 = 0
    foreach i := 0…#a.fns - 1:
        if a.fns[i].is_start:
            start_fn ← @dropunit(i)
    em.jglobal(232, ⁻1, start_fn)
    em.movimm(R_AX, 60)
    em.b3(72, 49, 255)
    em.b2(15, 5)
    emit_runtime(&em, &lw, alloc_off)
    foreach i := 0…#a.fns - 1:
        let f : i64 = @dropunit(i)
        let ir := lower_fn(&lw, a, chk, f)
        em.fn_off.push(em.here())
        let np : i64 = a.extra[a.fns[i].params_off × 1¤ptrdiff]
        emit_fn(&em, ir, np, lw.strs)
    // every function was emitted and left its offset behind
    assert(#em.fn_off = #a.fns, "one code offset per function")
    assert(#em.rt_off = 15, "every runtime routine in place")
    // calls resolve now that every target has a place
    if #em.cf_pos > 0:
        foreach i := 0…#em.cf_pos - 1:
            let pos : i64 = em.cf_pos[i]
            let t : i64 = em.cf_target[i]
            let dest : i64 = em.fn_off[t × 1¤ptrdiff] if t >= 0 else em.rt_off[(0 - t - 1) × 1¤ptrdiff]
            em.patch32(pos, dest - (pos + 4))
    // rodata: the strings' bytes, then their descriptors
    let text_size : i64 = em.here()
    let ro_vaddr : i64 = IMAGE_BASE + align_up(PAGE + text_size, PAGE)
    let stroffs : mut i64[] = []
    let acc : mut i64 = 0
    foreach s := lw.strs:
        stroffs.push(acc)
        acc ← acc + str_len(s)
    let descbase : i64 = align_up(acc, 8)
    let jt_base : i64 = descbase + 16 × @dropunit(#lw.strs)
    if #em.sf_pos > 0:
        foreach i := 0…#em.sf_pos - 1:
            em.patch64(em.sf_pos[i], ro_vaddr + stroffs[em.sf_str[i] × 1¤ptrdiff])
    if #em.sd_pos > 0:
        foreach i := 0…#em.sd_pos - 1:
            em.patch64(em.sd_pos[i], ro_vaddr + descbase + 16 × em.sd_str[i])
    if #em.jt_pos > 0:
        foreach i := 0…#em.jt_pos - 1:
            em.patch64(em.jt_pos[i], ro_vaddr + jt_base + 8 × em.jt_starts[em.jt_id[i] × 1¤ptrdiff])
    assert(#stroffs = #lw.strs, "one offset per string")
    let rodata : mut u8[] = []
    foreach s := lw.strs:
        foreach c := s:
            rodata.push(c.ord() & 255)
    while @dropunit(#rodata) < descbase:
        rodata.push(0)
    foreach i := 0…#lw.strs - 1:
        push64(&rodata, ro_vaddr + stroffs[i])
        push64(&rodata, str_len(lw.strs[i]))
    // a jump table holds code addresses, a value table its data
    if #em.jt_starts > 0:
        foreach t := 0…#em.jt_starts - 1:
            let lo2 : i64 = em.jt_starts[t]
            let hi2 : i64 = em.jt_starts[t + 1] if t + 1 < #em.jt_starts else @dropunit(#em.jt_entries)
            let base2 : i64 = IMAGE_BASE + PAGE if em.jt_is_code[t] = 1 else 0
            let e3 : mut i64 = lo2
            while e3 < hi2:
                push64(&rodata, base2 + em.jt_entries[e3 × 1¤ptrdiff])
                e3 ← e3 + 1
    // data: the globals' first values, then the allocator's state
    let d_vaddr : i64 = IMAGE_BASE + align_up(align_up(PAGE + text_size, PAGE) + @dropunit(#rodata), PAGE)
    if #em.df_pos > 0:
        foreach i := 0…#em.df_pos - 1:
            em.patch64(em.df_pos[i], d_vaddr + em.df_off[i])
    let data : mut u8[] = []
    if nglobals > 0:
        foreach i := 0…#chk.gvals - 1:
            push64(&data, chk.gvals[i])
    foreach _ := 1…16:
        data.push(0)
    (Compiled{elf: build_elf(em.code, rodata, data), log: lw.dlog})

// ===========================================================================
// Driver (grows as the pipeline does)
// ===========================================================================

fn tok_name(k : i64) → str:
    if k = TK_EOF: return "eof"
    if k = TK_NL: return "nl"
    if k = TK_INDENT: return "indent"
    if k = TK_DEDENT: return "dedent"
    if k = TK_IDENT: return "ident"
    if k = TK_INT: return "int"
    if k = TK_STR: return "str"
    if k = TK_RESERVED: return "reserved"
    if k >= 20 and k <= 38: return "kw"
    "op"

@impure
fn dump_tokens(t : Toks, src : byte[]):
    foreach i := 0…#t.kind - 1:
        let k : i64 = t.kind[i]
        let text := run_str(src, t.off[i], t.len[i])
        std.println("{}:{} {} {} '{}' {}", t.line[i], t.col[i], k,
                    tok_name(k), text, t.val[i])

@impure
fn report(diags : Diag[], file : str, as_json : bool, src : byte[]):
    foreach d := diags:
        if as_json:
            std.println("{}\"file\": \"{}\", \"line\": {}, \"col\": {}, \"severity\": \"error\", \"message\": \"{}\"{}",
                        "{", file, d.line, d.col, d.msg, "}")
        else:
            std.println("{}:{}:{}: error: {}", file, d.line, d.col, d.msg)
            let num := i64_str(d.line)
            let gut : mut str = ""
            let g ¤ptrdiff : mut i64 = 0
            while g < #num:
                gut ← gut ⧺ " "
                g ← g + 1
            let pad : mut str = ""
            let c : mut i64 = 1
            while c < d.col:
                pad ← pad ⧺ " "
                c ← c + 1
            std.println("  {} | {}", num, line_str(src, d.line))
            std.println("  {} | {}^", gut, pad)

// What a file is for is told by its name: a source file ends in
// .ngpl, and other kinds of input -- objects, libraries -- will carry
// names of their own.  A name the compiler cannot classify is refused
// up front rather than read and misparsed.
fn is_ngpl_source(path : str) → bool:
    let cs := path.chars()
    if #cs < 6:
        return false
    cs[#cs - 5] = '.' and cs[#cs - 4] = 'n' and cs[#cs - 3] = 'g' and cs[#cs - 2] = 'p' and cs[#cs - 1] = 'l'

// The named source could not be opened: say which file and why the
// compiler stopped, in the compiler's own words rather than a raw
// operating system error.
@noreturn
@impure
fn missing_input(name : str):
    std.println("ngplc: cannot open '{}': no such file or it cannot be read", name)
    std.exit(1)

@start
@impure
fn main() → u8:
    let argv := std.args.all()
    if #argv = 0:
        std.println("usage: ngplc <source.ngpl> [-o out] [--dump-tokens] [--dump-ast] [--diag=json] [--log=json]")
        return 1
    let input : mut str = ""
    let output : mut str = ""
    let want_tokens : mut bool = false
    let want_ast : mut bool = false
    let want_log : mut bool = false
    let json : mut bool = false
    let i ¤ptrdiff : mut i64 = 0
    while i < #argv:
        let a := argv[i]
        if a = "-o":
            if i + 1 >= #argv:
                std.println("ngplc: -o requires the output file name after it")
                return 1
            output ← argv[i + 1]
            i ← i + 2
            continue
        if a = "--dump-tokens":
            want_tokens ← true
        elif a = "--dump-ast":
            want_ast ← true
        elif a = "--diag=json":
            json ← true
        elif a = "--log=json":
            want_log ← true
        elif input = "":
            input ← a
        else:
            std.println("ngplc: one source file per run; '{}' is a second", a)
            return 1
        i ← i + 1
    if input = "":
        std.println("ngplc: no source file named")
        return 1
    if not is_ngpl_source(input):
        std.println("ngplc: cannot tell what '{}' is: an NGPL source file's name ends in '.ngpl'", input)
        return 1

    let alloc := std.arena.allocator()
    let file := std.fs.cwd().open_file(input) ?? missing_input(input)
    let src := file.read_file(alloc)

    let toks := lex(src)
    if #toks.diags > 0:
        report(toks.diags, input, json, src)
        return 1
    if want_tokens:
        dump_tokens(toks, src)
        return 0

    let ast := parse(toks, src)
    if #ast.diags > 0:
        report(ast.diags, input, json, src)
        return 1
    if want_ast:
        dump_ast(ast, src, toks)
        return 0

    let chk := check(ast, toks, src)
    if #chk.diags > 0:
        report(chk.diags, input, json, src)
        return 1

    let compiled := codegen(ast, toks, src, chk)
    if want_log:
        foreach l := compiled.log:
            std.println("{}", l)

    // as every Unix compiler has it: a.out unless -o names the file
    let outname : str = output if output ≠ "" else "a.out"
    let outf := std.fs.cwd().create_file(outname, 493)
    outf.write(compiled.elf)
    outf.close()
    0
