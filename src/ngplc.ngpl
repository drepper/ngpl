                else:
                    em.b3(72, 99, 200)           // movsxd rcx, eax
                em.b3(72, 57, 193)               // cmp rcx, rax
                em.jglobal(0, 133, RT_BADFIT)    // jne
            em.store(R_AX, d)
        elif o = IR_SBYTES:
            em.load(R_DI, a)
            em.jglobal(232, ⁻1, RT_SBYTES)
