// ---------------------------------------------------------------------------
// riscv64: the RV64IM instruction layer
//
// Register plan: RA=t0, RB=t1, RC=t2, T=t3, with t4…t6 the layer's
// own scratch; arguments in a0…a7, the result in a0, a7 the syscall
// number; ra and s0 frame the call.  RISC-V materializes what other
// machines read from flags, which suits a driver that wants its
// comparisons as 0/1 anyway.
// ---------------------------------------------------------------------------

let RV_RA : i64 = 5
let RV_RB : i64 = 6
let RV_RC : i64 = 7
let RV_T : i64 = 28
let RV_S0 : i64 = 29
let RV_S1 : i64 = 30
let RV_S2 : i64 = 31

fn rv_r(r : i64) → i64:
    if r = RG_A: return RV_RA
    if r = RG_B: return RV_RB
    if r = RG_C: return RV_RC
    RV_T

// the four instruction shapes
fn rv_R(em : &mut Emit, f7 : i64, rs2 : i64, rs1 : i64, f3 : i64, rd : i64, op : i64):
    em.aw((f7 « 25) + (rs2 « 20) + (rs1 « 15) + (f3 « 12) + (rd « 7) + op)

fn rv_I(em : &mut Emit, imm : i64, rs1 : i64, f3 : i64, rd : i64, op : i64):
    assert(imm >= ⁻2048 and imm < 2048, "the immediate fits twelve bits")
    em.aw(((imm & 4095) « 20) + (rs1 « 15) + (f3 « 12) + (rd « 7) + op)

fn rv_S(em : &mut Emit, imm : i64, rs2 : i64, rs1 : i64, f3 : i64):
    assert(imm >= ⁻2048 and imm < 2048, "the immediate fits twelve bits")
    em.aw((((imm » 5) & 127) « 25) + (rs2 « 20) + (rs1 « 15) + (f3 « 12) + ((imm & 31) « 7) + 35)

fn rv_U(em : &mut Emit, imm20 : i64, rd : i64, op : i64):
    em.aw(((imm20 & 1048575) « 12) + (rd « 7) + op)

// jal's scrambled immediate, from a byte delta
fn rv_jimm(delta : i64) → i64:
    let d : i64 = delta
    (((d » 20) & 1) « 31) + (((d » 1) & 1023) « 21) + (((d » 11) & 1) « 20) + (((d » 12) & 255) « 12)

fn rv_jal(em : &mut Emit, rd : i64, delta : i64):
    em.aw(rv_jimm(delta) + (rd « 7) + 111)

// a conditional branch with a fixed short hop, used to step over the
// long jump that carries the real distance
fn rv_bshort(em : &mut Emit, f3 : i64, rs1 : i64, rs2 : i64, delta : i64):
    let imm : i64 = delta
    em.aw((((imm » 12) & 1) « 31) + (((imm » 5) & 63) « 25) + (rs2 « 20) + (rs1 « 15) + (f3 « 12) + (((imm » 1) & 15) « 8) + (((imm » 11) & 1) « 7) + 99)

fn rv_mv(em : &mut Emit, rd : i64, rs : i64):
    rv_I(&em, 0, rs, 0, rd, 19)

fn rv_movimm(em : &mut Emit, rd : i64, v : i64):
    if v >= ⁻2048 and v < 2048:
        rv_I(&em, v, 0, 0, rd, 19)                          // addi rd, x0, v
        return
    if v >= ⁻2147483648 and v < 2147483648:
        let hi : i64 = (v + 2048) » 12
        rv_U(&em, hi, rd, 55)                               // lui
        rv_I(&em, v - (hi « 12), rd, 0, rd, 19)             // lui+addi
        return
    // the high half, shifted up, and the low half added in from t6;
    // the seam arithmetic wraps on purpose at the edges of the range
    let lo : i64 = @wrap(@wrap(v « 32) » 32)
    let hi32 : i64 = @wrap(v - lo) » 32
    rv_movimm(&em, rd, hi32)
    rv_I(&em, 32, rd, 1, rd, 19)                            // slli rd, rd, 32
    rv_movimm32(&em, RV_S2, lo)
    rv_R(&em, 0, RV_S2, rd, 0, rd, 51)                      // add
fn rv_movimm32(em : &mut Emit, rd : i64, v : i64):
    if v >= ⁻2048 and v < 2048:
        rv_I(&em, v, 0, 0, rd, 19)
        return
    let hi : i64 = (v + 2048) » 12
    rv_U(&em, hi, rd, 55)
    rv_I(&em, v - (hi « 12), rd, 0, rd, 19)

// a slot, reached with a wide offset when the frame is deep
fn rv_slotaddr(em : &mut Emit, off : i64) → i64:
    // answers the register holding the address: sp itself for a near
    // slot, t5 for a far one
    if off < 2048:
        return 2
    rv_movimm(&em, RV_S1, off)
    rv_R(&em, 0, RV_S1, 2, 0, RV_S1, 51)                    // add t5, sp, t5
    RV_S1

fn rv_ldslot(em : &mut Emit, rd : i64, slot : i64):
    let off : i64 = 32 + 8 × slot
    let base : i64 = rv_slotaddr(&em, off)
    let zero : i64 = 0
    let o : i64 = off if base = 2 else zero
    rv_I(&em, o, base, 3, rd, 3)                            // ld

fn rv_stslot(em : &mut Emit, rs : i64, slot : i64):
    let off : i64 = 32 + 8 × slot
    let base : i64 = rv_slotaddr(&em, off)
    let zero : i64 = 0
    let o : i64 = off if base = 2 else zero
    rv_S(&em, o, rs, base, 3)                               // sd

fn rvg_lds(em : &mut Emit, tg : Target, r : i64, slot : i64):
    rv_ldslot(&em, rv_r(r), slot)

fn rvg_sts(em : &mut Emit, tg : Target, r : i64, slot : i64):
    rv_stslot(&em, rv_r(r), slot)

fn rvg_const(em : &mut Emit, tg : Target, r : i64, v : i64):
    rv_movimm(&em, rv_r(r), v)

fn rvg_mov2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    rv_mv(&em, rv_r(rd), rv_r(rs))

fn rvg_add3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 0, rv_r(ry), rv_r(rx), 0, rv_r(rd), 51)

fn rvg_sub3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 32, rv_r(ry), rv_r(rx), 0, rv_r(rd), 51)

fn rvg_mul3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 1, rv_r(ry), rv_r(rx), 0, rv_r(rd), 51)

fn rvg_and3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 0, rv_r(ry), rv_r(rx), 7, rv_r(rd), 51)

fn rvg_or3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 0, rv_r(ry), rv_r(rx), 6, rv_r(rd), 51)

fn rvg_xor3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 0, rv_r(ry), rv_r(rx), 4, rv_r(rd), 51)

fn rvg_not2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    rv_I(&em, ⁻1, rv_r(rs), 4, rv_r(rd), 19)                // xori rd, rs, -1

fn rvg_neg2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    rv_R(&em, 32, rv_r(rs), 0, 0, rv_r(rd), 51)             // sub rd, x0, rs

fn rvg_shl3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 0, rv_r(ry), rv_r(rx), 1, rv_r(rd), 51)

fn rvg_shr3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 0, rv_r(ry), rv_r(rx), 5, rv_r(rd), 51)

fn rvg_sar3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    rv_R(&em, 32, rv_r(ry), rv_r(rx), 5, rv_r(rd), 51)

fn rvg_shl3i(em : &mut Emit, tg : Target, rd : i64, rs : i64, imm : i64):
    rv_I(&em, imm, rv_r(rs), 1, rv_r(rd), 19)               // slli

fn rvg_cmp3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64):
    let x : i64 = rv_r(rx)
    let y : i64 = rv_r(ry)
    let d : i64 = rv_r(rd)
    if cond = CC_EQ or cond = CC_NE:
        rv_R(&em, 0, y, x, 4, RV_S0, 51)                    // xor t4, x, y
        if cond = CC_EQ:
            rv_I(&em, 1, RV_S0, 3, d, 19)                   // sltiu d, t4, 1
        else:
            rv_R(&em, 0, RV_S0, 0, 3, d, 51)                // sltu d, x0, t4
        return
    let f3 : i64 = 2 if sgn = 1 else 3                      // slt / sltu
    if cond = CC_LT:
        rv_R(&em, 0, y, x, f3, d, 51)
    elif cond = CC_GE:
        rv_R(&em, 0, y, x, f3, d, 51)
        rv_I(&em, 1, d, 4, d, 19)                           // xori
    elif cond = CC_GT:
        rv_R(&em, 0, x, y, f3, d, 51)
    else:
        rv_R(&em, 0, x, y, f3, d, 51)
        rv_I(&em, 1, d, 4, d, 19)

fn rvg_sel4(em : &mut Emit, tg : Target, rd : i64, rc : i64, rx : i64, ry : i64):
    // masks, not branches: t4 = all-ones where the condition holds
    rv_R(&em, 0, rv_r(rc), 0, 3, RV_S0, 51)                 // sltu t4, x0, rc
    rv_R(&em, 32, RV_S0, 0, 0, RV_S0, 51)                   // sub t4, x0, t4
    rv_R(&em, 0, RV_S0, rv_r(rx), 7, RV_S1, 51)             // and t5, rx, t4
    rv_I(&em, ⁻1, RV_S0, 4, RV_S0, 19)                      // not t4
    rv_R(&em, 0, RV_S0, rv_r(ry), 7, RV_S0, 51)             // and t4, ry, t4
    rv_R(&em, 0, RV_S0, RV_S1, 6, rv_r(rd), 51)             // or rd

fn rvg_div3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    rv_R(&em, 1, rv_r(ry), rv_r(rx), 4 if sgn = 1 else 5, rv_r(rd), 51)

fn rvg_mod3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    rv_R(&em, 1, rv_r(ry), rv_r(rx), 6 if sgn = 1 else 7, rv_r(rd), 51)

fn rvg_addov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    if sgn = 1:
        rv_R(&em, 0, rv_r(ry), rv_r(rx), 0, RV_S1, 51)      // t5 = x + y
        rv_R(&em, 0, rv_r(ry), rv_r(rx), 4, RV_S0, 51)      // t4 = x ^ y
        rv_I(&em, ⁻1, RV_S0, 4, RV_S0, 19)                  // ~t4
        rv_R(&em, 0, RV_S1, rv_r(rx), 4, RV_S2, 51)         // t6 = x ^ sum
        rv_R(&em, 0, RV_S2, RV_S0, 7, RV_S0, 51)            // and
        rv_I(&em, 63, RV_S0, 5, rv_r(rf), 19)               // srli rf, t4, 63
        rv_mv(&em, rv_r(rd), RV_S1)
    else:
        rv_R(&em, 0, rv_r(ry), rv_r(rx), 0, RV_S1, 51)
        rv_R(&em, 0, rv_r(rx), RV_S1, 3, rv_r(rf), 51)      // sltu rf, sum, x
        rv_mv(&em, rv_r(rd), RV_S1)

fn rvg_subov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    if sgn = 1:
        rv_R(&em, 32, rv_r(ry), rv_r(rx), 0, RV_S1, 51)     // t5 = x - y
        rv_R(&em, 0, rv_r(ry), rv_r(rx), 4, RV_S0, 51)      // t4 = x ^ y
        rv_R(&em, 0, RV_S1, rv_r(rx), 4, RV_S2, 51)         // t6 = x ^ diff
        rv_R(&em, 0, RV_S2, RV_S0, 7, RV_S0, 51)
        rv_I(&em, 63, RV_S0, 5, rv_r(rf), 19)               // srli
        rv_mv(&em, rv_r(rd), RV_S1)
    else:
        rv_R(&em, 0, rv_r(ry), rv_r(rx), 3, RV_S0, 51)      // sltu t4, x, y
        rv_R(&em, 32, rv_r(ry), rv_r(rx), 0, rv_r(rd), 51)
        rv_mv(&em, rv_r(rf), RV_S0)

fn rvg_mulov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    if sgn = 1:
        rv_R(&em, 1, rv_r(ry), rv_r(rx), 0, RV_S1, 51)      // mul
        rv_R(&em, 1, rv_r(ry), rv_r(rx), 1, RV_S2, 51)      // mulh
        rv_I(&em, 63 + 1024, RV_S1, 5, RV_S0, 19)           // srai t4, t5, 63
        rv_R(&em, 0, RV_S2, RV_S0, 4, RV_S0, 51)            // xor t4, t4, t6
        rv_R(&em, 0, RV_S0, 0, 3, rv_r(rf), 51)             // sltu rf, x0, t4
        rv_mv(&em, rv_r(rd), RV_S1)
    else:
        rv_R(&em, 1, rv_r(ry), rv_r(rx), 0, RV_S1, 51)
        rv_R(&em, 1, rv_r(ry), rv_r(rx), 3, RV_S2, 51)      // mulhu
        rv_R(&em, 0, RV_S2, 0, 3, rv_r(rf), 51)
        rv_mv(&em, rv_r(rd), RV_S1)

fn rvg_ext2(em : &mut Emit, tg : Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    let sh : i64 = 64 - bits
    rv_I(&em, sh, rv_r(r), 1, rv_r(r), 19)                  // slli
    rv_I(&em, sh + 1024 if sgn = 1 else sh, rv_r(r), 5, rv_r(r), 19)

fn rvg_ldo(em : &mut Emit, tg : Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    let base : mut i64 = rv_r(rbase)
    let o : mut i64 = off
    if off >= 2048:
        rv_movimm(&em, RV_S1, off)
        rv_R(&em, 0, RV_S1, base, 0, RV_S1, 51)
        base ← RV_S1
        o ← 0
    let f3 : mut i64 = 3
    if wd = 4:
        f3 ← 2 if sgn = 1 else 6
    elif wd = 2:
        f3 ← 1 if sgn = 1 else 5
    elif wd = 1:
        f3 ← 0 if sgn = 1 else 4
    rv_I(&em, o, base, f3, rv_r(rd), 3)

fn rvg_sto(em : &mut Emit, tg : Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    let base : mut i64 = rv_r(rbase)
    let o : mut i64 = off
    if off >= 2048:
        rv_movimm(&em, RV_S1, off)
        rv_R(&em, 0, RV_S1, base, 0, RV_S1, 51)
        base ← RV_S1
        o ← 0
    let f3 : i64 = 3 if wd = 8 else (2 if wd = 4 else (1 if wd = 2 else 0))
    rv_S(&em, o, rv_r(rs), base, f3)

// local branches: an inverted short hop over a jal that goes the
// distance, so a label a megabyte away still resolves
let RVF_J : i64 = 20

fn rvg_jmp(em : &mut Emit, tg : Target, lab : i64):
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(RVF_J)
    em.aw(111)                                              // jal x0, 0

fn rvg_jz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    rv_bshort(&em, 1, rv_r(r), 0, 8)                        // bne r, x0, +8
    rvg_jmp(&em, tg, lab)

fn rvg_jnz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    rv_bshort(&em, 0, rv_r(r), 0, 8)                        // beq r, x0, +8
    rvg_jmp(&em, tg, lab)

fn rvg_label(em : &mut Emit, tg : Target, lab : i64):
    em.set_label(lab)

fn rvg_call(em : &mut Emit, tg : Target, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here())
    em.cf_target.push(target)
    em.aw((1 « 7) + 23)                                     // auipc ra, 0
    rv_I(&em, 0, 1, 0, 1, 103)                              // jalr ra, ra, 0

fn rvg_calli(em : &mut Emit, tg : Target, r : i64):
    rv_I(&em, 0, rv_r(r), 0, 1, 103)                        // jalr ra, r

fn rvg_ijmp(em : &mut Emit, tg : Target, r : i64):
    rv_I(&em, 0, rv_r(r), 0, 0, 103)                        // jalr x0, r

fn rvg_argld(em : &mut Emit, tg : Target, k : i64, slot : i64):
    if k < 8:
        rv_ldslot(&em, 10 + k, slot)
    else:
        rv_ldslot(&em, RV_S1, slot)
        rv_S(&em, 8 × (k - 8), RV_S1, 2, 3)                 // sd t5, off(sp)

fn rvg_argconst(em : &mut Emit, tg : Target, k : i64, v : i64):
    assert(k < 8, "a constant argument rides a register")
    rv_movimm(&em, 10 + k, v)

fn rvg_argmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    assert(k < 8, "a moved argument rides a register")
    rv_mv(&em, 10 + k, rv_r(r))

fn rvg_retst(em : &mut Emit, tg : Target, slot : i64):
    rv_stslot(&em, 10, slot)

fn rvg_retld(em : &mut Emit, tg : Target, slot : i64):
    rv_ldslot(&em, 10, slot)

fn rvg_retmov(em : &mut Emit, tg : Target, r : i64):
    rv_mv(&em, 10, rv_r(r))

fn rvg_absref(em : &mut Emit, tg : Target, r : i64) → i64:
    rv_absref(&em, rv_r(r))

fn rvg_absref_arg(em : &mut Emit, tg : Target, k : i64) → i64:
    assert(k < 8, "an address argument rides a register")
    rv_absref(&em, 10 + k)

fn rv_absref(em : &mut Emit, rd : i64) → i64:
    let pos : i64 = em.here()
    rv_U(&em, 0, rd, 55)                                    // lui rd, 0
    rv_I(&em, 0, rd, 0, rd, 19)                             // addi rd, rd, 0
    pos

fn rvg_sysarg(em : &mut Emit, tg : Target, k : i64, slot : i64):
    rv_ldslot(&em, 10 + k, slot)

fn rvg_sysimm(em : &mut Emit, tg : Target, k : i64, v : i64):
    rv_movimm(&em, 10 + k, v)

fn rvg_sysmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    rv_mv(&em, 10 + k, rv_r(r))

fn rvg_syscall(em : &mut Emit, tg : Target, scid : i64):
    rv_movimm(&em, 17, sc_number(tg, scid))
    em.aw(115)                                              // ecall

fn rvg_sysret(em : &mut Emit, tg : Target, r : i64):
    rv_mv(&em, rv_r(r), 10)

fn rvg_prologue(em : &mut Emit, tg : Target, nvregs : i64, np : i64):
    let frame : i64 = align_up(32 + 8 × nvregs, 16)
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    rv_I(&em, ⁻16, 2, 0, 2, 19)                             // addi sp, sp, -16
    rv_S(&em, 8, 1, 2, 3)                                   // sd ra, 8(sp)
    rv_S(&em, 0, 8, 2, 3)                                   // sd s0, 0(sp)
    rv_I(&em, 0, 2, 0, 8, 19)                               // mv s0, sp
    if frame < 2048:
        rv_I(&em, 0 - frame, 2, 0, 2, 19)                   // addi sp, sp, -frame
    else:
        rv_movimm(&em, RV_S1, frame)
        rv_R(&em, 32, RV_S1, 2, 0, 2, 51)                   // sub sp, sp, t5
    let j : mut i64 = 0
    while j < np:
        if j < 8:
            rv_stslot(&em, 10 + j, j)
        else:
            rv_I(&em, 16 + 8 × (j - 8), 8, 3, RV_S1, 3)     // ld t5, off(s0)
            rv_stslot(&em, RV_S1, j)
        j ← j + 1

fn rvg_epilogue(em : &mut Emit, tg : Target):
    rv_I(&em, 0, 8, 0, 2, 19)                               // mv sp, s0
    rv_I(&em, 8, 2, 3, 1, 3)                                // ld ra, 8(sp)
    rv_I(&em, 0, 2, 3, 8, 3)                                // ld s0, 0(sp)
    rv_I(&em, 16, 2, 0, 2, 19)                              // addi sp, sp, 16
    rv_I(&em, 0, 1, 0, 0, 103)                              // ret

fn rvg_resolve(em : &mut Emit, tg : Target):
    if #em.tf_pos > 0:
        foreach i := 0…#em.tf_pos - 1:
            let pos : i64 = em.tf_pos[i]
            let delta : i64 = em.labels[em.tf_lab[i] × 1¤ptrdiff] - pos
            assert(delta >= ⁻1048576 and delta < 1048576, "a local jump inside jal's reach")
            em.patch32(pos, code_word(&em, pos) + rv_jimm(delta))
    while #em.tf_pos > 0:
        _ ← em.tf_pos.pop() ?? 0
        _ ← em.tf_lab.pop() ?? 0
        _ ← em.tf_form.pop() ?? 0

fn rvg_patch_abs(em : &mut Emit, tg : Target, pos : i64, v : i64):
    let hi : i64 = (v + 2048) » 12
    em.patch32(pos, code_word(&em, pos) + ((hi & 1048575) « 12))
    em.patch32(pos + 4, code_word(&em, pos + 4) + (((v - (hi « 12)) & 4095) « 20))

fn rvg_patch_call(em : &mut Emit, tg : Target, pos : i64, dest : i64):
    let delta : i64 = dest - pos
    let hi : i64 = (delta + 2048) » 12
    em.patch32(pos, code_word(&em, pos) + ((hi & 1048575) « 12))
    em.patch32(pos + 4, code_word(&em, pos + 4) + (((delta - (hi « 12)) & 4095) « 20))

// ---------------------------------------------------------------------------
// i386: the 32-bit x86 instruction layer
//
// A 32-bit machine carries the 8-byte data model in pairs.  Here the
// abstract registers are not registers at all: they are four 8-byte
// cells at the top of the frame, and every operation loads its pairs
// into eax:edx and ecx:ebx, computes, and puts the result back.  The
// real registers never hold anything across two operations, which
// costs memory traffic and buys a layer simple enough to trust.
// Arguments travel on the stack, eight bytes each; the syscall is
// int 0x80 with the six arguments staged below it.
// ---------------------------------------------------------------------------

// the cells: A, B, C, T at [ebp-8], [ebp-16], [ebp-24], [ebp-32]
fn i3_cello(r : i64) → i64:
    0 - 8 × (r + 1)

// slot s lives at [ebp - 32 - 8×(s+1)]
fn i3_sloto(slot : i64) → i64:
    0 - 32 - 8 × (slot + 1)

// opcode + modrm(10, reg, 101) + disp32: the [ebp+disp] form
fn i3_rm(em : &mut Emit, op : i64, reg : i64, disp : i64):
    em.b2(op, 128 + reg × 8 + 5)
    em.w32(disp)

// a pair into (lo, hi) registers, and back
fn i3_ldpair(em : &mut Emit, lo : i64, hi : i64, disp : i64):
    i3_rm(&em, 139, lo, disp)
    i3_rm(&em, 139, hi, disp + 4)

fn i3_stpair(em : &mut Emit, lo : i64, hi : i64, disp : i64):
    i3_rm(&em, 137, lo, disp)
    i3_rm(&em, 137, hi, disp + 4)

fn i3_movimm(em : &mut Emit, reg : i64, v : i64):
    em.b1(184 + reg)
    em.w32(v)

fn i3g_lds(em : &mut Emit, tg : Target, r : i64, slot : i64):
    i3_ldpair(&em, 0, 2, i3_sloto(slot))
    i3_stpair(&em, 0, 2, i3_cello(r))

fn i3g_sts(em : &mut Emit, tg : Target, r : i64, slot : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    i3_stpair(&em, 0, 2, i3_sloto(slot))

fn i3g_const(em : &mut Emit, tg : Target, r : i64, v : i64):
    // straight into the cell, no register needed
    em.b2(199, 128 + 5)
    em.w32(i3_cello(r))
    em.w32(v & 4294967295)
    em.b2(199, 128 + 5)
    em.w32(i3_cello(r) + 4)
    em.w32(@wrap(v » 32) & 4294967295)

fn i3g_mov2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    i3_stpair(&em, 0, 2, i3_cello(rd))

// the pair ALU: x in eax:edx, y in ecx:ebx, result in eax:edx
fn i3_binprep(em : &mut Emit, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_ldpair(&em, 1, 3, i3_cello(ry))

fn i3g_add3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(1, 200)                    // add eax, ecx
    em.b2(17, 218)                   // adc edx, ebx
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_sub3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(41, 200)                   // sub eax, ecx
    em.b2(25, 218)                   // sbb edx, ebx
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_and3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(33, 200)
    em.b2(33, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_or3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(9, 200)
    em.b2(9, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_xor3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_binprep(&em, rx, ry)
    em.b2(49, 200)
    em.b2(49, 218)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_not2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    em.b2(247, 208)                  // not eax
    em.b2(247, 210)                  // not edx
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_neg2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    em.b2(247, 208)
    em.b2(247, 210)
    em.b3(131, 192, 1)               // add eax, 1
    em.b3(131, 210, 0)               // adc edx, 0
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_mul3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    // x in esi:edi, y in ecx:ebx; the three half-products
    i3_ldpair(&em, 6, 7, i3_cello(rx))
    i3_ldpair(&em, 1, 3, i3_cello(ry))
    em.b3(15, 175, 249)              // imul edi, ecx: x_hi × y_lo
    em.b3(15, 175, 222)              // imul ebx, esi: y_hi × x_lo
    em.b2(1, 223)                    // add edi, ebx
    em.b2(137, 240)                  // mov eax, esi
    em.b2(247, 225)                  // mul ecx: edx:eax = x_lo × y_lo
    em.b2(1, 250)                    // add edx, edi
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_shl3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_rm(&em, 139, 1, i3_cello(ry))     // mov ecx, count
    em.b3(128, 249, 32)              // cmp cl, 32
    em.b2(114, 11)                   // jb small (+11)
    em.b2(137, 194)                  // mov edx, eax
    em.b2(49, 192)                   // xor eax, eax
    em.b3(128, 233, 32)              // sub cl, 32
    em.b2(211, 226)                  // shl edx, cl
    em.b2(235, 5)                    // jmp done (+5)
    em.b4(15, 165, 194, 211)         // shld edx, eax, cl; shl eax, cl (starts)
    em.b1(224)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_shr3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_rm(&em, 139, 1, i3_cello(ry))
    em.b3(128, 249, 32)              // cmp cl, 32
    em.b2(114, 11)                   // jb small (+11)
    em.b2(137, 208)                  // mov eax, edx
    em.b2(49, 210)                   // xor edx, edx
    em.b3(128, 233, 32)              // sub cl, 32
    em.b2(211, 232)                  // shr eax, cl
    em.b2(235, 5)                    // jmp done (+5)
    em.b4(15, 173, 208, 211)         // shrd eax, edx, cl; shr edx, cl
    em.b1(234)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_sar3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_rm(&em, 139, 1, i3_cello(ry))
    em.b3(128, 249, 32)              // cmp cl, 32
    em.b2(114, 12)                   // jb small (+12)
    em.b2(137, 208)                  // mov eax, edx
    em.b3(193, 250, 31)              // sar edx, 31
    em.b3(128, 233, 32)              // sub cl, 32
    em.b2(211, 248)                  // sar eax, cl
    em.b2(235, 5)                    // jmp done (+5)
    em.b4(15, 173, 208, 211)         // shrd eax, edx, cl; sar edx, cl
    em.b1(250)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_shl3i(em : &mut Emit, tg : Target, rd : i64, rs : i64, imm : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rs))
    // the driver only asks for small shifts; the pair form is shld
    em.b4(15, 164, 194, imm)         // shld edx, eax, imm
    em.b3(193, 224, imm)             // shl eax, imm
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_cmp3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64):
    i3_binprep(&em, rx, ry)
    if cond = CC_EQ or cond = CC_NE:
        em.b2(49, 200)               // xor eax, ecx
        em.b2(49, 218)               // xor edx, ebx
        em.b2(9, 208)                // or eax, edx
        em.b3(15, 148 if cond = CC_EQ else 149, 192)
        em.b4(15, 182, 192, 144)     // movzx eax, al; nop
    else:
        // the swapped pair asks the mirrored question
        let flip : bool = cond = CC_GT or cond = CC_LE
        if flip:
            em.b2(135, 200)          // xchg eax, ecx
            em.b2(135, 218)          // xchg edx, ebx
        em.b2(57, 218)               // cmp edx, ebx
        em.b2(117, 7)                // jne past-the-low (+7)
        em.b2(57, 200)               // cmp eax, ecx
        em.b3(15, 146, 192)          // setb al: the low words decide
        em.b2(235, 4)                // jmp join (+4)
        em.b3(15, 156 if sgn = 1 else 146, 192)   // setl / setb on the high
        em.b1(144)                   // nop
        em.b4(15, 182, 192, 144)     // movzx eax, al; nop
        if cond = CC_GE or cond = CC_LE:
            em.b2(52, 1)             // xor al, 1
    em.b2(49, 210)                   // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_sel4(em : &mut Emit, tg : Target, rd : i64, rc : i64, rx : i64, ry : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rc))
    em.b2(9, 208)                    // or eax, edx
    em.b2(117, 14)                   // jnz take-rx (+14)
    i3_ldpair(&em, 0, 2, i3_cello(ry))
    em.b2(235, 12)                   // jmp join (+12)
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_div3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    i3_helper2(&em, rd, rx, ry, RT_DIVS64 if sgn = 1 else RT_DIVU64)

fn i3g_mod3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    i3_helper2(&em, rd, rx, ry, RT_MODS64 if sgn = 1 else RT_MODU64)

// a two-argument helper call: the cells staged, the answer stored
fn i3_helper2(em : &mut Emit, rd : i64, rx : i64, ry : i64, target : i64):
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    em.b3(137, 68, 36)
    em.b1(0)                         // mov [esp], eax
    em.b3(137, 84, 36)
    em.b1(4)                         // mov [esp+4], edx
    i3_ldpair(&em, 0, 2, i3_cello(ry))
    em.b3(137, 68, 36)
    em.b1(8)
    em.b3(137, 84, 36)
    em.b1(12)
    i3_call(&em, target)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_addov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    i3_binprep(&em, rx, ry)
    em.b2(1, 200)                    // add eax, ecx
    em.b2(17, 218)                   // adc edx, ebx
    em.b3(15, 144 if sgn = 1 else 146, 193)   // seto cl / setb cl
    em.b4(15, 182, 201, 144)         // movzx ecx, cl
    em.b2(49, 219)                   // xor ebx, ebx
    i3_stpair(&em, 0, 2, i3_cello(rd))
    i3_stpair(&em, 1, 3, i3_cello(rf))

fn i3g_subov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    i3_binprep(&em, rx, ry)
    em.b2(41, 200)                   // sub eax, ecx
    em.b2(25, 218)                   // sbb edx, ebx
    em.b3(15, 144 if sgn = 1 else 146, 193)
    em.b4(15, 182, 201, 144)
    em.b2(49, 219)
    i3_stpair(&em, 0, 2, i3_cello(rd))
    i3_stpair(&em, 1, 3, i3_cello(rf))

fn i3g_mulov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    // the helper's arguments staged, the product computed and parked
    // past them, the flag fetched, and only then the cells written --
    // the driver aliases the flag's cell with an operand's
    i3_ldpair(&em, 0, 2, i3_cello(rx))
    em.b3(137, 68, 36)
    em.b1(0)
    em.b3(137, 84, 36)
    em.b1(4)
    i3_ldpair(&em, 0, 2, i3_cello(ry))
    em.b3(137, 68, 36)
    em.b1(8)
    em.b3(137, 84, 36)
    em.b1(12)
    em.b3(199, 68, 36)
    em.b1(16)
    em.w32(sgn)                      // mov dword [esp+16], sgn
    em.b3(199, 68, 36)
    em.b1(20)
    em.w32(0)
    // the wrapped product, into the parking pair at [esp+24]
    i3_ldpair(&em, 6, 7, i3_cello(rx))
    i3_ldpair(&em, 1, 3, i3_cello(ry))
    em.b3(15, 175, 249)              // imul edi, ecx
    em.b3(15, 175, 222)              // imul ebx, esi
    em.b2(1, 223)                    // add edi, ebx
    em.b2(137, 240)                  // mov eax, esi
    em.b2(247, 225)                  // mul ecx
    em.b2(1, 250)                    // add edx, edi
    em.b3(137, 68, 36)
    em.b1(24)
    em.b3(137, 84, 36)
    em.b1(28)
    i3_call(&em, RT_MULOV64)
    i3_stpair(&em, 0, 2, i3_cello(rf))
    em.b3(139, 68, 36)
    em.b1(24)
    em.b3(139, 84, 36)
    em.b1(28)
    i3_stpair(&em, 0, 2, i3_cello(rd))

fn i3g_ext2(em : &mut Emit, tg : Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    i3_ldpair(&em, 0, 2, i3_cello(r))
    if bits = 8:
        em.b3(15, 190 if sgn = 1 else 182, 192)   // movsx/movzx eax, al
    elif bits = 16:
        em.b3(15, 191 if sgn = 1 else 183, 192)   // movsx/movzx eax, ax
    if sgn = 1:
        em.b1(153)                   // cdq
    else:
        em.b2(49, 210)               // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(r))

fn i3g_ldo(em : &mut Emit, tg : Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    i3_rm(&em, 139, 0, i3_cello(rbase))       // mov eax, base.lo
    if off ≠ 0:
        em.b1(5)
        em.w32(off)                  // add eax, off
    if wd = 8:
        em.b2(139, 72)
        em.b1(0)                     // mov ecx, [eax]
        em.b2(139, 88)
        em.b1(4)                     // mov ebx, [eax+4]
    elif wd = 4:
        em.b2(139, 8)                // mov ecx, [eax]
        if sgn = 1:
            em.b2(137, 203)          // mov ebx, ecx
            em.b3(193, 251, 31)      // sar ebx, 31
        else:
            em.b2(49, 219)
    elif wd = 2:
        em.b3(15, 191 if sgn = 1 else 183, 8)     // movsx/movzx ecx, word [eax]
        if sgn = 1:
            em.b2(137, 203)
            em.b3(193, 251, 31)
        else:
            em.b2(49, 219)
    else:
        em.b3(15, 190 if sgn = 1 else 182, 8)     // …byte [eax]
        if sgn = 1:
            em.b2(137, 203)
            em.b3(193, 251, 31)
        else:
            em.b2(49, 219)
    i3_stpair(&em, 1, 3, i3_cello(rd))

fn i3g_sto(em : &mut Emit, tg : Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    i3_rm(&em, 139, 0, i3_cello(rbase))
    if off ≠ 0:
        em.b1(5)
        em.w32(off)
    i3_ldpair(&em, 1, 3, i3_cello(rs))
    if wd = 8:
        em.b2(137, 8)                // mov [eax], ecx
        em.b2(137, 88)
        em.b1(4)                     // mov [eax+4], ebx
    elif wd = 4:
        em.b2(137, 8)
    elif wd = 2:
        em.b3(102, 137, 8)           // mov [eax], cx
    else:
        em.b2(136, 8)                // mov [eax], cl

let I3F_REL : i64 = 32

fn i3g_jmp(em : &mut Emit, tg : Target, lab : i64):
    em.tf_pos.push(em.here() + 1)
    em.tf_lab.push(lab)
    em.tf_form.push(I3F_REL)
    em.b1(233)                       // jmp rel32
    em.w32(0)

fn i3_jcc(em : &mut Emit, cc : i64, lab : i64):
    em.tf_pos.push(em.here() + 2)
    em.tf_lab.push(lab)
    em.tf_form.push(I3F_REL)
    em.b2(15, cc)
    em.w32(0)

fn i3g_jz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    em.b2(9, 208)                    // or eax, edx
    i3_jcc(&em, 132, lab)

fn i3g_jnz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    em.b2(9, 208)
    i3_jcc(&em, 133, lab)

fn i3g_label(em : &mut Emit, tg : Target, lab : i64):
    em.set_label(lab)

fn i3_call(em : &mut Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here() + 1)
    em.cf_target.push(target)
    em.b1(232)                       // call rel32
    em.w32(0)

fn i3g_call(em : &mut Emit, tg : Target, target : i64):
    i3_call(&em, target)

fn i3g_calli(em : &mut Emit, tg : Target, r : i64):
    i3_rm(&em, 139, 0, i3_cello(r))
    em.b2(255, 208)                  // call eax

fn i3g_ijmp(em : &mut Emit, tg : Target, r : i64):
    i3_rm(&em, 139, 0, i3_cello(r))
    em.b2(255, 224)                  // jmp eax

fn i3g_argld(em : &mut Emit, tg : Target, k : i64, slot : i64):
    i3_ldpair(&em, 0, 2, i3_sloto(slot))
    em.b3(137, 68, 36)
    em.b1(8 × k)
    em.b3(137, 84, 36)
    em.b1(8 × k + 4)

fn i3g_argconst(em : &mut Emit, tg : Target, k : i64, v : i64):
    em.b3(199, 68, 36)
    em.b1(8 × k)
    em.w32(v & 4294967295)
    em.b3(199, 68, 36)
    em.b1(8 × k + 4)
    em.w32(@wrap(v » 32) & 4294967295)

fn i3g_argmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))
    em.b3(137, 68, 36)
    em.b1(8 × k)
    em.b3(137, 84, 36)
    em.b1(8 × k + 4)

fn i3g_retst(em : &mut Emit, tg : Target, slot : i64):
    i3_stpair(&em, 0, 2, i3_sloto(slot))

fn i3g_retld(em : &mut Emit, tg : Target, slot : i64):
    i3_ldpair(&em, 0, 2, i3_sloto(slot))

fn i3g_retmov(em : &mut Emit, tg : Target, r : i64):
    i3_ldpair(&em, 0, 2, i3_cello(r))

fn i3g_absref(em : &mut Emit, tg : Target, r : i64) → i64:
    let pos : i64 = em.here() + 1
    i3_movimm(&em, 0, 0)             // mov eax, imm32
    em.b2(49, 210)                   // xor edx, edx
    i3_stpair(&em, 0, 2, i3_cello(r))
    pos

fn i3g_absref_arg(em : &mut Emit, tg : Target, k : i64) → i64:
    let pos : i64 = em.here() + 1
    i3_movimm(&em, 0, 0)
    em.b3(137, 68, 36)
    em.b1(8 × k)
    em.b3(199, 68, 36)
    em.b1(8 × k + 4)
    em.w32(0)
    pos

// the kernel: the six arguments staged low in the outgoing area as
// 4-byte words, then gathered into the registers int 0x80 reads
fn i3g_sysarg(em : &mut Emit, tg : Target, k : i64, slot : i64):
    i3_rm(&em, 139, 0, i3_sloto(slot))
    em.b3(137, 68, 36)
    em.b1(4 × k)

fn i3g_sysimm(em : &mut Emit, tg : Target, k : i64, v : i64):
    em.b3(199, 68, 36)
    em.b1(4 × k)
    em.w32(v)

fn i3g_sysmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    i3_rm(&em, 139, 0, i3_cello(r))
    em.b3(137, 68, 36)
    em.b1(4 × k)

fn i3g_syscall(em : &mut Emit, tg : Target, scid : i64):
    i3_movimm(&em, 0, sc_number(tg, scid))
    em.b1(85)                        // push ebp
    em.b3(139, 92, 36)
    em.b1(4)                         // mov ebx, [esp+4]
    em.b3(139, 76, 36)
    em.b1(8)
    em.b3(139, 84, 36)
    em.b1(12)
    em.b3(139, 116, 36)
    em.b1(16)
    em.b3(139, 124, 36)
    em.b1(20)
    em.b3(139, 108, 36)
    em.b1(24)                        // mov ebp, [esp+24]
    em.b2(205, 128)                  // int 0x80
    em.b1(93)                        // pop ebp
    // only the errno band is negative; an address above 2G is not
    em.b2(49, 210)                   // xor edx, edx
    em.b1(61)
    em.w32(⁻4096)                    // cmp eax, -4096
    em.b2(114, 5)                    // jb done (+5)
    i3_movimm(&em, 2, ⁻1)            // mov edx, -1: a real error

fn i3g_sysret(em : &mut Emit, tg : Target, r : i64):
    i3_stpair(&em, 0, 2, i3_cello(r))

fn i3g_prologue(em : &mut Emit, tg : Target, nvregs : i64, np : i64):
    let frame : i64 = 32 + 8 × nvregs + 128
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.b1(85)                        // push ebp
    em.b2(137, 229)                  // mov ebp, esp
    em.b2(129, 236)
    em.w32(frame)                    // sub esp, frame
    let j : mut i64 = 0
    while j < np:
        i3_ldpair(&em, 0, 2, 8 + 8 × j)
        i3_stpair(&em, 0, 2, i3_sloto(j))
        j ← j + 1

fn i3g_epilogue(em : &mut Emit, tg : Target):
    em.b2(137, 236)                  // mov esp, ebp
    em.b1(93)                        // pop ebp
    em.b1(195)                       // ret

fn i3g_resolve(em : &mut Emit, tg : Target):
    if #em.tf_pos > 0:
        foreach i := 0…#em.tf_pos - 1:
            let pos : i64 = em.tf_pos[i]
            em.patch32(pos, em.labels[em.tf_lab[i] × 1¤ptrdiff] - (pos + 4))
    while #em.tf_pos > 0:
        _ ← em.tf_pos.pop() ?? 0
        _ ← em.tf_lab.pop() ?? 0
        _ ← em.tf_form.pop() ?? 0

fn i3g_patch_abs(em : &mut Emit, tg : Target, pos : i64, v : i64):
    em.patch32(pos, v)

fn i3g_patch_call(em : &mut Emit, tg : Target, pos : i64, dest : i64):
    em.patch32(pos, dest - (pos + 4))

// ---------------------------------------------------------------------------
// arm (32-bit, EABI): the A32 instruction layer
//
// The same cell model as i386: pairs in (r0,r1) and (r2,r3), scratch
// r4…r6 and ip, everything at rest in memory at [sp,#128…].  What x86
// answers with setcc, ARM answers with a conditional mov; what x86
// branches for, a register-specified shift often absorbs, since a
// shift by 32 or more falls to zero on its own.  Arguments travel on
// the stack, eight bytes each.
// ---------------------------------------------------------------------------

let A32_LDRSP : i64 = 3852271616
let A32_STRSP : i64 = 3851223040
let A32_LDRR : i64 = 3851419648
let A32_STRR : i64 = 3850371072
let A32_LDRB : i64 = 3855613952
let A32_STRB : i64 = 3854565376
let A32_LDRH : i64 = 3788505264
let A32_STRH : i64 = 3787456688
let A32_ADD : i64 = 3766484992
let A32_ADDS : i64 = 3767533568
let A32_ADC : i64 = 3768582144
let A32_SUB : i64 = 3762290688
let A32_SUBS : i64 = 3763339264
let A32_SBC : i64 = 3770679296
let A32_SBCS : i64 = 3771727872
let A32_AND : i64 = 3758096384
let A32_ORR : i64 = 3783262208
let A32_EOR : i64 = 3760193536
let A32_MVN : i64 = 3789553664
let A32_MOVR : i64 = 3785359360
let A32_CMP : i64 = 3780116480
let A32_CMP0 : i64 = 3813670912
let A32_MOV0 : i64 = 3818913792
let A32_MUL : i64 = 3758096528
let A32_UMULL : i64 = 3766485136
let A32_MLA : i64 = 3760193680
let A32_MOVW : i64 = 3808428032
let A32_MOVT : i64 = 3812622336
let A32_B : i64 = 3925868544
let A32_BL : i64 = 3942645760
let A32_BLXR : i64 = 3778019120
let A32_BXLR : i64 = 3778019102
let A32_PUSHFL : i64 = 3912058880
let A32_POPFL : i64 = 3904718848
let A32_SVC : i64 = 4009754624
let A32_RSBI : i64 = 3797942272
let A32_ADDI : i64 = 3800039424
let A32_MOVC1 : i64 = 60817409

let A32_EQ : i64 = 0
let A32_NE : i64 = 1
let A32_CS : i64 = 2
let A32_CC : i64 = 3
let A32_VS : i64 = 6
let A32_HI : i64 = 8
let A32_LS : i64 = 9
let A32_GE : i64 = 10
let A32_LT : i64 = 11
let A32_GT : i64 = 12
let A32_LE : i64 = 13

fn a32_cello(r : i64) → i64:
    128 + 8 × r

fn a32_sloto(slot : i64) → i64:
    160 + 8 × slot

// a data op, rd ← rn op rm
fn a32_dp(em : &mut Emit, op : i64, rd : i64, rn : i64, rm : i64):
    em.aw(op + (rn « 16) + (rd « 12) + rm)

// rd ← rn op (rm shifted by register rs); type 0 lsl, 1 lsr, 2 asr
fn a32_dps(em : &mut Emit, op : i64, rd : i64, rn : i64, rm : i64, ty : i64, rs : i64):
    em.aw(op + (rn « 16) + (rd « 12) + (rs « 8) + (ty « 5) + 16 + rm)

fn a32_movw(em : &mut Emit, rd : i64, v : i64):
    em.aw(A32_MOVW + (((v » 12) & 15) « 16) + (rd « 12) + (v & 4095))
fn a32_movt(em : &mut Emit, rd : i64, v : i64):
    em.aw(A32_MOVT + (((v » 28) & 15) « 16) + (rd « 12) + ((v » 16) & 4095))
fn a32_movimm(em : &mut Emit, rd : i64, v : i64):
    a32_movw(&em, rd, v & 65535)
    if ((v » 16) & 65535) ≠ 0:
        a32_movt(&em, rd, v & 4294967295)

fn a32_ldsp(em : &mut Emit, rd : i64, off : i64):
    if off < 4096:
        em.aw(A32_LDRSP + (rd « 12) + off)
    else:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 12, 13, 12)
        em.aw(A32_LDRR + (12 « 16) + (rd « 12))
fn a32_stsp(em : &mut Emit, rs : i64, off : i64):
    if off < 4096:
        em.aw(A32_STRSP + (rs « 12) + off)
    else:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 12, 13, 12)
        em.aw(A32_STRR + (12 « 16) + (rs « 12))

fn a32_ldpair(em : &mut Emit, lo : i64, hi : i64, off : i64):
    a32_ldsp(&em, lo, off)
    a32_ldsp(&em, hi, off + 4)
fn a32_stpair(em : &mut Emit, lo : i64, hi : i64, off : i64):
    a32_stsp(&em, lo, off)
    a32_stsp(&em, hi, off + 4)

fn a32g_lds(em : &mut Emit, tg : Target, r : i64, slot : i64):
    a32_ldpair(&em, 0, 1, a32_sloto(slot))
    a32_stpair(&em, 0, 1, a32_cello(r))

fn a32g_sts(em : &mut Emit, tg : Target, r : i64, slot : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_stpair(&em, 0, 1, a32_sloto(slot))

fn a32g_const(em : &mut Emit, tg : Target, r : i64, v : i64):
    a32_movimm(&em, 0, v & 4294967295)
    a32_movimm(&em, 1, @wrap(v » 32) & 4294967295)
    a32_stpair(&em, 0, 1, a32_cello(r))

fn a32g_mov2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32_binprep(em : &mut Emit, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldpair(&em, 2, 3, a32_cello(ry))

fn a32g_add3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ADDS, 0, 0, 2)
    a32_dp(&em, A32_ADC, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_sub3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_SUBS, 0, 0, 2)
    a32_dp(&em, A32_SBC, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_and3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_AND, 0, 0, 2)
    a32_dp(&em, A32_AND, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_or3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ORR, 0, 0, 2)
    a32_dp(&em, A32_ORR, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_xor3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_EOR, 0, 0, 2)
    a32_dp(&em, A32_EOR, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_not2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    a32_dp(&em, A32_MVN, 0, 0, 0)
    a32_dp(&em, A32_MVN, 1, 0, 1)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_neg2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    em.aw(A32_RSBI + 1048576 + (0 « 16) + (0 « 12))  // rsbs r0, r0, #0
    em.aw(3806330880 + (1 « 16) + (1 « 12))          // rsc r1, r1, #0
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_mul3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    // umull r4, r5, r0, r2: RdLo=r4 at 12, RdHi=r5 at 16, Rm=r0, Rs=r2
    em.aw(A32_UMULL + (5 « 16) + (4 « 12) + (2 « 8) + 0)
    // mla r5, r0, r3, r5 and r5, r1, r2, r5
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (3 « 8) + 0)
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (2 « 8) + 1)
    a32_stpair(&em, 4, 5, a32_cello(rd))

// the pair shifts, branchless: a register shift reads its bottom
// byte, and 32 or more empties the word on its own
fn a32g_shl3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldsp(&em, 2, a32_cello(ry))
    em.aw(A32_RSBI + (2 « 16) + (4 « 12) + 32)       // rsb r4, r2, #32
    em.aw(A32_SUB + 33554432 + (2 « 16) + (6 « 12) + 32)  // sub r6, r2, #32
    a32_dps(&em, A32_MOVR, 1, 0, 1, 0, 2)            // lsl r1, r1, r2
    a32_dps(&em, A32_ORR, 1, 1, 0, 1, 4)             // orr r1, r1, r0 lsr r4
    a32_dps(&em, A32_ORR, 1, 1, 0, 0, 6)             // orr r1, r1, r0 lsl r6
    a32_dps(&em, A32_MOVR, 0, 0, 0, 0, 2)            // lsl r0, r0, r2
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_shr3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldsp(&em, 2, a32_cello(ry))
    em.aw(A32_RSBI + (2 « 16) + (4 « 12) + 32)
    em.aw(A32_SUB + 33554432 + (2 « 16) + (6 « 12) + 32)
    a32_dps(&em, A32_MOVR, 0, 0, 0, 1, 2)            // lsr r0, r0, r2
    a32_dps(&em, A32_ORR, 0, 0, 1, 0, 4)             // orr r0, r0, r1 lsl r4
    a32_dps(&em, A32_ORR, 0, 0, 1, 1, 6)             // orr r0, r0, r1 lsr r6
    a32_dps(&em, A32_MOVR, 1, 0, 1, 1, 2)            // lsr r1, r1, r2
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_sar3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldsp(&em, 2, a32_cello(ry))
    // the ≥32 case cannot ride the same trick -- an asr by little
    // still spreads -- so the tail is chosen by compare
    em.aw(A32_RSBI + (2 « 16) + (4 « 12) + 32)       // rsb r4, r2, #32
    a32_dps(&em, A32_MOVR, 0, 0, 0, 1, 2)            // lsr r0, r0, r2
    a32_dps(&em, A32_ORR, 0, 0, 1, 0, 4)             // orr r0, r0, r1 lsl r4
    em.aw(A32_CMP0 + (2 « 16) + 32)                  // cmp r2, #32
    em.aw(A32_SUB + 33554432 + (2 « 16) + (6 « 12) + 32)  // sub r6, r2, #32
    // r0 ← r1 asr r6 where the count reached the high word, and the
    // high word spreads its sign either way after
    em.aw(((A32_MOVR & 268435455) + (A32_CS « 28)) + (0 « 12) + (6 « 8) + (2 « 5) + 16 + 1)
    a32_dps(&em, A32_MOVR, 1, 0, 1, 2, 2)            // asr r1, r1, r2
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_cmp3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64):
    a32_binprep(&em, rx, ry)
    if cond = CC_EQ or cond = CC_NE:
        a32_dp(&em, A32_EOR, 0, 0, 2)
        a32_dp(&em, A32_EOR, 1, 1, 3)
        a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)      // orrs r0, r0, r1
        a32_zero9(&em, 0)
        a32_movc1(&em, A32_EQ if cond = CC_EQ else A32_NE, 0)
    else:
        // subs/sbcs leave the whole comparison in the flags; GT and LE
        // ask the mirrored question
        let flip : bool = cond = CC_GT or cond = CC_LE
        let xl : i64 = 2 if flip else 0
        let xh : i64 = 3 if flip else 1
        let yl : i64 = 0 if flip else 2
        let yh : i64 = 1 if flip else 3
        a32_dp(&em, A32_SUBS, 4, xl, yl)
        a32_dp(&em, A32_SBCS, 4, xh, yh)
        let base : i64 = A32_LT if sgn = 1 else A32_CC
        let inv : i64 = A32_GE if sgn = 1 else A32_CS
        a32_zero9(&em, 0)
        a32_movc1(&em, inv if cond = CC_GE or cond = CC_LE else base, 0)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32_zero9(em : &mut Emit, rd : i64):
    em.aw(A32_MOV0 + (rd « 12))

fn a32_movc1(em : &mut Emit, cond : i64, rd : i64):
    em.aw((cond « 28) + A32_MOVC1 + (rd « 12))

fn a32g_sel4(em : &mut Emit, tg : Target, rd : i64, rc : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rc))
    a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)          // orrs
    // both loads are conditional, so nothing branches
    a32_ldpair(&em, 2, 3, a32_cello(rx))
    a32_ldpair(&em, 4, 5, a32_cello(ry))
    em.aw((A32_NE « 28) + (A32_MOVR & 268435455) + (0 « 12) + 2)   // movne r0, r2
    em.aw((A32_NE « 28) + (A32_MOVR & 268435455) + (1 « 12) + 3)
    em.aw((A32_EQ « 28) + (A32_MOVR & 268435455) + (0 « 12) + 4)   // moveq r0, r4
    em.aw((A32_EQ « 28) + (A32_MOVR & 268435455) + (1 « 12) + 5)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_div3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    a32_helper2(&em, rd, rx, ry, RT_DIVS64 if sgn = 1 else RT_DIVU64)

fn a32g_mod3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    a32_helper2(&em, rd, rx, ry, RT_MODS64 if sgn = 1 else RT_MODU64)

fn a32_helper2(em : &mut Emit, rd : i64, rx : i64, ry : i64, target : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_stpair(&em, 0, 1, 0)
    a32_ldpair(&em, 0, 1, a32_cello(ry))
    a32_stpair(&em, 0, 1, 8)
    a32_call(&em, target)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_addov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ADDS, 0, 0, 2)
    a32_dp(&em, A32_ADC + 1048576, 1, 1, 3)          // adcs
    a32_zero9(&em, 4)
    a32_movc1(&em, A32_VS if sgn = 1 else A32_CS, 4)
    a32_zero9(&em, 5)
    a32_stpair(&em, 0, 1, a32_cello(rd))
    a32_stpair(&em, 4, 5, a32_cello(rf))

fn a32g_subov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_SUBS, 0, 0, 2)
    a32_dp(&em, A32_SBCS, 1, 1, 3)
    a32_zero9(&em, 4)
    a32_movc1(&em, A32_VS if sgn = 1 else A32_CC, 4)
    a32_zero9(&em, 5)
    a32_stpair(&em, 0, 1, a32_cello(rd))
    a32_stpair(&em, 4, 5, a32_cello(rf))

fn a32g_mulov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    // as on i386: stage, park the product, ask the helper, then land
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_stpair(&em, 0, 1, 0)
    a32_ldpair(&em, 0, 1, a32_cello(ry))
    a32_stpair(&em, 0, 1, 8)
    a32_movimm(&em, 0, sgn)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, 16)
    a32_binprep(&em, rx, ry)
    em.aw(A32_UMULL + (5 « 16) + (4 « 12) + (2 « 8) + 0)
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (3 « 8) + 0)
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (2 « 8) + 1)
    a32_stpair(&em, 4, 5, 24)
    a32_call(&em, RT_MULOV64)
    a32_stpair(&em, 0, 1, a32_cello(rf))
    a32_ldpair(&em, 0, 1, 24)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_ext2(em : &mut Emit, tg : Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    a32_ldpair(&em, 0, 1, a32_cello(r))
    if bits < 32:
        let sh : i64 = 32 - bits
        em.aw(A32_MOVR + (0 « 12) + (sh « 7) + 0)            // lsl r0, r0, #sh
        em.aw(A32_MOVR + (0 « 12) + (sh « 7) + ((2 if sgn = 1 else 1) « 5) + 0)
    if sgn = 1:
        em.aw(A32_MOVR + (1 « 12) + (31 « 7) + (2 « 5) + 0)  // asr r1, r0, #31
    else:
        a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(r))

fn a32g_ldo(em : &mut Emit, tg : Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    a32_ldsp(&em, 2, a32_cello(rbase))
    if off ≠ 0:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 2, 2, 12)
    if wd = 8:
        em.aw(A32_LDRR + (2 « 16) + (0 « 12))
        em.aw(A32_LDRR + (2 « 16) + (1 « 12) + 4)
    else:
        if wd = 4:
            em.aw(A32_LDRR + (2 « 16) + (0 « 12))
        elif wd = 2:
            em.aw((A32_LDRH + 64 if sgn = 1 else A32_LDRH) + (2 « 16) + (0 « 12))
        else:
            if sgn = 1:
                em.aw(A32_LDRH + 32 + (2 « 16) + (0 « 12))   // ldrsb
            else:
                em.aw(A32_LDRB + (2 « 16) + (0 « 12))
        if sgn = 1:
            em.aw(A32_MOVR + (1 « 12) + (31 « 7) + (2 « 5) + 0)
        else:
            a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32g_sto(em : &mut Emit, tg : Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    a32_ldsp(&em, 2, a32_cello(rbase))
    if off ≠ 0:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 2, 2, 12)
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    if wd = 8:
        em.aw(A32_STRR + (2 « 16) + (0 « 12))
        em.aw(A32_STRR + (2 « 16) + (1 « 12) + 4)
    elif wd = 4:
        em.aw(A32_STRR + (2 « 16) + (0 « 12))
    elif wd = 2:
        em.aw(A32_STRH + (2 « 16) + (0 « 12))
    else:
        em.aw(A32_STRB + (2 « 16) + (0 « 12))

let A32F_B24 : i64 = 24

fn a32g_jmp(em : &mut Emit, tg : Target, lab : i64):
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw(A32_B)

fn a32g_jz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw((A32_EQ « 28) + (A32_B & 268435455))

fn a32g_jnz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw((A32_NE « 28) + (A32_B & 268435455))

fn a32g_label(em : &mut Emit, tg : Target, lab : i64):
    em.set_label(lab)

fn a32_call(em : &mut Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here())
    em.cf_target.push(target)
    em.aw(A32_BL)

fn a32g_call(em : &mut Emit, tg : Target, target : i64):
    a32_call(&em, target)

fn a32g_calli(em : &mut Emit, tg : Target, r : i64):
    a32_ldsp(&em, 4, a32_cello(r))
    em.aw(A32_BLXR + 4)

fn a32g_ijmp(em : &mut Emit, tg : Target, r : i64):
    a32_ldsp(&em, 4, a32_cello(r))
    em.aw(A32_BLXR - 16 + 4)                         // bx r4

fn a32g_argld(em : &mut Emit, tg : Target, k : i64, slot : i64):
    a32_ldpair(&em, 0, 1, a32_sloto(slot))
    a32_stpair(&em, 0, 1, 8 × k)

fn a32g_argconst(em : &mut Emit, tg : Target, k : i64, v : i64):
    a32_movimm(&em, 0, v & 4294967295)
    a32_movimm(&em, 1, @wrap(v » 32) & 4294967295)
    a32_stpair(&em, 0, 1, 8 × k)

fn a32g_argmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_stpair(&em, 0, 1, 8 × k)

fn a32g_retst(em : &mut Emit, tg : Target, slot : i64):
    a32_stpair(&em, 0, 1, a32_sloto(slot))

fn a32g_retld(em : &mut Emit, tg : Target, slot : i64):
    a32_ldpair(&em, 0, 1, a32_sloto(slot))

fn a32g_retmov(em : &mut Emit, tg : Target, r : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))

fn a32g_absref(em : &mut Emit, tg : Target, r : i64) → i64:
    let pos : i64 = em.here()
    a32_movw(&em, 0, 0)
    a32_movt(&em, 0, 0)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(r))
    pos

fn a32g_absref_arg(em : &mut Emit, tg : Target, k : i64) → i64:
    let pos : i64 = em.here()
    a32_movw(&em, 0, 0)
    a32_movt(&em, 0, 0)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, 8 × k)
    pos

fn a32g_sysarg(em : &mut Emit, tg : Target, k : i64, slot : i64):
    // the low words parked below the outgoing area's own use
    a32_ldsp(&em, 0, a32_sloto(slot))
    a32_stsp(&em, 0, 104 + 4 × k)

fn a32g_sysimm(em : &mut Emit, tg : Target, k : i64, v : i64):
    a32_movimm(&em, 0, v & 4294967295)
    a32_stsp(&em, 0, 104 + 4 × k)

fn a32g_sysmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    a32_ldsp(&em, 0, a32_cello(r))
    a32_stsp(&em, 0, 104 + 4 × k)

fn a32g_syscall(em : &mut Emit, tg : Target, scid : i64):
    a32_ldsp(&em, 0, 104)
    a32_ldsp(&em, 1, 108)
    a32_ldsp(&em, 2, 112)
    a32_ldsp(&em, 3, 116)
    a32_ldsp(&em, 4, 120)
    a32_ldsp(&em, 5, 124)
    a32_movimm(&em, 7, sc_number(tg, scid))
    em.aw(A32_SVC)
    // only the errno band is negative
    a32_zero9(&em, 1)
    a32_movimm(&em, 12, 4294963200)
    a32_dp(&em, A32_CMP, 0, 0, 12)
    em.aw((A32_CS « 28) + (A32_MVN & 268435455) + (1 « 12) + 1)  // mvnhs r1, r1
    _ ← scid

fn a32g_sysret(em : &mut Emit, tg : Target, r : i64):
    a32_stpair(&em, 0, 1, a32_cello(r))

fn a32g_prologue(em : &mut Emit, tg : Target, nvregs : i64, np : i64):
    let frame : i64 = 160 + 8 × nvregs
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.aw(A32_PUSHFL)                                // push {r11, lr}
    a32_dp(&em, A32_MOVR, 11, 0, 13)                 // mov r11, sp
    a32_movimm(&em, 12, frame)
    a32_dp(&em, A32_SUB, 13, 13, 12)                 // sub sp, sp, ip
    let j : mut i64 = 0
    while j < np:
        // every argument arrived on the stack, above the saved pair
        em.aw(A32_LDRR + (11 « 16) + (0 « 12) + (8 + 8 × j))
        em.aw(A32_LDRR + (11 « 16) + (1 « 12) + (12 + 8 × j))
        a32_stpair(&em, 0, 1, a32_sloto(j))
        j ← j + 1

fn a32g_epilogue(em : &mut Emit, tg : Target):
    a32_dp(&em, A32_MOVR, 13, 0, 11)                 // mov sp, r11
    em.aw(A32_POPFL)
    em.aw(A32_BXLR)

fn a32g_resolve(em : &mut Emit, tg : Target):
    if #em.tf_pos > 0:
        foreach i := 0…#em.tf_pos - 1:
            let pos : i64 = em.tf_pos[i]
            let delta : i64 = em.labels[em.tf_lab[i] × 1¤ptrdiff] - pos
            em.patch32(pos, code_word(&em, pos) + (((delta - 8) » 2) & 16777215))
    while #em.tf_pos > 0:
        _ ← em.tf_pos.pop() ?? 0
        _ ← em.tf_lab.pop() ?? 0
        _ ← em.tf_form.pop() ?? 0

fn a32g_patch_abs(em : &mut Emit, tg : Target, pos : i64, v : i64):
    let w0 : i64 = code_word(&em, pos)
    em.patch32(pos, w0 + (((v » 12) & 15) « 16) + (v & 4095))
    let w1 : i64 = code_word(&em, pos + 4)
    em.patch32(pos + 4, w1 + (((v » 28) & 15) « 16) + ((v » 16) & 4095))

fn a32g_patch_call(em : &mut Emit, tg : Target, pos : i64, dest : i64):
    em.patch32(pos, code_word(&em, pos) + (((dest - pos - 8) » 2) & 16777215))

fn a32g_shl3i(em : &mut Emit, tg : Target, rd : i64, rs : i64, imm : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    // lsl r1, r1, #imm; orr r1, r1, r0 lsr #(32-imm); lsl r0, r0, #imm
    em.aw(A32_MOVR + (1 « 12) + (imm « 7) + 1)
    em.aw(A32_ORR + (1 « 16) + (1 « 12) + ((32 - imm) « 7) + (1 « 5) + 0)
    em.aw(A32_MOVR + (0 « 12) + (imm « 7) + 0)
    a32_stpair(&em, 0, 1, a32_cello(rd))

// ---------------------------------------------------------------------------
// riscv32: the RV32IM pair layer
//
// The RV64 base encoders (rv_R, rv_I, rv_S) are width-blind, so RV32
// reuses them and works the 8-byte model in pairs: a0:a1 hold x, a2:a3
// hold y, t0…t2 scratch, everything at rest at [sp,#128…].  Carry and
// the high half of a product are what sltu and mulhu give, which is
// exactly the pair math a 32-bit machine needs.
// ---------------------------------------------------------------------------

fn r32_cello(r : i64) → i64:
    128 + 8 × r

fn r32_sloto(slot : i64) → i64:
    160 + 8 × slot

fn r32_ld(em : &mut Emit, rd : i64, off : i64):
    let base : i64 = rv_slotaddr(&em, off)
    let zero : i64 = 0
    rv_I(&em, off if base = 2 else zero, base, 2, rd, 3)   // lw
fn r32_st(em : &mut Emit, rs : i64, off : i64):
    let base : i64 = rv_slotaddr(&em, off)
    let zero : i64 = 0
    rv_S(&em, off if base = 2 else zero, rs, base, 2)      // sw
fn r32_ldpair(em : &mut Emit, lo : i64, hi : i64, off : i64):
    r32_ld(&em, lo, off)
    r32_ld(&em, hi, off + 4)
fn r32_stpair(em : &mut Emit, lo : i64, hi : i64, off : i64):
    r32_st(&em, lo, off)
    r32_st(&em, hi, off + 4)

fn r32_movimm(em : &mut Emit, rd : i64, v : i64):
    let w : i64 = v & 4294967295
    if w >= 2147483648:
        rv_movimm(&em, rd, w - 4294967296)
    else:
        rv_movimm(&em, rd, w)

fn r32g_lds(em : &mut Emit, tg : Target, r : i64, slot : i64):
    r32_ldpair(&em, 10, 11, r32_sloto(slot))
    r32_stpair(&em, 10, 11, r32_cello(r))
fn r32g_sts(em : &mut Emit, tg : Target, r : i64, slot : i64):
    r32_ldpair(&em, 10, 11, r32_cello(r))
    r32_stpair(&em, 10, 11, r32_sloto(slot))
fn r32g_const(em : &mut Emit, tg : Target, r : i64, v : i64):
    r32_movimm(&em, 10, v & 4294967295)
    r32_movimm(&em, 11, @wrap(v » 32) & 4294967295)
    r32_stpair(&em, 10, 11, r32_cello(r))
fn r32g_mov2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rs))
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32_binprep(em : &mut Emit, rx : i64, ry : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rx))
    r32_ldpair(&em, 12, 13, r32_cello(ry))

fn r32g_add3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_binprep(&em, rx, ry)
    rv_R(&em, 0, 12, 10, 0, 10, 51)             // add a0, a0, a2
    rv_R(&em, 0, 12, 10, 3, 5, 51)              // sltu t0, a0, a2: carry
    rv_R(&em, 0, 13, 11, 0, 11, 51)             // add a1, a1, a3
    rv_R(&em, 0, 5, 11, 0, 11, 51)              // add a1, a1, t0
    r32_stpair(&em, 10, 11, r32_cello(rd))
fn r32g_sub3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_binprep(&em, rx, ry)
    rv_R(&em, 0, 12, 10, 3, 5, 51)              // sltu t0, a0, a2: borrow
    rv_R(&em, 32, 12, 10, 0, 10, 51)            // sub a0, a0, a2
    rv_R(&em, 32, 13, 11, 0, 11, 51)            // sub a1, a1, a3
    rv_R(&em, 32, 5, 11, 0, 11, 51)             // sub a1, a1, t0
    r32_stpair(&em, 10, 11, r32_cello(rd))
fn r32_bitwise(em : &mut Emit, rd : i64, rx : i64, ry : i64, f3 : i64):
    r32_binprep(&em, rx, ry)
    rv_R(&em, 0, 12, 10, f3, 10, 51)
    rv_R(&em, 0, 13, 11, f3, 11, 51)
    r32_stpair(&em, 10, 11, r32_cello(rd))
fn r32g_and3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_bitwise(&em, rd, rx, ry, 7)
fn r32g_or3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_bitwise(&em, rd, rx, ry, 6)
fn r32g_xor3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_bitwise(&em, rd, rx, ry, 4)
fn r32g_not2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rs))
    rv_I(&em, ⁻1, 10, 4, 10, 19)
    rv_I(&em, ⁻1, 11, 4, 11, 19)
    r32_stpair(&em, 10, 11, r32_cello(rd))
fn r32g_neg2(em : &mut Emit, tg : Target, rd : i64, rs : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rs))
    rv_R(&em, 0, 10, 0, 3, 5, 51)               // sltu t0, x0, a0: borrow if lo≠0
    rv_R(&em, 32, 10, 0, 0, 10, 51)             // sub a0, x0, a0
    rv_R(&em, 32, 11, 0, 0, 11, 51)             // sub a1, x0, a1
    rv_R(&em, 32, 5, 11, 0, 11, 51)             // sub a1, a1, t0
    r32_stpair(&em, 10, 11, r32_cello(rd))
fn r32g_mul3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_binprep(&em, rx, ry)
    rv_R(&em, 1, 12, 10, 3, 5, 51)              // mulhu t0, a0, a2
    rv_R(&em, 1, 13, 10, 0, 6, 51)              // mul t1, a0, a3
    rv_R(&em, 1, 12, 11, 0, 7, 51)              // mul t2, a1, a2
    rv_R(&em, 1, 12, 10, 0, 10, 51)             // mul a0, a0, a2 (low, last)
    rv_R(&em, 0, 6, 5, 0, 5, 51)                // t0 += t1
    rv_R(&em, 0, 7, 5, 0, 11, 51)               // a1 = t0 + t2
    r32_stpair(&em, 10, 11, r32_cello(rd))

// the pair shift by a variable count.  RISC-V masks a shift count to
// five bits, so the natural cross term lo>>(32-c) misbehaves at c=0;
// (lo>>(31-c))>>1 is the same value for c in 1..31 and folds to zero
// at c=0, which is what the near case needs.  The far case (c≥32) is
// chosen by a mask, so nothing branches.
fn r32g_shl3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_shift(&em, rd, rx, ry, 0)
fn r32g_shr3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_shift(&em, rd, rx, ry, 1)
fn r32g_sar3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64):
    r32_shift(&em, rd, rx, ry, 2)

// registers: a0:a1 = x, t0 = c, t1 = c&31, t2 = 31-(c&31), t3 = near
fn r32_shift(em : &mut Emit, rd : i64, rx : i64, ry : i64, kind : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rx))
    r32_ld(&em, 5, r32_cello(ry))               // t0 = count
    rv_I(&em, 31, 5, 7, 6, 19)                   // t1 = c & 31
    rv_I(&em, 31, 6, 4, 7, 19)                   // t2 = 31 ^ (c&31) = 31 - (c&31)
    rv_I(&em, 32, 5, 3, 28, 19)                  // t3 = (c <u 32) : near
    if kind = 0:
        // hn = (hi<<c1) | ((lo>>t2)>>1);  hf = lo<<c1
        rv_R(&em, 0, 6, 11, 1, 29, 51)          // t4 = hi << c1
        rv_R(&em, 0, 7, 10, 5, 30, 51)          // t5 = lo >> t2
        rv_I(&em, 1, 30, 5, 30, 19)             // t5 >>= 1
        rv_R(&em, 0, 30, 29, 6, 29, 51)         // t4 = t4 | t5  (near hi)
        rv_R(&em, 0, 6, 10, 1, 30, 51)          // t5 = lo << c1 (far hi = near lo)
        // hi = near ? t4 : t5
        r32_pick(&em, 28, 29, 30, 11)
        // lo = near ? (lo<<c1) : 0
        rv_R(&em, 0, 6, 10, 1, 29, 51)          // t4 = lo << c1
        rv_movimm(&em, 30, 0)
        r32_pick(&em, 28, 29, 30, 10)
    elif kind = 1:
        // ln = (lo>>c1) | ((hi<<t2)<<1);  lf = hi>>c1;  hn = hi>>c1; hf = 0
        rv_R(&em, 0, 6, 10, 5, 29, 51)          // t4 = lo >> c1
        rv_R(&em, 0, 7, 11, 1, 30, 51)          // t5 = hi << t2
        rv_I(&em, 1, 30, 1, 30, 19)             // t5 <<= 1
        rv_R(&em, 0, 30, 29, 6, 29, 51)         // t4 = near lo
        rv_R(&em, 0, 6, 11, 5, 30, 51)          // t5 = hi >> c1 (far lo)
        r32_pick(&em, 28, 29, 30, 10)
        rv_R(&em, 0, 6, 11, 5, 29, 51)          // t4 = hi >> c1 (near hi)
        rv_movimm(&em, 30, 0)                   // far hi = 0
        r32_pick(&em, 28, 29, 30, 11)
    else:
        // arithmetic: lo like logical; hi near = hi>>a c1, far = hi>>a31
        rv_R(&em, 0, 6, 10, 5, 29, 51)          // t4 = lo >> c1
        rv_R(&em, 0, 7, 11, 1, 30, 51)          // t5 = hi << t2
        rv_I(&em, 1, 30, 1, 30, 19)
        rv_R(&em, 0, 30, 29, 6, 29, 51)         // near lo
        rv_R(&em, 32, 6, 11, 5, 30, 51)         // t5 = hi >>a c1 (far lo)
        r32_pick(&em, 28, 29, 30, 10)
        rv_R(&em, 32, 6, 11, 5, 29, 51)         // t4 = hi >>a c1 (near hi)
        rv_movimm(&em, 6, 31)
        rv_R(&em, 32, 6, 11, 5, 30, 51)         // t5 = hi >>a 31 (far hi)
        r32_pick(&em, 28, 29, 30, 11)
    r32_stpair(&em, 10, 11, r32_cello(rd))

// rd ← cond ? ra : rb, cond a 0/1 in a register; ra and rb are
// clobbered, so a caller passes scratch
fn r32_pick(em : &mut Emit, cond : i64, ra : i64, rb : i64, rd : i64):
    rv_R(&em, 32, cond, 0, 0, 31, 51)           // t6 = -cond (mask)
    rv_R(&em, 0, 31, ra, 7, ra, 51)             // ra &= mask
    rv_I(&em, ⁻1, 31, 4, 31, 19)                // ~mask
    rv_R(&em, 0, 31, rb, 7, rb, 51)             // rb &= ~mask
    rv_R(&em, 0, rb, ra, 6, rd, 51)             // rd = ra | rb

// rd ← cond ? ra : rb, cond a 0/1 already in a register
fn r32g_shl3i(em : &mut Emit, tg : Target, rd : i64, rs : i64, imm : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rs))
    rv_I(&em, imm, 11, 1, 11, 19)               // slli a1, a1, imm
    rv_I(&em, 32 - imm, 10, 5, 5, 19)           // srli t0, a0, 32-imm
    rv_R(&em, 0, 5, 11, 6, 11, 51)              // or a1, a1, t0
    rv_I(&em, imm, 10, 1, 10, 19)               // slli a0, a0, imm
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32g_cmp3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64):
    r32_binprep(&em, rx, ry)
    if cond = CC_EQ or cond = CC_NE:
        rv_R(&em, 0, 12, 10, 4, 5, 51)          // xor t0, lo, lo'
        rv_R(&em, 0, 13, 11, 4, 6, 51)          // xor t1, hi, hi'
        rv_R(&em, 0, 6, 5, 6, 5, 51)            // or t0, t0, t1
        if cond = CC_EQ:
            rv_I(&em, 1, 5, 3, 10, 19)          // sltiu a0, t0, 1
        else:
            rv_R(&em, 0, 5, 0, 3, 10, 51)       // sltu a0, x0, t0
        r32_finish(&em, rd)
        return
    // the high halves decide unless equal; a signed test on the top,
    // an unsigned on the bottom
    let flip : bool = cond = CC_GT or cond = CC_LE
    let xl : i64 = 12 if flip else 10
    let xh : i64 = 13 if flip else 11
    let yl : i64 = 10 if flip else 12
    let yh : i64 = 11 if flip else 13
    let hf3 : i64 = 2 if sgn = 1 else 3
    rv_R(&em, 0, yh, xh, hf3, 5, 51)            // t0 = hi < hi'
    rv_R(&em, 0, xh, yh, hf3, 6, 51)            // t1 = hi > hi'
    rv_R(&em, 0, yl, xl, 3, 7, 51)              // t2 = lo <u lo'
    // if hi==hi' use t2, else t0.  eq = 1 - t0 - t1
    rv_R(&em, 0, 6, 5, 6, RV_S0, 51)            // t4 = t0|t1: hi differ
    rv_R(&em, 0, RV_S0, 0, 3, RV_S1, 51)        // t5 = (t4≠0)
    // res = t4 ? t0 : t2
    rv_R(&em, 32, RV_S1, 0, 0, RV_S2, 51)       // mask = -t5
    rv_R(&em, 0, RV_S2, 5, 7, 5, 51)            // t0 &= mask
    rv_I(&em, ⁻1, RV_S2, 4, RV_S2, 19)
    rv_R(&em, 0, RV_S2, 7, 7, 7, 51)            // t2 &= ~mask
    rv_R(&em, 0, 7, 5, 6, 10, 51)               // a0 = t0 | t2
    if cond = CC_GE or cond = CC_LE:
        rv_I(&em, 1, 10, 4, 10, 19)             // xori a0, a0, 1
    r32_finish(&em, rd)

fn r32_finish(em : &mut Emit, rd : i64):
    rv_movimm(&em, 11, 0)
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32g_sel4(em : &mut Emit, tg : Target, rd : i64, rc : i64, rx : i64, ry : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rc))
    rv_R(&em, 0, 11, 10, 6, 5, 51)              // t0 = lo | hi
    rv_R(&em, 0, 5, 0, 3, 5, 51)                // t0 = (t0≠0)
    rv_R(&em, 32, 5, 0, 0, 5, 51)               // t0 = -t0: mask
    r32_ldpair(&em, 12, 13, r32_cello(rx))
    r32_ldpair(&em, 6, 7, r32_cello(ry))        // t1:t2 = ry
    rv_R(&em, 0, 5, 12, 7, 12, 51)              // rx &= mask
    rv_R(&em, 0, 5, 13, 7, 13, 51)
    rv_I(&em, ⁻1, 5, 4, 5, 19)                  // ~mask
    rv_R(&em, 0, 5, 6, 7, 6, 51)                // ry &= ~mask
    rv_R(&em, 0, 5, 7, 7, 7, 51)
    rv_R(&em, 0, 6, 12, 6, 10, 51)              // a0 = rxlo | rylo
    rv_R(&em, 0, 7, 13, 6, 11, 51)
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32g_div3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    r32_helper2(&em, rd, rx, ry, RT_DIVS64 if sgn = 1 else RT_DIVU64)
fn r32g_mod3(em : &mut Emit, tg : Target, rd : i64, rx : i64, ry : i64, sgn : i64):
    r32_helper2(&em, rd, rx, ry, RT_MODS64 if sgn = 1 else RT_MODU64)
fn r32_helper2(em : &mut Emit, rd : i64, rx : i64, ry : i64, target : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rx))
    r32_stpair(&em, 10, 11, 0)
    r32_ldpair(&em, 10, 11, r32_cello(ry))
    r32_stpair(&em, 10, 11, 8)
    r32_call(&em, target)
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32g_addov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    r32_ovhelper(&em, rd, rf, rx, ry, sgn, 0)
fn r32g_subov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    r32_ovhelper(&em, rd, rf, rx, ry, sgn, 1)
fn r32_ovhelper(em : &mut Emit, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, issub : i64):
    // do the 64-bit op in pairs, then read overflow from the operands
    r32_binprep(&em, rx, ry)
    if issub = 0:
        rv_R(&em, 0, 12, 10, 0, RV_S0, 51)      // t4 = lo + lo'
        rv_R(&em, 0, 12, RV_S0, 3, 5, 51)       // carry
        rv_R(&em, 0, 13, 11, 0, RV_S1, 51)      // t5 = hi + hi'
        rv_R(&em, 0, 5, RV_S1, 0, RV_S1, 51)    // + carry
    else:
        rv_R(&em, 0, 12, 10, 3, 5, 51)          // borrow
        rv_R(&em, 32, 12, 10, 0, RV_S0, 51)
        rv_R(&em, 32, 13, 11, 0, RV_S1, 51)
        rv_R(&em, 32, 5, RV_S1, 0, RV_S1, 51)
    if sgn = 1:
        // overflow if (x^y sign matches op) and (x^res sign differs) —
        // for add: ~(xh^yh) & (xh^resh); for sub: (xh^yh) & (xh^resh)
        rv_R(&em, 0, 13, 11, 4, 6, 51)          // t1 = xh ^ yh
        if issub = 0:
            rv_I(&em, ⁻1, 6, 4, 6, 19)
        rv_R(&em, 0, RV_S1, 11, 4, 7, 51)       // t2 = xh ^ resh
        rv_R(&em, 0, 7, 6, 7, 6, 51)            // and
        rv_I(&em, 31, 6, 5, 10, 19)             // srli a0, t1, 31
    else:
        if issub = 0:
            rv_R(&em, 0, 11, RV_S1, 3, 10, 51)  // sltu a0, resh, xh: the sum wrapped below x
        else:
            // a 64-bit borrow leaves the high result above the minuend
            rv_R(&em, 0, RV_S1, 11, 3, 10, 51)  // sltu a0, xh, resh
    rv_movimm(&em, 11, 0)
    r32_stpair(&em, RV_S0, RV_S1, r32_cello(rd))
    r32_stpair(&em, 10, 11, r32_cello(rf))

fn r32g_mulov(em : &mut Emit, tg : Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64):
    r32_ldpair(&em, 10, 11, r32_cello(rx))
    r32_stpair(&em, 10, 11, 0)
    r32_ldpair(&em, 10, 11, r32_cello(ry))
    r32_stpair(&em, 10, 11, 8)
    r32_movimm(&em, 10, sgn)
    rv_movimm(&em, 11, 0)
    r32_stpair(&em, 10, 11, 16)
    // the wrapped product parked at 24
    r32g_mul3(&em, tg, rd, rx, ry)
    r32_ldpair(&em, 10, 11, r32_cello(rd))
    r32_stpair(&em, 10, 11, 24)
    r32_call(&em, RT_MULOV64)
    r32_stpair(&em, 10, 11, r32_cello(rf))
    r32_ldpair(&em, 10, 11, 24)
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32g_ext2(em : &mut Emit, tg : Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    r32_ldpair(&em, 10, 11, r32_cello(r))
    if bits < 32:
        let sh : i64 = 32 - bits
        rv_I(&em, sh, 10, 1, 10, 19)            // slli
        let ab : i64 = 1024 if sgn = 1 else 0
        rv_I(&em, sh + ab, 10, 5, 10, 19)
    if sgn = 1:
        rv_I(&em, 31 + 1024, 10, 5, 11, 19)     // srai a1, a0, 31
    else:
        rv_movimm(&em, 11, 0)
    r32_stpair(&em, 10, 11, r32_cello(r))

fn r32g_ldo(em : &mut Emit, tg : Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    r32_ld(&em, 12, r32_cello(rbase))
    if off ≠ 0:
        r32_movimm(&em, 5, off)
        rv_R(&em, 0, 5, 12, 0, 12, 51)
    if wd = 8:
        rv_I(&em, 0, 12, 2, 10, 3)
        rv_I(&em, 4, 12, 2, 11, 3)
    else:
        let f3 : i64 = 2 if wd = 4 else (1 if wd = 2 and sgn = 1 else (5 if wd = 2 else (0 if sgn = 1 else 4)))
        rv_I(&em, 0, 12, f3, 10, 3)
        if sgn = 1:
            rv_I(&em, 31 + 1024, 10, 5, 11, 19)
        else:
            rv_movimm(&em, 11, 0)
    r32_stpair(&em, 10, 11, r32_cello(rd))

fn r32g_sto(em : &mut Emit, tg : Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = tg.ptr if width = 0 else width
    r32_ld(&em, 12, r32_cello(rbase))
    if off ≠ 0:
        r32_movimm(&em, 5, off)
        rv_R(&em, 0, 5, 12, 0, 12, 51)
    r32_ldpair(&em, 10, 11, r32_cello(rs))
    if wd = 8:
        rv_S(&em, 0, 10, 12, 2)
        rv_S(&em, 4, 11, 12, 2)
    else:
        let f3 : i64 = 2 if wd = 4 else (1 if wd = 2 else 0)
        rv_S(&em, 0, 10, 12, f3)

fn r32g_jmp(em : &mut Emit, tg : Target, lab : i64):
    rvg_jmp(&em, tg, lab)
fn r32g_jz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    r32_ldpair(&em, 10, 11, r32_cello(r))
    rv_R(&em, 0, 11, 10, 6, 5, 51)              // t0 = lo | hi
    rv_bshort(&em, 1, 5, 0, 8)                  // bne t0, x0, +8
    rvg_jmp(&em, tg, lab)
fn r32g_jnz(em : &mut Emit, tg : Target, r : i64, lab : i64):
    r32_ldpair(&em, 10, 11, r32_cello(r))
    rv_R(&em, 0, 11, 10, 6, 5, 51)
    rv_bshort(&em, 0, 5, 0, 8)                  // beq t0, x0, +8
    rvg_jmp(&em, tg, lab)
fn r32g_label(em : &mut Emit, tg : Target, lab : i64):
    em.set_label(lab)

fn r32_call(em : &mut Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here())
    em.cf_target.push(target)
    em.aw((1 « 7) + 23)                         // auipc ra, 0
    rv_I(&em, 0, 1, 0, 1, 103)                  // jalr ra, ra, 0
fn r32g_call(em : &mut Emit, tg : Target, target : i64):
    r32_call(&em, target)
fn r32g_calli(em : &mut Emit, tg : Target, r : i64):
    r32_ld(&em, 5, r32_cello(r))
    rv_I(&em, 0, 5, 0, 1, 103)
fn r32g_ijmp(em : &mut Emit, tg : Target, r : i64):
    r32_ld(&em, 5, r32_cello(r))
    rv_I(&em, 0, 5, 0, 0, 103)

fn r32g_argld(em : &mut Emit, tg : Target, k : i64, slot : i64):
    r32_ldpair(&em, 10, 11, r32_sloto(slot))
    r32_stpair(&em, 10, 11, 8 × k)
fn r32g_argconst(em : &mut Emit, tg : Target, k : i64, v : i64):
    r32_movimm(&em, 10, v & 4294967295)
    r32_movimm(&em, 11, @wrap(v » 32) & 4294967295)
    r32_stpair(&em, 10, 11, 8 × k)
fn r32g_argmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    r32_ldpair(&em, 10, 11, r32_cello(r))
    r32_stpair(&em, 10, 11, 8 × k)
fn r32g_retst(em : &mut Emit, tg : Target, slot : i64):
    r32_stpair(&em, 10, 11, r32_sloto(slot))
fn r32g_retld(em : &mut Emit, tg : Target, slot : i64):
    r32_ldpair(&em, 10, 11, r32_sloto(slot))
fn r32g_retmov(em : &mut Emit, tg : Target, r : i64):
    r32_ldpair(&em, 10, 11, r32_cello(r))

fn r32g_absref(em : &mut Emit, tg : Target, r : i64) → i64:
    let pos : i64 = em.here()
    rv_U(&em, 0, 10, 55)                        // lui
    rv_I(&em, 0, 10, 0, 10, 19)                 // addi
    rv_movimm(&em, 11, 0)
    r32_stpair(&em, 10, 11, r32_cello(r))
    pos
fn r32g_absref_arg(em : &mut Emit, tg : Target, k : i64) → i64:
    let pos : i64 = em.here()
    rv_U(&em, 0, 10, 55)
    rv_I(&em, 0, 10, 0, 10, 19)
    rv_movimm(&em, 11, 0)
    r32_stpair(&em, 10, 11, 8 × k)
    pos

fn r32g_sysarg(em : &mut Emit, tg : Target, k : i64, slot : i64):
    r32_ld(&em, 10 + k, r32_sloto(slot))
fn r32g_sysimm(em : &mut Emit, tg : Target, k : i64, v : i64):
    r32_movimm(&em, 10 + k, v)
fn r32g_sysmov(em : &mut Emit, tg : Target, k : i64, r : i64):
    r32_ld(&em, 10 + k, r32_cello(r))
fn r32g_syscall(em : &mut Emit, tg : Target, scid : i64):
    r32_movimm(&em, 17, sc_number(tg, scid))
    em.aw(115)
    // sign-extend the 32-bit answer into the high half of the cell
    rv_I(&em, 31 + 1024, 10, 5, 11, 19)         // srai a1, a0, 31
fn r32g_sysret(em : &mut Emit, tg : Target, r : i64):
    r32_stpair(&em, 10, 11, r32_cello(r))

fn r32g_prologue(em : &mut Emit, tg : Target, nvregs : i64, np : i64):
    let frame : i64 = align_up(160 + 8 × nvregs, 16)
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    rv_I(&em, ⁻16, 2, 0, 2, 19)
    rv_S(&em, 8, 1, 2, 2)                        // sw ra, 8(sp)
    rv_S(&em, 4, 8, 2, 2)                        // sw s0, 4(sp)
    rv_I(&em, 0, 2, 0, 8, 19)                    // mv s0, sp
    if frame < 2048:
        rv_I(&em, 0 - frame, 2, 0, 2, 19)
    else:
        r32_movimm(&em, 5, frame)
        rv_R(&em, 32, 5, 2, 0, 2, 51)
    let j : mut i64 = 0
    while j < np:
        // the incoming pair sits above the save area, so it is read
        // through s0 (x8), which sp has moved away from
        rv_I(&em, 16 + 8 × j, 8, 2, 10, 3)      // lw a0, off(s0)
        rv_I(&em, 20 + 8 × j, 8, 2, 11, 3)
        r32_stpair(&em, 10, 11, r32_sloto(j))
        j ← j + 1
fn r32g_epilogue(em : &mut Emit, tg : Target):
    rv_I(&em, 0, 8, 0, 2, 19)                    // mv sp, s0
    rv_I(&em, 8, 2, 2, 1, 3)                     // lw ra, 8(sp)
    rv_I(&em, 4, 2, 2, 8, 3)                     // lw s0, 4(sp)
    rv_I(&em, 16, 2, 0, 2, 19)
    rv_I(&em, 0, 1, 0, 0, 103)

fn r32g_resolve(em : &mut Emit, tg : Target):
    rvg_resolve(&em, tg)
fn r32g_patch_abs(em : &mut Emit, tg : Target, pos : i64, v : i64):
    rvg_patch_abs(&em, tg, pos, v)
fn r32g_patch_call(em : &mut Emit, tg : Target, pos : i64, dest : i64):
    rvg_patch_call(&em, tg, pos, dest)

// ---------------------------------------------------------------------------
// The driver: every IR op composed from the abstract operations.
// Written once; a target that teaches the machine its spellings gets
// all of it.  The x86-64 emitter above stays as the measure the
// compositions are checked against.
// ---------------------------------------------------------------------------

// a value that must fit its width or leave for RT_OV, composed with
// scratch labels the caller hands out
fn t_range_check(em : &mut Emit, tg : Target, w : i64, lok : i64):
    let bits : i64 = w & 255
    let sgn : i64 = w » 8
    if sgn = 0:
        g_const(&em, tg, RG_B, (1 « bits) - 1)
        g_cmp3(&em, tg, RG_C, RG_A, RG_B, CC_LE, 0)
        g_jnz(&em, tg, RG_C, lok)
        g_call(&em, tg, RT_OV)
    else:
        g_mov2(&em, tg, RG_B, RG_A)
        g_ext2(&em, tg, RG_B, bits, 1)
        g_cmp3(&em, tg, RG_C, RG_A, RG_B, CC_EQ, 0)
        g_jnz(&em, tg, RG_C, lok)
        g_call(&em, tg, RT_OV)
    g_label(&em, tg, lok)

// the canonical form of a wrapped result
fn t_canon(em : &mut Emit, tg : Target, w : i64):
    let bits : i64 = w & 255
    if bits < 64:
        g_ext2(&em, tg, RG_A, bits, w » 8)

fn t_emit_fn(em : &mut Emit, tg : Target, ir : IrFn, np : i64, strs : str[]):
    assert(ir.nvregs >= np, "the frame covers the spilled arguments")
    let n : i64 = @dropunit(#ir.op)
    em.begin_fn(ir.nlabels + 6 × n + 8)
    let sl : mut i64 = ir.nlabels
    g_prologue(&em, tg, ir.nvregs, np)
    let i : mut i64 = 0
    while i < n:
        let o : i64 = ir.op[i × 1¤ptrdiff]
        let a : i64 = ir.ia[i × 1¤ptrdiff]
        let b : i64 = ir.ib[i × 1¤ptrdiff]
        let c : i64 = ir.ic[i × 1¤ptrdiff]
        let d : i64 = ir.id[i × 1¤ptrdiff]
        let w : i64 = ir.iw[i × 1¤ptrdiff]
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        if o = IR_CONST:
            g_const(&em, tg, RG_A, a)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_MOV:
            g_lds(&em, tg, RG_A, a)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_ADD or o = IR_ADDW or o = IR_SUB or o = IR_SUBW:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            if o = IR_ADD or o = IR_SUB:
                if bits = 64:
                    if o = IR_ADD:
                        g_addov(&em, tg, RG_A, RG_C, RG_A, RG_B, sgn)
                    else:
                        g_subov(&em, tg, RG_A, RG_C, RG_A, RG_B, sgn)
                    g_jz(&em, tg, RG_C, sl)
                    g_call(&em, tg, RT_OV)
                    g_label(&em, tg, sl)
                    sl ← sl + 1
                else:
                    if o = IR_ADD:
                        g_add3(&em, tg, RG_A, RG_A, RG_B)
                    else:
                        g_sub3(&em, tg, RG_A, RG_A, RG_B)
                    t_range_check(&em, tg, w, sl)
                    sl ← sl + 1
            else:
                if o = IR_ADDW:
                    g_add3(&em, tg, RG_A, RG_A, RG_B)
                else:
                    g_sub3(&em, tg, RG_A, RG_A, RG_B)
                t_canon(&em, tg, w)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_MUL or o = IR_MULW:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            if o = IR_MULW:
                g_mul3(&em, tg, RG_A, RG_A, RG_B)
                t_canon(&em, tg, w)
            elif bits = 64:
                g_mulov(&em, tg, RG_A, RG_C, RG_A, RG_B, sgn)
                g_jz(&em, tg, RG_C, sl)
                g_call(&em, tg, RT_OV)
                g_label(&em, tg, sl)
                sl ← sl + 1
            else:
                g_mul3(&em, tg, RG_A, RG_A, RG_B)
                t_range_check(&em, tg, w, sl)
                sl ← sl + 1
            g_sts(&em, tg, RG_A, d)
        elif o = IR_NEG or o = IR_NEGW:
            g_lds(&em, tg, RG_A, a)
            if o = IR_NEG and sgn = 1 and bits = 64:
                // the one signed value with no negation
                g_const(&em, tg, RG_B, ⁻9223372036854775807 - 1)
                g_cmp3(&em, tg, RG_C, RG_A, RG_B, CC_NE, 0)
                g_jnz(&em, tg, RG_C, sl)
                g_call(&em, tg, RT_OV)
                g_label(&em, tg, sl)
                sl ← sl + 1
                g_neg2(&em, tg, RG_A, RG_A)
            elif o = IR_NEG and sgn = 0:
                // a negated unsigned is only 0
                g_jz(&em, tg, RG_A, sl)
                g_call(&em, tg, RT_OV)
                g_label(&em, tg, sl)
                sl ← sl + 1
                g_neg2(&em, tg, RG_A, RG_A)
            else:
                g_neg2(&em, tg, RG_A, RG_A)
                if o = IR_NEG:
                    t_range_check(&em, tg, w, sl)
                    sl ← sl + 1
                else:
                    t_canon(&em, tg, w)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_BAND or o = IR_BORR or o = IR_BXORR:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            if o = IR_BAND:
                g_and3(&em, tg, RG_A, RG_A, RG_B)
            elif o = IR_BORR:
                g_or3(&em, tg, RG_A, RG_A, RG_B)
            else:
                g_xor3(&em, tg, RG_A, RG_A, RG_B)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_BNOTT:
            g_lds(&em, tg, RG_A, a)
            g_not2(&em, tg, RG_A, RG_A)
            t_canon(&em, tg, w)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_SHLL or o = IR_SHRR:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            g_const(&em, tg, RG_C, bits - sgn)
            g_cmp3(&em, tg, RG_C, RG_B, RG_C, CC_LT, 0)
            g_jnz(&em, tg, RG_C, sl)
            g_call(&em, tg, RT_SHIFT)
            g_label(&em, tg, sl)
            sl ← sl + 1
            if o = IR_SHLL:
                g_shl3(&em, tg, RG_A, RG_A, RG_B)
                t_canon(&em, tg, w)
            elif sgn = 1:
                g_sar3(&em, tg, RG_A, RG_A, RG_B)
            else:
                g_shr3(&em, tg, RG_A, RG_A, RG_B)
            g_sts(&em, tg, RG_A, d)
        elif o >= IR_CEQ and o <= IR_CGE:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            g_cmp3(&em, tg, RG_C, RG_A, RG_B, o - IR_CEQ, sgn)
            g_mov2(&em, tg, RG_A, RG_C)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_MAXX or o = IR_MINN:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            g_cmp3(&em, tg, RG_C, RG_A, RG_B, CC_GE if o = IR_MAXX else CC_LE, sgn)
            g_sel4(&em, tg, RG_A, RG_C, RG_A, RG_B)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_SEL:
            g_lds(&em, tg, RG_C, a)
            g_lds(&em, tg, RG_A, b)
            g_lds(&em, tg, RG_B, c)
            g_sel4(&em, tg, RG_A, RG_C, RG_A, RG_B)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_DIVV or o = IR_MODD:
            g_lds(&em, tg, RG_A, a)
            g_lds(&em, tg, RG_B, b)
            let ldo9 : i64 = sl
            let lend9 : i64 = sl + 1
            sl ← sl + 2
            g_jnz(&em, tg, RG_B, ldo9)
            g_lds(&em, tg, RG_A, c)
            g_jmp(&em, tg, lend9)
            g_label(&em, tg, ldo9)
            if sgn = 1 and bits = 64:
                g_const(&em, tg, RG_C, ⁻9223372036854775807 - 1)
                g_cmp3(&em, tg, RG_C, RG_A, RG_C, CC_NE, 0)
                g_jnz(&em, tg, RG_C, sl)
                g_const(&em, tg, RG_C, ⁻1)
                g_cmp3(&em, tg, RG_C, RG_B, RG_C, CC_NE, 0)
                g_jnz(&em, tg, RG_C, sl)
                g_call(&em, tg, RT_OV)
                g_label(&em, tg, sl)
                sl ← sl + 1
            if o = IR_DIVV:
                g_div3(&em, tg, RG_A, RG_A, RG_B, sgn)
            else:
                g_mod3(&em, tg, RG_A, RG_A, RG_B, sgn)
            if sgn = 1 and bits ≠ 64:
                t_range_check(&em, tg, w, sl)
                sl ← sl + 1
            g_label(&em, tg, lend9)
            g_sts(&em, tg, RG_A, d)
        elif o = IR_JMP:
            g_jmp(&em, tg, a)
        elif o = IR_JZ or o = IR_JNZ:
            g_lds(&em, tg, RG_A, a)
            if o = IR_JZ:
                g_jz(&em, tg, RG_A, b)
            else:
                g_jnz(&em, tg, RG_A, b)
        elif o = IR_LABEL:
            g_label(&em, tg, a)
        elif o = IR_CALL:
            let argc : i64 = ir.extra[b × 1¤ptrdiff]
            let k : mut i64 = 0
            while k < argc:
                g_argld(&em, tg, k, ir.extra[(b + 1 + k) × 1¤ptrdiff])
