            j ← j + 1
        self.set_type(id, ty_strip_ref(want) if ty_is_farr(ty_strip_ref(want)) else mk_aty(settled))

    fn check_slit(&mut self, id : i64, tok : i64, off : i64):
        let name := self.text(tok)
        let sidx : i64 = self.struct_index(name)
        if sidx = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ "' is not a struct this program defines")
            self.set_type(id, TY_I64)
            return
        let d := self.a.structs[sidx × 1¤ptrdiff]
        let nf : i64 = self.a.extra[d.fields_off × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let filled : mut i64[] = []
        let j : mut i64 = 0
        while j < nf:
            filled.push(0)
            j ← j + 1
        let i : mut i64 = 0
        while i < n:
            let ftok : i64 = self.a.extra[(off + 1 + i × 2) × 1¤ptrdiff]
            let e : i64 = self.a.extra[(off + 2 + i × 2) × 1¤ptrdiff]
            let (fidx, fty) := self.field_of(sidx, self.text(ftok))
