let arch_a64 := @import("arch_a64")
let elf := @import("elf")
let emit := @import("emit")

// ---------------------------------------------------------------------------
// arm (32-bit, EABI): the A32 instruction layer
//
// The same cell model as i386: pairs in (r0,r1) and (r2,r3), scratch
// r4…r6 and ip, everything at rest in memory at [sp,#128…].  What x86
// answers with setcc, ARM answers with a conditional mov; what x86
// branches for, a register-specified shift often absorbs, since a
// shift by 32 or more falls to zero on its own.  Arguments travel on
// the stack, eight bytes each.
// ---------------------------------------------------------------------------



let A32_LDRSP : i64 = 3852271616
let A32_STRSP : i64 = 3851223040
@export
let A32_LDRR : i64 = 3851419648
@export
let A32_STRR : i64 = 3850371072
let A32_LDRB : i64 = 3855613952
let A32_STRB : i64 = 3854565376
let A32_LDRH : i64 = 3788505264
let A32_STRH : i64 = 3787456688
@export
let A32_ADD : i64 = 3766484992
let A32_ADDS : i64 = 3767533568
let A32_ADC : i64 = 3768582144
@export
let A32_SUB : i64 = 3762290688
let A32_SUBS : i64 = 3763339264
let A32_SBC : i64 = 3770679296
let A32_SBCS : i64 = 3771727872
let A32_AND : i64 = 3758096384
let A32_ORR : i64 = 3783262208
let A32_EOR : i64 = 3760193536
let A32_MVN : i64 = 3789553664
@export
let A32_MOVR : i64 = 3785359360
@export
let A32_CMP : i64 = 3780116480
@export
let A32_CMP0 : i64 = 3813670912
let A32_MOV0 : i64 = 3818913792
let A32_MUL : i64 = 3758096528
let A32_UMULL : i64 = 3766485136
let A32_MLA : i64 = 3760193680
let A32_MOVW : i64 = 3808428032
let A32_MOVT : i64 = 3812622336
@export
let A32_B : i64 = 3925868544
let A32_BL : i64 = 3942645760
let A32_BLXR : i64 = 3778019120
let A32_BXLR : i64 = 3778019102
let A32_PUSHFL : i64 = 3912058880
let A32_POPFL : i64 = 3904718848
@export
let A32_SVC : i64 = 4009754624
let A32_RSBI : i64 = 3797942272
@export
let A32_ADDI : i64 = 3800039424
let A32_MOVC1 : i64 = 60817409

let A32_EQ : i64 = 0
@export
let A32_NE : i64 = 1
@export
let A32_CS : i64 = 2
let A32_CC : i64 = 3
let A32_VS : i64 = 6
let A32_HI : i64 = 8
let A32_LS : i64 = 9
let A32_GE : i64 = 10
let A32_LT : i64 = 11
let A32_GT : i64 = 12
let A32_LE : i64 = 13

fn a32_cello(r : i64) → i64:
    128 + 8 × r

fn a32_sloto(slot : i64) → i64:
    160 + 8 × slot

// a data op, rd ← rn op rm
@export
fn a32_dp(em : &mut emit.Emit, op : i64, rd : i64, rn : i64, rm : i64):
    em.aw(op + (rn « 16) + (rd « 12) + rm)

// rd ← rn op (rm shifted by register rs); type 0 lsl, 1 lsr, 2 asr
fn a32_dps(em : &mut emit.Emit, op : i64, rd : i64, rn : i64, rm : i64, ty : i64, rs : i64):
    em.aw(op + (rn « 16) + (rd « 12) + (rs « 8) + (ty « 5) + 16 + rm)

@export
fn a32_movw(em : &mut emit.Emit, rd : i64, v : i64):
    em.aw(A32_MOVW + (((v » 12) & 15) « 16) + (rd « 12) + (v & 4095))
@export
fn a32_movt(em : &mut emit.Emit, rd : i64, v : i64):
    em.aw(A32_MOVT + (((v » 28) & 15) « 16) + (rd « 12) + ((v » 16) & 4095))
@export
fn a32_movimm(em : &mut emit.Emit, rd : i64, v : i64):
    a32_movw(&em, rd, v & 65535)
    if ((v » 16) & 65535) ≠ 0:
        a32_movt(&em, rd, v & 4294967295)

fn a32_ldsp(em : &mut emit.Emit, rd : i64, off : i64):
    if off < 4096:
        em.aw(A32_LDRSP + (rd « 12) + off)
    else:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 12, 13, 12)
        em.aw(A32_LDRR + (12 « 16) + (rd « 12))
fn a32_stsp(em : &mut emit.Emit, rs : i64, off : i64):
    if off < 4096:
        em.aw(A32_STRSP + (rs « 12) + off)
    else:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 12, 13, 12)
        em.aw(A32_STRR + (12 « 16) + (rs « 12))

fn a32_ldpair(em : &mut emit.Emit, lo : i64, hi : i64, off : i64):
    a32_ldsp(&em, lo, off)
    a32_ldsp(&em, hi, off + 4)
fn a32_stpair(em : &mut emit.Emit, lo : i64, hi : i64, off : i64):
    a32_stsp(&em, lo, off)
    a32_stsp(&em, hi, off + 4)

@export
fn a32g_lds(em : &mut emit.Emit, tg : elf.Target, r : i64, slot : i64):
    a32_ldpair(&em, 0, 1, a32_sloto(slot))
    a32_stpair(&em, 0, 1, a32_cello(r))

@export
fn a32g_sts(em : &mut emit.Emit, tg : elf.Target, r : i64, slot : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_stpair(&em, 0, 1, a32_sloto(slot))

@export
fn a32g_const(em : &mut emit.Emit, tg : elf.Target, r : i64, v : i64):
    a32_movimm(&em, 0, v & 4294967295)
    a32_movimm(&em, 1, @wrap(v » 32) & 4294967295)
    a32_stpair(&em, 0, 1, a32_cello(r))

@export
fn a32g_mov2(em : &mut emit.Emit, tg : elf.Target, rd : i64, rs : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32_binprep(em : &mut emit.Emit, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldpair(&em, 2, 3, a32_cello(ry))

@export
fn a32g_add3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ADDS, 0, 0, 2)
    a32_dp(&em, A32_ADC, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_sub3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_SUBS, 0, 0, 2)
    a32_dp(&em, A32_SBC, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_and3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_AND, 0, 0, 2)
    a32_dp(&em, A32_AND, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_or3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ORR, 0, 0, 2)
    a32_dp(&em, A32_ORR, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_xor3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_EOR, 0, 0, 2)
    a32_dp(&em, A32_EOR, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_not2(em : &mut emit.Emit, tg : elf.Target, rd : i64, rs : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    a32_dp(&em, A32_MVN, 0, 0, 0)
    a32_dp(&em, A32_MVN, 1, 0, 1)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_neg2(em : &mut emit.Emit, tg : elf.Target, rd : i64, rs : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    em.aw(A32_RSBI + 1048576 + (0 « 16) + (0 « 12))  // rsbs r0, r0, #0
    em.aw(3806330880 + (1 « 16) + (1 « 12))          // rsc r1, r1, #0
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_mul3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_binprep(&em, rx, ry)
    // umull r4, r5, r0, r2: RdLo=r4 at 12, RdHi=r5 at 16, Rm=r0, Rs=r2
    em.aw(A32_UMULL + (5 « 16) + (4 « 12) + (2 « 8) + 0)
    // mla r5, r0, r3, r5 and r5, r1, r2, r5
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (3 « 8) + 0)
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (2 « 8) + 1)
    a32_stpair(&em, 4, 5, a32_cello(rd))

// the pair shifts, branchless: a register shift reads its bottom
// byte, and 32 or more empties the word on its own
@export
fn a32g_shl3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldsp(&em, 2, a32_cello(ry))
    em.aw(A32_RSBI + (2 « 16) + (4 « 12) + 32)       // rsb r4, r2, #32
    em.aw(A32_SUB + 33554432 + (2 « 16) + (6 « 12) + 32)  // sub r6, r2, #32
    a32_dps(&em, A32_MOVR, 1, 0, 1, 0, 2)            // lsl r1, r1, r2
    a32_dps(&em, A32_ORR, 1, 1, 0, 1, 4)             // orr r1, r1, r0 lsr r4
    a32_dps(&em, A32_ORR, 1, 1, 0, 0, 6)             // orr r1, r1, r0 lsl r6
    a32_dps(&em, A32_MOVR, 0, 0, 0, 0, 2)            // lsl r0, r0, r2
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_shr3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldsp(&em, 2, a32_cello(ry))
    em.aw(A32_RSBI + (2 « 16) + (4 « 12) + 32)
    em.aw(A32_SUB + 33554432 + (2 « 16) + (6 « 12) + 32)
    a32_dps(&em, A32_MOVR, 0, 0, 0, 1, 2)            // lsr r0, r0, r2
    a32_dps(&em, A32_ORR, 0, 0, 1, 0, 4)             // orr r0, r0, r1 lsl r4
    a32_dps(&em, A32_ORR, 0, 0, 1, 1, 6)             // orr r0, r0, r1 lsr r6
    a32_dps(&em, A32_MOVR, 1, 0, 1, 1, 2)            // lsr r1, r1, r2
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_sar3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_ldsp(&em, 2, a32_cello(ry))
    // the ≥32 case cannot ride the same trick -- an asr by little
    // still spreads -- so the tail is chosen by compare
    em.aw(A32_RSBI + (2 « 16) + (4 « 12) + 32)       // rsb r4, r2, #32
    a32_dps(&em, A32_MOVR, 0, 0, 0, 1, 2)            // lsr r0, r0, r2
    a32_dps(&em, A32_ORR, 0, 0, 1, 0, 4)             // orr r0, r0, r1 lsl r4
    em.aw(A32_CMP0 + (2 « 16) + 32)                  // cmp r2, #32
    em.aw(A32_SUB + 33554432 + (2 « 16) + (6 « 12) + 32)  // sub r6, r2, #32
    // r0 ← r1 asr r6 where the count reached the high word, and the
    // high word spreads its sign either way after
    em.aw(((A32_MOVR & 268435455) + (A32_CS « 28)) + (0 « 12) + (6 « 8) + (2 « 5) + 16 + 1)
    a32_dps(&em, A32_MOVR, 1, 0, 1, 2, 2)            // asr r1, r1, r2
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_cmp3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, cond : i64, sgn : i64, bits : i64):
    a32_binprep(&em, rx, ry)
    if cond = arch_a64.CC_EQ or cond = arch_a64.CC_NE:
        a32_dp(&em, A32_EOR, 0, 0, 2)
        a32_dp(&em, A32_EOR, 1, 1, 3)
        a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)      // orrs r0, r0, r1
        a32_zero9(&em, 0)
        a32_movc1(&em, if cond = arch_a64.CC_EQ: A32_EQ else: A32_NE, 0)
    else:
        // subs/sbcs leave the whole comparison in the flags; GT and LE
        // ask the mirrored question
        let flip : bool = cond = arch_a64.CC_GT or cond = arch_a64.CC_LE
        let xl : i64 = if flip: 2 else: 0
        let xh : i64 = if flip: 3 else: 1
        let yl : i64 = if flip: 0 else: 2
        let yh : i64 = if flip: 1 else: 3
        a32_dp(&em, A32_SUBS, 4, xl, yl)
        a32_dp(&em, A32_SBCS, 4, xh, yh)
        let base : i64 = if sgn = 1: A32_LT else: A32_CC
        let inv : i64 = if sgn = 1: A32_GE else: A32_CS
        a32_zero9(&em, 0)
        a32_movc1(&em, if cond = arch_a64.CC_GE or cond = arch_a64.CC_LE: inv else: base, 0)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32_zero9(em : &mut emit.Emit, rd : i64):
    em.aw(A32_MOV0 + (rd « 12))

fn a32_movc1(em : &mut emit.Emit, cond : i64, rd : i64):
    em.aw((cond « 28) + A32_MOVC1 + (rd « 12))

@export
fn a32g_sel4(em : &mut emit.Emit, tg : elf.Target, rd : i64, rc : i64, rx : i64, ry : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rc))
    a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)          // orrs
    // both loads are conditional, so nothing branches
    a32_ldpair(&em, 2, 3, a32_cello(rx))
    a32_ldpair(&em, 4, 5, a32_cello(ry))
    em.aw((A32_NE « 28) + (A32_MOVR & 268435455) + (0 « 12) + 2)   // movne r0, r2
    em.aw((A32_NE « 28) + (A32_MOVR & 268435455) + (1 « 12) + 3)
    em.aw((A32_EQ « 28) + (A32_MOVR & 268435455) + (0 « 12) + 4)   // moveq r0, r4
    em.aw((A32_EQ « 28) + (A32_MOVR & 268435455) + (1 « 12) + 5)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_div3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    a32_helper2(&em, rd, rx, ry, if sgn = 1: emit.RT_DIVS64 else: emit.RT_DIVU64)

@export
fn a32g_mod3(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    a32_helper2(&em, rd, rx, ry, if sgn = 1: emit.RT_MODS64 else: emit.RT_MODU64)

fn a32_helper2(em : &mut emit.Emit, rd : i64, rx : i64, ry : i64, target : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_stpair(&em, 0, 1, 0)
    a32_ldpair(&em, 0, 1, a32_cello(ry))
    a32_stpair(&em, 0, 1, 8)
    a32_call(&em, target)
    a32_stpair(&em, 0, 1, a32_cello(rd))

fn a32_bcc(em : &mut emit.Emit, cond : i64, lab : i64):
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw((cond « 28) + (A32_B & 268435455))

// A clear carry is the borrow here, so an addition that did not
// overflow leaves it clear and a subtraction that did not leaves it set.
@export
fn a32g_addchk(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ADDS, 0, 0, 2)
    a32_dp(&em, A32_ADC + 1048576, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))
    a32_bcc(&em, if sgn = 1: 7 else: A32_CC, lab)

@export
fn a32g_subchk(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_SUBS, 0, 0, 2)
    a32_dp(&em, A32_SBC + 1048576, 1, 1, 3)
    a32_stpair(&em, 0, 1, a32_cello(rd))
    a32_bcc(&em, if sgn = 1: 7 else: A32_CS, lab)

@export
fn a32g_addov(em : &mut emit.Emit, tg : elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_ADDS, 0, 0, 2)
    a32_dp(&em, A32_ADC + 1048576, 1, 1, 3)          // adcs
    a32_zero9(&em, 4)
    a32_movc1(&em, if sgn = 1: A32_VS else: A32_CS, 4)
    a32_zero9(&em, 5)
    a32_stpair(&em, 0, 1, a32_cello(rd))
    a32_stpair(&em, 4, 5, a32_cello(rf))

@export
fn a32g_subov(em : &mut emit.Emit, tg : elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    a32_binprep(&em, rx, ry)
    a32_dp(&em, A32_SUBS, 0, 0, 2)
    a32_dp(&em, A32_SBCS, 1, 1, 3)
    a32_zero9(&em, 4)
    a32_movc1(&em, if sgn = 1: A32_VS else: A32_CC, 4)
    a32_zero9(&em, 5)
    a32_stpair(&em, 0, 1, a32_cello(rd))
    a32_stpair(&em, 4, 5, a32_cello(rf))

@export
fn a32g_mulov(em : &mut emit.Emit, tg : elf.Target, rd : i64, rf : i64, rx : i64, ry : i64, sgn : i64, bits : i64):
    // as on i386: stage, park the product, ask the helper, then land
    a32_ldpair(&em, 0, 1, a32_cello(rx))
    a32_stpair(&em, 0, 1, 0)
    a32_ldpair(&em, 0, 1, a32_cello(ry))
    a32_stpair(&em, 0, 1, 8)
    a32_movimm(&em, 0, sgn)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, 16)
    a32_binprep(&em, rx, ry)
    em.aw(A32_UMULL + (5 « 16) + (4 « 12) + (2 « 8) + 0)
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (3 « 8) + 0)
    em.aw(A32_MLA + (5 « 16) + (5 « 12) + (2 « 8) + 1)
    a32_stpair(&em, 4, 5, 24)
    a32_call(&em, emit.RT_MULOV64)
    a32_stpair(&em, 0, 1, a32_cello(rf))
    a32_ldpair(&em, 0, 1, 24)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_ext2(em : &mut emit.Emit, tg : elf.Target, r : i64, bits : i64, sgn : i64):
    if bits >= 64:
        return
    a32_ldpair(&em, 0, 1, a32_cello(r))
    if bits < 32:
        let sh : i64 = 32 - bits
        em.aw(A32_MOVR + (0 « 12) + (sh « 7) + 0)            // lsl r0, r0, #sh
        em.aw(A32_MOVR + (0 « 12) + (sh « 7) + ((if sgn = 1: 2 else: 1) « 5) + 0)
    if sgn = 1:
        em.aw(A32_MOVR + (1 « 12) + (31 « 7) + (2 « 5) + 0)  // asr r1, r0, #31
    else:
        a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(r))

@export
fn a32g_ldo(em : &mut emit.Emit, tg : elf.Target, rd : i64, rbase : i64, off : i64, width : i64, sgn : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    a32_ldsp(&em, 2, a32_cello(rbase))
    if off ≠ 0:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 2, 2, 12)
    if wd = 8:
        em.aw(A32_LDRR + (2 « 16) + (0 « 12))
        em.aw(A32_LDRR + (2 « 16) + (1 « 12) + 4)
    else:
        if wd = 4:
            em.aw(A32_LDRR + (2 « 16) + (0 « 12))
        elif wd = 2:
            em.aw((if sgn = 1: A32_LDRH + 64 else: A32_LDRH) + (2 « 16) + (0 « 12))
        else:
            if sgn = 1:
                em.aw(A32_LDRH + 32 + (2 « 16) + (0 « 12))   // ldrsb
            else:
                em.aw(A32_LDRB + (2 « 16) + (0 « 12))
        if sgn = 1:
            em.aw(A32_MOVR + (1 « 12) + (31 « 7) + (2 « 5) + 0)
        else:
            a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(rd))

@export
fn a32g_sto(em : &mut emit.Emit, tg : elf.Target, rs : i64, rbase : i64, off : i64, width : i64):
    let wd : i64 = if width = 0: tg.ptr else: width
    a32_ldsp(&em, 2, a32_cello(rbase))
    if off ≠ 0:
        a32_movimm(&em, 12, off)
        a32_dp(&em, A32_ADD, 2, 2, 12)
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    if wd = 8:
        em.aw(A32_STRR + (2 « 16) + (0 « 12))
        em.aw(A32_STRR + (2 « 16) + (1 « 12) + 4)
    elif wd = 4:
        em.aw(A32_STRR + (2 « 16) + (0 « 12))
    elif wd = 2:
        em.aw(A32_STRH + (2 « 16) + (0 « 12))
    else:
        em.aw(A32_STRB + (2 « 16) + (0 « 12))

@export
let A32F_B24 : i64 = 24

@export
fn a32g_jmp(em : &mut emit.Emit, tg : elf.Target, lab : i64):
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw(A32_B)

@export
fn a32g_jz(em : &mut emit.Emit, tg : elf.Target, r : i64, lab : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw((A32_EQ « 28) + (A32_B & 268435455))

@export
fn a32g_jnz(em : &mut emit.Emit, tg : elf.Target, r : i64, lab : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_dp(&em, A32_ORR + 1048576, 0, 0, 1)
    em.tf_pos.push(em.here())
    em.tf_lab.push(lab)
    em.tf_form.push(A32F_B24)
    em.aw((A32_NE « 28) + (A32_B & 268435455))

@export
fn a32g_label(em : &mut emit.Emit, tg : elf.Target, lab : i64):
    em.set_label(lab)

@export
fn a32_call(em : &mut emit.Emit, target : i64):
    if em.skipping = 1:
        return
    em.cf_pos.push(em.here())
    em.cf_target.push(target)
    em.aw(A32_BL)

@export
fn a32g_call(em : &mut emit.Emit, tg : elf.Target, target : i64):
    a32_call(&em, target)

@export
fn a32g_calli(em : &mut emit.Emit, tg : elf.Target, r : i64):
    a32_ldsp(&em, 4, a32_cello(r))
    em.aw(A32_BLXR + 4)

@export
fn a32g_ijmp(em : &mut emit.Emit, tg : elf.Target, r : i64):
    a32_ldsp(&em, 4, a32_cello(r))
    em.aw(A32_BLXR - 16 + 4)                         // bx r4

// A function nobody outside can call takes its first two arguments in
// r0:r1 and r2:r3.  arm's abstract registers are cells in the frame and
// only r0:r1 carries anything between them, so r2 and r3 are free the
// whole way through, and nothing needs preserving: a caller here keeps
// nothing in a register across a call to lose.
@export
@pre(k >= 0 and k < 2)
fn a32g_argreg(em : &mut emit.Emit, tg : elf.Target, k : i64, slot : i64):
    a32_ldpair(&em, 2 × k, 2 × k + 1, a32_sloto(slot))

@export
fn a32g_argld(em : &mut emit.Emit, tg : elf.Target, k : i64, slot : i64):
    a32_ldpair(&em, 0, 1, a32_sloto(slot))
    a32_stpair(&em, 0, 1, 8 × k)

@export
fn a32g_argconst(em : &mut emit.Emit, tg : elf.Target, k : i64, v : i64):
    a32_movimm(&em, 0, v & 4294967295)
    a32_movimm(&em, 1, @wrap(v » 32) & 4294967295)
    a32_stpair(&em, 0, 1, 8 × k)

@export
fn a32g_argmov(em : &mut emit.Emit, tg : elf.Target, k : i64, r : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))
    a32_stpair(&em, 0, 1, 8 × k)

@export
fn a32g_retst(em : &mut emit.Emit, tg : elf.Target, slot : i64):
    a32_stpair(&em, 0, 1, a32_sloto(slot))

@export
fn a32g_retld(em : &mut emit.Emit, tg : elf.Target, slot : i64):
    a32_ldpair(&em, 0, 1, a32_sloto(slot))

@export
fn a32g_retmov(em : &mut emit.Emit, tg : elf.Target, r : i64):
    a32_ldpair(&em, 0, 1, a32_cello(r))

// r11 is the frame pointer, and the high half of the pair is zero
@export
fn a32g_fptr(em : &mut emit.Emit, tg : elf.Target, r : i64):
    a32_dp(&em, A32_MOVR, 0, 0, 11)              // mov r0, r11
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(r))

@export
fn a32g_absref(em : &mut emit.Emit, tg : elf.Target, r : i64) → i64:
    let pos : i64 = em.here()
    a32_movw(&em, 0, 0)
    a32_movt(&em, 0, 0)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, a32_cello(r))
    pos

@export
fn a32g_absref_arg(em : &mut emit.Emit, tg : elf.Target, k : i64) → i64:
    let pos : i64 = em.here()
    a32_movw(&em, 0, 0)
    a32_movt(&em, 0, 0)
    a32_zero9(&em, 1)
    a32_stpair(&em, 0, 1, 8 × k)
    pos

@export
fn a32g_sysarg(em : &mut emit.Emit, tg : elf.Target, k : i64, slot : i64):
    // the low words parked below the outgoing area's own use
    a32_ldsp(&em, 0, a32_sloto(slot))
    a32_stsp(&em, 0, 104 + 4 × k)

@export
fn a32g_sysimm(em : &mut emit.Emit, tg : elf.Target, k : i64, v : i64):
    a32_movimm(&em, 0, v & 4294967295)
    a32_stsp(&em, 0, 104 + 4 × k)

@export
fn a32g_sysmov(em : &mut emit.Emit, tg : elf.Target, k : i64, r : i64):
    a32_ldsp(&em, 0, a32_cello(r))
    a32_stsp(&em, 0, 104 + 4 × k)

@export
fn a32g_syscall(em : &mut emit.Emit, tg : elf.Target, scid : i64):
    a32_ldsp(&em, 0, 104)
    a32_ldsp(&em, 1, 108)
    a32_ldsp(&em, 2, 112)
    a32_ldsp(&em, 3, 116)
    a32_ldsp(&em, 4, 120)
    a32_ldsp(&em, 5, 124)
    a32_movimm(&em, 7, arch_a64.sc_number(tg, scid))
    em.aw(A32_SVC)
    // only the errno band is negative
    a32_zero9(&em, 1)
    a32_movimm(&em, 12, 4294963200)
    a32_dp(&em, A32_CMP, 0, 0, 12)
    em.aw((A32_CS « 28) + (A32_MVN & 268435455) + (1 « 12) + 1)  // mvnhs r1, r1
    _ ← scid

@export
fn a32g_sysret(em : &mut emit.Emit, tg : elf.Target, r : i64):
    a32_stpair(&em, 0, 1, a32_cello(r))

// see i3g_frameaddr; here a slot sits at sp + 160 + 8×s, upward, so
// the region begins at slot nvregs
@export
@pre(off >= 0)
fn a32g_frameaddr(em : &mut emit.Emit, tg : elf.Target, nvregs : i64, nobj : i64, off : i64, r : i64):
    _ ← nobj
    let at : i64 = 160 + 8 × nvregs + off
    a32_movimm(&em, 12, at)
    a32_dp(&em, A32_ADD, 0, 13, 12)                  // r0 ← sp + at
    a32_movimm(&em, 1, 0)
    a32_stpair(&em, 0, 1, a32_cello(r))

@export
fn a32g_prologue(em : &mut emit.Emit, tg : elf.Target, nvregs : i64, np : i64, nreg : i64):
    let frame : i64 = 160 + 8 × nvregs
    em.max_frame ← em.max_frame ⌈ (frame + 16)
    em.aw(A32_PUSHFL)                                // push {r11, lr}
    a32_dp(&em, A32_MOVR, 11, 0, 13)                 // mov r11, sp
    a32_movimm(&em, 12, frame)
    a32_dp(&em, A32_SUB, 13, 13, 12)                 // sub sp, sp, ip
    // The ones that came in registers go to their slots first: r0:r1 is
    // where argument 0 arrived and is also what a stack argument is
    // read through, and in this order the two never meet.
    foreach j := 0…np:
        if j < nreg:
            a32_stpair(&em, 2 × j, 2 × j + 1, a32_sloto(j))
        else:
            // it arrived on the stack, above the saved pair
            em.aw(A32_LDRR + (11 « 16) + (0 « 12) + (8 + 8 × j))
            em.aw(A32_LDRR + (11 « 16) + (1 « 12) + (12 + 8 × j))
            a32_stpair(&em, 0, 1, a32_sloto(j))

@export
fn a32g_epilogue(em : &mut emit.Emit, tg : elf.Target):
    a32_dp(&em, A32_MOVR, 13, 0, 11)                 // mov sp, r11
    em.aw(A32_POPFL)
    em.aw(A32_BXLR)

@export
fn a32g_resolve(em : &mut emit.Emit, tg : elf.Target):
    if #em.tf_pos > 0:
        foreach i := 0…#em.tf_pos:
            let pos : i64 = em.tf_pos[i]
            let delta : i64 = em.labels[em.tf_lab[i] × 1¤ptrdiff] - pos
            em.patch32(pos, arch_a64.code_word(&em, pos) + (((delta - 8) » 2) & 16777215))
    while #em.tf_pos > 0:
        _ ← em.tf_pos.pop() ?? 0
        _ ← em.tf_lab.pop() ?? 0
        _ ← em.tf_form.pop() ?? 0

@export
fn a32g_patch_abs(em : &mut emit.Emit, tg : elf.Target, pos : i64, v : i64):
    let w0 : i64 = arch_a64.code_word(&em, pos)
    em.patch32(pos, w0 + (((v » 12) & 15) « 16) + (v & 4095))
    let w1 : i64 = arch_a64.code_word(&em, pos + 4)
    em.patch32(pos + 4, w1 + (((v » 28) & 15) « 16) + ((v » 16) & 4095))

@export
fn a32g_patch_call(em : &mut emit.Emit, tg : elf.Target, pos : i64, dest : i64):
    em.patch32(pos, arch_a64.code_word(&em, pos) + (((dest - pos - 8) » 2) & 16777215))

@export
fn a32g_shl3i(em : &mut emit.Emit, tg : elf.Target, rd : i64, rs : i64, imm : i64):
    a32_ldpair(&em, 0, 1, a32_cello(rs))
    // lsl r1, r1, #imm; orr r1, r1, r0 lsr #(32-imm); lsl r0, r0, #imm
    em.aw(A32_MOVR + (1 « 12) + (imm « 7) + 1)
    em.aw(A32_ORR + (1 « 16) + (1 « 12) + ((32 - imm) « 7) + (1 « 5) + 0)
    em.aw(A32_MOVR + (0 « 12) + (imm « 7) + 0)
    a32_stpair(&em, 0, 1, a32_cello(rd))
