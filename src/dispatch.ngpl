// ---------------------------------------------------------------------------
// The abstract operations, dispatched on the target
// ---------------------------------------------------------------------------
//
// Each of these picks the layer that spells the operation for the
// target in hand -- a64g_ for aarch64, rvg_ for riscv64, and so on.
// x86-64 does not appear: it is the hand-tuned pioneer and has its own
// emitter in x86.ngpl, which these exist to be measured against.
//
// The file sits between aarch64 and riscv64 rather than after all the
// instruction layers, because the split of this compiler into files was
// cut from one text without moving a line of it, and this is where the
// dispatchers were.
//
// Each is a match over Tgt, and every one of them names all six.  That
// is the point of the match rather than a chain of comparisons: a
// seventh machine added to Tgt stops every dispatcher here that does
// not say what to do with it.  A chain answered the last branch by
// falling through to it, so a machine nobody had thought about would
// have been emitted as riscv32 -- silently, and only on that machine.
//
// x86-64 is named too, and what it says is that it does not come here.
// t_startup in codegen_t.ngpl is the same shape and says the same, for
// the same reason -- aarch64's startup was lifted out of it into
// a64_startup so that its arm has something to name.

let arch_a64 := @import("arch_a64")
let arch_arm := @import("arch_arm")
let arch_i386 := @import("arch_i386")
let arch_rv32 := @import("arch_rv32")
let arch_rv64 := @import("arch_rv64")
let elf := @import("elf")
let emit := @import("emit")

// The arm every dispatcher gives x86-64.  It has its own emitter in
// x86.ngpl and never reaches these, so this is not a case to handle
// but a statement that the case cannot arise -- written down because
// the match asks for all six and this is the honest sixth.


@export
@noreturn
fn g_pioneer():
    assert(false, "x86-64 has its own emitter and does not come through the dispatchers")

// A load whose value is already in the accumulator, because the store
// that would have put it in memory was dropped, is no load at all.
@export
fn g_lds(em : &mut emit.Emit, tg : elf.Target, r : i64, slot : i64):
    if r = arch_a64.RG_A and slot = em.hold_slot:
        em.hold_slot ← ⁻1
        return
    em.hold_slot ← ⁻1
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_lds(&em, tg, r, slot)
        elf.Tgt.rv64: arch_rv64.rvg_lds(&em, tg, r, slot)
        elf.Tgt.i386: arch_i386.i3g_lds(&em, tg, r, slot)
        elf.Tgt.a32: arch_arm.a32g_lds(&em, tg, r, slot)
        elf.Tgt.rv32: arch_rv32.r32g_lds(&em, tg, r, slot)
        elf.Tgt.x64: g_pioneer()

// A store nothing will read from memory is a store not worth making;
// what holds the value instead is the accumulator, which is where the
// one operation that wants it is about to look.
@export
fn g_sts(em : &mut emit.Emit, tg : elf.Target, r : i64, slot : i64):
    if r = arch_a64.RG_A and slot = em.drop_slot:
        em.drop_slot ← ⁻1
        em.hold_slot ← slot
        return
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_sts(&em, tg, r, slot)
        elf.Tgt.rv64: arch_rv64.rvg_sts(&em, tg, r, slot)
        elf.Tgt.i386: arch_i386.i3g_sts(&em, tg, r, slot)
        elf.Tgt.a32: arch_arm.a32g_sts(&em, tg, r, slot)
        elf.Tgt.rv32: arch_rv32.r32g_sts(&em, tg, r, slot)
        elf.Tgt.x64: g_pioneer()

