// The answer, on its way out.  Where the store that would have put it
// in memory was dropped, it is still in the accumulator, and moving it
// from there is what reading the slot would have been.
@export
fn g_retld(em : &mut emit.Emit, tg : elf.Target, slot : i64):
    if slot = em.hold_slot:
        em.hold_slot ← ⁻1
        g_retmov(&em, tg, arch_a64.RG_A)
        return
    em.hold_slot ← ⁻1
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_retld(&em, tg, slot)
        elf.Tgt.rv64: arch_rv64.rvg_retld(&em, tg, slot)
        elf.Tgt.i386: arch_i386.i3g_retld(&em, tg, slot)
        elf.Tgt.a32: arch_arm.a32g_retld(&em, tg, slot)
        elf.Tgt.rv32: arch_rv32.r32g_retld(&em, tg, slot)
        elf.Tgt.x64: g_pioneer()

fn g_retmov(em : &mut emit.Emit, tg : elf.Target, r : i64):
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_retmov(&em, tg, r)
        elf.Tgt.rv64: arch_rv64.rvg_retmov(&em, tg, r)
        elf.Tgt.i386: arch_i386.i3g_retmov(&em, tg, r)
        elf.Tgt.a32: arch_arm.a32g_retmov(&em, tg, r)
        elf.Tgt.rv32: arch_rv32.r32g_retmov(&em, tg, r)
        elf.Tgt.x64: g_pioneer()

