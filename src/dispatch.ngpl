// Which widths a target can settle an overflow at directly, the
// machine itself saying whether the narrow result was too big.  Below
// this the arithmetic is done at a word and the range asked afterwards.
//
// aarch64 has 32-bit forms of adds and subs -- the 64-bit encodings
// with one bit cleared -- and no scalar arithmetic narrower than that.
// i386's registers are 32 bits, so every narrow width is native there
// and the pair's high half need not be worked at all.
//
// riscv64 is not here, and was measured before being left out: it has
// no flags, so the answer is a comparison whichever width is asked, and
// what addw saves in making the sign-extended result the canonicalising
// afterwards spends again.  Asking at 32 bits came to +0.05% on a
// program of narrow arithmetic and nothing at all on t07_widths.
@export
fn g_narrow_ok(tg : elf.Target, bits : i64) → bool:
    if bits = 64:
        return true
    match tg.id:
        elf.Tgt.a64: bits = 32
        elf.Tgt.i386: bits = 8 or bits = 16 or bits = 32
        _: false

// Compute, and go to lab where it did not overflow.
//
// The overflow dispatchers above put a flag in a register and leave the
// caller to test it, which is the only shape the two RISC-V targets can
// use: they have no flags, so the answer is a value whichever way it is
// asked.  The other three have a condition and can branch on it, and
// putting it in a register first costs a cset or a setcc, the widening
// of it, and a test -- most of what the arithmetic itself costs.
//
// Each target says which of the two it is, because the condition that
// means "no overflow" belongs with the instruction that set it: on ARM
// a clear carry is the borrow, so a subtraction that did not overflow
// leaves it set, and an addition that did not leaves it clear.
@export
fn g_addchk(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_addchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.rv64: arch_rv64.rvg_addchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.i386: arch_i386.i3g_addchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.a32: arch_arm.a32g_addchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.rv32: arch_rv32.r32g_addchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.x64: g_pioneer()

@export
fn g_subchk(em : &mut emit.Emit, tg : elf.Target, rd : i64, rx : i64, ry : i64, sgn : i64, bits : i64, lab : i64):
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_subchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.rv64: arch_rv64.rvg_subchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.i386: arch_i386.i3g_subchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.a32: arch_arm.a32g_subchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.rv32: arch_rv32.r32g_subchk(&em, tg, rd, rx, ry, sgn, bits, lab)
        elf.Tgt.x64: g_pioneer()

