@export
fn g_sto(em : &mut emit.Emit, tg : elf.Target, rs : i64, rbase : i64, off : i64, width : i64):
    match tg.id:
        elf.Tgt.a64: arch_a64.a64g_sto(&em, tg, rs, rbase, off, width)
