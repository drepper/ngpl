let ast := @import("ast")
let check := @import("check")
let elf := @import("elf")
let emit := @import("emit")
let ir := @import("ir")
let lex := @import("lex")
let names := @import("names")
let tokens := @import("tokens")
let types := @import("types")

// ===========================================================================
// Lowering: Ast + Chk → IrFn per function
// ===========================================================================



@export
struct Lower:
    a : ast.Ast
    toks : lex.Toks
    src : byte[]
    ntype : i64[]
    nslot : i64[]
    ncvt : i64[]
    nrep : i64[]
    nlam : i64[]
    nhold : i64[]
    nfree : i64[]
    rec_stmt : i64[]     // see Chk
    rec_slot : i64[]
    nmove : i64[]        // see Chk
    cur_ref : i64        // whether the function being lowered answers a borrow
    strs : str[]
    sat : names.Names    // where each string sits in strs, by hashing
    loop_labels : i64[]  // the top and end labels of the loops being written, innermost last
    op : ir.Ir[]
    ia : i64[]
    ib : i64[]
    ic : i64[]
    idd : i64[]
    iww : i64[]
    extra : i64[]
    tbase : i64
    tnext : i64
    tmax : i64
    nlabels : i64
    breaks : i64[]
    conts : i64[]
    in_wrap : i64
    argsfix : i64
    lambase : i64        // the first lambda's function index
    shimbase : i64       // the first partial-application shim's        // the argument filter's index, ⁻1 for raw
    cur_ret : i64
    post_label : i64
    res_vreg : i64
    // A call to the function being lowered, standing in tail position,
    // is a loop rather than a call: the parameters take the new values
    // and the body starts again.  tail_label is where it starts again,
    // or ⁻1 where this function is not one that may be turned round.
    // Where the @old values of this function are kept.  A slot each,
    // below the temporaries: a temporary would not do, since tnext
    // falls back to tbase at every statement and the body runs between
    // the reading and the postcondition that asks.
    old_base : i64
    // The one an @invariant is being asked about, while it is asked.
    // A field of it is read out of this, so the condition is written
    // once and read wherever one of the type is made or changed.
    inv_subject : i64
    tail_label : i64
    tail_fn : i64        // which function that is, by index
    tail_np : i64        // how many parameters it takes
    cur_fname : str
    dlog : str[]         // one JSON line per code-shaping decision
    argcopy : i64[]      // arguments whose copy by value cannot be elided
    fbytes : i64 ¤byte   // frame taken by objects that live in the frame
    sret : i64           // where a sized answer is to be written, ⁻1 for none
    // How hard the compiler was asked to work on this code: 0 unless
    // -O said otherwise.  Nothing reads the number; what reads it is
    // opt_at_least below, so an optimization says which level it
    // belongs to and the levels stay a matter of one comparison.
    olevel : i64
    // what a violated condition does: one of CT_*
    contracts : i64

@post(r: (r & 255) >= 8 and (r & 255) <= 64)
fn width_of(t : i64) → i64:
    // the width an operation on this type runs at, bits + 256×sgn
    if t = types.TY_BOOL: return 64 + 256
    if not types.ty_is_int(t): return 64 + 256
    types.ty_bits(t) + 256 × types.ty_sgn(t)

impl Lower:
    // Whether the code being generated was asked for at least this much
    // work.  Every optimization the compiler grows asks this rather
    // than reading the level, so what a level means is written once
    // beside each thing it turns on, and level 0 -- the default, what a
    // build gets when -O said nothing -- turns none of them on.
    @pre(level >= 1)
    fn opt_at_least(&self, level : i64) → bool:
        self.olevel >= level

    // Take bytes out of this frame's object region.  The offset counts
    // from the bottom, so what is handed out stays put as the region
    // grows; the alignment is the object's own, and the region as a
    // whole is aligned to a slot by the prologue.
    @pre(bytes >= 0 and align > 0)
    @post(r: r >= 0)
    fn frame_alloc(&mut self, bytes : i64, align : i64) → i64:
        let nb : i64 ¤byte = bytes
        let al : i64 ¤byte = align
        let at : i64 ¤byte = elf.align_up_b(self.fbytes, al)
        self.fbytes ← at + nb
        @dropunit(at)

    fn ir(&mut self, o : ir.Ir, a : i64, b : i64, c : i64, d : i64, w : i64):
        self.op.push(o)
        self.ia.push(a)
        self.ib.push(b)
        self.ic.push(c)
        self.idd.push(d)
        self.iww.push(w)

    // What a call hands back, as a width, so that the value can be put
    // into canonical form where it lands rather than before it is
    // returned: a returned value is only as wide as its type says, and
    // the caller is the one that knows whether anything wants more.
    // Nought for anything that is not a sized integer, which is every
    // handle, and which canon leaves alone.
    fn callw(&self, nid : i64) → i64:
        let rt : i64 = self.tof(nid)
        if types.ty_is_int(rt) and types.ty_bits(rt) < 64:
            return width_of(rt)
        0

    fn tmp(&mut self) → i64:
        let v : i64 = self.tnext
        self.tnext ← self.tnext + 1
        if self.tnext > self.tmax:
            self.tmax ← self.tnext
        v

    fn label(&mut self) → i64:
        let l : i64 = self.nlabels
        self.nlabels ← self.nlabels + 1
        l

    fn intern(&mut self, s : str) → i64:
        // every literal and every message the compiler emits passes
        // here, and the pool holds thousands by the end: a hash, not
        // a walk down all of them
        let seen : i64 = self.sat.find(s)
        if seen ≠ ⁻1:
            return seen
        let idx : i64 = @dropunit(#self.strs)
        self.strs.push(s)
        self.sat.add_at(s, idx)
        idx

    fn fname_index(&self, name : str) → i64:
        foreach i := 0…#self.a.fns:
            if self.a.fns[i].name = name:
                return @dropunit(i)
        ⁻1

    fn text(&self, tok : i64) → str:
        tokens.run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    fn tok_line(&self, tok : i64) → i64 ¤"line":
        self.toks.line[tok × 1¤ptrdiff]

    // what was decided and where, for the log a program can read
    fn decide(&mut self, line : i64 ¤"line", what : str, detail : str):
        // the log says a number, as a diagnostic does, so the measure
        // is parted with here and nowhere earlier
        self.dlog.push("{\"function\": \"" ⧺ self.cur_fname ⧺ "\", \"line\": " ⧺ tokens.i64_str(@dropunit(line)) ⧺ ", \"decision\": \"" ⧺ what ⧺ "\"" ⧺ detail ⧺ "}")

    fn tof(&self, id : i64) → i64:
        self.ntype[id × 1¤ptrdiff]

    fn kof(&self, id : i64) → ast.Nk:
        self.a.nkind[id × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // What may be read without being asked: no effects, no faults.
    // Checked arithmetic can abort, so only @wrap arithmetic passes;
    // loads from arrays are bounds-checked, so they do not.  This is
    // the speculation-legality rule if-conversion runs on.
    // ------------------------------------------------------------------

    fn speculatable(&self, id : i64) → bool:
        let k : ast.Nk = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = ast.Nk.lit_int or k = ast.Nk.lit_bool or k = ast.Nk.lit_str or k = ast.Nk.var or k = ast.Nk.emptyv:
            return true
        if k = ast.Nk.op_not or k = ast.Nk.bnot:
            return self.speculatable(na)
        if k = ast.Nk.len or k = ast.Nk.field:
            return self.speculatable(na)
        if k = ast.Nk.op_wrap:
            return self.wrap_speculatable(na)
        if k = ast.Nk.eq or k = ast.Nk.ne or k = ast.Nk.lt or k = ast.Nk.le or k = ast.Nk.gt or k = ast.Nk.ge or k = ast.Nk.land or k = ast.Nk.lor or k = ast.Nk.op_and or k = ast.Nk.op_or or k = ast.Nk.maxop or k = ast.Nk.minop:
            return self.speculatable(na) and self.speculatable(nb)
        if k = ast.Nk.st_if:
            // An if written for its value: safe to read where its
            // condition is and both its branches are, each branch
            // being the one expression its block is.  A branch that is
            // more than that is not read ahead of the test.
            if nc = ⁻1:
                return false
            let tv : i64 = self.block_value_of(nb)
            let ev : i64 = self.block_value_of(nc)
            if tv = ⁻1 or ev = ⁻1:
                return false
            return self.speculatable(na) and self.speculatable(tv) and self.speculatable(ev)
        false

    // The one expression a block is, where it is exactly one and
    // nothing else; ⁻1 where the block does more than answer.
    fn block_value_of(&self, blk : i64) → i64:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        if self.a.extra[off × 1¤ptrdiff] ≠ 1:
            return ⁻1
        let only : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        if self.kof(only) ≠ ast.Nk.exprstmt:
            return ⁻1
        self.a.na[only × 1¤ptrdiff]

    fn wrap_speculatable(&self, id : i64) → bool:
        // inside @wrap the arithmetic cannot abort; shifts still can
        let k : ast.Nk = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if k = ast.Nk.add or k = ast.Nk.sub or k = ast.Nk.mul or k = ast.Nk.band or k = ast.Nk.bor or k = ast.Nk.bxor:
            return self.wrap_speculatable(na) and self.wrap_speculatable(nb)
        if k = ast.Nk.neg or k = ast.Nk.bnot:
            return self.wrap_speculatable(na)
        self.speculatable(id)

    // ------------------------------------------------------------------
    // Expressions
    // ------------------------------------------------------------------

    // A call to a runtime routine, which the backends know by its
    // negative id.  Lowering reaches for one where the work is the
    // runtime's rather than the machine's: int's arithmetic is all of
    // it so far.
    // the width a call of function f answers at; see callw
    fn retw(&self, f : i64) → i64:
        let rt : i64 = self.a.fns[f × 1¤ptrdiff].ret
        if types.ty_is_int(rt) and types.ty_bits(rt) < 64:
            return width_of(rt)
        0

    // one turn of a map or a fold: what the function says of the
    // arguments, called by its index where it was named and through
    // its box where it is a value the program holds
    fn call_fn(&mut self, f : i64, bx : i64, args : i64[], w : i64) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#args) + (if f = ⁻1: 1 else: 0))
        self.extra ← self.extra ⧺ args
        let d : i64 = self.tmp()
        if f = ⁻1:
            // the box rides behind the arguments, and the code address
            // is the first thing in it
            self.extra.push(bx)
            let ad : i64 = self.tmp()
            self.ir(ir.Ir.fld, bx, 0, 0, ad, 0)
            self.ir(ir.Ir.calli, ad, off, 0, d, 0)
        else:
            self.ir(ir.Ir.call, f, off, 0, d, w)
        d

    // f ¨ v: what f says of each element, collected in a fresh array
    fn lower_each(&mut self, nid : i64, na : i64, nb : i64) → i64:
        let f : i64 = self.a.nc[nid × 1¤ptrdiff]
        // the function value is made once, before the loop, where it
        // is a value rather than a name
        let bx : i64 = if f = ⁻1: self.lower_expr(na) else: 0
        // a range is walked as the array of its steps, as the
        // quantifiers walk one
        let cv : i64 = if types.ty_is_rg(types.ty_strip_ref(self.tof(nb))): self.lower_rg_arr(nb) else: self.lower_expr(nb)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, cv, 0, 0, n, 0)
        let out : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, out, 0)
        let i : i64 = self.iconst(0)
        let one : i64 = self.iconst(1)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let more : i64 = self.tmp()
        self.ir(ir.Ir.clt, i, n, 0, more, 64 + 256)
        self.ir(ir.Ir.jz, more, lend, 0, 0, 0)
        let e : i64 = self.tmp()
        self.ir(ir.Ir.aidx, cv, i, 0, e, 0)
        let r : i64 = self.call_fn(f, bx, [e], if f = ⁻1: 0 else: self.retw(f))
        self.ir(ir.Ir.apush, out, r, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, i, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, i, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        out

    // a loop over 0…n: answers the index vreg, having written the top
    // label and the test; the caller writes the body and calls
    // loop_close with what this answered
    fn loop_over(&mut self, n : i64) → i64:
        let i : i64 = self.iconst(0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.loop_labels.push(ltop)
        self.loop_labels.push(lend)
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let more : i64 = self.tmp()
        self.ir(ir.Ir.clt, i, n, 0, more, 64 + 256)
        self.ir(ir.Ir.jz, more, lend, 0, 0, 0)
        i

    fn loop_close(&mut self, i : i64):
        let lend : i64 = self.loop_labels.pop() ?? 0
        let ltop : i64 = self.loop_labels.pop() ?? 0
        let one : i64 = self.iconst(1)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, i, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, i, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)

    // v[lo…step…hi]: every step-th element from lo, stopping at hi as
    // the range of that spelling stops, in a fresh array
    fn lower_sslice(&mut self, nid : i64, na : i64, nb : i64) → i64:
        let pn : i64 = self.packed_n(na)
        let aty : i64 = self.tof(na)
        let w : i64 = width_of(self.elem_of(types.ty_strip_ref(aty)))
        let av : i64 = self.lower_expr(na)
        let lo : i64 = self.lower_expr(self.a.extra[nb × 1¤ptrdiff])
        let st : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
        let hi : i64 = self.lower_expr(self.a.extra[(nb + 2) × 1¤ptrdiff])
        let lz : i64 = self.label()
        self.ir(ir.Ir.jnz, st, lz, 0, 0, 0)
        let m : i64 = self.intern("a slice's step must not be zero (line " ⧺ tokens.i64_str(@dropunit(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]))) ⧺ ")\n")
        self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lz, 0, 0, 0, 0)
        let out : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, out, 0)
        let i : i64 = self.tmp()
        self.ir(ir.Ir.mov, lo, 0, 0, i, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c : i64 = self.range_alive(i, hi, st)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        let e : i64 = if pn >= 0: self.farr_load(av, aty, pn, i, ⁻1) else: self.tmp()
        if pn < 0:
            self.ir(ir.Ir.aidx, av, i, 0, e, w)
        self.ir(ir.Ir.apush, out, e, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, i, st, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, i, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        out

    // ⍋ v: the indices that sort v, least first, ties in their order.
    // The keys go to the runtime canonical -- an element is kept only
    // as wide as its type, and the sort compares whole words -- and
    // with whether they are unsigned, which is the one thing about
    // them a word does not say.
    fn lower_grade(&mut self, na : i64) → i64:
        let aty : i64 = types.ty_strip_ref(self.tof(na))
        let et : i64 = self.elem_of(aty)
        let w : i64 = width_of(et)
        let pn : i64 = self.packed_n(na)
        let av : i64 = self.lower_expr(na)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, av, 0, 0, n, 0)
        let keys : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, keys, 0)
        let i : i64 = self.loop_over(n)
        let e : i64 = if pn >= 0: self.farr_load(av, aty, pn, i, ⁻1) else: self.tmp()
        if pn < 0:
            self.ir(ir.Ir.aidx, av, i, 0, e, w)
        self.ir(ir.Ir.apush, keys, e, 0, 0, 0)
        self.loop_close(i)
        let uns : i64 = self.iconst(if types.ty_sgn(et) = 0: 1 else: 0)
        self.rt2(emit.RT_GRADE, keys, uns)

    // sep ⋈ parts: the parts joined, sep between each two
    fn lower_join(&mut self, na : i64, nb : i64) → i64:
        let sep : i64 = self.lower_expr(na)
        let pv : i64 = self.lower_expr(nb)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, pv, 0, 0, n, 0)
        let acc : i64 = self.tmp()
        let empty : i64 = self.tmp()
        self.ir(ir.Ir.sc, self.intern(""), 0, 0, empty, 0)
        self.ir(ir.Ir.mov, empty, 0, 0, acc, 0)
        let i : i64 = self.loop_over(n)
        let e : i64 = self.tmp()
        self.ir(ir.Ir.aidx, pv, i, 0, e, 0)
        // the separator goes before every part but the first
        let lfirst : i64 = self.label()
        self.ir(ir.Ir.jz, i, lfirst, 0, 0, 0)
        let withsep : i64 = self.tmp()
        self.ir(ir.Ir.sccat, acc, sep, 0, withsep, 0)
        self.ir(ir.Ir.mov, withsep, 0, 0, acc, 0)
        self.ir(ir.Ir.label, lfirst, 0, 0, 0, 0)
        let grown : i64 = self.tmp()
        self.ir(ir.Ir.sccat, acc, e, 0, grown, 0)
        self.ir(ir.Ir.mov, grown, 0, 0, acc, 0)
        self.loop_close(i)
        acc

    // Whether a store is `x ← x ⧺ w` with the same x on both sides: the
    // value is a join of arrays whose left operand names the very place
    // the store writes.  Answering yes is what lets the join grow the
    // array rather than build another.
    fn extends_itself(&self, sid : i64, val : i64) → bool:
        if self.kof(val) ≠ ast.Nk.ccat or not types.ty_is_arr(types.ty_strip_ref(self.tof(val))):
            return false
        self.same_dest(sid, self.a.na[val × 1¤ptrdiff])

    // Whether an operand names the very place a store writes: the
    // binding the store names, or the field of the place it names.
    fn same_dest(&self, sid : i64, l : i64) → bool:
        // a sized array lives in the frame as its elements and is not
        // an object to write through
        if self.packed_n(l) >= 0:
            return false
        match self.kof(sid):
            ast.Nk.assign:
                self.kof(l) = ast.Nk.var and self.a.nb[sid × 1¤ptrdiff] ≠ 1 and self.nslot[l × 1¤ptrdiff] = self.nslot[sid × 1¤ptrdiff]
            ast.Nk.storefld:
                self.kof(l) = ast.Nk.field and self.a.nb[l × 1¤ptrdiff] = self.a.nc[sid × 1¤ptrdiff] and self.same_place(self.a.na[l × 1¤ptrdiff], self.a.na[sid × 1¤ptrdiff])
            _:
                false

    // Whether this node is an operator the checker marked as threading.
    // The mark is one bit of nc, which other node kinds put other things
    // in, so the kind is asked as well as the mark.
    fn threaded_op(&self, val : i64) → bool:
        if self.a.nc[val × 1¤ptrdiff] ≠ 1:
            return false
        match self.kof(val):
            ast.Nk.add, ast.Nk.sub, ast.Nk.mul, ast.Nk.shl, ast.Nk.shr, ast.Nk.band, ast.Nk.bor, ast.Nk.bxor, ast.Nk.satadd, ast.Nk.satsub, ast.Nk.satmul, ast.Nk.maxop, ast.Nk.minop, ast.Nk.eq, ast.Nk.ne, ast.Nk.lt, ast.Nk.le, ast.Nk.gt, ast.Nk.ge:
                true
            _:
                false

    // `v ← v + w` and `v ← w + v`: which side of a threaded operator
    // names the place the answer is stored into -- 0 the left, 1 the
    // right, ⁻1 neither.  Where one of them does, the loop writes its
    // answers into that array instead of building another.
    // @post @result >= ⁻1 and @result <= 1
    fn threads_itself(&self, sid : i64, val : i64) → i64:
        if not self.threaded_op(val) or not types.ty_is_arr(types.ty_strip_ref(self.tof(val))):
            return ⁻1
        if self.same_dest(sid, self.a.na[val × 1¤ptrdiff]):
            return 0
        if self.same_dest(sid, self.a.nb[val × 1¤ptrdiff]):
            return 1
        ⁻1

    // Whether two expressions name one place: a binding, a global, or a
    // field of a place.  Anything else answers no, which only costs the
    // join above being written the long way.
    fn same_place(&self, a9 : i64, b9 : i64) → bool:
        if self.kof(a9) ≠ self.kof(b9):
            return false
        match self.kof(a9):
            ast.Nk.var:
                self.nslot[a9 × 1¤ptrdiff] = self.nslot[b9 × 1¤ptrdiff]
            ast.Nk.field:
                self.a.nb[a9 × 1¤ptrdiff] = self.a.nb[b9 × 1¤ptrdiff] and self.same_place(self.a.na[a9 × 1¤ptrdiff], self.a.na[b9 × 1¤ptrdiff])
            _:
                false

    // ⍸ b: the indices at which the truth values are true
    fn lower_where(&mut self, na : i64) → i64:
        let bv : i64 = self.lower_expr(na)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, bv, 0, 0, n, 0)
        let out : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, out, 0)
        let i : i64 = self.loop_over(n)
        let e : i64 = self.tmp()
        self.ir(ir.Ir.aidx, bv, i, 0, e, 64)
        let lskip : i64 = self.label()
        self.ir(ir.Ir.jz, e, lskip, 0, 0, 0)
        self.ir(ir.Ir.apush, out, i, 0, 0, 0)
        self.ir(ir.Ir.label, lskip, 0, 0, 0, 0)
        self.loop_close(i)
        out

    // v[ix]: the elements at each index, a fresh array of them
    fn lower_gather(&mut self, av : i64, iv : i64, aty : i64, pn : i64, w : i64) → i64:
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, iv, 0, 0, n, 0)
        let out : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, out, 0)
        let i : i64 = self.loop_over(n)
        let k : i64 = self.tmp()
        self.ir(ir.Ir.aidx, iv, i, 0, k, 0)
        // a sized array lives in the frame as its elements, and is
        // read as farr_load reads it; any other is a descriptor
        let e : i64 = if pn >= 0: self.farr_load(av, aty, pn, k, ⁻1) else: self.tmp()
        if pn < 0:
            self.ir(ir.Ir.aidx, av, k, 0, e, w)
        self.ir(ir.Ir.apush, out, e, 0, 0, 0)
        self.loop_close(i)
        out

    // v[ix] ← w: each index takes w, or its own element of w where w
    // is an array -- of the same length, or the program stops
    fn lower_amend(&mut self, sid : i64, bv : i64, iv : i64, vv : i64, by_elem : bool, aty : i64, pn : i64, w : i64):
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, iv, 0, 0, n, 0)
        if by_elem:
            let m : i64 = self.tmp()
            self.ir(ir.Ir.alen, vv, 0, 0, m, 0)
            let same : i64 = self.tmp()
            self.ir(ir.Ir.ceq, n, m, 0, same, 64 + 256)
            let lok : i64 = self.label()
            self.ir(ir.Ir.jnz, same, lok, 0, 0, 0)
            let msg : i64 = self.intern("an amend writes one value at each index, and the indices and the values differ in number (line " ⧺ tokens.i64_str(@dropunit(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]))) ⧺ ")\n")
            self.ir(ir.Ir.abort, msg, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lok, 0, 0, 0, 0)
        let i : i64 = self.loop_over(n)
        let k : i64 = self.tmp()
        self.ir(ir.Ir.aidx, iv, i, 0, k, 0)
        let e : i64 = self.tmp()
        if by_elem:
            self.ir(ir.Ir.aidx, vv, i, 0, e, w)
        else:
            self.ir(ir.Ir.mov, vv, 0, 0, e, 0)
        if pn >= 0:
            self.farr_store(bv, aty, pn, k, ⁻1, e)
        else:
            self.ir(ir.Ir.asto, bv, k, e, 0, 0)
        self.loop_close(i)

    // one step of an operator fold: acc op e, at the elements' width
    fn fold_op(&mut self, op : i64, acc : i64, e : i64, et : i64) → i64:
        let d : i64 = self.tmp()
        let w : i64 = width_of(et)
        if op = ast.Nk.ccat.ord():
            if et = types.TY_STR:
                self.ir(ir.Ir.sccat, acc, e, 0, d, 0)
            else:
                self.ir(ir.Ir.acat, acc, e, 0, d, 0)
            return d
        let o : ir.Ir = if op = ast.Nk.add.ord():
            ir.Ir.add
        elif op = ast.Nk.sub.ord():
            ir.Ir.sub
        elif op = ast.Nk.mul.ord():
            ir.Ir.mul
        elif op = ast.Nk.satadd.ord():
            ir.Ir.satadd
        elif op = ast.Nk.satsub.ord():
            ir.Ir.satsub
        elif op = ast.Nk.satmul.ord():
            ir.Ir.satmul
        elif op = ast.Nk.maxop.ord():
            ir.Ir.maxx
        elif op = ast.Nk.minop.ord():
            ir.Ir.minn
        elif op = ast.Nk.band.ord() or op = ast.Nk.land.ord():
            ir.Ir.band
        elif op = ast.Nk.bor.ord() or op = ast.Nk.lor.ord():
            ir.Ir.borr
        elif op = ast.Nk.bxor.ord():
            ir.Ir.bxorr
        elif op = ast.Nk.shl.ord():
            ir.Ir.shll
        else:
            ir.Ir.shrr
        self.ir(o, acc, e, 0, d, if et = types.TY_BOOL: 64 else: w)
        d

    // f ⌿ v and f ⍀ v: the elements folded into one value.  Left, the
    // first element (or the value given) starts it and each next one
    // is folded in as f(acc, e); right, the last starts it and each
    // earlier one as f(e, acc).  Without a value to start from, an
    // empty array is nothing to fold and stops the program.
    fn lower_fold(&mut self, nid : i64, na : i64, nb : i64) → i64:
        let what : i64 = self.a.extra[nb × 1¤ptrdiff]
        let fo : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
        let init : i64 = self.a.extra[(nb + 2) × 1¤ptrdiff]
        let down : bool = self.a.extra[(nb + 3) × 1¤ptrdiff] = 1
        let f : i64 = self.a.nc[nid × 1¤ptrdiff]
        let et : i64 = self.elem_of(types.ty_strip_ref(self.tof(na)))
        let bx : i64 = if what = 2: self.lower_expr(fo) else: 0
        let cv : i64 = if types.ty_is_rg(types.ty_strip_ref(self.tof(na))): self.lower_rg_arr(na) else: self.lower_expr(na)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, cv, 0, 0, n, 0)
        let acc : i64 = self.tmp()
        let one : i64 = self.iconst(1)
        let i : i64 = self.tmp()
        // where the fold starts, and which element comes first
        if init ≠ ⁻1:
            let iv : i64 = self.lower_expr(init)
            self.ir(ir.Ir.mov, iv, 0, 0, acc, 0)
            if down:
                self.ir(ir.Ir.subw, n, one, 0, i, 64 + 256)
            else:
                self.ir(ir.Ir.const, 0, 0, 0, i, 0)
        else:
            let lok : i64 = self.label()
            self.ir(ir.Ir.jnz, n, lok, 0, 0, 0)
            let m : i64 = self.intern("a fold of nothing has nothing to start from (line " ⧺ tokens.i64_str(@dropunit(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]))) ⧺ ")\n")
            self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lok, 0, 0, 0, 0)
            let first : i64 = self.tmp()
            if down:
                self.ir(ir.Ir.subw, n, one, 0, first, 64 + 256)
                self.ir(ir.Ir.subw, first, one, 0, i, 64 + 256)
            else:
                self.ir(ir.Ir.const, 0, 0, 0, first, 0)
                self.ir(ir.Ir.mov, one, 0, 0, i, 0)
            self.ir(ir.Ir.aidx, cv, first, 0, acc, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let more : i64 = self.tmp()
        if down:
            let z : i64 = self.iconst(0)
            self.ir(ir.Ir.cge, i, z, 0, more, 64 + 256)
        else:
            self.ir(ir.Ir.clt, i, n, 0, more, 64 + 256)
        self.ir(ir.Ir.jz, more, lend, 0, 0, 0)
        let e : i64 = self.tmp()
        self.ir(ir.Ir.aidx, cv, i, 0, e, 0)
        let r : i64 = self.tmp()
        if what = 1:
            let r1 : i64 = if down: self.fold_op(fo, e, acc, et) else: self.fold_op(fo, acc, e, et)
            self.ir(ir.Ir.mov, r1, 0, 0, r, 0)
        else:
            let r2 : i64 = self.call_fn(f, bx, if down: [e, acc] else: [acc, e], if f = ⁻1: 0 else: self.retw(f))
            self.ir(ir.Ir.mov, r2, 0, 0, r, 0)
        self.ir(ir.Ir.mov, r, 0, 0, acc, 0)
        let ni : i64 = self.tmp()
        if down:
            self.ir(ir.Ir.subw, i, one, 0, ni, 64 + 256)
        else:
            self.ir(ir.Ir.addw, i, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, i, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        acc

    fn iconst(&mut self, v : i64) → i64:
        let d : i64 = self.tmp()
        self.ir(ir.Ir.const, v, 0, 0, d, 0)
        d

    fn rt0(&mut self, target : i64) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(0)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.call, target, off, 0, d, 0)
        d

    fn rt1(&mut self, target : i64, a0 : i64) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(1)
        self.extra.push(a0)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.call, target, off, 0, d, 0)
        d

    fn rt2(&mut self, target : i64, a0 : i64, a1 : i64) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(2)
        self.extra.push(a0)
        self.extra.push(a1)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.call, target, off, 0, d, 0)
        d

    fn rt3(&mut self, target : i64, a0 : i64, a1 : i64, a2 : i64) → i64:
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(3)
        self.extra.push(a0)
        self.extra.push(a1)
        self.extra.push(a2)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.call, target, off, 0, d, 0)
        d

    fn lower_expr(&mut self, nid : i64) → i64:
        let v0 : i64 = self.lower_expr_i(nid)
        let v : mut i64 = v0
        let cw : i64 = self.ncvt[nid × 1¤ptrdiff]
        if cw ≠ 0:
            // Going the other way is a widening: the value is right in
            // its own bits and says nothing above them, so it is put
            // into the canonical form the wider read expects.  Coming
            // down is a narrowing, and the run stops where a value does
            // not fit, as the interpreter does.
            let up : bool = types.ty_is_int(cw) and types.ty_is_int(self.tof(nid)) and types.ty_bits(cw) > types.ty_bits(self.tof(nid))
            let d : i64 = self.tmp()
            if up:
                self.ir(ir.Ir.ext, v, 0, 0, d, width_of(self.tof(nid)))
            else:
                self.ir(ir.Ir.narrow, v, 0, 0, d, width_of(cw))
            v ← d
        // Two things can be wanted of a value on its way into a
        // stated type, and `int?` wants both, so nhold says them
        // separately: bit 1 to be made into an int, bit 0 to be held in
        // an optional.  In that order -- what is held is what the
        // optional holds, which is the int and not the number it was.
        let hv : i64 = self.nhold[nid × 1¤ptrdiff]
        let vh : mut i64 = v
        if (hv & 2) = 2:
            // made into an int: every fixed width fits one, and a
            // number written down is one where an int was wanted
            vh ← self.rt1(emit.RT_BIGFROM, v)
        if (hv & 1) = 0:
            return vh
        // A value meeting a stated optional type is held in one.  Every
        // position where a value meets a stated type comes through
        // here, so saying it once says it for the binding, the
        // argument, the field, the element and the answer alike.  The
        // width is settled first: what is held is the value the type
        // asked for.
        let b : i64 = self.tmp()
        self.ir(ir.Ir.snew, 1, 0, 0, b, 0)
        self.ir(ir.Ir.fsto, b, 0, vh, 0, 0)
        b

    fn lower_expr_i(&mut self, nid : i64) → i64:
        let k : ast.Nk = self.kof(nid)
        let tok : i64 = self.a.ntok[nid × 1¤ptrdiff]
        let na : i64 = self.a.na[nid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[nid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[nid × 1¤ptrdiff]
        let w : i64 = width_of(self.tof(nid))
        if k = ast.Nk.lit_int or k = ast.Nk.lit_bool:
            let d : i64 = self.tmp()
            self.ir(ir.Ir.const, na, 0, 0, d, w)
            return d
        if k = ast.Nk.lit_str:
            let d : i64 = self.tmp()
            self.ir(ir.Ir.sc, na, 0, 0, d, w)
            return d
        if k = ast.Nk.var:
            let slot : i64 = self.nslot[nid × 1¤ptrdiff]
            if slot <= ⁻2:
                let d : i64 = self.tmp()
                self.ir(ir.Ir.gload, 0 - slot - 2, 0, 0, d, w)
                return d
            if self.a.nb[nid × 1¤ptrdiff] = 1:
                // an element reference: the slot holds the address
                let d : i64 = self.tmp()
                self.ir(ir.Ir.fld, slot, 0, 0, d, w)
                return d
            return slot
        if k = ast.Nk.arrlit:
            return self.lower_arrlit(nid, na)
        if k = ast.Nk.hlit:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            // a group is sixteen slots wide, so a table is at least one
            let cap : mut i64 = 16
            while cap × 7 < (n + 1) × 8:
                cap ← cap × 2
            let keystr : i64 = if types.ty_hkey(self.tof(nid)) = types.TY_STR: 1 else: 0
            let d : i64 = self.tmp()
            self.ir(ir.Ir.hnew, cap, keystr, 0, d, 0)
            foreach i := 0…n:
                let kv : i64 = self.lower_expr(self.a.extra[(na + 1 + i × 2) × 1¤ptrdiff])
                let vv : i64 = self.lower_expr(self.a.extra[(na + 2 + i × 2) × 1¤ptrdiff])
                self.ir(ir.Ir.hput, d, kv, vv, 0, 0)
            return d
        if k = ast.Nk.dropu:
            return self.lower_expr(na)
        if k = ast.Nk.mslice:
            return self.lower_mslice(nid, na, nb, nc)
        if k = ast.Nk.slice:
            if self.tof(na) = types.TY_STR:
                let sv : i64 = self.lower_expr(na)
                let slo : i64 = self.lower_expr(nb)
                let shi : i64 = self.lower_expr(nc)
                let sd : i64 = self.tmp()
                self.ir(ir.Ir.sslice, sv, slo, shi, sd, 0)
                return sd
            let av : i64 = self.lower_arr_operand(na)
            let lo : i64 = self.lower_expr(nb)
            let hi : i64 = self.lower_expr(nc)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.aslice, av, lo, hi, d, 0)
            return d
        if k = ast.Nk.each:
            return self.lower_each(nid, na, nb)
        if k = ast.Nk.where:
            return self.lower_where(na)
        if k = ast.Nk.grade:
            return self.lower_grade(na)
        if k = ast.Nk.join:
            return self.lower_join(na, nb)
        if k = ast.Nk.sslice:
            return self.lower_sslice(nid, na, nb)
        if k = ast.Nk.fold:
            return self.lower_fold(nid, na, nb)
        if k = ast.Nk.reshape:
            if types.ty_is_mat(self.tof(nid)):
                return self.lower_mreshape(nid, na, nb)
            let rpn : i64 = self.packed_n(nid)
            let rfa : bool = rpn >= 0
            let nv : i64 = self.lower_expr(na)
            if types.ty_is_rg(self.tof(nb)):
                let fvr : i64 = self.lower_rg_arr(nb)
                let dr : i64 = self.tmp()
                self.ir(ir.Ir.acyc, nv, fvr, 0, dr, 0)
                return if rfa: self.arr_to_farr(dr, self.tof(nid), rpn) else: dr
            let fv : i64 = if types.ty_is_arr(self.tof(nb)): self.lower_arr_operand(nb) else: self.lower_expr(nb)
            if rfa and not types.ty_is_arr(self.tof(nb)):
                // n ⍴ scalar into a sized binding: no array is built
                // for it, the frame is filled where it stands
                _ ← nv
                return self.farr_fill(self.tof(nid), rpn, fv)
            let d : i64 = self.tmp()
            if types.ty_is_arr(self.tof(nb)):
                self.ir(ir.Ir.acyc, nv, fv, 0, d, 0)
            else:
                self.ir(ir.Ir.afill, nv, fv, 0, d, 0)
            return if rfa: self.arr_to_farr(d, self.tof(nid), rpn) else: d
        if k = ast.Nk.tuple:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            let d : i64 = self.tmp()
            self.ir(ir.Ir.snew, n, 0, 0, d, 0)
            foreach i := 0…n:
                let ev : i64 = self.lower_expr(self.a.extra[(na + 1 + i) × 1¤ptrdiff])
                self.ir(ir.Ir.fsto, d, i, ev, 0, 0)
            return d
        if k = ast.Nk.slit:
            let n : i64 = self.a.extra[na × 1¤ptrdiff]
            let d : i64 = self.tmp()
            self.ir(ir.Ir.snew, n, 0, 0, d, 0)
            foreach i := 0…n:
                let fidx : i64 = self.a.extra[(na + 1 + i × 2) × 1¤ptrdiff]
                let fen : i64 = self.a.extra[(na + 2 + i × 2) × 1¤ptrdiff]
                let ev : i64 = self.field_val(self.lower_expr(fen), self.tof(fen))
                self.ir(ir.Ir.fsto, d, fidx, ev, 0, 0)
            // one of these has just been made, so what the type says is
            // always true of one has to be true of it
            self.lower_invariants(types.ty_strip_ref(self.tof(nid)), d)
            return d
        if k = ast.Nk.lambda:
            let loff : i64 = na
            let np9 : i64 = self.a.extra[loff × 1¤ptrdiff]
            let ncap9 : i64 = self.a.extra[(loff + 1 + np9 × 2) × 1¤ptrdiff]
            let ord9 : i64 = self.nslot[nid × 1¤ptrdiff]
            let d9l : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1 + ncap9, 0, 0, d9l, 0)
            let av9 : i64 = self.tmp()
            self.ir(ir.Ir.faddr, self.lambase + ord9, 0, 0, av9, 0)
            self.ir(ir.Ir.fsto, d9l, 0, av9, 0, 0)
            foreach ci9 := 0…ncap9:
                // the capture cell holds the outer slot -- or, below
                // zero, a function whose value-box is built here
                let cell9 : i64 = self.a.extra[(loff + 2 + np9 × 2 + ci9) × 1¤ptrdiff]
                if cell9 < 0:
                    let fb9 : i64 = self.tmp()
                    self.ir(ir.Ir.snew, 1, 0, 0, fb9, 0)
                    let fa9 : i64 = self.tmp()
                    self.ir(ir.Ir.faddr, 0 - cell9 - 1, 0, 0, fa9, 0)
                    self.ir(ir.Ir.fsto, fb9, 0, fa9, 0, 0)
                    self.ir(ir.Ir.fsto, d9l, 1 + ci9, fb9, 0, 0)
                else:
                    self.ir(ir.Ir.fsto, d9l, 1 + ci9, cell9, 0, 0)
            return d9l
        if k = ast.Nk.fnval:
            let d9f : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, d9f, 0)
            let av9f : i64 = self.tmp()
            self.ir(ir.Ir.faddr, na, 0, 0, av9f, 0)
            self.ir(ir.Ir.fsto, d9f, 0, av9f, 0, 0)
            return d9f
        if k = ast.Nk.try:
            if self.kof(na) = ast.Nk.div or self.kof(na) = ast.Nk.mod:
                // the zero divisor answers the function early with ∅
                let av9t : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let bv9t : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
                let lok9 : i64 = self.label()
                self.ir(ir.Ir.jnz, bv9t, lok9, 0, 0, 0)
                let zn9 : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, zn9, 0)
                self.lower_ret(zn9)
                self.ir(ir.Ir.label, lok9, 0, 0, 0, 0)
                let zd9 : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, zd9, 0)
                let dq9 : i64 = self.tmp()
                self.ir(if self.kof(na) = ast.Nk.div: ir.Ir.divv else: ir.Ir.modd, av9t, bv9t, zd9, dq9, width_of(self.tof(na)))
                return dq9
            let bx9 : i64 = self.lower_expr(na)
            let lok9b : i64 = self.label()
            self.ir(ir.Ir.jnz, bx9, lok9b, 0, 0, 0)
            let zn9b : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, zn9b, 0)
            self.lower_ret(zn9b)
            self.ir(ir.Ir.label, lok9b, 0, 0, 0, 0)
            let du9 : i64 = self.tmp()
            self.ir(ir.Ir.fld, bx9, 0, 0, du9, 0)
            return du9
        if k = ast.Nk.rangev:
            let lov9 : i64 = self.lower_expr(na)
            let hiv9 : i64 = self.lower_expr(nb)
            let stv9 : i64 = self.tmp()
            if nc = ⁻1:
                // no step written: the direction follows the bounds
                let c9 : i64 = self.tmp()
                self.ir(ir.Ir.cle, lov9, hiv9, 0, c9, 64 + 256)
                let one9 : i64 = self.tmp()
                self.ir(ir.Ir.const, 1, 0, 0, one9, 0)
                let mone9 : i64 = self.tmp()
                self.ir(ir.Ir.const, ⁻1, 0, 0, mone9, 0)
                self.ir(ir.Ir.sel, c9, one9, mone9, stv9, 0)
            else:
                let sv9 : i64 = self.lower_expr(nc)
                self.ir(ir.Ir.mov, sv9, 0, 0, stv9, 0)
            let d9r : i64 = self.tmp()
            self.ir(ir.Ir.snew, 3, 0, 0, d9r, 0)
            self.ir(ir.Ir.fsto, d9r, 0, lov9, 0, 0)
            self.ir(ir.Ir.fsto, d9r, 1, stv9, 0, 0)
            self.ir(ir.Ir.fsto, d9r, 2, hiv9, 0, 0)
            return d9r
        if k = ast.Nk.field:
            if types.ty_is_mat(types.ty_strip_ref(self.tof(na))):
                // shape: the row count and the first row's length; a
                // matrix is never empty, so the first row is there
                let mv : i64 = self.lower_expr(na)
                let d9 : i64 = self.tmp()
                self.ir(ir.Ir.anew, 4, 0, 0, d9, 0)
                let rl9 : i64 = self.tmp()
                self.ir(ir.Ir.alen, mv, 0, 0, rl9, 0)
                self.ir(ir.Ir.apush, d9, rl9, 0, 0, 0)
                let z9 : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, z9, 0)
                let r09 : i64 = self.tmp()
                self.ir(ir.Ir.aidx, mv, z9, 0, r09, 0)
                let cl9 : i64 = self.tmp()
                self.ir(ir.Ir.alen, r09, 0, 0, cl9, 0)
                self.ir(ir.Ir.apush, d9, cl9, 0, 0, 0)
                if self.mat_rank(types.ty_strip_ref(self.tof(na))) = 3:
                    // a cube's planes are matrices, so one step further
                    // in reaches the row whose length is the last extent
                    let r19 : i64 = self.tmp()
                    self.ir(ir.Ir.aidx, r09, z9, 0, r19, 0)
                    let dl9 : i64 = self.tmp()
                    self.ir(ir.Ir.alen, r19, 0, 0, dl9, 0)
                    self.ir(ir.Ir.apush, d9, dl9, 0, 0, 0)
                return d9
            let bv : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.fld, bv, nb, 0, d, 0)
            return d
        if k = ast.Nk.op_some:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, d, 0)
            self.ir(ir.Ir.fsto, d, 0, v, 0, 0)
            return d
        if k = ast.Nk.emptyv:
            let d : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, d, 0)
            return d
        if k = ast.Nk.index:
            if types.ty_is_tup(self.tof(na)):
                let av0 : i64 = self.lower_expr(na)
                let d0 : i64 = self.tmp()
                self.ir(ir.Ir.fld, av0, self.a.na[nb × 1¤ptrdiff], 0, d0, w)
                return d0
            if self.tof(na) = types.TY_STR:
                let av1 : i64 = self.lower_expr(na)
                let iv1 : i64 = self.lower_expr(nb)
                let d1 : i64 = self.tmp()
                self.ir(ir.Ir.sidx, av1, iv1, 0, d1, w)
                return d1
            let pni : i64 = self.packed_n(na)
            if types.ty_is_arr(types.ty_strip_ref(self.tof(nb))):
                // v[ix]: the elements at each index in ix
                let gav : i64 = self.lower_expr(na)
                let giv : i64 = self.lower_expr(nb)
                return self.lower_gather(gav, giv, self.tof(na), pni, width_of(self.elem_of(types.ty_strip_ref(self.tof(na)))))
            if pni >= 0:
                let fav : i64 = self.lower_expr(na)
                let ki : i64 = self.const_index(nb)
                let fiv : i64 = if ki ≠ ⁻1: 0 else: self.lower_expr(nb)
                return self.farr_load(fav, self.tof(na), pni, fiv, ki)
            let av : i64 = self.lower_expr(na)
            let iv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            if types.ty_is_hash(self.tof(na)):
                self.ir(ir.Ir.hget, av, iv, 0, d, 0)
            else:
                self.ir(ir.Ir.aidx, av, iv, 0, d, w)
            return d
        if k = ast.Nk.len:
            let av : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            if self.tof(na) = types.TY_STR:
                self.ir(ir.Ir.slenv, av, 0, 0, d, w)
            elif types.ty_is_hash(self.tof(na)):
                self.ir(ir.Ir.hlen, av, 0, 0, d, w)
            elif types.ty_is_tup(self.tof(na)):
                self.ir(ir.Ir.const, self.tup_len(self.tof(na)), 0, 0, d, w)
            elif self.packed_n(na) >= 0:
                // how many is settled, so nothing is read
                self.ir(ir.Ir.const, self.packed_n(na), 0, 0, d, w)
            else:
                self.ir(ir.Ir.alen, av, 0, 0, d, w)
            return d
        if k = ast.Nk.call:
            return self.lower_call(nid, tok, na × 1¤"aextra")
        if k = ast.Nk.run:
            return self.lower_run(na, nb, nc)
        if k = ast.Nk.quant:
            return self.lower_quant(nid, na, nb, nc)
        if k = ast.Nk.callv:
            let bx9 : i64 = self.lower_expr(na)
            let cargc : i64 = self.a.extra[nb × 1¤ptrdiff]
            if self.a.nc[nid × 1¤ptrdiff] = 5:
                return bx9
            let cav : mut i64[] = []
            foreach cj := 0…cargc:
                cav.push(self.lower_expr(self.a.extra[(nb + 1 + cj) × 1¤ptrdiff]))
            if self.a.nc[nid × 1¤ptrdiff] = 1:
                let coff : i64 = @dropunit(#self.extra)
                self.extra.push(cargc + 1)
                self.extra ← self.extra ⧺ cav
                self.extra.push(bx9)
                let cad : i64 = self.tmp()
                self.ir(ir.Ir.fld, bx9, 0, 0, cad, 0)
                let cd : i64 = self.tmp()
                self.ir(ir.Ir.calli, cad, coff, 0, cd, 0)
                return cd
            // a partial of the value: bind now, keep the source box
            let dp : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1 + cargc + 1, 0, 0, dp, 0)
            let ap : i64 = self.tmp()
            self.ir(ir.Ir.faddr, self.shimbase + self.nslot[nid × 1¤ptrdiff], 0, 0, ap, 0)
            self.ir(ir.Ir.fsto, dp, 0, ap, 0, 0)
            foreach ck := 0…cargc:
                self.ir(ir.Ir.fsto, dp, 1 + ck, cav[ck × 1¤ptrdiff], 0, 0)
            self.ir(ir.Ir.fsto, dp, 1 + cargc, bx9, 0, 0)
            return dp
        if k = ast.Nk.scall:
            if na = ast.Sb.args.ord():
                let d : i64 = self.tmp()
                if self.argsfix >= 0:
                    let coff : i64 = @dropunit(#self.extra)
                    self.extra.push(0)
                    self.ir(ir.Ir.call, self.argsfix, coff, 0, d, 0)
                else:
                    self.ir(ir.Ir.args, 0, 0, 0, d, 0)
                return d
            if na = ast.Sb.open.ord():
                let pv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(ir.Ir.fopen, pv, 0, 0, d, 0)
                return d
            if na = ast.Sb.fileid.ord():
                let pv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(ir.Ir.fidp, pv, 0, 0, d, 0)
                return d
            if na = ast.Sb.hasfile.ord():
                let pv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(ir.Ir.fthere, pv, 0, 0, d, 0)
                return d
            if na = ast.Sb.create.ord():
                let pv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let mv : i64 = self.lower_expr(self.a.extra[(nb + 2) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(ir.Ir.fcreate, pv, mv, 0, d, 0)
                return d
            if na = ast.Sb.cwd.ord():
                let d : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, d, 0)
                return d
            if na = ast.Sb.bytes.ord():
                let sv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(ir.Ir.sbytes, sv, 0, 0, d, 0)
                return d
            if na = ast.Sb.hstart.ord():
                let av : i64 = self.tmp()
                self.ir(ir.Ir.const, self.a.nc[nid × 1¤ptrdiff], 0, 0, av, 0)
                let d : i64 = self.tmp()
                self.ir(ir.Ir.hstart, av, 0, 0, d, 0)
                return d
            if na = ast.Sb.hdigest.ord():
                // A message already in hand is the same thing said in
                // three steps, so it is: one implementation of the
                // algorithm, not two that could drift apart.
                let av : i64 = self.tmp()
                self.ir(ir.Ir.const, self.a.nc[nid × 1¤ptrdiff], 0, 0, av, 0)
                let hv : i64 = self.tmp()
                self.ir(ir.Ir.hstart, av, 0, 0, hv, 0)
                self.ir(ir.Ir.hupdate, hv, self.lower_hash_arg(self.a.extra[(nb + 1) × 1¤ptrdiff]), 0, 0, 0)
                let dst : i64 = self.farr_new(self.tof(nid), self.packed_ty_n(self.tof(nid)))
                let d : i64 = self.tmp()
                self.ir(ir.Ir.hfinal, hv, dst, 0, d, 0)
                return d
            if na = ast.Sb.iov.ord():
                return self.lower_iov(self.a.extra[(nb + 1) × 1¤ptrdiff])
            if na = ast.Sb.allocator.ord():
                let d : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, d, 0)
                return d
            if na = ast.Sb.proc.ord():
                if nb = ast.Proc.execfn.ord():
                    let d : i64 = self.tmp()
                    self.ir(ir.Ir.execfn, 0, 0, 0, d, 0)
                    return d
                let v : i64 = self.tmp()
                self.ir(ir.Ir.auxv, ast.proc_key(nb), 0, 0, v, 0)
                if nb ≠ ast.Proc.secure.ord():
                    return v
                // secure is what the kernel set, said as a truth value
                let z : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, z, 0)
                let b : i64 = self.tmp()
                self.ir(ir.Ir.cne, v, z, 0, b, 64)
                return b
            if na = ast.Sb.envn.ord():
                let d : i64 = self.tmp()
                self.ir(ir.Ir.envn, 0, 0, 0, d, 0)
                return d
            if na = ast.Sb.envg.ord() or na = ast.Sb.envh.ord():
                let nv : i64 = self.lower_expr(self.a.extra[(nb + 1) × 1¤ptrdiff])
                let d : i64 = self.tmp()
                self.ir(ir.Ir.envg, nv, 0, 0, d, 0)
                if na = ast.Sb.envg.ord():
                    return d
                // has: the box is there, or it is not
                let z : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, z, 0)
                let b : i64 = self.tmp()
                self.ir(ir.Ir.cne, d, z, 0, b, 64)
                return b
            self.lower_scall(nid, tok, na, nb × 1¤"aextra")
            return ⁻1
        if k = ast.Nk.mcall:
            return self.lower_mcall(nid, ⁻1)
        if k = ast.Nk.ref:
            return self.lower_expr(na)
        if k = ast.Nk.neg:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            self.ir(if self.in_wrap > 0: ir.Ir.negw else: ir.Ir.neg, v, 0, 0, d, w)
            return d
        if k = ast.Nk.bnot:
            let v : i64 = self.lower_expr(na)
            let d : i64 = self.tmp()
            let t9 : i64 = types.ty_strip_ref(self.tof(nid))
            if types.ty_is_enum(t9):
                // the complement stays within the set's own bits
                let ei : i64 = types.ty_eidx(t9)
                let st : i64 = self.a.estart[ei × 1¤ptrdiff]
                let nm : i64 = self.a.ecount[ei × 1¤ptrdiff]
                let msk : mut i64 = 0
                foreach mi := 0…nm:
                    msk ← msk | self.a.evalues[(st + mi) × 1¤ptrdiff]
                let flipped : i64 = self.tmp()
                self.ir(ir.Ir.bnott, v, 0, 0, flipped, 64)
                let mv : i64 = self.tmp()
                self.ir(ir.Ir.const, msk, 0, 0, mv, 0)
                self.ir(ir.Ir.band, flipped, mv, 0, d, 64)
                return d
            self.ir(ir.Ir.bnott, v, 0, 0, d, w)
            return d
        if k = ast.Nk.op_not:
            // the operand is a bool, 0 or 1; flipping it is one xor
            let v : i64 = self.lower_expr(na)
            let one : i64 = self.tmp()
            self.ir(ir.Ir.const, 1, 0, 0, one, 64)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.bxorr, v, one, 0, d, 64)
            return d
        if k = ast.Nk.op_wrap:
            self.in_wrap ← self.in_wrap + 1
            let v : i64 = self.lower_expr(na)
            self.in_wrap ← self.in_wrap - 1
            return v
        if k = ast.Nk.st_if:
            return self.lower_ife(nid, na, nb, nc)
        if k = ast.Nk.ifield:
            let d : i64 = self.tmp()
            self.ir(ir.Ir.fld, self.inv_subject, na, 0, d, width_of(self.tof(nid)))
            return d
        if k = ast.Nk.old:
            // read before the body ran, and kept in a slot of its own
            return self.old_base + nb
        if k = ast.Nk.matche:
            let dm : i64 = self.tmp()
            self.lower_matche(nid, na, nb, nc, types.TY_UNIT, false, dm)
            return dm
        if k = ast.Nk.st_match:
            // ⊨ binds what the optional holds; ∅ is the other way out
            let dv : i64 = self.tmp()
            let sv : i64 = self.lower_expr(na)
            let bind : i64 = self.nslot[nid × 1¤ptrdiff]
            let lempty : i64 = self.label()
            let lend : i64 = self.label()
            let toopt : bool = types.ty_is_opt(self.tof(nid))
            self.ir(ir.Ir.jz, sv, lempty, 0, 0, 0)
            self.ir(ir.Ir.fld, sv, 0, 0, bind, 0)
            self.lower_block_value(self.a.extra[nb × 1¤ptrdiff], dv, toopt)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lempty, 0, 0, 0, 0)
            self.lower_block_value(self.a.extra[(nb + 1) × 1¤ptrdiff], dv, toopt)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
            return dv
        if k = ast.Nk.default:
            return self.lower_default(nid, na, nb)
        if k = ast.Nk.op_and or k = ast.Nk.op_or:
            return self.lower_andor(nid, k, na, nb)
        if k = ast.Nk.elemof:
            let kv2 : i64 = self.lower_expr(na)
            let hv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            if types.ty_is_arr(types.ty_strip_ref(self.tof(nb))):
                // where it sits, if anywhere: the boxed position or the
                // null, and being there is the null not answered
                let sf : i64 = if self.elem_of(types.ty_strip_ref(self.tof(nb))) = types.TY_STR: 1 else: 0
                let at : i64 = self.tmp()
                self.ir(ir.Ir.afind, hv, kv2, sf, at, 0)
                let z : i64 = self.iconst(0)
                self.ir(ir.Ir.cne, at, z, 0, d, 64)
                return d
            self.ir(ir.Ir.helem, hv, kv2, 0, d, 0)
            return d
        if k = ast.Nk.ccat:
            if types.ty_is_arr(self.tof(nid)):
                let aav : i64 = self.lower_arr_operand(na)
                let abv : i64 = self.lower_arr_operand(nb)
                let ad : i64 = self.tmp()
                self.ir(ir.Ir.acat, aav, abv, 0, ad, 0)
                return ad
            let av0 : i64 = self.lower_expr(na)
            let av : mut i64 = av0
            if self.tof(na) = types.TY_CHAR:
                let ta : i64 = self.tmp()
                self.ir(ir.Ir.charstr, av0, 0, 0, ta, 0)
                av ← ta
            let bv0 : i64 = self.lower_expr(nb)
            let bv : mut i64 = bv0
            if self.tof(nb) = types.TY_CHAR:
                let tb : i64 = self.tmp()
                self.ir(ir.Ir.charstr, bv0, 0, 0, tb, 0)
                bv ← tb
            let d : i64 = self.tmp()
            self.ir(ir.Ir.sccat, av, bv, 0, d, w)
            return d
        if k = ast.Nk.eq or k = ast.Nk.ne:
            if types.ty_is_opt(self.tof(na)) and types.ty_is_opt(self.tof(nb)):
                let d0 : i64 = self.lower_opt_eq(na, nb)
                if k = ast.Nk.ne:
                    let zz : i64 = self.tmp()
                    self.ir(ir.Ir.const, 0, 0, 0, zz, 64)
                    let d1 : i64 = self.tmp()
                    self.ir(ir.Ir.ceq, d0, zz, 0, d1, 64)
                    return d1
                return d0
            if self.tof(na) = types.TY_STR:
                let av : i64 = self.lower_expr(na)
                let bv : i64 = self.lower_expr(nb)
                let d : i64 = self.tmp()
                self.ir(ir.Ir.seqv, av, bv, 0, d, 64)
                if k = ast.Nk.ne:
                    let z : i64 = self.tmp()
                    self.ir(ir.Ir.const, 0, 0, 0, z, 64)
                    let d2 : i64 = self.tmp()
                    self.ir(ir.Ir.ceq, d, z, 0, d2, 64)
                    return d2
                return d
        // a listable operator handed an array is the loop that asks
        // it of each element; the checker marked the node where it is
        if nc = 1:
            return self.lower_thread_op(nid, k, na, nb, ⁻1)
        // the remaining family evaluates both sides
        let av : i64 = self.lower_expr(na)
        let bv : i64 = self.lower_expr(nb)
        return self.lower_binop_vals(k, av, bv, self.tof(na), self.tof(nb), self.tof(nid), w)

    // One turn of an operator: the two values, the types they came
    // from and the type they answer.  Written apart from the node so
    // that a threaded operator can ask for one element's worth of it
    // as many times as the container is long.
    // @pre av >= 0 and bv >= 0
    fn lower_binop_vals(&mut self, k : ast.Nk, av : i64, bv : i64, ta : i64, tb : i64, tres : i64, w : i64) → i64:
        let d : i64 = self.tmp()
        let owa : i64 = width_of(ta)
        let owb : i64 = width_of(tb)
        // mixed sides compare at the wider width; where signedness
        // mixes the checker admitted only unsigned-narrower-than-
        // signed, and the signed side's width carries the compare
        let ow : mut i64 = owa
        if (owa » 8) ≠ (owb » 8):
            ow ← if (owa » 8) = 1: owa else: owb
        elif (owb & 255) > (owa & 255):
            ow ← owb
        if types.ty_is_bigint(ta) and not types.ty_is_bigint(tres):
            // Comparing two ints answers a truth value, so the width
            // settled above says nothing about the operands and the
            // ordinary compare would ask its question of two addresses.
            // The runtime compares them and answers ⁻1, 0 or 1, and the
            // ordering is then asked of that, where a width does mean
            // something.
            assert(k = ast.Nk.eq or k = ast.Nk.ne or k = ast.Nk.lt or k = ast.Nk.le or k = ast.Nk.gt or k = ast.Nk.ge,
                   "an int whose answer is not an int was compared")
            let c : i64 = self.rt2(emit.RT_BIGCMP, av, bv)
            let z : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, z, 64)
            let op : ir.Ir = if k = ast.Nk.eq:
                ir.Ir.ceq
            elif k = ast.Nk.ne:
                ir.Ir.cne
            elif k = ast.Nk.lt:
                ir.Ir.clt
            elif k = ast.Nk.le:
                ir.Ir.cle
            elif k = ast.Nk.gt:
                ir.Ir.cgt
            else:
                ir.Ir.cge
            // signed: the answer is ⁻1, 0 or 1, and unsigned would read
            // the ⁻1 as the largest number there is
            self.ir(op, c, z, 0, d, 64 + 256)
            return d
        if types.ty_is_bigint(tres):
            // int carries its own arithmetic, in the runtime: there is
            // no width here for a machine instruction to work at
            if k = ast.Nk.add:
                return self.rt3(emit.RT_BIGADD, av, bv, self.iconst(0))
            if k = ast.Nk.sub:
                return self.rt3(emit.RT_BIGADD, av, bv, self.iconst(1))
            if k = ast.Nk.mul:
                return self.rt2(emit.RT_BIGMUL, av, bv)
            // ÷ and % over an int are not written yet; the checker
            // says so before this is reached
            return av
        match k:
            ast.Nk.add:
                self.ir(if self.in_wrap > 0: ir.Ir.addw else: ir.Ir.add, av, bv, 0, d, w)
                if tres = types.TY_CHAR:
                    // a character and a number make the character that far
                    // on, and what is no character stops the program: the
                    // same judgement .chr() makes, made where the sum is
                    let c9 : i64 = self.tmp()
                    self.ir(ir.Ir.chr, d, 0, 0, c9, w)
                    return c9
            ast.Nk.sub:
                self.ir(if self.in_wrap > 0: ir.Ir.subw else: ir.Ir.sub, av, bv, 0, d, w)
            ast.Nk.mul:
                self.ir(if self.in_wrap > 0: ir.Ir.mulw else: ir.Ir.mul, av, bv, 0, d, w)
            ast.Nk.shl:
                self.ir(ir.Ir.shll, av, bv, 0, d, w)
            ast.Nk.shr:
                self.ir(ir.Ir.shrr, av, bv, 0, d, w)
            ast.Nk.band:
                self.ir(ir.Ir.band, av, bv, 0, d, w)
            ast.Nk.bor:
                self.ir(ir.Ir.borr, av, bv, 0, d, w)
            ast.Nk.bxor:
                self.ir(ir.Ir.bxorr, av, bv, 0, d, w)
            ast.Nk.eq:
                self.ir(ir.Ir.ceq, av, bv, 0, d, ow)
            ast.Nk.ne:
                self.ir(ir.Ir.cne, av, bv, 0, d, ow)
            ast.Nk.lt:
                self.ir(ir.Ir.clt, av, bv, 0, d, ow)
            ast.Nk.le:
                self.ir(ir.Ir.cle, av, bv, 0, d, ow)
            ast.Nk.gt:
                self.ir(ir.Ir.cgt, av, bv, 0, d, ow)
            ast.Nk.ge:
                self.ir(ir.Ir.cge, av, bv, 0, d, ow)
            ast.Nk.land, ast.Nk.lor:
                // both sides are bools already; one and or or does it
                self.ir(if k = ast.Nk.land: ir.Ir.band else: ir.Ir.borr, av, bv, 0, d, 64)
            ast.Nk.lxor:
                self.ir(ir.Ir.cne, av, bv, 0, d, 64)
            ast.Nk.lnand, ast.Nk.lnor:
                let tt : i64 = self.tmp()
                self.ir(if k = ast.Nk.lnand: ir.Ir.band else: ir.Ir.borr, av, bv, 0, tt, 64)
                let c1 : i64 = self.tmp()
                self.ir(ir.Ir.const, 1, 0, 0, c1, 64)
                self.ir(ir.Ir.bxorr, tt, c1, 0, d, 64)
            ast.Nk.iota:
                let sf : i64 = if self.elem_of(ta) = types.TY_STR: 1 else: 0
                self.ir(ir.Ir.afind, av, bv, sf, d, 0)
            ast.Nk.satadd:
                self.ir(ir.Ir.satadd, av, bv, 0, d, w)
            ast.Nk.satsub:
                self.ir(ir.Ir.satsub, av, bv, 0, d, w)
            ast.Nk.satmul:
                self.ir(ir.Ir.satmul, av, bv, 0, d, w)
            ast.Nk.maxop:
                self.ir(ir.Ir.maxx, av, bv, 0, d, w)
            ast.Nk.minop:
                self.ir(ir.Ir.minn, av, bv, 0, d, w)
            _:
                // no other kind reaches here; the checker said which do
                _ ← 0
        return d

    // A listable operator handed an array asks itself of each of the
    // elements and answers an array of what they said.  The container
    // says how many turns; a value operand stands still and is read
    // once, outside the loop, since it is the same at every turn.
    // Where both sides are containers they meet element against
    // element, so their lengths have to agree.  dstside says which
    // side's array the answers are written into -- 0 the left, 1 the
    // right, ⁻1 for an array of its own.
    // @pre self.a.nc[nid × 1¤ptrdiff] = 1
    // @pre dstside >= ⁻1 and dstside <= 1
    // @post @result >= 0
    fn lower_thread_op(&mut self, nid : i64, k : ast.Nk, na : i64, nb : i64, dstside : i64) → i64:
        // a sized array lives in the frame as its elements; the loop
        // reads an object, so it is made into one first
        let av : i64 = self.lower_arr_operand(na)
        let bv : i64 = self.lower_arr_operand(nb)
        let ta : i64 = types.ty_strip_ref(self.tof(na))
        let tb : i64 = types.ty_strip_ref(self.tof(nb))
        let la : bool = types.ty_is_arr(ta)
        let lb : bool = types.ty_is_arr(tb)
        assert(la or lb, "a threaded operator has a container to thread over")
        let ea : i64 = if la: self.elem_of(ta) else: ta
        let eb : i64 = if lb: self.elem_of(tb) else: tb
        let er : i64 = self.elem_of(self.tof(nid))
        let ew : i64 = width_of(er)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, if la: av else: bv, 0, 0, n, 0)
        if la and lb:
            let n2 : i64 = self.tmp()
            self.ir(ir.Ir.alen, bv, 0, 0, n2, 0)
            let same : i64 = self.tmp()
            self.ir(ir.Ir.ceq, n, n2, 0, same, 64 + 256)
            let lok : i64 = self.label()
            self.ir(ir.Ir.jnz, same, lok, 0, 0, 0)
            // What is wrong is which two lengths did not meet, so the
            // report says them rather than only that they differed.
            // The words are the interpreter's, which says the same
            // thing where it checks as it evaluates.
            self.ir(ir.Ir.eprints, self.intern(self.text(self.a.ntok[nid × 1¤ptrdiff]) ⧺ """: the operands it threads over are taken apart
                                                                  " together, so they must be the same length, but the
                                                                  " left operand has """), 0, 0, 0, 0)
            _ ← self.rt1(emit.RT_EPRINTI, n)
            self.ir(ir.Ir.eprints, self.intern(" elements and the right operand has "), 0, 0, 0, 0)
            _ ← self.rt1(emit.RT_EPRINTI, n2)
            self.ir(ir.Ir.abort, self.intern("\n"), 0, 0, 0, 0)
            self.ir(ir.Ir.label, lok, 0, 0, 0, 0)
        // where the answer goes: the array one side already names, or
        // a fresh one where neither side is the place being written
        let d : mut i64 = if dstside = 1: bv else: av
        if dstside < 0:
            let fresh : i64 = self.tmp()
            self.ir(ir.Ir.anew, 4, 0, 0, fresh, 0)
            d ← fresh
        let iv : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, iv, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c : i64 = self.tmp()
        self.ir(ir.Ir.clt, iv, n, 0, c, 64 + 256)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        let xa : mut i64 = av
        if la:
            let e1 : i64 = self.tmp()
            self.ir(ir.Ir.aidx, av, iv, 0, e1, 0)
            xa ← e1
        let xb : mut i64 = bv
        if lb:
            let e2 : i64 = self.tmp()
            self.ir(ir.Ir.aidx, bv, iv, 0, e2, 0)
            xb ← e2
        let r : i64 = self.lower_binop_vals(k, xa, xb, ea, eb, er, ew)
        // into the array that is already the right length, or onto the
        // end of the one being built
        if dstside < 0:
            self.ir(ir.Ir.apush, d, r, 0, 0, 0)
        else:
            self.ir(ir.Ir.asto, d, iv, r, 0, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, iv, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, iv, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    // What a let binds.  `let v := w`, where w names a container, gives
    // v an array of its own holding what w holds, so that what happens
    // to w afterwards is w's business; `let v : & = w` is how a program
    // asks for the other thing, and everything else is already fresh.
    // @post @result >= 0
    fn lower_let_value(&mut self, sid : i64, na : i64) → i64:
        let v : i64 = self.lower_expr(na)
        if not self.binds_a_copy(sid, na):
            return v
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, v, 0, 0, n, 0)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.aslice, v, self.iconst(0), n, d, 0)
        d

    // Whether this let takes a copy: the value is an array that a place
    // already names, and the binding did not ask to borrow it.  A sized
    // array is copied into the frame however it is written, and a
    // gather, a slice or a call already answers an array of its own.
    fn binds_a_copy(&self, sid : i64, na : i64) → bool:
        if sid ∊ self.a.blets or self.packed_n(na) >= 0:
            return false
        types.ty_is_arr(types.ty_strip_ref(self.tof(na))) and self.plain_place(na)

    // A binding or a field of one, all the way down.  A subscript is
    // left out on purpose: an element of a matrix is a row of it, and
    // rows are how a matrix is worked, so a binding of one names it.
    fn plain_place(&self, e : i64) → bool:
        match self.kof(e):
            ast.Nk.var:
                true
            ast.Nk.field:
                self.plain_place(self.a.na[e × 1¤ptrdiff])
            _:
                false

    fn lower_ife(&mut self, nid : i64, na : i64, nb : i64, nc : i64) → i64:
        // Where each branch is one expression and both may be read
        // without harm, neither is worth a jump: read both and choose.
        // That is what the machine's conditional move is for, and it
        // is why an if written for its value costs no branch when it
        // is the small kind.
        let tv0 : i64 = self.block_value_of(nb)
        let ev0 : mut i64 = ⁻1
        if nc ≠ ⁻1:
            ev0 ← self.block_value_of(nc)
        let sel : bool = tv0 ≠ ⁻1 and ev0 ≠ ⁻1 and self.speculatable(tv0) and self.speculatable(ev0)
        self.decide(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]),
                    if sel: "select" else: "branched-conditional", "")
        if sel:
            let cv : i64 = self.lower_expr(na)
            let tv : i64 = self.lower_expr(tv0)
            let ev : i64 = self.lower_expr(ev0)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.sel, cv, tv, ev, d, width_of(self.tof(nid)))
            return d
        // With no else the value is optional and the fall-through is
        // ∅, which is how an if that can fall past its branch still
        // answers on every path.
        let noelse : bool = nc = ⁻1
        // Where the if answers an optional, a branch that answers the
        // base type is held on the way out; one that already answers
        // an optional, or says ∅, is what it is.
        let toopt : bool = types.ty_is_opt(self.tof(nid))
        let d : i64 = self.tmp()
        let lelse : i64 = self.label()
        let lend : i64 = self.label()
        let cv : i64 = self.lower_expr(na)
        self.ir(ir.Ir.jz, cv, lelse, 0, 0, 0)
        self.lower_block_value(nb, d, toopt)
        self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lelse, 0, 0, 0, 0)
        if noelse:
            self.ir(ir.Ir.const, 0, 0, 0, d, 0)
        else:
            self.lower_block_value(nc, d, toopt)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    // Whether an if answers with a choice rather than a branch: it
    // has both sides, each is one expression, and neither can come to
    // harm from being read where the other was chosen.
    fn if_selectable(&mut self, sid : i64) → bool:
        let nc : i64 = self.a.nc[sid × 1¤ptrdiff]
        if nc = ⁻1:
            return false
        let tv : i64 = self.block_value_of(self.a.nb[sid × 1¤ptrdiff])
        let ev : i64 = self.block_value_of(nc)
        if tv = ⁻1 or ev = ⁻1:
            return false
        self.speculatable(tv) and self.speculatable(ev)


    // One branch of such an if: every statement but the last as
    // itself, and the last written into the destination.  A branch
    // that leaves rather than answering writes nothing, having
    // nowhere to arrive from.
    fn lower_block_value(&mut self, blk : i64, d : i64, toopt : bool):
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        // every statement but the last, and an empty block has none
        foreach i := 0…(n - 1) ⌈ 0:
            self.lower_stmt(self.a.extra[(off + 1 + i) × 1¤ptrdiff], false, types.TY_UNIT)
        if n > 0:
            let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
            let lk : ast.Nk = self.kof(last)
            if lk = ast.Nk.exprstmt:
                let e : i64 = self.a.na[last × 1¤ptrdiff]
                let v : i64 = self.lower_expr(e)
                self.lower_into(v, d, self.holds(toopt, e))
            elif lk = ast.Nk.st_if:
                let v : i64 = self.lower_expr(last)
                self.lower_into(v, d, self.holds(toopt, last))
            else:
                self.lower_stmt(last, false, types.TY_UNIT)

    // What a branch hands to the destination: the value itself, or ⊨
    // of it where the if has no else and what it answers is therefore
    // optional.
    // Whether what this branch answers has to be held in an optional
    // on the way out: only where the if answers one and the branch
    // does not -- ∅ is already an optional's own value.
    fn holds(&self, toopt : bool, e : i64) → bool:
        toopt and not types.ty_is_opt(self.tof(e)) and self.tof(e) ≠ types.TY_EMPTY and (self.nhold[e × 1¤ptrdiff] & 1) = 0

    fn lower_into(&mut self, v : i64, d : i64, hold : bool):
        if not hold:
            self.ir(ir.Ir.mov, v, 0, 0, d, 0)
            return
        let b : i64 = self.tmp()
        self.ir(ir.Ir.snew, 1, 0, 0, b, 0)
        self.ir(ir.Ir.fsto, b, 0, v, 0, 0)
        self.ir(ir.Ir.mov, b, 0, 0, d, 0)

    fn lower_andor(&mut self, nid : i64, k : ast.Nk, na : i64, nb : i64) → i64:
        // a pure, fault-free right side may be read eagerly, and the
        // whole answer becomes three straight-line instructions
        self.decide(self.tok_line(self.a.ntok[nid × 1¤ptrdiff]),
                    if self.speculatable(nb): "eager-logic" else: "short-circuit", "")
        if self.speculatable(nb):
            let av : i64 = self.lower_expr(na)
            let bv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(if k = ast.Nk.op_and: ir.Ir.band else: ir.Ir.borr, av, bv, 0, d, 64)
            return d
        let d : i64 = self.tmp()
        let lend : i64 = self.label()
        let av : i64 = self.lower_expr(na)
        self.ir(ir.Ir.const, if k = ast.Nk.op_and: 0 else: 1, 0, 0, d, 64)
        self.ir(if k = ast.Nk.op_and: ir.Ir.jz else: ir.Ir.jnz, av, lend, 0, 0, 0)
        let bv : i64 = self.lower_expr(nb)
        self.ir(ir.Ir.mov, bv, 0, 0, d, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    // two optionals: the shape first -- both absent is true, one
    // absent is false -- and the contents only when both are there
    fn lower_opt_eq(&mut self, na : i64, nb : i64) → i64:
        let ob : i64 = types.ty_opt_base(self.tof(na))
        let av : i64 = self.lower_expr(na)
        let bv : i64 = self.lower_expr(nb)
        let d : i64 = self.tmp()
        let ltrue : i64 = self.label()
        let lfalse : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        let z : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, z, 64)
        let pa : i64 = self.tmp()
        self.ir(ir.Ir.cne, av, z, 0, pa, 64)
        let pb : i64 = self.tmp()
        self.ir(ir.Ir.cne, bv, z, 0, pb, 64)
        let same : i64 = self.tmp()
        self.ir(ir.Ir.ceq, pa, pb, 0, same, 64)
        self.ir(ir.Ir.jz, same, lfalse, 0, 0, 0)
        self.ir(ir.Ir.jz, pa, ltrue, 0, 0, 0)
        self.ir(ir.Ir.jmp, lcont, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lcont, 0, 0, 0, 0)
        let la : i64 = self.tmp()
        self.ir(ir.Ir.fld, av, 0, 0, la, 0)
        let lb : i64 = self.tmp()
        self.ir(ir.Ir.fld, bv, 0, 0, lb, 0)
        if ob = types.TY_STR:
            self.ir(ir.Ir.seqv, la, lb, 0, d, 64)
        else:
            self.ir(ir.Ir.ceq, la, lb, 0, d, width_of(ob))
        self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
        self.ir(ir.Ir.label, ltrue, 0, 0, 0, 0)
        self.ir(ir.Ir.const, 1, 0, 0, d, 64)
        self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lfalse, 0, 0, 0, 0)
        self.ir(ir.Ir.const, 0, 0, 0, d, 64)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    fn lower_default(&mut self, nid : i64, na : i64, nb : i64) → i64:
        let ik : ast.Nk = self.kof(na)
        if ik = ast.Nk.div or ik = ast.Nk.mod:
            let av : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
            let bv : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
            let dv : i64 = self.lower_expr(nb)
            let d : i64 = self.tmp()
            self.ir(if ik = ast.Nk.div: ir.Ir.divv else: ir.Ir.modd, av, bv, dv, d,
                    width_of(self.tof(na)))
            return d
        if ik = ast.Nk.mcall and self.a.nc[na × 1¤ptrdiff] < 1000:
            return self.lower_mcall(na, nb)
        // any optional: absent takes the default, present unwraps
        let v : i64 = self.lower_expr(na)
        let d : i64 = self.tmp()
        let ldef : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.jz, v, ldef, 0, 0, 0)
        self.ir(ir.Ir.fld, v, 0, 0, d, 0)
        self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
        self.ir(ir.Ir.label, ldef, 0, 0, 0, 0)
        let dv : i64 = self.lower_expr(nb)
        self.ir(ir.Ir.mov, dv, 0, 0, d, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    fn lower_mcall(&mut self, nid : i64, defnode : i64) → i64:
        let mid : i64 = self.a.nc[nid × 1¤ptrdiff]
        let base : i64 = self.a.na[nid × 1¤ptrdiff]
        let args_off : i64 ¤"aextra" = self.a.nb[nid × 1¤ptrdiff] × 1¤"aextra"
        if mid >= 1000:
            // a struct's method is a function with the receiver first
            let f : i64 = ((mid - 1000) ÷ 2) ?? 0
            let inst : i64 = (mid - 1000) & 1
            let vregs : mut i64[] = []
            if inst = 1:
                vregs.push(self.lower_expr(base))
            let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
            foreach i := 0…argc:
                vregs.push(self.lower_expr(self.a.extra[args_off + 1 + i]))
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(@dropunit(#vregs))
            self.extra ← self.extra ⧺ vregs
            let d : i64 = self.tmp()
            self.ir(ir.Ir.call, f, off, 0, d, self.callw(nid))
            return d
        let av : i64 = self.lower_expr(base)
        let w : i64 = width_of(self.tof(nid))
        if mid = check.Mid.chr.ord():
            let d : i64 = self.tmp()
            self.ir(ir.Ir.chr, av, 0, 0, d, w)
            return d
        if mid = check.Mid.ord.ord():
            let d : i64 = self.tmp()
            self.ir(ir.Ir.mov, av, 0, 0, d, w)
            return d
        if mid = check.Mid.chars.ord():
            let d : i64 = self.tmp()
            self.ir(ir.Ir.chars, av, 0, 0, d, 0)
            return d
        if mid = check.Mid.fdev.ord() or mid = check.Mid.fino.ord():
            let w : i64 = self.tmp()
            self.ir(ir.Ir.const, (if mid = check.Mid.fdev.ord(): 0 else: 1), 0, 0, w, 0)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.fident, av, w, 0, d, 0)
            return d
        if mid = check.Mid.readf.ord():
            _ ← self.lower_expr(self.a.extra[args_off + 1])
            let d : i64 = self.tmp()
            self.ir(ir.Ir.fread, av, 0, 0, d, 0)
            return d
        if mid = check.Mid.writef.ord():
            let bv : i64 = self.lower_expr(self.a.extra[args_off + 1])
            self.ir(ir.Ir.fwrite, av, bv, 0, 0, 0)
            return ⁻1
        if mid = check.Mid.closef.ord():
            self.ir(ir.Ir.fclose, av, 0, 0, 0, 0)
            return ⁻1
        if mid = check.Mid.writev.ord():
            let pv : i64 = self.lower_expr(self.a.extra[args_off + 1])
            self.ir(ir.Ir.writev, av, pv, 0, 0, 0)
            return ⁻1
        if mid = check.Mid.hupdate.ord():
            let uv : i64 = self.lower_hash_arg(self.a.extra[args_off + 1])
            self.ir(ir.Ir.hupdate, av, uv, 0, 0, 0)
            return ⁻1
        if mid = check.Mid.hdigest.ord():
            // the digest is a fixed width, so the space for it is the
            // caller's and nothing is allocated for the answer
            let dst : i64 = self.farr_new(self.tof(nid), self.packed_ty_n(self.tof(nid)))
            let d : i64 = self.tmp()
            self.ir(ir.Ir.hfinal, av, dst, 0, d, 0)
            return d
        if mid = check.Mid.diriter.ord():
            let earr : i64 = self.tmp()
            self.ir(ir.Ir.dents, 0, 0, 0, earr, 0)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.snew, 2, 0, 0, d, 0)
            self.ir(ir.Ir.fsto, d, 0, earr, 0, 0)
            let z8 : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, z8, 0)
            self.ir(ir.Ir.fsto, d, 1, z8, 0, 0)
            return d
        if mid = check.Mid.iter.ord():
            // {the array, the position}: a fresh two-slot box
            let d : i64 = self.tmp()
            self.ir(ir.Ir.snew, 2, 0, 0, d, 0)
            self.ir(ir.Ir.fsto, d, 0, av, 0, 0)
            let z9 : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, z9, 0)
            self.ir(ir.Ir.fsto, d, 1, z9, 0, 0)
            return d
        if mid = check.Mid.next.ord() and defnode = ⁻1 and types.ty_is_opt(self.tof(nid)):
            // outside ?? and the while binding: the step is boxed as
            // any optional is, the end the null
            let dscb : i64 = self.tmp()
            self.ir(ir.Ir.fld, av, 0, 0, dscb, 0)
            let posb : i64 = self.tmp()
            self.ir(ir.Ir.fld, av, 1, 0, posb, 0)
            let nb9 : i64 = self.tmp()
            self.ir(ir.Ir.alen, dscb, 0, 0, nb9, 0)
            let cb9 : i64 = self.tmp()
            self.ir(ir.Ir.clt, posb, nb9, 0, cb9, 64 + 256)
            let d : i64 = self.tmp()
            let labs : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.jz, cb9, labs, 0, 0, 0)
            let ev9 : i64 = self.tmp()
            self.ir(ir.Ir.aidx, dscb, posb, 0, ev9, 0)
            let ob9 : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, ob9, 0)
            self.ir(ir.Ir.fsto, ob9, 0, ev9, 0, 0)
            let one8 : i64 = self.tmp()
            self.ir(ir.Ir.const, 1, 0, 0, one8, 0)
            let np8 : i64 = self.tmp()
            self.ir(ir.Ir.addw, posb, one8, 0, np8, 64 + 256)
            self.ir(ir.Ir.fsto, av, 1, np8, 0, 0)
            self.ir(ir.Ir.mov, ob9, 0, 0, d, 0)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, labs, 0, 0, 0, 0)
            self.ir(ir.Ir.const, 0, 0, 0, d, 0)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
            return d
        if mid = check.Mid.next.ord():
            // position under length answers the element and steps; the
            // end answers the default, as pop does under ??
            let dsc : i64 = self.tmp()
            self.ir(ir.Ir.fld, av, 0, 0, dsc, 0)
            let pos : i64 = self.tmp()
            self.ir(ir.Ir.fld, av, 1, 0, pos, 0)
            let n9 : i64 = self.tmp()
            self.ir(ir.Ir.alen, dsc, 0, 0, n9, 0)
            let c9 : i64 = self.tmp()
            self.ir(ir.Ir.clt, pos, n9, 0, c9, 64 + 256)
            let d : i64 = self.tmp()
            let ldef : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.jz, c9, ldef, 0, 0, 0)
            self.ir(ir.Ir.aidx, dsc, pos, 0, d, 0)
            let one9 : i64 = self.tmp()
            self.ir(ir.Ir.const, 1, 0, 0, one9, 0)
            let np9 : i64 = self.tmp()
            self.ir(ir.Ir.addw, pos, one9, 0, np9, 64 + 256)
            self.ir(ir.Ir.fsto, av, 1, np9, 0, 0)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, ldef, 0, 0, 0, 0)
            let dv9 : i64 = self.lower_expr(defnode)
            self.ir(ir.Ir.mov, dv9, 0, 0, d, 0)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
            return d
        if mid = check.Mid.push.ord():
            let vv : i64 = self.lower_expr(self.a.extra[args_off + 1])
            self.ir(ir.Ir.apush, av, vv, 0, 0, 0)
            return ⁻1
        if mid = check.Mid.pop.ord() and defnode = ⁻1 and types.ty_is_opt(self.tof(nid)):
            // outside ??: an empty array answers the null, and a value
            // answers boxed, as ⊨ boxes
            let n9 : i64 = self.tmp()
            self.ir(ir.Ir.alen, av, 0, 0, n9, 0)
            let d9 : i64 = self.tmp()
            let lno : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.jz, n9, lno, 0, 0, 0)
            let z9 : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, z9, 0)
            let e9 : i64 = self.tmp()
            self.ir(ir.Ir.apop, av, z9, 0, e9, width_of(types.ty_opt_base(self.tof(nid))))
            let b9 : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, b9, 0)
            self.ir(ir.Ir.fsto, b9, 0, e9, 0, 0)
            self.ir(ir.Ir.mov, b9, 0, 0, d9, 0)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lno, 0, 0, 0, 0)
            self.ir(ir.Ir.const, 0, 0, 0, d9, 0)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
            return d9
        if mid = check.Mid.pop.ord():
            let dv : mut i64 = 0
            if defnode = ⁻1:
                dv ← self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, dv, 0)
            else:
                dv ← self.lower_expr(defnode)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.apop, av, dv, 0, d, w)
            return d
        if defnode = ⁻1 and types.ty_is_opt(self.tof(nid)):
            // get, outside ??: past the end answers the null
            let iv9 : i64 = self.lower_expr(self.a.extra[args_off + 1])
            let n8 : i64 = self.tmp()
            self.ir(ir.Ir.alen, av, 0, 0, n8, 0)
            let c8 : i64 = self.tmp()
            self.ir(ir.Ir.clt, iv9, n8, 0, c8, 64 + 256)
            let d8 : i64 = self.tmp()
            let lno8 : i64 = self.label()
            let lend8 : i64 = self.label()
            self.ir(ir.Ir.jz, c8, lno8, 0, 0, 0)
            let e8 : i64 = self.tmp()
            self.ir(ir.Ir.aidx, av, iv9, 0, e8, 0)
            let b8 : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, b8, 0)
            self.ir(ir.Ir.fsto, b8, 0, e8, 0, 0)
            self.ir(ir.Ir.mov, b8, 0, 0, d8, 0)
            self.ir(ir.Ir.jmp, lend8, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lno8, 0, 0, 0, 0)
            self.ir(ir.Ir.const, 0, 0, 0, d8, 0)
            self.ir(ir.Ir.label, lend8, 0, 0, 0, 0)
            return d8
        // get, with the default a ?? supplies
        assert(defnode ≠ ⁻1, "a get with no default answers an optional and is lowered above")
        let iv : i64 = self.lower_expr(self.a.extra[args_off + 1])
        let dv : i64 = self.lower_expr(defnode)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.aget, av, iv, dv, d, w)
        d

    // a range written out as the array of its steps, for the places
    // that cycle an array: the walk is the foreach's own
    fn lower_rg_arr(&mut self, nb : i64) → i64:
        let rv : i64 = self.lower_expr(nb)
        let lo9 : i64 = self.tmp()
        self.ir(ir.Ir.fld, rv, 0, 0, lo9, 0)
        let st9 : i64 = self.tmp()
        self.ir(ir.Ir.fld, rv, 1, 0, st9, 0)
        let hi9 : i64 = self.tmp()
        self.ir(ir.Ir.fld, rv, 2, 0, hi9, 0)
        let lz9 : i64 = self.label()
        self.ir(ir.Ir.jnz, st9, lz9, 0, 0, 0)
        let m9 : i64 = self.intern("range step must not be zero\n")
        self.ir(ir.Ir.abort, m9, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lz9, 0, 0, 0, 0)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, d, 0)
        let iv : i64 = self.tmp()
        self.ir(ir.Ir.mov, lo9, 0, 0, iv, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c : i64 = self.range_alive(iv, hi9, st9)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        self.ir(ir.Ir.apush, d, iv, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, iv, st9, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, iv, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    // m[rows, cols] and m[rows, i]: the rows are walked and each is cut
    // to what was asked for.  A row the matrix holds cannot be handed
    // back narrowed, so every row of the answer is built, and the answer
    // shares nothing with what it was cut from.
    fn lower_mslice(&mut self, nid : i64, na : i64, off : i64, iscol : i64) → i64:
        let mv : i64 = self.lower_expr(na)
        let rlo : i64 = self.lower_expr(self.a.extra[off × 1¤ptrdiff])
        let rhi : i64 = self.lower_expr(self.a.extra[(off + 1) × 1¤ptrdiff])
        let clo : i64 = self.lower_expr(self.a.extra[(off + 2) × 1¤ptrdiff])
        let chin : i64 = self.a.extra[(off + 3) × 1¤ptrdiff]
        let chi : mut i64 = 0
        if chin ≠ ⁻1:
            chi ← self.lower_expr(chin)
        let out : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, out, 0)
        let r : i64 = self.tmp()
        self.ir(ir.Ir.mov, rlo, 0, 0, r, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let cnd : i64 = self.tmp()
        // rhi is where the slice stops, not the last row it takes
        self.ir(ir.Ir.clt, r, rhi, 0, cnd, 64 + 256)
        self.ir(ir.Ir.jz, cnd, lend, 0, 0, 0)
        let row : i64 = self.tmp()
        self.ir(ir.Ir.aidx, mv, r, 0, row, 0)
        let piece : i64 = self.tmp()
        if iscol = 1:
            self.ir(ir.Ir.aidx, row, clo, 0, piece, 0)
        else:
            self.ir(ir.Ir.aslice, row, clo, chi, piece, 0)
        self.ir(ir.Ir.apush, out, piece, 0, 0, 0)
        let nr : i64 = self.tmp()
        self.ir(ir.Ir.addw, r, one, 0, nr, 64 + 256)
        self.ir(ir.Ir.mov, nr, 0, 0, r, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        out

    fn lower_mreshape(&mut self, nid : i64, na : i64, nb : i64) → i64:
        // the flat filler cycles across the row seam, then is cut into
        // rows, each row its own fresh array
        let toff : i64 = self.a.na[na × 1¤ptrdiff]
        let rank : i64 = self.a.extra[toff × 1¤ptrdiff]
        let r : i64 = self.a.na[self.a.extra[(toff + 1) × 1¤ptrdiff] × 1¤ptrdiff]
        let c : i64 = self.a.na[self.a.extra[(toff + 2) × 1¤ptrdiff] × 1¤ptrdiff]
        // a cube is planes of rows: the last two extents make the plane,
        // and the first counts them
        let d3 : i64 = if rank = 2: 1 else: self.a.na[self.a.extra[(toff + 3) × 1¤ptrdiff] × 1¤ptrdiff]
        let nall : i64 = self.tmp()
        self.ir(ir.Ir.const, r × c × d3, 0, 0, nall, 0)
        let flat : i64 = self.tmp()
        if types.ty_is_rg(self.tof(nb)):
            let fvr : i64 = self.lower_rg_arr(nb)
            self.ir(ir.Ir.acyc, nall, fvr, 0, flat, 0)
        elif types.ty_is_arr(self.tof(nb)):
            let fv : i64 = self.lower_expr(nb)
            self.ir(ir.Ir.acyc, nall, fv, 0, flat, 0)
        else:
            let fv : i64 = self.lower_expr(nb)
            self.ir(ir.Ir.afill, nall, fv, 0, flat, 0)
        // the outermost dimension counts what the level below builds:
        // rows for a matrix, planes for a cube.  Either way the cutting
        // is the same loop, so a cube runs it twice, once nested.
        let d : i64 = self.cut_up(flat, r, c × d3)
        if rank = 2:
            return d
        let cube : i64 = self.tmp()
        self.ir(ir.Ir.anew, r ⌈ 4, 0, 0, cube, 0)
        let pi : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, pi, 0)
        let pn : i64 = self.tmp()
        self.ir(ir.Ir.const, r, 0, 0, pn, 0)
        let pone : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, pone, 0)
        let ptop : i64 = self.label()
        let pend : i64 = self.label()
        self.ir(ir.Ir.label, ptop, 0, 0, 0, 0)
        let pc : i64 = self.tmp()
        self.ir(ir.Ir.clt, pi, pn, 0, pc, 64 + 256)
        self.ir(ir.Ir.jz, pc, pend, 0, 0, 0)
        let plane : i64 = self.tmp()
        self.ir(ir.Ir.aidx, d, pi, 0, plane, 0)
        let pm : i64 = self.cut_up(plane, c, d3)
        self.ir(ir.Ir.apush, cube, pm, 0, 0, 0)
        let pnx : i64 = self.tmp()
        self.ir(ir.Ir.addw, pi, pone, 0, pnx, 64 + 256)
        self.ir(ir.Ir.mov, pnx, 0, 0, pi, 0)
        self.ir(ir.Ir.jmp, ptop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, pend, 0, 0, 0, 0)
        cube

    // n slices of width w, cut off the front of flat and pushed into a
    // fresh array; the slices share with what they were cut from
    fn cut_up(&mut self, flat : i64, n : i64, w : i64) → i64:
        let d : i64 = self.tmp()
        self.ir(ir.Ir.anew, n ⌈ 4, 0, 0, d, 0)
        let i : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, i, 0)
        let rv : i64 = self.tmp()
        self.ir(ir.Ir.const, n, 0, 0, rv, 0)
        let cv : i64 = self.tmp()
        self.ir(ir.Ir.const, w, 0, 0, cv, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let cnd : i64 = self.tmp()
        self.ir(ir.Ir.clt, i, rv, 0, cnd, 64 + 256)
        self.ir(ir.Ir.jz, cnd, lend, 0, 0, 0)
        let lo : i64 = self.tmp()
        self.ir(ir.Ir.mulw, i, cv, 0, lo, 64 + 256)
        // one row is the run from lo up to lo + columns, and a slice
        // stops at its end rather than taking it
        let hi : i64 = self.tmp()
        self.ir(ir.Ir.addw, lo, cv, 0, hi, 64 + 256)
        let row : i64 = self.tmp()
        self.ir(ir.Ir.aslice, flat, lo, hi, row, 0)
        self.ir(ir.Ir.apush, d, row, 0, 0, 0)
        let nxt : i64 = self.tmp()
        self.ir(ir.Ir.addw, i, one, 0, nxt, 64 + 256)
        self.ir(ir.Ir.mov, nxt, 0, 0, i, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    // std.iov(x): the run of bytes x amounts to, made here and held as
    // a base and a length.  A byte array is already its own bytes; a
    // struct with a layout is written out one field at a time, at the
    // offsets the layout gives, with what the layout skips written as
    // zeros so the same program twice produces the same file.
    // What a hash is handed: an array of bytes.  A string gives up its
    // bytes first, which costs a copy the runtime would otherwise need
    // a second entry point to avoid.
    fn lower_hash_arg(&mut self, hn : i64) → i64:
        let ht : i64 = types.ty_strip_ref(self.tof(hn))
        let hv : i64 = self.lower_expr(hn)
        if ht ≠ types.TY_STR:
            return hv
        let bv : i64 = self.tmp()
        self.ir(ir.Ir.sbytes, hv, 0, 0, bv, 0)
        bv

    fn lower_iov(&mut self, pe : i64) → i64:
        let pt : i64 = types.ty_strip_ref(self.tof(pe))
        let pv : i64 = self.lower_expr(pe)
        let bytes : mut i64 = pv
        if pt ≠ types.mk_aty(types.TY_U8):
            bytes ← self.pack_piece(pt, pv)
        let raw : i64 = self.tmp()
        self.ir(ir.Ir.toraw, bytes, 0, 0, raw, 0)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, bytes, 0, 0, n, 0)
        // the two slots the kernel wants, in the order it wants them,
        // so a run needs no rearranging when it is handed over
        let d : i64 = self.tmp()
        self.ir(ir.Ir.snew, 2, 0, 0, d, 0)
        self.ir(ir.Ir.fsto, d, 0, raw, 0, 0)
        self.ir(ir.Ir.fsto, d, 1, n, 0, 0)
        d

    // the bytes of one piece that is not already bytes: a struct, or a
    // table of them walked one entry at a time
    fn pack_piece(&mut self, pt : i64, pv : i64) → i64:
        let buf : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, buf, 0)
        if not types.ty_is_arr(pt):
            _ ← self.pack_val(buf, pt, pv, 0)
            return buf
        // a table: the same static sequence inside a loop, since how
        // many entries there are is not known until it runs
        let et : i64 = self.elem_of(pt)
        let n : i64 = self.tmp()
        self.ir(ir.Ir.alen, pv, 0, 0, n, 0)
        let ix : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, ix, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c : i64 = self.tmp()
        self.ir(ir.Ir.clt, ix, n, 0, c, 64 + 256)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        let e : i64 = self.tmp()
        self.ir(ir.Ir.aidx, pv, ix, 0, e, 0)
        _ ← self.pack_val(buf, et, e, 0)
        let nx : i64 = self.tmp()
        self.ir(ir.Ir.addw, ix, one, 0, nx, 64 + 256)
        self.ir(ir.Ir.mov, nx, 0, 0, ix, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        buf

    // push one byte, whose value the caller has already reduced
    fn pack_byte(&mut self, buf : i64, v : i64):
        self.ir(ir.Ir.apush, buf, v, 0, 0, 0)

    // zeros up to the offset the layout wants next
    fn pack_pad(&mut self, buf : i64, from : i64, to : i64):
        if to > from:
            let z : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, z, 0)
            foreach _ := from…to:
                self.pack_byte(buf, z)

    // one value of type ty appended to buf; answers how far along the
    // piece the writing has got, so the caller can pad to the next
    // field without counting the bytes again
    fn pack_val(&mut self, buf : i64, ty0 : i64, v : i64, pos0 : i64) → i64:
        let ty : i64 = types.ty_drop_unit(types.ty_strip_ref(ty0))
        let pos : mut i64 = pos0
        if types.ty_is_struct(ty):
            let si : i64 = types.ty_sidx(ty)
            let d := self.a.structs[si × 1¤ptrdiff]
            let nf : i64 ¤ptrdiff = self.a.extra[d.fields_off] × 1¤ptrdiff
            let (ssz, sal) := check.c_struct_layout(self.a, si, 0)
            _ ← sal
            if nf > 0:
                foreach fi := 0…nf:
                    let fty : i64 = self.a.extra[d.fields_off + 2 + fi × 2]
                    self.pack_pad(buf, pos, pos0 + check.c_field_offset(self.a, si, fi))
                    pos ← pos0 + check.c_field_offset(self.a, si, fi)
                    let fv : i64 = self.tmp()
                    self.ir(ir.Ir.fld, v, @dropunit(fi), 0, fv, 0)
                    pos ← self.pack_val(buf, fty, fv, pos)
            // the tail padding is part of the struct, so an array of
            // it keeps every element where the layout says
            self.pack_pad(buf, pos, pos0 + ssz)
            return pos0 + ssz
        if check.farr_is_packed(self.a, ty):
            // a sized array is its elements one after the other, and
            // how many there are is part of the type -- which is also
            // how the value itself is laid out, so the elements are
            // read where they lie
            let et : i64 = self.a.fae[types.ty_fidx(ty) × 1¤ptrdiff]
            let cnt : i64 = self.a.fas[types.ty_fidx(ty) × 1¤ptrdiff]
            foreach ei := 0…cnt:
                let ev : i64 = self.farr_load(v, ty, cnt, 0, ei)
                pos ← self.pack_val(buf, et, ev, pos)
            return pos
        // a scalar: its own width, least significant byte first, which
        // is the target's order
        let (sz, al) := check.c_layout(self.a, ty, 0)
        _ ← al
        let m : i64 = self.tmp()
        self.ir(ir.Ir.const, 255, 0, 0, m, 0)
        foreach bi := 0…sz:
            let sh : i64 = self.tmp()
            self.ir(ir.Ir.const, 8 × @dropunit(bi), 0, 0, sh, 0)
            let shifted : i64 = self.tmp()
            self.ir(ir.Ir.shrr, v, sh, 0, shifted, 64 + 256)
            let low : i64 = self.tmp()
            self.ir(ir.Ir.band, shifted, m, 0, low, 64 + 256)
            self.pack_byte(buf, low)
        pos + sz

    // generate(f, r): the range written out, then one call per step
    fn lower_generate(&mut self, nid : i64, args_off : i64 ¤"aextra") → i64:
        let fe : i64 = self.a.extra[args_off + 1]
        let re : i64 = self.a.extra[args_off + 2]
        let fv : i64 = self.lower_expr(fe)
        let rga : i64 = self.lower_rg_arr(re)
        let out : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, out, 0)
        let n9 : i64 = self.tmp()
        self.ir(ir.Ir.alen, rga, 0, 0, n9, 0)
        let ix9 : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, ix9, 0)
        let one9 : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one9, 0)
        let ad9 : i64 = self.tmp()
        self.ir(ir.Ir.fld, fv, 0, 0, ad9, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c9 : i64 = self.tmp()
        self.ir(ir.Ir.clt, ix9, n9, 0, c9, 64 + 256)
        self.ir(ir.Ir.jz, c9, lend, 0, 0, 0)
        let x9 : i64 = self.tmp()
        self.ir(ir.Ir.aidx, rga, ix9, 0, x9, 0)
        let off9 : i64 = @dropunit(#self.extra)
        self.extra.push(2)
        self.extra.push(x9)
        self.extra.push(fv)
        let r9 : i64 = self.tmp()
        self.ir(ir.Ir.calli, ad9, off9, 0, r9, 0)
        self.ir(ir.Ir.apush, out, r9, 0, 0, 0)
        let ni9 : i64 = self.tmp()
        self.ir(ir.Ir.addw, ix9, one9, 0, ni9, 64 + 256)
        self.ir(ir.Ir.mov, ni9, 0, 0, ix9, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        out

    // a ⊑ b and a ⊒ b: whether a runs along the front of b, or along
    // its back.  The length settles it first -- a longer run is
    // neither -- and then it is element by element from where the
    // shorter one is laid, stopping at the first that differs.  Two
    // strings, or two arrays of one element type; the elements are
    // compared as the language compares them.
    fn lower_run(&mut self, ae : i64, be : i64, back : i64) → i64:
        let isstr : bool = self.tof(ae) = types.TY_STR
        let av : i64 = self.lower_expr(ae)
        let bv : i64 = self.lower_expr(be)
        let an : i64 = self.tmp()
        let bn : i64 = self.tmp()
        if isstr:
            self.ir(ir.Ir.slenv, av, 0, 0, an, 0)
            self.ir(ir.Ir.slenv, bv, 0, 0, bn, 0)
        else:
            self.ir(ir.Ir.alen, av, 0, 0, an, 0)
            self.ir(ir.Ir.alen, bv, 0, 0, bn, 0)
        // the answer, false until the walk has run out of ways to
        // make it false
        let d : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, d, 0)
        let lend : i64 = self.label()
        // a run longer than what it is laid against is neither
        let toolong : i64 = self.tmp()
        self.ir(ir.Ir.clt, bn, an, 0, toolong, 64 + 256)
        self.ir(ir.Ir.jnz, toolong, lend, 0, 0, 0)
        // where the shorter one is laid: the front, or as far along
        // as leaves it ending where the longer one does
        let at : i64 = self.tmp()
        if back = 1:
            self.ir(ir.Ir.subw, bn, an, 0, at, 64 + 256)
        else:
            self.ir(ir.Ir.const, 0, 0, 0, at, 0)
        let ix : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, ix, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ltop : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let more : i64 = self.tmp()
        self.ir(ir.Ir.clt, ix, an, 0, more, 64 + 256)
        let lsame : i64 = self.label()
        self.ir(ir.Ir.jz, more, lsame, 0, 0, 0)
        let bi : i64 = self.tmp()
        self.ir(ir.Ir.addw, at, ix, 0, bi, 64 + 256)
        let x : i64 = self.tmp()
        let y : i64 = self.tmp()
        if isstr:
            self.ir(ir.Ir.sidx, av, ix, 0, x, 0)
            self.ir(ir.Ir.sidx, bv, bi, 0, y, 0)
        else:
            self.ir(ir.Ir.aidx, av, ix, 0, x, 0)
            self.ir(ir.Ir.aidx, bv, bi, 0, y, 0)
        let same : i64 = self.tmp()
        self.ir(ir.Ir.ceq, x, y, 0, same, 64 + 256)
        self.ir(ir.Ir.jz, same, lend, 0, 0, 0)
        let nx : i64 = self.tmp()
        self.ir(ir.Ir.addw, ix, one, 0, nx, 64 + 256)
        self.ir(ir.Ir.mov, nx, 0, 0, ix, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lsame, 0, 0, 0, 0)
        self.ir(ir.Ir.const, 1, 0, 0, d, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d
    // f ∀ v, f ∃ v and f ∄ v.  The loop generate makes, with the
    // answer a truth instead of an array and a way out of the middle
    // of it: the walk leaves at the first element that settles the
    // question and asks about no more.  That is not an optimization to
    // be added later -- what f does on the way is what the program
    // does, so a walk that finished the container would be a different
    // program.  kind is 0 for ∀, 1 for ∃ and 2 for ∄, and the fourth
    // bit says the container is a range.
    fn lower_quant(&mut self, nid : i64, fe : i64, ce : i64, kind0 : i64) → i64:
        let kind : i64 = kind0 & 3
        // ∀ is settled by an element that does not hold, ∃ and ∄ by one
        // that does; what it is settled as is true only for ∃
        let onhold : bool = kind ≠ 0
        let settled : i64 = if kind = 1: 1 else: 0
        let isrange : bool = (kind0 & 4) = 4
        let fv : i64 = self.lower_expr(fe)
        // a range is walked as the array of its steps, as generate
        // walks one; an array is walked where it stands
        let av : i64 = if isrange: self.lower_rg_arr(ce) else: self.lower_expr(ce)
        // The answer the walk carries until something settles it, and
        // the one place it is written from twice.
        let d : i64 = self.tmp()
        self.ir(ir.Ir.const, 1 - settled, 0, 0, d, 0)
        let n9 : i64 = self.tmp()
        self.ir(ir.Ir.alen, av, 0, 0, n9, 0)
        let ix9 : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, ix9, 0)
        let one9 : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one9, 0)
        let ad9 : i64 = self.tmp()
        self.ir(ir.Ir.fld, fv, 0, 0, ad9, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c9 : i64 = self.tmp()
        self.ir(ir.Ir.clt, ix9, n9, 0, c9, 64 + 256)
        self.ir(ir.Ir.jz, c9, lend, 0, 0, 0)
        let x9 : i64 = self.tmp()
        self.ir(ir.Ir.aidx, av, ix9, 0, x9, 0)
        let off9 : i64 = @dropunit(#self.extra)
        self.extra.push(2)
        self.extra.push(x9)
        self.extra.push(fv)
        let r9 : i64 = self.tmp()
        self.ir(ir.Ir.calli, ad9, off9, 0, r9, 0)
        // the one answer that settles it: true for ∃, false for ∀.
        // It is written down and the walk leaves; nothing below runs.
        let lsettled : i64 = self.label()
        if onhold:
            self.ir(ir.Ir.jnz, r9, lsettled, 0, 0, 0)
        else:
            self.ir(ir.Ir.jz, r9, lsettled, 0, 0, 0)
        let ni9 : i64 = self.tmp()
        self.ir(ir.Ir.addw, ix9, one9, 0, ni9, 64 + 256)
        self.ir(ir.Ir.mov, ni9, 0, 0, ix9, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lsettled, 0, 0, 0, 0)
        self.ir(ir.Ir.const, settled, 0, 0, d, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d
    fn lower_arrlit(&mut self, nid : i64, off : i64) → i64:
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let ty : i64 = self.tof(nid)
        let pn : i64 = self.packed_n(nid)
        if pn >= 0:
            // the elements go straight into the frame; there is no
            // header to make and nothing to allocate
            assert(pn = n, "the literal has as many elements as the binding holds")
            let fb : i64 = self.farr_new(ty, pn)
            foreach j := 0…n:
                let ev : i64 = self.lower_expr(self.a.extra[(off + 1 + j) × 1¤ptrdiff])
                self.farr_store(fb, ty, pn, 0, j, ev)
            return fb
        let d : i64 = self.tmp()
        self.ir(ir.Ir.anew, n ⌈ 4, 0, 0, d, 0)
        foreach i := 0…n:
            let ev : i64 = self.lower_expr(self.a.extra[(off + 1 + i) × 1¤ptrdiff])
            self.ir(ir.Ir.apush, d, ev, 0, 0, 0)
        d

    fn lower_call(&mut self, nid : i64, tok : i64, args_off : i64 ¤"aextra") → i64:
        let name := self.text(tok)
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if name = "static_assert" or name = "static_assert_eq":
            return ⁻1
        if name = "assert" or name = "assert_eq":
            self.lower_assert(nid, tok, args_off, name = "assert_eq")
            return ⁻1
        if self.a.nc[nid × 1¤ptrdiff] = 2:
            return self.lower_generate(nid, args_off)
        if self.a.nc[nid × 1¤ptrdiff] >= 6 and self.a.nc[nid × 1¤ptrdiff] <= 8:
            let gb9 : i64 = self.tmp()
            self.ir(ir.Ir.gload, self.nslot[nid × 1¤ptrdiff], 0, 0, gb9, 0)
            if self.a.nc[nid × 1¤ptrdiff] = 7:
                return gb9
            if self.a.nc[nid × 1¤ptrdiff] = 6:
                let gv9 : mut i64[] = []
                foreach gi9 := 0…argc:
                    gv9.push(self.lower_expr(self.a.extra[args_off + 1 + gi9]))
                let go9 : i64 = @dropunit(#self.extra)
                self.extra.push(@dropunit(argc) + 1)
                self.extra ← self.extra ⧺ gv9
                self.extra.push(gb9)
                let ga9 : i64 = self.tmp()
                self.ir(ir.Ir.fld, gb9, 0, 0, ga9, 0)
                let gd9 : i64 = self.tmp()
                self.ir(ir.Ir.calli, ga9, go9, 0, gd9, 0)
                return gd9
            let gv8 : mut i64[] = []
            foreach gi8 := 0…argc:
                gv8.push(self.lower_expr(self.a.extra[args_off + 1 + gi8]))
            let gp8 : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1 + @dropunit(argc) + 1, 0, 0, gp8, 0)
            let gf8 : i64 = self.tmp()
            self.ir(ir.Ir.faddr, self.shimbase + self.a.nb[nid × 1¤ptrdiff], 0, 0, gf8, 0)
            self.ir(ir.Ir.fsto, gp8, 0, gf8, 0, 0)
            foreach gk8 := 0…argc:
                self.ir(ir.Ir.fsto, gp8, @dropunit(1 + gk8), gv8[gk8], 0, 0)
            self.ir(ir.Ir.fsto, gp8, 1 + @dropunit(argc), gb9, 0, 0)
            return gp8
        if self.a.nc[nid × 1¤ptrdiff] = 5:
            // an empty application answers the box unchanged
            return self.nslot[nid × 1¤ptrdiff]
        if self.a.nc[nid × 1¤ptrdiff] = 3 or self.a.nc[nid × 1¤ptrdiff] = 4:
            // a partial: the shim's address, then the bound values,
            // then -- for a closure source -- the source box itself
            let isclo : i64 = if self.a.nc[nid × 1¤ptrdiff] = 4: 1 else: 0
            let vb9 : mut i64[] = []
            foreach bi9 := 0…argc:
                vb9.push(self.lower_expr(self.a.extra[args_off + 1 + bi9]))
            let d9p : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1 + @dropunit(argc) + isclo, 0, 0, d9p, 0)
            let av9p : i64 = self.tmp()
            self.ir(ir.Ir.faddr, self.shimbase + self.a.nb[nid × 1¤ptrdiff], 0, 0, av9p, 0)
            self.ir(ir.Ir.fsto, d9p, 0, av9p, 0, 0)
            foreach ci9p := 0…argc:
                self.ir(ir.Ir.fsto, d9p, @dropunit(1 + ci9p), vb9[ci9p], 0, 0)
            if isclo = 1:
                self.ir(ir.Ir.fsto, d9p, 1 + @dropunit(argc), self.nslot[nid × 1¤ptrdiff], 0, 0)
            return d9p
        if self.a.nc[nid × 1¤ptrdiff] = 1:
            // through the binding's box: the address in slot 0, the
            // box itself riding along as the hidden last argument
            let box9 : i64 = self.nslot[nid × 1¤ptrdiff]
            let vr9 : mut i64[] = []
            foreach ix9 := 0…argc:
                vr9.push(self.lower_expr(self.a.extra[args_off + 1 + ix9]))
            let bt9 : i64 = self.nlam[nid × 1¤ptrdiff]
            if bt9 ≠ ⁻1 and self.lam_listable(bt9):
                let pts9 : mut i64[] = []
                foreach pk9 := 0…argc:
                    pts9.push(self.lam_pt(bt9, pk9))
                let thr9 : i64[] = self.thread_mask(args_off, argc, pts9)
                if self.threads_any(thr9):
                    return self.lower_thread(thr9, vr9, ⁻1, box9)
            let off9 : i64 = @dropunit(#self.extra)
            self.extra.push(@dropunit(argc) + 1)
            self.extra ← self.extra ⧺ vr9
            self.extra.push(box9)
            let ad9 : i64 = self.tmp()
            self.ir(ir.Ir.fld, box9, 0, 0, ad9, 0)
            let d9 : i64 = self.tmp()
            self.ir(ir.Ir.calli, ad9, off9, 0, d9, 0)
            return d9
        let vregs : mut i64[] = []
        foreach i := 0…argc:
            let an : i64 = self.a.extra[args_off + 1 + i]
            vregs.push(self.copied_arg(an, self.lower_expr(an)))
        let f : i64 = self.fname_index(name)
        if f ≠ ⁻1 and self.a.fns[f × 1¤ptrdiff].is_listable:
            let pts : mut i64[] = []
            let po : i64 ¤"aextra" = self.a.fns[f × 1¤ptrdiff].params_off
            let pn : i64 ¤ptrdiff = self.a.extra[po] × 1¤ptrdiff
            foreach pk := 0…pn:
                pts.push(self.a.extra[po + 2 + pk × 2])
            let thr : i64[] = self.thread_mask(args_off, argc, pts)
            if self.threads_any(thr):
                return self.lower_thread(thr, vregs, f, ⁻1)
        // a callee that answers a sized array is given the space to
        // answer into, as a last argument the source never wrote
        let rt : i64 = self.tof(nid)
        let rn : i64 = self.packed_ty_n(rt)
        if rn >= 0:
            vregs.push(self.farr_new(rt, rn))
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(@dropunit(#vregs))
        self.extra ← self.extra ⧺ vregs
        let d : i64 = self.tmp()
        self.ir(ir.Ir.call, f, off, 0, d, self.callw(nid))
        d

    // What the type says is always true of one, asked of this one.  A
    // condition that does not hold stops the program: there is no such
    // value, so there is nothing to carry on with.
    fn lower_invariants(&mut self, sty : i64, subject : i64):
        if not types.ty_is_struct(sty):
            return
        let d := self.a.structs[types.ty_sidx(sty) × 1¤ptrdiff]
        if d.inv_off = ⁻1:
            return
        let n : i64 ¤ptrdiff = self.a.extra[d.inv_off] × 1¤ptrdiff
        let saved : i64 = self.inv_subject
        self.inv_subject ← subject
        foreach j := 0…n:
            let c : i64 = self.a.extra[d.inv_off + 1 + j]
            let cv : i64 = self.lower_expr(c)
            let lok : i64 = self.label()
            self.ir(ir.Ir.jnz, cv, lok, 0, 0, 0)
            let m : i64 = self.intern("invariant of '" ⧺ d.name ⧺ "' does not hold\n")
            self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lok, 0, 0, 0, 0)
        self.inv_subject ← saved

    // Which arguments of a listable call are the containers it is
    // threaded over.  The checker settled the call's type on the same
    // reading -- an array where the parameter asked for one of the
    // things in it -- so the two agree without either being told.
    // the same two readers the checker has, over the same tables
    fn lam_listable(&self, t : i64) → bool:
        self.a.ltf[types.ty_lidx(t) × 1¤ptrdiff] = 1

    fn lam_pt(&self, t : i64, i : i64 ¤ptrdiff) → i64:
        self.a.lte[self.a.lts[types.ty_lidx(t) × 1¤ptrdiff] × 1¤ptrdiff + i]

    fn thread_mask(&mut self, args_off : i64 ¤"aextra", argc : i64 ¤ptrdiff, pts : i64[]) → i64[]:
        let thr : mut i64[] = []
        foreach i := 0…argc:
            let an : i64 = self.a.extra[args_off + 1 + i]
            let at : i64 = types.ty_strip_ref(self.tof(an))
            let pb : i64 = types.ty_strip_ref(pts[i])
            if types.ty_is_arr(at) and not types.ty_is_arr(pb) and types.ty_ref_kind(pts[i]) = 0:
                thr.push(1)
            else:
                thr.push(0)
        thr

    fn threads_any(&self, thr : i64[]) → bool:
        marks_thread ∃ thr

// one mark of the thread mask, asked about on its own so that the
// question over the whole mask is one ∃
fn marks_thread(f : i64) → bool:
    f = 1

impl Lower:
    // The loop a listable call is: each turn indexes the threaded
    // arguments, leaves the others as they are, and pushes what the
    // call answers onto a fresh array.  How many turns the first
    // threaded argument says, and every other one is asked to agree --
    // element against element is what threading means, and two lengths
    // would leave the odd elements with nothing to meet.
    //
    // boxv is ⁻1 for a call by name and the box for one through a
    // binding, which is the only difference between the two.
    fn lower_thread(&mut self, thr : i64[], vals : i64[], f : i64,
                    boxv : i64) → i64:
        // pushed into extra beside plain numbers
        let argc : i64 = @dropunit(#thr)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.anew, 4, 0, 0, d, 0)
        let n : i64 = self.tmp()
        let seen : mut bool = false
        foreach j0 := 0…#thr:
            if thr[j0] = 1:
                if seen:
                    // a second container: its length has to be the first's
                    let n2 : i64 = self.tmp()
                    self.ir(ir.Ir.alen, vals[j0], 0, 0, n2, 0)
                    let same : i64 = self.tmp()
                    self.ir(ir.Ir.ceq, n, n2, 0, same, 64 + 256)
                    let lok : i64 = self.label()
                    self.ir(ir.Ir.jnz, same, lok, 0, 0, 0)
                    let m : i64 = self.intern("""a listable call meets element against element, and
                                               " its containers are of different lengths\n""")
                    self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
                    self.ir(ir.Ir.label, lok, 0, 0, 0, 0)
                else:
                    self.ir(ir.Ir.alen, vals[j0], 0, 0, n, 0)
                    seen ← true
        assert(seen, "a threaded call has a container to thread over")
        let iv : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, iv, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c : i64 = self.tmp()
        self.ir(ir.Ir.clt, iv, n, 0, c, 64 + 256)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        let cargs : mut i64[] = []
        foreach j := 0…#thr:
            if thr[j] = 1:
                let e : i64 = self.tmp()
                self.ir(ir.Ir.aidx, vals[j], iv, 0, e, 0)
                cargs.push(e)
            else:
                cargs.push(vals[j])
        let off : i64 = @dropunit(#self.extra)
        if boxv = ⁻1:
            self.extra.push(argc)
        else:
            self.extra.push(argc + 1)
        self.extra ← self.extra ⧺ cargs
        let r : i64 = self.tmp()
        if boxv = ⁻1:
            self.ir(ir.Ir.call, f, off, 0, r, 0)
        else:
            self.extra.push(boxv)
            let ad : i64 = self.tmp()
            self.ir(ir.Ir.fld, boxv, 0, 0, ad, 0)
            self.ir(ir.Ir.calli, ad, off, 0, r, 0)
        self.ir(ir.Ir.apush, d, r, 0, 0, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, iv, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, iv, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        d

    // By value means a copy.  The copy is elided wherever it cannot be
    // noticed, which is everywhere but here: a &mut of the same thing
    // in the same call, where the callee would otherwise watch its own
    // argument change under it.  The checker found these and said
    // which; this is where the copy is made.  Cycling an array to its
    // own length is a fresh array of the same elements, which is what
    // the language already has for the job.
    fn copied_arg(&mut self, node : i64, v : i64) → i64:
        if #self.argcopy = 0:
            return v
        let n : i64 ¤ptrdiff = #self.argcopy
        let i : mut i64 ¤ptrdiff = 0¤ptrdiff
        let want : mut bool = false
        while i < n:
            if self.argcopy[i] = node:
                want ← true
            i ← i + 1
        if not want:
            return v
        let len : i64 = self.tmp()
        self.ir(ir.Ir.alen, v, 0, 0, len, 0)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.acyc, len, v, 0, d, 0)
        d

    fn lower_assert(&mut self, nid : i64, tok : i64, args_off : i64 ¤"aextra", is_eq : bool):
        let line : i64 ¤"line" = self.tok_line(tok)
        let lok : i64 = self.label()
        if is_eq:
            let x : i64 = self.a.extra[args_off + 1]
            let y : i64 = self.a.extra[args_off + 2]
            let c : mut i64 = 0
            if types.ty_is_opt(self.tof(x)) and types.ty_is_opt(self.tof(y)):
                c ← self.lower_opt_eq(x, y)
            elif self.tof(x) = types.TY_STR:
                let av0 : i64 = self.lower_expr(x)
                let bv0 : i64 = self.lower_expr(y)
                c ← self.tmp()
                self.ir(ir.Ir.seqv, av0, bv0, 0, c, 64)
            elif types.ty_is_bigint(self.tof(x)):
                // two ints are equal when they say so, not when they
                // are the same block
                let av1 : i64 = self.lower_expr(x)
                let bv1 : i64 = self.lower_expr(y)
                let cc : i64 = self.rt2(emit.RT_BIGCMP, av1, bv1)
                let zz : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, zz, 64)
                c ← self.tmp()
                self.ir(ir.Ir.ceq, cc, zz, 0, c, 64 + 256)
            else:
                let av : i64 = self.lower_expr(x)
                let bv : i64 = self.lower_expr(y)
                c ← self.tmp()
                self.ir(ir.Ir.ceq, av, bv, 0, c, width_of(self.tof(x)))
            self.ir(ir.Ir.jnz, c, lok, 0, 0, 0)
            let m : i64 = self.intern("assertion does not hold (line " ⧺ tokens.i64_str(@dropunit(line)) ⧺ ")\n")
            self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
        else:
            let cv : i64 = self.lower_expr(self.a.extra[args_off + 1])
            self.ir(ir.Ir.jnz, cv, lok, 0, 0, 0)
            let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
            let msg : mut str = "assertion does not hold (line " ⧺ tokens.i64_str(@dropunit(line)) ⧺ ")\n"
            if argc = 2:
                let marg : i64 = self.a.extra[args_off + 2]
                msg ← "assertion does not hold (line " ⧺ tokens.i64_str(@dropunit(line)) ⧺ "): " ⧺ self.a.strs[self.a.na[marg × 1¤ptrdiff] × 1¤ptrdiff] ⧺ "\n"
            let m : i64 = self.intern(msg)
            self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lok, 0, 0, 0, 0)

    fn lower_scall(&mut self, nid : i64, tok : i64, sb : i64, args_off : i64 ¤"aextra"):
        if sb = ast.Sb.exit.ord():
            let v : i64 = self.lower_expr(self.a.extra[args_off + 1])
            self.ir(ir.Ir.exit, v, 0, 0, 0, 0)
            return
        let fmt : i64 = self.a.extra[args_off + 1]
        let cs : str = self.a.strs[self.a.na[fmt × 1¤ptrdiff] × 1¤ptrdiff]
        let argi : mut i64 ¤ptrdiff = 2
        // The text between the fields is taken where it stands: what
        // runs from the end of the last field to the start of this one
        // is one slice of the format, not a string gathered a
        // character at a time.
        let cut : mut i64 ¤ptrdiff = 0
        let i : mut i64 ¤ptrdiff = 0
        while i < #cs:
            if i + 1 < #cs and cs[i] = '{' and cs[i + 1] = '}':
                let chunk : str = cs[cut…i]
                if chunk ≠ "":
                    let m : i64 = self.intern(chunk)
                    self.ir(ir.Ir.prints, m, 0, 0, 0, 0)
                let arg : i64 = self.a.extra[args_off + argi]
                self.lower_print_arg(arg)
                argi ← argi + 1
                i ← i + 2
                cut ← i
            else:
                i ← i + 1
        let rest : mut str = cs[cut…#cs]
        if sb = ast.Sb.println.ord():
            rest ← rest ⧺ (10).chr()
        if rest ≠ "":
            let m : i64 = self.intern(rest)
            self.ir(ir.Ir.prints, m, 0, 0, 0, 0)

    fn lower_print_arg(&mut self, arg : i64):
        let t : i64 = self.tof(arg)
        if t = types.TY_STR:
            if self.kof(arg) = ast.Nk.lit_str:
                let m : i64 = self.intern(self.a.strs[self.a.na[arg × 1¤ptrdiff] × 1¤ptrdiff])
                self.ir(ir.Ir.prints, m, 0, 0, 0, 0)
            else:
                let v : i64 = self.lower_expr(arg)
                self.ir(ir.Ir.printsv, v, 0, 0, 0, 0)
        elif t = types.TY_CHAR:
            let v : i64 = self.lower_expr(arg)
            let sv : i64 = self.tmp()
            self.ir(ir.Ir.charstr, v, 0, 0, sv, 0)
            self.ir(ir.Ir.printsv, sv, 0, 0, 0, 0)
        elif t = types.TY_BOOL:
            let v : i64 = self.lower_expr(arg)
            let mt : i64 = self.intern("true")
            let mf : i64 = self.intern("false")
            let lfalse : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.jz, v, lfalse, 0, 0, 0)
            self.ir(ir.Ir.prints, mt, 0, 0, 0, 0)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lfalse, 0, 0, 0, 0)
            self.ir(ir.Ir.prints, mf, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        elif types.ty_is_bigint(t):
            let v : i64 = self.lower_expr(arg)
            _ ← self.rt1(emit.RT_BIGPRINT, v)
        else:
            let v : i64 = self.lower_expr(arg)
            if types.ty_sgn(t) = 1:
                self.ir(ir.Ir.printi, v, 0, 0, 0, 0)
            else:
                self.ir(ir.Ir.printu, v, 0, 0, 0, 0)
            // a measured value prints its measure, as the interpreter does
            let u : i64 = types.ty_unit(t)
            if u ≠ types.UNIT_NONE:
                self.ir(ir.Ir.prints, self.intern(" " ⧺ self.a.umarks[u × 1¤ptrdiff]), 0, 0, 0, 0)

    // ------------------------------------------------------------------
    // Statements
    // ------------------------------------------------------------------

    fn lower_block(&mut self, blk : i64, is_fn_body : bool, ret_ty : i64):
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            let s : i64 = self.a.extra[(off + 1 + i) × 1¤ptrdiff]
            let trailing : bool = is_fn_body and i = n - 1
            self.lower_stmt(s, trailing, ret_ty)
            self.reclaim_after(s)

    // An array the checker found finished with after this statement:
    // its slots go back, as a walk's do, unless they lie inside the
    // descriptor, which is not a block of its own.
    fn reclaim_after(&mut self, s : i64):
        foreach i := 0¤ptrdiff…#self.rec_stmt:
            if self.rec_stmt[i] ≠ s:
                continue
            let desc : i64 = self.rec_slot[i]
            let lkeep : i64 = self.label()
            let dsl : i64 = self.tmp()
            self.ir(ir.Ir.fld, desc, 0, 0, dsl, 0)
            let hoff : i64 = self.tmp()
            self.ir(ir.Ir.const, 24, 0, 0, hoff, 0)
            let inl : i64 = self.tmp()
            self.ir(ir.Ir.add, desc, hoff, 0, inl, 64 + 256)
            let same : i64 = self.tmp()
            self.ir(ir.Ir.ceq, dsl, inl, 0, same, 64 + 256)
            self.ir(ir.Ir.jnz, same, lkeep, 0, 0, 0)
            let dcp : i64 = self.tmp()
            self.ir(ir.Ir.fld, desc, 2, 0, dcp, 0)
            let three : i64 = self.tmp()
            self.ir(ir.Ir.const, 3, 0, 0, three, 0)
            let nby : i64 = self.tmp()
            self.ir(ir.Ir.shll, dcp, three, 0, nby, 64 + 256)
            self.ir(ir.Ir.giveback, dsl, nby, 0, 0, 0)
            self.ir(ir.Ir.label, lkeep, 0, 0, 0, 0)

    // what a return hands over: a bare value under an optional answer
    // boxes itself, and a bare ÷ or % answers ∅ for the zero divisor
    // Whether this is a call, in tail position, to the very function
    // being lowered -- a plain call by name, with the parameters it
    // takes, and this function one that may be turned round at all.
    fn tail_call_here(&mut self, na : i64) → bool:
        if self.tail_label = ⁻1 or self.kof(na) ≠ ast.Nk.call:
            return false
        if self.a.nc[na × 1¤ptrdiff] ≠ 0:
            // through a binding's box, a partial, a generate: not the
            // plain call this turns
            return false
        if self.fname_index(self.text(self.a.ntok[na × 1¤ptrdiff])) ≠ self.tail_fn:
            return false
        self.a.extra[self.a.na[na × 1¤ptrdiff] × 1¤ptrdiff] = self.tail_np

    // The call as a loop.  Every argument is worked out before any
    // parameter is written, since an argument may still read a
    // parameter the write would have destroyed -- `f(b, a)` is the
    // plain case of it.  Nothing after the call reads a local, tail
    // position being what that means, so the frame is used again
    // rather than stacked.
    fn lower_tail(&mut self, na : i64):
        let args_off : i64 ¤"aextra" = self.a.na[na × 1¤ptrdiff] × 1¤"aextra"
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        let vals : mut i64[] = []
        foreach i := 0…argc:
            let an : i64 = self.a.extra[args_off + 1 + i]
            let v0 : i64 = self.copied_arg(an, self.lower_expr(an))
            let v : mut i64 = v0
            if v0 >= 0 and v0 < self.tail_np:
                // A bare parameter is not a copy of itself: it is the
                // slot, and the slots are what is about to be written.
                // `f(b, a)` is where that shows -- without this, a is
                // written before b is read and both come out the same.
                let s : i64 = self.tmp()
                self.ir(ir.Ir.mov, v0, 0, 0, s, 0)
                v ← s
            vals.push(v)
        assert(@dropunit(#vals) = argc, "one value per argument")
        self.decide(self.tok_line(self.a.ntok[na × 1¤ptrdiff]), "tail-call-loop", "")
        foreach j := 0…argc:
            self.ir(ir.Ir.mov, vals[j], 0, 0, @dropunit(j), 0)
        self.ir(ir.Ir.jmp, self.tail_label, 0, 0, 0, 0)

    fn lower_ret_value(&mut self, na : i64):
        if self.tail_call_here(na):
            self.lower_tail(na)
            return
        if types.ty_is_opt(self.cur_ret) and (self.kof(na) = ast.Nk.div or self.kof(na) = ast.Nk.mod) and not types.ty_is_opt(self.tof(na)):
            let av9 : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
            let bv9 : i64 = self.lower_expr(self.a.nb[na × 1¤ptrdiff])
            let lok9 : i64 = self.label()
            self.ir(ir.Ir.jnz, bv9, lok9, 0, 0, 0)
            let zn9 : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, zn9, 0)
            self.lower_ret(zn9)
            self.ir(ir.Ir.label, lok9, 0, 0, 0, 0)
            let zd9 : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, zd9, 0)
            let q9 : i64 = self.tmp()
            self.ir(if self.kof(na) = ast.Nk.div: ir.Ir.divv else: ir.Ir.modd, av9, bv9, zd9, q9, width_of(self.tof(na)))
            let bb9 : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, bb9, 0)
            self.ir(ir.Ir.fsto, bb9, 0, q9, 0, 0)
            self.lower_ret(bb9)
            return
        let v0 : i64 = self.lower_expr(na)
        // Without the & the signature promises the caller a value of
        // its own, so an answer that is not the function's to give --
        // a field, an element, a parameter, a global, anything not
        // born fresh in this function -- is copied on the way out.
        let vt : i64 = self.tof(na)
        let v : i64 = if self.cur_ref = 0 and not types.ty_is_opt(vt) and not self.answer_moves(na): self.copied_answer(na, v0, vt) else: v0
        // nhold says the checker already had it held on the way out of
        // lower_expr; holding it again would make an optional of an
        // optional, which is nobody's value.
        if types.ty_is_opt(self.cur_ret) and not types.ty_is_opt(self.tof(na)) and (self.nhold[na × 1¤ptrdiff] & 1) = 0:
            let b9 : i64 = self.tmp()
            self.ir(ir.Ir.snew, 1, 0, 0, b9, 0)
            self.ir(ir.Ir.fsto, b9, 0, v, 0, 0)
            self.lower_ret(b9)
            return
        self.lower_ret(v)

    // the single expression a block answers with, or ⁻1
    fn block_only_value(&self, blk : i64) → i64:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        if self.a.extra[off × 1¤ptrdiff] ≠ 1:
            return ⁻1
        let only : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        if self.kof(only) ≠ ast.Nk.exprstmt:
            return ⁻1
        self.a.na[only × 1¤ptrdiff]

    // Whether what this answers is the function's own to hand over:
    // something made here, or a binding born fresh here.  A field, an
    // element, a parameter or a global is not, and neither is a name
    // bound to one of those.
    fn answer_moves(&self, na : i64) → bool:
        let k : ast.Nk = self.kof(na)
        if k = ast.Nk.arrlit or k = ast.Nk.ccat or k = ast.Nk.slit or k = ast.Nk.hlit or k = ast.Nk.call or k = ast.Nk.mcall or k = ast.Nk.scall or k = ast.Nk.slice:
            return true
        if k = ast.Nk.reshape:
            let sk : ast.Nk = self.kof(self.a.nb[na × 1¤ptrdiff])
            return sk ≠ ast.Nk.var and sk ≠ ast.Nk.field and sk ≠ ast.Nk.index and sk ≠ ast.Nk.ref
        if k = ast.Nk.var:
            return self.nmove[na × 1¤ptrdiff] = 1
        if k = ast.Nk.st_if:
            let tv : i64 = self.block_only_value(self.a.nb[na × 1¤ptrdiff])
            let ec : i64 = self.a.nc[na × 1¤ptrdiff]
            let ev : i64 = if ec = ⁻1: ⁻1 else: self.block_only_value(ec)
            return tv ≠ ⁻1 and ev ≠ ⁻1 and self.answer_moves(tv) and self.answer_moves(ev)
        false

    // A copy of an array or a struct for the caller: the container is
    // fresh, and what it holds is what was held.  Anything else is a
    // value already, or has no copy yet and is handed over as it is.
    fn copied_answer(&mut self, na : i64, v : i64, t : i64) → i64:
        if types.ty_is_arr(t) and not types.ty_is_farr(t):
            self.decide(self.tok_line(self.a.ntok[na × 1¤ptrdiff]), "answer-copy", ", \"of\": \"array\"")
            let len : i64 = self.tmp()
            self.ir(ir.Ir.alen, v, 0, 0, len, 0)
            let d : i64 = self.tmp()
            self.ir(ir.Ir.acyc, len, v, 0, d, 0)
            return d
        if types.ty_is_struct(t):
            self.decide(self.tok_line(self.a.ntok[na × 1¤ptrdiff]), "answer-copy", ", \"of\": \"struct\"")
            let sd := self.a.structs[types.ty_sidx(t) × 1¤ptrdiff]
            let nf : i64 = self.a.extra[sd.fields_off]
            let d : i64 = self.tmp()
            self.ir(ir.Ir.snew, nf, 0, 0, d, 0)
            foreach i := 0…nf:
                let fv : i64 = self.tmp()
                self.ir(ir.Ir.fld, v, i, 0, fv, 0)
                self.ir(ir.Ir.fsto, d, i, fv, 0, 0)
            return d
        v

    fn lower_ret(&mut self, v : i64):
        if self.sret ≠ ⁻1 and self.packed_ty_n(self.cur_ret) >= 0:
            // the frame this was computed in ends at the return, so
            // the elements go where the caller said before that
            self.farr_copy(self.sret, v, self.cur_ret, self.packed_ty_n(self.cur_ret))
            if self.post_label ≠ ⁻1:
                self.ir(ir.Ir.mov, self.sret, 0, 0, self.res_vreg, 0)
                self.ir(ir.Ir.jmp, self.post_label, 0, 0, 0, 0)
            else:
                self.ir(ir.Ir.ret, self.sret, 0, 0, 0, 0)
            return
        if self.post_label ≠ ⁻1:
            self.ir(ir.Ir.mov, v, 0, 0, self.res_vreg, 0)
            self.ir(ir.Ir.jmp, self.post_label, 0, 0, 0, 0)
        else:
            self.ir(ir.Ir.ret, v, 0, 0, 0, 0)

    // An if, laid out so the way it is expected to go is the way that
    // falls through.  Without a hint the then-block falls through;
    // @unlikely says otherwise, and where there is an else the two swap
    // for nothing -- the same instructions, with the cold block out of
    // the straight line.  With no else there is nothing to swap it
    // with, and the layout stands as it was.
    fn lower_if(&mut self, sid : i64, unlikely : i64, trailing : bool, ret_ty : i64):
        if self.try_jtab(sid, ret_ty):
            return
        let na : i64 = self.a.na[sid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[sid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[sid × 1¤ptrdiff]
        let lelse : i64 = self.label()
        let cv : i64 = self.lower_expr(na)
        // An if standing last in a body hands each branch's value on
        // as the function's answer, so a branch is trailing exactly
        // when the if is.
        if unlikely = 1 and nc ≠ ⁻1:
            let lend2 : i64 = self.label()
            self.ir(ir.Ir.jnz, cv, lelse, 0, 0, 0)
            self.lower_block(nc, trailing, ret_ty)
            self.ir(ir.Ir.jmp, lend2, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lelse, 0, 0, 0, 0)
            self.lower_block(nb, trailing, ret_ty)
            self.ir(ir.Ir.label, lend2, 0, 0, 0, 0)
            return
        self.ir(ir.Ir.jz, cv, lelse, 0, 0, 0)
        self.lower_block(nb, trailing, ret_ty)
        if nc = ⁻1:
            self.ir(ir.Ir.label, lelse, 0, 0, 0, 0)
        else:
            let lend : i64 = self.label()
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lelse, 0, 0, 0, 0)
            self.lower_block(nc, trailing, ret_ty)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)

    fn lower_stmt(&mut self, sid : i64, trailing : bool, ret_ty : i64):
        self.tnext ← self.tbase
        let k : ast.Nk = self.kof(sid)
        let tok : i64 = self.a.ntok[sid × 1¤ptrdiff]
        let na : i64 = self.a.na[sid × 1¤ptrdiff]
        let nb : i64 = self.a.nb[sid × 1¤ptrdiff]
        let nc : i64 = self.a.nc[sid × 1¤ptrdiff]
        if k = ast.Nk.expects:
            // one that drew what it was marked to draw did not check,
            // and there is nothing of it to emit; one that drew nothing
            // is an ordinary statement and is emitted as one
            if nb = 0:
                self.lower_stmt(na, trailing, ret_ty)
        elif k = ast.Nk.st_let:
            let v : i64 = self.lower_let_value(sid, na)
            self.ir(ir.Ir.mov, v, 0, 0, self.nslot[sid × 1¤ptrdiff], 0)
        elif k = ast.Nk.st_lett:
            let n : i64 = self.a.extra[nc × 1¤ptrdiff]
            let v : i64 = self.lower_expr(na)
            let slot0 : i64 = self.nslot[sid × 1¤ptrdiff]
            foreach i := 0…n:
                self.ir(ir.Ir.fld, v, i, 0, slot0 + i, 0)
        elif k = ast.Nk.assign:
            // `v ← v ⧺ w`: the join is the array itself, grown, rather
            // than a fresh one built out of two.  What makes it the
            // same array is that the left of the ⧺ is the very place
            // being written, which nothing else may hold while it is
            // written -- an array binding is owned, and a second name
            // for one is a borrow the checker would not admit here.
            if self.extends_itself(sid, na):
                let dst0 : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let src0 : i64 = self.lower_arr_operand(self.a.nb[na × 1¤ptrdiff])
                _ ← self.rt2(emit.RT_AEXT, dst0, src0)
                return
            // `v ← v + w` and `v ← w + v`: the loop writes its answers
            // into the array v already names, element for element,
            // rather than building another of the same length
            let ds0 : i64 = self.threads_itself(sid, na)
            if ds0 >= 0:
                _ ← self.lower_thread_op(na, self.kof(na), self.a.na[na × 1¤ptrdiff], self.a.nb[na × 1¤ptrdiff], ds0)
                return
            let v : i64 = self.lower_expr(na)
            let slot : i64 = self.nslot[sid × 1¤ptrdiff]
            if slot <= ⁻2:
                self.ir(ir.Ir.gstore, 0 - slot - 2, v, 0, 0, 0)
            elif self.a.nb[sid × 1¤ptrdiff] = 1:
                // through the element's address, back into the array
                self.ir(ir.Ir.fsto, slot, 0, v, 0, 0)
            else:
                self.ir(ir.Ir.mov, v, 0, 0, slot, 0)
        elif k = ast.Nk.storefld:
            // the same, for a field: `b.xs ← b.xs ⧺ w`
            if self.extends_itself(sid, nb):
                let dst1 : i64 = self.lower_expr(self.a.na[nb × 1¤ptrdiff])
                let src1 : i64 = self.lower_arr_operand(self.a.nb[nb × 1¤ptrdiff])
                _ ← self.rt2(emit.RT_AEXT, dst1, src1)
                return
            // and the same, for `b.xs ← b.xs + w`
            let ds1 : i64 = self.threads_itself(sid, nb)
            if ds1 >= 0:
                _ ← self.lower_thread_op(nb, self.kof(nb), self.a.na[nb × 1¤ptrdiff], self.a.nb[nb × 1¤ptrdiff], ds1)
                return
            let bv : i64 = self.lower_expr(na)
            let vv : i64 = self.field_val(self.lower_expr(nb), self.tof(nb))
            self.ir(ir.Ir.fsto, bv, nc, vv, 0, 0)
            // and again once it has changed, or there would be a way to
            // have one that does not keep to what its type says
            self.lower_invariants(types.ty_strip_ref(self.tof(na)), bv)
        elif k = ast.Nk.storeidxp:
            let bv : i64 = self.lower_expr(na)
            let pns : i64 = self.packed_n(na)
            if types.ty_is_arr(types.ty_strip_ref(self.tof(nb))):
                // v[ix] ← w: a store at each index in ix
                let aiv : i64 = self.lower_expr(nb)
                let avv : i64 = self.lower_expr(nc)
                self.lower_amend(sid, bv, aiv, avv, types.ty_strip_ref(self.tof(nc)) = types.ty_strip_ref(self.tof(na)), self.tof(na), pns, width_of(self.elem_of(types.ty_strip_ref(self.tof(na)))))
                return
            if pns >= 0:
                let fk : i64 = self.const_index(nb)
                let fi : i64 = if fk ≠ ⁻1: 0 else: self.lower_expr(nb)
                let fv : i64 = self.lower_expr(nc)
                self.farr_store(bv, self.tof(na), pns, fi, fk, fv)
                return
            let iv : i64 = self.lower_expr(nb)
            let vv : i64 = self.lower_expr(nc)
            if types.ty_is_hash(self.tof(sid)):
                self.ir(ir.Ir.hput, bv, iv, vv, 0, 0)
            else:
                self.ir(ir.Ir.asto, bv, iv, vv, 0, 0)
        elif k = ast.Nk.discard:
            _ ← self.lower_expr(na)
        elif k = ast.Nk.exprstmt:
            if trailing and self.tail_call_here(na):
                // a function that answers nothing still ends at its
                // last statement, so a call to itself there is a tail
                // call like any other
                self.lower_tail(na)
            elif trailing and ret_ty ≠ types.TY_UNIT:
                self.lower_ret_value(na)
            else:
                _ ← self.lower_expr(na)
        elif k = ast.Nk.st_return:
            if na = ⁻1:
                self.ir(ir.Ir.ret, ⁻1, 0, 0, 0, 0)
            else:
                self.lower_ret_value(na)
        elif k = ast.Nk.hinted:
            self.lower_if(na, nb, trailing, ret_ty)
        elif k = ast.Nk.st_if:
            // Standing last in a body with both sides small enough to
            // be read without harm, the whole if is one value and the
            // answer is given once, chosen rather than branched to --
            // which is what the same thing written `a if c else b`
            // used to do, and there is no reason for the spelling to
            // cost a branch.
            // An if with no else answers an optional, which the
            // checker settled a type for; that is the signal that the
            // whole if is the value rather than a branch apiece.
            let ncs : i64 = self.a.nc[sid × 1¤ptrdiff]
            let whole : bool = self.if_selectable(sid) or (ncs = ⁻1 and self.tof(sid) ≠ types.TY_UNIT)
            if trailing and ret_ty ≠ types.TY_UNIT and whole:
                self.lower_ret_value(sid)
            else:
                self.lower_if(sid, 0, trailing, ret_ty)
        elif k = ast.Nk.st_while:
            let ltop : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
            let cv : i64 = self.lower_expr(na)
            self.ir(ir.Ir.jz, cv, lend, 0, 0, 0)
            self.breaks.push(lend)
            self.conts.push(ltop)
            self.lower_block(nb, false, ret_ty)
            _ ← self.breaks.pop() ?? 0
            _ ← self.conts.pop() ?? 0
            self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        elif k = ast.Nk.matche:
            self.lower_matche(sid, na, nb, nc, ret_ty, trailing, ⁻1)
        elif k = ast.Nk.st_match:
            let v : i64 = self.lower_expr(na)
            let bind : i64 = self.nslot[sid × 1¤ptrdiff]
            let lempty : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.jz, v, lempty, 0, 0, 0)
            self.ir(ir.Ir.fld, v, 0, 0, bind, 0)
            self.lower_block(self.a.extra[nb × 1¤ptrdiff], trailing, ret_ty)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lempty, 0, 0, 0, 0)
            self.lower_block(self.a.extra[(nb + 1) × 1¤ptrdiff], trailing, ret_ty)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        elif k = ast.Nk.st_foreach:
            self.lower_foreach(sid, tok, na, nb, ret_ty)
        elif k = ast.Nk.whileb:
            let evar : i64 = self.nslot[sid × 1¤ptrdiff]
            let ltop : i64 = self.label()
            let lend : i64 = self.label()
            self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
            if self.kof(na) = ast.Nk.mcall and self.a.nc[na × 1¤ptrdiff] = check.Mid.pop.ord():
                // pop's own emptiness is the loop's test
                let av9 : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let n9 : i64 = self.tmp()
                self.ir(ir.Ir.alen, av9, 0, 0, n9, 0)
                self.ir(ir.Ir.jz, n9, lend, 0, 0, 0)
                let dz : i64 = self.tmp()
                self.ir(ir.Ir.const, 0, 0, 0, dz, 0)
                self.ir(ir.Ir.apop, av9, dz, 0, evar, width_of(self.tof(na)))
            elif self.kof(na) = ast.Nk.mcall and self.a.nc[na × 1¤ptrdiff] = check.Mid.get.ord():
                // the place is asked afresh each turn; absence ends it
                let avg : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let ivg : i64 = self.lower_expr(self.a.extra[(self.a.nb[na × 1¤ptrdiff] + 1) × 1¤ptrdiff])
                let ng : i64 = self.tmp()
                self.ir(ir.Ir.alen, avg, 0, 0, ng, 0)
                let cg : i64 = self.tmp()
                self.ir(ir.Ir.clt, ivg, ng, 0, cg, 64)
                self.ir(ir.Ir.jz, cg, lend, 0, 0, 0)
                self.ir(ir.Ir.aidx, avg, ivg, 0, evar, 0)
            elif self.kof(na) = ast.Nk.mcall and self.a.nc[na × 1¤ptrdiff] = check.Mid.next.ord():
                // the iterator's position against its array's length
                let itv : i64 = self.lower_expr(self.a.na[na × 1¤ptrdiff])
                let dsc9 : i64 = self.tmp()
                self.ir(ir.Ir.fld, itv, 0, 0, dsc9, 0)
                let pos9 : i64 = self.tmp()
                self.ir(ir.Ir.fld, itv, 1, 0, pos9, 0)
                let len9 : i64 = self.tmp()
                self.ir(ir.Ir.alen, dsc9, 0, 0, len9, 0)
                let cc9 : i64 = self.tmp()
                self.ir(ir.Ir.clt, pos9, len9, 0, cc9, 64 + 256)
                self.ir(ir.Ir.jz, cc9, lend, 0, 0, 0)
                if self.a.extra[nc × 1¤ptrdiff] = 1:
                    // the element's address, to write back through
                    self.ir(ir.Ir.aref, dsc9, pos9, 0, evar, 0)
                else:
                    self.ir(ir.Ir.aidx, dsc9, pos9, 0, evar, 0)
                let on9 : i64 = self.tmp()
                self.ir(ir.Ir.const, 1, 0, 0, on9, 0)
                let npp : i64 = self.tmp()
                self.ir(ir.Ir.addw, pos9, on9, 0, npp, 64 + 256)
                self.ir(ir.Ir.fsto, itv, 1, npp, 0, 0)
            else:
                let v9 : i64 = self.lower_expr(na)
                self.ir(ir.Ir.jz, v9, lend, 0, 0, 0)
                if types.ty_is_opt(self.tof(na)):
                    self.ir(ir.Ir.fld, v9, 0, 0, evar, 0)
                else:
                    self.ir(ir.Ir.mov, v9, 0, 0, evar, 0)
            self.breaks.push(lend)
            self.conts.push(ltop)
            self.lower_block(nb, false, ret_ty)
            _ ← self.breaks.pop() ?? 0
            _ ← self.conts.pop() ?? 0
            self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        elif k = ast.Nk.foreacha:
            self.lower_foreacha(sid, tok, na, nb, ret_ty)
        elif k = ast.Nk.st_break:
            self.ir(ir.Ir.jmp, self.breaks[#self.breaks - 1], 0, 0, 0, 0)
        elif k = ast.Nk.st_continue:
            self.ir(ir.Ir.jmp, self.conts[#self.conts - 1], 0, 0, 0, 0)

    // ------------------------------------------------------------------
    // Dense dispatch becomes a jump table.  An if/elif ladder testing
    // one variable against integer constants is one decision, not
    // many; with at least four cases and a span within three times
    // their count (the profitability window real compilers use), the
    // ladder lowers to a bounds check and one indirect jump through a
    // table of code addresses in rodata.
    // ------------------------------------------------------------------

    fn try_jtab(&mut self, sid : i64, ret_ty : i64) → bool:
        let ks : mut i64[] = []
        let blks : mut i64[] = []
        let xslot : mut i64 = ⁻1
        let default_blk : mut i64 = ⁻1
        let cur : mut i64 = sid
        let good : mut bool = true
        while true:
            let cond : i64 = self.a.na[cur × 1¤ptrdiff]
            if self.kof(cond) ≠ ast.Nk.eq:
                good ← false
                break
            let l : i64 = self.a.na[cond × 1¤ptrdiff]
            let r : i64 = self.a.nb[cond × 1¤ptrdiff]
            let vn : mut i64 = ⁻1
            let kn : mut i64 = ⁻1
            if self.kof(l) = ast.Nk.var and self.kof(r) = ast.Nk.lit_int:
                vn ← l
                kn ← r
            elif self.kof(r) = ast.Nk.var and self.kof(l) = ast.Nk.lit_int:
                vn ← r
                kn ← l
            else:
                good ← false
                break
            let slot : i64 = self.nslot[vn × 1¤ptrdiff]
            if slot < 0 or self.a.nb[kn × 1¤ptrdiff] ≠ 0:
                // a global, or a constant past i64: leave it a ladder
                good ← false
                break
            if xslot = ⁻1:
                xslot ← slot
            elif slot ≠ xslot:
                good ← false
                break
            ks.push(self.a.na[kn × 1¤ptrdiff])
            blks.push(self.a.nb[cur × 1¤ptrdiff])
            let els : i64 = self.a.nc[cur × 1¤ptrdiff]
            if els = ⁻1:
                break
            // an elif chain is an else block holding exactly one if
            let off : i64 = self.a.na[els × 1¤ptrdiff]
            if self.a.extra[off × 1¤ptrdiff] = 1 and self.kof(self.a.extra[(off + 1) × 1¤ptrdiff]) = ast.Nk.st_if:
                cur ← self.a.extra[(off + 1) × 1¤ptrdiff]
            else:
                default_blk ← els
                break
        assert(#ks = #blks, "one arm per case")
        if not good or #ks < 4:
            return false
        let lo : mut i64 = ks[0]
        let hi : mut i64 = ks[0]
        foreach k := ks:
            lo ← lo ⌊ k
            hi ← hi ⌈ k
        let span : i64 = hi - lo + 1
        let shape : str = ", \"cases\": " ⧺ tokens.i64_str(@dropunit(#ks)) ⧺ ", \"span\": " ⧺ tokens.i64_str(span)
        if span > 3 × @dropunit(#ks) or span > 1024:
            self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "ladder-kept", shape)
            return false
        // distinct cases; a repeat would silently shadow, so leave a
        // repeat to the ladder the checker saw
        foreach i := 0…#ks:
            foreach j := 0…#ks:
                if j > i and ks[i] = ks[j]:
                    return false
        // a ladder whose every arm returns a constant, default
        // included, is not control flow at all: it folds to one load
        // from a table of values and one select against the default
        if default_blk ≠ ⁻1 and self.post_label = ⁻1:
            let vals : mut i64[] = []
            let all_const : mut bool = true
            foreach b := blks:
                let cv : i64 = self.block_ret_const(b)
                if cv = ⁻4611686018427387904:
                    all_const ← false
                vals.push(cv)
            let defv : i64 = self.block_ret_const(default_blk)
            if defv = ⁻4611686018427387904:
                all_const ← false
            if all_const:
                let off0 : i64 = @dropunit(#self.extra)
                self.extra.push(lo)
                self.extra.push(span)
                self.extra.push(defv)
                foreach si := 0…span:
                    let entry : mut i64 = defv
                    foreach i := 0…#ks:
                        if ks[i] = lo + si:
                            entry ← vals[i]
                    self.extra.push(entry)
                let xv0 : i64 = xslot
                let d : i64 = self.tmp()
                self.ir(ir.Ir.vtab, xv0, off0, 0, d, 0)
                self.ir(ir.Ir.ret, d, 0, 0, 0, 0)
                self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "value-table", shape)
                return true
        // labels: one per case, the default, the join
        let ldef : i64 = self.label()
        let lend : i64 = self.label()
        let case_labels : mut i64[] = []
        foreach _ := 0…#ks:
            case_labels.push(self.label())
        let off : i64 = @dropunit(#self.extra)
        self.extra.push(lo)
        self.extra.push(span)
        self.extra.push(ldef)
        foreach s := 0…span:
            let target : mut i64 = ldef
            foreach i := 0…#ks:
                if ks[i] = lo + s:
                    target ← case_labels[i]
            self.extra.push(target)
        self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "jump-table", shape)
        self.ir(ir.Ir.jtab, xslot, off, 0, 0, 0)
        foreach i := 0…#ks:
            self.ir(ir.Ir.label, case_labels[i], 0, 0, 0, 0)
            self.lower_block(blks[i], false, ret_ty)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
        self.ir(ir.Ir.label, ldef, 0, 0, 0, 0)
        if default_blk ≠ ⁻1:
            self.lower_block(default_blk, false, ret_ty)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        true

    // ------------------------------------------------------------------
    // match over an enumeration
    // ------------------------------------------------------------------
    //
    // The checker has already seen that every value has an arm, so
    // there is nothing to decide here beyond how to get to the right
    // one.  An enumeration's values are usually a dense little run,
    // which is the case a jump table is for -- one bounds check and one
    // indirect jump, whatever the arm count -- and the same span test
    // the if-ladder uses says when it is not worth it.
    // dest is ⁻1 where the match stands as a statement, and the place
    // the value goes where it stands as a value: each arm writes what
    // it answers there and the ways out meet at the end.
    fn lower_matche(&mut self, sid : i64, na : i64, nb : i64, ei : i64, ret_ty : i64, trailing : bool, dest : i64):
        let n : i64 = self.a.extra[nb × 1¤ptrdiff]
        let dflt : i64 = self.a.extra[(nb + 1) × 1¤ptrdiff]
        let est : i64 = self.a.estart[ei × 1¤ptrdiff]
        let ecount : i64 = self.a.ecount[ei × 1¤ptrdiff]
        // what each arm stands for, and where it goes
        let ks : mut i64[] = []
        let blks : mut i64[] = []
        foreach i := 0…n:
            let mtok : i64 = self.a.extra[(nb + 3 + i × 3) × 1¤ptrdiff]
            let m := self.text(mtok)
            foreach mi := 0…ecount:
                if self.a.emembers[(est + mi) × 1¤ptrdiff] = m:
                    ks.push(self.a.evalues[(est + mi) × 1¤ptrdiff])
                    break
            blks.push(self.a.extra[(nb + 4 + i × 3) × 1¤ptrdiff])
        assert(#ks = #blks, "one value per arm")
        let sv : i64 = self.lower_expr(na)
        let lend : i64 = self.label()
        let ldef : i64 = self.label()
        let case_labels : mut i64[] = []
        foreach ci := 0…n:
            case_labels.push(self.label())
        let lo : mut i64 = ks[0¤ptrdiff]
        let hi : mut i64 = ks[0¤ptrdiff]
        foreach kv := ks:
            lo ← lo ⌊ kv
            hi ← hi ⌈ kv
        let span : i64 = hi - lo + 1
        let shape : str = ", \"cases\": " ⧺ tokens.i64_str(n) ⧺ ", \"span\": " ⧺ tokens.i64_str(span)
        let tabled : bool = n >= 4 and span <= 3 × n and span <= 1024
        if tabled:
            let off : i64 = @dropunit(#self.extra)
            self.extra.push(lo)
            self.extra.push(span)
            self.extra.push(ldef)
            foreach s := 0…span:
                let target : mut i64 = ldef
                foreach j := 0…#ks:
                    if ks[j] = lo + s:
                        target ← case_labels[j]
                self.extra.push(target)
            self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "match-jump-table", shape)
            self.ir(ir.Ir.jtab, sv, off, 0, 0, 0)
        else:
            self.decide(self.tok_line(self.a.ntok[sid × 1¤ptrdiff]), "match-ladder", shape)
            foreach j := 0…#ks:
                let kv : i64 = self.tmp()
                self.ir(ir.Ir.const, ks[j], 0, 0, kv, 0)
                let c : i64 = self.tmp()
                self.ir(ir.Ir.ceq, sv, kv, 0, c, 64 + 256)
                self.ir(ir.Ir.jnz, c, case_labels[j], 0, 0, 0)
            self.ir(ir.Ir.jmp, ldef, 0, 0, 0, 0)
        let toopt : bool = dest ≠ ⁻1 and types.ty_is_opt(self.tof(sid))
        foreach b := 0…#blks:
            self.ir(ir.Ir.label, case_labels[b], 0, 0, 0, 0)
            if dest ≠ ⁻1:
                self.lower_block_value(blks[b], dest, toopt)
            else:
                self.lower_block(blks[b], trailing, ret_ty)
            self.ir(ir.Ir.jmp, lend, 0, 0, 0, 0)
        self.ir(ir.Ir.label, ldef, 0, 0, 0, 0)
        if dflt ≠ ⁻1:
            if dest ≠ ⁻1:
                self.lower_block_value(dflt, dest, toopt)
            else:
                self.lower_block(dflt, trailing, ret_ty)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)

    // the constant a block returns, or the impossible sentinel
    fn block_ret_const(&self, blk : i64) → i64:
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        if self.a.extra[off × 1¤ptrdiff] ≠ 1:
            return ⁻4611686018427387904
        let st : i64 = self.a.extra[(off + 1) × 1¤ptrdiff]
        if self.kof(st) ≠ ast.Nk.st_return:
            return ⁻4611686018427387904
        let e : i64 = self.a.na[st × 1¤ptrdiff]
        if e = ⁻1:
            return ⁻4611686018427387904
        let ek : ast.Nk = self.kof(e)
        if ek ≠ ast.Nk.lit_int and ek ≠ ast.Nk.lit_bool:
            return ⁻4611686018427387904
        // a constant that happens to be the sentinel itself simply
        // does not fold; the jump table serves it instead
        self.a.na[e × 1¤ptrdiff]

    fn elem_of(&self, t : i64) → i64:
        if types.ty_is_mat(t):
            return self.a.minner[types.ty_midx(t) × 1¤ptrdiff]
        if types.ty_is_farr(t): self.a.fae[types.ty_fidx(t) × 1¤ptrdiff] else: types.ty_elem(t)

    fn farr_size(&self, t : i64) → i64:
        self.a.fas[types.ty_fidx(t) × 1¤ptrdiff]

    // ------------------------------------------------------------------
    // A sized array is its elements and nothing else
    // ------------------------------------------------------------------
    //
    // A T[] is a pointer to {data, length, capacity} and a second
    // allocation for the data.  A T[N] carries no length, because the
    // type already says it, and no capacity, because nothing may grow
    // it: the value is a pointer to N elements laid out exactly as
    // @repr(C) would lay them, and the elements live in the frame.  A
    // u8[32] is thirty-two bytes and one address, where the same thing
    // as a T[] was two allocations, a twenty-four byte header and two
    // hundred and fifty-six bytes of eight-byte slots.
    //
    // The bound is a constant, so an index that is also a constant is
    // checked here and costs nothing at run time.

    // An index written out, or ⁻1 where it is not.  Only the forms an
    // index is actually written in are read: a bare number, the
    // `k × 1¤ptrdiff` that gives one its measure, and @dropunit around
    // either.  Anything else answers ⁻1 and is checked at run time.
    //
    // A folded index skips the bound, so one that is out of range must
    // not fold to something in range: the callers check what comes back
    // against the size, and a number that fails is left to the abort.
    @post(r: r >= ⁻1)
    fn const_index(&self, id : i64) → i64:
        let k : ast.Nk = self.kof(id)
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        if k = ast.Nk.lit_int:
            return if nb ≠ 0 or na < 0: ⁻1 else: na
        if k = ast.Nk.dropu:
            return self.const_index(na)
        if k = ast.Nk.mul:
            let l : i64 = self.const_index(na)
            let r : i64 = self.const_index(nb)
            return if l = ⁻1 or r = ⁻1: ⁻1 else: l × r
        ⁻1

    // How many elements an array's value is, where the value is the
    // elements themselves and nothing else.  A T[N] says so in its
    // type; a T[] says so where the checker settled that its length
    // never changes and it never leaves the function.  ⁻1 where the
    // array is an ordinary one, header and all.
    @post(r: r >= ⁻1)
    fn packed_n(&self, id : i64) → i64:
        let t : i64 = self.tof(id)
        if check.farr_is_packed(self.a, t): self.farr_size(t) else: self.nrep[id × 1¤ptrdiff]

    // the same for a type alone, where there is no node to ask: a
    // return type, a field's type
    @post(r: r >= ⁻1)
    fn packed_ty_n(&self, t : i64) → i64:
        if check.farr_is_packed(self.a, t): self.farr_size(t) else: ⁻1

    @post(r: r > 0)
    fn farr_esize(&self, t : i64) → i64:
        let (es, ea) := check.c_layout(self.a, self.elem_of(t), 0)
        _ ← ea
        es

    // the frame space for one, its address in a fresh vreg
    @pre(n >= 0)
    fn farr_new(&mut self, t : i64, n : i64) → i64:
        let (es, ea) := check.c_layout(self.a, self.elem_of(t), 0)
        let at : i64 = self.frame_alloc(es × n, ea)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.frame, at, 0, 0, d, 0)
        d

    // the address of element i, bounds-checked against the constant
    // the type states; a constant index is checked here instead
    // base + i×element, with nothing checked: for a walk that already
    // holds the index inside the bound
    fn farr_addr_at(&mut self, base : i64, t : i64, iv : i64) → i64:
        let sc : i64 = self.tmp()
        self.ir(ir.Ir.const, self.farr_esize(t), 0, 0, sc, 0)
        let byteoff : i64 = self.tmp()
        self.ir(ir.Ir.mul, iv, sc, 0, byteoff, 64 + 256)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.add, base, byteoff, 0, d, 64 + 256)
        d

    @pre(n >= 0)
    fn farr_addr(&mut self, base : i64, t : i64, n : i64, iv : i64, kidx : i64) → i64:
        let es : i64 = self.farr_esize(t)
        if kidx ≠ ⁻1 and (kidx < 0 or kidx >= n):
            // written out and outside: the bound fails here, always
            self.ir(ir.Ir.abort, self.intern("index out of range\n"), 0, 0, 0, 0)
            return base
        if kidx ≠ ⁻1:
            // the index is written out, so the bound is settled now
            let off : i64 = self.tmp()
            self.ir(ir.Ir.const, es × kidx, 0, 0, off, 0)
            let d0 : i64 = self.tmp()
            self.ir(ir.Ir.add, base, off, 0, d0, 64 + 256)
            return d0
        let nv : i64 = self.tmp()
        self.ir(ir.Ir.const, n, 0, 0, nv, 0)
        let ok : i64 = self.tmp()
        self.ir(ir.Ir.clt, iv, nv, 0, ok, 64)          // unsigned: negative fails too
        let lok : i64 = self.label()
        self.ir(ir.Ir.jnz, ok, lok, 0, 0, 0)
        self.ir(ir.Ir.abort, self.intern("index out of range\n"), 0, 0, 0, 0)
        self.ir(ir.Ir.label, lok, 0, 0, 0, 0)
        _ ← es
        self.farr_addr_at(base, t, iv)

    @pre(n >= 0)
    fn farr_load(&mut self, base : i64, t : i64, n : i64, iv : i64, kidx : i64) → i64:
        let ad : i64 = self.farr_addr(base, t, n, iv, kidx)
        let et : i64 = self.elem_of(t)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.ldn, ad, 0, 0, d, self.farr_esize(t) + 256 × types.ty_sgn(et))
        d

    @pre(n >= 0)
    fn farr_store(&mut self, base : i64, t : i64, n : i64, iv : i64, kidx : i64, vv : i64):
        let ad : i64 = self.farr_addr(base, t, n, iv, kidx)
        self.ir(ir.Ir.stn, ad, 0, vv, 0, self.farr_esize(t))

    // A loop from nought to the size, answering the index vreg and the
    // two labels the caller closes it with.  Every wholesale copy below
    // runs over one of these rather than writing the size out N times,
    // which for a u8[32] is the difference between one loop and
    // thirty-two unrolled stores.
    @pre(n >= 0)
    fn farr_loop_open(&mut self, n : i64) → (i64, i64, i64):
        let iv : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, iv, 0)
        let ltop : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let nv : i64 = self.tmp()
        self.ir(ir.Ir.const, n, 0, 0, nv, 0)
        let c : i64 = self.tmp()
        self.ir(ir.Ir.clt, iv, nv, 0, c, 64 + 256)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        (iv, ltop, lend)

    fn farr_loop_close(&mut self, iv : i64, ltop : i64, lend : i64):
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, iv, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, iv, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)

    // every element set to one value, written where it lies
    @pre(n >= 0)
    fn farr_fill(&mut self, t : i64, n : i64, vv : i64) → i64:
        let fb : i64 = self.farr_new(t, n)
        let (iv, ltop, lend) := self.farr_loop_open(n)
        let ad : i64 = self.farr_addr_at(fb, t, iv)
        self.ir(ir.Ir.stn, ad, 0, vv, 0, self.farr_esize(t))
        self.farr_loop_close(iv, ltop, lend)
        fb

    // The other way: a T[] that a sized binding is to hold.  ⍴ builds
    // its answer as a T[] whatever it is for, so what it built is
    // copied into the frame and the header falls away with it.
    @pre(n >= 0)
    fn arr_to_farr(&mut self, av : i64, t : i64, n : i64) → i64:
        let fb : i64 = self.farr_new(t, n)
        let (iv, ltop, lend) := self.farr_loop_open(n)
        let ev : i64 = self.tmp()
        self.ir(ir.Ir.aidx, av, iv, 0, ev, 0)
        let ad : i64 = self.farr_addr_at(fb, t, iv)
        self.ir(ir.Ir.stn, ad, 0, ev, 0, self.farr_esize(t))
        self.farr_loop_close(iv, ltop, lend)
        fb

    // A sized array that is about to be kept somewhere longer-lived
    // than this frame.  A struct is the one thing that can hold one --
    // an array of them, a dictionary of them and a global of one are
    // all refused -- and a struct outlives the frame it was made in,
    // so the elements are copied where the struct's own memory comes
    // from.  Without this the field points at a frame that has ended,
    // and reads whatever the next call put there.
    @pre(n >= 0)
    fn farr_to_arena(&mut self, v : i64, t : i64, n : i64) → i64:
        let bytes : i64 = self.farr_esize(t) × n
        let d : i64 = self.tmp()
        self.ir(ir.Ir.snew, (bytes + 7) ÷ 8 ?? 0, 0, 0, d, 0)
        self.farr_copy(d, v, t, n)
        d

    // the value a field is to hold: kept where the struct's memory is
    // when it is a sized array, and itself otherwise
    fn field_val(&mut self, v : i64, ft : i64) → i64:
        let pn : i64 = self.packed_ty_n(ft)
        if pn >= 0: self.farr_to_arena(v, ft, pn) else: v

    // Copy one sized array's elements over another's.  This is what a
    // return is: the answer is written into the space the caller
    // handed over, since the frame it was computed in is about to go.
    @pre(n >= 0)
    fn farr_copy(&mut self, dst : i64, src : i64, t : i64, n : i64):
        let (iv, ltop, lend) := self.farr_loop_open(n)
        let sa : i64 = self.farr_addr_at(src, t, iv)
        let et : i64 = self.elem_of(t)
        let ev : i64 = self.tmp()
        self.ir(ir.Ir.ldn, sa, 0, 0, ev, self.farr_esize(t) + 256 × types.ty_sgn(et))
        let da : i64 = self.farr_addr_at(dst, t, iv)
        self.ir(ir.Ir.stn, da, 0, ev, 0, self.farr_esize(t))
        self.farr_loop_close(iv, ltop, lend)

    // An operand where a T[] is wanted: a sized array is laid out
    // afresh, anything else is itself.  This is the only place the two
    // representations meet, so it is the only place that has to be
    // right about the difference.
    fn lower_arr_operand(&mut self, nd : i64) → i64:
        let v : i64 = self.lower_expr(nd)
        let pn : i64 = self.packed_n(nd)
        if pn >= 0: self.farr_to_arr(v, self.tof(nd), pn) else: v

    // What a sized array has to become where a T[] is wanted -- ⧺,
    // a slice, printing.  Every element is read and pushed, because
    // the two layouts are not the same: a T[] holds a slot apiece.
    @pre(n >= 0)
    fn farr_to_arr(&mut self, base : i64, t : i64, n : i64) → i64:
        let et : i64 = self.elem_of(t)
        let d : i64 = self.tmp()
        self.ir(ir.Ir.anew, n ⌈ 4, 0, 0, d, 0)
        let (iv, ltop, lend) := self.farr_loop_open(n)
        let ad : i64 = self.farr_addr_at(base, t, iv)
        let ev : i64 = self.tmp()
        self.ir(ir.Ir.ldn, ad, 0, 0, ev, self.farr_esize(t) + 256 × types.ty_sgn(et))
        self.ir(ir.Ir.apush, d, ev, 0, 0, 0)
        self.farr_loop_close(iv, ltop, lend)
        d

    fn mat_elem(&self, t : i64) → i64:
        self.a.mel[types.ty_midx(t) × 1¤ptrdiff]

    fn mat_rr(&self, t : i64) → i64:
        self.a.mrr[types.ty_midx(t) × 1¤ptrdiff]

    fn mat_cc(&self, t : i64) → i64:
        self.a.mcc[types.ty_midx(t) × 1¤ptrdiff]

    fn mat_dd(&self, t : i64) → i64:
        self.a.mdd[types.ty_midx(t) × 1¤ptrdiff]

    fn mat_rank(&self, t : i64) → i64:
        if self.a.mdd[types.ty_midx(t) × 1¤ptrdiff] = ⁻2: 2 else: 3

    fn tup_len(&self, t : i64) → i64:
        self.a.ttl[types.ty_tidx(t) × 1¤ptrdiff]

    fn lower_foreach(&mut self, sid : i64, tok : i64, na : i64, body : i64,
                     ret_ty : i64):
        let lo_n : i64 = self.a.extra[na × 1¤ptrdiff]
        let step_n : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi_n : i64 = self.a.extra[(na + 2) × 1¤ptrdiff]
        let lov : i64 = self.lower_expr(lo_n)
        let hiv0 : i64 = self.lower_expr(hi_n)
        let hiv : i64 = self.tmp()
        self.ir(ir.Ir.mov, hiv0, 0, 0, hiv, 0)
        let dirv : i64 = self.tmp()
        if step_n = ⁻1:
            // without a step the direction follows the bounds: a cmov,
            // not a branch
            let c : i64 = self.tmp()
            self.ir(ir.Ir.cle, lov, hiv, 0, c, 64 + 256)
            let one : i64 = self.tmp()
            self.ir(ir.Ir.const, 1, 0, 0, one, 0)
            let mone : i64 = self.tmp()
            self.ir(ir.Ir.const, ⁻1, 0, 0, mone, 0)
            self.ir(ir.Ir.sel, c, one, mone, dirv, 0)
        else:
            let sv : i64 = self.lower_expr(step_n)
            self.ir(ir.Ir.mov, sv, 0, 0, dirv, 0)
            let lz : i64 = self.label()
            self.ir(ir.Ir.jnz, dirv, lz, 0, 0, 0)
            let m : i64 = self.intern("a foreach step of zero never arrives (line " ⧺ tokens.i64_str(@dropunit(self.tok_line(tok))) ⧺ ")\n")
            self.ir(ir.Ir.abort, m, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lz, 0, 0, 0, 0)
        self.lower_range_loop(sid, lov, hiv, dirv, body, ret_ty)

    // still inside: (dir > 0 ∧ i ≤ hi) ∨ (dir < 0 ∧ i ≥ hi) --
    // materialized comparisons, no branches until the one decision
    fn range_alive(&mut self, ivar : i64, hiv : i64, dirv : i64) → i64:
        let z : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, z, 0)
        let up : i64 = self.tmp()
        self.ir(ir.Ir.cgt, dirv, z, 0, up, 64 + 256)
        // the end is where the range stops rather than the last value
        // it holds, so the walk is alive strictly short of it
        let le : i64 = self.tmp()
        self.ir(ir.Ir.clt, ivar, hiv, 0, le, 64 + 256)
        let c1 : i64 = self.tmp()
        self.ir(ir.Ir.band, up, le, 0, c1, 64)
        let down : i64 = self.tmp()
        self.ir(ir.Ir.clt, dirv, z, 0, down, 64 + 256)
        let ge : i64 = self.tmp()
        self.ir(ir.Ir.cgt, ivar, hiv, 0, ge, 64 + 256)
        let c2 : i64 = self.tmp()
        self.ir(ir.Ir.band, down, ge, 0, c2, 64)
        let c : i64 = self.tmp()
        self.ir(ir.Ir.borr, c1, c2, 0, c, 64)
        c

    fn lower_range_loop(&mut self, sid : i64, lov : i64, hiv : i64,
                        dirv : i64, body : i64, ret_ty : i64):
        let ivar : i64 = self.nslot[sid × 1¤ptrdiff]
        self.ir(ir.Ir.mov, lov, 0, 0, ivar, 0)
        let saved_base : i64 = self.tbase
        self.tbase ← self.tnext
        let ltop : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let c : i64 = self.range_alive(ivar, hiv, dirv)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        self.breaks.push(lend)
        self.conts.push(lcont)
        self.lower_block(body, false, ret_ty)
        _ ← self.breaks.pop() ?? 0
        _ ← self.conts.pop() ?? 0
        self.ir(ir.Ir.label, lcont, 0, 0, 0, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, ivar, dirv, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, ivar, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        self.tbase ← saved_base

    fn lower_foreacha(&mut self, sid : i64, tok : i64, arr : i64, body : i64,
                      ret_ty : i64):
        if types.ty_is_rg(self.tof(arr)):
            let rv : i64 = self.lower_expr(arr)
            let lo9 : i64 = self.tmp()
            self.ir(ir.Ir.fld, rv, 0, 0, lo9, 0)
            let st9 : i64 = self.tmp()
            self.ir(ir.Ir.fld, rv, 1, 0, st9, 0)
            let hi9 : i64 = self.tmp()
            self.ir(ir.Ir.fld, rv, 2, 0, hi9, 0)
            let lz9 : i64 = self.label()
            self.ir(ir.Ir.jnz, st9, lz9, 0, 0, 0)
            let m9 : i64 = self.intern("range step must not be zero (line " ⧺ tokens.i64_str(@dropunit(self.tok_line(tok))) ⧺ ")\n")
            self.ir(ir.Ir.abort, m9, 0, 0, 0, 0)
            self.ir(ir.Ir.label, lz9, 0, 0, 0, 0)
            self.lower_range_loop(sid, lo9, hi9, st9, body, ret_ty)
            return
        let evar : i64 = self.nslot[sid × 1¤ptrdiff]
        if self.tof(arr) = types.TY_STR:
            // A string is walked where it lies.  Laying its characters
            // out first would cost eight bytes for every byte read, and
            // the arena does not take them back -- a walk repeated is a
            // walk that grows.  Each turn decodes one character and says
            // where the next one begins.
            let sv : i64 = self.lower_expr(arr)
            let sb : i64 = self.tmp()
            self.ir(ir.Ir.fld, sv, 1, 0, sb, 0)
            let si : i64 = self.tmp()
            self.ir(ir.Ir.const, 0, 0, 0, si, 0)
            let sbase : i64 = self.tbase
            self.tbase ← self.tnext
            let stop : i64 = self.label()
            let scont : i64 = self.label()
            let send : i64 = self.label()
            self.ir(ir.Ir.label, stop, 0, 0, 0, 0)
            let sc : i64 = self.tmp()
            self.ir(ir.Ir.clt, si, sb, 0, sc, 64 + 256)
            self.ir(ir.Ir.jz, sc, send, 0, 0, 0)
            let snext : i64 = self.tmp()
            self.ir(ir.Ir.sdec, sv, si, snext, evar, 0)
            // the position moves before the body, so a continue leaves
            // the walk where the next character begins
            self.ir(ir.Ir.mov, snext, 0, 0, si, 0)
            self.breaks.push(send)
            self.conts.push(scont)
            self.lower_block(body, false, ret_ty)
            _ ← self.breaks.pop() ?? 0
            _ ← self.conts.pop() ?? 0
            self.ir(ir.Ir.label, scont, 0, 0, 0, 0)
            self.ir(ir.Ir.jmp, stop, 0, 0, 0, 0)
            self.ir(ir.Ir.label, send, 0, 0, 0, 0)
            self.tbase ← sbase
            return
        let av : i64 = self.lower_expr(arr)
        let desc : i64 = self.tmp()
        self.ir(ir.Ir.mov, av, 0, 0, desc, 0)
        let iv : i64 = self.tmp()
        self.ir(ir.Ir.const, 0, 0, 0, iv, 0)
        let saved_base : i64 = self.tbase
        self.tbase ← self.tnext
        let ltop : i64 = self.label()
        let lcont : i64 = self.label()
        let lend : i64 = self.label()
        let pnw : i64 = self.packed_n(arr)
        let fa : bool = pnw >= 0
        self.ir(ir.Ir.label, ltop, 0, 0, 0, 0)
        let n : i64 = self.tmp()
        if fa:
            // the type says how many, so the walk asks nothing
            self.ir(ir.Ir.const, pnw, 0, 0, n, 0)
        else:
            self.ir(ir.Ir.alen, desc, 0, 0, n, 0)
        let c : i64 = self.tmp()
        self.ir(ir.Ir.clt, iv, n, 0, c, 64 + 256)
        self.ir(ir.Ir.jz, c, lend, 0, 0, 0)
        if fa and self.a.nc[sid × 1¤ptrdiff] ≠ 0:
            let ad : i64 = self.farr_addr(desc, self.tof(arr), pnw, iv, ⁻1)
            self.ir(ir.Ir.mov, ad, 0, 0, evar, 0)
        elif fa:
            let ev : i64 = self.farr_load(desc, self.tof(arr), pnw, iv, ⁻1)
            self.ir(ir.Ir.mov, ev, 0, 0, evar, 0)
        elif self.a.nc[sid × 1¤ptrdiff] ≠ 0:
            self.ir(ir.Ir.aref, desc, iv, 0, evar, 0)
        else:
            self.ir(ir.Ir.aidx, desc, iv, 0, evar, 0)
        self.breaks.push(lend)
        self.conts.push(lcont)
        self.lower_block(body, false, ret_ty)
        _ ← self.breaks.pop() ?? 0
        _ ← self.conts.pop() ?? 0
        self.ir(ir.Ir.label, lcont, 0, 0, 0, 0)
        let one : i64 = self.tmp()
        self.ir(ir.Ir.const, 1, 0, 0, one, 0)
        let ni : i64 = self.tmp()
        self.ir(ir.Ir.addw, iv, one, 0, ni, 64 + 256)
        self.ir(ir.Ir.mov, ni, 0, 0, iv, 0)
        self.ir(ir.Ir.jmp, ltop, 0, 0, 0, 0)
        self.ir(ir.Ir.label, lend, 0, 0, 0, 0)
        // What the walk walked is nobody's now: the checker saw the
        // name written over inside the loop, and saw that nothing else
        // could be holding what the walk took.  So the slots go back.
        // Not the descriptor -- it does not record how big its own
        // block was -- and not slots that RT_ARRNEW laid inside the
        // descriptor, which are not a block of their own.
        if self.nfree[sid × 1¤ptrdiff] = 1:
            let lkeep : i64 = self.label()
            // Whether the name was written over is not something the
            // text settles: the loop may have run no turns at all, and
            // the writing may have been under an if that did not go
            // that way.  What settles it is the name itself -- if it
            // still holds what the walk took, the walk was not the
            // last to hold it, and nothing goes back.  One comparison,
            // and it is right however the loop ran.
            let cur : i64 = self.lower_expr(arr)
            let held : i64 = self.tmp()
            self.ir(ir.Ir.ceq, cur, desc, 0, held, 64 + 256)
            self.ir(ir.Ir.jnz, held, lkeep, 0, 0, 0)
            let dsl : i64 = self.tmp()
            self.ir(ir.Ir.fld, desc, 0, 0, dsl, 0)
            let hoff : i64 = self.tmp()
            self.ir(ir.Ir.const, 24, 0, 0, hoff, 0)
            let inl : i64 = self.tmp()
            self.ir(ir.Ir.add, desc, hoff, 0, inl, 64 + 256)
            let same : i64 = self.tmp()
            self.ir(ir.Ir.ceq, dsl, inl, 0, same, 64 + 256)
            self.ir(ir.Ir.jnz, same, lkeep, 0, 0, 0)
            let dcp : i64 = self.tmp()
            self.ir(ir.Ir.fld, desc, 2, 0, dcp, 0)
            let three : i64 = self.tmp()
            self.ir(ir.Ir.const, 3, 0, 0, three, 0)
            let nby : i64 = self.tmp()
            self.ir(ir.Ir.shll, dcp, three, 0, nby, 64 + 256)
            self.ir(ir.Ir.giveback, dsl, nby, 0, 0, 0)
            self.ir(ir.Ir.label, lkeep, 0, 0, 0, 0)
        self.tbase ← saved_base

// one λ becomes one function: the parameters arrive in the argument
// registers, the box rides behind them, and the captures come out of
// the box into the slots the body reads
@export
fn lower_lambda_fn(lw : &mut Lower, a : &ast.Ast, chk : &check.Chk, j : i64) → ir.IrFn:
    // fresh columns: what the last function left is its own now
    lw.op ← []
    lw.ia ← []
    lw.ib ← []
    lw.ic ← []
    lw.idd ← []
    lw.iww ← []
    lw.extra ← []
    lw.nlabels ← 0
    lw.fbytes ← 0¤byte
    let nid : i64 = chk.lams[j × 1¤ptrdiff]
    let loff : i64 = a.na[nid × 1¤ptrdiff]
    let np : i64 = a.extra[loff × 1¤ptrdiff]
    let ncap : i64 = a.extra[(loff + 1 + np × 2) × 1¤ptrdiff]
    let ret : i64 = a.extra[(loff + 2 + np × 2 + ncap) × 1¤ptrdiff]
    lw.tbase ← chk.lamns[j × 1¤ptrdiff] ⌈ (np + 2)
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← ret
    lw.cur_ref ← 0
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← "λ"
    // the prologue put argument k in slot k, and the checker's slots
    // for the parameters may overlap those very cells -- so everything
    // incoming is parked in fresh temporaries first, then placed
    let parked : mut i64[] = []
    foreach pi := 0…np:
        let pt9 : i64 = lw.tmp()
        lw.ir(ir.Ir.mov, pi, 0, 0, pt9, 0)
        parked.push(pt9)
    let boxt : i64 = lw.tmp()
    lw.ir(ir.Ir.mov, np, 0, 0, boxt, 0)
    foreach pj := 0…np:
        lw.ir(ir.Ir.mov, parked[pj × 1¤ptrdiff], 0, 0, a.extra[(loff + 1 + pj × 2) × 1¤ptrdiff], 0)
    let pslot0 : i64 = a.extra[(loff + 1) × 1¤ptrdiff]
    foreach ci := 0…ncap:
        lw.ir(ir.Ir.fld, boxt, 1 + ci, 0, pslot0 + np + ci, 0)
    let bodyn : i64 = a.nb[nid × 1¤ptrdiff]
    if a.nkind[bodyn × 1¤ptrdiff] = ast.Nk.block:
        // statements, ending in a trailing value or a return; both go
        // through lower_ret_value, which boxes under an optional answer
        lw.lower_block(bodyn, true, ret)
    else:
        let rv : i64 = lw.lower_expr(bodyn)
        if types.ty_is_opt(ret) and not types.ty_is_opt(lw.tof(bodyn)) and (lw.nhold[bodyn × 1¤ptrdiff] & 1) = 0:
            // a bare value under an optional answer boxes itself, where
            // the checker did not already have it held on the way out
            let bb : i64 = lw.tmp()
            lw.ir(ir.Ir.snew, 1, 0, 0, bb, 0)
            lw.ir(ir.Ir.fsto, bb, 0, rv, 0, 0)
            lw.ir(ir.Ir.ret, bb, 0, 0, 0, 0)
        else:
            lw.ir(ir.Ir.ret, rv, 0, 0, 0, 0)
    // the columns, cut whole: a slice is one operation where a loop
    // over the elements is one per instruction lowered
    let opc : ir.Ir[] = lw.op[0¤ptrdiff…#lw.op]
    let iac : i64[] = lw.ia[0¤ptrdiff…#lw.ia]
    let ibc : i64[] = lw.ib[0¤ptrdiff…#lw.ib]
    let icc : i64[] = lw.ic[0¤ptrdiff…#lw.ic]
    let idc : i64[] = lw.idd[0¤ptrdiff…#lw.idd]
    let iwc : i64[] = lw.iww[0¤ptrdiff…#lw.iww]
    let exc : i64[] = lw.extra[0¤ptrdiff…#lw.extra]
    ir.IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
         extra: exc, nvregs: lw.tmax, nlabels: lw.nlabels, fbytes: lw.fbytes}

// one partial-application site becomes one shim: the remaining
// arguments arrive in registers, the box rides behind them, and the
// bound values come out of the box in front
@export
fn lower_shim_fn(lw : &mut Lower, chk : &check.Chk, j : i64) → ir.IrFn:
    // fresh columns: what the last function left is its own now
    lw.op ← []
    lw.ia ← []
    lw.ib ← []
    lw.ic ← []
    lw.idd ← []
    lw.iww ← []
    lw.extra ← []
    lw.nlabels ← 0
    lw.fbytes ← 0¤byte
    let target : i64 = chk.psfn[j × 1¤ptrdiff]
    let k : i64 = chk.psk[j × 1¤ptrdiff]
    let np : i64 = chk.psnp[j × 1¤ptrdiff]
    let rem : i64 = np - k
    let box9 : i64 = rem
    lw.tbase ← rem + 2
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← types.TY_I64
    lw.cur_ref ← 0
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.cur_fname ← "λ"
    let bound : mut i64[] = []
    foreach bi := 0…k:
        let bv : i64 = lw.tmp()
        lw.ir(ir.Ir.fld, box9, 1 + bi, 0, bv, 0)
        bound.push(bv)
    let off : i64 = @dropunit(#lw.extra)
    if target >= 0:
        lw.extra.push(np)
    else:
        lw.extra.push(np + 1)
    lw.extra ← lw.extra ⧺ bound
    // the remaining parameters, numbered from zero: the shim reads its
    // own arguments in order
    foreach ri := 0…rem:
        lw.extra.push(ri)
    let d : i64 = lw.tmp()
    if target >= 0:
        lw.ir(ir.Ir.call, target, off, 0, d, 0)
    else:
        let src : i64 = lw.tmp()
        lw.ir(ir.Ir.fld, box9, 1 + k, 0, src, 0)
        lw.extra.push(src)
        let ad : i64 = lw.tmp()
        lw.ir(ir.Ir.fld, src, 0, 0, ad, 0)
        lw.ir(ir.Ir.calli, ad, off, 0, d, 0)
    lw.ir(ir.Ir.ret, d, 0, 0, 0, 0)
    // the columns, cut whole: a slice is one operation where a loop
    // over the elements is one per instruction lowered
    let opc : ir.Ir[] = lw.op[0¤ptrdiff…#lw.op]
    let iac : i64[] = lw.ia[0¤ptrdiff…#lw.ia]
    let ibc : i64[] = lw.ib[0¤ptrdiff…#lw.ib]
    let icc : i64[] = lw.ic[0¤ptrdiff…#lw.ic]
    let idc : i64[] = lw.idd[0¤ptrdiff…#lw.idd]
    let iwc : i64[] = lw.iww[0¤ptrdiff…#lw.iww]
    let exc : i64[] = lw.extra[0¤ptrdiff…#lw.extra]
    ir.IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
         extra: exc, nvregs: lw.tmax, nlabels: lw.nlabels, fbytes: lw.fbytes}

@export
fn lower_stub_fn(lw : &mut Lower, np : i64) → ir.IrFn:
    // fresh columns: what the last function left is its own now
    lw.op ← []
    lw.ia ← []
    lw.ib ← []
    lw.ic ← []
    lw.idd ← []
    lw.iww ← []
    lw.extra ← []
    lw.nlabels ← 0
    lw.fbytes ← 0¤byte
    lw.tbase ← np + 1
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.ir(ir.Ir.ret, ⁻1, 0, 0, 0, 0)
    // the columns, cut whole
    let opc : ir.Ir[] = lw.op[0¤ptrdiff…#lw.op]
    let iac : i64[] = lw.ia[0¤ptrdiff…#lw.ia]
    let ibc : i64[] = lw.ib[0¤ptrdiff…#lw.ib]
    let icc : i64[] = lw.ic[0¤ptrdiff…#lw.ic]
    let idc : i64[] = lw.idd[0¤ptrdiff…#lw.idd]
    let iwc : i64[] = lw.iww[0¤ptrdiff…#lw.iww]
    ir.IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc,
         extra: [], nvregs: lw.tmax, nlabels: 0, fbytes: lw.fbytes}

// What a violated condition does, which is a property of the run and
// not of the source: --contract-evaluation-semantic says which.  The
// four are C++26's evaluation semantics, and the interpreter's.
@export
let CT_IGNORE : i64 = 0
@export
let CT_OBSERVE : i64 = 1
@export
let CT_ENFORCE : i64 = 2
@export
let CT_QUICK : i64 = 3

// The name of one, as the command line writes it, or ⁻1.
@export
fn contract_semantic(name : str) → i64:
    if name = "ignore": return CT_IGNORE
    if name = "observe": return CT_OBSERVE
    if name = "enforce": return CT_ENFORCE
    if name = "quick_enforce" or name = "quick-enforce": return CT_QUICK
    ⁻1

// What a violated condition does, emitted where the condition failed.
// enforce says which one and stops; observe says it and goes on as
// though it held; quick_enforce stops at once and says nothing, which
// is the whole of what makes it quick.  ignore never reaches here --
// the condition is not read at all.
// @pre lw.contracts ≠ CT_IGNORE
fn lower_violation(lw : &mut Lower, which : str, name : str):
    if lw.contracts = CT_QUICK:
        _ ← lw.rt0(emit.RT_QSTOP)
        return
    let m : i64 = lw.intern(which ⧺ " of '" ⧺ name ⧺ "' does not hold\n")
    if lw.contracts = CT_OBSERVE:
        lw.ir(ir.Ir.eprints, lw.intern("warning: "), 0, 0, 0, 0)
        lw.ir(ir.Ir.eprints, m, 0, 0, 0, 0)
        return
    lw.ir(ir.Ir.abort, m, 0, 0, 0, 0)

@export
fn lower_fn(lw : &mut Lower, a : &ast.Ast, chk : &check.Chk, f : i64) → ir.IrFn:
    let d := a.fns[f × 1¤ptrdiff]
    // fresh columns: what the last function left is its own now
    lw.op ← []
    lw.ia ← []
    lw.ib ← []
    lw.ic ← []
    lw.idd ← []
    lw.iww ← []
    lw.extra ← []
    lw.nlabels ← 0
    lw.fbytes ← 0¤byte
    // A function that answers a sized array is handed the space to
    // answer into, in a slot past the parameters -- the same place a
    // lambda's box rides.  The checker knew nothing of it and may have
    // put a local there, so the pointer is parked in a temporary
    // before a line of the body runs, which is before that local is
    // ever written.
    // A temporary would not do: tnext falls back to tbase at every
    // statement, so anything taken from there is written over by the
    // first thing the body computes.  The pointer gets a slot of its
    // own, below where the temporaries begin.
    let np0 : i64 ¤ptrdiff = a.extra[d.params_off] × 1¤ptrdiff
    let sized_ret : bool = check.farr_is_packed(a, d.ret)
    let sbase : i64 = chk.fslots[f × 1¤ptrdiff] ⌈ (@dropunit(np0) + 1)
    let obase : i64 = if sized_ret: sbase + 1 else: chk.fslots[f × 1¤ptrdiff]
    let nolds : i64 = if d.olds_off = ⁻1: 0 else: a.extra[d.olds_off]
    lw.old_base ← obase
    lw.tbase ← obase + nolds
    lw.tnext ← lw.tbase
    lw.tmax ← lw.tbase
    lw.in_wrap ← 0
    lw.cur_ret ← d.ret
    lw.cur_ref ← d.ret_ref
    lw.post_label ← ⁻1
    lw.res_vreg ← ⁻1
    lw.sret ← ⁻1
    lw.cur_fname ← d.name
    if sized_ret:
        lw.ir(ir.Ir.mov, @dropunit(np0), 0, 0, sbase, 0)
        lw.sret ← sbase
    // Where this function calls itself in tail position, the call is a
    // loop: the parameters take the new values and the body starts
    // again here, so the recursion spends no stack at all and the
    // language's guarantee is kept.
    //
    // The top is above the preconditions rather than below them, so
    // that each turn is asked what a fresh call would have been asked.
    // A function with a postcondition is left alone: a condition
    // relating the answer to the arguments is stated once per call,
    // and a loop has one call where the source has many.  So is one
    // answering a sized array, whose caller hands it the room to
    // answer into and whose recursion is not the shape this turns.
    lw.tail_fn ← f
    lw.tail_np ← @dropunit(np0)
    lw.tail_label ← ⁻1
    if not sized_ret and d.post_off = ⁻1:
        lw.tail_label ← lw.label()
        lw.ir(ir.Ir.label, lw.tail_label, 0, 0, 0, 0)
    if d.pre_off ≠ ⁻1 and lw.contracts ≠ CT_IGNORE:
        let n : i64 ¤ptrdiff = a.extra[d.pre_off] × 1¤ptrdiff
        foreach j := 0…n:
            lw.tnext ← lw.tbase
            let c : i64 = a.extra[d.pre_off + 1 + j]
            let cv : i64 = lw.lower_expr(c)
            let lok : i64 = lw.label()
            lw.ir(ir.Ir.jnz, cv, lok, 0, 0, 0)
            lower_violation(&lw, "precondition", d.name)
            lw.ir(ir.Ir.label, lok, 0, 0, 0, 0)
    // What @old says is what the call began with, so it is read here:
    // after the preconditions, before a statement of the body.
    if d.olds_off ≠ ⁻1:
        let no : i64 ¤ptrdiff = a.extra[d.olds_off] × 1¤ptrdiff
        foreach oi := 0…no:
            lw.tnext ← lw.tbase
            let on : i64 = a.extra[d.olds_off + 1 + oi]
            let ov : i64 = lw.lower_expr(a.na[on × 1¤ptrdiff])
            lw.ir(ir.Ir.mov, ov, 0, 0, obase + a.nb[on × 1¤ptrdiff], 0)
        lw.tnext ← lw.tbase
    if d.post_off ≠ ⁻1 and d.ret ≠ types.TY_UNIT and lw.contracts ≠ CT_IGNORE:
        lw.post_label ← lw.label()
        // the checker gave the result's name the slot after the
        // parameters, so the value is put where the conditions read it
        lw.res_vreg ← a.extra[d.params_off]
    lw.lower_block(d.body, true, d.ret)
    if d.ret = types.TY_UNIT:
        lw.ir(ir.Ir.ret, ⁻1, 0, 0, 0, 0)
    if lw.post_label ≠ ⁻1:
        lw.ir(ir.Ir.label, lw.post_label, 0, 0, 0, 0)
        let n : i64 ¤ptrdiff = a.extra[d.post_off] × 1¤ptrdiff
        foreach j := 0…n:
            lw.tnext ← lw.tbase
            let c : i64 = a.extra[d.post_off + 2 + j × 2]
            let cv : i64 = lw.lower_expr(c)
            let lok : i64 = lw.label()
            lw.ir(ir.Ir.jnz, cv, lok, 0, 0, 0)
            lower_violation(&lw, "postcondition", d.name)
            lw.ir(ir.Ir.label, lok, 0, 0, 0, 0)
        lw.ir(ir.Ir.ret, lw.res_vreg, 0, 0, 0, 0)
    // the columns, cut whole: a slice is one operation where a loop
    // over the elements is one per instruction lowered
    let opc : ir.Ir[] = lw.op[0¤ptrdiff…#lw.op]
    let iac : i64[] = lw.ia[0¤ptrdiff…#lw.ia]
    let ibc : i64[] = lw.ib[0¤ptrdiff…#lw.ib]
    let icc : i64[] = lw.ic[0¤ptrdiff…#lw.ic]
    let idc : i64[] = lw.idd[0¤ptrdiff…#lw.idd]
    let iwc : i64[] = lw.iww[0¤ptrdiff…#lw.iww]
    let exc : i64[] = lw.extra[0¤ptrdiff…#lw.extra]
    assert(#opc = #iac and #opc = #ibc and #opc = #icc, "ir arrays in step")
    assert(#opc = #idc and #opc = #iwc, "ir arrays in step")
    assert(lw.tmax >= chk.fslots[f × 1¤ptrdiff], "the frame covers the locals")
    ir.IrFn{op: opc, ia: iac, ib: ibc, ic: icc, id: idc, iw: iwc, extra: exc,
         nvregs: lw.tmax, nlabels: lw.nlabels, fbytes: lw.fbytes}
