            return d
        if k = NK_NOT:
            // the operand is a bool, 0 or 1; flipping it is one xor
            let v : i64 = self.lower_expr(na)
            let one : i64 = self.tmp()
            self.ir(IR_CONST, 1, 0, 0, one, 64)
            let d : i64 = self.tmp()
            self.ir(IR_BXORR, v, one, 0, d, 64)
            return d
        if k = NK_WRAP:
            self.in_wrap ← self.in_wrap + 1
            let v : i64 = self.lower_expr(na)
            self.in_wrap ← self.in_wrap - 1
            return v
        if k = NK_IF:
            return self.lower_ife(nid, na, nb, nc)
        if k = NK_IFIELD:
            let d : i64 = self.tmp()
            self.ir(IR_FLD, self.inv_subject, na, 0, d, width_of(self.tof(nid)))
