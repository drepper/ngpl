            dispatch.g_shl3i(&em, tg, arch_a64.RG_T, arch_a64.RG_A, 3)
            dispatch.g_add3(&em, tg, arch_a64.RG_B, arch_a64.RG_B, arch_a64.RG_T)
            dispatch.g_ldo(&em, tg, arch_a64.RG_A, arch_a64.RG_B, 0, 8, 0)
            dispatch.g_const(&em, tg, arch_a64.RG_B, defv)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
            em.pj_id.push(id2)
            em.pj_start.push(@dropunit(#em.pj_labels))
            em.pj_len.push(0 - span)
            foreach e2 := 0…span:
                em.pj_labels.push(ir.extra[(b + 3 + e2) × 1¤ptrdiff])
        elif o = ir_m.Ir.sysc:
            let sargc : i64 = ir.extra[b × 1¤ptrdiff]
            foreach sk := 0…sargc:
                dispatch.g_sysarg(&em, tg, sk, ir.extra[(b + 1 + sk) × 1¤ptrdiff])
            dispatch.g_syscall(&em, tg, a)
            if d ≠ ⁻1:
                dispatch.g_sysret(&em, tg, arch_a64.RG_A)
                dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.ldn:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_ldo(&em, tg, arch_a64.RG_A, arch_a64.RG_A, b, bits, sgn)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.stn:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, c)
            dispatch.g_sto(&em, tg, arch_a64.RG_B, arch_a64.RG_A, b, bits)
        elif o = ir_m.Ir.frame:
            dispatch.g_frameaddr(&em, tg, ir.nvregs, nobj, a, arch_a64.RG_A)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.kaddr:
            let pos : i64 = dispatch.g_absref(&em, tg, arch_a64.RG_A)
            if em.skipping = 0:
                em.df_pos.push(pos)
                em.df_off.push((if a = 0: em.k_args else: (if a = 1: em.k_alloc else: em.k_sig)) + b)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.fptr:
            dispatch.g_fptr(&em, tg, arch_a64.RG_A)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.btaddr:
            let bpos : i64 = dispatch.g_absref(&em, tg, arch_a64.RG_A)
            if em.skipping = 0:
                em.bt_pos.push(bpos)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        else:
            assert(false, "an IR op the driver knows")
    dispatch.g_resolve(&em, tg)
    em.resolve_jtabs()

// saturating arithmetic, held at the type's edge; two scratch labels
fn t_emit_sat(em : &mut emit.Emit, tg : elf.Target, o : ir_m.Ir, w : i64, a : i64, b : i64, d : i64, sl : i64):
    let bits : i64 = w & 255
    let sgn : i64 = w » 8
    dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
    dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
    if bits < 64:
        if o = ir_m.Ir.satadd:
            dispatch.g_add3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
        elif o = ir_m.Ir.satsub:
            dispatch.g_sub3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
        else:
            dispatch.g_mul3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
        if sgn = 1:
            dispatch.g_const(&em, tg, arch_a64.RG_C, 0 - (1 « (bits - 1)))
            dispatch.g_cmp3(&em, tg, arch_a64.RG_T, arch_a64.RG_A, arch_a64.RG_C, arch_a64.CC_LT, 1, 64)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_T, arch_a64.RG_C, arch_a64.RG_A)
            dispatch.g_const(&em, tg, arch_a64.RG_C, (1 « (bits - 1)) - 1)
            dispatch.g_cmp3(&em, tg, arch_a64.RG_T, arch_a64.RG_A, arch_a64.RG_C, arch_a64.CC_GT, 1, 64)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_T, arch_a64.RG_C, arch_a64.RG_A)
        elif o = ir_m.Ir.satsub:
            dispatch.g_const(&em, tg, arch_a64.RG_C, 0)
            dispatch.g_cmp3(&em, tg, arch_a64.RG_T, arch_a64.RG_A, arch_a64.RG_C, arch_a64.CC_LT, 1, 64)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_T, arch_a64.RG_C, arch_a64.RG_A)
        else:
            dispatch.g_const(&em, tg, arch_a64.RG_C, (1 « bits) - 1)
            dispatch.g_cmp3(&em, tg, arch_a64.RG_T, arch_a64.RG_A, arch_a64.RG_C, arch_a64.CC_GT, 0, 64)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_T, arch_a64.RG_C, arch_a64.RG_A)
        dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        return
    if sgn = 0:
        if o = ir_m.Ir.satadd:
            dispatch.g_addov(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, 0, 64)
            dispatch.g_jz(&em, tg, arch_a64.RG_C, sl)
            dispatch.g_const(&em, tg, arch_a64.RG_A, ⁻1)
        elif o = ir_m.Ir.satsub:
            dispatch.g_subov(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, 0, 64)
            dispatch.g_jz(&em, tg, arch_a64.RG_C, sl)
            dispatch.g_const(&em, tg, arch_a64.RG_A, 0)
        else:
            dispatch.g_mulov(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, 0, 64)
            dispatch.g_jz(&em, tg, arch_a64.RG_C, sl)
            dispatch.g_const(&em, tg, arch_a64.RG_A, ⁻1)
        dispatch.g_label(&em, tg, sl)
        dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        return
    // signed, full width: the direction of the clamp follows the
    // operands, read before they are lost
    if o = ir_m.Ir.satmul:
        dispatch.g_xor3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B)
        dispatch.g_mulov(&em, tg, arch_a64.RG_A, arch_a64.RG_B, arch_a64.RG_A, arch_a64.RG_B, 1, 64)
        dispatch.g_jz(&em, tg, arch_a64.RG_B, sl + 1)
        dispatch.g_const(&em, tg, arch_a64.RG_B, 0)
        dispatch.g_cmp3(&em, tg, arch_a64.RG_T, arch_a64.RG_C, arch_a64.RG_B, arch_a64.CC_LT, 1, 64)
        dispatch.g_const(&em, tg, arch_a64.RG_A, 9223372036854775807)
        dispatch.g_jz(&em, tg, arch_a64.RG_T, sl + 1)
        dispatch.g_const(&em, tg, arch_a64.RG_A, ⁻9223372036854775807 - 1)
        dispatch.g_label(&em, tg, sl + 1)
        dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        return
    if o = ir_m.Ir.satadd:
        dispatch.g_addov(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, 1, 64)
    else:
        dispatch.g_subov(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, 1, 64)
    dispatch.g_jz(&em, tg, arch_a64.RG_C, sl + 1)
    dispatch.g_const(&em, tg, arch_a64.RG_C, 0)
    // an overflowed add went the way of b; a subtract the other way
    dispatch.g_cmp3(&em, tg, arch_a64.RG_T, arch_a64.RG_B, arch_a64.RG_C, if o = ir_m.Ir.satadd: arch_a64.CC_LT else: arch_a64.CC_GT, 1, 64)
    dispatch.g_const(&em, tg, arch_a64.RG_A, 9223372036854775807)
    dispatch.g_jz(&em, tg, arch_a64.RG_T, sl + 1)
    dispatch.g_const(&em, tg, arch_a64.RG_A, ⁻9223372036854775807 - 1)
    dispatch.g_label(&em, tg, sl + 1)
    dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
