// ---------------------------------------------------------------------------
// The driver: every IR op composed from the abstract operations.
// Written once; a target that teaches the machine its spellings gets
// all of it.  The x86-64 emitter above stays as the measure the
// compositions are checked against.
// ---------------------------------------------------------------------------

let arch_a64 := @import("arch_a64")
let arch_x86_64 := @import("arch_x86_64")
let dispatch := @import("dispatch")
let elf := @import("elf")
let emit := @import("emit")
let ir_m := @import("ir")

// a value that must fit its width or leave for RT_OV, composed with
// scratch labels the caller hands out


fn t_range_check(em : &mut emit.Emit, tg : elf.Target, w : i64, lok : i64):
    let bits : i64 = w & 255
    let sgn : i64 = w » 8
    if sgn = 0:
        dispatch.g_const(&em, tg, arch_a64.RG_B, (1 « bits) - 1)
        dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, arch_a64.CC_LE, 0, 64)
        dispatch.g_jnz(&em, tg, arch_a64.RG_C, lok)
        dispatch.g_call(&em, tg, emit.RT_OV)
    else:
        dispatch.g_mov2(&em, tg, arch_a64.RG_B, arch_a64.RG_A)
        dispatch.g_ext2(&em, tg, arch_a64.RG_B, bits, 1)
        dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, arch_a64.CC_EQ, 0, 64)
        dispatch.g_jnz(&em, tg, arch_a64.RG_C, lok)
        dispatch.g_call(&em, tg, emit.RT_OV)
    dispatch.g_label(&em, tg, lok)

// the canonical form of a wrapped result
fn t_canon(em : &mut emit.Emit, tg : elf.Target, w : i64):
    let bits : i64 = w & 255
    if bits < 64:
        dispatch.g_ext2(&em, tg, arch_a64.RG_A, bits, w » 8)

// nreg is what this function itself takes in registers; nreg_of says
// the same for every function it might call, indexed as a call target
// is.  A call to anything not in that table -- a runtime routine, whose
// number is negative, or a synthetic past the end of it -- takes what
// the architecture says and nothing more.
// The least value a width holds.
fn t_least(bits : i64) → i64:
    if bits = 32:
        return ⁻2147483648
    if bits = 16:
        return ⁻32768
    if bits = 8:
        return ⁻128
    ⁻9223372036854775807 - 1

// At which widths a target's compare and divide read no further than
// the value goes, as a bit per width -- the width divided by eight.
// aarch64 has both at thirty-two and nothing below it; riscv64 has
// neither below its word and would have to widen the value first,
// which is the work being avoided; the three whose word is thirty-two
// bits hold a thirty-two bit value canonical for nothing, so freeing
// it there would say only what is already true.
fn t_freecmp(tg : elf.Target) → i64:
    match tg.id:
        elf.Tgt.a64: 4
        elf.Tgt.rv64: 0
        elf.Tgt.i386: 0
        elf.Tgt.a32: 0
        elf.Tgt.rv32: 0
        elf.Tgt.x64: 0

// Nothing is free to divide at its width.  aarch64 can -- sdiv and
// udiv have a form for the lower half -- but dividing there it answers
// the least value over minus one wrongly rather than refusing it, and
// the check that has to stand in front of every such division costs
// two constants this machine must build a piece at a time.  Measured
// at 160 bytes on a division probe and 60 on t07_widths against the
// range check it would replace, so it keeps the range check.
fn t_freediv(tg : elf.Target) → i64:
    match tg.id:
        elf.Tgt.a64: 0
        elf.Tgt.rv64: 0
        elf.Tgt.i386: 0
        elf.Tgt.a32: 0
        elf.Tgt.rv32: 0
        elf.Tgt.x64: 0

// Which operations begin by loading their first operand into RG_A.
// Only after one of those may the store before it be dropped: the value
// stays in the accumulator and that load takes it straight back, and
// any other opening would put something else there first.  Read out of
// the ladder below rather than written from memory of it.
fn td_reads_a_first(o : ir_m.Ir) → bool:
    if o.ord() >= ir_m.Ir.ceq.ord() and o.ord() <= ir_m.Ir.cge.ord():
        return true
    o = ir_m.Ir.mov or o = ir_m.Ir.add or o = ir_m.Ir.addw or o = ir_m.Ir.sub or o = ir_m.Ir.subw or o = ir_m.Ir.mul or o = ir_m.Ir.mulw or o = ir_m.Ir.neg or o = ir_m.Ir.negw or o = ir_m.Ir.band or o = ir_m.Ir.borr or o = ir_m.Ir.bxorr or o = ir_m.Ir.bnott or o = ir_m.Ir.shll or o = ir_m.Ir.shrr or o = ir_m.Ir.maxx or o = ir_m.Ir.minn or o = ir_m.Ir.divv or o = ir_m.Ir.modd or o = ir_m.Ir.jz or o = ir_m.Ir.jnz or o = ir_m.Ir.aidx or o = ir_m.Ir.aref or o = ir_m.Ir.asto or o = ir_m.Ir.alen or o = ir_m.Ir.hlen or o = ir_m.Ir.fld or o = ir_m.Ir.fsto or o = ir_m.Ir.chr or o = ir_m.Ir.narrow or o = ir_m.Ir.ldn or o = ir_m.Ir.stn or o = ir_m.Ir.ret or o = ir_m.Ir.ext

// The same reckoning the pioneer makes, over the same shared counts,
// asking this ladder's own question about what comes next.
fn td_can_drop(ir : ir_m.IrFn, i : i64 ¤ptrdiff, n : i64 ¤ptrdiff, cnt : i64[], nv : i64) → bool:
    let d : i64 = ir.id[i]
    if d < 0 or d >= nv or i + 1 >= n:
        return false
    let nx : ir_m.Ir = ir.op[i + 1]
    if nx = ir_m.Ir.label or not td_reads_a_first(nx):
        return false
    if ir.ia[i + 1] ≠ d:
        return false
    cnt[d × 1¤ptrdiff] - ir_m.se_here(ir, i, d) = ir_m.se_here(ir, i + 1, d) and ir_m.se_here(ir, i + 1, d) = 1

@export
fn t_emit_fn(em : &mut emit.Emit, tg : elf.Target, ir : ir_m.IrFn, np : i64, strs : str[],
             nreg : i64, nreg_of : i64[]):
    assert(ir.nvregs >= np, "the frame covers the spilled arguments")
    let n : i64 ¤ptrdiff = #ir.op
    let secnt : i64[] = ir_m.se_counts(ir, ir.nvregs)
    // which results anything will read wider than their type
    let cwant : i64[] = ir_m.canon_wanted(ir, ir.nvregs, t_freecmp(tg), t_freediv(tg))
    em.begin_fn(ir.nlabels + @dropunit(6 × n) + 8)
    let sl : mut i64 = ir.nlabels
    // the objects that live in the frame take the slots past the vregs
    let nobj : i64 = (@dropunit(ir.fbytes) + 7) ÷ 8 ?? 0
    dispatch.g_prologue(&em, tg, ir.nvregs + nobj, np, nreg)
    foreach i := 0¤ptrdiff…n:
        let o : ir_m.Ir = ir.op[i]
        let a : i64 = ir.ia[i]
        let b : i64 = ir.ib[i]
        let c : i64 = ir.ic[i]
        let d : i64 = ir.id[i]
        let w : i64 = ir.iw[i]
        let bits : i64 = w & 255
        let sgn : i64 = w » 8
        // The width to work at, which is the value's own only where
        // this target is free at it and so the analysis has let the
        // bits above it be anything.  Everywhere else the value is
        // canonical and the whole register is the right place to work.
        let wb9 : i64 = (bits ÷ 8) ?? 0
        let cwid : i64 = if (t_freecmp(tg) & wb9) ≠ 0: bits else: 64
        let dwid : i64 = if (t_freediv(tg) & wb9) ≠ 0: bits else: 64
        em.drop_slot ← if td_can_drop(ir, i, n, secnt, ir.nvregs): d else: ⁻1
        if o = ir_m.Ir.const:
            dispatch.g_const(&em, tg, arch_a64.RG_A, a)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.mov:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.add or o = ir_m.Ir.addw or o = ir_m.Ir.sub or o = ir_m.Ir.subw:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            if o = ir_m.Ir.add or o = ir_m.Ir.sub:
                // Where the machine can settle it at this width, it
                // does; otherwise the arithmetic is done at a word and
                // the range asked afterwards.
                if dispatch.g_narrow_ok(tg, bits):
                    // the target says whether it can branch on what the
                    // arithmetic set or has to make a value of it first
                    if o = ir_m.Ir.add:
                        dispatch.g_addchk(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B, sgn, bits, sl)
                    else:
                        dispatch.g_subchk(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B, sgn, bits, sl)
                    dispatch.g_call(&em, tg, emit.RT_OV)
                    dispatch.g_label(&em, tg, sl)
                    sl ← sl + 1
                    // a narrow result comes back in the shape its width
                    // leaves it; a word-wide one is already canonical
                    if arch_x86_64.want_canon(cwant, d, w):
                        t_canon(&em, tg, w)
                else:
                    if o = ir_m.Ir.add:
                        dispatch.g_add3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                    else:
                        dispatch.g_sub3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                    t_range_check(&em, tg, w, sl)
                    sl ← sl + 1
            else:
                if o = ir_m.Ir.addw:
                    dispatch.g_add3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                else:
                    dispatch.g_sub3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                if arch_x86_64.want_canon(cwant, d, w):
                    t_canon(&em, tg, w)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.mul or o = ir_m.Ir.mulw:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            if o = ir_m.Ir.mulw:
                dispatch.g_mul3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                if arch_x86_64.want_canon(cwant, d, w):
                    t_canon(&em, tg, w)
            elif bits = 64:
                dispatch.g_mulov(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, sgn, bits)
                dispatch.g_jz(&em, tg, arch_a64.RG_C, sl)
                dispatch.g_call(&em, tg, emit.RT_OV)
                dispatch.g_label(&em, tg, sl)
                sl ← sl + 1
            else:
                dispatch.g_mul3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                t_range_check(&em, tg, w, sl)
                sl ← sl + 1
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.neg or o = ir_m.Ir.negw:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            if o = ir_m.Ir.neg and sgn = 1 and bits = 64:
                // the one signed value with no negation
                dispatch.g_const(&em, tg, arch_a64.RG_B, ⁻9223372036854775807 - 1)
                dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, arch_a64.CC_NE, 0, 64)
                dispatch.g_jnz(&em, tg, arch_a64.RG_C, sl)
                dispatch.g_call(&em, tg, emit.RT_OV)
                dispatch.g_label(&em, tg, sl)
                sl ← sl + 1
                dispatch.g_neg2(&em, tg, arch_a64.RG_A, arch_a64.RG_A)
            elif o = ir_m.Ir.neg and sgn = 0:
                // a negated unsigned is only 0
                dispatch.g_jz(&em, tg, arch_a64.RG_A, sl)
                dispatch.g_call(&em, tg, emit.RT_OV)
                dispatch.g_label(&em, tg, sl)
                sl ← sl + 1
                dispatch.g_neg2(&em, tg, arch_a64.RG_A, arch_a64.RG_A)
            else:
                dispatch.g_neg2(&em, tg, arch_a64.RG_A, arch_a64.RG_A)
                if o = ir_m.Ir.neg:
                    t_range_check(&em, tg, w, sl)
                    sl ← sl + 1
                elif arch_x86_64.want_canon(cwant, d, w):
                    t_canon(&em, tg, w)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.band or o = ir_m.Ir.borr or o = ir_m.Ir.bxorr:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            if o = ir_m.Ir.band:
                dispatch.g_and3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
            elif o = ir_m.Ir.borr:
                dispatch.g_or3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
            else:
                dispatch.g_xor3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.bnott:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_not2(&em, tg, arch_a64.RG_A, arch_a64.RG_A)
            if arch_x86_64.want_canon(cwant, d, w):
                t_canon(&em, tg, w)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.shll or o = ir_m.Ir.shrr:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            dispatch.g_const(&em, tg, arch_a64.RG_C, bits - sgn)
            dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_B, arch_a64.RG_C, arch_a64.CC_LT, 0, 64)
            dispatch.g_jnz(&em, tg, arch_a64.RG_C, sl)
            dispatch.g_call(&em, tg, emit.RT_SHIFT)
            dispatch.g_label(&em, tg, sl)
            sl ← sl + 1
            if o = ir_m.Ir.shll:
                dispatch.g_shl3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
                if arch_x86_64.want_canon(cwant, d, w):
                    t_canon(&em, tg, w)
            elif sgn = 1:
                dispatch.g_sar3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
            else:
                dispatch.g_shr3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o.ord() >= ir_m.Ir.ceq.ord() and o.ord() <= ir_m.Ir.cge.ord():
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, o.ord() - ir_m.Ir.ceq.ord(), sgn, cwid)
            dispatch.g_mov2(&em, tg, arch_a64.RG_A, arch_a64.RG_C)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.maxx or o = ir_m.Ir.minn:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B, if o = ir_m.Ir.maxx: arch_a64.CC_GE else: arch_a64.CC_LE, sgn, cwid)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.sel:
            dispatch.g_lds(&em, tg, arch_a64.RG_C, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_A, b)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, c)
            dispatch.g_sel4(&em, tg, arch_a64.RG_A, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_B)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.divv or o = ir_m.Ir.modd:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            dispatch.g_lds(&em, tg, arch_a64.RG_B, b)
            let ldo9 : i64 = sl
            let lend9 : i64 = sl + 1
            sl ← sl + 2
            dispatch.g_jnz(&em, tg, arch_a64.RG_B, ldo9)
            dispatch.g_lds(&em, tg, arch_a64.RG_A, c)
            dispatch.g_jmp(&em, tg, lend9)
            dispatch.g_label(&em, tg, ldo9)
            // Dividing at the width, the least value over minus one is
            // answered wrongly rather than refused, so the check that
            // stood only at the word now stands wherever the division
            // is made where the value is.
            let dfree : bool = dwid ≠ 64
            if sgn = 1 and (bits = 64 or dfree):
                dispatch.g_const(&em, tg, arch_a64.RG_C, t_least(bits))
                dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_A, arch_a64.RG_C, arch_a64.CC_NE, 0, dwid)
                dispatch.g_jnz(&em, tg, arch_a64.RG_C, sl)
                dispatch.g_const(&em, tg, arch_a64.RG_C, ⁻1)
                dispatch.g_cmp3(&em, tg, arch_a64.RG_C, arch_a64.RG_B, arch_a64.RG_C, arch_a64.CC_NE, 0, dwid)
                dispatch.g_jnz(&em, tg, arch_a64.RG_C, sl)
                if o = ir_m.Ir.divv:
                    dispatch.g_call(&em, tg, emit.RT_OV)
                else:
                    // the remainder is nought and always was; the
                    // machine faults only because it works the
                    // quotient out at the same time
                    dispatch.g_const(&em, tg, arch_a64.RG_A, 0)
                    dispatch.g_jmp(&em, tg, lend9)
                dispatch.g_label(&em, tg, sl)
                sl ← sl + 1
            if o = ir_m.Ir.divv:
                dispatch.g_div3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B, sgn, dwid)
            else:
                dispatch.g_mod3(&em, tg, arch_a64.RG_A, arch_a64.RG_A, arch_a64.RG_B, sgn, dwid)
            if sgn = 1 and bits ≠ 64 and not dfree:
                t_range_check(&em, tg, w, sl)
                sl ← sl + 1
            dispatch.g_label(&em, tg, lend9)
            // Only a division made at the width leaves a value only
            // that wide.  Made whole, of operands that were canonical,
            // it answers canonically and there is nothing to put right.
            if dfree and arch_x86_64.want_canon(cwant, d, w):
                t_canon(&em, tg, w)
            dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.jmp:
            dispatch.g_jmp(&em, tg, a)
        elif o = ir_m.Ir.jz or o = ir_m.Ir.jnz:
            dispatch.g_lds(&em, tg, arch_a64.RG_A, a)
            if o = ir_m.Ir.jz:
                dispatch.g_jz(&em, tg, arch_a64.RG_A, b)
            else:
                dispatch.g_jnz(&em, tg, arch_a64.RG_A, b)
        elif o = ir_m.Ir.label:
            dispatch.g_label(&em, tg, a)
        elif o = ir_m.Ir.call:
            let argc : i64 = ir.extra[b × 1¤ptrdiff]
            let cnr : i64 = if a >= 0 and a < @dropunit(#nreg_of): nreg_of[a × 1¤ptrdiff] else: 0
            // The stack arguments are put down first.  Where a target
            // moves an argument into a register it may be travelling
            // through the very register a later stack argument would
            // borrow, and going in this order the two never meet.
            foreach k := (cnr ⌊ argc)…argc:
                dispatch.g_argld(&em, tg, k, ir.extra[(b + 1 + k) × 1¤ptrdiff])
            foreach kr := 0…(argc ⌊ cnr):
                dispatch.g_argreg(&em, tg, kr, ir.extra[(b + 1 + kr) × 1¤ptrdiff])
            dispatch.g_call(&em, tg, a)
            dispatch.g_retst(&em, tg, d)
            // a returned value is only as wide as its type; where this
            // caller wants more, this caller is the one that says so
            if arch_x86_64.want_canon(cwant, d, w):
                dispatch.g_lds(&em, tg, arch_a64.RG_A, d)
                t_canon(&em, tg, w)
                dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.calli:
            let argci : i64 = ir.extra[b × 1¤ptrdiff]
            foreach ki := 0…argci:
                dispatch.g_argld(&em, tg, ki, ir.extra[(b + 1 + ki) × 1¤ptrdiff])
            dispatch.g_lds(&em, tg, arch_a64.RG_C, a)
            dispatch.g_calli(&em, tg, arch_a64.RG_C)
            dispatch.g_retst(&em, tg, d)
            if arch_x86_64.want_canon(cwant, d, w):
                dispatch.g_lds(&em, tg, arch_a64.RG_A, d)
                t_canon(&em, tg, w)
                dispatch.g_sts(&em, tg, arch_a64.RG_A, d)
        elif o = ir_m.Ir.ret:
            if a ≠ ⁻1:
                dispatch.g_retld(&em, tg, a)
            dispatch.g_epilogue(&em, tg)
        elif o = ir_m.Ir.prints or o = ir_m.Ir.eprints or o = ir_m.Ir.abort:
            let pos : i64 = dispatch.g_absref_arg(&em, tg, 0)
            if em.skipping = 0:
                em.sf_pos.push(pos)
                em.sf_str.push(a)
            dispatch.g_argconst(&em, tg, 1, emit.str_len(strs[a × 1¤ptrdiff]))
            dispatch.g_call(&em, tg, if o = ir_m.Ir.prints: emit.RT_WRITE1 else: (if o = ir_m.Ir.eprints: emit.RT_WRITE2 else: emit.RT_ABORT))
        elif o = ir_m.Ir.printi or o = ir_m.Ir.printu:
            dispatch.g_argld(&em, tg, 0, a)
            dispatch.g_call(&em, tg, if o = ir_m.Ir.printi: emit.RT_PRINTI else: emit.RT_PRINTU)
        elif o = ir_m.Ir.printsv:
            dispatch.g_argld(&em, tg, 0, a)
            dispatch.g_call(&em, tg, emit.RT_PRINTSTR)
        elif o = ir_m.Ir.exit:
            dispatch.g_sysarg(&em, tg, 0, a)
            dispatch.g_syscall(&em, tg, arch_a64.SC_EXIT)
