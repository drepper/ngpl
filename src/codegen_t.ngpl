// ===========================================================================
// Code generation for every target that is not the x86-64 pioneer:
// one shared driver over the IR, one thin instruction layer per
// architecture, and a runtime written once as IR and compiled by the
// same driver it serves.
// ===========================================================================

let abi := @import("abi")
let arch_a64 := @import("arch_a64")
let arch_arm := @import("arch_arm")
let arch_i386 := @import("arch_i386")
let arch_rv32 := @import("arch_rv32")
let arch_rv64 := @import("arch_rv64")
let ast := @import("ast")
let check := @import("check")
let codegen := @import("codegen")
let diag := @import("diag")
let dispatch := @import("dispatch")
let elf := @import("elf")
let emit := @import("emit")
let machine := @import("machine")
let incr_m := @import("incr")
let ir_m := @import("ir")
let lex := @import("lex")
let lower := @import("lower")
let names := @import("names")
let rt_backtrace := @import("rt_backtrace")
let rt_portable := @import("rt_portable")
let symbols := @import("symbols")
let tdriver_m := @import("tdriver")
let tokens := @import("tokens")
let types := @import("types")

// How many arguments a target takes in registers today, and how many
// more a function nobody outside can call could take.  The three
// 32-bit targets take none: an i64 arrives as a pair, and the simple
// course was to put every pair on the stack -- which is why the private
// convention is worth most exactly there.


fn abi_argregs(tg : &elf.Target) → i64:
    match tg.id:
        elf.Tgt.a64: 8
        elf.Tgt.rv64: 8
        _: 0

// How many arguments past the architecture's own convention a private
// function actually takes.  A target grants this only where its call
// site and its prologue have both been taught to spend it; everywhere
// else it is zero, and the architecture's convention carries every
// argument exactly as it did before.
//
// i386 grants three because its abstract registers are cells in the
// frame: eax:edx is the only pair a body touches, so ecx, ebx, esi and
// edi are free from one end of a function to the other, and nothing
// needs preserving because a caller keeps nothing across a call.
fn abi_spent(tg : &elf.Target) → i64:
    match tg.id:
        elf.Tgt.i386: 3         // eax:edx, ecx:ebx, esi:edi
        elf.Tgt.a32: 2          // r0:r1, r2:r3
        elf.Tgt.rv32: 4         // a0…a7, a pair each
        _: 0

@export
@pre(olevel >= 0)
fn codegen_t(a : &ast.Ast, toks : &lex.Toks, src : byte[], chk : &check.Chk, tgt : &elf.Target,
             stack_size : i64, guard_size : i64, olevel : i64, want_log : bool,
             incr : &incr_m.Incr) → codegen.Compiled:
    let ab : abi.Abi = abi.analyze_abi(&a, &toks, abi_argregs(&tgt), abi_spent(&tgt), want_log)
    // What the driver routes through the private convention, per
    // function.  Zero says the architecture's own path carries every
    // argument, which is what every target but i386 still does.
    let nregs : mut i64[] = []
    foreach i := 0…#a.fns:
        // a function whose code is copied was written against the
        // convention it had, and the convention is decided over the
        // whole program; under --incremental every function keeps
        // the architecture's own path, which no build moves
        nregs.push(if abi_spent(&tgt) = 0 or incr.mode ≠ 0: 0 else: ab.nreg[i])
    let strs0 : mut str[] = []
    strs0 ← strs0 ⧺ a.strs
    let sat0 : mut names.Names = names.names_new(@dropunit(#strs0))
    foreach i0 := 0¤ptrdiff…#strs0:
        sat0.add_at(strs0[i0], @dropunit(i0))
    let lw : mut lower.Lower = lower.Lower{a: a, toks: toks, src: src, ntype: chk.ntype,
                               nslot: chk.nslot, ncvt: chk.ncvt, nrep: chk.nrep, nlam: chk.nlam, nhold: chk.nhold, nfree: chk.nfree, rec_stmt: chk.rec_stmt, rec_slot: chk.rec_slot, nmove: chk.nmove, cur_ref: 0, strs: strs0, sat: sat0, loop_labels: [],
                               op: [], ia: [], ib: [], ic: [], idd: [],
                               iww: [], extra: [], tbase: 0, tnext: 0,
                               tmax: 0, nlabels: 0, breaks: [], conts: [],
                               in_wrap: 0, argsfix: ⁻1, lambase: 0,
                               shimbase: 0,
                               cur_ret: 0, post_label: ⁻1,
                               res_vreg: ⁻1, old_base: 0, inv_subject: ⁻1, tail_label: ⁻1, tail_fn: ⁻1, tail_np: 0, cur_fname: "", dlog: [],
                               argcopy: chk.argcopy, fbytes: 0¤byte, sret: ⁻1,
                               olevel: olevel}
    let em : mut emit.Emit = emit.Emit{code: [], cf_pos: [], cf_target: [],
                             sf_pos: [], sf_str: [], sd_pos: [], sd_str: [],
                             df_pos: [], df_off: [], labels: [],
                             lf_pos: [], lf_label: [], fn_off: [],
                             rt_off: [], rax_slot: ⁻1, drop_slot: ⁻1, hold_slot: ⁻1, pkeep: [], self_priv: 0,
                             jt_pos: [], jt_id: [], jt_count: 0,
                             jt_starts: [], jt_is_code: [], jt_entries: [],
                             pj_id: [],
                             pj_start: [], pj_len: [], pj_labels: [],
                             max_frame: 0,
                             gmap: [], gseg: [], gr_pos: [], gr_off: [],
                             skipping: 0, rt_need: [],
                             rx: [], rx_pos: [], rx_off: [], bt_pos: [],
                             ab_kind: [], ab_lab: [],
                             tf_pos: [], tf_lab: [], tf_form: [],
                             ff_pos: [], ff_fn: [], k_args: 0, k_alloc: 0, k_sig: 0}
    let nglobals : i64 ¤ptrdiff = #a.globals
    // the same three kinds of data the x86-64 path sorts out, placed
    // with the same offsets
    let is_relro : mut i64[] = nglobals ⍴ 0
    foreach g := chk.ginit:
        is_relro[g × 1¤ptrdiff] ← 1
    let n_relro : mut i64 = 0
    let n_rw : mut i64 = 0
    if nglobals > 0:
        foreach i := 0…nglobals:
            if a.globals[i].is_mut:
                n_rw ← n_rw + 1
            elif is_relro[i] = 1:
                n_relro ← n_relro + 1
    let args_off : i64 = 8 × n_relro
    let relro_size : i64 = elf.align_up(args_off + emit.KB_SIZE, elf.PAGE)
    // the signal structures sit at the head of the writable data
    let alloc_off : i64 = relro_size + emit.SIG_SIZE + 8 × n_rw
    em.k_args ← args_off
    em.k_alloc ← alloc_off
    em.k_sig ← relro_size
    let k_ro : mut i64 = 0
    let k_relro : mut i64 = 0
    let k_rw : mut i64 = 0
    if nglobals > 0:
        foreach i := 0…nglobals:
            if a.globals[i].is_mut:
                em.gseg.push(1)
                em.gmap.push(relro_size + emit.SIG_SIZE + 8 × k_rw)
                k_rw ← k_rw + 1
            elif is_relro[i] = 1:
                em.gseg.push(1)
                em.gmap.push(8 × k_relro)
                k_relro ← k_relro + 1
            else:
                em.gseg.push(0)
                em.gmap.push(8 × k_ro)
                k_ro ← k_ro + 1
    let nfns : i64 = @dropunit(#a.fns)
    let start_fn : mut i64 = ⁻1
    foreach i := 0…#a.fns:
        if a.fns[i].is_start:
            start_fn ← @dropunit(i)
    let ninit : i64 = @dropunit(#chk.ginit)
    let g1 : i64 = if ninit > 0: 1 else: 0
    lw.argsfix ← nfns + g1
    lw.lambase ← nfns + g1 + 2
    lw.shimbase ← lw.lambase + @dropunit(#chk.lams)
    let tdriver : i64 = nfns + g1 + 1
    let sret : bool = start_fn >= 0 and a.fns[start_fn × 1¤ptrdiff].ret ≠ types.TY_UNIT
    dispatch.g_startup(&em, &lw, &tgt, args_off, stack_size, guard_size,
              if ninit > 0: nfns else: ⁻1, tdriver, start_fn, sret)
    // the program's own code, then the whole runtime: nothing is
    // trimmed here yet, since the IR-built routines call each other
    let incr_why : mut str = ""
    // see the same lists in codegen.ngpl: what is not written where it
    // stands is gathered here and written after the runtime
    let dfr_fn : mut i64[] = []
    let dfr_at : mut i64[] = []
    let dfr_np : mut i64[] = []
    let dfr_ir : mut ir_m.IrFn[] = []
    let dfr_rt : mut i64[] = []
    // A function nothing reaches is in no binary.  Its slot in the
    // schedule stays, so every index into it still means what it meant
    // -- the lambdas and the shims are numbered past the functions --
    // and its offset is the one no call may land on, so a call that
    // somehow reaches for it is caught where the calls are resolved
    // rather than jumping into whatever stands at the front.
    let live : bool[] = incr_m.reached_fns(&a, &toks, src)
    foreach i := 0…#a.fns:
        let f : i64 = @dropunit(i)
        if not live[i]:
            // Its slot stays, so every index into the schedule still
            // means what it meant -- the lambdas and the shims are
            // numbered past the functions -- and its offset is the one
            // no call may land on, so a call that somehow reaches for
            // it is caught where the calls are resolved rather than
            // jumping into whatever stands at the front.
            em.fn_off.push(⁻1)
            continue
        // the space for a sized answer arrives as one more argument
        let np : i64 = a.extra[a.fns[i].params_off] + (if check.farr_is_packed(a, a.fns[i].ret): 1 else: 0)
        let symnm : str = symbols.fn_symbol(&a, &toks, src, f)
        // lowered whether or not it is emitted: see the same loop in
        // codegen.ngpl for why the string table has to be complete
        let ir := if chk.skipfn[i] = 1: lower.lower_stub_fn(&lw, np) else: lower.lower_fn(&lw, &a, &chk, f)
        // a function an earlier build moved lives past .text, which is
        // past where the runtime goes: it is written with the rest of
        // the overflow, and emitted here only to find out what it
        // calls while that can still be answered
        let away : bool = incr.mode = 2 and incr.at_of(symnm) >= incr_m.incr_text_size(&incr)
        if away:
            if incr.fresh[i]:
                let mk0 := em.mark()
                tdriver_m.t_emit_fn(&em, &tgt, ir, np, lw.strs, nregs[i], nregs)
                incr_m.incr_harvest(em, mk0, &dfr_rt)
                em.rewind(mk0)
            dfr_fn.push(f)
            dfr_at.push(incr.at_of(symnm))
            dfr_np.push(np)
            dfr_ir.push(ir)
            em.fn_off.push(0)
            continue
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, symnm))
        em.fn_off.push(em.here())
        let began : i64 = em.here()
        if incr.mode = 2 and incr_why = "" and not incr.fresh[i]:
            incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_copy(&em, &incr, symnm))
        else:
            let mk := em.mark()
            tdriver_m.t_emit_fn(&em, &tgt, ir, np, lw.strs, nregs[i], nregs)
            if incr.mode = 2 and em.here() > incr.end_of(symnm):
                incr_m.incr_harvest(em, mk, &dfr_rt)
                em.rewind(mk)
                dfr_fn.push(f)
                dfr_at.push(⁻1)
                dfr_np.push(np)
                dfr_ir.push(ir)
                em.fn_off[i] ← 0
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, symnm, began))
    if ninit > 0:
        let gir := codegen.lower_ginit(&lw, &a, &chk)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, "<globals>"))
        em.fn_off.push(em.here())
        let b1 : i64 = em.here()
        tdriver_m.t_emit_fn(&em, &tgt, gir, 0, lw.strs, 0, nregs)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, "<globals>", b1))
    let fir := codegen.lower_argsfilter(&lw)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, "<args>"))
    em.fn_off.push(em.here())
    let b2 : i64 = em.here()
    tdriver_m.t_emit_fn(&em, &tgt, fir, 0, lw.strs, 0, nregs)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, "<args>", b2))
    let dir := codegen.lower_testdriver(&lw, &a)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, "<tests>"))
    em.fn_off.push(em.here())
    let b3 : i64 = em.here()
    tdriver_m.t_emit_fn(&em, &tgt, dir, 0, lw.strs, 0, nregs)
    incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, "<tests>", b3))
    foreach j := 0…#chk.lams:
        let lir := lower.lower_lambda_fn(&lw, &a, &chk, @dropunit(j))
        let lnm : str = "λ#" ⧺ tokens.i64_str(@dropunit(j))
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, lnm))
        em.fn_off.push(em.here())
        let b4 : i64 = em.here()
        let lnp : i64 = a.extra[a.na[chk.lams[j] × 1¤ptrdiff] × 1¤ptrdiff]
        tdriver_m.t_emit_fn(&em, &tgt, lir, lnp + 1, lw.strs, 0, nregs)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, lnm, b4))
    foreach j := 0…#chk.psfn:
        let sir := lower.lower_shim_fn(&lw, &chk, @dropunit(j))
        let pnm : str = "partial#" ⧺ tokens.i64_str(@dropunit(j))
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, pnm))
        em.fn_off.push(em.here())
        let b5 : i64 = em.here()
        tdriver_m.t_emit_fn(&em, &tgt, sir, chk.psnp[j] - chk.psk[j] + 1, lw.strs, 0, nregs)
        incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, pnm, b5))
    assert(@dropunit(#em.fn_off) = nfns + g1 + 2 + @dropunit(#chk.lams) + @dropunit(#chk.psfn), "one code offset per function")
    // What is emitted so far is the program's own, and the calls it
    // made name the runtime it reaches for.  Emitting those reveals
    // more calls -- a routine calls others, and the driver itself puts
    // in a call where an overflow or a bounds check has to go -- so
    // this runs in waves until a wave adds nothing.  Asking the IR
    // which routines it calls would miss the second kind.
    let nrt : i64 ¤ptrdiff = 75
    foreach _ := 0…nrt:
        em.rt_need.push(0)
        em.rt_off.push(⁻1)
    // Which routines a build carries is read off the calls it emitted,
    // and a build that copies a function instead of emitting it sees
    // none of that function's calls.  So a build lining up with a
    // previous one starts from the routines that build had, which the
    // old symbol table names.
    //
    // And it writes them in the order that build wrote them in.  Here
    // a routine is emitted as it is discovered, so the order depends
    // on which wave found it -- and seeding the set puts every routine
    // in the first wave, which is a different order and therefore a
    // different order of interning their messages, which is a
    // different .rodata.  The old symbol table says the order too,
    // since a routine's address is where it was written.  A routine
    // the old build did not carry sorts last, and moves nothing before
    // it; that it moved the end is what the check on the symbol table
    // catches.
    let rt_order : mut i64[] = []
    foreach i := 0…nrt:
        rt_order.push(@dropunit(i))
    if incr.mode = 2:
        let rtn0 := emit.RT_NAMES
        let key : mut i64[] = []
        foreach i := 0…nrt:
            let rt_at : i64 = incr.at_of(rtn0[i])
            key.push(if rt_at < 0: 1073741824 + @dropunit(i) else: rt_at)
            if rt_at >= 0:
                em.rt_need[i] ← 1
        // the routines in the order the old file had them: the order
        // that sorts the keys, applied to what stood in it
        rt_order ← rt_order[⍋ key]
    // what the functions written after the runtime reach, found out
    // before the set is closed rather than after it is written
    foreach t := dfr_rt:
        em.rt_need[(0 - t - 1) × 1¤ptrdiff] ← 1
    let more : mut bool = true
    while more:
        more ← false
        foreach i := 0…#em.cf_target:
            let t : i64 = em.cf_target[i]
            if t < 0:
                em.rt_need[(0 - t - 1) × 1¤ptrdiff] ← 1
        // a routine whose address was taken is reached as surely as one
        // that was called, and the address has nowhere to point if it
        // was left out
        foreach i := 0…#em.ff_fn:
            let t : i64 = em.ff_fn[i]
            if t < 0:
                em.rt_need[(0 - t - 1) × 1¤ptrdiff] ← 1
        foreach k0 := 0…nrt:
            let id0 : i64 ¤ptrdiff = rt_order[k0] × 1¤ptrdiff
            if em.rt_need[id0] = 1 and em.rt_off[id0] = ⁻1:
                em.rt_off[id0] ← em.here()
                let rid : i64 = 0 - @dropunit(id0) - 1
                let np9 : i64 = rt_nargs(rid)
                tdriver_m.t_emit_fn(&em, &tgt, rt_portable.rt_build(rid, &tgt, &lw), np9, lw.strs, 0, nregs)
                more ← true

    // The overflow: what would not fit where it stood.  See the same
    // block in codegen.ngpl for what each part of it is for.
    let tx_ends : mut i64[] = []
    tx_ends.push(em.here())
    if incr.mode = 2:
        foreach ov_e := incr.tx_ends:
            if ov_e > tx_ends[0¤ptrdiff]:
                tx_ends.push(ov_e)
    let placed : mut i64[] = []
    if #dfr_fn > 0:
        let ov_ord : mut i64[] = []
        foreach ov_k := 0…#dfr_fn:
            if dfr_at[ov_k] >= 0:
                let ov_at : i64 = dfr_at[ov_k]
                let ov_j : mut i64 ¤ptrdiff = #ov_ord
                ov_ord.push(@dropunit(ov_k))
                while ov_j > 0¤ptrdiff and dfr_at[ov_ord[ov_j - 1¤ptrdiff] × 1¤ptrdiff] > ov_at:
                    let ov_t : i64 = ov_ord[ov_j - 1¤ptrdiff]
                    ov_ord[ov_j - 1¤ptrdiff] ← ov_ord[ov_j]
                    ov_ord[ov_j] ← ov_t
                    ov_j ← ov_j - 1¤ptrdiff
        let ov_late : mut i64[] = []
        foreach ov_kk := ov_ord:
            let ov_i : i64 ¤ptrdiff = ov_kk × 1¤ptrdiff
            let ov_f : i64 = dfr_fn[ov_i]
            let ov_nm : str = symbols.fn_symbol(&a, &toks, src, ov_f)
            incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_before(&em, &incr, ov_nm))
            em.fn_off[ov_f × 1¤ptrdiff] ← em.here()
            let ov_beg : i64 = em.here()
            if not incr.fresh[ov_f × 1¤ptrdiff]:
                incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_copy(&em, &incr, ov_nm))
            else:
                let ov_mark := em.mark()
                tdriver_m.t_emit_fn(&em, &tgt, dfr_ir[ov_i], dfr_np[ov_i], lw.strs, nregs[ov_f × 1¤ptrdiff], nregs)
                if em.here() > incr.end_of(ov_nm):
                    em.rewind(ov_mark)
                    ov_late.push(ov_kk)
                    em.fn_off[ov_f × 1¤ptrdiff] ← 0
            incr_why ← incr_m.incr_first_reason(incr_why, incr_m.incr_after(&em, &incr, ov_nm, ov_beg))
            if em.fn_off[ov_f × 1¤ptrdiff] ≠ 0:
                placed.push(ov_f)
        foreach ov_k := 0…#dfr_fn:
            if dfr_at[ov_k] < 0:
                ov_late.push(@dropunit(ov_k))
        if #ov_late > 0:
            assert(em.here() <= incr_m.incr_text_end(&incr), "the overflow begins past what the last build used")
            while em.here() < incr_m.incr_text_end(&incr):
                em.b1(incr.fill)
            foreach ov_kk := ov_late:
                let ov_i : i64 ¤ptrdiff = ov_kk × 1¤ptrdiff
                let ov_f : i64 = dfr_fn[ov_i]
                em.fn_off[ov_f × 1¤ptrdiff] ← em.here()
                let ov_beg2 : i64 = em.here()
                tdriver_m.t_emit_fn(&em, &tgt, dfr_ir[ov_i], dfr_np[ov_i], lw.strs, nregs[ov_f × 1¤ptrdiff], nregs)
                let ov_pad : i64 = @dropunit(incr_m.incr_padding((em.here() - ov_beg2) × 1¤byte))
                foreach _ := 0…ov_pad:
                    em.b1(incr.fill)
                placed.push(ov_f)
            tx_ends.push(em.here())
    // calls resolve now that every target has a place
    foreach i := 0…#em.cf_pos:
        let pos : i64 = em.cf_pos[i]
        let t : i64 = em.cf_target[i]
        let dest : i64 = if t >= 0: em.fn_off[t × 1¤ptrdiff] else: em.rt_off[(0 - t - 1) × 1¤ptrdiff]
        assert(dest ≠ ⁻1, "every call reaches a routine that was emitted")
        dispatch.g_patch_call(&em, &tgt, pos, dest)
    // a function's address, taken as a value
    foreach i := 0…#em.ff_pos:
        let ff : i64 = em.ff_fn[i]
        let fat : i64 = if ff >= 0: em.fn_off[ff × 1¤ptrdiff] else: em.rt_off[(0 - ff - 1) × 1¤ptrdiff]
        assert(fat ≠ ⁻1, "the address taken is of a routine that was emitted")
        dispatch.g_patch_abs(&em, &tgt, em.ff_pos[i], elf.IMAGE_BASE + elf.PAGE + fat)
    // rodata: the strings' bytes, then their descriptors, then the
    // tables -- the same layout the x86-64 path writes
    let text_size : i64 = em.here()
    // What the text region is given, which is where the read-only
    // data begins; see incr_room_text for why this is not #code.
    let text_room : i64 ¤byte = incr_m.incr_room_text(&incr, text_size × 1¤byte)
    let ro_vaddr : i64 = elf.IMAGE_BASE + elf.align_up(elf.PAGE + @dropunit(text_room), elf.PAGE)
    // only the strings something reads reach the image; see str_uses
    let used : i64[] = if incr.mode = 0: emit.str_uses(&em, @dropunit(#lw.strs)) else: incr_m.incr_all_used(#lw.strs)
    let stroffs : mut i64[] = []
    let descidx : mut i64[] = []
    let acc : mut i64 = 0
    let nstr : mut i64 = 0
    foreach i := 0…#lw.strs:
        stroffs.push(acc)
        descidx.push(nstr)
        if used[i] = 1:
            acc ← acc + emit.str_len(lw.strs[i])
            nstr ← nstr + 1
    let descbase : i64 = elf.align_up(acc, 8)
    foreach i := 0…#em.sf_pos:
        dispatch.g_patch_abs(&em, &tgt, em.sf_pos[i], ro_vaddr + stroffs[em.sf_str[i] × 1¤ptrdiff])
    foreach i := 0…#em.sd_pos:
        dispatch.g_patch_abs(&em, &tgt, em.sd_pos[i], ro_vaddr + descbase + 16 × descidx[em.sd_str[i] × 1¤ptrdiff])
    let rodata : mut u8[] = []
    foreach i := 0…#lw.strs:
        if used[i] = 1:
            foreach c := lw.strs[i]:
                rodata.push(c.ord() & 255)
    while @dropunit(#rodata) < descbase:
        rodata.push(0)
    foreach i := 0…#lw.strs:
        if used[i] = 1:
            elf.push64(&rodata, ro_vaddr + stroffs[i])
            elf.push64(&rodata, emit.str_len(lw.strs[i]))
    // The table a backtrace reads: where every function of the program
    // begins, how far it runs, and what it is called.  Built here
    // because here is where all three are known, and read by RT_BT,
    // which is the one thing that asks where it is -- so the list of
    // places that ask is also the answer to whether to build it at
    // all.  A program with no way to stop itself carries no RT_BT, and
    // then these bytes would sit in the image saying nothing.
    let bt_at : mut i64 = 0
    let bt_to : mut i64 = 0
    if #em.bt_pos > 0:
        let bt_base : i64 = elf.align_up(@dropunit(#rodata), 8)
        while @dropunit(#rodata) < bt_base:
            rodata.push(0)
        bt_at ← bt_base
        let bt_nm0 : str[] = incr_m.incr_reorder_names(rt_backtrace.bt_fn_names(&a, ninit, @dropunit(#chk.lams), @dropunit(#chk.psfn)), placed)
        let bt_of0 : i64[] = incr_m.incr_reorder(em.fn_off, placed)
        let bt_nm : str[] = incr_m.bt_keep_names(bt_nm0, bt_of0)
        let bt_of : i64[] = incr_m.bt_keep_offs(bt_of0)
        foreach c := rt_backtrace.bt_bytes(&tgt, elf.IMAGE_BASE + elf.PAGE, bt_nm, bt_of,
                              rt_backtrace.bt_sizes(bt_of, @dropunit(#placed),
                                       rt_backtrace.bt_text_end(em, text_size), text_size)):
            rodata.push(c)
        foreach i := 0…#em.bt_pos:
            dispatch.g_patch_abs(&em, &tgt, em.bt_pos[i], ro_vaddr + bt_base)
        bt_to ← @dropunit(#rodata)
    let gro_base : i64 = @dropunit(#rodata)
    if nglobals > 0:
        foreach i := 0…nglobals:
            if em.gseg[i] = 0:
                elf.push64(&rodata, chk.gvals[i])
    let gro_end : i64 = @dropunit(#rodata)
    foreach i := 0…#em.gr_pos:
        dispatch.g_patch_abs(&em, &tgt, em.gr_pos[i], ro_vaddr + gro_base + em.gr_off[i])
    // A jump table holds code addresses, a value table its data, and
    // both come last: see incr_jt_prefix for why the end is where they
    // have to be.
    let jt_base : i64 = elf.align_up(@dropunit(#rodata), 8)
    while @dropunit(#rodata) < jt_base:
        rodata.push(0)
    let jt_kept : i64 = incr_m.incr_jt_prefix(&rodata, &incr, jt_base)
    foreach i := 0…#em.jt_pos:
        dispatch.g_patch_abs(&em, &tgt, em.jt_pos[i], ro_vaddr + jt_base + jt_kept + 8 × em.jt_starts[em.jt_id[i] × 1¤ptrdiff])
    foreach t := 0…#em.jt_starts:
        let lo2 : i64 = em.jt_starts[t]
        let hi2 : i64 = if t + 1 < #em.jt_starts: em.jt_starts[t + 1] else: @dropunit(#em.jt_entries)
        let base2 : i64 = if em.jt_is_code[t] = 1: elf.IMAGE_BASE + elf.PAGE else: 0
        foreach e3 := lo2…hi2:
            elf.push64(&rodata, base2 + em.jt_entries[e3 × 1¤ptrdiff])
    let ro_room : i64 ¤byte = incr_m.incr_room_ro(&incr, #rodata)
    let d_vaddr : i64 = elf.IMAGE_BASE + elf.align_up(ro_vaddr - elf.IMAGE_BASE + @dropunit(ro_room), elf.PAGE)
    foreach i := 0…#em.df_pos:
        dispatch.g_patch_abs(&em, &tgt, em.df_pos[i], d_vaddr + em.df_off[i])
    let data : mut u8[] = []
    if nglobals > 0:
        foreach i := 0…nglobals:
            if em.gseg[i] = 1 and em.gmap[i] < relro_size:
                elf.push64(&data, chk.gvals[i])
    // argc, argv, envp, the auxiliary vector and the guard's two
    // bounds, then the page's rest
    data ← data ⧺ (emit.KB_SIZE ⍴ 0)
    while @dropunit(#data) < relro_size:
        data.push(0)
    // the structures the kernel is handed when the handler is installed
    data ← data ⧺ (emit.SIG_SIZE ⍴ 0)
    if nglobals > 0:
        foreach i := 0…nglobals:
            if em.gseg[i] = 1 and em.gmap[i] >= relro_size:
                elf.push64(&data, chk.gvals[i])
    // the allocator's bump pointer, the limit it runs to, and the
    // free lists a block given back is put on
    data ← data ⧺ (emit.AL_SIZE ⍴ 0)
    assert(@dropunit(#data) = alloc_off + emit.AL_SIZE, "the data segment is as long as it was planned")
    let cdiags : mut diag.Diag[] = []
    if em.max_frame > guard_size:
        cdiags.push(diag.Diag{line: 1¤"line", col: 1¤"col",
                         msg: "a function claims " ⧺ tokens.i64_str(em.max_frame) ⧺ " bytes of stack, more than the " ⧺ tokens.i64_str(guard_size) ⧺ "-byte guard below it, which it could step over; raise --guard-size", level: diag.Level.error, code: diag.DIAG_NONE})
    if em.max_frame >= stack_size:
        cdiags.push(diag.Diag{line: 1¤"line", col: 1¤"col",
                         msg: "a function claims " ⧺ tokens.i64_str(em.max_frame) ⧺ " bytes of stack, and the whole stack is " ⧺ tokens.i64_str(stack_size) ⧺ "; raise --stack-size", level: diag.Level.error, code: diag.DIAG_NONE})
    // the symbols, in address order: the entry point, the functions,
    // the synthetics, and the runtime, which here is emitted in id
    // order and so already ascends
    let sname : mut str[] = []
    let soffs : mut i64[] = []
    let sglob : mut bool[] = []
    sname.push("_start")
    soffs.push(0)
    sglob.push(false)
    // a function this build moved is not in address order here; see
    // the same run in codegen.ngpl
    foreach i := 0…#a.fns:
        // a function nothing reached is in no binary, and so is no
        // symbol either -- as a runtime routine nobody reached is not
        if not incr_m.incr_moved(placed, @dropunit(i)) and em.fn_off[i] ≠ ⁻1:
            sname.push(symbols.fn_symbol(&a, &toks, src, @dropunit(i)))
            soffs.push(em.fn_off[i])
            sglob.push(a.fns[i].is_export)
    let synth : mut str[] = []
    if ninit > 0:
        synth.push("<globals>")
    synth.push("<args>")
    synth.push("<tests>")
    synth ← synth ⧺ (tokens.numbered("λ#") ¨ (0…@dropunit(#chk.lams)))
    synth ← synth ⧺ (tokens.numbered("partial#") ¨ (0…@dropunit(#chk.psfn)))
    foreach j := 0…#synth:
        sname.push(synth[j])
        soffs.push(em.fn_off[(nfns + @dropunit(j)) × 1¤ptrdiff])
        sglob.push(false)
    // A routine nobody reached is in no binary, and so is no symbol
    // either.  The rest go in by address: a routine's id is its place
    // in the list rather than in the code, and a symbol's size is the
    // distance to the next one, which must never run backwards.
    let rtn := emit.RT_NAMES
    let rname : mut str[] = []
    let roff : mut i64[] = []
    foreach i := 0…#em.rt_off:
        if em.rt_off[i] ≠ ⁻1:
            let at : i64 = em.rt_off[i]
            let nm : str = rtn[i]
            let k : mut i64 = @dropunit(#roff)
            rname.push(nm)
            roff.push(at)
            while k > 0 and roff[(k - 1) × 1¤ptrdiff] > at:
                rname[k × 1¤ptrdiff] ← rname[(k - 1) × 1¤ptrdiff]
                roff[k × 1¤ptrdiff] ← roff[(k - 1) × 1¤ptrdiff]
                k ← k - 1
            rname[k × 1¤ptrdiff] ← nm
            roff[k × 1¤ptrdiff] ← at
    foreach i := 0…#roff:
        sname.push(rname[i])
        soffs.push(roff[i])
        sglob.push(false)
    foreach mv := placed:
        sname.push(symbols.fn_symbol(&a, &toks, src, mv))
        soffs.push(em.fn_off[mv × 1¤ptrdiff])
        sglob.push(a.fns[mv × 1¤ptrdiff].is_export)
    let syms : mut elf.Sym[] = []
    foreach i := 0…#sname:
        let here : i64 ¤byte = soffs[i]
        let next : i64 ¤byte = if i + 1 < #soffs: soffs[i + 1] else: text_size
        assert(next >= here, "the symbols run up the text")
        syms.push(elf.Sym{name: sname[i], value: here, size: next - here,
                      is_global: sglob[i]})
    // what the convention analysis decided, then what the lowering did
    let dlog : mut str[] = []
    dlog ← dlog ⧺ ab.log
    dlog ← dlog ⧺ lw.dlog
    codegen.Compiled{incr_why: incr_why, ro_fixed: descbase × 1¤byte,
             text_room: text_room, ro_room: ro_room, tx_ends: tx_ends,
             ro_vals: gro_base × 1¤byte, ro_vals_end: gro_end × 1¤byte,
             ro_bt: bt_at × 1¤byte, ro_bt_end: bt_to × 1¤byte, code: em.code, rodata: rodata, data: data,
             relro_size: relro_size, syms: syms,
             log: dlog, diags: cdiags}

// how many arguments each runtime routine takes, for the prologue
fn rt_nargs(id : i64) → i64:
    if id = emit.RT_WRITE1 or id = emit.RT_WRITE2 or id = emit.RT_ABORT: return 2
    if id = emit.RT_ALLOC or id = emit.RT_ARRNEW or id = emit.RT_PRINTI or id = emit.RT_PRINTU or id = emit.RT_EPRINTI: return 1
    if id = emit.RT_ARRPUSH or id = emit.RT_CONCAT or id = emit.RT_STREQ: return 2
    if id = emit.RT_STRCHARS or id = emit.RT_PRINTSTR: return 1
    if id = emit.RT_HNEW: return 2
    if id = emit.RT_HFIND or id = emit.RT_HGET or id = emit.RT_HELEM: return 2
    if id = emit.RT_HPUT: return 3
    if id = emit.RT_HGROW: return 1
    if id = emit.RT_STRIDX or id = emit.RT_STRNEXT: return 2
    if id = emit.RT_CHARS or id = emit.RT_CHARSTR: return 1
    if id = emit.RT_FOPEN or id = emit.RT_FREAD or id = emit.RT_TORAW or id = emit.RT_SBYTES: return 1
    if id = emit.RT_FTHERE or id = emit.RT_FIDP: return 1
    if id = emit.RT_GRADE or id = emit.RT_AEXT: return 2
    if id = emit.RT_FCREATE or id = emit.RT_FWRITE or id = emit.RT_WRITEV or id = emit.RT_FIDENT: return 2
    if id = emit.RT_AFIND: return 3
    if id = emit.RT_ASLICE: return 3
    if id = emit.RT_AFILL or id = emit.RT_ACYC or id = emit.RT_ACAT: return 2
    if id = emit.RT_ENVG or id = emit.RT_AUXV: return 1
    if id = emit.RT_DIVU64 or id = emit.RT_MODU64 or id = emit.RT_DIVS64 or id = emit.RT_MODS64: return 2
    if id = emit.RT_MULOV64: return 3
    if id = emit.RT_BT: return 0
    if id = emit.RT_SSLICE: return 3
    if id = emit.RT_HSTART: return 1
    if id = emit.RT_HFINAL: return 2
    if id = emit.RT_HUPDATE: return 2
    if id = emit.RT_SHA256INIT or id = emit.RT_SHA256BLK: return 1
    if id = emit.RT_SHA256FIN: return 2
    if id = emit.RT_SEGV: return 3
    if id = emit.RT_SIGINIT: return 0
    if id = emit.RT_FREE: return 2
    if id = emit.RT_BIGFROM: return 1
    if id = emit.RT_BIGCMP: return 2
    if id = emit.RT_BIGADD: return 3
    if id = emit.RT_BIGMUL: return 2
    if id = emit.RT_BIGPRINT: return 1
    0
