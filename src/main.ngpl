let ast_m := @import("ast")
let check := @import("check")
let codegen := @import("codegen")
let comptime_m := @import("comptime")
let diag := @import("diag")
let dumpast := @import("dumpast")
let elf := @import("elf")
let imports := @import("imports")
let incr_m := @import("incr")
let lex := @import("lex")
let parse := @import("parse")
let sbom := @import("sbom")
let sha256 := @import("sha256")
let tokens := @import("tokens")

// ===========================================================================
// Driver (grows as the pipeline does)
// ===========================================================================



fn tok_name(k : tokens.Tk) → str:
    if k = tokens.Tk.eof: return "eof"
    if k = tokens.Tk.nl: return "nl"
    if k = tokens.Tk.indent: return "indent"
    if k = tokens.Tk.dedent: return "dedent"
    if k = tokens.Tk.ident: return "ident"
    if k = tokens.Tk.number: return "int"
    if k = tokens.Tk.string: return "str"
    if k = tokens.Tk.reserved: return "reserved"
    // the keywords sit together in the numbering, which is what this
    // asks about: their names, not one of them
    if k.ord() >= tokens.Tk.kw_fn.ord() and k.ord() <= tokens.Tk.kw_match.ord(): return "kw"
    "op"

@impure
fn dump_tokens(t : &lex.Toks, src : byte[], files : &diag.Files):
    // a token's line is counted over the whole text, so it is turned
    // back into the file it came from, as a diagnostic's is
    let starts := diag.file_lines(files, src)
    foreach i := 0…#t.kind:
        let k : tokens.Tk = t.kind[i]
        let text := tokens.run_str(src, t.off[i], t.len[i])
        let f : i64 ¤ptrdiff = diag.file_of(starts, t.line[i])
        std.println("{}:{}:{} {} {} '{}' {}", files.names[f],
                    @dropunit(t.line[i] - starts[f] + 1),
                    @dropunit(t.col[i]), k.ord(),
                    tok_name(k), text, t.val[i])

// Whether anything said here refuses the program.  A warning does not:
// it is reported and the program still compiles, which is what makes it
// a warning.  -Werror says to treat every one as a refusal, as the
// interpreter's does.
fn any_refusal(diags : diag.Diag[], werror : bool) → bool:
    foreach d := diags:
        if d.level = diag.Level.error or werror:
            return true
    false

@impure
fn report(diags : diag.Diag[], files : &diag.Files, as_json : bool, src : byte[]):
    // one walk of the text, here where something is being reported
    // anyway, rather than on every compile that has nothing to say
    let starts := diag.file_lines(files, src)
    foreach d := diags:
        // the excerpt is taken with the line counted over the whole
        // text, which is what it is an index into; the file and the
        // line within it are what get printed.  A measured value shows
        // its measure when it is printed, and a diagnostic says a
        // number, so each parts with its measure here and nowhere
        // earlier -- the arithmetic above is checked, the printing is
        // what it always was.
        let k : i64 ¤ptrdiff = diag.file_of(starts, d.line)
        let file : str = files.names[k]
        let ln : i64 ¤"line" = d.line - starts[k] + 1
        // A warning says the program compiles and something in it is
        // worth a look; an error says it does not.  The number, where
        // the diagnostic has one, is what an @expect names.
        let sev : str = if d.level = diag.Level.warning: "warning" else: "error"
        let named : str = if d.code = diag.DIAG_NONE: sev else: sev ⧺ "[" ⧺ tokens.i64_str(d.code) ⧺"]"
        if as_json:
            std.println("""{}\"file\": \"{}\", \"line\": {}, \"col\": {}, \"severity\": \"{}\",
                         " \"code\": {}, \"message\": \"{}\"{}""",
                        "{", file, @dropunit(ln), @dropunit(d.col), sev, d.code, d.msg, "}")
        else:
            std.println("{}:{}:{}: {}: {}", file, @dropunit(ln), @dropunit(d.col), named, d.msg)
            let num := tokens.i64_str(@dropunit(ln))
            let gut : mut str = ""
            foreach g := 0…#num:
                gut ← gut ⧺ " "
            let pad : mut str = ""
            foreach c := 1…d.col:
                pad ← pad ⧺ " "
            std.println("  {} | {}", num, diag.line_str(src, d.line))
            std.println("  {} | {}^", gut, pad)

// What a file is for is told by its name: a source file ends in
// .ngpl, and other kinds of input -- objects, libraries -- will carry
// names of their own.  A name the compiler cannot classify is refused
// up front rather than read and misparsed.
fn is_ngpl_source(path : str) → bool:
    // something before the suffix, and then the suffix
    #path > 5 and ".ngpl" ⊒ path

// The named source could not be opened: say which file and why the
// compiler stopped, in the compiler's own words rather than a raw
// operating system error.
@noreturn
@impure
fn missing_input(name : str):
    std.println("ngplc: cannot open '{}': no such file or it cannot be read", name)
    std.exit(1)

// a size on the command line: bytes, or K, M or G of them; ⁻1 when
// the text is not a size at all
@post(r: r = ⁻1 or r >= 0)
fn parse_size(t : str) → i64:
    if #t = 0:
        return ⁻1
    let scale : mut i64 = 1
    // how many of the characters are the number, which is a count of
    // characters and is measured like one all the way to the subscript
    let n : mut i64 ¤ptrdiff = #t
    let last := t[#t - 1]
    if last = 'K' or last = 'k':
        scale ← 1024
        n ← n - 1
    elif last = 'M' or last = 'm':
        scale ← 1048576
        n ← n - 1
    elif last = 'G' or last = 'g':
        scale ← 1073741824
        n ← n - 1
    if n = 0:
        return ⁻1
    let v : mut i64 = 0
    foreach i := 0…n:
        let c := t[i]
        if c < '0' or c > '9':
            return ⁻1
        v ← v ⊠ 10 ⊞ (c - '0')
    v ⊠ scale

// The number an option carries written out in plain decimal, or ⁻1
// where what follows is not one.  -O takes a level this way, where a
// size takes the K, M and G that parse_size knows.
@post(r: r >= ⁻1)
fn parse_level(t : str) → i64:
    if #t = 0¤ptrdiff:
        return ⁻1
    let v : mut i64 = 0
    foreach c := t:
        if c < '0' or c > '9':
            return ⁻1
        // a level nobody could mean is refused rather than wrapped
        if v > 99999999:
            return ⁻1
        v ← v × 10 + (c - '0')
    v

// The directories a search path names, in the order it names them.  A
// path is written the way every other one is, the parts separated by a
// colon; an empty part names the working directory, as it does there.
fn split_path(raw : str) → str[]:
    if #raw = 0¤ptrdiff:
        // nothing said names no directory, where one empty part would
        // name the working directory
        return []
    let out : mut str[] = []
    let cur : mut str = ""
    foreach c := raw:
        if c = ':':
            out.push(cur)
            cur ← ""
        else:
            cur ← cur ⧺ c
    out.push(cur)
    out

// whether an argument is 'name=' and then whatever it carries
@pre(#name > 0)
fn opt_matches(a : str, name : str) → bool:
    #name > 0 and #a > #name and name ⊑ a and a[#name] = '='

// what it carries, which an argument written 'name=' alone leaves
// empty: the slice begins where the '=' ends, and a slice may begin at
// the end of what it takes from
@pre(#name > 0 and #a > #name)
fn opt_value(a : str, name : str) → str:
    a[#name + 1…#a]

// The compiler's own build, run with `ngplc --build src/main.ngpl`.
//
// The order below is the order the program is in, and it is not a
// convenience: a struct may be declared below whatever names it, since
// the parser sweeps the token stream for struct names before parsing,
// but an `enum` and a `unit` are registered as they are read.  So
// elf.ngpl has to come before anything that writes `Sht` or `¤"shndx"`,
// and sorting this list -- alphabetically, or any other way -- makes a
// different program.  build/sources.sh keeps the same list for the
// bootstrap's first stage, which runs under the interpreter and so
// cannot read this one; the two are checked against each other by the
// bootstrap comparing the stage each built.
@build
fn build(b : &mut std.Build, o : &std.Options):
    // One file, and the program says the rest of itself: every source
    // names at its head what it is written against, so the list that
    // used to live here lives in the files that know it.
    //
    // Where the compiler goes is named from where this file is: the
    // recipe lives in src/ and the binary belongs beside it, in build/.
    // What the command line said arrives as one std.Options, each of
    // its members ∅ where nothing was said: o.output names what this
    // build is called, o.target what it is built for, and o.optimize
    // how hard to work on it -- and where none of them said anything
    // the recipe's own answers stand, a compiler called ngplc built for
    // the machine underfoot at the level every build starts from.  The
    // compiler applies all three to what a recipe adds in any case, so
    // this says the same thing it would have done rather than a
    // different one.
    b.add_executable(std.Build.Executable{name: o.output ?? "ngplc",
                                          root_source_file: "main.ngpl",
                                          output_dir: "../build",
                                          target: o.target ?? "",
                                          optimize: o.optimize ?? 0})

fn empty_recipe() → comptime_m.Recipe:
    comptime_m.Recipe{names: [], roots: [], outdirs: [], targets: [], optimizes: [],
           paths: [], flags: [], diags: []}

// A name the recipe gave, made into a path this run can open.  An
// absolute name is taken as written; anything else is looked for beside
// the recipe first -- so a recipe means the same thing from whatever
// directory it is run -- and then along each search path it declared.
@impure
fn resolve_source(name : str, base : str, paths : str[]) → str:
    if "/" ⊑ name:
        return name
    let here : str = if base = "": name else: base ⧺ "/" ⧺ name
    if can_open(here):
        return here
    foreach d := paths:
        let root : str = if "/" ⊑ d or base = "": d else: base ⧺ "/" ⧺ d
        let cand : str = root ⧺ "/" ⧺ name
        if can_open(cand):
            return cand
    here

// Whether a candidate is there, asked the way imports.ngpl asks it:
// the name is looked at rather than opened, so the candidates that are
// not there cost a call each and a descriptor none.
@impure
fn can_open(path : str) → bool:
    std.fs.cwd().has_file(path)

// Read the recipe out of its own file: lex it, parse it leniently, and
// run it.  The file is not compiled here -- what it says to compile is
// the whole point -- so nothing past the recipe needs to be understood.
@noreturn
@impure
fn recipe_failed():
    std.exit(1)

@impure
fn read_build(path : str, json : bool, output : str, target : str,
              host : str, optimize : i64, searched : str) → comptime_m.Recipe:
    if not is_ngpl_source(path):
        std.println("ngplc: cannot tell what '{}' is: an NGPL source file's name ends in '.ngpl'", path)
        recipe_failed()
    let alloc := std.arena.allocator()
    let file := std.fs.cwd().open_file(path) ?? missing_input(path)
    let src := file.read_file(alloc)
    let files := diag.Files{names: [path], off: [0]}
    let toks := lex.lex(src)
    if #toks.diags > 0:
        report(toks.diags, &files, json, src)
        recipe_failed()
    let ast := parse.parse_recipe(&toks, src)
    if #ast.diags > 0:
        report(ast.diags, &files, json, src)
        recipe_failed()
    if #ast.builds = 0:
        std.println("ngplc: '{}' carries no @build function, so there is no recipe to read", path)
        recipe_failed()
    // The recipe runs without the checker having seen the file: what it
    // may contain is settled by the evaluator's own first pass, and no
    // global has been folded, so it reads none.
    let plan := comptime_m.build_recipe(&ast, &toks, src, [], output, target, host, optimize, searched)
    if #plan.diags > 0:
        report(plan.diags, &files, json, src)
        recipe_failed()
    plan

// A size as this help writes it, which is the spelling --stack-size
// takes back: the largest of G, M and K that divides it exactly.
fn size_str(n : i64) → str:
    if (n % 1073741824 ?? 1) = 0:
        return tokens.i64_str(n ÷ 1073741824 ?? 0) ⧺ "G"
    if (n % 1048576 ?? 1) = 0:
        return tokens.i64_str(n ÷ 1048576 ?? 0) ⧺ "M"
    if (n % 1024 ?? 1) = 0:
        return tokens.i64_str(n ÷ 1024 ?? 0) ⧺ "K"
    tokens.i64_str(n)

// Every option there is, grouped by what it is for and laid out the way
// argp lays one out: the usage line, the groups each under a heading,
// and the description of each option starting at the same column.  The
// defaults and the machine list are read from where they are defined
// rather than written again here, so they cannot come to disagree.
@impure
fn help():
    std.println("""Usage: ngplc [OPTION...] SOURCE.ngpl...\n
                  "   or: ngplc [OPTION...] --build RECIPE.ngpl\n
                  "Compile NGPL source into a static executable.\n
                  "\n
                  " Naming what to compile:\n
                  "      --build FILE           Take the source list from FILE's @build\n
                  "                             recipe rather than from the command line\n
                  "\n
                  " Output:\n
                  "  -o FILE                    Write the executable to FILE\n
                  "      --incremental          Leave each function room to grow, and on a\n
                  "                             later build write again only the functions\n
                  "                             whose source changed and those that call\n
                  "                             them\n
                  "      --target=MACHINE       Compile for MACHINE rather than for the\n
                  "                             machine this compiler runs on\n
                  "      --path=DIR:DIR         Look for an imported file in these\n
                  "                             directories, after the one beside it and\n
                  "                             before the library's own\n
                  "  -O[LEVEL]                  Work on the code at LEVEL, or at 1 where the\n
                  "                             level is left off; without -O the level is 0\n
                  "\n
                  " The program that comes out:\n
                  "      --stack-size=SIZE      Reserve SIZE for its stack\n
                  "      --guard-size=SIZE      Leave SIZE unmapped below the stack, so\n
                  "                             running off the bottom is caught\n
                  "\n
                  " Diagnostics:\n
                  "  -Werror                    Treat every warning as an error\n
                  "      --diag=json            Write diagnostics as JSON, one to a line\n
                  "\n
                  " What the compiler did:\n
                  "      --dump-tokens          Write the token stream and stop\n
                  "      --dump-ast             Write the syntax tree and stop\n
                  "      --log=json             Write one JSON line for each decision\n
                  "                             taken about the shape of the code\n
                  "\n
                  "      --help                 Give this help list\n
                  "\n
                  "Mandatory or optional arguments to long options are also mandatory or optional\n
                  "for any corresponding short options.\n
                  "\n
                  "A SIZE is a number of bytes, or a number and K, M or G; the stack\n
                  "holds {} and the guard {} unless they are said otherwise.\n""",
                size_str(elf.STACK_DEFAULT), size_str(elf.GUARD_DEFAULT))
    std.println("")
    std.println("MACHINE is one of: {}.", elf.target_names())
    std.println("")
    std.println("Report bugs to <https://github.com/drepper/ngpl/issues>.")

// What the command line said, carried to each build the recipe asks
// for rather than passed one argument at a time.  A recipe may ask for
// several, and every one of them is compiled the same way.
struct Options:
    tgt_index : i64
    stack_size : i64
    guard_size : i64
    // how hard the compiler is asked to work on the code: 0, which is
    // what every build gets unless -O said otherwise, and upwards from
    // there.  It reaches the phases that generate code, which ask
    // whether they are at a level rather than reading the number.
    optimize : i64
    // where a name that says nothing about where it lives is looked
    // for, in the order --path named the directories
    path : str[]
    want_tokens : bool
    want_ast : bool
    want_log : bool
    werror : bool
    json : bool
    incremental : bool

// Compile the program rooted in `inputs` and write it to `outname`.
// Answers what the compiler answers: 0 where it wrote the file.
@impure
fn compile_one(inputs : str[], outname : str, o : &Options) → u8:
    // One program, read from the file it is rooted in: what a file is
    // written against comes in ahead of it, however deep that goes.
    // The lexer sees one text and counts one set of line numbers over
    // it; `files` keeps what is needed to give a diagnostic back the
    // file it came from.
    let prog := imports.read_program(inputs, o.path)
    if prog.why ≠ "":
        std.println("ngplc: {}", prog.why)
        return 1
    let src : byte[] = prog.src
    let files := diag.Files{names: prog.names, off: prog.offs}
    assert(#files.names = #files.off, "one starting offset per source file")

    let toks := lex.lex(src)
    if #toks.diags > 0:
        report(toks.diags, &files, o.json, src)
        return 1
    if o.want_tokens:
        dump_tokens(&toks, src, &files)
        return 0

    let mtab : ast_m.Mods = ast_m.Mods{offs: prog.offs, fmod: prog.fmod,
                           names: imports.mod_names(prog.mroot, prog.bmod),
                           roots: prog.mroot,
                           bname: prog.bname, bmod: prog.bmod,
                           bowner: prog.bowner}
    let ast := parse.parse_mods(&toks, src, mtab)
    if #ast.diags > 0:
        report(ast.diags, &files, o.json, src)
        return 1
    if o.want_ast:
        dumpast.dump_ast(&ast, src, &toks)
        return 0

    let chk := check.check(&ast, &toks, src)
    if #chk.diags > 0:
        report(chk.diags, &files, o.json, src)
        if any_refusal(chk.diags, o.werror):
            return 1

    // What went in: the compiler, then each source and all of them
    // together, then every function.  It is worked out here rather
    // than beside the writing because --incremental decides what to
    // generate by comparing the function digests with the ones the
    // previous binary carries, and that decision comes before the work
    // it saves.
    // Every binary carries its bill.  There is no flag: a program that
    // says what it was built from only where someone remembered to ask
    // is a program nobody can check, and since std.sha256 became a
    // runtime routine the bill costs a tenth of a second compiled and
    // nothing at all under the interpreter.
    let bom : mut sbom.SbomRow[] = []
    bom.push(sbom.SbomRow{kind: sbom.Sbomkind.compiler, name: sbom.sbom_compiler_name(),
                     hash: sha256.sha256_hex(std.bytes(sbom.sbom_compiler_name()))})
    // what this build is writing, which the bill names and the code
    // generator emits -- worked out once and handed to both
    let live : bool[] = incr_m.reached_fns(&ast, &toks, src)
    foreach r := sbom.sbom_sources(&ast, &toks, src, &files, live):
        bom.push(r)

    // The recipe is read whenever the program carries one, not only
    // under --build.  The interpreter runs it at load with no flag
    // involved, so a compiler that read it only when asked would accept
    // recipes the interpreter refuses -- the one direction this project
    // does not allow.  A file without a recipe pays one comparison.
    // What the recipe says here is not acted on -- --build is where a
    // recipe is read for what it declares -- so it is handed nothing
    // the command line said, and reads it only to be held to the rules.
    let recipe := comptime_m.build_recipe(&ast, &toks, src, chk.gvals, "", "", "", ⁻1, "")
    if #recipe.diags > 0:
        report(recipe.diags, &files, o.json, src)
        return 1

    let tgt := elf.targets()[o.tgt_index × 1¤ptrdiff]

    // Under --incremental the file about to be written is read first.
    // What it says -- a digest per function, an address and a slot per
    // symbol -- is enough to write again only the functions whose
    // source moved and those that name one; where it says nothing
    // usable, this is a first build, which differs from a plain one
    // only in leaving each function room to grow.
    let prev : incr_m.Prev = if o.incremental: incr_m.read_prev(outname) else: incr_m.prev_none()
    let fill : i64 = if tgt.id = elf.Tgt.x64: incr_m.INCR_FILL_X86 else: incr_m.INCR_FILL_ANY
    let incr : mut incr_m.Incr = incr_m.incr_off()
    if o.incremental:
        incr ← incr_m.incr_prev(&ast, &toks, src, &prev, bom, fill,
                         tgt.machine.ord(), tgt.is64, tgt.eflags)
    let first := codegen.codegen(&ast, &toks, src, &chk, &tgt, o.stack_size, o.guard_size, o.optimize, o.want_log, &incr)
    // A rebuild that could not be laid over the old file says why and
    // is done again whole, which is always right.  The whole build
    // still leaves padding, so the build after it is incremental.
    let why : mut str = ""
    if incr.mode = 2 and #first.diags = 0:
        why ← if first.incr_why = "": codegen.incr_lines_up(&prev, &incr, first) else: first.incr_why
    let compiled := if why = "":
        first
    else:
        // a borrow is written on a name, so the fresh schedule gets one
        let afresh : incr_m.Incr = incr_m.incr_first(fill)
        codegen.codegen(&ast, &toks, src, &chk, &tgt, o.stack_size, o.guard_size, o.optimize, o.want_log, &afresh)
    if o.incremental and o.want_log:
        if incr.mode ≠ 2:
            std.println("{}", "{\"decision\": \"incremental-first\", \"functions\": " ⧺ tokens.i64_str(@dropunit(#ast.fns)) ⧺ "}")
        elif why = "":
            std.println("{}", "{\"decision\": \"incremental\", \"read\": \"" ⧺ outname ⧺ "\", \"functions\": " ⧺ tokens.i64_str(@dropunit(#ast.fns)) ⧺ ", \"regenerated\": " ⧺ tokens.i64_str(incr_m.incr_fresh_count(&incr)) ⧺ "}")
        else:
            std.println("{}", "{\"decision\": \"incremental-fallback\", \"why\": \"" ⧺ why ⧺ "\"}")
    if #compiled.diags > 0:
        report(compiled.diags, &files, o.json, src)
        return 1
    if o.want_log:
        std.println("{}", "{\"decision\": \"optimize\", \"level\": " ⧺ tokens.i64_str(o.optimize) ⧺ "}")
        // what the checker worked out, then what the lowering did
        foreach l := chk.log:
            std.println("{}", l)
        foreach l := compiled.log:
            std.println("{}", l)

    let outf := std.fs.cwd().create_file(outname, 493)
    // one plan, and the class picks how wide its fields are written;
    // one run for each thing the file is made of, and the kernel
    // joins them, so nothing here ever holds the whole image
    // What came out is added by the plan, which is where the entry
    // point is known.
    // The room the two regions get is what code generation gave them
    // when it patched the addresses, not something worked out again
    // here: a second opinion about where .rodata begins is a second
    // chance to disagree with the instructions that name it.
    let pl := elf.plan_elf(&tgt, compiled.code, compiled.rodata, compiled.data,
                       o.stack_size × 1¤byte, compiled.relro_size × 1¤byte,
                       compiled.syms, bom, compiled.text_room, compiled.ro_room,
                       compiled.tx_ends)
    let runs : mut std.iovec[] = []
    if tgt.is64:
        let e := elf.elf_file64(pl, compiled.code, compiled.rodata, compiled.data)
        runs.push(std.iov(e.ehdr))
        runs.push(std.iov(e.phdrs))
        runs.push(std.iov(e.gap_text))
        runs.push(std.iov(e.code))
        runs.push(std.iov(e.gap_ro))
        runs.push(std.iov(e.rodata))
        runs.push(std.iov(e.gap_data))
        runs.push(std.iov(e.data))
        runs.push(std.iov(e.gap_sbom))
        runs.push(std.iov(e.sbom))
        runs.push(std.iov(e.sbomstr))
        runs.push(std.iov(e.gap_syms))
        runs.push(std.iov(e.syms))
        runs.push(std.iov(e.strtab))
        runs.push(std.iov(e.shstrtab))
        runs.push(std.iov(e.gap_shdrs))
        runs.push(std.iov(e.shdrs))
    else:
        let e := elf.elf_file32(pl, compiled.code, compiled.rodata, compiled.data)
        runs.push(std.iov(e.ehdr))
        runs.push(std.iov(e.phdrs))
        runs.push(std.iov(e.gap_text))
        runs.push(std.iov(e.code))
        runs.push(std.iov(e.gap_ro))
        runs.push(std.iov(e.rodata))
        runs.push(std.iov(e.gap_data))
        runs.push(std.iov(e.data))
        runs.push(std.iov(e.gap_sbom))
        runs.push(std.iov(e.sbom))
        runs.push(std.iov(e.sbomstr))
        runs.push(std.iov(e.gap_syms))
        runs.push(std.iov(e.syms))
        runs.push(std.iov(e.strtab))
        runs.push(std.iov(e.shstrtab))
        runs.push(std.iov(e.gap_shdrs))
        runs.push(std.iov(e.shdrs))
    outf.writev(runs)
    outf.close()
    0

@start
@impure
fn main() → u8:
    let argv := std.args.all()
    // --help is answered wherever it appears and before anything else
    // is judged, so that a command line with a mistake in it can still
    // be asked what it should have said.
    foreach a := argv:
        if a = "--help":
            help()
            return 0
    if #argv = 0:
        std.println("Usage: ngplc [OPTION...] SOURCE.ngpl...")
        std.println("   or: ngplc [OPTION...] --build RECIPE.ngpl")
        std.println("Try 'ngplc --help' for more information.")
        return 1
    let inputs : mut str[] = []
    let output : mut str = ""
    let build_file : mut str = ""
    let want_tokens : mut bool = false
    let want_ast : mut bool = false
    let werror : mut bool = false
    let want_log : mut bool = false
    let incremental : mut bool = false
    let json : mut bool = false
    let stack_size : mut i64 = elf.STACK_DEFAULT
    let guard_size : mut i64 = elf.GUARD_DEFAULT
    // aim at the machine underfoot unless --target says otherwise
    let tgt_index : mut i64 = elf.target_index(elf.host_target())
    let target_name : mut str = ""
    // What -O asked for, ⁻1 where it was not given.  The level the
    // compiler works at is 0 unless it says otherwise; the two are
    // told apart so that a recipe can be handed ∅ for "nothing said".
    let opt_level : mut i64 = ⁻1
    // what --path said, as it said it: a recipe is handed the whole
    // path rather than what the compiler made of it
    let path_raw : mut str = ""
    let i : mut i64 ¤ptrdiff = 0
    while i < #argv:
        let a := argv[i]
        if a = "-o":
            if i + 1 >= #argv:
                std.println("ngplc: -o requires the output file name after it")
                return 1
            output ← argv[i + 1]
            i ← i + 2
            continue
        if a = "--build":
            if i + 1 >= #argv:
                std.println("ngplc: --build requires the file holding the @build recipe after it")
                return 1
            build_file ← argv[i + 1]
            i ← i + 2
            continue
        if opt_matches(a, "--stack-size") or opt_matches(a, "--guard-size"):
            let is_stack : bool = opt_matches(a, "--stack-size")
            let which : str = if is_stack: "--stack-size" else: "--guard-size"
            let raw : str = opt_value(a, which)
            let v : i64 = parse_size(raw)
            if v = ⁻1:
                std.println("ngplc: {} wants a size, as 8388608 or 8M; '{}' is not one", which, raw)
                return 1
            if v < elf.PAGE or v > elf.SIZE_MAX_OPT:
                std.println("ngplc: {} runs from one page to a gibibyte; {} is outside it", which, tokens.i64_str(v))
                return 1
            if is_stack:
                stack_size ← elf.align_up(v, elf.PAGE)
            else:
                guard_size ← elf.align_up(v, elf.PAGE)
            i ← i + 1
            continue
        if opt_matches(a, "--path"):
            path_raw ← opt_value(a, "--path")
            i ← i + 1
            continue
        if opt_matches(a, "--target"):
            let tname : str = opt_value(a, "--target")
            let ti : i64 = elf.target_index(tname)
            if ti = ⁻1:
                std.println("ngplc: '{}' is not a target this compiler has; they are {}", tname, elf.target_names())
                return 1
            tgt_index ← ti
            // what --target said, as it said it: a recipe is handed the
            // word rather than what the compiler made of it
            target_name ← tname
            i ← i + 1
            continue
        if "-O" ⊑ a and a ≠ "-o":
            // -O alone is the first level, as every compiler has it;
            // -O and a number is that level, however far the levels
            // this compiler has yet reach.
            let raw : str = a[2¤ptrdiff…#a]
            let lv : i64 = if raw = "": 1 else: parse_level(raw)
            if lv = ⁻1:
                std.println("""ngplc: -O takes a level written after it, as -O2, or nothing at all
                             " for -O1; '{}' is not one""", a)
                return 1
            opt_level ← lv
            i ← i + 1
            continue
        if a = "--dump-tokens":
            want_tokens ← true
        elif a = "--dump-ast":
            want_ast ← true
        elif a = "--diag=json":
            json ← true
        elif a = "--log=json":
            want_log ← true
        elif a = "--incremental":
            incremental ← true
        elif a = "-Werror":
            werror ← true
        else:
            inputs.push(a)
        i ← i + 1
    // --build reads the source list from the recipe, so naming files
    // beside it would be saying two different things at once
    if build_file ≠ "" and #inputs > 0:
        std.println("""ngplc: --build reads the source list from the recipe; '{}' names a file
                     " besides""", inputs[0¤ptrdiff])
        return 1
    // The recipe is handed what the command line said, so it may act on
    // it; the compiler then applies -o to what the recipe added.
    let plan : comptime_m.Recipe = if build_file ≠ "": read_build(build_file, json, output, target_name, elf.host_target(), opt_level, path_raw) else: empty_recipe()
    if build_file ≠ "":
        if #plan.names = 0:
            std.println("""ngplc: the @build recipe in '{}' adds no executable, so there is nothing
                         " to build""", build_file)
            return 1
        if output ≠ "" and #plan.names > 1:
            std.println("""ngplc: -o names one file and this recipe adds {} of them; leave it out
                         " and each goes where the recipe says""", @dropunit(#plan.names))
            return 1
        foreach f := plan.flags:
            std.println("""ngplc: the build recipe asks for flag '{}', which this compiler does not
                         " have""", f)
            return 1
    if #inputs = 0 and build_file = "":
        std.println("ngplc: no source file named")
        return 1
    foreach nm := inputs:
        if not is_ngpl_source(nm):
            std.println("""ngplc: cannot tell what '{}' is: an NGPL source file's name ends in
                         " '.ngpl'""", nm)
            return 1

    // Every executable the recipe asked for, in the order it asked.
    // Without a recipe there is the one program the command line named.
    let opts : Options = Options{tgt_index: tgt_index, stack_size: stack_size,
                                 guard_size: guard_size,
                                 optimize: opt_level ⌈ 0,
                                 path: split_path(path_raw),
                                 want_tokens: want_tokens,
                                 want_ast: want_ast, want_log: want_log,
                                 werror: werror, json: json,
                                 incremental: incremental}
    if build_file = "":
        return compile_one(inputs, if output ≠ "": output else: "a.out", &opts)
    foreach i := 0¤ptrdiff…#plan.names:
        // What it is built for: what the executable named, else what
        // --target named, else the machine underfoot.
        let want : str = if plan.targets[i] ≠ "": plan.targets[i] else: target_name
        let ti : i64 = if want = "": tgt_index else: elf.target_index(want)
        if ti = ⁻1:
            std.println("ngplc: '{}' is not a target this compiler has; they are {}",
                        want, elf.target_names())
            return 1
        // Where it goes.  What a recipe names is named from where the
        // recipe is, as the file it is rooted in is, so a recipe means
        // the same thing from whatever directory it is run.  -o names
        // the file instead, and is named from where the compiler runs.
        let base : str = imports.dir_of(build_file)
        let dir : mut str = base
        if plan.outdirs[i] ≠ "":
            dir ← if "/" ⊑ plan.outdirs[i] or base = "": plan.outdirs[i] else: base ⧺ "/" ⧺ plan.outdirs[i]
        let named : str = if dir = "": plan.names[i] else: dir ⧺ "/" ⧺ plan.names[i]
        let where : str = if output ≠ "": output else: named
        // How hard the compiler is asked to work on this one: what the
        // executable said, else what -O said, which is 0 unless it did.
        let olv : i64 = if plan.optimizes[i] >= 0: plan.optimizes[i] else: opts.optimize
        let one : Options = Options{tgt_index: ti, stack_size: opts.stack_size,
                                    guard_size: opts.guard_size,
                                    optimize: olv,
                                    path: opts.path,
                                    want_tokens: opts.want_tokens,
                                    want_ast: opts.want_ast, want_log: opts.want_log,
                                    werror: opts.werror, json: opts.json,
                                    incremental: opts.incremental}
        let rc : u8 = compile_one([resolve_source(plan.roots[i], imports.dir_of(build_file), plan.paths)],
                                  where, &one)
        if rc ≠ 0:
            return rc
    0
