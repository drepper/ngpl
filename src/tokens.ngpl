
// ngplc -- the NGPL compiler, attempt 2.
//
// Written in the bootstrap subset of NGPL, and compiled by itself.  It
// compiles the core-2 subset described in DESIGN.md to static Linux ELF
// executables that speak only to the kernel, for six targets: x86-64,
// i386, aarch64, arm, riscv64 and riscv32.
//
// The compiler is twenty-five source files, read as if they were one
// and named in order by build/sources.sh and by the @build recipe in
// main.ngpl.  The order is part of the program: an enum and a unit must
// be declared before they are used.  Build it with
//
//     ngplc --build src/main.ngpl
//
// or, for the first stage, through the bootstrap interpreter, which
// takes the same list:
//
//     python -m interp <sources…> -- <sources…> -o build/ngplc
//
// The pipeline is a chain of pure functions over flat arrays:
//     bytes -> lex -> Toks -> parse -> Ast -> check -> lower -> Ir
//           -> emit -> code bytes -> elf -> a.out (or the -o name)
//
// Control flow policy (CLAUDE.md): decisions are data.  The lexer runs
// on a byte-class table and two glyph hashes rather than a branch
// tree; the code generator materializes comparisons (setcc), selects
// with conditional moves where both sides are safe to read, and turns
// dense dispatch into jump tables.  Branches that remain are cold
// paths (aborts) or semantically required (short-circuit with an
// effectful right side).
//
// This file holds the token kinds and the helpers over raw byte runs;
// what follows it is listed in build/sources.sh.

// ===========================================================================
// Token kinds
// ===========================================================================

@export
enum Tk : i64:
    none = ⁻1    // no token kind: what a table answers for nothing
    eof = 0
    nl = 1
    indent = 2
    dedent = 3
    ident = 10
    number = 11
    string = 12
    // keywords core-1 parses
    kw_fn = 20
    kw_let = 21
    kw_mut = 22
    kw_if = 23
    kw_elif = 24
    kw_else = 25
    kw_while = 26
    kw_foreach = 27
    kw_return = 28
    kw_break = 29
    kw_continue = 30
    kw_true = 31
    kw_false = 32
    kw_and = 33
    kw_or = 34
    kw_not = 35
    kw_struct = 36
    kw_impl = 37
    // punctuation and operators
    lpar = 40
    rpar = 41
    colon = 42
    comma = 43
    dot = 44
    arrow = 45    // → or ->
    assign = 46    // ← or <-
    define = 47    // :=
    ellipsis = 48    // …
    at = 49    // @
    plus = 50
    minus = 51    // binary -
    neg = 52    // unary ⁻
    mult = 53    // ×
    divide = 54    // ÷
    mod = 55
    eq = 56    // =
    ne = 57    // ≠
    lt = 58
    gt = 59
    le = 60
    ge = 61
    shl = 62    // « or <<
    shr = 63    // » or >>
    band = 64    // & (also the borrow marker)
    bor = 65
    bxor = 66
    bnot = 67    // ~
    land = 68    // ∧
    lor = 69    // ∨
    lnot = 70    // ¬
    max = 71    // ⌈
    min = 72    // ⌊
    coalesce = 73    // ??
    lbrack = 74
    rbrack = 75
    currency = 76    // ¤
    hash = 77    // #
    concat = 78    // ⧺
    lbrace = 79
    rbrace = 80
    qmark = 81    // ? as a type's suffix
    kw_some = 82    // ⊨
// The quantifiers.  f ∀ v asks whether f holds of every one of the
    // things v holds, f ∃ v whether it holds of any.
    forall = 107    // ∀
    exists = 108    // ∃
    notex = 109    // ∄
    // a runs along the front of b, or along its back
    prefix = 110    // ⊑
    suffix = 111    // ⊒
    empty = 83    // ∅
    lhash = 84    // ⸨
    rhash = 85    // ⸩
    elem = 86    // ∊
    iota = 87    // ⍳
    satadd = 88    // ⊞
    satsub = 89    // ⊟
    satmul = 90    // ⊠
    lxor = 91    // ⊕
    lnand = 92    // ⊼
    lnor = 93    // ⊽
    reshape = 94    // ⍴
    kw_match = 38
    reserved = 99    // a word the bootstrap reserves and core-1 does not use
    lambda = 100    // λ
    bang = 101    // ! -- the expected suffix on a type
    semi = 102    // ; -- between statements in a brace block
    kw_type = 103    // type: a name standing for a type
    kw_enum = 104    // enum
    kw_unit = 105    // unit: a measure the file gives a name

// The keyword table: one hash probe replaces a comparison ladder.  A
// word the bootstrap language reserves but core-1 gives no meaning is
// mapped to Tk.reserved, so it is refused wherever a name is expected
// rather than quietly accepted -- the strict-subset rule.
@export
let KEYWORDS : std.dict(str, Tk) = (⸨
    "fn": Tk.kw_fn, "let": Tk.kw_let, "mut": Tk.kw_mut, "if": Tk.kw_if, "elif": Tk.kw_elif, "else": Tk.kw_else,
    "while": Tk.kw_while, "foreach": Tk.kw_foreach, "return": Tk.kw_return, "break": Tk.kw_break, "continue": Tk.kw_continue,
    "true": Tk.kw_true, "false": Tk.kw_false, "and": Tk.kw_and, "or": Tk.kw_or, "not": Tk.kw_not,
    "struct": Tk.kw_struct, "impl": Tk.kw_impl, "match": Tk.kw_match,
    "opt": Tk.reserved, "is": Tk.reserved, "import": Tk.reserved, "some": Tk.reserved,
    "start": Tk.reserved, "test": Tk.reserved, "expect": Tk.reserved, "wrap": Tk.reserved, "enum": Tk.kw_enum,
    "flag": Tk.reserved, "replaceable": Tk.reserved, "catch": Tk.reserved, "comptime": Tk.reserved,
    "type": Tk.kw_type, "unit": Tk.kw_unit, "module": Tk.reserved, "impure": Tk.reserved, "enumerate": Tk.reserved,
    "macro": Tk.reserved⸩)

// The multi-byte glyphs, keyed by their UTF-8 bytes packed into one
// number: b0×256+b1 for two-byte glyphs, b0×65536+b1×256+b2 for three.
// One hash probe per glyph instead of a branch tree over byte values.
@export
let GLYPHS2 : std.dict(i64, Tk) = (⸨
    49835: Tk.shl,      // « shl
    49851: Tk.shr,      // » shr
    49836: Tk.lnot,      // ¬
    49828: Tk.currency,      // ¤
    50071: Tk.mult,      // ×
    50103: Tk.divide,      // ÷
    52923: Tk.lambda⸩)    // λ

@export
let GLYPHS3 : std.dict(i64, Tk) = (⸨
    14847411: Tk.iota,   // ⍳
    14847412: Tk.reshape,   // ⍴
    14846622: Tk.satadd,   // ⊞
    14846623: Tk.satsub,   // ⊟
    14846624: Tk.satmul,   // ⊠
    14846613: Tk.lxor,   // ⊕
    14846652: Tk.lnand,   // ⊼
    14846653: Tk.lnor,   // ⊽
    14845584: Tk.assign,   // ←
    14845586: Tk.arrow,   // →
    14844347: Tk.neg,   // ⁻
    14844070: Tk.ellipsis,   // …
    14846368: Tk.ne,   // ≠
    14846119: Tk.land,   // ∧
    14846120: Tk.lor,   // ∨
    14847112: Tk.max,   // ⌈
    14847114: Tk.min,   // ⌊
    14854074: Tk.concat,   // ⧺
    14846632: Tk.kw_some,   // ⊨
    14846080: Tk.forall,  // ∀
    14846083: Tk.exists,  // ∃
    14846084: Tk.notex,  // ∄
    14846609: Tk.prefix,  // ⊑
    14846610: Tk.suffix,  // ⊒
    14846085: Tk.empty,   // ∅
    14858408: Tk.lhash,   // ⸨
    14858409: Tk.rhash,   // ⸩
    14846090: Tk.elem⸩)  // ∊

// ===========================================================================
// Small helpers
// ===========================================================================

// Whether a string is the one wanted.  The wanted one comes first so
// that str_is(name) is a question about a single string, which is the
// shape ∀ and ∃ ask for.
@export
fn str_is(want : str, s : str) → bool:
    s = want

@export
@post(r: #r > 0)
fn i64_str(n : i64) → str:
    if n = 0: return "0"
    let neg : bool = n < 0
    // work below zero, where every i64 has a home; the remainders come
    // out non-positive and are flipped digit by digit
    let v : mut i64 = if neg: n else: @wrap(0 - n)
    let s : mut str = ""
    while v ≠ 0:
        let digit : i64 = @wrap(0 - (v % 10 ?? 0))
        s ← ('0' + digit) ⧺ s
        v ← (v ÷ 10 ?? 0)
    if neg: ("-" ⧺ s) else: s

// The text of a byte run, for identifiers, keywords and messages.
@export
@pre(off >= 0 and n >= 0)
fn run_str(src : byte[], off : i64, n : i64) → str:
    let s : mut str = ""
    foreach i := 0…n:
        let b : i64 = src[(off + i) × 1¤byte]
        s ← s ⧺ b.chr()
    s

