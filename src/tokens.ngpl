let TK_RESHAPE : i64 = 94    // ⍴
@export
let TK_MATCH : i64 = 38
@export
let TK_RESERVED : i64 = 99   // a word the bootstrap reserves and core-1 does not use
@export
let TK_LAMBDA : i64 = 100    // λ
@export
let TK_BANG : i64 = 101      // ! -- the expected suffix on a type
@export
let TK_SEMI : i64 = 102      // ; -- between statements in a brace block
@export
let TK_TYPE : i64 = 103      // type: a name standing for a type
@export
let TK_ENUM : i64 = 104      // enum
@export
let TK_UNIT : i64 = 105      // unit: a measure the file gives a name

// The keyword table: one hash probe replaces a comparison ladder.  A
// word the bootstrap language reserves but core-1 gives no meaning is
// mapped to TK_RESERVED, so it is refused wherever a name is expected
// rather than quietly accepted -- the strict-subset rule.
@export
let KEYWORDS : std.dict(str, i64) = (⸨
    "fn": 20, "let": 21, "mut": 22, "if": 23, "elif": 24, "else": 25,
    "while": 26, "foreach": 27, "return": 28, "break": 29, "continue": 30,
    "true": 31, "false": 32, "and": 33, "or": 34, "not": 35,
    "struct": 36, "impl": 37, "match": 38,
    "opt": 99, "is": 99, "import": 99, "some": 99,
    "start": 99, "test": 99, "expect": 99, "wrap": 99, "enum": 104,
    "flag": 99, "replaceable": 99, "catch": 99, "comptime": 99,
    "type": 103, "unit": 105, "module": 99, "impure": 99, "enumerate": 99,
    "macro": 99⸩)

// The multi-byte glyphs, keyed by their UTF-8 bytes packed into one
// number: b0×256+b1 for two-byte glyphs, b0×65536+b1×256+b2 for three.
// One hash probe per glyph instead of a branch tree over byte values.
@export
let GLYPHS2 : std.dict(i64, i64) = (⸨
    49835: 62,      // « shl
    49851: 63,      // » shr
    49836: 70,      // ¬
    49828: 76,      // ¤
    50071: 53,      // ×
    50103: 54,      // ÷
    52923: 100⸩)    // λ

@export
let GLYPHS3 : std.dict(i64, i64) = (⸨
    14847411: 87,   // ⍳
    14847412: 94,   // ⍴
    14846622: 88,   // ⊞
    14846623: 89,   // ⊟
    14846624: 90,   // ⊠
    14846613: 91,   // ⊕
    14846652: 92,   // ⊼
    14846653: 93,   // ⊽
    14845584: 46,   // ←
    14845586: 45,   // →
    14844347: 52,   // ⁻
    14844070: 48,   // …
    14846368: 57,   // ≠
    14846119: 68,   // ∧
    14846120: 69,   // ∨
    14847112: 71,   // ⌈
    14847114: 72,   // ⌊
    14854074: 78,   // ⧺
    14846632: 82,   // ⊨
    14846080: 107,  // ∀
    14846083: 108,  // ∃
    14846084: 109,  // ∄
    14846609: 110,  // ⊑
    14846610: 111,  // ⊒
    14846085: 83,   // ∅
    14858408: 84,   // ⸨
    14858409: 85,   // ⸩
    14846090: 86⸩)  // ∊

// ===========================================================================
// Small helpers
// ===========================================================================

// Whether a string is the one wanted.  The wanted one comes first so
// that str_is(name) is a question about a single string, which is the
// shape ∀ and ∃ ask for.
@export
fn str_is(want : str, s : str) → bool:
    s = want

@export
@post(r: #r > 0)
fn i64_str(n : i64) → str:
    if n = 0: return "0"
    let neg : bool = n < 0
    // work below zero, where every i64 has a home; the remainders come
    // out non-positive and are flipped digit by digit
    let v : mut i64 = if neg: n else: @wrap(0 - n)
    let s : mut str = ""
    while v ≠ 0:
        let digit : i64 = @wrap(0 - (v % 10 ?? 0))
        s ← ('0' + digit) ⧺ s
        v ← (v ÷ 10 ?? 0)
    if neg: ("-" ⧺ s) else: s

// The text of a byte run, for identifiers, keywords and messages.
@export
@pre(off >= 0 and n >= 0)
fn run_str(src : byte[], off : i64, n : i64) → str:
    let s : mut str = ""
    foreach i := 0…n:
        let b : i64 = src[(off + i) × 1¤byte]
        s ← s ⧺ b.chr()
    s

