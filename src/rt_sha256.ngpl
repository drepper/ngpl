// ===========================================================================
// SHA-256 as IR: one spelling, six machines
// ===========================================================================
//
// Every other runtime routine is written twice -- by hand for the
// pioneer in rt_x86_64.ngpl, as IR for the five in rt_portable.ngpl.
// This one is written once.  A hash is two hundred instructions of
// pure arithmetic with no calling convention and no kernel in it, so
// there is nothing for a hand-tuned version to know that the driver
// does not; writing it twice would only be two places to get FIPS
// 180-4 wrong.  x86-64 compiles this IR through emit_fn exactly as
// the other five compile it through t_emit_fn.
//
// It is the same algorithm sha256.ngpl spells in the language, and the
// conformance suite holds the two to one answer.  The compiler needs
// both: the digest it computes while running under the interpreter is
// the language one, and the digest the compiled compiler computes is
// this.
//
// The arithmetic is thirty-two bits wide and says so.  add32/shl32
// leave the driver's t_canon to narrow what the operation widened,
// which is exactly the `& 0xFFFFFFFF` the language version writes out
// by hand at every step -- so the IR is shorter than the source it
// mirrors, not longer.
//
// The numbers here are virtual register ids and label ids, which
// measure nothing; they carry no unit, as everywhere else the IR is
// built.

// x turned right by n places, at thirty-two bits.  What falls off the
// bottom comes back at the top, which a shift alone will not do.
@pre(n >= 1 and n <= 31)
fn sha_ir_rotr(b : &mut RtB, x : i64, n : i64) → i64:
    b.bor(b.shr32(x, b.cst(n)), b.shl32(x, b.cst(32 - n)))

// the message schedule's word at a computed index; `three` holds the
// shift that turns an index into a byte offset
fn sha_ir_w(b : &mut RtB, scr : i64, idx : i64, three : i64) → i64:
    b.ldn(b.add(scr, b.shl(idx, three)), 0, 8)

// The whole routine: (h) → the thirty-two bytes of the SHA-256 of the
// u8[] h, most significant first.  Its one argument is an array
// descriptor, so a string is turned into its bytes before the call.
fn rt_sha256_ir() → IrFn:
    let b : mut RtB = rtb(1)
    let slots : i64 = b.ldn(0, 0, 8)
    let n : i64 = b.ldn(0, 8, 8)

    // The padded length: the message, one set bit, then the length in
    // bits as eight bytes, rounded up to whole sixty-four-byte blocks.
    // Sixty-four is a power of two, so the rounding is a mask.
    let zero : i64 = b.cst(0)
    let one : i64 = b.cst(1)
    let two : i64 = b.cst(2)
    let three : i64 = b.cst(3)
    let seven : i64 = b.cst(7)
    let c8 : i64 = b.cst(8)
    let c16 : i64 = b.cst(16)
    let c64 : i64 = b.cst(64)
    let c128 : i64 = b.cst(128)
    let c255 : i64 = b.cst(255)
    let total : i64 = b.band(b.add(n, b.cst(72)), b.cst(⁻64))
    let msgbits : i64 = b.shl(n, three)
    let lenat : i64 = b.sub(total, c8)

    // One thousand and twenty-four bytes of scratch: the sixty-four
    // words of the message schedule, then the sixty-four round
    // constants.  The constants are laid down once per call rather
    // than once per block, and they come from the same sha_k() the
    // language version reads -- one table, not two.
    let scr : i64 = b.call1(RT_ALLOC, b.cst(1024))
    let kt : u32[] = sha_k()
    assert(@dropunit(#kt) = 64, "sixty-four round constants")
    foreach i := 0…63:
        b.stn(scr, 512 + i × 8, b.cst(kt[i × 1¤ptrdiff]), 8)

    // the eight words the digest is made of, carried across blocks
    let h0 : u32[] = sha_h0()
    assert(@dropunit(#h0) = 8, "eight starting words")
    let hs : mut i64[] = []
    foreach i := 0…7:
        let r : i64 = b.t()
        b.mov(r, b.cst(h0[i × 1¤ptrdiff]))
        hs.push(r)

    // the working registers, allocated once and re-read each block
    let va : i64 = b.t()
    let vb : i64 = b.t()
    let vc : i64 = b.t()
    let vd : i64 = b.t()
    let ve : i64 = b.t()
    let vf : i64 = b.t()
    let vg : i64 = b.t()
    let vh : i64 = b.t()

    let blk : i64 = b.t()
    let bi : i64 = b.t()
    let acc : i64 = b.t()
    let j : i64 = b.t()
    let t : i64 = b.t()

    b.mov(blk, zero)
    let lblk : i64 = b.l()
    let lblke : i64 = b.l()
    b.lab(lblk)
    b.jz(b.cltu(blk, total), lblke)

    // -----------------------------------------------------------------
    // the block's first sixteen words, from the padded message
    // -----------------------------------------------------------------
    //
    // A byte at a time, shifted into an accumulator that is written to
    // its word every time.  The word index only advances every fourth
    // byte, and the accumulator is thirty-two bits, so the store that
    // lands last on a word is the one carrying that word's four bytes:
    // the three before it wrote a value that is overwritten, and no
    // branch is needed to tell them apart.
    b.mov(bi, zero)
    b.mov(acc, zero)
    let lbt : i64 = b.l()
    let lbe : i64 = b.l()
    b.lab(lbt)
    b.jz(b.cltu(bi, c64), lbe)
    let off : i64 = b.add(blk, bi)
    // Which of the four things the padded message says here, computed
    // rather than branched to.  The message's own bytes come first,
    // then the one set bit, then the length, and zeros between.  The
    // address read from is steered to the scratch when the offset is
    // past the message, so nothing is read that was not allocated.
    let inmsg : i64 = b.cltu(off, n)
    let isone : i64 = b.ceq(off, n)
    let inlen : i64 = b.cgeu(off, lenat)
    let at : i64 = b.sel(inmsg, b.add(slots, b.shl(off, three)), scr)
    let mbyte : i64 = b.band(b.ldn(at, 0, 8), c255)
    // the length's bytes run most significant first; the shift is
    // steered away from a negative count the same way
    let k9 : i64 = b.sel(inlen, b.sub(off, lenat), zero)
    let lbyte : i64 = b.band(b.shr(msgbits, b.shl(b.sub(seven, k9), three)), c255)
    let v : i64 = b.sel(inmsg, mbyte, b.sel(isone, c128, b.sel(inlen, lbyte, zero)))
    b.mov(acc, b.bor(b.shl32(acc, c8), v))
    b.stn(b.add(scr, b.shl(b.shr(bi, two), three)), 0, acc, 8)
    b.mov(bi, b.add(bi, one))
    b.jmp(lbt)
    b.lab(lbe)

    // -----------------------------------------------------------------
    // and the other forty-eight, worked out from those
    // -----------------------------------------------------------------
    b.mov(j, c16)
    let ljt : i64 = b.l()
    let lje : i64 = b.l()
    b.lab(ljt)
    b.jz(b.cltu(j, c64), lje)
    let a15 : i64 = sha_ir_w(&b, scr, b.sub(j, b.cst(15)), three)
    let a2 : i64 = sha_ir_w(&b, scr, b.sub(j, two), three)
    let s0 : i64 = b.bxor(b.bxor(sha_ir_rotr(&b, a15, 7), sha_ir_rotr(&b, a15, 18)),
                          b.shr32(a15, three))
    let s1 : i64 = b.bxor(b.bxor(sha_ir_rotr(&b, a2, 17), sha_ir_rotr(&b, a2, 19)),
                          b.shr32(a2, b.cst(10)))
    let w16 : i64 = sha_ir_w(&b, scr, b.sub(j, c16), three)
    let w7 : i64 = sha_ir_w(&b, scr, b.sub(j, seven), three)
    let nw : i64 = b.add32(b.add32(b.add32(w16, s0), w7), s1)
    b.stn(b.add(scr, b.shl(j, three)), 0, nw, 8)
    b.mov(j, b.add(j, one))
    b.jmp(ljt)
    b.lab(lje)

    // -----------------------------------------------------------------
    // the sixty-four rounds
    // -----------------------------------------------------------------
    b.mov(va, hs[0 × 1¤ptrdiff])
    b.mov(vb, hs[1 × 1¤ptrdiff])
    b.mov(vc, hs[2 × 1¤ptrdiff])
    b.mov(vd, hs[3 × 1¤ptrdiff])
    b.mov(ve, hs[4 × 1¤ptrdiff])
    b.mov(vf, hs[5 × 1¤ptrdiff])
    b.mov(vg, hs[6 × 1¤ptrdiff])
    b.mov(vh, hs[7 × 1¤ptrdiff])
    b.mov(t, zero)
    let ltt : i64 = b.l()
    let lte : i64 = b.l()
    b.lab(ltt)
    b.jz(b.cltu(t, c64), lte)
    let toff : i64 = b.shl(t, three)
    let big1 : i64 = b.bxor(b.bxor(sha_ir_rotr(&b, ve, 6), sha_ir_rotr(&b, ve, 11)),
                            sha_ir_rotr(&b, ve, 25))
    let ch : i64 = b.bxor(b.band(ve, vf), b.band(b.bnot32(ve), vg))
    let kv : i64 = b.ldn(b.add(scr, toff), 512, 8)
    let wv : i64 = b.ldn(b.add(scr, toff), 0, 8)
    let t1 : i64 = b.add32(b.add32(b.add32(b.add32(vh, big1), ch), kv), wv)
    let big0 : i64 = b.bxor(b.bxor(sha_ir_rotr(&b, va, 2), sha_ir_rotr(&b, va, 13)),
                            sha_ir_rotr(&b, va, 22))
    let maj : i64 = b.bxor(b.bxor(b.band(va, vb), b.band(va, vc)), b.band(vb, vc))
    let t2 : i64 = b.add32(big0, maj)
    // each value moves down one place; the two that are computed read
    // what they need before the move that would overwrite it
    b.mov(vh, vg)
    b.mov(vg, vf)
    b.mov(vf, ve)
    b.mov(ve, b.add32(vd, t1))
    b.mov(vd, vc)
    b.mov(vc, vb)
    b.mov(vb, va)
    b.mov(va, b.add32(t1, t2))
    b.mov(t, b.add(t, one))
    b.jmp(ltt)
    b.lab(lte)

    b.mov(hs[0 × 1¤ptrdiff], b.add32(hs[0 × 1¤ptrdiff], va))
    b.mov(hs[1 × 1¤ptrdiff], b.add32(hs[1 × 1¤ptrdiff], vb))
    b.mov(hs[2 × 1¤ptrdiff], b.add32(hs[2 × 1¤ptrdiff], vc))
    b.mov(hs[3 × 1¤ptrdiff], b.add32(hs[3 × 1¤ptrdiff], vd))
    b.mov(hs[4 × 1¤ptrdiff], b.add32(hs[4 × 1¤ptrdiff], ve))
    b.mov(hs[5 × 1¤ptrdiff], b.add32(hs[5 × 1¤ptrdiff], vf))
    b.mov(hs[6 × 1¤ptrdiff], b.add32(hs[6 × 1¤ptrdiff], vg))
    b.mov(hs[7 × 1¤ptrdiff], b.add32(hs[7 × 1¤ptrdiff], vh))
    b.mov(blk, b.add(blk, c64))
    b.jmp(lblk)
    b.lab(lblke)

    // the eight words as thirty-two bytes, most significant first
    let out : i64 = b.call1(RT_ARRNEW, b.cst(32))
    let shifts : i64[] = [24, 16, 8, 0]
    foreach i := 0…7:
        foreach s := shifts:
            _ ← b.call2(RT_ARRPUSH, out,
                        b.band(b.shr32(hs[i × 1¤ptrdiff], b.cst(s)), c255))
    b.ret(out)
    rtb_fn(b)
