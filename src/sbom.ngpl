// ===========================================================================
// The bill of materials: what a program was built from
// ===========================================================================
//
// A binary that cannot say what it was made of has to be taken on
// trust.  This writes the answer into the file: the compiler, each
// source, the sources together, and the program itself, each named and
// each with a SHA-256 beside it.
//
// The source hashes are over the *tokens*, not the text.  A comment
// added, a line rewrapped, `->` written where `→` was: none of those
// change what the program is, and a hash that moved for them would say
// two builds differ when they do not.  What the lexer kept is exactly
// what the program is, so that is what is hashed.

let ast := @import("ast")
let diag := @import("diag")
let lex := @import("lex")
let sha256 := @import("sha256")
let tokens := @import("tokens")

// What a row is about.  A fixed representation, since these are read
// out of a file by whoever wants to know.


@export
enum Sbomkind : u32:
    compiler         // which compiler built it
    source           // one of the sources it was built from
    sources          // all of them together, in the order they were read
    output           // the program itself
    // Appended rather than slotted in beside `source`, because the
    // numbers are a wire format: a bill is read out of a file by
    // whoever wants to know, and renumbering what they already read
    // would be a worse thing than an odd order here.
    function         // one function, over the tokens it is written in

// A row before it is laid out: the strings still strings.
@export
struct SbomRow:
    kind : Sbomkind
    name : str
    hash : str

// What this compiler calls itself.  A build records which compiler made
// it, and this is that name; it is a constant so that two builds of the
// same program by the same compiler agree, which is what a bill of
// materials is for.
@export
fn sbom_compiler_name() → str:
    "ngplc core-2"

// ---------------------------------------------------------------------------
// Hashing what the program is, rather than how it was typed
// ---------------------------------------------------------------------------

// How much of the message is held before it is handed to the digests.
// Large enough that the handing over is not what costs, small enough
// that it is nothing beside the sources themselves.
let SBOM_CHUNK : i64 ¤byte = 65536


// ---------------------------------------------------------------------------
// The same program, however it was laid out
// ---------------------------------------------------------------------------
//
// A block can be written two ways -- indented, or in braces with
// semicolons between the statements -- and they are the same program.
// So are one statement to a line and several.  A hash that moved for
// any of that would say two builds differ when they do not, which is
// the one thing a bill of materials must not do.
//
// The three pairs that say the same thing are folded onto one code
// each: a block opens, a block closes, a statement ends.  What is left
// is the shape, which does differ between programs that differ.
//
// The separator needs more than folding, because the two ways of
// writing a block put them in different places.  Layout writes a
// newline before the indent and before the dedent, where braces write
// none; and a dedent is followed straight away by the next statement,
// where a closing brace needs a newline after it, because the dedent
// ended the statement and the brace did not.
//
// So a separator is held rather than written, and written only when
// what follows is not a block edge and what preceded was not one
// either.  A block edge already says a statement ended, and a run of
// blank lines says nothing at all.
//
// The colon needs the same treatment, and for the same reason: the
// laid-out form opens its block with one where the braced form opens
// with the brace alone.  A colon that opens a block is therefore not
// written down; every other colon -- a type's, a field's, a match
// arm's -- is a colon and says so.

let TC_OPEN : i64 = 1        // an indent, or {
let TC_CLOSE : i64 = 2       // a dedent, or }
let TC_SEP : i64 = 3         // a newline, or ;

// Whether the colon at `i` is the one opening a laid-out block, which
// is the case exactly when what follows it, past the newlines, is an
// indent.  A colon before anything else -- a type, a field's type, the
// statement of a one-line block -- is written down like any token.
fn colon_opens(t : lex.Toks, i : i64 ¤ptrdiff) → bool:
    let n : i64 ¤ptrdiff = #t.kind
    let j : mut i64 ¤ptrdiff = i + 1¤ptrdiff
    while j < n and t.kind[j] = tokens.Tk.nl:
        j ← j + 1¤ptrdiff
    j < n and t.kind[j] = tokens.Tk.indent

@post(r: r >= 0)
fn canon_kind(k : tokens.Tk) → i64:
    match k:
        tokens.Tk.indent, tokens.Tk.lbrace: TC_OPEN
        tokens.Tk.dedent, tokens.Tk.rbrace: TC_CLOSE
        tokens.Tk.nl, tokens.Tk.semi: TC_SEP
        // the rest keep their own kind, moved past the three codes above
        _: k.ord() + 8

// The bytes a token contributes: what kind it is, and what it says.
// Layout contributes nothing, and neither does a comment, since the
// lexer kept neither.  A number is written out in decimal rather than
// as it was spelled, so 0x10 and 16 hash alike if the lexer read them
// alike.
fn token_bytes(t : lex.Toks, src : byte[], i : i64 ¤ptrdiff, into : &mut u8[]):
    let k0 : tokens.Tk = t.kind[i]
    let k : i64 = canon_kind(k0)
    into.push(k & 255)
    into.push((k » 8) & 255)
    if k0 = tokens.Tk.ident or k0 = tokens.Tk.number or k0 = tokens.Tk.string:
        // an identifier and a string say their text; a number says the
        // value the lexer read, and whether it needed all sixty-four
        // bits to hold it
        let what : str = if k0 = tokens.Tk.string: t.strs[t.val[i] × 1¤ptrdiff] else: (if k0 = tokens.Tk.number: tokens.i64_str(t.val[i]) else: tokens.run_str(src, t.off[i], t.len[i]))
        foreach b := std.bytes(what):
            into.push(b)
        if k0 = tokens.Tk.number:
            into.push(t.big[i] & 255)
    into.push(0)

// One token into the message, with the separator rule above applied.
// `held` says a separator is waiting; `prev` is the last code written,
// so that a separator just inside a block opening is dropped as one
// just before a closing is.  Both are answered back.
fn feed_token(c : i64, ready : u8[], held : i64, prev : i64,
              into : &mut u8[]) → (i64, i64):
    if c = TC_SEP:
        return (1, prev)
    let edge : bool = c = TC_OPEN or c = TC_CLOSE
    let after : bool = prev = TC_OPEN or prev = TC_CLOSE or prev = 0
    if held = 1 and not edge and not after:
        into.push(TC_SEP)
        into.push(0)
        into.push(0)
    foreach b := ready:
        into.push(b)
    (0, c)

// The rows a program's sources make: one for each file, in the order
// they were read, and one for all of them together.
//
// One pass, and no array of the message.  The tokens are in the order
// they were read, so the file a token belongs to only ever moves
// forward, and two digests are fed as they go by: this file's, and
// every file's together.  Gathering the message first would mean
// holding a quarter of a million tokens' worth of bytes for this
// compiler alone, and then copying all of it again for each file to
// build the digest of them together -- which is what this used to do.
// A handle is fed a chunk at a time instead, so what is held is
// SBOM_CHUNK and never the message.
// `live` says which functions the build is writing: a bill names what
// the binary is made of, and a function nothing reached is not in it.
@export
fn sbom_sources(a : ast.Ast, t : lex.Toks, src : byte[], files : diag.Files,
                live : bool[]) → SbomRow[]:
    let rows : mut SbomRow[] = []
    let nf : i64 ¤ptrdiff = #files.names
    let ntok : i64 ¤ptrdiff = #t.kind
    let total : i64 ¤byte = #src
    let whole : mut = std.hash.sha256.start()
    let one : mut = std.hash.sha256.start()
    let feed : mut u8[] = []
    let fi : mut i64 ¤ptrdiff = 0
    let hi : mut i64 ¤byte = if nf > 1: files.off[1¤ptrdiff] else: total
    let held : mut i64 = 0
    let prev : mut i64 = 0
    // and the function the token falls in, if any: the definitions are
    // in the order they were parsed, which is the order of the tokens,
    // so this only ever moves forward
    let fnrows : mut SbomRow[] = []
    let fnh : mut = std.hash.sha256.start()
    let ffeed : mut u8[] = []
    let fheld : mut i64 = 0
    let fprev : mut i64 = 0
    let fopen : mut bool = false
    let fend : mut i64 = ⁻1
    let fnext : mut i64 ¤ptrdiff = 0
    let nfn : i64 ¤ptrdiff = #a.fns
    let ready : mut u8[] = []
    foreach i := 0…ntok:
        let at : i64 ¤byte = t.off[i]
        while at >= hi and fi + 1 < nf:
            one.update(feed)
            whole.update(feed)
            feed ← []
            rows.push(SbomRow{kind: Sbomkind.source, name: files.names[fi],
                              hash: sha256.hex_digest(one.digest())})
            one ← std.hash.sha256.start()
            fi ← fi + 1
            hi ← if fi + 1 < nf: files.off[fi + 1¤ptrdiff] else: total
        // a function begins here?
        while fnext < nfn and a.fns[fnext].tok_lo × 1¤ptrdiff <= i:
            if a.fns[fnext].tok_hi × 1¤ptrdiff > i and not fopen:
                fnh ← std.hash.sha256.start()
                ffeed ← []
                fheld ← 0
                fprev ← 0
                fopen ← true
                fend ← a.fns[fnext].tok_hi
                fnext ← fnext + 1¤ptrdiff
            else:
                fnext ← fnext + 1¤ptrdiff
        // the token's own bytes, read once however many digests want them
        let opener : bool = t.kind[i] = tokens.Tk.colon and colon_opens(t, i)
        let c : i64 = if opener: TC_SEP else: canon_kind(t.kind[i])
        ready ← []
        if c ≠ TC_SEP:
            token_bytes(t, src, i, &ready)
        let (h2, p2) : (i64, i64) = feed_token(c, ready, held, prev, &feed)
        held ← h2
        prev ← p2
        if fopen:
            let (h3, p3) : (i64, i64) = feed_token(c, ready, fheld, fprev, &ffeed)
            fheld ← h3
            fprev ← p3
            if i + 1¤ptrdiff >= fend × 1¤ptrdiff:
                fnh.update(ffeed)
                ffeed ← []
                let d := a.fns[fnext - 1¤ptrdiff]
                let nm : str = if d.modname = "": d.name else: d.modname ⧺ "." ⧺ d.name
                if live[(fnext - 1¤ptrdiff)]:
                    fnrows.push(SbomRow{kind: Sbomkind.function, name: nm,
                                        hash: sha256.hex_digest(fnh.digest())})
                fopen ← false
            elif #ffeed >= SBOM_CHUNK:
                fnh.update(ffeed)
                ffeed ← []
        if #feed >= SBOM_CHUNK:
            one.update(feed)
            whole.update(feed)
            feed ← []
    one.update(feed)
    whole.update(feed)
    rows.push(SbomRow{kind: Sbomkind.source, name: files.names[fi],
                      hash: sha256.hex_digest(one.digest())})
    rows.push(SbomRow{kind: Sbomkind.sources, name: "",
                      hash: sha256.hex_digest(whole.digest())})
    foreach r := fnrows:
        rows.push(r)
    rows
