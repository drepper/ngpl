// ===========================================================================
// Compile-time evaluation: reading the @build recipe
// ===========================================================================
//
// A recipe is a program that runs while the program is being built.
// This runs it, over a subset: integers, truth values, strings, arrays
// of strings; let and ←; if, while, foreach; calls to the functions the
// file defines; and std.build, which is the point of the exercise.
//
// Two passes, and the first is the one that matters.  The recipe is the
// one function the checker never walks, so nothing has looked at its
// body before now -- and the interpreter's purity check reads a whole
// body, taken branches and untaken alike, refusing a pure function that
// so much as mentions std.println.  An evaluator that only walked the
// branch it took would let `if false: std.println(…)` through, and the
// interpreter would then refuse the program the compiler accepted.  So
// ev_scan walks every node and refuses every construct outside the
// subset before anything runs.
//
// This is where the compiler's compile-time evaluation begins; @build
// is its first customer.

let ast := @import("./ast.ngpl")
let diag := @import("./diag.ngpl")
let lex := @import("./lex.ngpl")
let tokens := @import("./tokens.ngpl")
let types := @import("./types.ngpl")

// what a recipe computed with


let CV_NONE : i64 = 0       // what a declaration answers
let CV_INT : i64 = 1
let CV_BOOL : i64 = 2       // n is 0 or 1
let CV_STR : i64 = 3
let CV_ARR : i64 = 4        // str[]: n where it starts in the pool, m how many
let CV_BUILD : i64 = 5      // the std.Build a recipe was handed
let CV_EXE : i64 = 6        // std.Build.Executable{…}: n indexes the configs
let CV_OPTS : i64 = 7       // the std.Options a recipe reads the command line from

// A value the recipe made.  Everything it may hold is a number, a truth
// value, a string or a run of strings, so one struct with a tag says all
// of it; a run lives in the evaluator's pool and is named here by where
// it starts.  A CVal is never changed once made, so handing one on can
// never alias.
struct CVal:
    tag : i64
    n : i64
    m : i64
    s : str

fn cv_none() → CVal:
    (CVal{tag: CV_NONE, n: 0, m: 0, s: ""})

fn cv_int(v : i64) → CVal:
    (CVal{tag: CV_INT, n: v, m: 0, s: ""})

fn cv_bool(b : bool) → CVal:
    (CVal{tag: CV_BOOL, n: if b: 1 else: 0, m: 0, s: ""})

fn cv_str(t : str) → CVal:
    (CVal{tag: CV_STR, n: 0, m: 0, s: t})

// how a statement left off, carried outward by one comparison
let EV_NORM : i64 = 0
let EV_BREAK : i64 = 1
let EV_CONT : i64 = 2
let EV_RET : i64 = 3
let EV_STOP : i64 = 4       // a diagnostic was raised; everything unwinds

// What a recipe may do before it is called a mistake rather than a
// program.  A recipe names files: this compiler's own uses a few
// hundred steps, so the room here is some hundreds of times over.
// The ceiling is not set higher because reaching it is how a recipe
// that loops is reported, and stage 1 runs this compiler under the
// interpreter, where every step costs a great deal -- a budget of
// millions turns a mistake in a recipe into a wait of minutes.
let EV_STEPS : i64 = 100000
let EV_DEPTH : i64 = 64

// What the recipe said, answered together with whatever went wrong
// saying it -- the shape every phase here has.  One entry per
// executable it added, in the order it added them: what the output is
// called, the file it is rooted in, the directory it goes in, and what
// it is built for -- the last empty where the recipe left it to the
// command line.
@export
struct Recipe:
    names : str[]
    roots : str[]
    outdirs : str[]
    targets : str[]
    // the level each is built at, ⁻1 where the executable said nothing
    // and what -O said stands
    optimizes : i64[]
    paths : str[]
    flags : str[]
    diags : diag.Diag[]

struct Cev:
    a : ast.Ast
    toks : lex.Toks
    src : byte[]
    gvals : i64[]           // what the checker folded each global to,
                            // empty where it has not run
    names : str[]           // the bindings in scope, innermost last
    vals : CVal[]           // … and what each one holds
    vmut : i64[]            // … 1 where ← may write to it
    marks : i64[]           // where each open scope began
    floor : i64             // a called function sees nothing below this
    pool : str[]            // the elements of every array value, one arena
    // Every std.Build.Executable the recipe has written down, whether
    // or not it has been added: a config is a value, and the four
    // strings it holds are kept side by side, as everything here is.
    cfg_name : str[]
    cfg_root : str[]
    cfg_outd : str[]
    cfg_tgt : str[]
    cfg_opt : i64[]
    // …and which of them were added, in the order they were added
    added : i64[]
    // what the command line said, which the std.Options answers: the
    // empty string is how the rest of the compiler carries "nothing
    // said" of the two names, and ⁻1 how it carries it of the level;
    // each becomes the ∅ a recipe reads
    opt_output : str
    opt_target : str
    opt_path : str
    opt_optimize : i64
    outd : str              // b.output_dir: where an output that names none goes
    host : str              // b.host_target: what this compiler builds for by default
    paths : str[]
    flags : str[]
    steps : i64             // what is left of the budget
    depth : i64             // how deep the calls stand
    ret : CVal              // what a return carried
    diags : diag.Diag[]

// how a construct a recipe may not use is spelled, so the complaint
// names what was written rather than a node number
fn ev_spell(k : i64) → str:
    if k = ast.NK_MCALL: return "a method call"
    if k = ast.NK_HLIT: return "a dictionary literal"
    if k = ast.NK_SLIT: return "a struct literal"
    if k = ast.NK_FIELD: return "a field"
    if k = ast.NK_TUPLE: return "a tuple"
    if k = ast.NK_LAMBDA or k = ast.NK_BADLAM: return "a λ"
    if k = ast.NK_FNVAL or k = ast.NK_CALLV: return "a function value"
    if k = ast.NK_SOME or k = ast.NK_TRY: return "an optional"
    if k = ast.NK_MATCH or k = ast.NK_MATCHE: return "a match"
    if k = ast.NK_REF: return "a borrow"
    if k = ast.NK_SLICE or k = ast.NK_MSLICE: return "a slice"
    if k = ast.NK_RESHAPE: return "a reshape"
    if k = ast.NK_IOTA or k = ast.NK_ELEMOF: return "a search"
    if k = ast.NK_SATADD or k = ast.NK_SATSUB or k = ast.NK_SATMUL: return "saturating arithmetic"
    if k = ast.NK_SHL or k = ast.NK_SHR or k = ast.NK_BAND or k = ast.NK_BOR or k = ast.NK_BXOR or k = ast.NK_BNOT: return "a bit operation"
    if k = ast.NK_LAND or k = ast.NK_LOR or k = ast.NK_LXOR or k = ast.NK_LNAND or k = ast.NK_LNOR: return "an eager logical operation"
    if k = ast.NK_MAXOP or k = ast.NK_MINOP: return "⌈ or ⌊"
    if k = ast.NK_WRAP: return "@wrap"
    if k = ast.NK_TYPEOF or k = ast.NK_SIZEOF: return "@typeof or @sizeof"
    if k = ast.NK_RANGEV: return "a range as a value"
    if k = ast.NK_WHILEB: return "while with a binding"
    if k = ast.NK_LETT: return "a tuple binding"
    if k = ast.NK_STOREFLD or k = ast.NK_STOREIDXP: return "a write through a path"
    if k = ast.NK_EXPECTS: return "@expect"
    if k = ast.NK_HINTED: return "@likely or @unlikely"
    "that"

// how a std member a recipe may not reach is spelled
fn sb_spell(sb : i64) → str:
    if sb = ast.SB_PRINTLN or sb = ast.SB_PRINT: return "std.println"
    if sb = ast.SB_EXIT: return "std.exit"
    if sb = ast.SB_ARGS: return "std.args"
    if sb = ast.SB_OPEN or sb = ast.SB_CREATE or sb = ast.SB_CWD: return "std.fs"
    if sb = ast.SB_ALLOCATOR: return "std.arena"
    if sb = ast.SB_BYTES or sb = ast.SB_IOV: return "std.bytes"
    if sb = ast.SB_ENVN or sb = ast.SB_ENVG or sb = ast.SB_ENVH: return "std.env"
    if sb = ast.SB_PROC: return "std.process"
    if sb = ast.SB_HDIGEST or sb = ast.SB_HSTART: return "std.hash"
    "that"

// what a recipe holds, said once and quoted wherever it is refused
fn ev_subset() → str:
    """a recipe binds names, tests them, loops, joins strings, reads what the command line said
     " with ??, and calls the functions this file defines"""

// a node with nothing under it
fn ev_is_leaf(k : i64) → bool:
    if k = ast.NK_INT or k = ast.NK_BOOL or k = ast.NK_STR or k = ast.NK_EMPTYV: return true
    k = ast.NK_VAR or k = ast.NK_BREAK or k = ast.NK_CONTINUE

// How many of na, nb and nc hold a child, for the nodes that keep them
// there; 0 says the node is not part of the subset.  The count has to
// be exact rather than "walk all three": a let keeps its mutability in
// nb and its type in nc, and either read as a node id sends the walk
// somewhere else in the tree entirely.
fn ev_nchildren(k : i64) → i64:
    if k = ast.NK_LEN or k = ast.NK_NEG or k = ast.NK_NOT or k = ast.NK_DROPU: return 1
    if k = ast.NK_RETURN or k = ast.NK_DISCARD or k = ast.NK_EXPRSTMT: return 1
    if k = ast.NK_LET or k = ast.NK_ASSIGN: return 1
    if k = ast.NK_INDEX or k = ast.NK_CCAT or k = ast.NK_DEFAULT: return 2
    if k >= ast.NK_ADD and k <= ast.NK_MOD: return 2
    if k >= ast.NK_EQ and k <= ast.NK_OR: return 2
    if k = ast.NK_WHILE or k = ast.NK_FOREACHA: return 2
    if k = ast.NK_IF: return 3
    0

// which orderings each comparison admits, indexed by NK_EQ…NK_GE:
// less is 1, equal is 2, greater is 4.  One subtraction and a mask
// answers all six, over integers, strings and truth values alike.
fn ev_cmp_admits() → i64[]:
    [2, 5, 1, 3, 4, 6]

impl Cev:
    fn derr(&mut self, tok : i64, m : str):
        let at : i64 ¤ptrdiff = tok
        self.diags.push(diag.Diag{line: self.toks.line[at],
                             col: self.toks.col[at], msg: m, level: diag.DIAG_ERROR, code: diag.DIAG_NONE})

    // One diagnostic ends the recipe.  Unlike the parser and the
    // checker, which recover and go on, a recipe that has gone wrong
    // computes on values that were never made, so everything after the
    // first complaint would be noise.
    fn halted(&self) → bool:
        #self.diags > 0

    fn text(&self, tok : i64) → str:
        tokens.run_str(self.src, self.toks.off[tok × 1¤ptrdiff],
                self.toks.len[tok × 1¤ptrdiff])

    // -------------------------------------------------------------------
    // Pass one: what the recipe may contain, settled for every branch
    // -------------------------------------------------------------------

    fn ev_scan(&mut self, id : i64):
        if id = ⁻1 or self.halted():
            return
        let k : i64 = self.a.nkind[id × 1¤ptrdiff]
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        // A character literal is an int node the lexer marked, and the
        // evaluator holds no characters -- a recipe that wrote one
        // would be handed its code point here and a character by the
        // interpreter, which is two different programs.  So it is
        // refused by name, as everything else outside the subset is.
        if k = ast.NK_INT and nb >= 2 and (nb » 1) = types.TY_CHAR:
            self.derr(tok, "a character is not part of a build recipe; " ⧺ ev_subset())
            return
        if ev_is_leaf(k):
            return
        if k = ast.NK_ARRLIT or k = ast.NK_CALL:
            if k = ast.NK_CALL:
                self.scan_callee(tok)
                if self.halted():
                    return
            self.scan_list(na)
            return
        if k = ast.NK_SCALL:
            self.derr(tok, sb_spell(na) ⧺ " is not part of a build recipe; " ⧺ ev_subset())
            return
        if k = ast.NK_SLIT:
            // the build system's own struct is a recipe's to write; a
            // program's struct is not, since a recipe holds no program
            if nb ≠ ast.SLIT_EXE:
                self.derr(tok, "a struct literal is not part of a build recipe; " ⧺ ev_subset())
                return
            let nf : i64 = self.a.extra[na × 1¤"aextra"]
            foreach i := 0…nf:
                self.ev_scan(self.a.extra[(na + 2 + i × 2) × 1¤"aextra"])
            return
        if k = ast.NK_MCALL:
            // what a recipe says to the build it was handed; whether the
            // receiver really is one is settled where it has a value
            self.ev_scan(na)
            self.scan_list(nb)
            return
        if k = ast.NK_FIELD:
            self.ev_scan(na)
            return
        if k = ast.NK_STOREFLD:
            // a write to what the build holds; that the thing written
            // into is a build is settled where it has a value
            self.ev_scan(na)
            self.ev_scan(nb)
            return
        if k = ast.NK_BLOCK:
            self.scan_list(na)
            return
        if k = ast.NK_FOREACH:
            self.ev_scan(self.a.extra[na × 1¤ptrdiff])
            self.ev_scan(self.a.extra[(na + 1) × 1¤ptrdiff])
            self.ev_scan(self.a.extra[(na + 2) × 1¤ptrdiff])
            self.ev_scan(nb)
            return
        // everything left that is admitted keeps its children in na,
        // nb and nc, as many of them as the node has
        let nch : i64 = ev_nchildren(k)
        if nch > 0:
            self.ev_scan(na)
            if nch >= 2:
                self.ev_scan(nb)
            if nch >= 3:
                self.ev_scan(nc)
            return
        self.derr(tok, ev_spell(k) ⧺ " is not part of a build recipe; " ⧺ ev_subset())

    fn scan_list(&mut self, off : i64):
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            if self.halted():
                return
            self.ev_scan(self.a.extra[(off + 1 + i) × 1¤ptrdiff])

    // A recipe calls only what is effect-free: an @impure callee would
    // put std.println back within reach through the side door, and with
    // it the divergence pass one exists to close.
    fn scan_callee(&mut self, tok : i64):
        let name : str = self.text(tok)
        let f : i64 = self.fn_index(name)
        if f = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ """' is not a function this file defines; a build recipe
                                         " reaches what is written beside it""")
            return
        if self.a.fns[f × 1¤ptrdiff].is_impure:
            self.derr(tok, "'" ⧺ name ⧺ """' is @impure, and a build recipe does nothing but
                                         " declare; """ ⧺ ev_subset())

    fn fn_index(&self, name : str) → i64:
        if #self.a.fns > 0:
            foreach i := 0…#self.a.fns:
                if self.a.fns[i].name = name:
                    return @dropunit(i)
        ⁻1

    // -------------------------------------------------------------------
    // Scope: the checker's watermark, and its floor for a called frame
    // -------------------------------------------------------------------

    fn push_scope(&mut self):
        self.marks.push(@dropunit(#self.names))

    fn pop_scope(&mut self):
        let base : i64 = self.marks.pop() ?? 0
        while @dropunit(#self.names) > base:
            _ ← self.names.pop() ?? ""
            _ ← self.vals.pop() ?? cv_none()
            _ ← self.vmut.pop() ?? 0

    fn bind(&mut self, name : str, v : CVal, is_mut : bool):
        self.names.push(name)
        self.vals.push(v)
        self.vmut.push(if is_mut: 1 else: 0)

    // innermost first, and never below the frame's floor, so a callee
    // sees its own parameters and nothing of its caller's
    fn slot_of(&self, name : str) → i64:
        foreach i := @dropunit(#self.names) - 1…self.floor - 1:
            if self.names[i × 1¤ptrdiff] = name:
                return i
        ⁻1

    // -------------------------------------------------------------------
    // The budgets, so a recipe that loops ends with a complaint
    // -------------------------------------------------------------------

    @pre(self.steps >= 0)
    fn tick(&mut self, tok : i64) → bool:
        if self.steps = 0:
            if not self.halted():
                self.derr(tok, "this build recipe did not settle after " ⧺ tokens.i64_str(EV_STEPS) ⧺ " steps; something in it does not finish")
            return false
        self.steps ← self.steps - 1
        not self.halted()

    // -------------------------------------------------------------------
    // Pass two: run it
    // -------------------------------------------------------------------

    fn ev_block(&mut self, off : i64) → i64:
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        foreach i := 0…n:
            let fl : i64 = self.ev_stmt(self.a.extra[(off + 1 + i) × 1¤ptrdiff])
            if fl ≠ EV_NORM:
                return fl
        EV_NORM

    // The value of a block: its statements in order, its last one
    // being what it answers.  An if written for its value answers this
    // way, and so does each arm of a chain, an elif being a block
    // holding one if.
    fn ev_block_value(&mut self, blk : i64) → CVal:
        if blk = ⁻1:
            return cv_none()
        let off : i64 = self.a.na[blk × 1¤ptrdiff]
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        if n = 0:
            return cv_none()
        self.push_scope()
        foreach i := 0…n - 1:
            let fl : i64 = self.ev_stmt(self.a.extra[(off + 1 + i) × 1¤ptrdiff])
            if fl ≠ EV_NORM:
                self.pop_scope()
                return cv_none()
        let last : i64 = self.a.extra[(off + n) × 1¤ptrdiff]
        let lk : i64 = self.a.nkind[last × 1¤ptrdiff]
        let v : mut CVal = cv_none()
        if lk = ast.NK_EXPRSTMT:
            v ← self.ev_expr(self.a.na[last × 1¤ptrdiff])
        elif lk = ast.NK_IF:
            v ← self.ev_expr(last)
        else:
            _ ← self.ev_stmt(last)
        self.pop_scope()
        v

    fn ev_stmt(&mut self, id : i64) → i64:
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        if not self.tick(tok):
            return EV_STOP
        let k : i64 = self.a.nkind[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = ast.NK_BLOCK:
            self.push_scope()
            let fl : i64 = self.ev_block(na)
            self.pop_scope()
            return fl
        if k = ast.NK_STOREFLD:
            let base : CVal = self.ev_expr(na)
            if self.halted():
                return EV_STOP
            if base.tag = CV_OPTS:
                self.derr(tok, """what the command line said is read and not written; a recipe
                                " answers it rather than changing it""")
                return EV_STOP
            if base.tag ≠ CV_BUILD:
                self.derr(tok, "a write through a path is not part of a build recipe; " ⧺ ev_subset())
                return EV_STOP
            let v : CVal = self.ev_expr(nb)
            if self.halted():
                return EV_STOP
            if v.tag ≠ CV_STR:
                self.derr(tok, "what a std.Build holds is a string, and this is " ⧺ self.cv_kind(v))
                return EV_STOP
            let f : str = self.text(tok)
            if ast.build_member(f) ≠ ast.BM_OUTDIR:
                self.derr(tok, "'" ⧺ f ⧺ "' is nothing a recipe may write; output_dir is")
                return EV_STOP
            self.outd ← v.s
            return EV_NORM
        if k = ast.NK_LET:
            let v : CVal = self.ev_expr(na)
            if self.halted():
                return EV_STOP
            self.bind(self.text(tok), v, nb = 1)
            return EV_NORM
        if k = ast.NK_ASSIGN:
            let v : CVal = self.ev_expr(na)
            if self.halted():
                return EV_STOP
            let name : str = self.text(tok)
            let s : i64 = self.slot_of(name)
            if s = ⁻1:
                self.derr(tok, "'" ⧺ name ⧺ "' is not a name in scope here")
                return EV_STOP
            if self.vmut[s × 1¤ptrdiff] = 0:
                self.derr(tok, "'" ⧺ name ⧺ "' was not declared mut, so ← may not write to it")
                return EV_STOP
            self.vals[s × 1¤ptrdiff] ← v
            return EV_NORM
        if k = ast.NK_DISCARD:
            _ ← self.ev_expr(na)
            return if self.halted(): EV_STOP else: EV_NORM
        if k = ast.NK_EXPRSTMT:
            // A function answers with its last expression rather than a
            // return, so every expression statement leaves its value
            // where a return would; the one the body ends on is the one
            // still there when the frame closes.
            self.ret ← self.ev_expr(na)
            return if self.halted(): EV_STOP else: EV_NORM
        if k = ast.NK_RETURN:
            self.ret ← if na = ⁻1: cv_none() else: self.ev_expr(na)
            return if self.halted(): EV_STOP else: EV_RET
        if k = ast.NK_BREAK:
            return EV_BREAK
        if k = ast.NK_CONTINUE:
            return EV_CONT
        if k = ast.NK_IF:
            let c : CVal = self.ev_expr(na)
            if self.halted():
                return EV_STOP
            if c.n ≠ 0:
                return self.ev_stmt(nb)
            return if nc = ⁻1: EV_NORM else: self.ev_stmt(nc)
        if k = ast.NK_WHILE:
            while true:
                let c : CVal = self.ev_expr(na)
                if self.halted():
                    return EV_STOP
                if c.n = 0:
                    return EV_NORM
                let fl : i64 = self.ev_stmt(nb)
                if fl = EV_BREAK:
                    return EV_NORM
                if fl = EV_RET or fl = EV_STOP:
                    return fl
                if not self.tick(tok):
                    return EV_STOP
            return EV_NORM
        if k = ast.NK_FOREACH:
            return self.ev_foreach(id, tok, na, nb)
        if k = ast.NK_FOREACHA:
            return self.ev_foreacha(id, tok, na, nb)
        self.derr(tok, ev_spell(k) ⧺ " is not part of a build recipe; " ⧺ ev_subset())
        EV_STOP

    // foreach v := lo…hi and lo…step…hi.  A range counts downward when
    // its end is below its base, which is the language's rule and the
    // reason a step of zero has to be refused rather than run.
    fn ev_foreach(&mut self, id : i64, tok : i64, na : i64, body : i64) → i64:
        let lo_v : CVal = self.ev_expr(self.a.extra[na × 1¤ptrdiff])
        let step_id : i64 = self.a.extra[(na + 1) × 1¤ptrdiff]
        let hi_v : CVal = self.ev_expr(self.a.extra[(na + 2) × 1¤ptrdiff])
        if self.halted():
            return EV_STOP
        let one : i64 = 1
        let minus : i64 = ⁻1
        let dir : i64 = if hi_v.n >= lo_v.n: one else: minus
        let step : mut i64 = dir
        if step_id ≠ ⁻1:
            let sv : CVal = self.ev_expr(step_id)
            if self.halted():
                return EV_STOP
            if sv.n = 0:
                self.derr(tok, "a step of zero never reaches the end of the range")
                return EV_STOP
            step ← sv.n
        let name : str = self.text(tok)
        let i : mut i64 = lo_v.n
        while (if step > 0: i <= hi_v.n else: i >= hi_v.n):
            self.push_scope()
            self.bind(name, cv_int(i), false)
            let fl : i64 = self.ev_stmt(body)
            self.pop_scope()
            if fl = EV_BREAK:
                return EV_NORM
            if fl = EV_RET or fl = EV_STOP:
                return fl
            if not self.tick(tok):
                return EV_STOP
            i ← i + step
        EV_NORM

    fn ev_foreacha(&mut self, id : i64, tok : i64, na : i64, body : i64) → i64:
        let av : CVal = self.ev_expr(na)
        if self.halted():
            return EV_STOP
        if av.tag ≠ CV_ARR:
            self.derr(tok, "foreach walks an array, and this is " ⧺ self.cv_kind(av))
            return EV_STOP
        let name : str = self.text(tok)
        foreach i := 0…av.m:
            self.push_scope()
            self.bind(name, cv_str(self.pool[(av.n + i) × 1¤ptrdiff]), false)
            let fl : i64 = self.ev_stmt(body)
            self.pop_scope()
            if fl = EV_BREAK:
                return EV_NORM
            if fl = EV_RET or fl = EV_STOP:
                return fl
            if not self.tick(tok):
                return EV_STOP
        EV_NORM

    fn cv_kind(&self, v : CVal) → str:
        if v.tag = CV_INT: return "a number"
        if v.tag = CV_BOOL: return "a truth value"
        if v.tag = CV_STR: return "a string"
        if v.tag = CV_ARR: return "an array of strings"
        if v.tag = CV_BUILD: return "the build"
        if v.tag = CV_EXE: return "an executable"
        if v.tag = CV_OPTS: return "what the command line said"
        "nothing"

    // -------------------------------------------------------------------
    // Expressions
    // -------------------------------------------------------------------

    fn ev_expr(&mut self, id : i64) → CVal:
        if id = ⁻1 or self.halted():
            return cv_none()
        let tok : i64 = self.a.ntok[id × 1¤ptrdiff]
        if not self.tick(tok):
            return cv_none()
        let k : i64 = self.a.nkind[id × 1¤ptrdiff]
        let na : i64 = self.a.na[id × 1¤ptrdiff]
        let nb : i64 = self.a.nb[id × 1¤ptrdiff]
        let nc : i64 = self.a.nc[id × 1¤ptrdiff]
        if k = ast.NK_INT:
            return cv_int(na)
        if k = ast.NK_BOOL:
            return cv_bool(na = 1)
        if k = ast.NK_STR:
            return cv_str(self.a.strs[na × 1¤ptrdiff])
        if k = ast.NK_DROPU:
            // @dropunit(#xs) is how this project writes a count, and a
            // recipe in the house style should not be punished for it
            return self.ev_expr(na)
        if k = ast.NK_VAR:
            return self.ev_var(tok)
        if k = ast.NK_ARRLIT:
            return self.ev_arrlit(tok, na)
        if k = ast.NK_SLIT:
            if nb ≠ ast.SLIT_EXE:
                self.derr(tok, "a struct literal is not part of a build recipe; " ⧺ ev_subset())
                return cv_none()
            return self.ev_exe_lit(tok, na)
        if k = ast.NK_MCALL:
            let recv : CVal = self.ev_expr(na)
            if self.halted():
                return cv_none()
            if recv.tag ≠ CV_BUILD:
                self.derr(tok, "a method call is not part of a build recipe; " ⧺ ev_subset())
                return cv_none()
            return self.ev_bmethod(tok, self.text(tok), nb × 1¤"aextra")
        if k = ast.NK_FIELD:
            let base : CVal = self.ev_expr(na)
            if self.halted():
                return cv_none()
            if base.tag = CV_OPTS:
                return self.ev_ofield(tok, self.text(tok))
            if base.tag ≠ CV_BUILD:
                self.derr(tok, "a field is not part of a build recipe; " ⧺ ev_subset())
                return cv_none()
            return self.ev_bfield(tok, self.text(tok))
        if k = ast.NK_LEN:
            let v : CVal = self.ev_expr(na)
            if self.halted():
                return cv_none()
            if v.tag = CV_ARR:
                return cv_int(v.m)
            if v.tag = CV_STR:
                return cv_int(@dropunit(#v.s))
            self.derr(tok, "# counts an array or a string, and this is " ⧺ self.cv_kind(v))
            return cv_none()
        if k = ast.NK_INDEX:
            return self.ev_index(tok, na, nb)
        if k = ast.NK_CCAT:
            return self.ev_ccat(tok, na, nb)
        if k = ast.NK_EMPTYV:
            // ∅, which is what a recipe reads where the command line
            // said nothing
            return cv_none()
        if k = ast.NK_DEFAULT:
            // x ?? y: the value where there is one, and the other where
            // there is not.  It is how a recipe reads what -o and
            // --target said without having to say what ∅ would mean
            // everywhere it is used.
            let v : CVal = self.ev_expr(na)
            if self.halted():
                return cv_none()
            if v.tag ≠ CV_NONE:
                return v
            return self.ev_expr(nb)
        if k = ast.NK_NEG:
            let v : CVal = self.ev_expr(na)
            return cv_int(⁻v.n)
        if k = ast.NK_NOT:
            let v : CVal = self.ev_expr(na)
            return cv_bool(v.n = 0)
        if k = ast.NK_AND or k = ast.NK_OR:
            // short-circuit, as the language has it
            let l : CVal = self.ev_expr(na)
            if self.halted():
                return cv_none()
            if k = ast.NK_AND and l.n = 0:
                return cv_bool(false)
            if k = ast.NK_OR and l.n ≠ 0:
                return cv_bool(true)
            let r : CVal = self.ev_expr(nb)
            return cv_bool(r.n ≠ 0)
        if k = ast.NK_IF:
            // an if standing where a value is wanted: the branch that
            // runs is the value, and the other side is not read
            let c : CVal = self.ev_expr(na)
            if self.halted():
                return cv_none()
            return self.ev_block_value(if c.n ≠ 0: nb else: nc)
        if k >= ast.NK_ADD and k <= ast.NK_MOD:
            return self.ev_arith(k, tok, na, nb)
        if k >= ast.NK_EQ and k <= ast.NK_GE:
            return self.ev_cmp(k, tok, na, nb)
        if k = ast.NK_CALL:
            return self.ev_call(tok, na × 1¤"aextra")
        if k = ast.NK_SCALL:
            self.derr(tok, sb_spell(na) ⧺ " is not part of a build recipe; " ⧺ ev_subset())
            return cv_none()
        self.derr(tok, ev_spell(k) ⧺ " is not part of a build recipe; " ⧺ ev_subset())
        cv_none()

    fn ev_var(&mut self, tok : i64) → CVal:
        let name : str = self.text(tok)
        let s : i64 = self.slot_of(name)
        if s ≠ ⁻1:
            return self.vals[s × 1¤ptrdiff]
        // A global the checker folded to a constant is readable.  Every
        // integer and truth-value global folds -- the checker refuses
        // one that does not -- and what does not fold is a function
        // value, which is not something a recipe holds.
        let g : i64 = self.global_index(name)
        if g ≠ ⁻1:
            if g < @dropunit(#self.gvals):
                let gt : i64 = self.a.globals[g × 1¤ptrdiff].ty
                let gv : i64 = self.gvals[g × 1¤ptrdiff]
                if gt = types.TY_BOOL:
                    return cv_bool(gv ≠ 0)
                if types.ty_is_int(gt):
                    return cv_int(gv)
        self.derr(tok, "'" ⧺ name ⧺ "' is not a name a build recipe can read here")
        cv_none()

    fn global_index(&self, name : str) → i64:
        if #self.a.globals > 0:
            foreach i := 0…#self.a.globals:
                if self.a.globals[i].name = name:
                    return @dropunit(i)
        ⁻1

    fn ev_arrlit(&mut self, tok : i64, off : i64) → CVal:
        let n : i64 = self.a.extra[off × 1¤ptrdiff]
        let base : i64 = @dropunit(#self.pool)
        foreach i := 0…n:
            let e : CVal = self.ev_expr(self.a.extra[(off + 1 + i) × 1¤ptrdiff])
            if self.halted():
                return cv_none()
            if e.tag ≠ CV_STR:
                self.derr(tok, "a build recipe's arrays hold strings, and this element is " ⧺ self.cv_kind(e))
                return cv_none()
            self.pool.push(e.s)
        assert(@dropunit(#self.pool) = base + n, "every element reached the pool")
        (CVal{tag: CV_ARR, n: base, m: n, s: ""})

    fn ev_index(&mut self, tok : i64, na : i64, nb : i64) → CVal:
        let base : CVal = self.ev_expr(na)
        let idx : CVal = self.ev_expr(nb)
        if self.halted():
            return cv_none()
        if base.tag ≠ CV_ARR:
            self.derr(tok, "indexing reads an array, and this is " ⧺ self.cv_kind(base))
            return cv_none()
        if idx.n < 0 or idx.n >= base.m:
            self.derr(tok, "the array holds " ⧺ tokens.i64_str(base.m) ⧺ " elements, so " ⧺ tokens.i64_str(idx.n) ⧺ " is not one of them")
            return cv_none()
        cv_str(self.pool[(base.n + idx.n) × 1¤ptrdiff])

    // ⧺ joins two strings or two arrays.  An array join copies both runs
    // to the top of the pool rather than writing into either, so no
    // value already handed out is disturbed.
    fn ev_ccat(&mut self, tok : i64, na : i64, nb : i64) → CVal:
        let l : CVal = self.ev_expr(na)
        let r : CVal = self.ev_expr(nb)
        if self.halted():
            return cv_none()
        if l.tag = CV_STR and r.tag = CV_STR:
            return cv_str(l.s ⧺ r.s)
        if l.tag = CV_ARR and r.tag = CV_ARR:
            let base : i64 = @dropunit(#self.pool)
            foreach i := 0…l.m:
                self.pool.push(self.pool[(l.n + i) × 1¤ptrdiff])
            foreach j := 0…r.m:
                self.pool.push(self.pool[(r.n + j) × 1¤ptrdiff])
            return (CVal{tag: CV_ARR, n: base, m: l.m + r.m, s: ""})
        self.derr(tok, "⧺ joins two strings or two arrays, and these are " ⧺ self.cv_kind(l) ⧺ " and " ⧺ self.cv_kind(r))
        cv_none()

    // The compiler's own arithmetic aborts on overflow, so a recipe's
    // overflow has to be caught before it reaches it.
    fn ev_arith(&mut self, k : i64, tok : i64, na : i64, nb : i64) → CVal:
        let l : CVal = self.ev_expr(na)
        let r : CVal = self.ev_expr(nb)
        if self.halted():
            return cv_none()
        if l.tag ≠ CV_INT or r.tag ≠ CV_INT:
            self.derr(tok, "arithmetic in a build recipe is over numbers, and these are " ⧺ self.cv_kind(l) ⧺ " and " ⧺ self.cv_kind(r))
            return cv_none()
        let lim : i64 = 4611686018427387903
        if l.n > lim or l.n < ⁻lim or r.n > lim or r.n < ⁻lim:
            self.derr(tok, """the numbers a build recipe counts with stay well inside i64; these do
                            " not""")
            return cv_none()
        if k = ast.NK_ADD: return cv_int(l.n + r.n)
        if k = ast.NK_SUB: return cv_int(l.n - r.n)
        if k = ast.NK_MUL:
            let small : i64 = 2147483647
            if l.n > small or l.n < ⁻small or r.n > small or r.n < ⁻small:
                self.derr(tok, """the numbers a build recipe multiplies stay inside i32; these do
                                " not""")
                return cv_none()
            return cv_int(l.n × r.n)
        if r.n = 0:
            self.derr(tok, "a build recipe divided by zero")
            return cv_none()
        // the zero divisor was refused just above, so the default here
        // stands for a case that cannot arise
        let zero : i64 = 0
        cv_int(if k = ast.NK_DIV: ((l.n ÷ r.n) ?? zero) else: ((l.n % r.n) ?? zero))

    // One comparison into a sign, then which orderings the operator
    // admits: less is 1, equal is 2, greater is 4.
    fn ev_cmp(&mut self, k : i64, tok : i64, na : i64, nb : i64) → CVal:
        let l : CVal = self.ev_expr(na)
        let r : CVal = self.ev_expr(nb)
        if self.halted():
            return cv_none()
        if l.tag ≠ r.tag:
            self.derr(tok, "a comparison reads two of a kind, and these are " ⧺ self.cv_kind(l) ⧺ " and " ⧺ self.cv_kind(r))
            return cv_none()
        let one : i64 = 1
        let two : i64 = 2
        let four : i64 = 4
        let ord : mut i64 = two
        if l.tag = CV_STR:
            ord ← if l.s = r.s: two else: one
        else:
            ord ← if l.n = r.n: two else: (if l.n < r.n: one else: four)
        let admits : i64[] = ev_cmp_admits()
        cv_bool(admits[(k - ast.NK_EQ) × 1¤ptrdiff] & ord ≠ 0)

    // -------------------------------------------------------------------
    // Calls, and what the recipe declares
    // -------------------------------------------------------------------

    fn ev_call(&mut self, tok : i64, args_off : i64 ¤"aextra") → CVal:
        let name : str = self.text(tok)
        let f : i64 = self.fn_index(name)
        if f = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ """' is not a function this file defines; a build recipe
                                         " reaches what is written beside it""")
            return cv_none()
        if self.depth >= EV_DEPTH:
            self.derr(tok, "the calls in this build recipe stand more than " ⧺ tokens.i64_str(EV_DEPTH) ⧺ " deep; something in it does not finish")
            return cv_none()
        let callee : ast.FnDef = self.a.fns[f × 1¤ptrdiff]
        let np : i64 ¤ptrdiff = self.a.extra[callee.params_off] × 1¤ptrdiff
        let argc : i64 ¤ptrdiff = self.a.extra[args_off] × 1¤ptrdiff
        if argc ≠ np:
            self.derr(tok, "'" ⧺ name ⧺ "' wants " ⧺ tokens.i64_str(@dropunit(np)) ⧺ " arguments, not " ⧺ tokens.i64_str(@dropunit(argc)))
            return cv_none()
        // the arguments are read in the caller's scope, before the
        // callee's frame hides it
        let vs : mut CVal[] = []
        foreach i := 0…argc:
            vs.push(self.ev_expr(self.a.extra[args_off + 1 + i]))
            if self.halted():
                return cv_none()
        let saved_floor : i64 = self.floor
        let saved_ret : CVal = self.ret
        self.push_scope()
        self.floor ← @dropunit(#self.names)
        self.depth ← self.depth + 1
        foreach j := 0…np:
            let ptok : i64 = self.a.extra[callee.params_off + 1 + j × 2]
            self.bind(self.text(ptok), vs[j], false)
        self.ret ← cv_none()
        let fl : i64 = self.ev_stmt(callee.body)
        let answered : CVal = self.ret
        self.depth ← self.depth - 1
        self.floor ← saved_floor
        self.pop_scope()
        self.ret ← saved_ret
        assert(self.floor = saved_floor, "the frame's floor was put back")
        if fl = EV_STOP:
            return cv_none()
        answered

    // -------------------------------------------------------------------
    // What a recipe says to the build it was handed
    // -------------------------------------------------------------------

    fn ev_exe_lit(&mut self, tok : i64, off : i64) → CVal:
        // One std.Build.Executable{…}: its fields read in the order
        // they were written, and what it did not name left empty.  Four
        // of them are names and one is a level, so what a field holds
        // is judged against the field rather than all alike.
        let n : i64 = self.a.extra[off × 1¤"aextra"]
        let name : mut str = ""
        let root : mut str = ""
        let outd : mut str = ""
        let tgt : mut str = ""
        // ⁻1 is what this executable says nothing about, which leaves
        // the level to what -O said
        let olv : mut i64 = ⁻1
        foreach i := 0…n:
            let ftok : i64 = self.a.extra[(off + 1 + i × 2) × 1¤"aextra"]
            let v : CVal = self.ev_expr(self.a.extra[(off + 2 + i × 2) × 1¤"aextra"])
            if self.halted():
                return cv_none()
            let f : str = self.text(ftok)
            if f = "optimize":
                if v.tag ≠ CV_INT:
                    self.derr(ftok, "the level an executable is built at is a number, and this is " ⧺ self.cv_kind(v))
                    return cv_none()
                if v.n < 0:
                    self.derr(ftok, "a level counts the work asked for, from 0 up; this one is below it")
                    return cv_none()
                olv ← v.n
                continue
            if v.tag ≠ CV_STR:
                self.derr(ftok, "a field of std.Build.Executable is a string, and this is " ⧺ self.cv_kind(v))
                return cv_none()
            if f = "name": name ← v.s
            elif f = "root_source_file": root ← v.s
            elif f = "output_dir": outd ← v.s
            elif f = "target": tgt ← v.s
            else:
                self.derr(ftok, "'" ⧺ f ⧺ """' is no field of std.Build.Executable; name,
                                 " root_source_file, output_dir, target and optimize are""")
                return cv_none()
        let at : i64 = @dropunit(#self.cfg_name)
        self.cfg_name.push(name)
        self.cfg_root.push(root)
        self.cfg_outd.push(outd)
        self.cfg_tgt.push(tgt)
        self.cfg_opt.push(olv)
        (CVal{tag: CV_EXE, n: at, m: 0, s: ""})

    fn ev_bmethod(&mut self, tok : i64, name : str, args_off : i64 ¤"aextra") → CVal:
        // A member function of the build: what the recipe declares.
        let bm : i64 = ast.build_member(name)
        let argc : i64 = @dropunit(self.a.extra[args_off])
        if bm = ast.BM_ADDEXE:
            if argc ≠ 1:
                self.derr(tok, "add_executable takes the one std.Build.Executable")
                return cv_none()
            let v : CVal = self.ev_expr(self.a.extra[args_off + 1¤"aextra"])
            if self.halted():
                return cv_none()
            if v.tag ≠ CV_EXE:
                self.derr(tok, "add_executable is told a std.Build.Executable, and this is " ⧺ self.cv_kind(v))
                return cv_none()
            let at : i64 ¤ptrdiff = v.n × 1¤ptrdiff
            if self.cfg_name[at] = "":
                self.derr(tok, "an executable is named: its 'name' is what the file is called")
                return cv_none()
            if self.cfg_root[at] = "":
                self.derr(tok, """an executable names the file it is rooted in: its
                                " 'root_source_file'""")
                return cv_none()
            self.added.push(v.n)
            return cv_none()
        if bm = ast.BM_PATH or bm = ast.BM_FLAG:
            if argc ≠ 1:
                self.derr(tok, "'" ⧺ name ⧺ "' takes the one string")
                return cv_none()
            let v : CVal = self.ev_expr(self.a.extra[args_off + 1¤"aextra"])
            if self.halted():
                return cv_none()
            if v.tag ≠ CV_STR:
                self.derr(tok, "'" ⧺ name ⧺ "' is told a string, and this is " ⧺ self.cv_kind(v))
                return cv_none()
            if bm = ast.BM_PATH: self.paths.push(v.s)
            else: self.flags.push(v.s)
            return cv_none()
        self.derr(tok, "'" ⧺ name ⧺ "' is nothing a std.Build does; " ⧺ ast.build_members())
        cv_none()

    fn ev_ofield(&mut self, tok : i64, name : str) → CVal:
        // A data member of the command line, read.  Each is an optional:
        // ∅ where nothing was said, which is what the empty string and
        // the ⁻1 the compiler carries stand for.
        let om : i64 = ast.option_member(name)
        if om = ⁻1:
            self.derr(tok, "'" ⧺ name ⧺ "' is nothing the command line says; " ⧺ ast.option_members())
            return cv_none()
        if om = ast.OM_OPTIMIZE:
            return if self.opt_optimize < 0: cv_none() else: cv_int(self.opt_optimize)
        let said : str = if om = ast.OM_OUTPUT: self.opt_output elif om = ast.OM_TARGET: self.opt_target else: self.opt_path
        if said = "": cv_none() else: cv_str(said)

    fn ev_bfield(&mut self, tok : i64, name : str) → CVal:
        // A data member of the build, read.
        let bm : i64 = ast.build_member(name)
        if bm = ast.BM_HOST: return cv_str(self.host)
        if bm = ast.BM_OUTDIR: return cv_str(self.outd)
        self.derr(tok, "'" ⧺ name ⧺ "' is nothing a std.Build holds; " ⧺ ast.build_members())
        cv_none()

    // a copy of a list into the pool, so what a reader answers is what
    // was declared when it was asked and not what came after
    fn pooled(&mut self, xs : str[]) → CVal:
        let base : i64 = @dropunit(#self.pool)
        foreach x := xs:
            self.pool.push(x)
        (CVal{tag: CV_ARR, n: base, m: @dropunit(#xs), s: ""})

// Read the @build recipe, if the program carries one.  A file without
// one pays a single comparison; every other phase here answers a struct
// carrying its own diagnostics, and so does this.
@export
@post(r: #r.diags = 0 or (#r.names = 0 and #r.paths = 0 and #r.flags = 0))
fn build_recipe(a : ast.Ast, toks : lex.Toks, src : byte[], gvals : i64[],
                output : str, target : str, host : str, optimize : i64,
                searched : str) → Recipe:
    if #a.builds = 0:
        return (Recipe{names: [], roots: [], outdirs: [], targets: [],
                       optimizes: [], paths: [], flags: [], diags: []})
    let recipe : ast.FnDef = a.builds[0¤ptrdiff]
    let ev : mut Cev = (Cev{a: a, toks: toks, src: src, gvals: gvals,
                          names: [], vals: [], vmut: [], marks: [], floor: 0,
                          pool: [], cfg_name: [], cfg_root: [], cfg_outd: [],
                          cfg_tgt: [], cfg_opt: [], added: [], opt_output: output,
                          opt_target: target, opt_path: searched,
                          opt_optimize: optimize,
                          outd: "", host: host,
                          paths: [], flags: [],
                          steps: EV_STEPS, depth: 0, ret: cv_none(),
                          diags: []})
    // Pass one settles what the body may contain, for every branch --
    // including the ones pass two will not take.
    ev.ev_scan(recipe.body)
    if #ev.diags = 0:
        ev.push_scope()
        // What the recipe was handed, under the names the recipe gave
        // them: the build always, and after it, where the recipe reads
        // it, what the command line said.  A recipe with any other
        // signature was refused where it was written, long before this,
        // so there is one of them or two.
        let np : i64 = a.extra[recipe.params_off]
        assert(np >= 1 and np <= 2, "the recipe takes the build and, where it reads it, the command line")
        ev.bind(ev.text(a.extra[recipe.params_off + 1]),
                (CVal{tag: CV_BUILD, n: 0, m: 0, s: ""}), false)
        if np = 2:
            ev.bind(ev.text(a.extra[recipe.params_off + 3]),
                    (CVal{tag: CV_OPTS, n: 0, m: 0, s: ""}), false)
        _ ← ev.ev_stmt(recipe.body)
        ev.pop_scope()
    if #ev.diags > 0:
        return (Recipe{names: [], roots: [], outdirs: [], targets: [],
                       optimizes: [], paths: [], flags: [], diags: ev.diags})
    assert(#ev.marks = 0, "every scope the recipe opened was closed")
    assert(ev.depth = 0, "every call the recipe made returned")
    // the executables it added, in the order it added them, each with
    // what it named and what it left to the command line
    let names : mut str[] = []
    let roots : mut str[] = []
    let outdirs : mut str[] = []
    let targets : mut str[] = []
    let optimizes : mut i64[] = []
    foreach at := ev.added:
        let i : i64 ¤ptrdiff = at × 1¤ptrdiff
        names.push(ev.cfg_name[i])
        roots.push(ev.cfg_root[i])
        outdirs.push(if ev.cfg_outd[i] = "": ev.outd else: ev.cfg_outd[i])
        targets.push(ev.cfg_tgt[i])
        optimizes.push(ev.cfg_opt[i])
    assert(#names = #roots and #names = #outdirs and #names = #targets and #names = #optimizes,
           "the five things said about an executable are still in step")
    (Recipe{names: names, roots: roots, outdirs: outdirs, targets: targets,
            optimizes: optimizes, paths: ev.paths, flags: ev.flags, diags: []})
