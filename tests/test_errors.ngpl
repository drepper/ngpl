// Error and warning detection tests using @expect annotations.
//
// Function-level @expect: the interpreter tries to parse and evaluate
// the function; produced diagnostics are matched against expectations.
//
// Statement-level @expect: the annotation appears before a statement
// inside a function body; diagnostics from that single statement are
// captured and matched.

let GLOBAL_C : i64 = 42

// --- let immutability ---------------------------------------------------

@expect error 2412 "cannot assign to let variable 'x'"
fn error_const_assign():
    let x : i64 = 42
    x ← 99

@expect error 2244 "cannot redefine let variable 'x'"
fn error_const_redef():
    let x : i64 = 42
    let x : mut = 99

@expect error 2241 "cannot assign to let variable 'GLOBAL_C'"
fn error_global_const_assign():
    GLOBAL_C ← 999

// --- foreach immutability -------------------------------------------------

@expect error 2412 "cannot assign to foreach variable 'i'"
fn error_foreach_assign():
    foreach i := 1…4:
        i ← i + 1

// foreach variable redefinition is a warning, not an error.
// The new variable shadows the loop variable after the redefinition.
@test
fn warn_foreach_redef():
    let total : mut i64 = 0
    foreach i := 1…4:
        @expect warning 2420 "redefinition of foreach variable 'i'"
        let i : mut i64 = 99
        total ← total + i
    assert_eq(total, 297)

// foreach without type requires := not =
@expect error 2023 "Line 49, col 14: foreach without type annotation requires ':='"
fn error_foreach_bare_eq():
    foreach i = 1…4:
        std.println("{}", i)

// let without type requires := not =
@expect error 2020 "Line 55, col 10: let definition requires ':=' or ': [mut] type ='"
fn error_let_bare_eq():
    let x = 42

// --- fast type restrictions -----------------------------------------------

@expect error 2737 "fast type 'u8fast' cannot be used as array element type"
@impure
fn error_fast_array():
    let arr : mut u8fast[10] = 10 ⍴ 0
    std.println("{}", arr[0])

// --- type mismatch --------------------------------------------------------

@expect error 2611 "assert_eq failed:\n  expected: 1\n  actual:   2"
fn error_assert_mismatch():
    assert_eq(1, 2)

// --- division by zero -----------------------------------------------------

@expect error 2013 "unwrap of expected error: errors.division_by_zero"
fn error_div_zero():
    let x : mut = 10 ÷ 0
    let y : mut = x + 1

// --- parse errors ---------------------------------------------------------

@expect error 2028 "Line 82, col 4: unexpected token: 'fn'"
fn error_nested_fn():
    fn inner():
        std.println("bad")

// --- unknown types --------------------------------------------------------

@expect error 2112 "unknown type 'i0'"
fn error_unknown_type_var():
    // A width of zero holds no values, so it names no type.
    let x : mut i0 = 0

// --- call-by-reference errors ----------------------------------------------

fn takes_ref(x : &mut i32[]):
    x[0] ← 1

@expect error 2259 "takes_ref: parameter 'x' is by-reference, caller must pass &x"
fn error_ref_missing_ampersand():
    let a : mut i32[] = [1, 2, 3]
    takes_ref(a)

fn takes_val(x : i32[]):
    x[0] ← 1

@expect error 2260 "takes_val: parameter 'x' is by-value, caller must not pass a reference"
fn error_val_with_ampersand():
    let a : mut i32[] = [1, 2, 3]
    takes_val(&a)

// --- immutable parameter errors --------------------------------------------

fn try_assign_param(x : i32):
    x ← 99

@test
fn error_param_immutable():
    @expect error 2412 "cannot assign to let variable 'x'"
    try_assign_param(42)

// --- fixed-size array parameter mismatch -----------------------------------

fn needs_three(arr : i32[3]) → i32:
    arr[0]

@test
fn error_fixed_array_size_mismatch():
    let a : i32[] = [1, 2, 3, 4]
    @expect error 2768 "needs_three: argument 'arr' expected i32[3] (length 3), got array of length 4"
    needs_three(a)

@start
@impure
fn main():
    std.println("error tests passed")
