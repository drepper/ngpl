// A struct field may state a unit the way a binding does: written
// after the name, and from then on the field's numbers count in it.
// What is checked here is the whole path: a literal filling the field
// adopts or converts, a read answers a measured value, a store is
// held to the measure, and a field with no unit still refuses one.

unit widgets

struct Span:
    off : i64 ¤byte
    len : i64 ¤byte
    tag : i64

@repr(C)
struct Packed:
    size : u64 ¤byte
    n : u32 ¤"widgets"
    kind : u32

@test
fn test_a_literal_adopts_the_fields_measure():
    let s : Span = Span{off: 8, len: 24, tag: 3}
    assert_eq(@dropunit(s.off), 8)
    assert_eq(@dropunit(s.len), 24)
    assert_eq(s.tag, 3)

@test
fn test_a_measured_value_fills_a_field_of_its_measure():
    let base : i64 ¤byte = 16
    let s : Span = Span{off: base, len: base + 8, tag: 0}
    assert_eq(@dropunit(s.len), 24)

@test
fn test_a_read_carries_the_measure_into_arithmetic():
    let s : Span = Span{off: 8, len: 24, tag: 0}
    let end : i64 ¤byte = s.off + s.len
    assert_eq(@dropunit(end), 32)

@expect error 2326 "Span: parameter 'tag' is i64, which carries no unit, but the argument is B; use @dropunit to part with it"
fn error_a_plain_field_refuses_a_measured_value():
    let q : i64 ¤byte = 8
    let s : Span = Span{off: 0, len: 0, tag: q}
    assert_eq(s.tag, 8)

@test
fn test_a_defined_measure_serves_a_field_too():
    let p : Packed = Packed{size: 64, n: 5, kind: 2}
    assert_eq(@dropunit(p.size), 64)
    assert_eq(@dropunit(p.n), 5)

@test
fn test_the_layout_is_blind_to_the_measure():
    // a unit says what a number counts, not how wide it is
    assert_eq(@sizeof(Packed), 16)
    assert_eq(Packed.offsetof("n"), 8)

@test
@impure
fn test_a_store_is_held_to_the_measure():
    let s : mut Span = Span{off: 0, len: 0, tag: 0}
    let w : i64 ¤byte = 40
    s.off ← w
    s.len ← 8
    assert_eq(@dropunit(s.off + s.len), 48)

@start
@impure
fn main():
    std.println("field unit tests passed")
