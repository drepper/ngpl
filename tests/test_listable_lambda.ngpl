// A lambda can be @listable.
//
// A @listable function handed something deeper than a parameter asked
// for is asked of each of the things in the container instead.  A
// lambda is a function like any other and threads the same way; what
// it lacked was somewhere to write the annotation.  It goes in front
// of the λ, which is the only place it could go.
//
// The specification's "Threading Over Containers" is the normative
// statement for what threading is; this file is about writing it on a
// lambda.

@test
fn test_a_listable_lambda_threads():
    let twice := @listable λx : i64 → i64: x × 2
    let v : i64[] = [1, 2, 3]
    let w : i64[] = twice(v)
    assert_eq(w[0 × 1¤ptrdiff], 2)
    assert_eq(w[1 × 1¤ptrdiff], 4)
    assert_eq(w[2 × 1¤ptrdiff], 6)

// Handed what the parameter asked for, it is an ordinary call.
@test
fn test_a_listable_lambda_is_still_a_function():
    let twice := @listable λx : i64 → i64: x × 2
    assert_eq(twice(21), 42)

// Two parameters thread together, element against element.
@test
fn test_two_parameters_thread_together():
    let add := @listable λa : i64, b : i64 → i64: a + b
    let v : i64[] = [1, 2, 3]
    let w : i64[] = [10, 20, 30]
    let s : i64[] = add(v, w)
    assert_eq(s[0 × 1¤ptrdiff], 11)
    assert_eq(s[2 × 1¤ptrdiff], 33)

// One of them may be the scalar the other is threaded against.
@test
fn test_a_scalar_beside_a_container():
    let add := @listable λa : i64, b : i64 → i64: a + b
    let v : i64[] = [1, 2, 3]
    let s : i64[] = add(v, 100)
    assert_eq(s[0 × 1¤ptrdiff], 101)
    assert_eq(s[2 × 1¤ptrdiff], 103)

// A partly applied listable lambda still threads: what is called in
// the end is the lambda, and it is the lambda that says it does.
@test
fn test_a_partial_still_threads():
    let add := @listable λa : i64, b : i64 → i64: a + b
    let plus100 := add(100)
    let v : i64[] = [1, 2, 3]
    let s : i64[] = plus100(v)
    assert_eq(s[0 × 1¤ptrdiff], 101)
    assert_eq(s[2 × 1¤ptrdiff], 103)

@start
@impure
fn main():
    std.println("listable lambda tests passed")
