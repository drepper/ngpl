// test_untyped.ngpl -- what an integer literal is before it settles
//
// A literal states no width, so it has nothing to say about the type
// of what it is combined with: it takes that type instead, as an
// untyped constant does in Go.  The result then lives in that type,
// and can overflow or wrap where a value of it would.
//
// A binding is a different thing.  It states a sized type — the
// bootstrap has no arbitrary-precision `int` for one to settle on —
// and keeps it; only a literal is uncommitted.  Where the two meet a
// fixed width, they answer differently, which is what these tests are
// about.

// --- A literal takes the width it meets --------------------------

@test
fn test_literal_takes_the_typed_width():
    let p : u8 = 7
    static_assert_eq(@typeof(p + 1), u8)
    static_assert_eq(@typeof(1 + p), u8)
    static_assert_eq(@typeof(p × 2), u8)

// Having taken the width, the result lives in it, and leaving that
// range is reported rather than adjusted.
@test
@expect error 2279 "integer overflow: 256 does not fit in u8 (range 0..255)"
@impure
fn test_overflow_follows_the_width_taken():
    let p : u8 = 255
    std.println("{}", p + 1)

// @wrap is how the modular result is asked for, and it is the width
// the literal took that the result comes round in.
@test
fn test_wrapping_follows_the_width_taken():
    let p : u8 = 255
    assert_eq(@wrap(p + 1), 0)
    let q : u16 = 65535
    assert_eq(@wrap(q + 1), 0)

// Signed overflow is reported rather than wrapped.
@test
@expect error 2279 "integer overflow: 128 does not fit in i8 (range -128..127)"
@impure
fn test_signed_overflow_is_reported():
    let i : i8 = 127
    std.println("{}", i + 1)

// --- Two literals stay uncommitted --------------------------------

@test
fn test_literals_together_stay_untyped():
    static_assert_eq(@typeof(1 + 2), int)
    // Arbitrary precision, so no width confines the result.
    assert_eq(100000000000000000000 + 1, 100000000000000000001)

// --- A name settles what it was given ------------------------------

// A binding states its type, so it wins where a literal would have
// given way: the wider of the two is what the result lives in.
@test
fn test_a_binding_is_not_a_literal():
    let n : i64 = 0
    static_assert_eq(@typeof(n), i64)
    let p : u8 = 200
    static_assert_eq(@typeof(n + p), i64)

// The distinction is what keeps an accumulator from being truncated
// by the first typed value added to it.
@test
fn test_an_accumulator_is_not_narrowed():
    let total : mut i64 = 0
    let a : u8 = 200
    let b : u8 = 200
    total ← total + a
    total ← total + b
    assert_eq(total, 400)

// --- Shifts, which read the width ---------------------------------

// A width bounds how far a shift may go, so a literal that has taken
// one is bounded by it.
@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_shift_bounded_by_the_width_taken():
    let p : u8 = 1
    std.println("{}", (p + 1) « 8)

// An untyped value has no width for a count to pass.
@test
fn test_untyped_shift_is_unbounded():
    assert_eq(1 « 40, 1099511627776)

// A binding is bounded by the width it states, which for an i64
// leaves room for this one.
@test
fn test_a_shift_is_bounded_by_the_binding():
    let n : i64 = 1
    assert_eq(n « 40, 1099511627776)

@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_a_shift_past_the_bindings_width():
    let n : i64 = 1
    _ ← n « 64

// --- Units still take an uncommitted number ------------------------

@test
fn test_a_literal_still_joins_a_measured_value():
    let d : i32 ¤meter = 5
    let further := d + 2
    assert_eq(@unitof(further), @unitof(d))

@start
@impure
fn main():
    std.println("untyped tests passed")
