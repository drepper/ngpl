// Tests for `f ¨ v` -- what f says of each of them.
//
// Every operator in the language already threads over what it is
// handed, so ¨ is for the functions that do not: an ordinary one, a
// lambda, anything that can be called.

fn twice(n : i64) → i64:
    n × 2

fn describe(n : i64) → str:
    "even" if n % 2 = 0 else "odd"

fn width(s : str) → i64 ¤ptrdiff:
    #s

// ---------------------------------------------------------------------
// What it answers
// ---------------------------------------------------------------------

@test
fn test_each_of_an_array():
    let v : i64[] = [1, 2, 3]
    let doubled := twice¨v
    assert_eq(doubled[0], 2)
    assert_eq(doubled[1], 4)
    assert_eq(doubled[2], 6)
    assert_eq(#doubled, 3¤ptrdiff)

@test
fn test_each_of_a_range():
    let doubled := twice¨(1…4)
    assert_eq(doubled[0], 2)
    assert_eq(doubled[3], 8)
    assert_eq(#doubled, 4¤ptrdiff)

// What comes back need not hold what went in: the answers are what f
// said, whatever that is.
@test
fn test_the_answers_need_not_be_what_was_handed_over():
    let v : i64[] = [1, 2, 3]
    let said := describe¨v
    assert_eq(said[0], "odd")
    assert_eq(said[1], "even")
    assert_eq(@typeof(said[0]), str)

@test
fn test_each_of_an_array_of_strings():
    let words : str[] = ["a", "bcd"]
    let lengths : i64 ¤ptrdiff[] = width¨words
    assert_eq(lengths[0], 1¤ptrdiff)
    assert_eq(lengths[1], 3¤ptrdiff)

// Nothing to ask about is an answer of nothing.
@test
fn test_each_of_an_empty_array():
    let v : i64[] = []
    assert_eq(#(twice¨v), 0¤ptrdiff)

// ---------------------------------------------------------------------
// What may stand on the left
// ---------------------------------------------------------------------

@test
fn test_a_lambda():
    let v : i64[] = [1, 2, 3]
    let raised := (λx : i64 → i64: x + 100)¨v
    assert_eq(raised[0], 101)
    assert_eq(raised[2], 103)

// A name that holds a function is a function.
@test
fn test_a_name_that_holds_one():
    let v : i64[] = [1, 2]
    let f := twice
    let doubled := f¨v
    assert_eq(doubled[1], 4)

// ---------------------------------------------------------------------
// Beside the other combinators
// ---------------------------------------------------------------------

// Mapping and then folding is the shape most of this is for.
@test
fn test_mapped_then_folded():
    let v : i64[] = [1, 2, 3]
    assert_eq(+⌿ twice¨v, 12)

// A matrix holds rows, so each of them is a row.
@test
fn test_each_of_a_matrix_is_a_row():
    let m : i64[2, 3] = [[1, 2, 3], [4, 5, 6]]
    let widths : i64[] = (λr : i64[] → i64: @dropunit(#r))¨m
    assert_eq(widths[0], 3)
    assert_eq(widths[1], 3)

// What follows ¨ is the container, as it is for a fold, so brackets
// are what stop it reaching further.
@test
fn test_brackets_say_where_the_container_ends():
    let a : i64[] = [1, 2]
    let b : i64[] = [3]
    let joined := twice¨(a ⧺ b)
    assert_eq(#joined, 3¤ptrdiff)
    assert_eq(joined[2], 6)

// ---------------------------------------------------------------------
// What an operator does without it
// ---------------------------------------------------------------------

// Every operator already threads, which is why ¨ is not needed for one
// and why it is needed for a function.
@test
fn test_an_operator_needs_no_each():
    let v : i64[] = [1, 2, 3]
    let negated := ⁻v
    assert_eq(negated[0], ⁻1)
    let bigger := v × 2
    assert_eq(bigger[2], 6)

// A function marked @listable threads the same way, and ¨ says the
// same thing at the call rather than at the definition.
@listable
fn tripled(n : i64) → i64:
    n × 3

@test
fn test_a_listable_function_threads_without_it():
    let v : i64[] = [1, 2]
    assert_eq(tripled(v)[1], 6)
    assert_eq((tripled¨v)[1], 6)

@start
@impure
fn main():
    std.println("map tests passed")
