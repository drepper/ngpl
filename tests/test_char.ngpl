// Tests for the character type.
//
// A character holds one Unicode scalar value — UCS-4, so any code
// point, not a byte.  It is what a string is made of, which is what
// iterating a string hands over.  It is not a string of one and not a
// number: it says its number with .ord(), and a number becomes one
// with .chr().

// ---------------------------------------------------------------------
// Iterating a string
// ---------------------------------------------------------------------

@test
fn test_iterating_a_string_gives_characters():
    let count : mut i64 = 0
    foreach c := "abc":
        count ← count + 1
    assert_eq(count, 3)

@test
fn test_the_loop_variable_is_a_character():
    foreach c := "a":
        static_assert_eq(@typeof(c), char)

@test
fn test_the_characters_come_in_order():
    let total : mut u32 = 0
    foreach c := "abc":
        total ← total + c.ord()
    assert_eq(total, 294)

// A character is a code point, not a byte, so a string of one
// non-ASCII character is one element rather than its UTF-8 length.
@test
fn test_a_string_is_counted_in_characters():
    let count : mut i64 = 0
    foreach c := "héllo":
        count ← count + 1
    assert_eq(count, 5)

@test
fn test_a_character_beyond_the_basic_plane():
    let count : mut i64 = 0
    let found : mut u32 = 0
    foreach c := "🎉":
        count ← count + 1
        found ← c.ord()
    assert_eq(count, 1)
    assert_eq(found, 127881)

@test
fn test_an_empty_string_has_no_characters():
    let count : mut i64 = 0
    foreach c := "":
        count ← count + 1
    assert_eq(count, 0)

// ---------------------------------------------------------------------
// Writing one down
// ---------------------------------------------------------------------
//
// A character literal is written between apostrophes, and a string
// between double quotes, so the two say which they are before they are
// read.

@test
fn test_a_character_literal():
    let c := 'a'
    static_assert_eq(@typeof(c), char)
    assert_eq(c.ord(), 97)

@test
fn test_a_literal_beyond_ascii():
    assert_eq('λ'.ord(), 955)
    assert_eq('🎉'.ord(), 127881)

@test
fn test_the_escapes_a_literal_takes():
    assert_eq('\n'.ord(), 10)
    assert_eq('\t'.ord(), 9)
    assert_eq('\r'.ord(), 13)
    assert_eq('\\'.ord(), 92)
    assert_eq('\''.ord(), 39)
    assert_eq('"'.ord(), 34)

@test
fn test_a_literal_by_code_point():
    assert_eq('\u{41}'.ord(), 65)
    assert_eq('\u{1F389}'.ord(), 127881)

// A literal is a compile-time constant, as the other literals are.
@test
fn test_a_literal_is_constant():
    static_assert('a' < 'b')
    static_assert('a' == 'a')
    static_assert('a' != 'b')

// The apostrophe that ends a generic type name is not a literal
// opening: the name takes it, and a literal after one still reads.
fn first_of_pack(args… : T') → T':
    args[0]

@test
fn test_a_generic_name_keeps_its_prime():
    assert(first_of_pack('a', 'b') == 'a')

// ---------------------------------------------------------------------
// .ord() and .chr()
// ---------------------------------------------------------------------

@test
fn test_ord_gives_the_code_point():
    let a : u32 = 97
    assert_eq(a.chr().ord(), 97)

@test
fn test_ord_answers_a_u32():
    let a : u32 = 97
    let n := a.chr().ord()
    static_assert_eq(@typeof(n), u32)

@test
fn test_chr_makes_a_character():
    let a : u32 = 97
    let c := a.chr()
    static_assert_eq(@typeof(c), char)

// Every integer type has it, since every one of them can hold a code
// point that fits.
@test
fn test_chr_is_on_every_integer_type():
    let a : u8 = 65
    let b : i32 = 955
    let c : i64 = 127881
    assert_eq(a.chr().ord(), 65)
    assert_eq(b.chr().ord(), 955)
    assert_eq(c.chr().ord(), 127881)

@test
fn test_chr_and_ord_are_inverse():
    let n : u32 = 955
    assert_eq(n.chr().ord(), n)

// ---------------------------------------------------------------------
// What is not a code point
// ---------------------------------------------------------------------

// A character is numbered from zero, so a negative number names none.
// Where the number is written down this is known before anything runs,
// which is what tests/output/chr_negative_constant.ngpl shows.
@test
@expect error "chr: -1 is not a code point"
fn error_chr_of_a_negative_number():
    let n : i64 = ⁻1
    let c : char = n.chr()

@test
@expect error "is past the last code point"
fn error_chr_past_the_last_code_point():
    let n : i64 = 1114112
    let c : char = n.chr()

@test
@expect error "is a surrogate"
fn error_chr_of_a_surrogate():
    let n : i64 = 55296
    let c : char = n.chr()

// The last code point itself is one.
@test
fn test_the_last_code_point():
    let n : i64 = 1114111
    assert_eq(n.chr().ord(), 1114111)

// ---------------------------------------------------------------------
// A character is its own kind of value
// ---------------------------------------------------------------------

@test
@expect error "'char' cannot hold an integer; a number becomes a character with .chr"
fn error_a_number_is_not_a_character():
    let c : char = 5

@test
@expect error "'char' cannot hold a string"
fn error_a_string_is_not_a_character():
    let c : char = "a"

@test
@expect error "'i64' cannot hold a character"
fn error_a_character_is_not_a_number():
    let a : u32 = 97
    let n : i64 = a.chr()

@test
@expect error "has no method 'nope'"
fn error_a_character_has_no_other_method():
    let a : u32 = 97
    let n : mut = a.chr().nope()

// ---------------------------------------------------------------------
// Comparing characters
// ---------------------------------------------------------------------

@test
fn test_characters_compare_by_code_point():
    let a : u32 = 97
    let b : u32 = 98
    assert(a.chr() == a.chr())
    assert(a.chr() != b.chr())
    assert(a.chr() < b.chr())
    assert(b.chr() > a.chr())
    assert(a.chr() <= a.chr())
    assert(b.chr() >= a.chr())

@test
fn test_finding_a_character_in_a_string():
    let wanted : u32 = 108
    let found : mut i64 = 0
    foreach c := "hello":
        if c == wanted.chr():
            found ← found + 1
    assert_eq(found, 2)

// Which reads better written down.
fn vowels(text : str) → i64:
    let count : mut i64 = 0
    foreach c := text:
        if c == 'a' ∨ c == 'e' ∨ c == 'i' ∨ c == 'o' ∨ c == 'u':
            count ← count + 1
    count

@test
fn test_counting_with_literals():
    assert_eq(vowels("hello world"), 3)

// A character parameter takes a character and nothing else.
fn is_digit(c : char) → bool:
    c >= '0' ∧ c <= '9'

@test
fn test_a_character_parameter():
    assert(is_digit('7'))
    assert(not is_digit('x'))

@test
@expect error "expected char, got str"
fn error_a_string_is_not_a_character_argument():
    let b : mut = is_digit("7")

// ---------------------------------------------------------------------
// Building a string from characters
// ---------------------------------------------------------------------
//
// ⧺ joins two sequences, and a string and a character are both text,
// so joining either with either gives a string.

@test
fn test_two_characters_make_a_string():
    let s := 'a' ⧺ 'b'
    static_assert_eq(@typeof(s), str)
    assert(s == "ab")

@test
fn test_a_character_joins_a_string():
    assert(("ab" ⧺ 'c') == "abc")
    assert(('c' ⧺ "ab") == "cab")

@test
fn test_two_strings_join():
    assert(("ab" ⧺ "cd") == "abcd")

// Which is what builds a string up one character at a time.
@test
fn test_building_a_string_in_a_loop():
    let out : mut str = ""
    foreach c := "abc":
        out ← out ⧺ c ⧺ '.'
    assert(out == "a.b.c.")

fn reversed(text : str) → str:
    let out : mut str = ""
    foreach c := text:
        out ← c ⧺ out
    out

@test
fn test_reversing_a_string():
    assert(reversed("abc") == "cba")

// A character says its string, and characters say theirs.
@test
fn test_a_character_becomes_a_string_of_one():
    let s := 'x'.str()
    static_assert_eq(@typeof(s), str)
    assert(s == "x")

@test
fn test_an_array_of_characters_becomes_a_string():
    let chars : char[] = ['h', 'i', '!']
    assert(chars.str() == "hi!")

// An array literal of characters says what it is made of.
@test
fn test_an_array_of_characters_knows_its_element_type():
    let chars := ['a', 'b']
    static_assert_eq(@typeof(chars[0]), char)

@test
fn test_an_empty_array_of_characters_makes_an_empty_string():
    let chars : char[] = []
    assert(chars.str() == "")

// The round trip: a string taken apart and put back together.
@test
fn test_a_string_survives_the_round_trip():
    let out : mut str = ""
    foreach c := "héllo 🎉":
        out ← out ⧺ c
    assert(out == "héllo 🎉")

// --- what does not go together with text ---

@test
@expect error "does not go together with text"
fn error_a_number_does_not_join_text():
    let s : mut = 'a' ⧺ 5i64

@test
@expect error "a string is made of characters, and element 0 is i64"
fn error_a_string_from_something_that_is_not_characters():
    let numbers : i64[] = [1, 2]
    let s : mut = numbers.str()

// ---------------------------------------------------------------------
// Writing one out
// ---------------------------------------------------------------------

// A character is written as itself, the way a string is: the quotes it
// is displayed with at the prompt are for reading a value back.
@test
@impure
fn test_a_character_is_written_as_itself():
    let alloc := std.heap.allocator()
    let n : u32 = 955
    let s := std.format(alloc, "{}", n.chr())
    assert(s == "λ")

@start
@impure
fn main():
    std.println("char tests passed")
