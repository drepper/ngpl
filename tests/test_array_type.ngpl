// test_array_type.ngpl -- an array type says its shape
//
// The brackets in i32[3] or i32[2,3] are what a type says an array
// with.  Leaving them off names a scalar, and a scalar is not an
// array however many elements are written on the other side of the
// equals sign: the declaration is a statement about the value, not a
// shorthand for what the elements are.

// --- Recognizing the syntax -----------------------------------------

// A fixed extent, as sha256's eight-word hash state is declared.
@test
fn test_fixed_extent():
    let h : u32[8] = [
        1779033703, 3144134277, 1013904242, 2773480762,
        1359893119, 2600822924, 528734635,  1541459225,
    ]
    assert_eq(#h, 8)
    assert_eq(h[0], 1779033703)
    assert_eq(h[7], 1541459225)

// An empty bracket leaves the extent to the initializer.
@test
fn test_dynamic_extent():
    let a : i32[] = [1, 2, 3]
    assert_eq(#a, 3)

// Two extents make a matrix, and the rows are arrays in their own right.
@test
fn test_two_dimensions():
    let m : i32[2,3] = [[1, 2, 3], [4, 5, 6]]
    assert_eq(#m, 2)
    assert_eq(#m[0], 3)
    assert_eq(m[1][2], 6)

// A dimension left empty takes the extent the initializer had, whether
// it is the first or a later one.
@test
fn test_open_dimensions():
    let rows : i32[,3] = [[1, 2, 3], [4, 5, 6]]
    assert_eq(#rows, 2)
    let cols : i32[2,] = [[1, 2, 3], [4, 5, 6]]
    assert_eq(#cols[1], 3)

// Three extents, to show the shape is read as written rather than
// only to a depth of two.
@test
fn test_three_dimensions():
    let t : i32[2,2,2] = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    assert_eq(t[1][1][0], 7)

// --- The element type reaches every element -------------------------

// The type names what the elements are, so they arrive at that width
// however many dimensions deep they sit.
@test
fn test_element_width_one_dimension():
    let a : u8[3] = [1, 2, 3]
    static_assert_eq(@typeof(a[0]), u8)

@test
fn test_element_width_two_dimensions():
    let m : u8[2,2] = [[1, 2], [3, 4]]
    static_assert_eq(@typeof(m[0][0]), u8)

// A value that will not fit the declared element type is refused
// wherever it sits, not only in the first row.
@test
@expect error "does not fit"
@impure
fn test_element_out_of_range_in_a_later_row():
    let m : i8[2,2] = [[1, 2], [3, 300]]
    std.println("{}", m)

// --- A scalar type is not an array ----------------------------------

// The mistake this refuses: sha256's hash state was declared u32 and
// initialized with its eight words, and the eight were quietly taken
// as the elements of an array nobody had declared.
@test
@expect error "is not an array type"
@impure
fn test_array_initializer_needs_an_array_type():
    let h : u32 = [1, 2, 3]
    std.println("{}", h)

@test
@expect error "is not an array type"
@impure
fn test_nested_initializer_needs_an_array_type():
    let m : i32 = [[1, 2], [3, 4]]
    std.println("{}", m)

// The same for a float element type, so the refusal is about the
// missing brackets and not about integers.
@test
@expect error "is not an array type"
@impure
fn test_float_scalar_refuses_an_array():
    let f : f64 = [1.0, 2.0]
    std.println("{}", f)

// A parameter states a type the same way, so it refuses the same way.
fn takes_a_scalar(n : u32) → u32:
    n

@test
@expect error "is not an array type"
@impure
fn test_scalar_parameter_refuses_an_array():
    std.println("{}", takes_a_scalar([1, 2, 3]))

// A return type refuses it too.  Where the body writes the array out,
// the signature and the brackets settle it between them and it is
// reported at the definition, so that case is in
// tests/output/array_return_type_static.ngpl rather than here.  What
// is left to run is a value whose shape the parameter does not fix:
fn hands_back_what_it_was_given(a : T') → u32:
    a

@test
@expect error "is not an array type"
@impure
fn test_scalar_return_refuses_an_array():
    std.println("{}", hands_back_what_it_was_given([1, 2, 3]))

// An array return type takes the literal that fits it.
fn returns_three() → u32[3]:
    [1, 2, 3]

@test
fn test_array_return_accepts_a_literal():
    assert_eq(#returns_three(), 3)

// --- The extent still has to match ----------------------------------

@test
@expect error "array size mismatch"
@impure
fn test_wrong_extent():
    let a : i32[3] = [1, 2]
    std.println("{}", a)

@test
@expect error "array size mismatch"
@impure
fn test_wrong_inner_extent():
    let m : i32[2,3] = [[1, 2, 3], [4, 5]]
    std.println("{}", m)

// ---------------------------------------------------------------------
// What threading hands back
// ---------------------------------------------------------------------

// A listable operator handed an array answers one for each of what it
// holds, so a signature promising a scalar is refused at the
// definition -- which, being a definition, is reported before anything
// runs and is checked by tests/output/threaded_return_type_static.
//
// The ones that do not thread are left alone: a fold answers one
// value, a length answers a number, and a subscript answers an
// element.
@test
fn test_what_does_not_thread_is_not_refused():
    let v : i64[] = [1, 2, 3]
    assert_eq(+⌿ v, 6)
    assert_eq(#v, 3¤ptrdiff)
    assert_eq(v[0], 1)

// A lambda states its own parameters and its own return type, so it is
// asked the same question, and the same answers are left alone.
@test
fn test_a_lambda_that_does_not_thread_is_not_refused():
    let v : i64[] = [1, 2, 3]
    let total := λa : i64[] → i64: +⌿ a
    let first := λa : i64[] → i64: a[0]
    let scalar := λn : i64 → bool: n > 3
    assert_eq(total(v), 6)
    assert_eq(first(v), 1)
    assert(scalar(5))

@start
@impure
fn main():
    std.println("array type tests passed")
