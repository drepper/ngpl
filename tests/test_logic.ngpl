// Tests for binary logic operations: ∧ ∨ ⊕ ⊼ ⊽ ¬
//
// These combine truth values: both operands must be bool, and the
// result is bool.  Anything else -- a number first of all -- is an
// error; the question a number means is written as a comparison.

// ---- ∧ (logic AND) ------------------------------------------------------

@test
fn test_and_true_true():
    assert(true ∧ true)

@test
fn test_and_true_false():
    assert(not (true ∧ false))

@test
fn test_and_false_true():
    assert(not (false ∧ true))

@test
fn test_and_false_false():
    assert(not (false ∧ false))

// ---- ∨ (logic OR) -------------------------------------------------------

@test
fn test_or_true_false():
    assert(true ∨ false)

@test
fn test_or_false_false():
    assert(not (false ∨ false))

@test
fn test_or_false_true():
    assert(false ∨ true)

// ---- ⊕ (logic XOR) -----------------------------------------------------

@test
fn test_xor_true_true():
    assert(not (true ⊕ true))

@test
fn test_xor_true_false():
    assert(true ⊕ false)

@test
fn test_xor_false_false():
    assert(not (false ⊕ false))

// ---- ⊼ (logic NAND) ----------------------------------------------------

@test
fn test_nand_true_true():
    assert(not (true ⊼ true))

@test
fn test_nand_true_false():
    assert(true ⊼ false)

@test
fn test_nand_false_false():
    assert(false ⊼ false)

// ---- ⊽ (logic NOR) -----------------------------------------------------

@test
fn test_nor_false_false():
    assert(false ⊽ false)

@test
fn test_nor_true_false():
    assert(not (true ⊽ false))

@test
fn test_nor_true_true():
    assert(not (true ⊽ true))

// ---- ¬ (logic NOT) ------------------------------------------------------

@test
fn test_not_true():
    assert(not (¬true))

@test
fn test_not_false():
    assert(¬false)

// ---- a number is not an answer -------------------------------------------
//
// The operands are truth values only.  An integer is refused by name,
// pointing the writer at the comparison that asks the question.

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_and_refuses_an_integer():
    let a : i32 = 42
    let b : i32 = 7
    assert(a ∧ b)

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_or_refuses_an_integer():
    let a : i32 = 0
    let b : i32 = 1
    assert(a ∨ b)

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_xor_refuses_an_integer():
    let a : i32 = 5
    let b : i32 = 3
    assert(not (a ⊕ b))

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_nand_refuses_an_integer():
    let a : i32 = 1
    let b : i32 = 1
    assert(not (a ⊼ b))

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_nor_refuses_an_integer():
    let a : i32 = 0
    let b : i32 = 0
    assert(a ⊽ b)

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_not_refuses_an_integer():
    let x : i32 = 100
    assert(not (¬x))

@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_not_keyword_refuses_an_integer():
    let x : i32 = 100
    assert(not x)

@expect error 2229 "a logic operator takes truth values, but this operand is u8; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_unsigned_is_refused_too():
    let a : u8 = 255
    assert(a ∧ a)

// The comparison asks the question the number was standing in for.
@test
fn test_the_comparison_asks_the_question():
    let a : i32 = 42
    let b : i32 = 0
    assert(a ≠ 0 ∧ b = 0)
    assert(a ≠ 0 ∨ b ≠ 0)

// ---- precedence: ∧ binds tighter than ∨ --------------------------------

@test
fn test_precedence_and_or():
    // false ∨ true ∧ true  =  false ∨ (true ∧ true)  =  true
    assert(false ∨ true ∧ true)
    // true ∧ false ∨ true  =  (true ∧ false) ∨ true  =  true
    assert(true ∧ false ∨ true)
    // true ∧ false ∨ false  =  (true ∧ false) ∨ false  =  false
    assert(not (true ∧ false ∨ false))

// ---- precedence: ⊕ is between ∧ and ∨ ----------------------------------

@test
fn test_precedence_xor():
    // true ∧ true ⊕ true ∧ true  =  (true ∧ true) ⊕ (true ∧ true)  =  false
    assert(not (true ∧ true ⊕ true ∧ true))

// ---- element-wise on arrays ---------------------------------------------

@test
fn test_and_array():
    let a : bool[3] = [true, false, true]
    let b : bool[3] = [true, false, false]
    let r := a ∧ b
    assert(r[0])
    assert(not r[1])
    assert(not r[2])

@test
fn test_or_array():
    let a : bool[3] = [true, false, false]
    let b : bool[3] = [false, false, true]
    let r := a ∨ b
    assert(r[0])
    assert(not r[1])
    assert(r[2])

@test
fn test_xor_array():
    let a : bool[3] = [true, false, true]
    let b : bool[3] = [true, false, false]
    let r := a ⊕ b
    assert(not r[0])
    assert(not r[1])
    assert(r[2])

// The elements are held to the same rule as scalars.
@expect error 2229 "a logic operator takes truth values, but this operand is i32; a number asks its question with a comparison, as 'x ≠ 0'"
fn error_integer_elements_are_refused():
    let a : mut i32[3] = 3 ⍴ 0
    a[0] ← 1
    let b : mut i32[3] = 3 ⍴ 0
    let r := a ∧ b
    assert(not r[1])

// ---- logic ops combined with comparison ---------------------------------

@test
fn test_logic_with_comparison():
    let x : i32 = 10
    let y : i32 = 20
    // (x < y) ∧ (y > 0)  =  true ∧ true  =  true
    assert(x < y ∧ y > 0)
    // (x > y) ∨ (y = 20)  =  false ∨ true  =  true
    assert(x > y ∨ y = 20)

@start
@impure
fn main():
    std.println("logic tests passed")
