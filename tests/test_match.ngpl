// Tests for ∃(VAL) and the match statement.
//
// ∃(v) is a present optional — Rust's Some(v).  It is how a program
// names one, whether to build it or to compare against it.  match
// dispatches on which of the two an optional is, binding the value in
// the present case.

// ---------------------------------------------------------------------
// ∃(VAL) builds and compares a present optional
// ---------------------------------------------------------------------

@test
fn test_exists_is_a_present_optional():
    let v := [10, 20]
    assert_eq(v.get(0), ∃(10))
    assert_eq(v.get(9), ∅)

// ∃ and the some keyword spell the same thing.
@test
fn test_exists_equals_some():
    assert(∃(5) == some(5))
    assert(∃(5) != ∅)

// It nests: an optional holding an optional is distinguishable.
@test
fn test_exists_nests():
    assert(∃(∅) != ∅)

// ---------------------------------------------------------------------
// An optional may not be compared with a plain value
// ---------------------------------------------------------------------
//
// The two are different things, and an equality that quietly looked
// through the optional would make `it.next() == 97` read as a test of
// the element when it is really a test of the element and of there
// being one at all.

@expect error "cannot compare an optional with a plain value"
fn error_compare_optional_with_plain():
    let v : mut = [1]
    assert(v.get(0) == 1)

@expect error "cannot compare an optional with a plain value"
fn error_assert_eq_optional_with_plain():
    let v : mut = [1]
    assert_eq(v.get(0), 1)

// ?? is the other way to get a plain value out.
@test
fn test_default_still_compares_plainly():
    let v := [1]
    assert_eq(v.get(0) ?? 0, 1)
    assert_eq(v.get(9) ?? 0, 0)

// ---------------------------------------------------------------------
// match on an optional
// ---------------------------------------------------------------------

@test
fn test_match_present_binds_the_value():
    let v := [42]
    let seen : mut = 0
    match v.get(0):
        ∃(x):
            seen ← x
        ∅:
            seen ← ⁻1
    assert_eq(seen, 42)

@test
fn test_match_absent():
    let v := []
    let seen : mut = 0
    match v.get(0):
        ∃(x):
            seen ← x
        ∅:
            seen ← ⁻1
    assert_eq(seen, ⁻1)

// A falsy value is still present, so it takes the ∃ arm.
@test
fn test_match_present_but_falsy():
    let v := [0]
    let took : mut = ""
    match v.get(0):
        ∃(x):
            took ← "present"
        ∅:
            took ← "absent"
    assert_eq(took, "present")

// The arms may be written in either order.
@test
fn test_match_arm_order():
    let v := [7]
    let seen : mut = 0
    match v.get(0):
        ∅:
            seen ← ⁻1
        ∃(x):
            seen ← x
    assert_eq(seen, 7)

// A single-statement arm may sit on the same line as its colon.
@test
fn test_match_inline_arms():
    let v := [3]
    let seen : mut = 0
    match v.get(0):
        ∃(x): seen ← x
        ∅: seen ← ⁻1
    assert_eq(seen, 3)

// _ matches whatever the earlier arms did not.
@test
fn test_match_wildcard():
    let v := []
    let took : mut = ""
    match v.get(0):
        ∃(x):
            took ← "present"
        _:
            took ← "anything else"
    assert_eq(took, "anything else")

// Matching an iterator drives a loop one step at a time.
@test
fn test_match_over_an_iterator():
    let v := [1, 2, 3]
    let it := v.iterate()
    let total : mut = 0
    let running : mut = true
    while running:
        match it.next():
            ∃(x):
                total ← total + x
            ∅:
                running ← false
    assert_eq(total, 6)

// ---------------------------------------------------------------------
// match on a result
// ---------------------------------------------------------------------
//
// ∃ covers both a present optional and a successful result: in each the
// question "was there a value" is answered yes.  ∄ is the failed result,
// which answers no and says why, where ∅ answers no and does not.

@test
fn test_match_result_ok():
    let seen : mut = 0
    match 10 ÷ 2:
        ∃(v):
            seen ← v
        ∄(e):
            seen ← ⁻1
    assert_eq(seen, 5)

@test
fn test_match_result_err_binds_the_error():
    let took : mut = ""
    match 10 ÷ 0:
        ∃(v):
            took ← "ok"
        ∄(e):
            assert_eq(e, std.errors.division_by_zero)
            took ← "err"
    assert_eq(took, "err")

// ∄(VAL) builds a failed result, which is how a function reports one.
fn checked(n : i64) → i64!:
    if n < 0:
        return ∄(std.errors.invalid_argument)
    n × 2

@test
fn test_explicit_error_return_ok_path():
    let seen : mut = 0
    match checked(5):
        ∃(v):
            seen ← v
        ∄(e):
            seen ← ⁻1
    assert_eq(seen, 10)

@test
fn test_explicit_error_return_err_path():
    let took : mut = ""
    match checked(⁻1):
        ∃(v):
            took ← "ok"
        ∄(e):
            assert_eq(e, std.errors.invalid_argument)
            took ← "err"
    assert_eq(took, "err")

// The error reaches ?? as well, so ∄ is a value like any other.
@test
fn test_explicit_error_with_default():
    assert_eq(checked(⁻1) ?? 0, 0)
    assert_eq(checked(5) ?? 0, 10)

// A wildcard covers a failure too.
@test
fn test_match_result_wildcard():
    let took : mut = ""
    match 10 ÷ 0:
        ∃(v):
            took ← "ok"
        _:
            took ← "anything else"
    assert_eq(took, "anything else")

// ∅ does not stand in for a failure: an absent value and a failed one
// are different answers.  Writing ∅ for a result is caught as the wrong
// pattern for the type, which is more use than being told an arm is
// missing.
@expect error "∅ cannot match a result"
fn error_absent_pattern_on_a_result():
    match 10 ÷ 0:
        ∃(v):
            std.println("{}", v)
        ∅:
            std.println("none")

// Nor does ∄ stand in for absence.
@expect error "cannot match an optional, whose absence is"
fn error_failure_pattern_on_an_optional():
    let v : mut = []
    match v.get(0):
        ∃(x):
            std.println("{}", x)
        ∄(e):
            std.println("err")

// ---------------------------------------------------------------------
// Coverage is checked when the function is defined
// ---------------------------------------------------------------------
//
// These functions are never run.  The gap is found from the shape of the
// code, so a match whose missing arm would only be reached on some
// unlucky input is reported all the same.

@expect error "match has no arm for ∅"
fn error_optional_missing_absent_arm():
    let v : mut = [1]
    match v.get(0):
        ∃(x):
            std.println("{}", x)

@expect error "match has no arm for a failed result"
fn error_result_missing_failure_arm():
    match 10 ÷ 2:
        ∃(v):
            std.println("{}", v)

// A function's declared return type says which shapes its value has.
fn returns_optional(n : i64) → i64?:
    if n < 0: return ∅
    n

@expect error "match has no arm for ∅"
fn error_missing_arm_through_a_call():
    match returns_optional(1):
        ∃(x):
            std.println("{}", x)

fn returns_result(n : i64) → i64!:
    if n < 0:
        return ∄(std.errors.invalid_argument)
    n

@expect error "match has no arm for a failed result"
fn error_missing_arm_through_a_result_call():
    match returns_result(1):
        ∃(x):
            std.println("{}", x)

// A plain value has only one shape, so one arm covers it.
fn returns_plain(n : i64) → i64:
    n × 2

@test
fn test_plain_subject_needs_one_arm():
    let seen : mut = 0
    match returns_plain(3):
        ∃(x):
            seen ← x
    assert_eq(seen, 6)

@expect error "∅ cannot match a plain value"
fn error_absent_pattern_on_a_plain_value():
    match returns_plain(3):
        ∃(x):
            std.println("{}", x)
        ∅:
            std.println("none")

// ---------------------------------------------------------------------
// Arms that can never be reached
// ---------------------------------------------------------------------
//
// These need no knowledge of the subject at all.

@expect error "match repeats the .* pattern"
fn error_duplicate_present_arm():
    let v : mut = [1]
    match v.get(0):
        ∃(x):
            std.println("{}", x)
        ∃(y):
            std.println("{}", y)
        ∅:
            std.println("none")

@expect error "match repeats the ∅ pattern"
fn error_duplicate_absent_arm():
    let v : mut = [1]
    match v.get(0):
        ∃(x):
            std.println("{}", x)
        ∅:
            std.println("none")
        ∅:
            std.println("again")

@expect error "match has arms after _"
fn error_arm_after_wildcard():
    let v : mut = [1]
    match v.get(0):
        _:
            std.println("anything")
        ∅:
            std.println("unreachable")

// ---------------------------------------------------------------------
// Where the subject's type is not knowable, the check is at run time
// ---------------------------------------------------------------------

// The subject is a variable, whose type the checker does not track, so
// the gap is found when the match runs instead.
@expect error "match has no arm for ∅"
fn error_unknown_subject_checked_at_run_time():
    let v : mut = []
    let x : mut = v.get(0)
    match x:
        ∃(y):
            std.println("{}", y)

// The bound name names the matched value, so it cannot be assigned to.
@expect error "cannot assign to match variable 'x'"
fn error_assign_to_match_binding():
    let v : mut = [1]
    match v.get(0):
        ∃(x):
            x ← 9
        ∅:
            std.println("none")

// A match that does not cover the value it is given is an error rather
// than a silent no-op.
@expect error "match has no arm for"
fn error_match_not_exhaustive():
    let v : mut = []
    match v.get(0):
        ∃(x):
            std.println("{}", x)

// ---------------------------------------------------------------------
// A subject whose type is written down
// ---------------------------------------------------------------------
//
// A parameter is where a type is written, so `match p` on one declared
// i32? is answerable before anything runs — the same answer a call to a
// function returning i32? gives.  Until this was read, a match on a
// parameter was left entirely to runtime and a missing arm went unsaid.

@expect error "match has no arm for ∅"
fn error_optional_parameter_missing_absent_arm(x : i64?):
    match x:
        ∃(v):
            std.println("{}", v)

@expect error "match has no arm for a failed result"
fn error_result_parameter_missing_failure_arm(r : i64!):
    match r:
        ∃(v):
            std.println("{}", v)

// The wrong pattern for the declared type is caught too.
@expect error "cannot match an optional, whose absence is"
fn error_failure_pattern_on_an_optional_parameter(x : i64?):
    match x:
        ∃(v):
            std.println("{}", v)
        ∄(e):
            std.println("err")

@expect error "∅ cannot match a result"
fn error_absent_pattern_on_a_result_parameter(r : i64!):
    match r:
        ∃(v):
            std.println("{}", v)
        ∅:
            std.println("none")

// A plain parameter has one shape, and a hint about failure would
// misdirect: it has none to write a different way.
@expect error "∅ cannot match a plain value"
fn error_absent_pattern_on_a_plain_parameter(n : i64):
    match n:
        ∃(v):
            std.println("{}", v)
        ∅:
            std.println("none")

// A covered match on a parameter is left alone.
fn describes(x : i64?) → str:
    match x:
        ∃(v):
            "present"
        ∅:
            "absent"

@test
fn test_a_covered_parameter_match_runs():
    assert_eq(describes(∃(1)), "present")
    assert_eq(describes(∅), "absent")

@test
fn test_a_wildcard_covers_a_parameter_match():
    let took : mut = 0
    match_with_wildcard(∃(7))
    assert_eq(took, 0)

fn match_with_wildcard(x : i64?):
    match x:
        _:
            std.println("anything")

// An untyped parameter says nothing, so nothing is claimed about it and
// the match is left to run.
fn untyped_subject(x):
    match x:
        ∃(v):
            std.println("{}", v)

@test
fn test_an_untyped_parameter_is_left_alone():
    untyped_subject(1)

// A let that writes a type says as much as a parameter does.
@expect error "match has no arm for ∅"
fn error_declared_local_missing_absent_arm():
    let x : i64? = 5
    match x:
        ∃(v):
            std.println("{}", v)

// A let without a type says nothing about which shapes the value has.
@test
fn test_an_inferred_local_is_left_alone():
    let x := 5
    match x:
        ∃(v):
            assert_eq(v, 5)

@start
fn main():
    std.println("match tests passed")
