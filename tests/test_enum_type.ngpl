// test_enum_type.ngpl -- an enum's name used as a type
//
// An enum names a type, so it can be written wherever a type can: a
// parameter, a return type, a binding, a struct field, an array
// element, an alias, and an alternative of a sum type.
//
// A parameter naming an enum takes that enum and nothing else.  The
// integer behind a member is not it, and neither is another enum.

enum Color:
    red
    green
    blue

enum Size:
    small
    large

enum Small : u8:
    a
    b

@flag
enum Perms:
    read
    write
    exec

// ---------------------------------------------------------------------
// Where an enum type may be written
// ---------------------------------------------------------------------

fn paint(c : Color) → Color:
    c

@test
fn test_parameter_and_return_type():
    assert_eq(paint(Color.blue), Color.blue)

@test
fn test_binding_annotation():
    let c : Color = Color.red
    assert_eq(c, Color.red)

type Hue = Color

@test
fn test_through_an_alias():
    let h : Hue = Color.green
    assert_eq(h, Color.green)

struct Item:
    hue : Color
    n : i32

@test
fn test_struct_field():
    let it := Item{hue: Color.green, n: 7}
    assert_eq(it.hue, Color.green)
    assert_eq(it.n, 7)

@test
fn test_array_of_enums():
    let arr : Color[3] = [Color.red, Color.green, Color.blue]
    assert_eq(arr[2], Color.blue)
    assert_eq(#arr, 3)

// A flag enum is a type in the same way, and a combination of its
// members is still a value of it.
fn count_perms(p : Perms) → Perms:
    p

@test
fn test_flag_enum_as_a_type():
    let both := Perms.read | Perms.write
    assert_eq(count_perms(both), both)

// ---------------------------------------------------------------------
// What an enum type admits
// ---------------------------------------------------------------------

@expect error "expected Color, got Size"
fn error_other_enum_rejected():
    _ ← paint(Size.small)

// A member compares equal to its integer, but the integer is not a
// value of the type.
@expect error "expected Color, got int"
fn error_integer_rejected():
    _ ← paint(0)

@expect error "'Color' is an enum, but the value is Size"
fn error_binding_rejects_other_enum():
    let c : Color = Size.large
    _ ← paint(c)

// ---------------------------------------------------------------------
// As an alternative of a sum type
// ---------------------------------------------------------------------

struct Circle:
    r : f64

type Paint = Color | Circle

fn describe(p : Paint) → str:
    match p:
        Color(c):   "a colour"
        Circle(s):  "a circle"

@test
fn test_enum_as_sum_alternative():
    assert_eq(describe(Color.red), "a colour")
    assert_eq(describe(Circle{r: 1.0}), "a circle")

@test
fn test_sum_binding_with_an_enum():
    let p : Paint = Color.blue
    assert_eq(describe(p), "a colour")

@expect error "'Paint' is Color . Circle, but the value is Size"
fn error_sum_rejects_other_enum():
    let p : Paint = Size.small
    _ ← describe(p)

// ---------------------------------------------------------------------
// A C representation
// ---------------------------------------------------------------------

// An enum is stored as an integer and lays out as that integer.  An
// enum that names no type is C's `int`, which is four bytes here.
@repr(C)
struct Plain:
    e : Color
    n : i32

@repr(C)
struct Sized:
    e : Small
    n : i32

@repr(C)
struct JustSmall:
    e : Small

@test
fn test_c_layout_of_a_plain_enum():
    assert_eq(@sizeof(Plain), 8)
    assert_eq(Plain.alignof, 4)

// u8 leaves three bytes of padding before the i32.
@test
fn test_c_layout_of_a_sized_enum():
    assert_eq(@sizeof(Sized), 8)
    assert_eq(Sized.alignof, 4)

@test
fn test_c_layout_of_a_sized_enum_alone():
    assert_eq(@sizeof(JustSmall), 1)
    assert_eq(JustSmall.alignof, 1)

// ---------------------------------------------------------------------
// A type may be declared below whatever names it
// ---------------------------------------------------------------------

fn uses_later(l : Later) → Later:
    l

enum Later:
    one
    two

@test
fn test_enum_declared_after_use():
    assert_eq(uses_later(Later.two), Later.two)

type AliasOfLater = Later

@test
fn test_alias_of_a_later_enum():
    let x : AliasOfLater = Later.one
    assert_eq(x, Later.one)

// An array's fill value has to be a member, and the diagnostic says
// what it was rather than naming the element type back.
@expect error "'Color' is an enum, but the value is int"
fn error_array_fill_is_not_a_member():
    let a : Color[3] = 0
    _ ← a

@start
@impure
fn main():
    std.println("enum type tests passed")
