// test_enum_type.ngpl -- an enum's name used as a type
//
// An enum names a type, so it can be written wherever a type can: a
// parameter, a return type, a binding, a struct field, an array
// element, an alias, and an alternative of a sum type.
//
// A parameter naming an enum takes that enum and nothing else.  The
// integer behind a member is not it, and neither is another enum.

enum Color:
    red
    green
    blue

enum Size:
    small
    large

enum Small : u8:
    a
    b

@flag
enum Perms:
    read
    write
    exec

// ---------------------------------------------------------------------
// Where an enum type may be written
// ---------------------------------------------------------------------

fn paint(c : Color) → Color:
    c

@test
fn test_parameter_and_return_type():
    assert_eq(paint(Color.blue), Color.blue)

@test
fn test_binding_annotation():
    let c : Color = Color.red
    assert_eq(c, Color.red)

type Hue = Color

@test
fn test_through_an_alias():
    let h : Hue = Color.green
    assert_eq(h, Color.green)

struct Item:
    hue : Color
    n : i32

@test
fn test_struct_field():
    let it := Item{hue: Color.green, n: 7}
    assert_eq(it.hue, Color.green)
    assert_eq(it.n, 7)

@test
fn test_array_of_enums():
    let arr : Color[3] = [Color.red, Color.green, Color.blue]
    assert_eq(arr[2], Color.blue)
    assert_eq(#arr, 3)

// A flag enum is a type in the same way, and a combination of its
// members is still a value of it.
fn count_perms(p : Perms) → Perms:
    p

@test
fn test_flag_enum_as_a_type():
    let both := Perms.read | Perms.write
    assert_eq(count_perms(both), both)

// ---------------------------------------------------------------------
// What an enum type admits
// ---------------------------------------------------------------------

@expect error 2017 "paint: argument 'c' expected Color, got Size"
fn error_other_enum_rejected():
    _ ← paint(Size.small)

// A normal enum is exhaustive: it holds exactly its members, so a
// number that is one member's value becomes that member, and any
// other number is refused by name.
@test
fn test_a_member_value_becomes_the_member():
    assert_eq(paint(0), Color.red)
    let c : Color = 1
    assert_eq(c, Color.green)

@expect error 2830 "paint: argument 'c': 'Color' holds exactly its members, and 7 is not one of them"
fn error_outside_number_rejected():
    _ ← paint(7)

@expect error 2828 "'Color' holds exactly its members, and 3 is not one of them"
fn error_outside_number_rejected_at_a_binding():
    let c : Color = 3
    _ ← paint(c)

// An enum is compared with its own kind.  What a member stands for is
// asked for with .ord(), and then it is a number being compared with a
// number, which is what the program said it meant.
@test
fn test_comparison_with_a_number_says_ord():
    let c : Color = Color.green
    assert_eq(c.ord() = 7, false)
    assert_eq(c.ord() ≠ 7, true)
    assert(c.ord() = 1)
    assert(c = Color.green)

// A @flag enum's values are combinations of members, which a bare
// number does not name, so a number is refused there regardless --
// and the refusal says which of the two reasons it is.
@expect error 2830 "count_perms: argument 'p': 'Perms' is a @flag enum, so its values are combinations of members that a bare number does not name"
fn error_flag_enum_still_rejects_numbers():
    _ ← count_perms(1)

// An enum is asked about its own kind and nothing else: a number that
// happens to equal a member is not that member, and .ord() is how a
// program says it means the number.
@expect error 2810 "an enum is asked about its own kind; the sides are Perms and u64; .ord() answers the number behind an enumerator"
fn error_an_enum_is_not_compared_with_a_number() → bool:
    Perms.read = 1

@expect error 2829 "'Color' is an enum, but the value is Size"
fn error_binding_rejects_other_enum():
    let c : Color = Size.large
    _ ← paint(c)

// ---------------------------------------------------------------------
// As an alternative of a sum type
// ---------------------------------------------------------------------

struct Circle:
    r : f64

type Paint = Color | Circle

fn describe(p : Paint) → str:
    match p:
        Color(c):   "a colour"
        Circle(s):  "a circle"

@test
fn test_enum_as_sum_alternative():
    assert_eq(describe(Color.red), "a colour")
    assert_eq(describe(Circle{r: 1.0}), "a circle")

@test
fn test_sum_binding_with_an_enum():
    let p : Paint = Color.blue
    assert_eq(describe(p), "a colour")

@expect error 2271 "'Paint' is Color | Circle, but the value is Size"
fn error_sum_rejects_other_enum():
    let p : Paint = Size.small
    _ ← describe(p)

// ---------------------------------------------------------------------
// A C representation
// ---------------------------------------------------------------------

// An enum is stored as an integer and lays out as that integer.  An
// enum that names no type stores its values in u64, eight bytes.
@repr(C)
struct Plain:
    e : Color
    n : i32

@repr(C)
struct Sized:
    e : Small
    n : i32

@repr(C)
struct JustSmall:
    e : Small

@test
fn test_c_layout_of_a_plain_enum():
    assert_eq(@sizeof(Plain), 16)
    assert_eq(Plain.alignof, 8)

// u8 leaves three bytes of padding before the i32.
@test
fn test_c_layout_of_a_sized_enum():
    assert_eq(@sizeof(Sized), 8)
    assert_eq(Sized.alignof, 4)

@test
fn test_c_layout_of_a_sized_enum_alone():
    assert_eq(@sizeof(JustSmall), 1)
    assert_eq(JustSmall.alignof, 1)

// ---------------------------------------------------------------------
// Every member fits the type the values are stored in
// ---------------------------------------------------------------------

// Under the default u64 a negative member does not fit; naming a
// signed underlying type is the fix.
enum Delta : i8:
    down = ⁻1
    hold = 0
    up = 1

@test
fn test_a_signed_underlying_type_holds_a_negative_member():
    let d : Delta = Delta.down
    assert_eq(d, Delta.down)
    assert(Delta.down.ord() = ⁻1)

// A member that does not fit is refused where the enum is defined,
// which is before anything runs; tests/output/enum_member_range_* hold
// the refusals.

// ---------------------------------------------------------------------
// A type may be declared below whatever names it
// ---------------------------------------------------------------------

fn uses_later(l : Later) → Later:
    l

enum Later:
    one
    two

@test
fn test_enum_declared_after_use():
    assert_eq(uses_later(Later.two), Later.two)

type AliasOfLater = Later

@test
fn test_alias_of_a_later_enum():
    let x : AliasOfLater = Later.one
    assert_eq(x, Later.one)

// An array's fill value follows the same exhaustiveness: a member's
// value fills with that member, an outside number is refused.
@test
fn test_array_fill_with_a_member_value():
    let a : Color[3] = 3 ⍴ 0
    assert_eq(a[0], Color.red)
    assert_eq(a[2], Color.red)

@expect error 2828 "'Color' holds exactly its members, and 9 is not one of them"
fn error_array_fill_outside_the_members():
    let a : Color[3] = 3 ⍴ 9
    _ ← a

@start
@impure
fn main():
    std.println("enum type tests passed")
