fn double(n : i64) → i64:
    n × 2

double(21)
fn fact(n : i64) → i64:
    let acc : mut i64 = 1
    foreach i := 1…n + 1:
        acc ← acc × i
    acc

fact(5)
struct Point:
    x : i64
    y : i64

impl Point:
    fn sum(&self) → i64:
        self.x + self.y

let p := Point { x: 3, y: 4 }
p
p.x
p.sum()
enum Color:
    red
    green

Color.green
type Small = u8
let b : Small = 7
b
unit tick
let t ¤tick : i64 = 5
t
