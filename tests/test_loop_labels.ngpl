// Tests for leaving a loop and going round it again, and for naming a
// loop so that an inner one can act on an outer.
//
// A name written on the line above a loop is that loop's name.  break
// and continue take one, and where they take none they act on the loop
// they sit directly inside.

// ---------------------------------------------------------------------
// Without a name
// ---------------------------------------------------------------------

@test
fn test_break_leaves_the_loop_it_is_in():
    let n : mut i64 = 0
    while n < 100:
        n ← n + 1
        if n = 5:
            break
    assert_eq(n, 5)

@test
fn test_continue_goes_round_again():
    let sum : mut i64 = 0
    foreach i := 1…10:
        if i % 2 = 0:
            continue
        sum ← sum + i
    assert_eq(sum, 25)

@test
fn test_break_in_a_foreach():
    let seen : mut i64 = 0
    foreach i := 1…10:
        if i > 3:
            break
        seen ← seen + 1
    assert_eq(seen, 3)

// An unnamed break acts on the loop it sits directly inside, which is
// the innermost one -- the outer one goes round again.
@test
fn test_an_unnamed_break_leaves_only_the_inner_loop():
    let count : mut i64 = 0
    foreach i := 1…3:
        foreach j := 1…3:
            if j = 2:
                break
            count ← count + 1
    assert_eq(count, 3)

// ---------------------------------------------------------------------
// With a name
// ---------------------------------------------------------------------

// The whole point: one statement inside two loops, leaving both.
@test
fn test_a_named_break_leaves_the_loop_it_names():
    let count : mut i64 = 0
    outer:
    foreach i := 1…3:
        foreach j := 1…3:
            if i = 2:
                break outer
            count ← count + 1
    assert_eq(count, 3)

@test
fn test_a_named_continue_takes_the_outer_loop_round_again():
    let count : mut i64 = 0
    rows:
    foreach i := 1…3:
        foreach j := 1…3:
            if j = 2:
                continue rows
            count ← count + 1
    assert_eq(count, 3)

// A name may be written on a loop with nothing to name it from -- it
// then reads as documentation, and its own break may use it.
@test
fn test_a_loop_may_name_itself():
    let n : mut i64 = 0
    counting:
    while n < 100:
        n ← n + 1
        if n = 7:
            break counting
    assert_eq(n, 7)

@test
fn test_a_name_on_a_while_loop():
    let found : mut i64 = 0
    let i : mut i64 = 0
    search:
    while i < 5:
        i ← i + 1
        let j : mut i64 = 0
        while j < 5:
            j ← j + 1
            if i × j = 6:
                found ← i × 10 + j
                break search
    assert_eq(found, 23)

// Three deep, leaving the outermost from the innermost.
@test
fn test_a_name_reaches_past_more_than_one_loop():
    let count : mut i64 = 0
    top:
    foreach i := 1…3:
        foreach j := 1…3:
            foreach k := 1…3:
                count ← count + 1
                if count = 4:
                    break top
    assert_eq(count, 4)

// The name belongs to the loop below it whichever loop that is, so an
// inner one may be named and an outer one not.
@test
fn test_only_the_inner_loop_is_named():
    let count : mut i64 = 0
    foreach i := 1…3:
        inner:
        foreach j := 1…3:
            if j = 2:
                continue inner
            count ← count + 1
    assert_eq(count, 6)

// ---------------------------------------------------------------------
// Where the loop walks something
// ---------------------------------------------------------------------

@test
fn test_break_out_of_a_walk_over_an_array():
    let v : i64[] = [4, 5, 6, 7]
    let found : mut i64 = 0
    foreach x := v:
        if x > 5:
            found ← x
            break
    assert_eq(found, 6)

@test
fn test_a_named_break_out_of_a_search_over_two_arrays():
    let a : i64[] = [1, 2, 3]
    let b : i64[] = [10, 20, 30]
    let hit : mut i64 = 0
    search:
    foreach x := a:
        foreach y := b:
            if x + y = 22:
                hit ← x × 100 + y
                break search
    assert_eq(hit, 220)

// ---------------------------------------------------------------------
// What is refused
// ---------------------------------------------------------------------

@test
@expect error 2292 "break is written outside any loop, so there is no loop for it to act on"
fn error_break_outside_a_loop():
    let n : mut i64 = 1
    break

@test
@expect error 2292 "continue is written outside any loop, so there is no loop for it to act on"
fn error_continue_outside_a_loop():
    let n : mut i64 = 1
    continue

@test
@expect error 2293 "break names the loop 'inner', which is not one it is inside; the loops here are named outer"
fn error_a_name_no_loop_here_has():
    let count : mut i64 = 0
    outer:
    foreach i := 1…3:
        break inner

// A loop around a lambda is not one the lambda's body can leave: the
// body is a function of its own.
@test
@expect error 2292 "break is written outside any loop, so there is no loop for it to act on"
fn error_break_inside_a_lambda():
    foreach i := 1…3:
        let f := λx : i64 → i64:
            break
            x

// A name exists to be taken by a break or a continue.  One that
// nothing takes says the loop is left from within when it is not.
@test
@expect warning 2911 "the loop is named 'outer' and nothing inside it takes the name; a break or a continue reaches an outer loop by naming it"
fn warn_a_name_nothing_takes():
    let count : mut i64 = 0
    outer:
    foreach i := 1…3:
        foreach j := 1…3:
            if j = 2:
                break
            count ← count + 1
    assert_eq(count, 3)

// A lambda body cannot leave a loop outside it, so a break written
// there does not count as taking the name.
@test
@expect warning 2911 "the loop is named 'outer' and nothing inside it takes the name; a break or a continue reaches an outer loop by naming it"
fn warn_a_name_only_a_lambda_would_take():
    let count : mut i64 = 0
    outer:
    foreach i := 1…3:
        let f := λx : i64 → i64:
            x + 1
        count ← count + f(i)
    assert_eq(count, 9)

// Naming both and taking only the outer leaves the inner one unused.
@test
@expect warning 2911 "the loop is named 'inner' and nothing inside it takes the name; a break or a continue reaches an outer loop by naming it"
fn warn_only_one_of_two_names_is_taken():
    let count : mut i64 = 0
    outer:
    foreach i := 1…3:
        inner:
        foreach j := 1…3:
            if j = 2:
                break outer
            count ← count + 1
    assert_eq(count, 1)

// Neither comes back, so what follows one is written to be run and
// never will be.
@test
@expect warning 2291 "this statement cannot be reached: the one above it does not come back"
fn warn_a_statement_after_a_break():
    let n : mut i64 = 0
    foreach i := 1…3:
        break
        n ← n + 1

@test
@expect warning 2291 "this statement cannot be reached: the one above it does not come back"
fn warn_a_statement_after_a_continue():
    let n : mut i64 = 0
    foreach i := 1…3:
        continue
        n ← n + 1

@start
@impure
fn main():
    std.println("loop label tests passed")
