// test_int_width.ngpl -- integer types that state their own bit width
//
// An integer type may state any width rather than pick from a fixed
// set: i7, u13, i127 are types in the same way i32 is.  The width is
// read from the name, so the range, the wrapping, and the shift bound
// all follow from it.
//
// The named types are the ones that carry a name instead of a width:
// byte, usize, and the fast variants.

// ---------------------------------------------------------------------
// A stated width is a type
// ---------------------------------------------------------------------

@test
fn test_odd_widths_hold_their_range() → ∅:
    let a : u7 = 127
    let b : i7 = 63
    let c : u13 = 8191
    let d : u1 = 1
    assert_eq(a, 127)
    assert_eq(b, 63)
    assert_eq(c, 8191)
    assert_eq(d, 1)

@test
fn test_wide_widths() → ∅:
    let a : i127 = 85070591730234615865843651857942052863
    let b : u128 = 340282366920938463463374607431768211455
    assert_eq(a, 85070591730234615865843651857942052863)
    assert_eq(b, 340282366920938463463374607431768211455)

// ---------------------------------------------------------------------
// The range follows from the width
// ---------------------------------------------------------------------

// A signed type spends one bit on the sign, so i7 reaches 63 and not
// 127.  Going past is an overflow, as it is for the named types.
@test
@expect error "does not fit in i7 .range -64..63."
fn error_signed_above_its_range() → ∅:
    let a : i7 = 64

@test
@expect error "does not fit in i7 .range -64..63."
fn error_signed_below_its_range() → ∅:
    let a : i7 = ⁻65

// An unsigned type wraps, as the named unsigned types do.
@test
fn test_unsigned_wraps_at_its_width() → ∅:
    let a : u7 = 128
    let b : u7 = 129
    let c : u1 = 2
    assert_eq(a, 0)
    assert_eq(b, 1)
    assert_eq(c, 0)

// A signed type spends a bit on the sign, so a one-bit one would
// have none left for the value and names no type.
@test
@expect error "unknown type 'i1'"
fn error_one_bit_signed() → ∅:
    let a : i1 = 0

// A variable holds at most 128 bits, and the sign counts against
// that, so u128 is the widest unsigned type and i127 the widest
// signed one.
@test
@expect error "unknown type 'u129'"
fn error_wider_than_a_variable() → ∅:
    let a : u129 = 0

@test
@expect error "unknown type 'i128'"
fn error_signed_wider_than_a_variable() → ∅:
    let a : i128 = 0

// ---------------------------------------------------------------------
// Arithmetic
// ---------------------------------------------------------------------

// The wider type wins, as it does among the named ones.
@test
fn test_the_wider_width_wins() → ∅:
    let a : u7 = 100
    let b : u13 = 5000
    let sum := a + b
    static_assert_eq(@typeof(sum), u13)
    assert_eq(sum, 5100)

@test
fn test_arithmetic_wraps_within_the_width() → ∅:
    let a : u7 = 100
    let b : u7 = 100
    assert_eq(a + b, 72)

// ---------------------------------------------------------------------
// A shift is bounded by the value bits, whatever the width
// ---------------------------------------------------------------------

@test
fn test_shift_within_the_value_bits() → ∅:
    let a : u7 = 1
    let b : i7 = 1
    assert_eq(a « 6, 64)
    assert_eq(b « 5, 32)

@test
@expect error "moves every value bit out"
fn error_shift_past_an_unsigned_width() → ∅:
    let a : u7 = 1
    _ ← a « 7

// A signed type has one value bit fewer, so it stops one earlier.
@test
@expect error "moves every value bit out"
fn error_shift_past_a_signed_width() → ∅:
    let a : i7 = 1
    _ ← a « 6

// ---------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------

// A stated width occupies the whole bytes it takes to hold it.
@test
fn test_storage_is_whole_bytes() → ∅:
    static_assert_eq(@sizeof(u1), 1 ¤byte)
    static_assert_eq(@sizeof(u7), 1 ¤byte)
    static_assert_eq(@sizeof(u13), 2 ¤byte)
    static_assert_eq(@sizeof(i127), 16 ¤byte)
    static_assert_eq(@sizeof(u128), 16 ¤byte)

@test
fn test_type_name_and_sizeof_of_a_binding() → ∅:
    let a : u7 = 5
    static_assert_eq(@typeof(a), u7)
    static_assert_eq(@sizeof(a), 1 ¤byte)

// A stated width names a type, so it is not available for anything
// else.
@test
@expect error "'u7' names a type and cannot name a variable"
fn error_width_cannot_name_a_variable() → ∅:
    let u7 := 5

// A width of zero holds no values, so it names no type.
@test
@expect error "unknown type 'u0'"
fn error_zero_width() → ∅:
    let a : u0 = 0

@start
fn main() → ∅:
    std.println("integer width tests passed")
