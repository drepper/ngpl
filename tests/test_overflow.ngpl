// Tests for integer overflow/underflow detection.
//
// Unsigned types wrap silently (modular arithmetic).
// Signed types and untyped-to-signed coercion raise OverflowError.

// ---- static: assignment overflow -----------------------------------------

@expect error 2279 "integer overflow: 128 does not fit in i8 (range -128..127)"
fn error_i8_too_large():
    let x : mut i8 = 128

@expect error 2279 "integer underflow: -129 does not fit in i8 (range -128..127)"
fn error_i8_too_small():
    let x : mut i8 = ⁻129

@expect error 2279 "integer overflow: 32768 does not fit in i16 (range -32768..32767)"
fn error_i16_too_large():
    let x : mut i16 = 32768

@expect error 2279 "integer overflow: 2147483648 does not fit in i32 (range -2147483648..2147483647)"
fn error_i32_too_large():
    let x : mut i32 = 2147483648

@expect error 2279 "integer overflow: 9223372036854775808 does not fit in i64 (range -9223372036854775808..9223372036854775807)"
fn error_i64_too_large():
    let x : mut i64 = 9223372036854775808

// ---- a literal the type its suffix names cannot hold --------------------
//
// A suffix says what type the number is, so a number the type cannot
// hold is a mistake in the literal.  It is reported at the definition,
// whether or not the code holding it ever runs; the uncalled case is
// tests/output/integer_literal_uncalled.ngpl, since a function that
// draws an error cannot also be a test.

@expect error 2294 "integer overflow: 300 does not fit in u8 (range 0..255)"
fn error_u8_literal():
    let x := 300u8

@expect error 2294 "integer overflow: 128 does not fit in i8 (range -128..127)"
fn error_i8_literal():
    let x := 128i8

@expect error 2294 "integer overflow: 65536 does not fit in u16 (range 0..65535)"
fn error_u16_literal():
    let x := 65536u16

// An arbitrary width answers the same way.
@expect error 2294 "integer overflow: 8 does not fit in u3 (range 0..7)"
fn error_u3_literal():
    let x := 8u3

// The base a literal is written in does not change what it is worth.
@expect error 2294 "integer overflow: 65535 does not fit in u8 (range 0..255)"
fn error_hex_literal():
    let x := 0xffffu8

@expect error 2294 "integer overflow: 256 does not fit in u8 (range 0..255)"
fn error_binary_literal():
    let x := 0b100000000u8

// A literal without a suffix is untyped, so it has no range of its
// own to leave: it is exact while it is being computed with, and the
// type it is used at is what it has to fit.
@test
fn test_an_untyped_literal_has_no_range_of_its_own():
    static_assert(340282366920938463463374607431768211456 > 0)
    static_assert(340282366920938463463374607431768211455
                  < 340282366920938463463374607431768211456)

@test
fn test_a_literal_the_type_holds_is_held():
    let a := 255u8
    let b := 127i8
    let c := 7u3
    assert_eq(a, 255)
    assert_eq(b, 127)
    assert_eq(c, 7)

// ---- ⁻ against a literal is part of the literal -------------------------
//
// Read the other way, the positive half would have to hold the value
// on the way to holding the negative one, and the lowest value of
// every signed type would be unwritable.

@test
fn test_the_lowest_value_of_a_signed_type_can_be_written():
    let a := ⁻128i8
    let b := ⁻32768i16
    let c := ⁻2147483648i32
    assert_eq(a, ⁻128)
    assert_eq(b, ⁻32768)
    assert_eq(c, ⁻2147483648)

// One past it is still one past it.
@expect error 2294 "integer underflow: -129 does not fit in i8 (range -128..127)"
fn error_below_the_lowest_i8():
    let x := ⁻129i8

// Only a literal the ⁻ is written directly against is part of it.  In
// ⁻2↑2 the ↑ takes the 2 first, so the ⁻ applies to the power.
@test
fn test_a_negation_of_an_expression_is_still_a_negation():
    assert_eq(⁻2↑2, ⁻4)

// ---- static: an unsigned type refuses what it cannot hold ---------------

@test
@expect error 2279 "integer overflow: 256 does not fit in u8 (range 0..255)"
fn error_u8_too_large_on_assign():
    let x : u8 = 256

@test
@expect error 2279 "integer underflow: -1 does not fit in u8 (range 0..255)"
fn error_u8_negative_on_assign():
    let x : u8 = ⁻1

@test
@expect error 2279 "integer overflow: 4294967296 does not fit in u32 (range 0..4294967295)"
fn error_u32_too_large_on_assign():
    let x : u32 = 4294967296

// ---- dynamic: signed arithmetic overflow ---------------------------------

@expect error 2279 "integer overflow: 128 does not fit in i8 (range -128..127)"
fn error_i8_add_overflow():
    let x : mut i8 = 127
    let y : mut i8 = 1
    let z : mut = x + y

@expect error 2279 "integer underflow: -129 does not fit in i8 (range -128..127)"
fn error_i8_sub_underflow():
    let x : mut i8 = ⁻128
    let y : mut i8 = 1
    let z : mut = x - y

@expect error 2279 "integer overflow: 40000 does not fit in i16 (range -32768..32767)"
fn error_i16_mul_overflow():
    let x : mut i16 = 200
    let y : mut i16 = 200
    let z : mut = x × y

@expect error 2279 "integer overflow: 2147483648 does not fit in i32 (range -2147483648..2147483647)"
fn error_i32_add_overflow():
    let x : mut i32 = 2147483647
    let y : mut i32 = 1
    let z : mut = x + y

@expect error 2279 "integer overflow: 2147483648 does not fit in i32 (range -2147483648..2147483647)"
fn error_i32_negate_min():
    let x : mut i32 = ⁻2147483648
    let z : mut = ⁻x

// ---- dynamic: unsigned arithmetic leaves its range -----------------------
//
// A width is what a program says a value stays inside, so leaving that
// range is reported for an unsigned type as much as a signed one.
// Going below zero is the way an unsigned type is usually left, and
// the diagnostic says "underflow" so that reads at once.

@test
@expect error 2279 "integer overflow: 256 does not fit in u8 (range 0..255)"
fn error_u8_add_overflow():
    let x : u8 = 255
    let y : u8 = 1
    let z := x + y

@test
@expect error 2279 "integer underflow: -1 does not fit in u8 (range 0..255)"
fn error_u8_sub_underflow():
    let x : u8 = 0
    let y : u8 = 1
    let z := x - y

@test
@expect error 2279 "integer overflow: 4294967296 does not fit in u32 (range 0..4294967295)"
fn error_u32_add_overflow():
    let x : u32 = 4294967295
    let y : u32 = 1
    let z := x + y

@test
@expect error 2279 "integer overflow: 4294967296 does not fit in u32 (range 0..4294967295)"
fn error_u32_mul_overflow():
    let x : u32 = 65536
    let y : u32 = 65536
    let z := x × y

// ---- @wrap is how wrapping is asked for ----------------------------------
//
// Modular arithmetic is still available, and now says so where it is
// meant.  SHA-256 is written this way.

@test
fn test_wrap_gives_modular_addition():
    let x : u8 = 255
    let y : u8 = 1
    assert_eq(@wrap(x + y), 0)

@test
fn test_wrap_gives_modular_subtraction():
    let x : u8 = 0
    let y : u8 = 1
    assert_eq(@wrap(x - y), 255)

@test
fn test_wrap_gives_modular_multiplication():
    let x : u32 = 65536
    let y : u32 = 65536
    assert_eq(@wrap(x × y), 0)

// ---- boundary values: signed types ---------------------------------------

@test
fn test_i8_max():
    let x : i8 = 127
    assert_eq(x, 127)

@test
fn test_i8_min():
    let x : i8 = ⁻128
    assert_eq(x, ⁻128)

@test
fn test_i32_max():
    let x : i32 = 2147483647
    assert_eq(x, 2147483647)

@test
fn test_i32_min():
    let x : i32 = ⁻2147483648
    assert_eq(x, ⁻2147483648)

// ---- bitwise ops always wrap (not overflow) ------------------------------

@test
fn test_bitwise_not_i8():
    let x : i8 = 0
    let y := ~x
    assert_eq(y, ⁻1)

@test
fn test_shift_left_wraps():
    let x : u8 = 128
    let s : u8 = 1
    let y := x « s
    assert_eq(y, 0)

// ---------------------------------------------------------------------
// A shift keeps the type it is given
// ---------------------------------------------------------------------

// The count says how far to move the bits, not what type to become,
// so the result is the type of what was shifted.
@test
fn test_shift_keeps_the_operand_type():
    let b : byte = 3
    let left := b « 4
    let right := b » 1
    static_assert_eq(@typeof(left), byte)
    static_assert_eq(@typeof(right), byte)
    static_assert_eq(@sizeof(left), 1 ¤byte)
    let u : u32 = 3
    let wide := u « 24
    static_assert_eq(@typeof(wide), u32)
    static_assert_eq(@sizeof(wide), 4 ¤byte)

@test
fn test_shift_within_the_width():
    let b : byte = 3
    assert_eq(b « 4, 48)
    assert_eq(b » 1, 1)
    let u : u32 = 1
    assert_eq(u « 31, 2147483648)

// A count that reaches the value bits would shift every one of them
// out.  Where the count is written down and the type is declared, that
// is settled before anything runs and is reported then.
@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_shift_past_the_width_is_a_compile_error():
    let b : byte = 3
    _ ← b « 8

@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_shift_right_past_the_width_is_a_compile_error():
    let u : u32 = 1
    _ ← u » 32

// A count that is not written down cannot be judged in advance, so
// that shift reports when it runs.
fn shift_by(n : i64) → i64:
    let b : byte = 3
    match b « n:
        ⊨(v):  v
        ⊭(e):  ⁻1

@test
fn test_runtime_count_reports_when_it_runs():
    assert_eq(shift_by(4), 48)
    assert_eq(shift_by(8), ⁻1)

// An untyped integer has no width for a count to pass.
@test
fn test_shift_of_an_untyped_integer():
    let n : i64 = 1
    assert_eq(n « 40, 1099511627776)

// The error can be recovered from, as division by zero can.
fn recover_with(n : i64) → i64:
    let b : byte = 3
    (b « n) ?? 99

@test
fn test_shift_error_recovers():
    assert_eq(recover_with(8), 99)
    assert_eq(recover_with(4), 48)

// ---------------------------------------------------------------------
// A rotation turns within the operand's own width
// ---------------------------------------------------------------------

// A rotation is paired with the shift that goes the same way: ↻
// turns the way « moves, and ↺ the way » does.  Where nothing
// falls off the end the two agree exactly.
@test
fn test_rotation_agrees_with_the_shift_it_matches():
    let a : u8 = 2
    assert_eq(a ↻ 1, a « 1)
    assert_eq(a ↺ 1, a » 1)
    assert_eq(a ↻ 1, 4)
    assert_eq(a ↺ 1, 1)

// They part company once a bit would leave the value: the shift drops
// it, the rotation brings it round.
@test
fn test_they_part_where_a_bit_would_be_lost():
    let high : u8 = 128
    let low : u8 = 1
    assert_eq(high ↻ 1, 1)
    assert_eq(high « 1, 0)
    assert_eq(low ↺ 1, 128)
    assert_eq(low » 1, 0)

// The bits turn within the confines of the declared type, so the type
// does not change.
@test
fn test_rotation_turns_within_the_width():
    let a : u8 = 1
    let turned := a ↻ 1
    static_assert_eq(@typeof(turned), u8)
    assert_eq(turned, 2)
    assert_eq(a ↺ 1, 128)

// A count that turns all the way round is where it started, so it is
// masked rather than refused.  This is where a rotation parts company
// with a shift, which would have lost every bit.
@test
fn test_rotation_masks_the_count():
    let a : u8 = 1
    assert_eq(a ↻ 8, 1)
    assert_eq(a ↻ 9, 2)
    assert_eq(a ↻ 17, 2)

// The width need not be a power of two for the count to be taken
// modulo it.
@test
fn test_rotation_at_an_odd_width():
    let a : u7 = 1
    let b : u7 = 64
    assert_eq(a ↺ 1, 64)
    assert_eq(a ↺ 7, 1)
    assert_eq(a ↺ 8, 64)
    assert_eq(b ↻ 1, 1)

// A signed type turns its whole representation, sign bit and all.
@test
fn test_rotation_of_a_signed_type():
    let a : i8 = 1
    assert_eq(a ↺ 1, ⁻128)

// An untyped integer has no width for the bits to come round in.
@test
@expect error 2228 "rotate-left: 'untyped' has no width to turn within; rotate a sized integer"
fn error_rotation_without_a_width():
    // A literal has not settled on a width, and a rotation is about
    // the bits of one.
    _ ← 1 ↻ 1

// ---------------------------------------------------------------------
// A signed type has one value bit fewer
// ---------------------------------------------------------------------

// The top bit of a signed type carries the sign rather than part of
// the value, so an i8 holds seven value bits and seven is already too
// far.
@test
fn test_shift_within_the_value_bits():
    let i : i8 = 1
    let u : u8 = 1
    let b : byte = 1
    assert_eq(i « 6, 64)
    assert_eq(u « 7, 128)
    assert_eq(b « 7, 128)

@test
fn test_wider_types_keep_the_one_bit_difference():
    let s : i32 = 1
    let u : u32 = 1
    assert_eq(s « 30, 1073741824)
    assert_eq(u « 31, 2147483648)

@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_signed_shift_stops_one_earlier():
    let i : i8 = 1
    _ ← i « 7

@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_signed_32_stops_one_earlier():
    let s : i32 = 1
    _ ← s « 31

// A right shift is bounded the same way: past the value bits there is
// nothing of the value left.
@test
fn test_signed_right_shift_within_range():
    let i : i8 = 64
    assert_eq(i » 6, 1)

@test
@expect error 2289 "this shift moves every value bit out, so it can only fail; the count is too far for the type shifted"
fn test_signed_right_shift_stops_one_earlier():
    let i : i8 = 64
    _ ← i » 7

@start
@impure
fn main():
    std.println("overflow tests passed")
