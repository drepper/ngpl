// Tests for a floating-point value a type cannot hold.
//
// A number past the top of a float format becomes an infinity, and one
// past the bottom becomes a zero.  Either way it is a different number
// from the one meant, so it is reported rather than computed with --
// where the value is written down (a literal, a binding, an argument,
// a field, a return) and where an operation produces it.
//
// A literal is refused before the program runs, so those cases are in
// tests/output/float_literal_overflow_*.ngpl, one to a file: the file
// does not get as far as having a test in it.

// ---------------------------------------------------------------------
// A binding whose type cannot hold the value
// ---------------------------------------------------------------------

@test
fn test_f32_binding():
    @expect error "float overflow.*does not fit in f32"
    let a : f32 = 1e39
    assert(true)

@test
fn test_f16_binding():
    @expect error "float overflow.*does not fit in f16"
    let a : f16 = 70000.0
    assert(true)

@test
fn test_bfloat16_binding():
    @expect error "float overflow.*does not fit in bfloat16"
    let a : bfloat16 = 1e39
    assert(true)

// The sign does not change the answer.
@test
fn test_a_negative_value():
    @expect error "float overflow.*does not fit in f32"
    let a : f32 = ⁻1e39
    assert(true)

// The other end of the range is the same mistake: the value is not
// zero, and zero is what the narrower format would hold.
@test
fn test_f32_binding_underflows():
    @expect error "float underflow.*too small for f32"
    let a : f32 = 1e-50
    assert(true)

@test
fn test_f16_binding_underflows():
    @expect error "float underflow.*too small for f16"
    let a : f16 = 1e-9
    assert(true)

@test
fn test_bfloat16_binding_underflows():
    @expect error "float underflow.*too small for bfloat16"
    let a : bfloat16 = 1e-50
    assert(true)

// A value the narrower format still holds is held, subnormals
// included: only reaching zero loses it.
@test
fn test_a_subnormal_is_narrow_enough():
    let a : f32 = 1e-44
    assert(a > 0.0)

// f64 is the widest format the bootstrap has, so a value that
// overflows it cannot be reached from another float -- only written,
// which the literal tests cover.

// ---------------------------------------------------------------------
// Every other place a value is written down
// ---------------------------------------------------------------------

fn takes_f32(v : f32) → f32:
    v

@test
fn test_an_argument():
    @expect error "float overflow.*does not fit in f32"
    let a := takes_f32(1e39)
    assert(true)

fn hands_back_f32() → f32:
    1e39

@test
fn test_a_return_value():
    @expect error "float overflow.*does not fit in f32"
    let a := hands_back_f32()
    assert(true)

struct Sized:
    v : f32

@test
fn test_a_struct_field():
    @expect error "float overflow.*does not fit in f32"
    let s := Sized{v: 1e39}
    assert(true)

@test
fn test_an_array_element():
    @expect error "float overflow.*does not fit in f32"
    let v : f32[] = [1.0, 1e39]
    assert(true)

// Underflow reaches every one of them too.
@test
fn test_an_argument_underflows():
    @expect error "float underflow.*too small for f32"
    let a := takes_f32(1e-50)
    assert(true)

// ---------------------------------------------------------------------
// What is still allowed
// ---------------------------------------------------------------------

// The largest value each format holds is a value it holds.
@test
fn test_the_largest_value_is_accepted():
    let a : f32 = 3.4028234663852886e38
    let b : f16 = 65504.0
    let c : f64 = 1.7976931348623157e308
    assert(a > 3.4e38)
    assert(b = 65504.0)
    assert(c > 1.7e308)

// A value the format rounds to something it can hold is held: only
// becoming an infinity is refused.
@test
fn test_rounding_within_the_range_is_not_overflow():
    let a : f32 = 3.4028234e38
    assert(a > 3.4e38)

// A signature that names a float width settles the value on it, so a
// wider value is rounded on the way out rather than travelling as it
// was written.
fn rounded_to_f32() → f32:
    0.1

@test
fn test_a_return_type_settles_the_width():
    // 0.1 is not exact in either format, and the two are not the same
    // number; what leaves the function is the f32 one.
    assert(rounded_to_f32() != 0.1)
    assert(rounded_to_f32() > 0.09999)
    assert(rounded_to_f32() < 0.10001)

// ---------------------------------------------------------------------
// An operation whose result the type cannot hold
// ---------------------------------------------------------------------
//
// The same rule as for a value written down, and the rule integer
// arithmetic already follows: a result that would be an infinity or a
// vanished zero is reported rather than handed back.

@test
fn test_multiplication_overflows():
    @expect error "float overflow.*does not fit in f64"
    let a := 3e300f64 × 3e300f64
    assert(true)

@test
fn test_addition_overflows():
    @expect error "float overflow.*does not fit in f64"
    let a := 1e308f64 + 1e308f64
    assert(true)

@test
fn test_a_power_overflows():
    @expect error "float overflow.*does not fit in f64"
    let a := 1e300f64 ↑ 3.0f64
    assert(true)

// The narrower the format, the sooner it happens; the operands here
// are values f64 holds without trouble.
@test
fn test_a_narrow_format_overflows():
    @expect error "float overflow.*does not fit in f32"
    let a := 3e38f32 × 3.0f32
    assert(true)

@test
fn test_f16_overflows():
    @expect error "float overflow.*does not fit in f16"
    let a := 60000f16 + 60000f16
    assert(true)

// Underflow is the same mistake at the other end: the result is not
// zero, and zero is what the format would hold.
@test
fn test_multiplication_underflows():
    @expect error "float underflow.*too small for f64"
    let a := 1e-300f64 × 1e-300f64
    assert(true)

@test
fn test_division_underflows():
    @expect error "float underflow.*too small for f64"
    let a := 1e-300f64 ÷ 1e300f64
    assert(true)

@test
fn test_a_narrow_format_underflows():
    @expect error "float underflow.*too small for f32"
    let a := 1e-45f32 × 0.001f32
    assert(true)

// ---------------------------------------------------------------------
// What arithmetic is still allowed
// ---------------------------------------------------------------------

// A zero from a sum is exact: it says the two operands were equal.
// Only a product or a quotient can lose a value to zero.
@test
fn test_a_zero_from_subtraction_is_exact():
    let a := 1.0f64 - 1.0f64
    assert(a = 0.0)

// A zero operand makes a zero result the exact answer.
@test
fn test_a_zero_operand_gives_an_exact_zero():
    let a := 0.0f64 × 5.0f64
    assert(a = 0.0)
    let b := 0.0f64 ÷ 5.0f64
    assert(b = 0.0)

// A subnormal is a number the format holds, with fewer significant
// bits than a normal value but not with none.
@test
fn test_a_subnormal_result_is_kept():
    let a := 1e-320f64 × 0.1f64
    assert(a > 0.0)
    assert(a < 1e-320)

@test
fn test_ordinary_arithmetic_is_untouched():
    let a := 1.5f64 ÷ 3.0f64
    assert(a = 0.5)
    let b := 2.0f64 ↑ 10.0f64
    assert(b = 1024.0)

@start
@impure
fn main():
    std.println("float overflow tests passed")
