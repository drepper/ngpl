// Tests for a dictionary and a set, written ⸨…⸩.
//
// A dictionary holds one type of key and one type of value; a set holds one
// type of value, each of them once.  What a container holds is what its
// type says, as it is for an array.
//
// The entries keep the order they arrived in.  A dictionary has no order of
// its own, and walking one in whatever order the implementation happens
// to use would make a program's output depend on something nobody
// wrote down.

// ---------------------------------------------------------------------
// Writing one down
// ---------------------------------------------------------------------

// A colon after the first entry says the entries have two halves.
@test
fn test_a_dict_literal():
    let d := ⸨"a": 1i64, "b": 2⸩
    assert_eq(#d, 2¤ptrdiff)
    assert_eq(d["a"] ?? 0, 1)
    assert_eq(d["b"] ?? 0, 2)

@test
fn test_a_set_literal():
    let s := ⸨1i64, 2, 3⸩
    assert_eq(#s, 3¤ptrdiff)
    assert(2 ∊ s)

// Each value once: a set is what is in it, not how often.
@test
fn test_a_set_holds_each_value_once():
    let s := ⸨1i64, 2, 2, 1⸩
    assert_eq(#s, 2¤ptrdiff)

// The last one written is what the key holds, as a second assignment
// would leave it.
@test
fn test_a_repeated_key_keeps_the_last():
    let d := ⸨"a": 1i64, "a": 2⸩
    assert_eq(#d, 1¤ptrdiff)
    assert_eq(d["a"] ?? 0, 2)

@test
fn test_the_type_may_be_written_down():
    let d : std.dict(str, i64) = ⸨"a": 1, "b": 2⸩
    let s : std.set(i64) = ⸨1, 2⸩
    assert_eq(d["b"] ?? 0, 2)
    assert(1 ∊ s)

// ⸨⸩ says neither what it holds nor which of the two it is, so the
// type says both.  Being empty is not the objection.
@test
fn test_an_empty_one_takes_its_type():
    let d : std.dict(str, i64) = ⸨⸩
    let s : std.set(i64) = ⸨⸩
    assert_eq(#d, 0¤ptrdiff)
    assert_eq(#s, 0¤ptrdiff)

@test
@expect error "it says neither what it holds nor whether it is a dictionary or a set"
fn error_an_empty_one_with_no_type():
    let e : mut = ⸨⸩

// ---------------------------------------------------------------------
// Reading and writing
// ---------------------------------------------------------------------

// What is not there is not a value to invent, so a read says whether
// there was one, as ⍳ does.
@test
fn test_reading_a_key_that_is_not_there():
    let d := ⸨"a": 1i64⸩
    assert((d["z"]) = ∅)
    assert_eq(d["z"] ?? ⁻1, ⁻1)

@test
fn test_matching_on_a_read():
    let d := ⸨"a": 1i64⸩
    let seen : mut i64 = 0
    match d["a"]:
        ∃(v):
            seen ← v
        ∅:
            seen ← ⁻1
    assert_eq(seen, 1)

// Writing at a key puts it there, whether or not it was there before:
// a dictionary has nothing to be out of range of.
@test
fn test_writing_at_a_key():
    let d : mut std.dict(str, i64) = ⸨"a": 1⸩
    d["b"] ← 2
    d["a"] ← 9
    assert_eq(#d, 2¤ptrdiff)
    assert_eq(d["a"] ?? 0, 9)
    assert_eq(d["b"] ?? 0, 2)

// ---------------------------------------------------------------------
// Asking about it
// ---------------------------------------------------------------------

// A dictionary is looked through by its keys, which is what it is asked
// about; what it holds against them is read with [].
@test
fn test_whether_a_key_is_there():
    let d := ⸨"a": 1i64⸩
    assert("a" ∊ d)
    assert(¬("z" ∊ d))

@test
fn test_whether_a_value_is_in_a_set():
    let s := ⸨1i64, 2⸩
    assert(1 ∊ s)
    assert(¬(9 ∊ s))

@test
fn test_how_many_are_in_it():
    let d := ⸨"a": 1i64, "b": 2, "c": 3⸩
    let s := ⸨1i64, 2⸩
    assert_eq(#d, 3¤ptrdiff)
    assert_eq(#s, 2¤ptrdiff)

// ---------------------------------------------------------------------
// Walking one
// ---------------------------------------------------------------------

// An entry is its key and what is held against it, which is a pair, so
// both halves are named the way any tuple is taken apart.
@test
fn test_walking_a_dict():
    let d := ⸨"a": 1i64, "b": 2, "c": 3⸩
    let total : mut i64 = 0
    let names : mut str[] = []
    foreach (k, v) := d:
        total ← total + v
        names.push(k)
    assert_eq(total, 6)
    assert_eq(#names, 3¤ptrdiff)
    // In the order they were written.
    assert_eq(names[0], "a")
    assert_eq(names[2], "c")

@test
fn test_walking_a_set():
    let s := ⸨1i64, 2, 3⸩
    let total : mut i64 = 0
    foreach v := s:
        total ← total + v
    assert_eq(total, 6)

// ⊃ asks a dictionary for its keys and ⊇ for what it holds against them,
// each answering an array in the order the entries arrived.
@test
fn test_the_keys_and_the_values():
    let d := ⸨"a": 1i64, "b": 2⸩
    assert_eq(#⊃d, 2¤ptrdiff)
    assert_eq((⊃d)[0], "a")
    assert_eq((⊇d)[1], 2)

// ---------------------------------------------------------------------
// Taking things out and putting them in
// ---------------------------------------------------------------------

@test
fn test_removing_from_a_dict():
    let d : mut std.dict(str, i64) = ⸨"a": 1, "b": 2⸩
    assert(d.remove("a"))
    assert_eq(#d, 1¤ptrdiff)
    // Answering whether there was one to remove.
    assert(¬d.remove("a"))

@test
fn test_inserting_into_a_set():
    let s : mut std.set(i64) = ⸨1⸩
    s.insert(2)
    s.insert(1)
    assert_eq(#s, 2¤ptrdiff)
    assert(s.remove(1))
    assert_eq(#s, 1¤ptrdiff)

@test
fn test_clearing_one():
    let d : mut std.dict(str, i64) = ⸨"a": 1⸩
    d.clear()
    assert_eq(#d, 0¤ptrdiff)

// ---------------------------------------------------------------------
// What two sets make between them
// ---------------------------------------------------------------------

@test
fn test_union():
    let a : std.set(i64) = ⸨1, 2, 3⸩
    let b : std.set(i64) = ⸨2, 3, 4⸩
    let u := a ∪ b
    assert_eq(#u, 4¤ptrdiff)
    assert(1 ∊ u)
    assert(4 ∊ u)

@test
fn test_intersection():
    let a : std.set(i64) = ⸨1, 2, 3⸩
    let b : std.set(i64) = ⸨2, 3, 4⸩
    let i := a ∩ b
    assert_eq(#i, 2¤ptrdiff)
    assert(2 ∊ i)
    assert(¬(1 ∊ i))

// What is in the first and not in the second, which is not the same
// question the other way round.
@test
fn test_difference():
    let a : std.set(i64) = ⸨1, 2, 3⸩
    let b : std.set(i64) = ⸨2, 3, 4⸩
    assert_eq(#(a ∖ b), 1¤ptrdiff)
    assert(1 ∊ (a ∖ b))
    assert_eq(#(b ∖ a), 1¤ptrdiff)
    assert(4 ∊ (b ∖ a))

// ∩ binds tighter than ∪, as × does than +, which is the order they
// are read in.
@test
fn test_intersection_binds_tighter():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨2, 3⸩
    let c : std.set(i64) = ⸨3⸩
    // a ∪ (b ∩ c) is ⸨1, 2, 3⸩; (a ∪ b) ∩ c would be ⸨3⸩.
    assert_eq(#(a ∪ b ∩ c), 3¤ptrdiff)

// The order is kept, as it is everywhere else these are walked.
@test
fn test_the_order_is_kept():
    let a : std.set(i64) = ⸨3, 1⸩
    let b : std.set(i64) = ⸨2⸩
    let u := a ∪ b
    assert_eq((⊇u)[0], 3)
    assert_eq((⊇u)[1], 1)
    assert_eq((⊇u)[2], 2)

// An empty set holds nothing to add or to take away.
@test
fn test_with_an_empty_set():
    let a : std.set(i64) = ⸨1, 2⸩
    let e : std.set(i64) = ⸨⸩
    assert_eq(#(a ∪ e), 2¤ptrdiff)
    assert_eq(#(a ∩ e), 0¤ptrdiff)
    assert_eq(#(a ∖ e), 2¤ptrdiff)

@test
@expect error "is asked of two sets"
fn error_a_set_and_a_dict():
    let a : std.set(i64) = ⸨1⸩
    let h : std.dict(str, i64) = ⸨"x": 1⸩
    let u : mut = a ∪ h

@test
@expect error "is asked of two sets"
fn error_a_set_and_an_array():
    let a : std.set(i64) = ⸨1⸩
    let v : i64[] = [1, 2]
    let u : mut = a ∪ v

@test
@expect error "only where they hold the same"
fn error_sets_of_two_types():
    let a : std.set(i64) = ⸨1⸩
    let b : std.set(str) = ⸨"x"⸩
    let u : mut = a ∪ b

// ---------------------------------------------------------------------
// Whether two hold the same things
// ---------------------------------------------------------------------

// Order is not part of it.  What a dictionary and a set keep is the order
// things arrived in, so that walking one is repeatable; two that hold
// the same things are the same whichever way each was built up.
@test
fn test_two_sets_holding_the_same():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨2, 1⸩
    let c : std.set(i64) = ⸨1, 2, 3⸩
    assert(a = b)
    assert(¬(a = c))
    assert(a ≠ c)

@test
fn test_two_dicts_holding_the_same():
    let d : std.dict(str, i64) = ⸨"a": 1, "b": 2⸩
    let e : std.dict(str, i64) = ⸨"b": 2, "a": 1⸩
    let f : std.dict(str, i64) = ⸨"a": 1, "b": 9⸩
    assert(d = e)
    assert(d ≠ f)

// A key the other has not is a difference, as a value it holds
// differently is.
@test
fn test_a_key_the_other_has_not():
    let d : std.dict(str, i64) = ⸨"a": 1⸩
    let e : std.dict(str, i64) = ⸨"b": 1⸩
    assert(d ≠ e)

// It reaches as deep as what is held.
@test
fn test_comparing_what_is_held():
    let a : std.dict(str, i64[]) = ⸨"x": [1, 2]⸩
    let b : std.dict(str, i64[]) = ⸨"x": [1, 2]⸩
    let c : std.dict(str, i64[]) = ⸨"x": [1, 3]⸩
    assert(a = b)
    assert(a ≠ c)

@test
fn test_two_empty_ones():
    let e : std.set(i64) = ⸨⸩
    let f : std.set(i64) = ⸨⸩
    assert(e = f)

// One answer for the whole of it, not one for each thing in it: a dictionary
// and a set are the operand rather than a stand-in for what is in them.
@test
fn test_the_answer_is_one_truth_value():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨1, 2⸩
    let same : bool = a = b
    assert(same)

@test
fn test_assert_eq_compares_them_too():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨2, 1⸩
    assert_eq(a, b)
    let d : std.dict(str, i64) = ⸨"a": 1⸩
    let e : std.dict(str, i64) = ⸨"a": 1⸩
    assert_eq(d, e)

@test
@expect error "they hold different kinds of thing"
fn error_comparing_a_set_with_a_dict():
    let a : std.set(i64) = ⸨1⸩
    let h : std.dict(str, i64) = ⸨"a": 1⸩
    let r : mut = a = h

@test
@expect error "they hold different kinds of thing"
fn error_comparing_a_set_with_an_array():
    let a : std.set(i64) = ⸨1⸩
    let v : i64[] = [1]
    let r : mut = a = v

@test
@expect error "only where they hold the same"
fn error_comparing_sets_of_two_types():
    let a : std.set(i64) = ⸨1⸩
    let b : std.set(str) = ⸨"x"⸩
    let r : mut = a = b

// ---------------------------------------------------------------------
// Joining two dictionaries
// ---------------------------------------------------------------------

// Joining says the one thing ∪ does not: what happens where both hold
// the same key.  The right-hand value is the answer, which makes
// `defaults ⧺ overrides` read the way it is meant.
@test
fn test_joining_two_dicts():
    let a : std.dict(str, i64) = ⸨"a": 1, "b": 2⸩
    let b : std.dict(str, i64) = ⸨"b": 9, "c": 3⸩
    let j := a ⧺ b
    assert_eq(#j, 3¤ptrdiff)
    assert_eq(j["a"] ?? 0, 1)
    assert_eq(j["b"] ?? 0, 9)
    assert_eq(j["c"] ?? 0, 3)

@test
fn test_the_other_way_round_answers_the_other_value():
    let a : std.dict(str, i64) = ⸨"a": 1, "b": 2⸩
    let b : std.dict(str, i64) = ⸨"b": 9, "c": 3⸩
    assert_eq((b ⧺ a)["b"] ?? 0, 2)

// A key keeps the place it first had: what the right operand says is
// what the key holds, not where it sits.
@test
fn test_a_shared_key_keeps_its_place():
    let a : std.dict(str, i64) = ⸨"a": 1, "b": 2⸩
    let b : std.dict(str, i64) = ⸨"b": 9, "c": 3⸩
    let j := a ⧺ b
    assert_eq((⊃j)[0], "a")
    assert_eq((⊃j)[1], "b")
    assert_eq((⊃j)[2], "c")

// A set holds each value once, so joining two would keep nothing the
// second one repeats -- which is what ∪ already answers.
@test
@expect error "which is what ∪ answers"
fn error_joining_two_sets():
    let s : std.set(i64) = ⸨1⸩
    let u : mut = s ⧺ s

@test
@expect error "a dictionary joins a dictionary"
fn error_joining_a_dict_and_an_array():
    let a : std.dict(str, i64) = ⸨"a": 1⸩
    let v : i64[] = [1]
    let j : mut = a ⧺ v

@test
@expect error "a dictionary holds one type of value"
fn error_joining_dicts_of_two_value_types():
    let a : std.dict(str, i64) = ⸨"a": 1⸩
    let b : std.dict(str, str) = ⸨"a": "x"⸩
    let j : mut = a ⧺ b

// ---------------------------------------------------------------------
// Whether one set is held inside another
// ---------------------------------------------------------------------

// ⊆ asks that everything in the one is in the other and no more.
@test
fn test_subset_or_equal():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨1, 2, 3⸩
    let c : std.set(i64) = ⸨1, 2⸩
    assert(a ⊆ b)
    assert(a ⊆ c)
    assert(¬(b ⊆ a))

// ⊂ asks it of a set that is not the whole of the other, which is what
// "proper" means -- so two holding the same things are not one.
@test
fn test_a_proper_subset():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨1, 2, 3⸩
    let c : std.set(i64) = ⸨1, 2⸩
    assert(a ⊂ b)
    assert(¬(a ⊂ c))
    assert(a ⊆ c)

// Nothing is inside everything, and inside itself.
@test
fn test_the_empty_set_is_inside_them_all():
    let a : std.set(i64) = ⸨1⸩
    let e : std.set(i64) = ⸨⸩
    assert(e ⊆ a)
    assert(e ⊂ a)
    assert(e ⊆ e)
    assert(¬(e ⊂ e))

// Answering a bool, so they sit where the comparisons do: what makes a
// set binds tighter, and what combines the answer binds looser.
@test
fn test_what_binds_tighter():
    let a : std.set(i64) = ⸨1, 2⸩
    let b : std.set(i64) = ⸨1, 2, 3⸩
    // (a ∪ ⸨3⸩) ⊆ b, not a ∪ (⸨3⸩ ⊆ b)
    assert(a ∪ ⸨3i64⸩ ⊆ b)
    assert(a ⊆ b ∧ a ⊂ b)

@test
@expect error "is asked of two sets"
fn error_a_subset_of_an_array():
    let a : std.set(i64) = ⸨1⸩
    let v : i64[] = [1]
    let r : mut = a ⊆ v

@test
@expect error "only where they hold the same"
fn error_subsets_of_two_types():
    let a : std.set(i64) = ⸨1⸩
    let b : std.set(str) = ⸨"x"⸩
    let r : mut = a ⊆ b

// ---------------------------------------------------------------------
// One type of key and one type of value
// ---------------------------------------------------------------------

@test
@expect error "an array holds one type of value"
fn error_keys_of_two_types():
    let d : mut = ⸨"a": 1i64, 2i64: 3⸩

@test
@expect error "an array holds one type of value"
fn error_values_of_two_types():
    let d : mut = ⸨"a": 1i64, "b": "two"⸩

@test
@expect error "an array holds one type of value"
fn error_a_set_of_two_types():
    let s : mut = ⸨1i64, "two"⸩

// A key is remembered by what it is, so it has to be one of the things
// the language compares exactly.
@test
@expect error "cannot be a key"
fn error_a_key_that_cannot_be_remembered():
    let d : mut = ⸨[1i64, 2]: 1i64⸩

@test
@expect error "cannot hold a string"
fn error_writing_a_value_of_the_wrong_type():
    let d : mut std.dict(str, i64) = ⸨"a": 1⸩
    d["b"] ← "two"

// A set holds values rather than answering about them by key.
@test
@expect error "a set holds values rather than answering about them by key"
fn error_reading_a_set_by_key():
    let s := ⸨1i64, 2⸩
    let v : mut = s[0]

// A set holds values rather than holding them against keys, so it has
// no keys to ask for.
@test
@expect error "so it has none to ask for"
fn error_asking_a_set_for_keys():
    let s : std.set(i64) = ⸨1⸩
    let k : mut = ⊃s

@test
@expect error "is a question for a dictionary"
fn error_asking_an_array_for_keys():
    let v : i64[] = [1]
    let k : mut = ⊃v

// The two that were members are operators now.
@test
@expect error "has no member"
fn error_the_members_they_replaced():
    let d : mut std.dict(str, i64) = ⸨"a": 1⸩
    let k : mut = d.keys()

@test
@expect error "has no member"
fn error_a_member_neither_of_them_has():
    let s : mut std.set(i64) = ⸨1⸩
    let v : mut = s.push(2)

@start
@impure
fn main():
    std.println("dictionary and set tests passed")
