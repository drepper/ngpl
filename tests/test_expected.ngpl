// Tests for expected (result) types: T?E syntax, division returning
// expected values, ? propagation, ?? recovery, and comparison with
// optional (T?) types.

// ---- postfix optional syntax (T?) ----------------------------------------

fn opt_double(x : i64?) → i64?:
    let v := x?
    v × 2

@test
fn test_optional_postfix_some():
    let r := opt_double(some(5))
    assert_eq(r ?? ⁻1, 10)

@test
fn test_optional_postfix_none():
    let r := opt_double(∅)
    assert_eq(r ?? ⁻1, ⁻1)

// ---- division returns expected value -------------------------------------

@test
fn test_div_success_unwrap():
    let x : i64! = 10 ÷ 3
    let v : i64 = x ?? ⁻1
    assert_eq(v, 3)

@test
fn test_div_zero_recovery():
    let x : i64! = 10 ÷ 0
    let v : i64 = x ?? ⁻1
    assert_eq(v, ⁻1)

@test
fn test_mod_success_unwrap():
    let x : i64! = 10 % 3
    let v : i64 = x ?? ⁻1
    assert_eq(v, 1)

@test
fn test_mod_zero_recovery():
    let x : i64! = 10 % 0
    let v : i64 = x ?? ⁻1
    assert_eq(v, ⁻1)

// ---- ? propagation for expected values -----------------------------------

fn safe_div(a : i64, b : i64) → i64!:
    (a ÷ b)?

@test
fn test_expected_propagate_ok():
    let r := safe_div(10, 2)
    assert_eq(r ?? ⁻1, 5)

@test
fn test_expected_propagate_err():
    let r := safe_div(10, 0)
    assert_eq(r ?? ⁻1, ⁻1)

// ---- chained division with ?? --------------------------------------------

@test
fn test_div_chain_recovery():
    let a : i64 = (100 ÷ 10) ?? 0
    let b := (a ÷ 2) ?? 0
    assert_eq(b, 5)

@test
fn test_div_chain_zero():
    let a : i64 = (100 ÷ 0) ?? 0
    let b := (a ÷ 2) ?? 0
    assert_eq(b, 0)

// ---- expected error is std.errors value ----------------------------------

fn div_or_err(a : i64, b : i64) → i64!:
    (a ÷ b)?

@test
fn test_expected_err_is_std_errors():
    let r := div_or_err(1, 0)
    let fallback : i64 = r ?? ⁻1
    assert_eq(fallback, ⁻1)

// ---- using unwrapped expected in arithmetic ------------------------------

@test
fn test_unwrapped_expected_arithmetic():
    let x : i64 = (20 ÷ 4) ?? 0
    let y := x + 10
    assert_eq(y, 15)

// ---- T! and T?std.errors are the same type -------------------------------
//
// T! is the form used throughout; this pins that the long form still
// parses and means exactly the same thing.

fn long_form(a : i64, b : i64) → i64?std.errors:
    (a ÷ b)?

fn short_form(a : i64, b : i64) → i64!:
    (a ÷ b)?

@test
fn test_long_and_short_agree_on_ok():
    assert_eq(long_form(10, 2) ?? ⁻1, short_form(10, 2) ?? ⁻1)

@test
fn test_long_and_short_agree_on_err():
    assert_eq(long_form(10, 0) ?? ⁻1, short_form(10, 0) ?? ⁻1)

// A value from one is accepted where the other is expected, which it
// could not be if they were different types.
fn takes_short(x : i64!) → i64:
    x ?? 0

@test
fn test_long_form_value_fits_short_form_parameter():
    assert_eq(takes_short(long_form(10, 2)), 5)

// ---- T! abbreviation ------------------------------------------------------

fn bang_div(a : i64, b : i64) → i64!:
    (a ÷ b)?

@test
fn test_bang_return_ok():
    let r := bang_div(10, 2)
    assert_eq(r ?? ⁻1, 5)

@test
fn test_bang_return_err():
    let r := bang_div(10, 0)
    assert_eq(r ?? ⁻1, ⁻1)

fn bang_param(x : i64!) → i64:
    x ?? 0

@test
fn test_bang_param_ok():
    let v : i64! = 10 ÷ 2
    assert_eq(bang_param(v), 5)

@test
fn test_bang_param_err():
    let v := 10 ÷ 0
    assert_eq(bang_param(v), 0)

// ---- error on unwrap of expected error -----------------------------------

@expect error "expected error"
fn error_unwrap_expected():
    let x : mut = 10 ÷ 0
    let y : mut = x + 1

@start
@impure
fn main():
    std.println("expected tests passed")
