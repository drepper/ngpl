// Tests for the tuple type.
//
// A tuple's type is written as its values are: `(i64, str)` is the
// type of `(1i64, "two")`.  The elements are types in their own right,
// so each may be anything a type may be, and the tuple type may go
// wherever a type may go.

// ---------------------------------------------------------------------
// A binding
// ---------------------------------------------------------------------

@test
fn test_a_binding_states_a_tuple_type():
    let t : (i64, str) = (1, "two")
    assert_eq(t[0], 1)
    assert(t[1] = "two")

// The elements settle on what the type says, so a number that stated
// no width takes the one written for it.
@test
fn test_the_type_settles_the_elements():
    let t : (u8, f64) = (200, 1.5)
    static_assert_eq(@typeof(t[0]), u8)
    static_assert_eq(@typeof(t[1]), f64)

@test
fn test_a_mutable_binding():
    let t : mut (i64, str) = (1, "two")
    t ← (2, "three")
    assert_eq(t[0], 2)

// ---------------------------------------------------------------------
// What the type refuses
// ---------------------------------------------------------------------

@test
@expect error "has 2 elements, but the value has 3"
fn error_too_many_elements():
    let t : (i64, str) = (1, "two", 3)

@test
@expect error "has 3 elements, but the value has 2"
fn error_too_few_elements():
    let t : (i64, str, bool) = (1, "two")

@test
@expect error "'str' cannot hold an integer"
fn error_wrong_element_type():
    let t : (i64, str) = (1, 2)

@test
@expect error "is a tuple type, but the value is"
fn error_not_a_tuple():
    let t : (i64, str) = 5

// int and float are refused inside a tuple type as anywhere else.
@test
@expect error "'int' is an arbitrary-precision type"
fn error_arbitrary_precision_element():
    let t : (int, str) = (1, "two")

// ---------------------------------------------------------------------
// Everywhere a type may be written
// ---------------------------------------------------------------------

fn takes_a_pair(p : (i64, str)) → i64:
    p[0]

fn hands_back_a_pair() → (i64, str):
    (1i64, "two")

@test
fn test_a_parameter():
    assert_eq(takes_a_pair((7, "seven")), 7)

@test
fn test_a_return_type():
    let t : (i64, str) = hands_back_a_pair()
    assert_eq(t[0], 1)

// A return type settles the elements the way a binding does.
fn hands_back_a_sized_pair() → (u8, i64):
    (200, 5)

@test
fn test_a_return_type_settles_the_elements():
    let t : (u8, i64) = hands_back_a_sized_pair()
    static_assert_eq(@typeof(t[0]), u8)

type Pair = (i64, str)

@test
fn test_a_type_alias():
    let t : Pair = (1, "two")
    assert_eq(t[0], 1)
    assert(t[1] = "two")

struct Holder:
    pair : (i64, str)

@test
fn test_a_struct_field():
    let h := Holder{pair: (3, "three")}
    assert_eq(h.pair[0], 3)

@test
fn test_a_lambda_parameter():
    let f := λp : (i64, str) → i64: p[0]
    assert_eq(f((9, "nine")), 9)

// ---------------------------------------------------------------------
// Types made of types
// ---------------------------------------------------------------------

@test
fn test_a_tuple_of_tuples():
    let t : ((i64, i64), str) = ((1, 2), "x")
    assert_eq(t[0][1], 2)

@test
fn test_an_array_of_tuples():
    let pairs : (i64, str)[] = [(1, "a"), (2, "b")]
    assert_eq(pairs[1][0], 2)
    assert(pairs[0][1] = "a")

@test
fn test_a_tuple_holding_an_array():
    let t : (i64[], str) = ([1, 2, 3], "x")
    assert_eq(t[0][2], 3)

// One type in parentheses is that type, not a tuple of one.
@test
fn test_parentheses_around_one_type():
    let n : (i64) = 5
    static_assert_eq(@typeof(n), i64)
    assert_eq(n, 5)

// ---------------------------------------------------------------------
// What a tuple answers about itself
// ---------------------------------------------------------------------
//
// @typeof answers with the type, written as a program would write it,
// rather than with the word "tuple".

@test
fn test_typeof_answers_the_structural_type():
    let t : (i64, str) = (1, "two")
    static_assert_eq(@typeof(t), "(i64, str)")

// A tuple of type names is the type they describe, so the answer can
// be compared against the type as written rather than against its text.
@test
fn test_typeof_compares_against_a_written_tuple_type():
    let t : (i64, str) = (1, "two")
    static_assert_eq(@typeof(t), (i64, str))

@test
fn test_typeof_of_a_nested_tuple():
    let t : ((i64, i64), str) = ((1, 2), "x")
    static_assert_eq(@typeof(t), ((i64, i64), str))

@test
fn test_typeof_reads_the_elements_settled_types():
    let t : (u8, f64) = (200, 1.5)
    static_assert_eq(@typeof(t), (u8, f64))

// Two tuples of the same shape answer alike, and of different shapes
// do not.
@test
fn test_two_tuples_answer_alike():
    let a : (i64, str) = (1, "one")
    let b : (i64, str) = (2, "two")
    static_assert_eq(@typeof(a), @typeof(b))

// ---------------------------------------------------------------------
// Taking a tuple apart at a binding
// ---------------------------------------------------------------------
//
// One name per element, in the order the tuple has them, so what the
// definition looks like is what it takes apart.

@test
fn test_a_destructuring_binding():
    let pair : (i64, str) = (1, "two")
    let (a, b) := pair
    assert_eq(a, 1)
    assert(b = "two")

// The names take the elements' types.
@test
fn test_the_names_take_the_element_types():
    let pair : (u8, f64) = (200, 1.5)
    let (a, b) := pair
    static_assert_eq(@typeof(a), u8)
    static_assert_eq(@typeof(b), f64)

// A type may be stated, and it is the tuple's, so it settles the
// elements before they are named.
@test
fn test_a_stated_type_settles_the_elements():
    let (a, b) : (u8, str) = (200, "x")
    static_assert_eq(@typeof(a), u8)
    assert_eq(a, 200)

// The value may be anything that is a tuple.
fn hands_back_a_pair_to_take_apart() → (i64, str):
    (7i64, "seven")

@test
fn test_taking_apart_what_a_function_hands_back():
    let (a, b) := hands_back_a_pair_to_take_apart()
    assert_eq(a, 7)
    assert(b = "seven")

// mut reaches every name.
@test
fn test_mutable_names():
    let (a, b) : mut (i64, i64) = (1, 2)
    a ← a + 1
    b ← b + 1
    assert_eq(a + b, 5)

// The discard target stands where an element is not wanted.
@test
fn test_an_element_may_be_discarded():
    let pair : (i64, str) = (1, "two")
    let (a, _) := pair
    assert_eq(a, 1)

// An element that is itself a tuple may be taken apart with it.
@test
fn test_nested_destructuring():
    let nested : ((i64, i64), str) = ((1, 2), "x")
    let ((a, b), c) := nested
    assert_eq(a + b, 3)
    assert(c = "x")

// --- what it refuses ---

@test
@expect error "needs a tuple, but the value is"
fn error_destructuring_a_value_that_is_not_a_tuple():
    let (a, b) := 5

@test
@expect error "names 3 elements, but the tuple has 2"
fn error_destructuring_the_wrong_number_of_elements():
    let (a, b, c) : (i64, str) = (1, "two")

@test
@expect error "names 'a' twice"
fn error_destructuring_repeats_a_name():
    let (a, a) := (1i64, 2i64)

// A name still settles a value, so an element that settled on nothing
// is refused as it would be at any other binding.
@test
@expect error "settles on 'int'"
fn error_destructuring_an_unsettled_element():
    let (a, b) := (1, "two")

// A name that is never modified draws the same warning it would
// elsewhere.
@expect warning "'b' is declared mut but is never modified"
fn warn_destructured_mut_is_never_modified():
    let (a, b) : mut (i64, i64) = (1, 2)
    a ← 3
    assert_eq(a + b, 5)

// ---------------------------------------------------------------------
// A parameter may name the elements too
// ---------------------------------------------------------------------

fn first_of_pair((a, b) : (i64, str)) → i64:
    a

@test
fn test_a_destructured_parameter():
    assert_eq(first_of_pair((1, "two")), 1)

// A parameter that names the elements states its type as any other
// parameter does, and the type is the tuple's.
fn sum_of_pair((a, b) : (i64, i64)) → i64:
    a + b

@test
fn test_a_destructured_parameter_states_its_type():
    assert_eq(sum_of_pair((3i64, 4i64)), 7)

// The stated type settles the elements before they are named.
fn as_byte((a, b) : (u8, str)) → u8:
    a

@test
fn test_a_parameter_type_settles_the_elements():
    assert_eq(as_byte((200, "x")), 200)

fn inner_sum(((a, b), c) : ((i64, i64), str)) → i64:
    a + b

@test
fn test_a_nested_destructured_parameter():
    assert_eq(inner_sum(((1, 2), "x")), 3)

fn keeps_the_first((a, _) : (i64, str)) → i64:
    a

@test
fn test_a_discarded_element_in_a_parameter():
    assert_eq(keeps_the_first((9, "x")), 9)

@test
fn test_a_destructured_lambda_parameter():
    let f := λ(a, b) : (i64, i64) → i64: a + b
    assert_eq(f((3, 4)), 7)

// --- what a destructured parameter refuses ---

@test
@expect error "is a tuple type, but the value is"
fn error_argument_is_not_a_tuple():
    let n : i64 = sum_of_pair(5i64)

fn wants_three((a, b, c) : (i64, i64, i64)) → i64:
    a

@test
@expect error "has 3 elements, but the value has 2"
fn error_argument_has_the_wrong_number_of_elements():
    let n : i64 = wants_three((1i64, 2i64))

// ---------------------------------------------------------------------
// A match arm may name the elements too
// ---------------------------------------------------------------------

fn maybe_pair(want : bool) → (i64, str)?:
    if want:
        return ∃((1i64, "two"))
    ∅

@test
fn test_a_destructured_match_arm():
    let found : mut i64 = 0
    match maybe_pair(true):
        ∃((a, b)):
            found ← a
        ∅:
            found ← ⁻1
    assert_eq(found, 1)

@test
fn test_the_arm_that_does_not_bind_still_runs():
    let found : mut i64 = 0
    match maybe_pair(false):
        ∃((a, b)):
            found ← a
        ∅:
            found ← ⁻1
    assert_eq(found, ⁻1)

fn divided(a : i64, b : i64) → (i64, i64)!:
    if b = 0:
        return ∄(std.errors.division_by_zero)
    ∃((a ÷ b ?? 0, a % b ?? 0))

@test
fn test_a_destructured_arm_on_a_result():
    let total : mut i64 = 0
    match divided(7, 2):
        ∃((q, r)):
            total ← q × 10 + r
        ∄(e):
            total ← ⁻1
    assert_eq(total, 31)

fn nested_pair() → ((i64, i64), str)?:
    ∃(((1i64, 2i64), "x"))

@test
fn test_a_nested_destructured_arm():
    let total : mut i64 = 0
    match nested_pair():
        ∃(((a, b), c)):
            total ← a + b
        ∅:
            total ← ⁻1
    assert_eq(total, 3)

@test
fn test_an_arm_may_discard_an_element():
    let word : mut str = ""
    match nested_pair():
        ∃((_, c)):
            word ← c
        ∅:
            word ← "none"
    assert(word = "x")

// The names an arm binds live for the arm, as a single name does.
@test
@expect error "cannot assign to match variable"
fn error_assigning_to_a_destructured_arm_name():
    match maybe_pair(true):
        ∃((a, b)):
            a ← 2
        ∅:
            assert(true)

fn maybe_number() → i64?:
    ∃(5i64)

@test
@expect error "the arm names the elements of a tuple, but the value matched is"
fn error_arm_names_elements_of_something_that_is_not_a_tuple():
    match maybe_number():
        ∃((a, b)):
            assert_eq(a, 5)
        ∅:
            assert(true)

@test
@expect error "the arm names 3 elements, but the value matched has 2"
fn error_arm_names_the_wrong_number_of_elements():
    match maybe_pair(true):
        ∃((a, b, c)):
            assert_eq(a, 1)
        ∅:
            assert(true)

@start
@impure
fn main():
    std.println("tuple type tests passed")
