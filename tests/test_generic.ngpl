// Tests for generic functions.

// Identity function: return type follows parameter type.
fn identity(x : T') → T':
    x

// Both parameters must have the same type.
fn add_g(a : T', b : T') → T':
    a + b

// Different generic names allow different argument types.
fn pick_first(a : T', b : U') → T':
    a

fn pick_second(a : T', b : U') → U':
    b

// Generic used only in parameters, concrete return type.
fn to_bool(x : T') → bool:
    x ≠ 0

// ------------------------------------------------------------------

@test
fn test_identity_int():
    assert_eq(identity(42), 42)

@test
fn test_identity_bool():
    assert(identity(true))
    assert(not identity(false))

@test
fn test_identity_string():
    assert_eq(identity("hello"), "hello")

@test
fn test_identity_typed_int():
    let x : i32 = 7
    let r := identity(x)
    assert_eq(r, 7)

@test
fn test_add_same_type():
    assert_eq(add_g(10, 20), 30)

@test
fn test_add_typed():
    let a : u32 = 100
    let b : u32 = 200
    assert_eq(add_g(a, b), 300)

@test
fn test_different_generics():
    assert_eq(pick_first(42, "hello"), 42)
    assert_eq(pick_first("world", 99), "world")
    assert(pick_second(1, true))

@test
fn test_generic_with_concrete_return():
    assert(to_bool(1))
    assert(not to_bool(0))

@test
fn test_generic_type_mismatch():
    let a : i32 = 1
    let b : u32 = 2
    @expect error "generic type T'"
    add_g(a, b)

@test
fn test_generic_curry():
    let add10 := add_g(10)
    assert_eq(add10(20), 30)

// --- local variables with generic types ---------------------------------

fn double_typed(x : T') → T':
    let result : T' = x + x
    result

@test
fn test_local_var_generic_type():
    assert_eq(double_typed(21), 42)
    let a : i32 = 5
    assert_eq(double_typed(a), 10)

// Multiple generic type parameters in local vars.
fn swap_add(a : T', b : U') → T':
    let first : T' = a
    let second : U' = b
    first + first

@test
fn test_local_var_multi_generic():
    assert_eq(swap_add(10, 20), 20)

// Generic array element type in local var.
fn first_elem(arr : T'[]) → T':
    let elem : T' = arr[0]
    elem

@test
fn test_local_var_generic_array():
    let a : i32[] = [7, 8, 9]
    assert_eq(first_elem(a), 7)

// --- local type aliases with generic types ------------------------------

fn add_aliased(a : T', b : T') → T':
    type Local = T'
    let x : Local = a
    let y : Local = b
    x + y

@test
fn test_local_type_alias_generic():
    assert_eq(add_aliased(3, 4), 7)
    let a : u32 = 100
    let b : u32 = 200
    assert_eq(add_aliased(a, b), 300)

// Local type alias for generic array type.
fn sum_aliased(arr : T'[]) → T':
    type Elem = T'
    let total : mut Elem = 0
    foreach i := 0…(arr.sizeof - 1):
        total ← total + arr[i]
    total

@test
fn test_local_type_alias_generic_array():
    let a : i32[] = [10, 20, 30]
    assert_eq(sum_aliased(a), 60)

@start
@impure
fn main():
    std.println("generic tests passed")

// ---------------------------------------------------------------------
// Every parameter states what it takes
// ---------------------------------------------------------------------
//
// A signature is what a reader is given instead of the body, so a
// parameter that says nothing about what it takes leaves them the body
// to read.  Where a function genuinely takes whatever it is handed, a
// generic says that -- and says it once, so the caller can be held to
// it.

// A generic takes the value as it is, which is the whole of what it
// says: a measured number keeps its unit, and a function is a value
// like any other.
fn given_back(x : T') → T':
    x

@test
fn test_a_generic_takes_a_measured_number():
    let d ¤meter : i64 = 5
    let back := given_back(d)
    assert_eq(back, 5¤meter)
    assert_eq(@unitof(back), ¤meter)

fn calls_it(f : F', n : i32) → i32:
    f(n)

@test
fn test_a_generic_takes_a_function():
    let double := λa : i32 → i32: a × 2
    assert_eq(calls_it(double, 21), 42)

// One generic in two places is a promise that both are the same type.
fn both(a : T', b : T') → T':
    a

@test
@expect error "generic type T' resolved to"
fn error_one_generic_two_types():
    let n : mut = both(1i64, "two")

// Two generics say nothing about each other.
fn either(a : A', b : B') → A':
    a

@test
fn test_two_generics_need_not_agree():
    assert_eq(either(1i64, "two"), 1)

// A pack states what it takes as any parameter does.
fn how_many(args… : T') → i64:
    @dropunit(args.sizeof)

@test
fn test_a_pack_states_a_type():
    assert_eq(how_many(1, 2, 3), 3)
