// Tests for system environment access: std.args, std.env, and std.sys.
//
// The values themselves depend on how and where the program is run, so
// these tests check invariants that must hold on every machine.  The
// exact-value tests live in tests/output/sysenv.ngpl, which is invoked
// with a fixed command line and a fixed environment.

// ---------------------------------------------------------------------
// std.args — command line parameters
// ---------------------------------------------------------------------

// all() reports as many parameters as count() promises.
@test
fn test_args_count_matches_all():
    let params := std.args.all()
    assert_eq(#params, std.args.count())

// get(i) and all()[i] name the same parameter.
@test
fn test_args_get_matches_all():
    let params := std.args.all()
    foreach i, v := enumerate(params):
        assert_eq(std.args.get(i), ⊨(v))

// The program name is always known, even with no parameters.
@test
fn test_args_program_present():
    let name := std.args.program()
    assert(#name > 0)

// Indexing past the last parameter is an error, not a silent empty string.
@expect error "out of range"
fn error_args_get_out_of_range():
    let past_end ¤count : mut i64 = std.args.count()
    let bad : mut = std.args.get(past_end)

// ---------------------------------------------------------------------
// std.env — process environment
// ---------------------------------------------------------------------

// names() reports as many variables as count() promises.
@test
fn test_env_count_matches_names():
    let names := std.env.names()
    assert_eq(#names, std.env.count())

// Every listed variable is present and has a value.
@test
fn test_env_listed_names_resolve():
    foreach name := std.env.names():
        assert(std.env.has(name))
        assert(std.env.get(name) ≠ ∅)

// A variable that is not set reads as ∅ rather than an empty string.
@test
fn test_env_missing_is_none():
    let missing := std.env.get("NGPL_NO_SUCH_VARIABLE_EXISTS")
    assert_eq(missing, ∅)
    assert(¬std.env.has("NGPL_NO_SUCH_VARIABLE_EXISTS"))

// The ?? operator supplies a default for an unset variable.
@test
fn test_env_default():
    let shell := std.env.get("NGPL_NO_SUCH_VARIABLE_EXISTS") ?? "fallback"
    assert_eq(shell, "fallback")

// ---------------------------------------------------------------------
// std.sys — CPU and memory properties
// ---------------------------------------------------------------------

// The program can always run on at least one CPU.
@test
fn test_sys_usable_cpus_positive():
    assert(std.sys.usable_cpus() > 0)

// Usable CPUs are a subset of the online CPUs, which are a subset of
// the CPUs the system is configured with.
@test
fn test_sys_cpu_counts_ordered():
    assert(std.sys.usable_cpus() <= std.sys.online_cpus())
    assert(std.sys.online_cpus() <= std.sys.total_cpus())

// usable_cpus() is exactly the population count of the affinity mask.
@test
fn test_sys_affinity_matches_usable():
    let cpus : i64[] = std.sys.affinity_cpus()
    assert_eq(#cpus, std.sys.usable_cpus())

// Every CPU id listed is actually set in the mask, and the ids ascend.
@test
fn test_sys_affinity_cpus_consistent():
    let mask : u64 = std.sys.affinity()
    let previous : mut i64 = ⁻1
    foreach cpu := std.sys.affinity_cpus():
        assert(((mask >> cpu) & 1) = 1)
        assert(cpu > previous)
        previous ← cpu

// Memory sizes are positive and the page size is a power of two.
@test
fn test_sys_memory():
    let page ¤byte : i64 = std.sys.page_size()
    assert(page > 0)
    assert((page & (page - 1)) = 0)
    assert(std.sys.total_memory() >= page)

// ---------------------------------------------------------------------
// std.process — what the kernel recorded at exec
// ---------------------------------------------------------------------

// The page size is positive and a power of two, as any page size is.
@test
fn test_process_pagesize():
    let page ¤byte : i64 = std.process.pagesize
    assert(page > 0)
    assert((page & (page - 1)) = 0)

// The auxiliary vector is written once, so a member answers the same
// every time it is asked.
@test
fn test_process_members_are_settled():
    assert_eq(std.process.uid, std.process.uid)
    assert_eq(std.process.gid, std.process.gid)
    assert_eq(std.process.pagesize, std.process.pagesize)

// A program nobody gave privilege to reports none.
@test
fn test_process_secure_is_a_truth_value():
    let s := std.process.secure
    assert(s ∨ ¬s)

// The kernel names what it executed, and a path is not empty.
@test
fn test_process_exec_filename():
    let name := std.process.exec_filename
    assert(#name > 0)

@start
@impure
fn main():
    std.println("system environment tests passed")
