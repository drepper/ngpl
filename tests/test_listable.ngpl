// Tests for @listable, which threads a function over what it is handed.
//
// A parameter handed something deeper than it asked for is handed a
// container of what it asked for, so the function is asked of each of
// the things in it.  The answer has the structure of what was taken
// apart; what it holds is what came back.

@listable
fn double(n : i64) → i64:
    n × 2

@listable
fn add(a : i64, b : i64) → i64:
    a + b

@listable
fn between(lo : i64, n : i64, hi : i64) → bool:
    lo <= n ∧ n <= hi

@listable
fn letter(n : i64) → char:
    (64 + n).chr()

// A parameter that asks for a vector is handed one without threading,
// and a matrix with it.
@listable
fn total(v : i64[]) → i64:
    (λa : i64, b : i64 → i64: a + b) ⌿ v

// ---------------------------------------------------------------------
// One parameter
// ---------------------------------------------------------------------

@test
fn test_over_a_vector():
    let v : i64[] = [1, 2, 3]
    let r := double(v)
    assert_eq(r[0], 2)
    assert_eq(r[1], 4)
    assert_eq(r[2], 6)

@test
fn test_a_value_is_not_threaded():
    assert_eq(double(21), 42)

// A container of containers is taken apart again, so what comes back
// has the shape of what went in.
@test
fn test_over_a_matrix():
    let m : i64[2, 2] = [[1, 2], [3, 4]]
    let r := double(m)
    assert_eq(r[0, 0], 2)
    assert_eq(r[0, 1], 4)
    assert_eq(r[1, 0], 6)
    assert_eq(r[1, 1], 8)

@test
fn test_nothing_to_take_apart():
    let e : i64[] = []
    let r := double(e)
    assert_eq(#r, 0¤ptrdiff)

// ---------------------------------------------------------------------
// More than one parameter
// ---------------------------------------------------------------------

@test
fn test_two_containers_go_together():
    let a : i64[] = [1, 2, 3]
    let b : i64[] = [10, 20, 30]
    let r := add(a, b)
    assert_eq(r[0], 11)
    assert_eq(r[1], 22)
    assert_eq(r[2], 33)

// What is not deeper than the parameter asked for is held still.
@test
fn test_one_container_and_one_value():
    let a : i64[] = [1, 2, 3]
    let r := add(a, 10)
    assert_eq(r[0], 11)
    assert_eq(r[2], 13)
    let s := add(10, a)
    assert_eq(s[0], 11)

@test
fn test_three_parameters():
    let v : i64[] = [1, 2, 3]
    let r := between(0, v, 2)
    assert(r[0])
    assert(r[1])
    assert(¬r[2])

// A matrix and a vector pair rows against elements, one level at a
// time, which is what threading once and asking again means.
@test
fn test_a_matrix_and_a_vector():
    let m : i64[2, 2] = [[1, 2], [3, 4]]
    let v : i64[] = [10, 20]
    let r := add(m, v)
    assert_eq(r[0, 0], 11)
    assert_eq(r[0, 1], 12)
    assert_eq(r[1, 0], 23)
    assert_eq(r[1, 1], 24)

// ---------------------------------------------------------------------
// What the parameter asks for
// ---------------------------------------------------------------------

@test
fn test_a_parameter_that_asks_for_a_vector():
    let v : i64[] = [1, 2, 3]
    assert_eq(total(v), 6)

@test
fn test_and_the_same_parameter_handed_a_matrix():
    let m : i64[2, 2] = [[1, 2], [3, 4]]
    let r := total(m)
    assert_eq(r[0], 3)
    assert_eq(r[1], 7)

// ---------------------------------------------------------------------
// What comes back
// ---------------------------------------------------------------------

// The structure is what was taken apart; the type is what the function
// answered, which need not be what it was given.
@test
fn test_the_answer_says_what_it_holds():
    let v : i64[] = [1, 2, 3]
    let r : mut = between(0, v, 2)
    assert(r[0])
    r[0] ← false
    assert(¬r[0])

@test
fn test_answering_something_else_entirely():
    let v : i64[] = [1, 2, 3]
    let r := letter(v)
    assert_eq(r[0], 'A')
    assert_eq(r[2], 'C')

// ---------------------------------------------------------------------
// What it is asked through
// ---------------------------------------------------------------------

// Too few arguments still curry; what comes back threads when the rest
// of them arrive.
@test
fn test_currying_then_threading():
    let v : i64[] = [1, 2, 3]
    let add10 := add(10)
    let r := add10(v)
    assert_eq(r[0], 11)
    assert_eq(r[2], 13)

@listable
fn same(x : T') → T':
    x

// A generic settles on what an element is rather than on the container.
@test
fn test_a_generic_parameter():
    let v : i64[] = [1, 2, 3]
    let r := same(v)
    assert_eq(r[1], 2)

@listable
fn twice_as_far(d ¤meter : i64) → i64 ¤meter:
    d × 2

// Each element meets the parameter for itself, so a unit is converted
// per element as it would be for one.
@test
fn test_a_unit_bearing_parameter():
    let one ¤meter : i64 = 1
    let two ¤meter : i64 = 2
    let d := [one, two]
    let r := twice_as_far(d)
    assert_eq(r[0], 2¤meter)
    assert_eq(r[1], 4¤meter)
    assert_eq(@unitof(r[0]), ¤meter)

struct Counter:
    base : i64

impl Counter:
    @listable
    fn above(self, n : i64) → i64:
        self.base + n

// A method threads over its arguments; self is one thing and stays it.
@test
fn test_a_method():
    let c := Counter{base: 100}
    let v : i64[] = [1, 2, 3]
    let r := c.above(v)
    assert_eq(r[0], 101)
    assert_eq(r[2], 103)

// A signature stating no return type hands nothing back, which is what
// → ∅ says.  There is nothing to collect, so nothing comes back rather
// than a row of ∅.
@listable
@impure
fn note(n : i64):
    std.print("")

@test
@impure
fn test_a_function_that_hands_nothing_back():
    let v : i64[] = [1, 2, 3]
    assert(note(v) = ∅)

// ---------------------------------------------------------------------
// The standard library's numeric functions thread too
// ---------------------------------------------------------------------

// sinpi is exact at half-integers, so the answers compare without a
// tolerance.
@test
fn test_std_sinpi_over_a_vector():
    let xs : f64[] = [0.5, 1.5, 2.5]
    let ys := std.sinpi(xs)
    assert(ys[0] = 1.0)
    assert(ys[1] = ⁻1.0)
    assert(ys[2] = 1.0)

@test
fn test_std_cos_over_a_vector():
    let zs : f64[] = [0.0, 0.0]
    let cs := std.cos(zs)
    assert(cs[0] = 1.0)
    assert(cs[1] = 1.0)

// A matrix is met one level at a time, as a user function is.
@test
fn test_std_sinpi_over_a_matrix():
    let m : f64[2,2] = [[0.5, 1.0], [1.5, 2.0]]
    let r := std.sinpi(m)
    assert(r[0][0] = 1.0)
    assert(r[0][1] = 0.0)
    assert(r[1][0] = ⁻1.0)
    assert(r[1][1] = 0.0)

// A scalar is still a scalar.
@test
fn test_std_sin_scalar_unchanged():
    assert(std.sin(0.0) = 0.0)

// ---------------------------------------------------------------------
// What it refuses
// ---------------------------------------------------------------------

// What is taken apart together must be the same length: there is no
// element to pair the extra ones with, and answering the shorter of
// the two would be answering a question that was not asked.
@test
@expect error 2236 "add: the arguments it threads over are taken apart together, so they must be the same length, but 'a' has 3 elements and 'b' has 2"
fn error_lengths_that_disagree():
    let a : i64[] = [1, 2, 3]
    let b : i64[] = [10, 20]
    let r : mut = add(a, b)

@start
@impure
fn main():
    std.println("listable tests passed")
