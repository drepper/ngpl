// A module says where the definitions after it live.  It is not a
// block: `module a` on a line of its own means everything below it
// belongs to `a`, until the next such line says otherwise.
//
// A bare name is read against the module in hand, so `module b` written
// while inside `a` is `a.b`.  A leading period starts again from the
// outside, so `module .c` is `c` wherever it is written.  These are
// C++'s namespace rules with a period in place of the two colons.
//
// Nothing leaves a module unless it says so.  `@export` is what says
// so, and a module that says it of nothing is refused: a module is a
// promise that something in it is worth naming from outside, and one
// that exports nothing keeps that promise to nobody.

module shapes

@export
fn area(w : i64, h : i64) → i64:
    scaled(w) × h

// Not exported.  `shapes.area` may call it because they are the same
// module; nothing outside may name it.
fn scaled(v : i64) → i64:
    v

// A name written inside `a.b` is looked for in `a.b`, then in `a`, then
// in the global module -- so a nested module reaches what encloses it
// without qualifying anything.
module solid

@export
fn volume(w : i64, h : i64, d : i64) → i64:
    area(w, h) × d          // shapes.area, seen from shapes.solid

module .counts

@export
fn twice(v : i64) → i64:
    v × 2

// ---------------------------------------------------------------------
// Back to the global module, where the tests live
// ---------------------------------------------------------------------

module .

@test
fn test_a_module_is_named_from_outside():
    assert_eq(shapes.area(3, 4), 12)

@test
fn test_a_nested_module_is_named_by_its_whole_path():
    assert_eq(shapes.solid.volume(2, 3, 4), 24)

@test
fn test_a_leading_period_starts_from_the_outside():
    // counts was written inside shapes.solid, and is not shapes.counts
    assert_eq(counts.twice(21), 42)

@test
fn test_two_modules_may_hold_the_same_name():
    assert_eq(shapes.area(2, 2), 4)
    assert_eq(counts.twice(2), 4)

// What a module did not export cannot be named from outside it.
@expect error "not exported"
fn error_what_is_not_exported_stays_in():
    _ ← shapes.scaled(1)

@expect error "defines no"
fn error_a_name_the_module_does_not_have():
    _ ← shapes.perimeter(1)

// A module that exports nothing is refused where it is written, which
// is before anything runs; tests/output/module_no_exports holds it.

@start
@impure
fn main():
    std.println("module tests passed")
