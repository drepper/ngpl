// Tests for @unitof intrinsic and standalone ¤unit references.
// All @ commands require compile-time constant arguments.

@impure
fn assert_true(cond:bool, msg:str):
  if not cond:
    std.println("FAIL: {}", msg)

// --- @unitof on unit-bearing literal expressions ---

@test
fn test_unitof_meter():
  static_assert_eq(@unitof(5 ¤meter), ¤meter)

@test
fn test_unitof_second():
  static_assert_eq(@unitof(10 ¤second), ¤second)

@test
fn test_unitof_kilogram():
  static_assert_eq(@unitof(3 ¤kilogram), ¤kilogram)

// --- @unitof on dimensionless literal ---

@test
@impure
fn test_unitof_dimensionless():
  assert_true(@unitof(42) != ¤meter, "dimensionless != meter")

// --- @unitof equality of same unit ---

@test
fn test_unitof_same_unit():
  static_assert_eq(@unitof(5 ¤meter), @unitof(10 ¤meter))

// --- @unitof inequality of different units ---

@test
@impure
fn test_unitof_different_units():
  assert_true(@unitof(5 ¤meter) != @unitof(3 ¤second), "meter != second")

// --- @unitof on derived unit ---

@test
fn test_unitof_derived():
  static_assert_eq(@unitof(100 ¤meter ÷ (10 ¤second)), ¤meter÷second)

// --- @unitof with kilometer ---

@test
@impure
fn test_unitof_kilometer():
  static_assert_eq(@unitof(5 ¤kilometer), ¤kilometer)
  assert_true(@unitof(5 ¤kilometer) != ¤meter, "kilometer != meter")

// --- static_assert_eq with @unitof ---

@test
fn test_static_assert_unitof():
  static_assert_eq(@unitof(5 ¤meter), ¤meter)

// --- dimensionless comparison ---

@test
@impure
fn test_unitof_dimensionless_eq():
  assert_true(@unitof(42) = @unitof(99), "both dimensionless")

// --- runtime unit queries use .unitof instead of @unitof ---

@test
@impure
fn test_runtime_unitof_sizeof():
  let arr : i64[] = [1, 2, 3]
  let sz ¤ptrdiff : i64 = arr.sizeof
  assert_true(sz = 3, "sizeof is 3")

@test
@impure
fn test_runtime_unitof_bytes():
  let buf: u8[4] = [1, 2, 3, 4]
  let sz ¤byte : i64 = buf.sizeof
  assert_true(sz = 4, "sizeof is 4")

@start
@impure
fn main():
  std.println("unitof tests passed")
