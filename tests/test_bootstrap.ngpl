// test_bootstrap.ngpl -- what the bootstrap implementation refuses
//
// The Python interpreter in interp/ implements the bootstrap language,
// a strict subset of the full language.  int and float are the
// arbitrary-precision types and belong to the full language, so a
// declaration naming one is refused rather than quietly given a
// different meaning.
//
// An untyped literal is unaffected while it is being computed with: it
// is what it says until it meets a type, and settles on that one.
// What it may not do is stay uncommitted once it is named.  A binding
// with no type written down would settle on int or float, so it is
// refused and the type is asked for.

// ---------------------------------------------------------------------
// What is still allowed
// ---------------------------------------------------------------------

@test
fn test_untyped_literals_are_unaffected():
    let n : i64 = 5
    let big : i64 = 1 « 40
    assert_eq(n, 5)
    assert_eq(big, 1099511627776)

@test
fn test_sized_types_are_the_way_to_declare():
    let a : i64 = 5
    let b : f64 = 1.5
    let c : u8 = 200
    assert_eq(a, 5)
    assert(b = 1.5)
    assert_eq(c, 200)

// A computation may exceed a sized type while it stays untyped.
@test
fn test_untyped_arithmetic_keeps_its_precision():
    let wide : i64 = (1 « 40) + 1
    assert_eq(wide, 1099511627777)

// ---------------------------------------------------------------------
// What is refused
// ---------------------------------------------------------------------

@test
@expect error 2272 "'n': 'int' is an arbitrary-precision type, which the bootstrap implementation does not provide; use a sized type such as i64"
fn error_int_binding():
    let n : int = 5

@test
@expect error 2272 "'f': 'float' is an arbitrary-precision type, which the bootstrap implementation does not provide; use a sized type such as f64"
fn error_float_binding():
    let f : float = 1.5

@test
@expect error 2272 "'n': 'int' is an arbitrary-precision type, which the bootstrap implementation does not provide; use a sized type such as i64"
fn error_int_binding_names_the_replacement():
    let n : int = 5

@test
@expect error 2272 "'f': 'float' is an arbitrary-precision type, which the bootstrap implementation does not provide; use a sized type such as f64"
fn error_float_binding_names_the_replacement():
    let f : float = 1.5

// The refusal reaches every place a type is declared; the parameter,
// return, field, and alias cases are output tests, since those are
// reported before any function runs.

// A lambda declares types the same way, and is refused the same way.

@test
@expect error 2272 "λ: parameter 'x': 'int' is an arbitrary-precision type, which the bootstrap implementation does not provide; use a sized type such as i64"
fn error_lambda_parameter():
    let f := λx : int → i64: 5

@test
@expect error 2272 "λ: return type: 'int' is an arbitrary-precision type, which the bootstrap implementation does not provide; use a sized type such as i64"
fn error_lambda_return():
    let f := λx : i64 → int: 5

// ---------------------------------------------------------------------
// A binding settles a value, and there is nothing for it to settle on
// ---------------------------------------------------------------------

@test
@expect error 2278 "'n': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let n : i64 = …'"
fn error_untyped_binding():
    let n := 5

@test
@expect error 2278 "'f': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let f : f64 = …'"
fn error_untyped_float_binding():
    let f := 1.5

// mut changes nothing: the question is what type the value has.
@test
@expect error 2278 "'n': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let n : i64 = …'"
fn error_untyped_mut_binding():
    let n : mut = 5

// The message names the type to write instead.
@test
@expect error 2278 "'n': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let n : i64 = …'"
fn error_untyped_binding_names_the_replacement():
    let n := 5

// A value that already has a sized type needs nothing added.
@test
fn test_a_sized_value_settles_nothing():
    let a : i64 = 5
    let b := a + 1
    let c := 5i64
    let d := 1.5f64
    assert_eq(b, 6)
    assert_eq(c, 5)
    assert(d = 1.5)

// A global is a binding like any other.  The global case is an output
// test, since it is reported while the definitions are installed.

// ---------------------------------------------------------------------
// An array settles element by element
// ---------------------------------------------------------------------
//
// An array of numbers that settled on nothing is an array of the type
// the bootstrap does not have, so a binding of one is refused the same
// way.  There are two ways to answer: say what the array is, or let
// one element say what its numbers are.

@test
@expect error 2278 "'a': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let a : i64[] = …'"
fn error_untyped_array():
    let a := [1, 2, 3]

@test
@expect error 2278 "'a': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let a : f64[] = …'"
fn error_untyped_float_array():
    let a := [1.5, 2.5]

// The type it asks for is the one the program would write, brackets
// and all.
@test
@expect error 2278 "'a': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let a : i64[] = …'"
fn error_untyped_array_names_the_replacement():
    let a := [1, 2, 3]

// A dimension is a comma inside one pair of brackets, so an array of
// arrays is asked for as i64[,].
@test
@expect error 2278 "'m': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let m : i64[,] = …'"
fn error_untyped_nested_array_names_the_replacement():
    let m := [[1, 2], [3, 4]]

// --- the two ways to answer ---

@test
fn test_the_binding_may_say_it():
    let a : i64[] = [1, 2, 3]
    static_assert_eq(@typeof(a[0]), i64)
    assert_eq(a[0], 1)

// One element saying what it is settles the rest, as a literal takes
// the width of what it is combined with anywhere else.
@test
fn test_one_element_may_say_it():
    let a := [1i64, 2, 3]
    static_assert_eq(@typeof(a[0]), i64)
    static_assert_eq(@typeof(a[1]), i64)
    static_assert_eq(@typeof(a[2]), i64)
    assert_eq(a[2], 3)

@test
fn test_a_later_element_may_be_the_one_that_says_it():
    let a := [1, 2, 3u8]
    static_assert_eq(@typeof(a[0]), u8)
    assert_eq(a[0], 1)

@test
fn test_one_element_may_say_it_for_floats():
    let a := [1.5f32, 2.5]
    static_assert_eq(@typeof(a[0]), f32)
    static_assert_eq(@typeof(a[1]), f32)

// An array whose elements are values that already have a type needs
// nothing said.
@test
fn test_elements_that_already_have_a_type():
    let n : u8 = 7
    let a := [n, 8, 9]
    static_assert_eq(@typeof(a[1]), u8)
    assert_eq(a[2], 9)

// An empty array says nothing about what it would hold, so a binding
// that says nothing either leaves the name with no type at all.  Being
// empty is not the objection: a dynamic array is allowed to hold
// nothing, and one whose type is written down holds nothing of that
// type.
@test
@expect error 2776 "'f': an empty array says nothing about what it would hold, and the binding says nothing either; state a type, as 'let f : i64[] = []'"
fn error_an_untyped_empty_array():
    let f : mut = []

// Rows of rows of nothing are still nothing.
@test
@expect error 2776 "'f': an empty array says nothing about what it would hold, and the binding says nothing either; state a type, as 'let f : i64[] = []'"
fn error_untyped_rows_of_nothing():
    let f : mut = [[], []]

@test
fn test_a_stated_type_holds_nothing_of_that_type():
    let f : i64[] = []
    assert_eq(#f, 0¤ptrdiff)
    let more : mut i64[] = []
    more.push(7)
    assert_eq(more[0], 7)

// One row saying what it holds says it for the empty ones too.
@test
fn test_one_row_settles_the_empty_ones():
    let f := [[1u8], []]
    static_assert_eq(@typeof(f[0][0]), u8)
    assert_eq(#f[1], 0¤ptrdiff)

// A number settles what is around it however deep it sits: one element
// of one row says what every number in the literal is, since there is
// only one type for all of them to be.
@test
fn test_a_nested_literal_settles_from_one_element():
    let d := [[1u8, 2, 3], [2, 3, 4]]
    static_assert_eq(@typeof(d[0, 0]), u8)
    static_assert_eq(@typeof(d[1, 2]), u8)
    assert_eq(d[1, 2], 4)

// Wherever in the literal it is written.
@test
fn test_a_later_row_may_be_the_one_that_says_it():
    let d := [[1, 2], [3, 4u16]]
    static_assert_eq(@typeof(d[0, 0]), u16)

@test
fn test_it_reaches_as_deep_as_the_literal_goes():
    let d := [[[1i64, 2], [3, 4]], [[5, 6], [7, 8]]]
    static_assert_eq(@typeof(d[1, 1, 1]), i64)
    assert_eq(d[1, 1, 1], 8)

// Rows of different lengths are a question about the shape, not about
// the type, so the numbers still settle.
@test
fn test_rows_of_different_lengths_still_settle():
    let d := [[1u8, 2, 3], [4]]
    static_assert_eq(@typeof(d[1][0]), u8)

@test
@expect error 2744 "an array holds one type of value, but element 0 is u8 and element 1 is i64"
fn error_two_rows_that_disagree():
    let d : mut = [[1u8, 2], [3, 4i64]]

@test
@expect error 2743 "an array holds one type of value, but element 0 is u8 and element 1 is an array"
fn error_a_number_beside_a_row():
    let d : mut = [1u8, [2, 3]]

// An array of something other than numbers settles on what it holds
// just as one of numbers does -- there is no width to argue about, but
// there is still one type, and the array says which.
@test
fn test_an_array_of_strings_settles_on_str():
    let words := ["one", "two"]
    assert(words[0] = "one")
    static_assert_eq(@typeof(words[0]), str)

// ---------------------------------------------------------------------
// A tuple settles nothing between its elements
// ---------------------------------------------------------------------
//
// Each element of a tuple is its own type, so one of them stating a
// width says nothing about the others.  Either the binding states the
// tuple's type or every number states its own.

@test
@expect error 2278 "'t': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let t : (i64, str) = …'"
fn error_untyped_tuple():
    let t := (1, "two")

@test
@expect error 2278 "'t': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let t : (f64, str) = …'"
fn error_untyped_float_tuple():
    let t := (1.5, "two")

// One element saying what it is settles only itself.
@test
@expect error 2278 "'t': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let t : (i64, i64) = …'"
fn error_partly_typed_tuple():
    let t := (1i64, 2)

// The type it asks for is the tuple's, written as its values are.
@test
@expect error 2278 "'t': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let t : (i64, str) = …'"
fn error_untyped_tuple_names_the_replacement():
    let t := (1, "two")

@test
fn test_every_number_may_say_it():
    let t := (1i64, "two")
    let u := (1i64, 2.5f64, true)
    assert_eq(t[0], 1)
    assert(u[1] = 2.5)

@test
fn test_the_binding_may_say_it_for_a_tuple():
    let t : (i64, str) = (1, "two")
    assert_eq(t[0], 1)
    assert(t[1] = "two")

// A tuple of things that are not numbers has nothing to settle.
@test
fn test_a_tuple_without_numbers_settles_nothing():
    let t := ("one", true)
    assert(t[0] = "one")

// The rule reaches a tuple inside an array, which is where a builtin
// hands one back.
@test
@expect error 2278 "'pairs': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let pairs : (i64, i64)[] = …'"
fn error_array_of_untyped_tuples():
    let pairs := [(1, 2), (3, 4)]

@test
fn test_array_of_typed_tuples():
    let pairs := [(1i64, 2i64), (3i64, 4i64)]
    assert_eq(pairs[0][1], 2)

// A tuple a builtin hands back arrives with its numbers sized, since
// nothing the program could write would say what they are.
@test
@impure
fn test_a_builtin_tuple_is_already_settled():
    let frames := std.callstack()
    let top := frames[0]
    static_assert_eq(@typeof(top[1]), i64)

// ---------------------------------------------------------------------
// An argument nothing settles
// ---------------------------------------------------------------------
//
// A parameter that states a type settles the value against it.  What
// is left is a value handed to something that states nothing -- a
// builtin, or an untyped parameter -- where a number too wide for
// every sized type would have to be kept as an int.

@test
@expect error 2617 "println: argument 2: 1606938044258990275541962092341162602522202993782792835301376 needs more bits than any sized type has, and nothing here says which type it should have; the bootstrap implementation has no arbitrary-precision int for it to settle on"
@impure
fn error_untyped_argument_to_a_builtin():
    std.println("{}", 2 ↑ 200)

@test
@expect error 2617 "assert_eq: argument 1: 1606938044258990275541962092341162602522202993782792835301376 needs more bits than any sized type has, and nothing here says which type it should have; the bootstrap implementation has no arbitrary-precision int for it to settle on"
fn error_untyped_argument_to_an_assertion():
    assert_eq(2 ↑ 200, 0)

fn takes_anything(x : T') → i64:
    1i64

@test
@expect error 2617 "takes_anything: parameter 'x': 1606938044258990275541962092341162602522202993782792835301376 needs more bits than any sized type has, and nothing here says which type it should have; the bootstrap implementation has no arbitrary-precision int for it to settle on"
fn error_untyped_argument_to_an_untyped_parameter():
    let n : i64 = takes_anything(2 ↑ 200)

// A number a sized type could hold is left alone: it is the arbitrary
// precision the bootstrap does not have, not the not-yet-settledness.
// The widest are u128 and i127, so a literal is measured against those.
@test
@impure
fn test_an_argument_a_sized_type_could_hold():
    std.println("{}", 1 « 40)
    assert_eq(1 + 1, 2)
    assert_eq(340282366920938463463374607431768211455, @max(u128))
    assert_eq(takes_anything(5), 1)

// Where the parameter states a type, the value settles on it and the
// question does not arise.
fn takes_i64(x : i64) → i64:
    x

@test
fn test_a_stated_parameter_type_settles_the_argument():
    assert_eq(takes_i64(5), 5)
    static_assert_eq(@resultof(takes_i64), i64)

// ---------------------------------------------------------------------
// Every operator that produces a number
// ---------------------------------------------------------------------
//
// Each one below is written twice: once with untyped operands, whose
// result has nothing to settle on and cannot be named, and once with
// a sized operand, which the result takes.  The rule is the operator's
// only involvement -- it is the binding that settles a value -- so the
// point of doing all of them is that none is an exception.

// --- shared by integers and floats ---

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_add():
    let x := 1 + 2

@test
fn test_sized_add():
    let a : i64 = 1
    static_assert_eq(@typeof(a + 2), i64)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_subtract():
    let x := 3 - 1

@test
fn test_sized_subtract():
    let a : i64 = 3
    static_assert_eq(@typeof(a - 1), i64)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_multiply():
    let x := 2 × 3

@test
fn test_sized_multiply():
    let a : i64 = 2
    static_assert_eq(@typeof(a × 3), i64)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : int = …'"
fn error_untyped_divide():
    let x := 6 ÷ 3

@test
fn test_sized_divide():
    let a : i64 = 6
    let q : i64! = a ÷ 3
    assert_eq(q ?? ⁻1, 2)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : int = …'"
fn error_untyped_remainder():
    let x := 7 % 3

@test
fn test_sized_remainder():
    let a : i64 = 7
    let r : i64! = a % 3
    assert_eq(r ?? ⁻1, 1)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_power():
    let x := 2 ↑ 3

@test
fn test_sized_power():
    let a : i64 = 2
    static_assert_eq(@typeof(a ↑ 3), i64)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_max():
    let x := 3 ⌈ 5

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_min():
    let x := 3 ⌊ 5

@test
fn test_sized_max_and_min():
    let a : i64 = 3
    static_assert_eq(@typeof(a ⌈ 5), i64)
    static_assert_eq(@typeof(a ⌊ 5), i64)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_negation():
    let x := ⁻5

@test
fn test_sized_negation():
    let a : i64 = 5
    static_assert_eq(@typeof(⁻a), i64)

// --- integers only ---

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_saturating_add():
    let x := 1 ⊞ 2

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_saturating_subtract():
    let x := 3 ⊟ 1

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_saturating_multiply():
    let x := 2 ⊠ 3

@test
fn test_sized_saturating():
    let a : u8 = 255
    static_assert_eq(@typeof(a ⊞ 1), u8)
    assert_eq(a ⊞ 1, 255)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_shift_left():
    let x := 1 « 4

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_shift_right():
    let x := 16 » 2

@test
fn test_sized_shifts():
    let a : u32 = 1
    static_assert_eq(@typeof(a « 4), u32)
    static_assert_eq(@typeof(a » 1), u32)

@test
fn test_sized_rotations():
    let a : u8 = 1
    static_assert_eq(@typeof(a ↻ 1), u8)
    static_assert_eq(@typeof(a ↺ 1), u8)

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_bitand():
    let x := 5 & 3

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_bitor():
    let x := 5 | 3

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_bitxor():
    let x := 5 ^ 3

@test
@expect error 2278 "'x': a binding with no type written down settles on 'int', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : i64 = …'"
fn error_untyped_bitnot():
    let x := ~5

@test
fn test_sized_bitwise():
    let a : u8 = 5
    static_assert_eq(@typeof(a & 3), u8)
    static_assert_eq(@typeof(a | 3), u8)
    static_assert_eq(@typeof(a ^ 3), u8)
    static_assert_eq(@typeof(~a), u8)

// --- floats only ---

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_float_add():
    let x := 1.5 + 2.5

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_float_multiply():
    let x := 1.5 × 2.0

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_float_divide():
    let x := 3.0 ÷ 2.0

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_float_power():
    let x := 2.0 ↑ 3.0

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_square_root():
    let x := √4.0

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_cube_root():
    let x := ∛8.0

@test
@expect error 2278 "'x': a binding with no type written down settles on 'float', which is an arbitrary-precision type the bootstrap implementation does not provide; state a sized type, as 'let x : f64 = …'"
fn error_untyped_fourth_root():
    let x := ∜16.0

@test
fn test_sized_float_operators():
    let a : f64 = 1.5
    static_assert_eq(@typeof(a + 2.5), f64)
    static_assert_eq(@typeof(a × 2.0), f64)
    static_assert_eq(@typeof(a ÷ 2.0), f64)
    static_assert_eq(@typeof(a ↑ 2.0), f64)
    static_assert_eq(@typeof(⁻a), f64)
    let r : f64 = √4.0f64
    assert(r = 2.0)

// --- what the operators answer with instead of a number ---
//
// A comparison and a logic operator answer with a bool, which is a
// sized type, so a binding taking one needs nothing said.

@test
fn test_comparisons_answer_with_a_bool():
    let lt := 1 < 2
    let eq := 1 = 2
    let ge := 2 >= 1
    assert(lt)
    assert(not eq)
    assert(ge)

@test
fn test_logic_operators_answer_with_a_bool():
    let and_ := true ∧ true
    let or_ := true ∨ true
    let xor := true ⊕ true
    let nand := true ⊼ true
    let nor := true ⊽ true
    let not_ := ¬true
    assert(and_)
    assert(or_)
    assert(not xor)
    assert(not nand)
    assert(not nor)
    assert(not not_)

@test
fn test_tolerant_comparisons_answer_with_a_bool():
    let alike := 1.0 ≅ 1.0
    let unlike := 1.0 ≇ 2.0
    assert(alike)
    assert(unlike)

@start
@impure
fn main():
    std.println("bootstrap tests passed")
