// test_if.ngpl -- if, elif, and else
//
// The clauses are tested in the order they are written, and the first
// whose condition holds is the one that runs.  A chain built the other
// way round would reach `else` before the `elif` above it, which is
// what these check.

// ---------------------------------------------------------------------
// A single condition
// ---------------------------------------------------------------------

@test
fn test_if_taken() → ∅:
    let hit : mut = false
    if true:
        hit ← true
    assert(hit)

@test
fn test_if_not_taken() → ∅:
    let hit : mut = false
    if false:
        hit ← true
    assert(¬hit)

@test
fn test_if_else() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    else:
        which ← 2
    assert_eq(which, 2)

// ---------------------------------------------------------------------
// elif
// ---------------------------------------------------------------------

@test
fn test_elif_taken() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    elif true:
        which ← 2
    assert_eq(which, 2)

@test
fn test_elif_not_taken() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    elif false:
        which ← 2
    assert_eq(which, 0)

// An elif runs in preference to the else below it.
@test
fn test_elif_before_else() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    elif true:
        which ← 2
    else:
        which ← 3
    assert_eq(which, 2)

// And the else runs only when no condition above it held.
@test
fn test_else_after_failing_elif() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    elif false:
        which ← 2
    else:
        which ← 3
    assert_eq(which, 3)

// ---------------------------------------------------------------------
// A chain of them, in order
// ---------------------------------------------------------------------

fn pick(n : i64) → i64:
    if n == 1:
        return 10
    elif n == 2:
        return 20
    elif n == 3:
        return 30
    else:
        return 99

@test
fn test_chain_picks_in_order() → ∅:
    assert_eq(pick(1), 10)
    assert_eq(pick(2), 20)
    assert_eq(pick(3), 30)
    assert_eq(pick(4), 99)

// The first match wins even when a later condition would also hold.
fn first_match(n : i64) → i64:
    if n > 0:
        return 1
    elif n > ⁻10:
        return 2
    elif n > ⁻100:
        return 3
    else:
        return 4

@test
fn test_first_match_wins() → ∅:
    assert_eq(first_match(5), 1)
    assert_eq(first_match(⁻5), 2)
    assert_eq(first_match(⁻50), 3)
    assert_eq(first_match(⁻500), 4)

// A chain with no else falls through when nothing matches.
@test
fn test_chain_without_else() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    elif false:
        which ← 2
    elif false:
        which ← 3
    assert_eq(which, 0)

// Only the matching clause runs; the others leave no trace.
@test
fn test_only_one_clause_runs() → ∅:
    let count : mut = 0
    if true:
        count ← count + 1
    elif true:
        count ← count + 10
    else:
        count ← count + 100
    assert_eq(count, 1)

// ---------------------------------------------------------------------
// Nesting
// ---------------------------------------------------------------------

@test
fn test_nested_chains() → ∅:
    let which : mut = 0
    if true:
        if false:
            which ← 1
        elif true:
            which ← 2
        else:
            which ← 3
    else:
        which ← 4
    assert_eq(which, 2)

@test
fn test_nested_in_else() → ∅:
    let which : mut = 0
    if false:
        which ← 1
    else:
        if false:
            which ← 2
        elif true:
            which ← 3
    assert_eq(which, 3)

@start
fn main() → ∅:
    std.println("if tests passed")
