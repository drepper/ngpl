// Root operator tests: √ (square root), ∛ (cube root), ∜ (fourth root).

@impure
fn approx_eq(a:f64, b:f64, msg:str):
  let diff : mut = a - b
  if diff < 0.0:
    diff ← ⁻diff
  if diff > 0.0001:
    std.println("FAIL: {} (got {} expected {})", msg, a, b)

// --- Square root ---

@test
@impure
fn test_sqrt_f64():
  let x: f64 = 25.0
  let r := √x
  approx_eq(@dropunit(r), 5.0, "√25.0")

@test
@impure
fn test_sqrt_float():
  let x : f64 = 2.0
  let r := √x
  approx_eq(r, 1.4142, "√2.0")

@test
@impure
fn test_sqrt_zero():
  let x: f64 = 0.0
  let r := √x
  approx_eq(r, 0.0, "√0.0")

// --- Cube root ---

@test
@impure
fn test_cbrt_f64():
  let x: f64 = 27.0
  let r := ∛x
  approx_eq(r, 3.0, "∛27.0")

@test
@impure
fn test_cbrt_float():
  let x : f64 = 8.0
  let r := ∛x
  approx_eq(r, 2.0, "∛8.0")

// --- Fourth root ---

@test
@impure
fn test_fourth_root_f64():
  let x: f64 = 81.0
  let r := ∜x
  approx_eq(r, 3.0, "∜81.0")

@test
@impure
fn test_fourth_root_float():
  let x : f64 = 16.0
  let r := ∜x
  approx_eq(r, 2.0, "∜16.0")

// --- Chained roots ---

@test
@impure
fn test_sqrt_of_sqrt():
  let x : f64 = 256.0
  let r := √√x
  approx_eq(r, 4.0, "√√256.0 = ∜256.0")

// --- Integer operand rejected ---

@test
fn test_sqrt_int_rejected():
  let x : i64 = 25
  @expect error "floating-point"
  let r : mut = √x

@test
fn test_cbrt_int_rejected():
  let x : i64 = 27
  @expect error "floating-point"
  let r : mut = ∛x

@test
fn test_fourth_root_int_rejected():
  let x : i64 = 16
  @expect error "floating-point"
  let r : mut = ∜x

// --- Roots with units ---

@test
@impure
fn test_sqrt_unit():
  let area ¤meter×meter : f64 = 36.0
  let side := √area
  // √(36 m^2) = 6 m
  approx_eq(@dropunit(side), 6.0, "√(36 m^2) value")
  std.println("{}", side)

@test
fn test_sqrt_unit_incompatible():
  let d ¤meter : f64 = 9.0
  // √(m) has odd exponent, rejected
  @expect error "exponent"
  let r : mut = √d

@test
@impure
fn test_cbrt_unit():
  let vol ¤meter×meter×meter : f64 = 125.0
  let side := ∛vol
  // ∛(125 m^3) = 5 m
  approx_eq(@dropunit(side), 5.0, "∛(125 m^3) value")
  std.println("{}", side)

@test
@impure
fn test_fourth_root_unit():
  let x ¤meter×meter×meter×meter : f64 = 625.0
  let r := ∜x
  // ∜(625 m^4) = 5 m (approximately)
  approx_eq(@dropunit(r), 5.0, "∜(625 m^4) value")

// --- Negation before root ---

@test
@impure
fn test_neg_sqrt():
  let x : f64 = 9.0
  let r := ⁻√x
  approx_eq(r, ⁻3.0, "⁻√9.0")

@start
@impure
fn main():
  std.println("roots tests passed")
