// Tests for compile-time @ introspection on parameters and loop variables.

// --- @typeof on function parameters ---

fn ret_i32() → i32:
    0

fn typeof_param(x : i32):
    static_assert_eq(@typeof(x), @resultof(ret_i32))

@test
fn test_typeof_param():
    typeof_param(42)

fn typeof_str_param(s : str):
    static_assert_eq(@typeof(s), @typeof(""))

@test
fn test_typeof_str_param():
    typeof_str_param("hello")

fn typeof_bool_param(b : bool):
    static_assert_eq(@typeof(b), @typeof(true))

@test
fn test_typeof_bool_param():
    typeof_bool_param(false)

fn typeof_array_param(arr : i32[]):
    static_assert_eq(@typeof(arr), @typeof([1]))

@test
fn test_typeof_array_param():
    let a : i32[] = [1, 2, 3]
    typeof_array_param(a)

// --- @typeof on foreach loop variables ---

@test
fn test_typeof_foreach_range():
    foreach i := 1…3:
        static_assert_eq(@typeof(i), @typeof(0))

@test
fn test_typeof_foreach_array():
    let arr : i64[] = [10, 20, 30]
    foreach v := arr:
        static_assert_eq(@typeof(v), i64)

// --- @unitof on function parameters ---

fn unitof_param(d ¤meter : i64):
    static_assert_eq(@unitof(d), ¤meter)

@test
fn test_unitof_param():
    unitof_param(100 ¤meter)

// --- @unitof on foreach loop variables ---

@test
fn test_unitof_foreach_range():
    foreach off := 0 ¤byte…3 ¤byte:
        static_assert_eq(@unitof(off), ¤byte)

@test
fn test_unitof_foreach_stepped():
    let total ¤byte : i64 = 128
    foreach off := 0…64…(total - 1):
        static_assert_eq(@unitof(off), ¤byte)

// --- @sizeof on parameter packs ---

fn sizeof_pack_param(args… : T') → i64:
    @dropunit(#args)

@test
fn test_sizeof_pack_param():
    assert_eq(sizeof_pack_param(1, 2, 3), 3)
    assert_eq(sizeof_pack_param(), 0)

// --- @typeof in comptime foreach ---

fn comptime_typeof(args… : T') → i64:
    let count : mut i64 = 0
    comptime foreach v := args:
        if @typeof(v) = @typeof(0):
            count ← count + 1
    count

@test
fn test_typeof_comptime_foreach():
    assert_eq(comptime_typeof(1, "a", 2), 2)

// --- @typeof on a runtime variable ---

// The type of a binding is known without knowing its value, so this
// is answerable; @sizeof below asks about the value and is not.
@test
fn test_typeof_runtime_var():
    let x : mut i64 = 42
    let y : mut i64 = 0
    // Both are written to, so neither mut is a claim the reader would
    // be wrong about, and neither value is one a constant would have.
    x ← x + 1
    y ← x
    static_assert_eq(@typeof(x), @typeof(y))

// --- @sizeof on a name ---

// A name answers from its type, and a length is only in the type when
// the type states it.  A fixed-size array states one.
@test
fn test_sizeof_fixed_array_var():
    let arr : i32[3] = 3 ⍴ 0
    assert_eq(#arr, 3 ¤ptrdiff)

@test
fn test_sizeof_tuple_var():
    let t := (1i64, 2i64, 3i64)
    assert_eq(#t, 3 ¤ptrdiff)

// A dynamically sized array has a length that is not part of its type,
// which is why the length is # and not @sizeof; what @sizeof answers is
// the memory it takes, and that is a question it can answer whether the
// length was written down or not.
@test
fn test_sizeof_dynamic_array_var():
    let arr : i64[] = [1, 2, 3]
    assert_eq(@sizeof(arr), 24¤byte)
    assert_eq(#arr, 3¤ptrdiff)

// --- @unitof on a name ---

// A unit is part of the type, so a name can be asked for it.
@test
fn test_unitof_runtime_var():
    let d ¤meter : mut i64 = 5
    let e ¤meter : mut i64 = 9
    d ← d + e
    e ← d
    static_assert_eq(@unitof(d), @unitof(e))

@start
@impure
fn main():
    std.println("comptime introspection tests passed")
