fn total(m : i64[,]) -> i64:
    let t : mut i64 = 0
    foreach row := m:
        foreach x := row:
            t ← t + x
    return t

fn firstcell(m : i64[2,3]) -> i64:
    return m[0, 0]

fn rowsum(m : i64[,3]) -> i64:
    return m[0, 0] + m[0, 1] + m[0, 2]

fn twobytwo() -> i64[2,2]:
    let m : i64[2,2] = [[1, 2], [3, 4]]
    return m

@impure
@start
fn main():
    let m : mut i64[,3] = [[1, 2, 3], [4, 5, 6]]
    std.println("{}", #m)
    std.println("{} {}", m[1, 2], m[1][0])
    let r := m[1]
    std.println("{} {}", r[0], #r)
    std.println("{}", total(m))
    let m23 : i64[2,3] = [[1, 2, 3], [4, 5, 6]]
    std.println("{} {}", firstcell(m23), rowsum(m23))
    std.println("{} {} {}", #m.shape, m.shape[0], m.shape[1])
    m[0, 1] ← 20
    std.println("{} {}", m[0, 1], total(m))
    m[1] ← [7, 8, 9]
    std.println("{} {}", m[1, 0], total(m))
    // a row handed out shares; narrowing it copies
    let h : mut i64[,] = [[1, 2], [3, 4]]
    let hr := h[1]
    h[1, 0] ← 99
    std.println("{} {}", h[1, 0], hr[0])
    let cut : mut = h[1, 0…1]
    cut[0] ← 5
    std.println("{} {}", cut[0], h[1, 0])
    let top : i64[,] = h[0…1]
    std.println("{} {}", #top, top[1, 0])
    // reshape: a fill and a cycle across the row seam
    let f : mut i64[,] = (2, 3) ⍴ 0
    f[1, 2] ← 7
    std.println("{} {}", f[1, 2], f[0, 0])
    let g : i64[,] = (2, 3) ⍴ [9, 8]
    std.println("{} {} {} {}", g[0, 0], g[0, 2], g[1, 0], g[1, 2])
    let q := twobytwo()
    std.println("{} {}", q[0, 0], q[1, 1])
    let u : u8[2,2] = [[200, 2], [3, 4]]
    std.println("{} {}", u[0, 0], u[1, 1])
    let sl : mut i64 = 0
    foreach row := h[0…1]:
        sl ← sl + row[0]
    std.println("{}", sl)
