// core-2: a measure is a name a number carries, and a file may name
// its own.  The ones the language ships with are written ¤meter; the
// ones a file defines with `unit` are written ¤"widgets", as the
// specification has it.  What a measure does is keep values apart: two
// of the same may be added and compared, a plain number scales one,
// and a quotient of two alike is a bare count.  What prints beside a
// value is the measure's own mark.

unit widgets
unit crates

fn area(w : i64 ¤meter, h : i64 ¤meter) -> i64:
    // two lengths do not multiply into a length, so their measures are
    // parted with before the product is taken
    return @dropunit(w) × @dropunit(h)

fn restock(have : i64 ¤"widgets", more : i64 ¤"widgets") -> i64:
    return @dropunit(have + more)

@impure
@start
fn main():
    let a : i64 ¤meter = 5
    let b : i64 ¤meter = 7
    let t : i64 ¤second = 3
    let m : i64 ¤kilogram = 2
    let c : i64 ¤count = 9
    std.println("{} {} {} {}", a, t, m, c)
    std.println("{} {}", a + b, b - a)
    std.println("{} {}", a < b, a = b)

    // a plain number scales a measured one, either way round
    std.println("{} {}", a × 3, 3 × a)
    std.println("{}", b ÷ 2 ?? 0)

    // two alike cancel to a bare count
    let ratio : i64 = b ÷ a ?? 0
    std.println("{}", ratio)

    // an untyped number takes whatever measure it meets
    std.println("{}", a + 1)

    // a measure a file named for itself
    let w : i64 ¤"widgets" = 4
    let x : i64 ¤"widgets" = 6
    let k : i64 ¤"crates" = 2
    std.println("{} {} {}", w, x, k)
    std.println("{} {}", w + x, restock(w, x))
    std.println("{}", area(a, b))

    // and an array of measured numbers
    let d : i64 ¤meter[] = [10, 20, 30]
    std.println("{} {} {}", d[0], d[2], #d)
    let total : mut i64 = 0
    foreach v := d:
        total ← total + @dropunit(v)
    std.println("{}", total)
