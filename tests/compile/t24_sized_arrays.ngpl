// core-2: sized arrays -- the length is part of the type -- and ⍴
// fills, scalar copies and cycled elements both.

// A sized array is the elements and nothing else only where an element
// is something a load can move.  A P[2] is two structs, and a struct is
// not; it keeps the representation every other array has, and the size
// in its type is a check rather than a layout.
struct P:
    x : i64
    y : i64

struct Grid:
    row : i64[4]

// A sized array answered by a function.  It is written into space the
// caller handed over, because the frame it was computed in ends at the
// return -- answering the callee's own frame would hand back a pointer
// the next call overwrites, and this is where that is pinned.
fn made(k : i64) → i64[4]:
    let v : i64[4] = [k, k + 1, k + 2, k + 3]
    v

// A struct is the one thing that can hold a sized array -- an array of
// them, a dictionary of them and a global of one are all refused -- and
// a struct outlives the frame it was made in, so the elements have to
// be kept where the struct's own memory is.  Held to here for the same
// reason as `made`: without it the field points at a frame that ended.
fn held() → Grid:
    let g : Grid = Grid{row: [11, 12, 13, 14]}
    g

// something to overwrite the frame `made` just left, if it were the
// frame the answer lived in
fn clobbers(a : i64) → i64:
    let junk : i64[4] = [999, 998, 997, 996]
    junk[0] + a

fn takes_any(v : i64[]) → i64:
    @dropunit(#v)

fn total(v : &i64[3]) → i64:
    let s : mut i64 = 0
    foreach x := v:
        s ← s + x
    s

@start
@impure
fn main():
    let a : mut i32[3] = 3 ⍴ 0
    a[1] ← 5
    std.println("{} {} {}", #a, a[0], a[1])
    let lit : i64[3] = [7i64, 8, 9]
    std.println("{} {}", lit[2], #lit)
    let f : mut i64[3] = [1i64, 2, 3]
    std.println("{}", total(&f))
    let cyc : i64[] = 5 ⍴ [10i64, 20]
    std.println("{} {} {} {}", #cyc, cyc[0], cyc[1], cyc[4])
    let emp : i64[] = 0 ⍴ [0i64]
    std.println("{}", #emp)
    let dyn : i64[] = 4 ⍴ 6i64
    std.println("{} {}", #dyn, dyn[3])
    let g : Grid = Grid{row: [1i64, 2, 3, 4]}
    std.println("{}", g.row[3])
    let sl : i64[] = f[0…1]
    std.println("{}", #sl)
    // The elements and nothing else.  A sized array carries no length
    // and no capacity: the type says how many there are, so #x is a
    // constant, x[i] is checked against a constant, and the whole
    // thing is bytes in the frame rather than a header and a second
    // allocation somewhere else.  These exercise the paths where that
    // representation has to meet the other one.
    let wide : u8[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    std.println("{} {} {}", #wide, wide[0], wide[7])
    let joined : u8[] = wide ⧺ wide
    std.println("{} {} {}", #joined, joined[0], joined[15])
    let cut : u8[] = wide[2¤byte…4¤byte]
    std.println("{} {} {}", #cut, cut[0], cut[2])
    // every element written through, then read back
    let filled : mut i16[6] = 6 ⍴ 0i16
    let k : mut i64 = 0
    while k < 6:
        let v16 : i16 = k × 3
        filled[k × 1¤ptrdiff] ← v16
        k ← k + 1
    std.println("{} {} {}", #filled, filled[0], filled[5])
    let tot : mut i64 = 0
    foreach e := filled:
        tot ← tot + e
    std.println("{}", tot)
    let answered : i64[4] = made(1)
    let _ignored : i64 = clobbers(7)
    std.println("{} {} {} {}", answered[0], answered[1],
                answered[2], answered[3])
    let kept : Grid = held()
    let _also : i64 = clobbers(8)
    std.println("{} {} {} {}", kept.row[0], kept.row[1],
                kept.row[2], kept.row[3])
    let pairs : P[2] = [P{x: 1, y: 2}, P{x: 3, y: 4}]
    std.println("{} {} {}", #pairs, pairs[0].x, pairs[1].y)
    let words : str[2] = ["one", "two"]
    std.println("{} {}", #words, words[1])
    // A T[] whose length is settled where it is written, and which
    // never leaves the function, is laid out the way a T[N] is.  Its
    // type does not change and nothing legal on it becomes illegal;
    // what changes is that there is no header beside the elements and
    // nothing is allocated for them.  Whether it leaves is decided by
    // counting: every read of the name is counted, and the reads in the
    // places a packed array serves are counted again, so a use nobody
    // anticipated disqualifies the binding rather than miscompiling it.
    let settled : i64[] = [3, 5, 7, 9]
    let acc : mut i64 = 0
    foreach s := settled:
        acc ← acc + s
    std.println("{} {} {}", acc, #settled, settled[2])
    // ⧺, a slice and ⍴ read a packed array by laying it out afresh,
    // which is what they already do to a T[N], so they do not want the
    // header either and the binding keeps its packing through them
    let both : i64[] = settled ⧺ settled
    std.println("{} {} {}", #both, both[0], both[7])
    let part : i64[] = settled[1…2]
    std.println("{} {} {}", #part, part[0], part[1])
    let cycled : i64[] = 6 ⍴ settled
    std.println("{} {} {}", #cycled, cycled[4], cycled[5])
    // this one is handed to a function, so it keeps its header
    let handed : i64[] = [2, 4, 6]
    std.println("{} {}", takes_any(handed), handed[0])
    // and this one is written to again, so its length is not settled
    let rebound : mut i64[] = [1, 1]
    rebound ← [1, 2, 3]
    std.println("{} {}", #rebound, rebound[2])
