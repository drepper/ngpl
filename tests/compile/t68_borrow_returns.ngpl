// A function may answer a borrow of what it was lent: `→ &T |p|` says
// the answer reaches into p.  At the call the caller's binding is lent
// to whatever binds the answer, and held until that binding's last
// use -- not until its block closes, which is what lets the bag be
// changed once nothing is looking at it any more.

struct Bag:
    items : i64[]

impl Bag:
    fn view(&self) → &i64[]:
        self.items

    // without the &, the caller gets a copy of its own
    fn copy(&self) → i64[]:
        self.items

fn items_of(b : &Bag) → &i64[] |b|:
    b.items

fn longer(a : &Bag, b : &Bag) → &i64[] |a, b|:
    if #a.items > #b.items: a.items else: b.items

// a borrow handed on is the same borrow, rooted where it was rooted
fn first_two(b : &Bag) → &i64[] |b|:
    items_of(&b)

// an array the function made and showed to nothing goes back to the
// allocator after its last use, which is before the function ends
fn total(n : i64) → i64:
    let w : i64[] = [10, 20]
    let s : i64 = w[0] + w[1]
    let v : mut i64[] = [1, 2, 3]
    v.push(n)
    s + @dropunit(#v)

// a fresh local moves out; a by-value parameter, which is the
// caller's own under an elided copy, is copied -- and the two must
// not be confused by sitting in the same slot of different functions
fn made() → i64[]:
    let out : mut i64[] = []
    out.push(1)
    out

fn same(v : i64[]) → i64[]:
    v

@start
@impure
fn main():
    let src : i64[] = [5, 6]
    let dup : mut i64[] = same(src)
    dup.push(7)
    std.println("made {} dup {} src {}", #made(), #dup, #src)
    let b : mut Bag = Bag{items: [1, 2, 3]}
    let v := b.view()
    std.println("view {}", #v)
    // v's last use was the line above, so b is its own again
    b.items.push(4)
    let w : &i64[] = items_of(&b)
    std.println("items {}", #w)
    let c : mut Bag = Bag{items: [9]}
    let l := longer(&b, &c)
    std.println("longer {}", #l)
    c.items.push(8)
    let f := first_two(&b)
    std.println("chain {}", #f)
    let own : mut i64[] = b.copy()
    own.push(0)
    std.println("copy {} bag {}", #own, #b.items)
    std.println("bag {} {} total {}", #b.items, #c.items, total(4))
