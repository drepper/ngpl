// The second file names Level, which the first declares, so it binds
// the file that holds it and writes the name through that binding.
// The enum it takes and the one the third file writes are one enum:
// two bindings of a file are two names for one module.

let a := @import("./a.ngpl")

@export
fn announce(l : a.Level, loud : str) → str:
    a.greeting(l) ⧺ ", " ⧺ loud
