// The third file completes the program and is the one it is rooted in.
// It binds both of the others: what a file needs it says for itself,
// and a name reaching it through b would be b's to give away.

let a := @import("./a.ngpl")
let b := @import("./b.ngpl")

fn shout(l : a.Level) → str:
    if l = a.Level.quiet: "world" else: "WORLD"

@start
@impure
fn main():
    std.println("{}", b.announce(a.Level.quiet, shout(a.Level.quiet)))
    std.println("{}", b.announce(a.Level.loud, shout(a.Level.loud)))
