// The third file completes the program, and is the one the program is
// rooted in: it names the second, which names the first, and that is
// the whole of what anything outside has to know.

@import("./b.ngpl")

fn shout(l : Level) → str:
    if l = Level.quiet: "world" else: "WORLD"

@start
@impure
fn main():
    std.println("{}", announce(Level.quiet))
    std.println("{}", announce(Level.loud))
