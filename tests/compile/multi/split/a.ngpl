// The first of three files that make one program.  It declares the
// enum, which the file after it uses as a type -- an enum is a measure
// away from being one, and a unit is registered as it is read, so a
// file that names one wants it read first.  It also carries the build
// recipe, which no file of its own is needed for.

enum Level:
    quiet
    loud

fn greeting(l : Level) → str:
    if l = Level.quiet: "hello" else: "HELLO"

@build
fn build(b : &mut std.Build, output : str, target : str):
    b.add_executable(std.Build.Executable{name: "split",
                                          root_source_file: "c.ngpl"})
