// The first of three files that make one program.  It declares the
// enum the file above it names as a type, and marks it @export: what a
// module lets others name is what it says so about.  It also carries
// the build recipe, which no file of its own is needed for.

@export
enum Level:
    quiet
    loud

@export
fn greeting(l : Level) → str:
    if l = Level.quiet: "hello" else: "HELLO"

@build
fn build(b : &mut std.Build):
    b.add_executable(std.Build.Executable{name: "split",
                                          root_source_file: "c.ngpl"})
