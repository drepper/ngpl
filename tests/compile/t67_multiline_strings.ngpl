// Three quotes open a string that need not end on the line it starts.
// The quote that begins each continuation line, the whitespace before
// it, and the line break itself are not part of what the string holds,
// so a message written across several lines is one line of text and
// does not depend on where the source happened to wrap.

@start
@impure
fn main():
    // the pieces are joined as they were written; the space each one
    // needs is written after its quote, where it can be seen
    let joined : str = """the pieces are joined
                        " as they were written"""
    std.println("[{}]", joined)

    // a break inside the text is written as it is in any other string
    let broken : str = """one\n
                        "two"""
    std.println("[{}]", broken)

    // three quotes end it, at the end of a piece or alone on a line
    let alone : str = """the closing quotes may stand
                       " on a line of their own
                       """
    std.println("[{}]", alone)

    // a single quote inside needs no escape, since three end the string
    let quoted : str = """a " needs no escape here"""
    std.println("[{}]", quoted)

    // and one written this way holds nothing, as "" does
    let empty : str = """"""
    std.println("[{}] {} {}", empty, #empty, empty = "")

    // it is a string like any other: it joins, it slices, it compares
    std.println("[{}] [{}] {}", joined ⧺ "!", joined[0¤ptrdiff…3¤ptrdiff],
                """abc""" = "abc")
