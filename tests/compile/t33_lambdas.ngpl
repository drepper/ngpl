fn square(x : i32) -> i32:
    return x × x

fn addmul(a : i64, b : i64) -> i64:
    return a + b × 10

@impure
@start
fn main():
    let f := λx : i64 → i64: x × 2
    std.println("{}", f(21))
    let n : mut i64 = 10
    let g := λx : i64 |n| → i64: x + n
    n ← 99
    std.println("{}", g(1))
    let h := λx : i64, y : i64 → i64: x × y
    std.println("{}", h(6, 7))
    let arr := generate(λx : i64 → i64: x × 2, 1…5)
    std.println("{} {} {}", #arr, arr[0], arr[4])
    let sq := generate(square, 1i32…4i32)
    std.println("{} {} {}", #sq, sq[0], sq[3])
    let offset : i64 = 100
    let capd := generate(λx : i64 |offset| → i64: x + offset, 1…3)
    std.println("{} {}", capd[0], capd[2])
    let stepped := generate(λx : i64 → i64: x, 0…2…10)
    std.println("{} {}", #stepped, stepped[5])
    let down := generate(λx : i64 → i64: x × x, 3…1)
    std.println("{} {} {}", down[0], down[1], down[2])
    let am := addmul
    std.println("{}", am(3, 4))
    let r := 1…5
    let viar := generate(λx : i64 → i64: x + 1, r)
    std.println("{} {}", viar[0], viar[4])
    let strl := λc : char → i64: if c = 'x': 7 else: 8
    std.println("{} {}", strl('x'), strl('y'))
