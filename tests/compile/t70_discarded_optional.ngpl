// A method call whose value is thrown away.
//
// `_ ← e` says the value is meant to go nowhere.  Where e is a method
// call answering an optional -- get past the end, pop from an empty
// array -- there is no `??` beside it to say what to answer instead,
// and there does not need to be: the optional is what is discarded.
//
// The compiler used to tell its checker that a default was coming, so
// the call answered the element type rather than the optional, and
// lowering then reached for a default that was never written.  That is
// a crash rather than a diagnostic, which is the worst kind of
// refusal.

@start
@impure
fn main():
    let v : mut i64[] = [1, 2, 3]

    // in range and past the end, both discarded
    _ ← v.get(0¤ptrdiff)
    _ ← v.get(99¤ptrdiff)

    // pop is the same shape and was already right; it stays right
    _ ← v.pop()

    // and the value still arrives where something reads it
    let first : i64 = v.get(0¤ptrdiff) ?? 9
    let past : i64 = v.get(99¤ptrdiff) ?? 9
    let held : i64? = v.get(1¤ptrdiff)

    std.println("{} {} {} {}", @dropunit(#v), first, past, held ?? 0)
