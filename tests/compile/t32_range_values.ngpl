fn total(r : i64[]) -> i64:
    let t : mut i64 = 0
    foreach x := r:
        t ← t + x
    return t

@impure
@start
fn main():
    let r := 3…8
    let s : mut i64 = 0
    foreach i := r:
        s ← s + i
    std.println("{}", s)
    let a := 1i32…4i32
    let s2 : mut i32 = 0
    foreach i := a:
        s2 ← s2 + i
    std.println("{}", s2)
    let d := 5…0
    let c : mut i64 = 0
    foreach i := d:
        c ← c + 1
    std.println("{}", c)
    let e := 0…2…11
    let s3 : mut i64 = 0
    foreach x := e:
        s3 ← s3 + x
    std.println("{}", s3)
    let f : i64[] = (5) ⍴ (1…4)
    std.println("{} {} {}", f[0], f[3], f[4])
    let g : i32[] = (5) ⍴ (1…4)
    std.println("{} {}", g[0], g[4])
    let m : i64[,] = (2, 4) ⍴ (1…9)
    std.println("{} {} {}", m[0, 0], m[1, 3], m[1, 0])
    let dn : i64[] = (4) ⍴ (9…7)
    std.println("{} {}", dn[0], dn[3])
    std.println("{}", total((3) ⍴ (2…5)))
    let w := 1 + 2 … 10 - 3
    let s4 : mut i64 = 0
    foreach i := w:
        s4 ← s4 + i
    std.println("{}", s4)
    let v : i64[] = [10, 20, 30, 40]
    let sl := v[1…3]
    std.println("{} {}", sl[0], sl[1])
