// `v ← v ⧺ w` where v names the same array on both sides grows that
// array rather than building a fresh one out of two, and a listable
// operator written back into what it reads writes into it.  What they
// mean is unchanged, so telling takes something that still names the
// same array: a binding of its own takes a copy, and a struct is a
// reference, so two names for one struct are two ways to the one array
// its field holds.

struct Table:
    names : str[]
    extra : i64[]

impl Table:
    // Take items onto the end of the table's own array, answering where
    // they start.
    fn push_list(&mut self, items : i64[]) → i64 ¤ptrdiff:
        let off : i64 ¤ptrdiff = #self.extra
        self.extra ← self.extra ⧺ items
        off

// The elements of an array, in order, on one line.
@impure
fn show(v : i64[]):
    foreach x := v:
        std.print("{} ", x)
    std.println("|")

@start
@impure
fn main():
    let v : mut i64[] = [1, 2]
    // a binding of its own: what it holds is what v held, and v growing
    // afterwards is v's business
    let keep : i64[] = v
    v ← v ⧺ [3, 4]
    v ← v ⧺ [5]
    show(v)
    show(keep)

    // and the same array under two names, which is what sees it grow
    let one : mut Table = Table{names: [], extra: [1, 2]}
    let two : Table = one
    one.extra ← one.extra ⧺ [3]
    show(two.extra)
    one.extra ← one.extra + 10
    show(two.extra)

    let t : mut Table = Table{names: ["a"], extra: []}
    std.println("{} {}", @dropunit(t.push_list([7, 8])), @dropunit(t.push_list([9])))
    show(t.extra)
    std.println("{} {}", t.names[0¤ptrdiff], @dropunit(#t.names))

    // the two sides name different places, so this one is still a join
    let w : mut i64[] = [10]
    let u : i64[] = [11, 12]
    w ← u ⧺ w
    show(w)
    show(u)

    let s : mut str = "ab"
    s ← s ⧺ "cd"
    std.println("{}", s)

    // and the listable operators, which write their answers into the
    // array they read rather than building one of the same length
    let o : mut i64[] = [1, 2, 3]
    o ← o + 10
    show(o)
    o ← 100 - o
    show(o)
    o ← o × o
    show(o)
    let p : i64[] = [1, 2, 3]
    o ← o + p
    show(o)
    o ← p × o
    show(o)

    let q : mut Table = Table{names: [], extra: [5, 6]}
    q.extra ← q.extra + 1
    show(q.extra)

    // neither side names the place written, so this one builds its own
    let r : mut i64[] = [0, 0, 0]
    r ← p + p
    show(r)
    show(p)
