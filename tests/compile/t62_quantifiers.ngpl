// core-1: the quantifier operators ∀, ∃ and ∄.
//
// `f ∀ v` asks whether f holds of every one of the things v holds,
// `f ∃ v` whether it holds of any, and `f ∄ v` whether it holds of
// none.  An array or a range may stand on
// the right; the interpreter also takes an iterator, which the
// compiled subset does not, so nothing here asks about one.
//
// The last test is the one worth having.  Both operators exit at the
// first element that settles the question and ask about no more, and
// the way to prove that rather than describe it is to quantify over a
// range that runs past the end of an array: a walk that leaves where
// it should never reaches an index out of range, and a walk that
// finishes the container stops the program.

fn positive(n : i64) → bool:
    n > 0

fn small(n : i64) → bool:
    n < 10


@start
@impure
fn main():
    let v : i64[] = [1, 2, 3]
    let w : i64[] = [1, ⁻2, 3]
    let e : i64[] = []
    std.println("{} {} {}", positive ∀ v, positive ∃ v, positive ∄ v)
    std.println("{} {} {}", positive ∀ w, positive ∃ w, positive ∄ w)
    std.println("{} {} {}", positive ∀ e, positive ∃ e, positive ∄ e)
    // a range on the right, and a lambda on the left
    std.println("{}", (λx : i64 → bool: x < 100) ∀ 1…6)
    std.println("{}", (λx : i64 → bool: x > 4) ∃ 1…6)
    // the answer is a bool, so the logical operators take it unbracketed
    std.println("{}", positive ∀ v ∧ small ∃ v)
    // ⧺ is absorbed into the right operand, as it is for a fold
    std.println("{}", positive ∀ v ⧺ w)
    // A measured range walked by a measured parameter: the index
    // arrives an index, and nothing puts the measure on inside the
    // question or takes it off outside.
    let name : str = "i64"
    std.println("{} {}", (λi : i64 ¤ptrdiff |name| → bool: name[i] ≠ 'x') ∀ 0…#name - 1,
                (λi : i64 ¤ptrdiff |name| → bool: name[i] = 'x') ∄ 0…#name - 1)
    // the exit, proved: "i64" is three long and the range runs to 9,
    // so only a walk that leaves at index 1 -- the first that does not
    // hold -- stays inside the string
    std.println("{}", (λi : i64 ¤ptrdiff |name| → bool: name[i] = 'i') ∀ 0¤ptrdiff…10¤ptrdiff)
