// A handle answers one digest.  digest() is where what it held is
// dropped, so there is nothing left to answer with afterwards, and
// asking again stops the program rather than handing back something
// that is no longer true.
//
// The prefix printed before the stop is what both runs must agree on;
// what they say afterwards is each implementation's own wording.

@start
@impure
fn main():
    let h : mut = std.hash.sha256.start()
    h.update("abc")
    std.println("a digest is {} long", #h.digest())
    // and this is one too many.  It is bound rather than printed
    // because a compiled std.println puts the literal part of its
    // format down before it works out what goes in the {}, so an
    // argument that stops the program leaves that much on stdout and
    // the interpreter, which formats the whole line first, does not.
    let second : u8[32] = h.digest()
    std.println("second: {}", #second)
