// @flag enums: members are independent bits, the automatic values
// double from one, nil is the empty combination, and the bit
// operators are the set operations.  What is pinned here is that the
// two implementations agree on the values, the operators, the
// complement's mask, ord()'s answer, and the bytes a flag field puts
// down through a @repr(C) layout.

@flag
enum Perm : u32:
    x
    w
    r

@flag
enum Wide : u64:
    lo
    mid = 65536
    hi

enum Plain : u16:
    a
    b

@repr(C)
struct Mode:
    bits : Perm
    kind : Plain
    pad : u16

@impure
fn values():
    std.println("{} {} {} {}", Perm.x.ord(), Perm.w.ord(), Perm.r.ord(), Perm.nil.ord())
    // an explicit value resets the doubling from itself
    std.println("{} {} {}", Wide.lo.ord(), Wide.mid.ord(), Wide.hi.ord())
    std.println("{} {}", Plain.a.ord(), Plain.b.ord())

@impure
fn operators():
    let rw := Perm.r | Perm.w
    std.println("{}", rw.ord())
    std.println("{} {}", (rw & Perm.r) = Perm.r, (rw & Perm.x) = Perm.x)
    std.println("{}", (rw ^ Perm.w) = Perm.r)
    // the complement stays within the set's own bits
    std.println("{}", (~rw) = Perm.x)
    std.println("{}", (~Perm.nil).ord())

@impure
fn through_a_layout():
    std.println("{} {}", @sizeof(Mode), Mode.offsetof("kind"))
    let m : Mode = Mode{bits: Perm.r | Perm.x, kind: Plain.b, pad: 0}
    std.println("{} {}", m.bits.ord(), (m.bits & Perm.w) = Perm.w)
    let f := std.fs.cwd().create_file("/tmp/ngpl_t57.tmp", 420)
    let runs : mut std.iovec[] = []
    runs.push(std.iov(m))
    f.writev(runs)
    f.close()
    let alloc := std.arena.allocator()
    match std.fs.cwd().open_file("/tmp/ngpl_t57.tmp"):
        ⊨(g):
            let got := g.read_file(alloc)
            std.println("{} {} {} {}", #got, got[0¤byte], got[4¤byte], got[6¤byte])
        ∅:
            std.println("vanished")

// std.filetype is an enumeration like any the file declares: its
// members answer .ord(), it compares with a number without becoming
// one, and it is reached through std rather than by a bare name.
// A @flag enum's values are combinations of its members, which no
// bare number names.  So a number neither becomes one nor is compared
// with one -- .ord() is the door to the bits, and a program that wants
// them writes it down.  An ordinary enum is different on both counts.
@expect error 2827 "'Perm' is a @flag enum, so its values are combinations of members that a bare number does not name"
fn error_a_number_does_not_become_a_flag() → bool:
    let bad : Perm = 1
    bad = Perm.x

@expect error 2826 "'Perm' is a @flag enum, so its values are combinations of members that a bare number does not name; write .ord() to compare the bits"
fn error_a_number_is_not_compared_with_a_flag() → bool:
    Perm.x = 1

@impure
fn the_bits_are_asked_for():
    std.println("{} {}", Perm.x.ord() = 1, (Perm.r | Perm.w).ord() = 6)
    // an ordinary enum answers the question directly
    std.println("{} {}", Plain.b = 1, Plain.b = 9)

@impure
fn the_builtin_enum():
    std.println("{} {} {}", std.filetype.unknown.ord(), std.filetype.dir.ord(), std.filetype.reg.ord())
    std.println("{} {}", std.filetype.reg = 32768, std.filetype.reg = 1)
    std.println("{}", std.filetype.dir = std.filetype.dir)
    std.println("{}", @typeof(std.filetype.lnk))

@impure @start
fn main():
    values()
    operators()
    through_a_layout()
    the_bits_are_asked_for()
    the_builtin_enum()
