// core-2: iterators -- born of iterate(), stepped by next(), holding
// the array they were made from until the block they were made in
// ends -- and std.bytes.
//
// This file used to change the array while an iterator was live and
// print what the iterator made of it.  That is refused now: an
// iterator borrows its array for reading, so the array may be read and
// not changed while the iterator lives.  See the specification's
// "What a Walk Holds"; tests/test_walk_holds.ngpl holds both
// implementations to the rule, and this shows the borrow ending.

@start
@impure
fn main():
    let v : mut i64[] = [1i64, 2]
    let a : mut i64 = 0
    let b : mut i64 = 0
    let c : mut i64 = 0
    if true:
        let it := v.iterate()
        a ← it.next() ?? ⁻1
        b ← it.next() ?? ⁻1
        c ← it.next() ?? ⁻1
    // the iterator went with its block, so the array is free again
    v.push(3)
    std.println("{} {} {} {}", a, b, c, @dropunit(#v))

    let ss : str[] = ["x", "y"]
    let sit := ss.iterate()
    while nm := sit.next():
        std.println("[{}]", nm)

    let ps : i64[] = [10i64, 20, 30]
    let pit := ps.iterate()
    let t : mut i64 = 0
    while x := pit.next():
        t ← t + x
    std.println("{}", t)

    // two iterators over one array step on their own
    let one := ps.iterate()
    let two := ps.iterate()
    let f1 : i64 = one.next() ?? ⁻1
    let f2 : i64 = two.next() ?? ⁻1
    let f3 : i64 = one.next() ?? ⁻1
    std.println("{} {} {}", f1, f2, f3)

    let bs := std.bytes("abé")
    std.println("{} {} {}", #bs, bs[0¤byte], bs[3¤byte])
