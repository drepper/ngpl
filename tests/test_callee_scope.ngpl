// A name frozen in the caller is not frozen in the callee.  A foreach
// variable, a while binding, or a borrow freezes the caller's name,
// and a function it calls may use the same spelling for a mut local of
// its own.  Before this was fixed the callee's assignment was refused
// as writing to the caller's loop variable.

fn count_up(n : i64) → i64:
    let i : mut i64 = 0
    while i < n:
        i ← i + 1
    i

@test
fn test_callee_reuses_a_foreach_name():
    let total : mut i64 = 0
    foreach i := 1…4:
        total ← total + count_up(i)
    assert_eq(total, 6)

@test
fn test_callee_reuses_a_while_binding_name():
    let v : i64[] = [10, 20]
    let it := v.iterate()
    let total : mut i64 = 0
    while e := it.next():
        total ← total + e + count_up(2) - count_up(2)
    assert_eq(total, 30)

fn e(n : i64) → i64:
    let e : mut i64 = n
    e ← e × 2
    e

@test
fn test_a_function_may_shadow_its_own_name_story():
    let one : i64[] = [1]
    let it := one.iterate()
    let total : mut i64 = 0
    while e2 := it.next():
        total ← total + e(e2)
    assert_eq(total, 2)

@start
@impure
fn main():
    std.println("callee scope tests passed")
