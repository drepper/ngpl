// Tests for enum types: definition, access, comparison, @flag enums,
// bitwise flag operations, std.errors, and invalid operations.

// ---- basic enum definition and member access -----------------------------

enum Color:
    red
    green
    blue

@test
fn test_enum_member_access():
    let c := Color.red
    assert_eq(c, Color.red)

@test
fn test_enum_sequential_values():
    assert(Color.red.ord() = 0)
    assert(Color.green.ord() = 1)
    assert(Color.blue.ord() = 2)

@test
fn test_enum_equality():
    let a := Color.red
    let b := Color.red
    let c := Color.blue
    assert(a = b)
    assert(not (a = c))
    assert(a ≠ c)

// ---- enum with explicit values -------------------------------------------

enum Status:
    ok = 0
    warning = 10
    error = 20
    fatal = 30

@test
fn test_enum_explicit_values():
    assert(Status.ok.ord() = 0)
    assert(Status.warning.ord() = 10)
    assert(Status.error.ord() = 20)
    assert(Status.fatal.ord() = 30)

// ---- enum with mixed auto and explicit -----------------------------------

enum Level:
    low
    medium
    high = 10
    critical

@test
fn test_enum_mixed_values():
    assert(Level.low.ord() = 0)
    assert(Level.medium.ord() = 1)
    assert(Level.high.ord() = 10)
    assert(Level.critical.ord() = 11)

// ---- enum with underlying type -------------------------------------------

enum SmallEnum : u8:
    a
    b
    c

@test
fn test_enum_underlying_type():
    let x := SmallEnum.a
    assert(x.ord() = 0)
    assert(x = SmallEnum.a)

// ---- @flag enum: powers of two -------------------------------------------

@flag
enum Perms:
    read
    write
    exec

@test
fn test_flag_auto_values():
    assert(Perms.read.ord() = 1)
    assert(Perms.write.ord() = 2)
    assert(Perms.exec.ord() = 4)

@test
fn test_flag_nil_auto_created():
    assert(Perms.nil.ord() = 0)

@test
fn test_flag_combine_or():
    let rw := Perms.read | Perms.write
    assert(rw.ord() = 3)

@test
fn test_flag_combine_all():
    let all := Perms.read | Perms.write | Perms.exec
    assert(all.ord() = 7)

@test
fn test_flag_and():
    let rw := Perms.read | Perms.write
    let r := rw & Perms.read
    assert_eq(r, Perms.read)

@test
fn test_flag_xor():
    let rw := Perms.read | Perms.write
    let toggled := rw ^ Perms.write
    assert_eq(toggled, Perms.read)

@test
fn test_flag_not():
    let rw := Perms.read | Perms.write
    let notrw := ~rw
    assert_eq(notrw, Perms.exec)

@test
fn test_flag_and_test_membership():
    let rw := Perms.read | Perms.write
    let has_read := (rw & Perms.read) = Perms.read
    let has_exec := (rw & Perms.exec) = Perms.exec
    assert(has_read)
    assert(not has_exec)

// ---- @flag enum with explicit values -------------------------------------

@flag
enum Flags:
    a = 1
    b = 4
    c
    d

@test
fn test_flag_explicit_and_auto():
    assert(Flags.a.ord() = 1)
    assert(Flags.b.ord() = 4)
    assert(Flags.c.ord() = 8)
    assert(Flags.d.ord() = 16)

// ---- @flag enum with explicit zero (no auto nil) -------------------------

@flag
enum Mode:
    off = 0
    read = 1
    write = 2

@test
fn test_flag_explicit_zero_no_nil():
    assert(Mode.off.ord() = 0)
    assert(Mode.read.ord() = 1)

// ---- std.errors enum -----------------------------------------------------

@test
fn test_std_errors_runtime():
    let e := std.errors.division_by_zero
    assert(e.ord() = 100)
    assert_eq(e, std.errors.division_by_zero)

@test
fn test_std_errors_compile():
    assert(std.errors.type_mismatch.ord() = 200)
    assert(std.errors.unknown_type.ord() = 201)
    assert(std.errors.syntax_error.ord() = 202)

@test
fn test_std_errors_library():
    assert(std.errors.file_not_found.ord() = 300)
    assert(std.errors.permission_denied.ord() = 301)
    assert(std.errors.io_error.ord() = 302)

@test
fn test_std_errors_grouping():
    // Runtime errors are in 100-199
    let div := std.errors.division_by_zero
    assert(div.ord() = 100 ∧ 100 <= 199)
    // Compile errors are in 200-299
    let typ := std.errors.type_mismatch
    assert(typ.ord() = 200 ∧ 200 <= 299)
    // Library errors are in 300-399
    let fnf := std.errors.file_not_found
    assert(fnf.ord() = 300 ∧ 300 <= 399)

// ---- invalid operations on non-flag enums --------------------------------

@expect error 2814 "bitwise operations require @flag enum, got 'Color'"
fn error_bitor_non_flag():
    let a : mut = Color.red
    let b : mut = Color.green
    let c : mut = a | b

@expect error 2811 "bitwise operations require @flag enum, got 'Color'"
fn error_bitand_non_flag():
    let a : mut = Color.red
    let b : mut = Color.green
    let c : mut = a & b

@expect error 2812 "bitwise operations require @flag enum, got 'Color'"
fn error_bitxor_non_flag():
    let a : mut = Color.red
    let b : mut = Color.green
    let c : mut = a ^ b

@expect error 2816 "bitwise-not requires @flag enum, got 'Color'"
fn error_bitnot_non_flag():
    let a : mut = Color.red
    let b : mut = ~a

// ---- cross-enum comparison error -----------------------------------------

@expect error 2810 "cannot compare enum 'Color' with enum 'Status'"
fn error_cross_enum_compare():
    let a : mut = Color.red
    let b : mut = Status.ok
    let x : mut = a = b

@expect error 2813 "cannot combine enum 'Perms' with 'Flags'"
fn error_cross_enum_bitor():
    let a : mut = Perms.read
    let b : mut = Flags.a
    let c : mut = a | b

@start
@impure
fn main():
    std.println("enum tests passed")
