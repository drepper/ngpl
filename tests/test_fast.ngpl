@test
fn test_fast_local():
    let i : mut u32fast = 0
    foreach k : u32fast = 0…9:
        i ← i + k
    assert_eq(i, 45)

@test
fn test_fast_wrapping():
    // u8fast is 32-bit on x86_64, so 255 + 1 = 256, not 0.
    let x : mut u8fast = 255
    x ← x + 1
    assert_eq(x, 256)

@test
fn test_fast_signed():
    let x : i8fast = ⁻1
    // i8fast is 32-bit signed, so ⁻1 stays ⁻1 (no 8-bit wrapping).
    assert_eq(x, ⁻1)

@start
@impure
fn main():
    std.println("fast type tests passed")
