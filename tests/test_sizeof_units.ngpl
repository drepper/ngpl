// Tests for sizeof returning unit-bearing values and dimensionless arithmetic.

// Untyped, so a measured value reaches it with its unit intact
// and the comparison below checks the unit as well as the number.
@impure
fn assert_eq_int(a, b, msg:str):
  if a != b:
    std.println("FAIL: {} (got {} expected {})", msg, a, b)

@impure
fn assert_true(cond:bool, msg:str):
  if not cond:
    std.println("FAIL: {}", msg)

// --- sizeof returns ptrdiff unit ---

@test
@impure
fn test_sizeof_array_ptrdiff():
  let arr := [10, 20, 30]
  let sz := arr.sizeof
  assert_eq_int(sz, 3, "array sizeof is 3")

@test
@impure
fn test_sizeof_string_ptrdiff():
  let s := "hello"
  let sz := s.sizeof
  assert_eq_int(sz, 5, "string sizeof is 5")

// --- sizeof byte[] returns byte unit ---

@test
@impure
fn test_sizeof_byte_array():
  let buf: u8[4] = [1, 2, 3, 4]
  let sz := buf.sizeof
  assert_eq_int(sz, 4, "byte array sizeof is 4")

// --- dimensionless + unit-bearing: addition ---

@test
@impure
fn test_add_unit_plus_dimensionless():
  let a ¤meter := 10
  let b := a + 3
  assert_eq_int(b, 13, "10m + 3")

@test
@impure
fn test_add_dimensionless_plus_unit():
  let a ¤meter := 10
  let b := 5 + a
  assert_eq_int(b, 15, "5 + 10m")

// --- dimensionless + unit-bearing: subtraction ---

@test
@impure
fn test_sub_unit_minus_dimensionless():
  let a ¤meter := 10
  let b := a - 3
  assert_eq_int(b, 7, "10m - 3")

@test
@impure
fn test_sub_dimensionless_minus_unit():
  let a ¤meter := 10
  let b := 20 - a
  assert_eq_int(b, 10, "20 - 10m")

// --- dimensionless * unit-bearing: multiplication preserves unit ---

@test
@impure
fn test_mul_unit_times_dimensionless():
  let a ¤meter := 5
  let b := a × 3
  assert_eq_int(b, 15, "5m × 3 = 15m")

@test
@impure
fn test_mul_dimensionless_times_unit():
  let a ¤meter := 5
  let b := 3 × a
  assert_eq_int(b, 15, "3 × 5m = 15m")

// --- dimensionless / unit-bearing ---

@test
@impure
fn test_div_unit_by_dimensionless():
  let a ¤meter := 12
  let b := a ÷ 3
  assert_eq_int(b, 4, "12m / 3 = 4m")

// --- dimensionless % unit-bearing ---

@test
@impure
fn test_mod_unit_by_dimensionless():
  let a ¤meter := 10
  let b := a % 3
  assert_eq_int(b, 1, "10m % 3 = 1m")

@test
@impure
fn test_mod_dimensionless_by_unit():
  let a ¤meter := 3
  let b := 10 % a
  assert_eq_int(b, 1, "10 % 3m = 1m")

// --- comparison with dimensionless ---

@test
@impure
fn test_cmp_unit_with_dimensionless():
  let a ¤meter := 5
  assert_true(a > 3, "5m > 3")
  assert_true(2 < a, "2 < 5m")
  assert_true(a == 5, "5m == 5")

// --- sizeof result used in arithmetic ---

@test
@impure
fn test_sizeof_in_arithmetic():
  let arr := [10, 20, 30, 40, 50]
  let sz := arr.sizeof
  let doubled := sz × 2
  assert_eq_int(doubled, 10, "sizeof×2")
  let plus_one := sz + 1
  assert_eq_int(plus_one, 6, "sizeof+1")

// --- @sizeof on compile-time constant ---

@test
@impure
fn test_at_sizeof_ptrdiff():
  let sz := @sizeof([1, 2, 3])
  assert_eq_int(sz, 3, "@sizeof literal is 3")

// --- @sizeof of a type: the storage it occupies, in bytes ---

// A type asks how much storage it takes; the answer is in bytes, and
// matches what C reports for the same declaration.
@impure
fn test_sizeof_of_scalar_types():
  assert_eq_int(@sizeof(i8), 1 ¤byte, "i8 is 1 byte")
  assert_eq_int(@sizeof(i16), 2 ¤byte, "i16 is 2 bytes")
  assert_eq_int(@sizeof(u32), 4 ¤byte, "u32 is 4 bytes")
  assert_eq_int(@sizeof(i64), 8 ¤byte, "i64 is 8 bytes")
  assert_eq_int(@sizeof(bool), 1 ¤byte, "bool is 1 byte")
  assert_eq_int(@sizeof(byte), 1 ¤byte, "byte is 1 byte")
  assert_eq_int(@sizeof(f32), 4 ¤byte, "f32 is 4 bytes")
  assert_eq_int(@sizeof(f64), 8 ¤byte, "f64 is 8 bytes")

@impure
fn test_sizeof_of_fixed_arrays():
  assert_eq_int(@sizeof(i32[4]), 16 ¤byte, "i32[4] is 16 bytes")
  assert_eq_int(@sizeof(u8[16]), 16 ¤byte, "u8[16] is 16 bytes")
  assert_eq_int(@sizeof(i16[2,3]), 12 ¤byte, "i16[2,3] is 12 bytes")

@repr(C)
struct SizedPoint:
  x : i32
  y : i64

enum SizedShade:
  light
  dark

enum TinyShade : u8:
  a

@impure
fn test_sizeof_of_named_types():
  assert_eq_int(@sizeof(SizedPoint), 16 ¤byte, "struct is 16 bytes")
  assert_eq_int(@sizeof(SizedPoint[2]), 32 ¤byte, "two of them is 32")
  assert_eq_int(@sizeof(SizedShade), 4 ¤byte, "plain enum is C's int")
  assert_eq_int(@sizeof(TinyShade), 1 ¤byte, "u8 enum is 1 byte")

// A type asks for storage and a value asks for elements, which the
// unit tells apart: bytes for the one, a count for the other.
@impure
fn test_sizeof_type_versus_value():
  let fixed : i32[4] = 0
  assert_eq_int(@sizeof(i32[4]), 16 ¤byte, "the type is 16 bytes")
  assert_eq_int(@sizeof(fixed), 4 ¤ptrdiff, "the value is 4 elements")
  assert_eq_int(fixed.sizeof, 4 ¤ptrdiff, ".sizeof agrees")

// A scalar holds no elements to count, so it answers with what its
// type occupies.
@impure
fn test_sizeof_of_a_scalar_binding():
  let a : i8 = 1
  let b : i16 = 1
  let c : u32 = 1
  let d : f64 = 1.0
  let e := true
  assert_eq_int(@sizeof(a), 1 ¤byte, "an i8 binding is 1 byte")
  assert_eq_int(@sizeof(b), 2 ¤byte, "an i16 binding is 2 bytes")
  assert_eq_int(@sizeof(c), 4 ¤byte, "a u32 binding is 4 bytes")
  assert_eq_int(@sizeof(d), 8 ¤byte, "an f64 binding is 8 bytes")
  assert_eq_int(@sizeof(e), 1 ¤byte, "a bool binding is 1 byte")

// An array type written out has a size when every dimension has one.
@impure
fn test_sizeof_of_written_array_types():
  assert_eq_int(@sizeof(i32[4]), 16 ¤byte, "i32[4] is 16 bytes")
  assert_eq_int(@sizeof(u8[16]), 16 ¤byte, "u8[16] is 16 bytes")
  assert_eq_int(@sizeof(i16[2,3]), 12 ¤byte, "i16[2,3] is 12 bytes")
  assert_eq_int(@sizeof(u8[2,3,4]), 24 ¤byte, "three dimensions")

@start
@impure
fn main():
  test_sizeof_array_ptrdiff()
  test_sizeof_string_ptrdiff()
  test_sizeof_byte_array()
  test_add_unit_plus_dimensionless()
  test_add_dimensionless_plus_unit()
  test_sub_unit_minus_dimensionless()
  test_sub_dimensionless_minus_unit()
  test_mul_unit_times_dimensionless()
  test_mul_dimensionless_times_unit()
  test_div_unit_by_dimensionless()
  test_mod_unit_by_dimensionless()
  test_mod_dimensionless_by_unit()
  test_cmp_unit_with_dimensionless()
  test_sizeof_in_arithmetic()
  test_at_sizeof_ptrdiff()
  test_sizeof_of_scalar_types()
  test_sizeof_of_fixed_arrays()
  test_sizeof_of_named_types()
  test_sizeof_type_versus_value()
  test_sizeof_of_a_scalar_binding()
  test_sizeof_of_written_array_types()
  std.println("sizeof_units tests passed")
