// Tests for fold operators: left fold ⌿ and right fold ⍀.

// Left fold: sum without init (first element is accumulator).
@test
fn test_left_fold_sum():
    let result := (λa : i64, b : i64 → i64: a + b) ⌿ [1, 2, 3, 4, 5]
    assert_eq(result, 15)

// Left fold: product without init.
@test
fn test_left_fold_product():
    let result := (λa : i64, b : i64 → i64: a × b) ⌿ [1, 2, 3, 4, 5]
    assert_eq(result, 120)

// Left fold: with explicit init via 2-tuple.
@test
fn test_left_fold_with_init():
    let result := (λa : i64, b : i64 → i64: a + b) ⌿ ([1, 2, 3, 4, 5], 100)
    assert_eq(result, 115)

// Right fold: difference (right-associative) without init.
@test
fn test_right_fold_subtract():
    // ⍀ [1,2,3] = f(1, f(2, 3)) = 1 - (2 - 3) = 1 - (⁻1) = 2
    let result := (λa : i64, b : i64 → i64: a - b) ⍀ [1, 2, 3]
    assert_eq(result, 2)

// Right fold: with init (non-trivial init that differs from no-init).
@test
fn test_right_fold_with_init():
    // f(1, f(2, f(3, 5))) = 1 - (2 - (3 - 5)) = 1 - (2 - (⁻2)) = 1 - 4 = ⁻3
    let result := (λa : i64, b : i64 → i64: a - b) ⍀ ([1, 2, 3], 5)
    assert_eq(result, ⁻3)

// Left fold: string concatenation without init.
@test
fn test_left_fold_concat():
    let result := (λacc : str, s : str → str: acc + s) ⌿ ["a", "b", "c"]
    assert_eq(result, "abc")

// Right fold: string concatenation without init.
@test
fn test_right_fold_concat():
    let result := (λs : str, acc : str → str: s + acc) ⍀ ["a", "b", "c"]
    assert_eq(result, "abc")

// Left fold with init over empty array returns init.
@test
fn test_left_fold_empty_with_init():
    let result : i64 = (λa : i64, b : i64 → i64: a + b) ⌿ ([], 42)
    assert_eq(result, 42)

// Right fold with init over empty array returns init.
@test
fn test_right_fold_empty_with_init():
    let result : i64 = (λa : i64, b : i64 → i64: a + b) ⍀ ([], 42)
    assert_eq(result, 42)

// Left fold over a range without init.
@test
fn test_left_fold_range():
    let result := (λa : i64, b : i64 → i64: a + b) ⌿ 1…6
    assert_eq(result, 15)

// Left fold: bit packing with init (used in sha256).
@test
fn test_left_fold_bit_pack():
    let result := (λacc : i64, h : i64 → i64: (acc « 8) | h) ⌿ ([0xAB, 0xCD, 0xEF], 0)
    assert_eq(result, 0xABCDEF)

// Left fold: bit packing with non-zero init to verify init is used.
@test
fn test_left_fold_bit_pack_init():
    let result := (λacc : i64, h : i64 → i64: (acc « 8) | h) ⌿ ([0xCD, 0xEF], 0xAB)
    assert_eq(result, 0xABCDEF)

// Left fold with a named function, no init.
fn add(x : i64, y : i64) → i64:
    x + y

@test
fn test_left_fold_named_fn():
    let result := add ⌿ [10, 20, 30]
    assert_eq(result, 60)

// Left fold with a named function, with init.
@test
fn test_left_fold_named_fn_init():
    let result := add ⌿ ([10, 20, 30], 100)
    assert_eq(result, 160)

// Left fold: single element array, no init.
@test
fn test_left_fold_single():
    let result : i64 = (λa : i64, b : i64 → i64: a + b) ⌿ [7]
    assert_eq(result, 7)

// Right fold: accumulator from right with non-trivial init.
@test
fn test_right_fold_build():
    // f(3, 10) = 3+20=23, f(2, 23) = 2+46=48, f(1, 48) = 1+96=97
    let result := (λa : i64, b : i64 → i64: a + b × 2) ⍀ ([1, 2, 3], 10)
    assert_eq(result, 97)

// Error: fold without init on empty container.
@test
@expect error 2251 "fold on empty container requires an initial value"
fn test_fold_empty_no_init():
    let result : mut = add ⌿ []
    _ ← result

// Error: fold with non-iterable.
@test
@expect error 2750 "fold requires array or range, got IntValue"
fn test_fold_non_iterable():
    let result : mut = add ⌿ 42
    _ ← result

// ---------------------------------------------------------------------
// An operator may stand where the function goes
// ---------------------------------------------------------------------
//
// An operator names an operation the way a function name does, so it
// needs no lambda repeating it.

@test
fn test_folding_with_an_operator():
    let nums : i64[] = [1, 2, 3, 4]
    assert_eq(+⌿ nums, 10)
    assert_eq(×⌿ nums, 24)
    assert_eq(⌈⌿ nums, 4)
    assert_eq(⌊⌿ nums, 1)

@test
fn test_the_operator_form_says_what_the_lambda_did():
    let nums : i64[] = [1, 2, 3, 4, 5]
    assert_eq(+⌿ nums, (λa : i64, b : i64 → i64: a + b) ⌿ nums)

@test
fn test_folding_an_operator_to_the_right():
    let nums : i64[] = [1, 2, 3]
    assert_eq(-⍀ nums, 2)

@test
fn test_folding_an_operator_with_an_initial_value():
    let nums : i64[] = [1, 2, 3]
    assert_eq(+⌿ (nums, 100), 106)

@test
fn test_folding_an_operator_over_a_range():
    assert_eq(+⌿ 1…6, 15)

@test
fn test_folding_a_logic_operator():
    let flags : i64[] = [12, 10, 8]
    assert_eq(&⌿ flags, 8)
    assert_eq(|⌿ flags, 14)

@start
@impure
fn main():
    std.println("fold tests passed")
