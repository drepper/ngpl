// std.print reads a template first, as C++'s std::print does.  The
// replacement fields are std.format's, so what is written here is what
// std.format would have produced.
@start
@impure
fn main():
    let a : i8 = 42
    let d : i32 ¤meter = 5
    std.println("plain")
    std.println("{} and {}", 1, "two")
    std.println("[{:>6}] [{:*<6}] [{:06}]", a, a, a)
    std.println("{:#x} {:#b} {:+}", 255, 10, 7)
    std.println("{:.3f}", 1.5)
    std.println("{} {:t} {:xt}", a, a, a)
    std.println("{} {:u} {:ut}", d, d, d)
