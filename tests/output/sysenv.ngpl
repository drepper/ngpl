// Exact-value test for std.args and std.env.
//
// The output test runner supplies a fixed command line (sysenv.args)
// and a fixed set of environment variables (sysenv.env), so unlike the
// invariant tests in tests/test_sysenv.ngpl this program can check the
// values themselves.

@start
@impure
fn main():
    std.println("count: {}", std.args.count())
    foreach v := std.args.all():
        std.println("arg: [{}]", v)
    std.println("first: {}", std.args.get(0))
    std.println("set: {}", std.env.get("NGPL_TEST_VAR") ?? "<absent>")
    std.println("has set: {}", std.env.has("NGPL_TEST_VAR"))
    // An empty value is a value: it must not read as absent.
    std.println("empty: [{}]", std.env.get("NGPL_TEST_EMPTY") ?? "<absent>")
    std.println("has empty: {}", std.env.has("NGPL_TEST_EMPTY"))
    std.println("absent: {}", std.env.get("NGPL_TEST_ABSENT") ?? "<absent>")
    std.println("has absent: {}", std.env.has("NGPL_TEST_ABSENT"))
