// How an if that is a value is read.
//
// The value is the branch the condition chooses, and only that branch
// is read -- the other side is not evaluated at all, which is what
// makes an if usable as a guard in front of the thing it guards
// against.  This file is about that reading: which branch runs, what
// is left alone, how a chain is walked, and where an if may stand.
//
// What the branches are and what type they say between them is
// [[test_if_value]]'s subject; this one takes those as given.

// ---------------------------------------------------------------------
// Both branches
// ---------------------------------------------------------------------

fn absolute(x : i64) → i64:
    if x > 0: x else: ⁻x

@test
fn test_the_value_is_the_branch_the_condition_chooses():
    assert_eq(absolute(5), 5)
    assert_eq(absolute(⁻5), 5)
    assert_eq(absolute(0), 0)

@test
fn test_either_branch_may_be_any_expression():
    let a : i64 = 3
    let b : i64 = 4
    assert_eq(if true: a + b else: a × b, 7)
    assert_eq(if false: a + b else: a × b, 12)

// ---------------------------------------------------------------------
// Only the branch taken is read
// ---------------------------------------------------------------------

// The other side is an index no array of two has.  Reading it would
// stop the program, so the test passing is the whole claim.
@test
fn test_the_branch_not_taken_is_not_read():
    let v : i64[] = [7, 8]
    assert_eq(if true: v[0] else: v[9], 7)
    assert_eq(if false: v[9] else: v[1], 8)

// Which is what lets a conditional stand in front of the thing it
// guards against.
@test
fn test_a_conditional_guards_what_follows_it():
    let v : i64[] = [1, 2, 3]
    let n : i64 ¤ptrdiff = 5¤ptrdiff
    assert_eq(if n >= #v: 0 else: v[n], 0)

// ---------------------------------------------------------------------
// How it groups
// ---------------------------------------------------------------------

// A branch is a whole expression and needs nothing to close it: the
// `else:` says where one ends and the next begins, so the arithmetic
// on either side is gathered up before the choice is made.
@test
fn test_a_branch_is_a_whole_expression():
    assert_eq(if false: 1 + 2 else: 3, 3)
    assert_eq(if true: 1 + 2 else: 3, 3)
    assert_eq(if true: 2 × 3 else: 0, 6)

// A chain groups to the right, so the second condition is asked only
// where the first does not hold.
@test
fn test_a_chain_groups_to_the_right():
    let n : i64 = 2
    assert_eq(if n = 1: "one" else: if n = 2: "two" else: "many", "two")
    assert_eq(if n = 1: "one" else: (if n = 2: "two" else: "many"), "two")

@test
fn test_a_chain_reaches_its_last_branch():
    let n : i64 = 7
    assert_eq(if n = 1: "one" else: if n = 2: "two" else: "many", "many")

// An if is not an operand, so standing inside an operator it stands
// in brackets, which is where the operator's operand is looked for.
@test
fn test_brackets_put_one_inside_an_operator():
    assert_eq(1 + (if true: 2 else: 30), 3)
    assert_eq(1 + (if false: 2 else: 30), 31)

// ---------------------------------------------------------------------
// Everywhere a value is wanted
// ---------------------------------------------------------------------

fn twice(n : i64) → i64:
    n × 2

@test
fn test_as_an_argument():
    assert_eq(twice(if true: 4 else: 5), 8)

@test
fn test_in_an_array():
    let v : i64[] = [if true: 1 else: 9, if false: 2 else: 9]
    assert_eq(v[0], 1)
    assert_eq(v[1], 9)

@test
fn test_as_a_binding_with_a_type_stated():
    let n : i64 = if true: 4 else: 5
    assert_eq(n, 4)

@test
fn test_as_what_an_assignment_stores():
    let n : mut i64 = 0
    n ← if true: 4 else: 5
    assert_eq(n, 4)

fn signum(x : i64) → i64:
    return if x = 0: 0 else: (if x > 0: 1 else: ⁻1)

@test
fn test_as_what_a_return_hands_back():
    assert_eq(signum(9), 1)
    assert_eq(signum(⁻9), ⁻1)
    assert_eq(signum(0), 0)

@test
fn test_as_what_a_loop_walks():
    let a : i64[] = [1, 2]
    let b : i64[] = [10, 20, 30]
    let total : mut i64 = 0
    foreach x := if false: a else: b:
        total ← total + x
    assert_eq(total, 60)

// ---------------------------------------------------------------------
// What the condition may be
// ---------------------------------------------------------------------

// The same truth an if statement asks of its condition: a number is
// true where it is not zero, and an optional where it holds something.
@test
fn test_a_number_as_the_condition():
    let n : i64 = 3
    assert_eq(if n: "some" else: "none", "some")
    let z : i64 = 0
    assert_eq(if z: "some" else: "none", "none")

@test
fn test_an_optional_as_the_condition():
    let v : i64[] = [4, 5]
    assert_eq(if v ⍳ 5: "found" else: "missing", "found")
    assert_eq(if v ⍳ 6: "found" else: "missing", "missing")

// A conditional is one value, so its two sides have to say one type
// between them.  Two that cannot be the same value are refused at the
// definition, which tests/output/conditional_branches_disagree checks.
// What agrees:
@test
fn test_the_branches_agree():
    let n : i64 = 1
    let m : i64 = 2
    let chosen := if true: n else: m
    assert_eq(chosen, 1)
    assert_eq(@typeof(chosen), i64)

// A number with no width stated settles on what it is asked for, so it
// agrees with any other number.
@test
fn test_a_number_with_no_width_settles():
    let d : f64 = if false: 1 else: 2.5
    assert_eq(d, 2.5)
    let i : i64 = if true: 1 else: 2
    assert_eq(i, 1)

// Nothing agrees with an absent value but an absent value, since an
// optional is what holds both.
@test
fn test_an_absent_value_agrees_with_what_holds_it():
    let found : i64? = if true: 7 else: ∅
    assert_eq(found ?? 0, 7)

// A sum type says two types belong together, which is the whole of
// what one is for, so a conditional over its alternatives is one
// value.
type Width = i32 | i64

@test
fn test_a_sum_type_says_the_two_belong_together():
    let a : i32 = 1
    let b : i64 = 2
    let w : Width = if true: a else: b
    assert_eq(@typeof(w), i32)

// ---------------------------------------------------------------------
// An if statement is still an if statement
// ---------------------------------------------------------------------

// An expression that ends a line is finished, so the if on the line
// below it opens a statement rather than going on with the expression.
@test
fn test_an_if_statement_after_an_expression_statement():
    let seen : mut i64 = 0
    _ ← twice(1)
    if true:
        seen ← 1
    assert_eq(seen, 1)

@test
fn test_an_if_statement_after_a_blank_line():
    let seen : mut i64 = 0
    _ ← twice(1)

    if true:
        seen ← 2
    assert_eq(seen, 2)

// The same where the expression is the last thing in a block.
@test
fn test_an_if_statement_after_a_nested_block():
    let seen : mut i64 = 0
    if true:
        _ ← twice(1)
    if true:
        seen ← 3
    assert_eq(seen, 3)

// And an if statement whose condition is itself an if, which is
// unusual to write and reads plainly enough in brackets -- where an
// if standing as an operand stands anyway.
@test
fn test_a_statement_condition_that_is_an_if():
    let seen : mut i64 = 0
    if (if false: true else: false):
        seen ← 1
    else:
        seen ← 2
    assert_eq(seen, 2)

@start
@impure
fn main():
    std.println("conditional expression tests passed")
