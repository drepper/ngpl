// Floating-point type tests: f16, f32, f64, bfloat16, float
// Tests literals, arithmetic, comparisons, type coercion, and formatting.

@test
fn test_float_literals():
  // Untyped float literal (inferred as "float")
  static_assert(3.14 > 3.0)
  static_assert(3.14 < 4.0)

  // Typed float literals with suffix
  static_assert(1.0f32 = 1.0f32)

  // Exponent notation
  static_assert(1e3 = 1000.0)
  static_assert(1.5e2 = 150.0)

  // Negative exponent
  static_assert(2.5e-1 = 0.25)

  // Integer with float suffix becomes float
  static_assert(42f32 = 42.0f32)

@test
@impure
fn test_float_arithmetic():
  // Addition
  static_assert(3.0 + 2.0 = 5.0)

  // Subtraction
  static_assert(3.0 - 2.0 = 1.0)

  // Multiplication
  static_assert(3.0 × 2.0 = 6.0)

  // Division
  let quot : f64 = 3.0 ÷ 2.0
  assert(quot = 1.5, "3.0 / 2.0 should be 1.5")

  // Modulus
  let rem : f64 = 7.0 % 3.0
  assert(rem = 1.0, "7.0 % 3.0 should be 1.0")

  // Negation
  static_assert(⁻3.0 = ⁻3.0)
  static_assert(⁻3.0 + 3.0 = 0.0)

@test
fn test_mixed_int_float_rejected():
  @expect error 2234 "addition requires matching types, got untyped and float"
  let a : mut = 2 + 3.0

  @expect error 2235 "addition requires matching types, got float and untyped"
  let b : mut f64 = 3.0 + 2

  @expect error 2234 "multiplication requires matching types, got untyped and float"
  let c : mut = 3 × 2.5

  @expect error 2235 "division requires matching types, got float and untyped"
  let d : mut f64 = 10.0 ÷ 4

@test
fn test_float_comparisons():
  static_assert(1.0 < 2.0)
  static_assert(2.0 > 1.0)
  static_assert(1.0 <= 1.0)
  static_assert(1.0 >= 1.0)
  static_assert(1.0 <= 2.0)
  static_assert(2.0 >= 1.0)
  static_assert(1.0 ≠ 2.0)
  static_assert(1.0 = 1.0)

  // Mixed int-float comparison
  static_assert(1.0 = 1)
  static_assert(2 > 1.5)
  static_assert(1.5 < 2)

@test
fn test_typed_float_widths():
  // All should be equal in value
  static_assert(1.5f16 = 1.5f32)
  static_assert(1.5f32 = 1.5f64)

  // Verify type names
  static_assert_eq(@typeof(1.0f16), @typeof(0.0f16))
  static_assert_eq(@typeof(1.0f32), @typeof(0.0f32))
  static_assert_eq(@typeof(1.0f64), @typeof(0.0f64))
  static_assert_eq(@typeof(1.0), @typeof(0.0))

fn add_floats(x:f64, y:f64) -> f64:
  x + y

fn as_f32(x:f32) -> f32:
  x

@test
@impure
fn test_float_coercion_in_functions():
  // Test int-to-float parameter coercion
  let r := add_floats(3, 4)
  assert(r = 7.0, "add_floats(3, 4) should be 7.0")

  // Test float-to-float coercion (narrowing)
  let s := as_f32(3.14)
  // f32 precision: 3.14 becomes approximately 3.140000104904175
  assert(s > 3.13, "as_f32(3.14) should be > 3.13")
  assert(s < 3.15, "as_f32(3.14) should be < 3.15")

@test
@impure
fn test_float_in_conditionals():
  let x : f64 = 0.0
  if x:
    assert(false, "0.0 should be falsy")
  let y : f64 = 1.5
  if y = 0.0:
    assert(false, "1.5 should be truthy")

@test
@impure
fn test_float_format():
  let alloc := std.heap.allocator()
  let s := std.format(alloc, "value: {}", 3.14)
  assert(s = "value: 3.14", "format float failed")

  // Fixed-point format specifier
  let s2 := std.format(alloc, "{:.2f}", 3.14)
  assert(s2 = "3.14", "format .2f failed")

  // Scientific notation
  let s3 := std.format(alloc, "{:.2e}", 1500.0)
  assert(s3 = "1.50e+03", "format .2e failed")

@test
@impure
fn test_hex_float_literal():
  // Hex float: 0x1.8p1 = 1.5 * 2^1 = 3.0
  let a : f64 = 0x1.8p1
  assert(a = 3.0, "0x1.8p1 should be 3.0")

  // 0x1p0 = 1.0
  let b : f64 = 0x1p0
  assert(b = 1.0, "0x1p0 should be 1.0")

  // 0x1p-1 = 0.5
  let c : f64 = 0x1p-1
  assert(c = 0.5, "0x1p-1 should be 0.5")

fn reject_float(x:i32) -> i32:
  x

@test
fn test_float_type_rejection():
  // Float should not be accepted where int is expected
  @expect error "expected i32"
  reject_float(3.14)

// --- an integer initializer has to survive the conversion ---

// An integer is exact in a float when its odd part fits the
// significand, so a power of two at the boundary is fine and the
// odd number just past it is not.
@test
@impure
fn test_integer_initializer_within_the_significand():
  let a : f32 = 16777216          // 2^24, exact
  let b : f32 = 17000002          // even, its odd part fits
  let c : f16 = 2048              // 2^11
  let d : bfloat16 = 256            // 2^8
  let e : f64 = 9007199254740992  // 2^53
  assert(a = 16777216.0, "2^24 is exact in f32")
  assert(b = 17000002.0, "an even number just past it is exact")
  assert(c = 2048.0, "2^11 is exact in f16")
  assert(d = 256.0, "2^8 is exact in bfloat16")
  assert(e = 9007199254740992.0, "2^53 is exact in f64")

@start
@impure
fn main():
  std.println("float tests passed")
