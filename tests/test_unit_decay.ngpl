// A measure may stand in for another: `unit tok → ptrdiff` says a
// token index goes wherever a ptrdiff is wanted.
//
// This is what lets a program give each of its tables an index of its
// own without those indices becoming useless.  A subscript is measured
// ¤ptrdiff and nothing else, so before this a table index had to be a
// ptrdiff -- which made every table's index the same thing as every
// other's, and a token index interchangeable with a node id.  A measure
// that stands in for ptrdiff subscripts, counts and compares, while
// remaining something its siblings are not.
//
// The relation is one-way and it is not shared: what stands in for a
// thing is not the thing, and two measures that stand in for the same
// thing do not stand in for each other.

unit tok -> ptrdiff
unit node → ptrdiff          // → and -> say the same
unit height

// Standing in for something is followed as far as it goes, and the
// measure named may be declared further down -- as a struct may be
// named before it is declared.  A line number stands in for a source
// position, which stands in for a ptrdiff, so a line number subscripts.
unit lineno -> srcpos
unit srcpos -> ptrdiff

// ---------------------------------------------------------------------
// What standing in for ptrdiff buys
// ---------------------------------------------------------------------

@test
fn test_it_subscripts():
    let xs : i64[] = [10, 20, 30]
    let t : i64 ¤"tok" = 1
    assert_eq(xs[t], 20)

@test
fn test_it_compares_with_a_count():
    let xs : i64[] = [10, 20, 30]
    let t : i64 ¤"tok" = 1
    assert(t < #xs)
    assert(not (t >= #xs))

@test
fn test_it_walks_an_array():
    let xs : i64[] = [10, 20, 30]
    let i : mut i64 ¤"tok" = 0
    let sum : mut i64 = 0
    while i < #xs:
        sum ← sum + xs[i]
        i ← i + 1
    assert_eq(sum, 60)

// Arithmetic on it keeps the measure: a token index plus one is still
// a token index, which is the whole reason for having it.
@test
fn test_arithmetic_keeps_the_measure():
    let t : i64 ¤"tok" = 1
    let u : i64 ¤"tok" = t + 1
    assert_eq(@dropunit(u), 2)

fn wants_ptrdiff(p : i64 ¤ptrdiff) → i64:
    @dropunit(p)

@test
fn test_it_passes_where_a_ptrdiff_is_wanted():
    let t : i64 ¤"tok" = 7
    assert_eq(wants_ptrdiff(t), 7)

fn wants_tok(t : i64 ¤"tok") → i64:
    @dropunit(t)

@test
fn test_its_own_measure_passes():
    let t : i64 ¤"tok" = 7
    assert_eq(wants_tok(t), 7)

// ---------------------------------------------------------------------
// What it does not buy
// ---------------------------------------------------------------------

// Two measures standing in for the same thing are still two measures.
@expect error 2327 "incompatible units: tok and node"
fn error_a_sibling_is_not_it():
    let t : i64 ¤"tok" = 1
    let n : i64 ¤"node" = t
    _ ← n

@expect error 2327 "incompatible units: node and tok"
fn error_a_sibling_does_not_pass():
    let n : i64 ¤"node" = 1
    _ ← wants_tok(n)

@expect error 2313 "incompatible units for +: tok and node"
fn error_siblings_do_not_add():
    let t : i64 ¤"tok" = 1
    let n : i64 ¤"node" = 2
    _ ← t + n

// The way back is not open: what stands in for a thing is not the
// thing, so a plain ptrdiff is not a token index.
@expect error 2327 "incompatible units: ptrdiff and tok"
fn error_the_way_back_is_shut():
    let p : i64 ¤ptrdiff = 1
    let t : i64 ¤"tok" = p
    _ ← t

// A measure that stands in for nothing stands in for nothing.
@expect error 2318 "array index requires unit ptrdiff, got height"
fn error_a_measure_that_stands_in_for_nothing():
    let xs : i64[] = [10, 20, 30]
    let h : i64 ¤"height" = 1
    _ ← xs[h]

// ---------------------------------------------------------------------
// Standing in for something, as far as it goes
// ---------------------------------------------------------------------

@test
fn test_a_chain_reaches_the_end():
    let xs : i64[] = [10, 20, 30]
    let l : i64 ¤"lineno" = 2
    assert_eq(xs[l], 30)

fn wants_srcpos(p : i64 ¤"srcpos") → i64:
    @dropunit(p)

@test
fn test_a_chain_reaches_the_middle():
    let l : i64 ¤"lineno" = 4
    assert_eq(wants_srcpos(l), 4)

fn wants_lineno(l : i64 ¤"lineno") → i64:
    @dropunit(l)

// Still one-way, however long the chain: what a line number stands in
// for does not stand in for a line number.
@expect error 2327 "incompatible units: srcpos and lineno"
fn error_a_chain_is_still_one_way():
    let p : i64 ¤"srcpos" = 1
    _ ← wants_lineno(p)

// A circle is no order at all, and is refused where it is written,
// which is before anything runs; tests/output/unit_decay_circle,
// unit_decay_self and unit_decay_unknown hold those refusals, since a
// file carrying one has nothing this suite could run.

@start
@impure
fn main():
    std.println("unit decay tests passed")
