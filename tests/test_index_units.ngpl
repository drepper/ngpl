// Tests for array index unit requirements.
//
// Untyped integer constants (literals) are accepted without unit annotation.
// Typed integers (i32, u32, u32fast, etc.) require the correct unit:
//   - byte (B)      for u8[] / byte[] arrays
//   - ptrdiff        for all other arrays
// Wrong units are always rejected.

// ---- untyped integer constants need no annotation ------------------------

@test
fn test_read_bare_literal():
    let arr : i64[] = [10, 20, 30]
    assert_eq(arr[0], 10)
    assert_eq(arr[2], 30)

@test
fn test_write_bare_literal():
    let arr : mut i64[] = [0, 0, 0]
    arr[1] ← 42
    assert_eq(arr[1], 42)

@test
fn test_byte_read_bare_literal():
    let buf : mut u8[3] = 0
    buf[0] ← 10; buf[1] ← 20; buf[2] ← 30
    assert_eq(buf[0], 10)
    assert_eq(buf[2], 30)

@test
fn test_byte_write_bare_literal():
    let buf : mut u8[4] = 0
    buf[1] ← 255
    assert_eq(buf[1], 255)

@test
fn test_slice_bare_literal():
    let arr : i64[] = [10, 20, 30, 40, 50]
    let sub := arr[1…3]
    assert_eq(#sub, 3)
    assert_eq(sub[0], 20)
    assert_eq(sub[2], 40)

@test
fn test_slice_assign_bare_literal():
    let arr : mut i64[] = [0, 0, 0, 0]
    arr[1…2] ← [88, 99]
    assert_eq(arr[1], 88)
    assert_eq(arr[2], 99)

// ---- sizeof-derived indices carry correct unit automatically -------------

@test
fn test_sizeof_derived_index():
    let arr : i64[] = [5, 10, 15, 20]
    let last : i64 = arr[#arr - 1]
    assert_eq(last, 20)

@test
fn test_foreach_sizeof_index():
    let arr : i64[] = [1, 2, 3, 4]
    let total : mut i64 = 0
    foreach i := 0…#arr - 1:
        total ← total + arr[i]
    assert_eq(total, 10)

@test
fn test_byte_sizeof_index():
    let buf : mut u8[5] = 0
    buf[0] ← 1; buf[1] ← 2; buf[2] ← 3
    buf[3] ← 4; buf[4] ← 5
    let last := buf[#buf - 1]
    assert_eq(last, 5)

// ---- typed integers without unit rejected (indexing) ---------------------

@test
@expect error "requires unit ptrdiff"
fn test_reject_i32_index_read():
    let arr : mut i64[] = [1, 2, 3]
    let idx : mut i32 = 0
    let x : mut = arr[idx]

@test
@expect error "requires unit ptrdiff"
fn test_reject_i32_index_write():
    let arr : mut i64[] = [1, 2, 3]
    let idx : mut i32 = 0
    arr[idx] ← 99

@test
@expect error "requires unit ptrdiff"
fn test_reject_u32_index():
    let arr : mut i64[] = [1, 2, 3]
    let idx : mut u32 = 0
    let x : mut = arr[idx]

@test
@expect error "requires unit ptrdiff"
fn test_reject_u32fast_index():
    let arr : mut i64[] = [1, 2, 3]
    let idx : mut u32fast = 0
    let x : mut = arr[idx]

@test
@expect error "requires unit B"
fn test_reject_i32_byte_index_read():
    let buf : mut u8[3] = 0
    let idx : mut i32 = 0
    let x : mut = buf[idx]

@test
@expect error "requires unit B"
fn test_reject_i32_byte_index_write():
    let buf : mut u8[3] = 0
    let idx : mut i32 = 0
    buf[idx] ← 99

@test
@expect error "requires unit ptrdiff"
fn test_reject_foreach_typed_index():
    let arr : mut i64[] = [10, 20, 30]
    foreach i : i32 = 0…2:
        let x : mut = arr[i]

// ---- typed integers without unit rejected (parameter passing) ------------

fn needs_ptrdiff(arr : i32[], idx ¤ptrdiff : i32) → i32:
    arr[idx]

fn needs_byte(buf : byte[], off ¤byte : usize) → u8:
    buf[off]

@test
@expect error "requires unit ptrdiff"
fn test_reject_typed_int_param_ptrdiff():
    let arr : mut i64[] = [1, 2, 3]
    let idx : mut i32 = 0
    needs_ptrdiff(arr, idx)

@test
@expect error "requires unit B"
fn test_reject_typed_int_param_byte():
    let buf : mut u8[3] = 0
    buf[0] ← 10
    let off : mut usize = 0
    needs_byte(buf, off)

@test
@expect error "requires unit ptrdiff"
fn test_reject_u32_param():
    let arr : mut i64[] = [1, 2, 3]
    let idx : mut u32 = 1
    needs_ptrdiff(arr, idx)

@test
fn test_accept_untyped_const_param_ptrdiff():
    let arr : i64[] = [10, 20, 30]
    assert_eq(needs_ptrdiff(arr, 1), 20)

@test
fn test_accept_untyped_const_param_byte():
    let buf : mut u8[3] = 0
    buf[0] ← 10; buf[1] ← 20; buf[2] ← 30
    assert_eq(needs_byte(buf, 2), 30)

@test
fn test_accept_unit_value_param():
    let arr : i64[] = [10, 20, 30]
    let idx ¤ptrdiff : i32 = 1
    assert_eq(needs_ptrdiff(arr, idx), 20)

// ---- typed integers with correct unit accepted ---------------------------

@test
fn test_typed_with_ptrdiff():
    let arr : i64[] = [10, 20, 30]
    let idx ¤ptrdiff : i32 = 1
    assert_eq(arr[idx], 20)

@test
fn test_typed_with_byte():
    let buf : mut u8[3] = 0
    buf[0] ← 10; buf[1] ← 20; buf[2] ← 30
    let idx ¤byte : i32 = 2
    assert_eq(buf[idx], 30)

// ---- wrong unit rejected ------------------------------------------------

@test
@expect error "requires unit ptrdiff"
fn test_reject_byte_for_general():
    let arr : mut i64[] = [1, 2, 3]
    let x : mut = arr[0 ¤byte]

@test
@expect error "requires unit B"
fn test_reject_ptrdiff_for_byte():
    let buf : mut u8[3] = 0
    let x : mut = buf[0 ¤ptrdiff]

@test
@expect error "requires unit ptrdiff"
fn test_reject_meter_for_general():
    let arr : mut i64[] = [1, 2, 3]
    let x : mut = arr[0 ¤meter]

// ---- arithmetic unit enforcement ----------------------------------------

// addition: typed int + unit → error
@test
@expect error "cannot .+ typed integer"
fn test_arith_typed_plus_unit():
    let a : mut i32 = 5
    let b ¤ptrdiff : mut i32 = 3
    let x : mut = a + b

// addition: unit + typed int → error
@test
@expect error "cannot .+ unit .+ with typed integer"
fn test_arith_unit_plus_typed():
    let a ¤ptrdiff : mut i32 = 3
    let b : mut i32 = 5
    let x : mut = a + b

// subtraction: unit - typed int → error
@test
@expect error "cannot - unit .+ with typed integer"
fn test_arith_unit_minus_typed():
    let a ¤ptrdiff : mut i32 = 3
    let b : mut i32 = 1
    let x : mut = a - b

// addition: unit + untyped let → ok
@test
fn test_arith_unit_plus_const():
    let a ¤ptrdiff : i32 = 3
    let x := a + 2
    assert_eq(x, 5 ¤ptrdiff)

// subtraction: unit - untyped let → ok
@test
fn test_arith_unit_minus_const():
    let a ¤ptrdiff : i32 = 5
    let x := a - 1
    assert_eq(x, 4 ¤ptrdiff)

// multiplication: unit × typed int → ok (scalar)
@test
fn test_arith_unit_times_typed():
    let a ¤byte : i32 = 3
    let b : i32 = 4
    let x := a × b
    assert_eq(x, 12 ¤byte)

// multiplication: typed int × unit → ok (scalar)
@test
fn test_arith_typed_times_unit():
    let a : i32 = 4
    let b ¤byte : i32 = 3
    let x := a × b
    assert_eq(x, 12 ¤byte)

// comparison: unit = typed int → error
@test
@expect error "cannot compare unit .+ with typed integer"
fn test_cmp_unit_eq_typed():
    let a ¤ptrdiff : mut i32 = 3
    let b : mut i32 = 3
    let x : mut = a = b

// comparison: typed int < unit → error
@test
@expect error "cannot compare typed integer .+ without unit with unit"
fn test_cmp_typed_lt_unit():
    let a : mut i32 = 1
    let b ¤ptrdiff : mut i32 = 3
    let x : mut = a < b

// comparison: unit = untyped let → ok
@test
fn test_cmp_unit_eq_const():
    let a ¤ptrdiff : i32 = 3
    assert_eq(a = 3, true)

// comparison: unit < untyped let → ok
@test
fn test_cmp_unit_lt_const():
    let a ¤ptrdiff : i32 = 1
    assert_eq(a < 5, true)

// ---- tuple indexing unchanged (no unit needed) --------------------------

@test
fn test_tuple_bare_int():
    let t := (10i64, 20i64, 30i64)
    assert_eq(t[0], 10)
    assert_eq(t[2], 30)

@start
@impure
fn main():
    std.println("index unit tests passed")
