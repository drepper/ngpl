// Tests for what an array holds: one type, one unit, both fixed where
// the array is declared.
//
// A unit measures a number, and a container is not one.  What a
// declaration of an array measures is each of the things in it, however
// deep they sit -- the same reach the element type has.

// ---------------------------------------------------------------------
// The two spellings
// ---------------------------------------------------------------------

// The unit may be written against the name or against the element
// type.  They say the same thing, so they are the same declaration.
@test
fn test_the_unit_may_be_written_by_the_name():
    let d : i64 ¤meter[] = [1, 2]
    assert_eq(d[0], 1¤meter)
    assert_eq(@unitof(d[0]), ¤meter)

@test
fn test_or_against_the_element_type():
    let d : i64 ¤meter[] = [1, 2]
    assert_eq(d[0], 1¤meter)
    assert_eq(@unitof(d[0]), ¤meter)

@test
fn test_a_scalar_reads_the_same_way():
    let s : i64 ¤meter = 5
    assert_eq(s, 5¤meter)

// A measure belongs to the type and is written there.  Against the
// name it says the same thing in the place the language no longer
// keeps for it, and is refused rather than quietly taken.
@test
@expect error 2022 "Line 37, col 10: a measure is written against the type, as 'let x : i64 ¤meter = …' -- or against nothing, as 'let x : ¤meter = …', where the right side says the type"
fn error_the_measure_written_against_the_name():
    let d ¤meter : i64[] = [1, 2]

// ---------------------------------------------------------------------
// The unit reaches the elements
// ---------------------------------------------------------------------

// A unit around the container is a value nothing can read an element
// out of, so it goes to the elements instead.
@test
fn test_a_measured_array_can_be_indexed():
    let d : i64 ¤meter[] = [10, 20, 30]
    assert_eq(d[2], 30¤meter)
    assert_eq(#d, 3¤ptrdiff)

@test
fn test_a_measured_matrix_measures_its_numbers():
    let m : i64 ¤meter[2, 2] = [[1, 2], [3, 4]]
    assert_eq(m[1, 1], 4¤meter)
    assert_eq(@unitof(m[0, 0]), ¤meter)

@test
fn test_an_allocated_array_is_measured_too():
    let f : i64 ¤meter[3] = 3 ⍴ 0
    assert_eq(f[0], 0¤meter)
    assert_eq(#f, 3¤ptrdiff)

@test
fn test_measured_elements_do_arithmetic_as_numbers_do():
    let d : i64 ¤meter[] = [7, 8]
    assert_eq(d[0] + d[1], 15¤meter)

// ---------------------------------------------------------------------
// A parameter and a return
// ---------------------------------------------------------------------

fn first_of(v : i64 ¤meter[]) → i64 ¤meter:
    v[0]

fn two_lengths() → i64 ¤meter[]:
    let r : i64 ¤meter[] = [1, 2]
    r

@test
fn test_a_measured_array_parameter():
    let d : i64 ¤meter[] = [7, 8, 9]
    assert_eq(first_of(d), 7¤meter)

@test
fn test_a_measured_array_return():
    let r := two_lengths()
    assert_eq(r[1], 2¤meter)
    assert_eq(@unitof(r[0]), ¤meter)

// ---------------------------------------------------------------------
// What a definition says, a name holds to
// ---------------------------------------------------------------------

// A definition may measure a bare number: the definition is what says
// what the number counts.
@test
fn test_a_definition_measures_bare_numbers():
    let d : i64 ¤meter[] = [1, 2]
    assert_eq(d[0], 1¤meter)

// An assignment says nothing, so what it stores has to arrive measured
// or the measure would be invented for it.
@test
@expect error 2322 "cannot assign dimensionless value to 'd' which has unit m"
fn error_assigning_bare_numbers_to_a_measured_array():
    let d : mut i64 ¤meter[] = [1, 2]
    d ← [5, 6]

@test
fn test_assigning_a_measured_array():
    let d : mut i64 ¤meter[] = [1, 2]
    let e : i64 ¤meter[] = [5, 6]
    d ← e
    assert_eq(d[0], 5¤meter)

@test
@expect error 2327 "incompatible units: s and m"
fn error_assigning_the_wrong_measure():
    let d : mut i64 ¤meter[] = [1, 2]
    let e : i64 ¤second[] = [5, 6]
    d ← e

// What the definition said outlives the value: a name that has been
// assigned once still holds to its declaration.
@test
@expect error 2746 "'a' holds i64 and cannot take a string"
fn error_the_declaration_outlives_the_first_assignment():
    let a : mut i64 = 1
    a ← 2
    a ← "x"

@test
@expect error 2772 "'i32' cannot hold a string"
fn error_an_array_holds_to_its_element_type():
    let a : mut i32[] = [1, 2]
    let s : str[] = ["x", "y"]
    a ← s

@test
@expect error 2321 "'x' carries no unit, but the value is m; use @dropunit to part with it"
fn error_an_unmeasured_name_stays_unmeasured():
    let x : mut i64 = 5
    x ← 3¤meter

// ---------------------------------------------------------------------
// Every way in asks the same question
// ---------------------------------------------------------------------

@test
@expect error 2760 "an array of i32 cannot hold a string"
fn error_pushing_the_wrong_kind():
    let a : mut i32[] = [1, 2, 3]
    a.push("smuggled")

@test
@expect error 2760 "an array of i32 cannot hold a boolean"
fn error_inserting_the_wrong_kind():
    let a : mut i32[] = [1, 2, 3]
    a.insert(0, true)

@test
@expect error 2324 "an array of i64 cannot hold m; use @dropunit to part with it"
fn error_a_measured_value_in_an_unmeasured_array():
    let a : mut i64[] = [1, 2]
    let m : i64 ¤meter = 7
    a[0] ← m

@test
@expect error 2325 "an array measured in m cannot hold a number that measures nothing"
fn error_an_unmeasured_value_in_a_measured_array():
    let d : mut i64 ¤meter[] = [1, 2]
    d.push(9)

@test
fn test_pushing_a_measured_value():
    let d : mut i64 ¤meter[] = [1, 2]
    let x : i64 ¤meter = 9
    d.push(x)
    assert_eq(d[2], 9¤meter)

// A width still converts, as it does at a definition, and a value that
// does not fit is reported the way arithmetic reports it.
@test
fn test_a_width_still_converts():
    let a : mut i32[] = [1, 2]
    let x : i64 = 7
    a.push(x)
    assert_eq(a[2], 7)

@test
@expect error 2279 "integer overflow: 5000000000 does not fit in i32 (range -2147483648..2147483647)"
fn error_a_value_the_element_type_cannot_hold():
    let a : mut i32[] = [1, 2]
    let x : i64 = 5000000000
    a.push(x)

// A row is one of the things a matrix holds, so it is measured the way
// any element is -- kind and length together.
@test
@expect error 2772 "'i32' cannot hold a string"
fn error_a_row_of_the_wrong_kind():
    let m : mut i32[2, 2] = [[1, 2], [3, 4]]
    let r : str[] = ["a", "b"]
    m[0] ← r

@test
@expect error 2774 "array size mismatch: type 'i32[2]' declares 2 elements, got 3"
fn error_a_row_of_the_wrong_length():
    let m : mut i32[2, 2] = [[1, 2], [3, 4]]
    let r : i32[] = [9, 9, 9]
    m[0] ← r

@test
fn test_a_row_that_fits():
    let m : mut i32[2, 2] = [[1, 2], [3, 4]]
    let r : i32[] = [9, 9]
    m[0] ← r
    assert_eq(m[0, 1], 9)

// ---------------------------------------------------------------------
// A literal holds one type of value
// ---------------------------------------------------------------------

// An array holds one type of value, so the elements have to agree
// before there is anything for the array to be an array of.  Two that
// disagree are refused here rather than left for a type to sort out:
// without a type nothing would ever sort them out.
@test
@expect error 2743 "an array holds one type of value, but element 0 is i64 and element 1 is a string"
fn error_a_literal_of_two_kinds():
    let a : mut = [1i64, "two"]

@test
@expect error 2744 "an array holds one type of value, but element 0 is i64 and element 1 is i32"
fn error_a_literal_of_two_widths():
    let a : mut = [1i64, 2i32]

@test
@expect error 2743 "an array holds one type of value, but element 0 is i64 and element 1 is a boolean"
fn error_a_number_and_a_boolean():
    let a : mut = [1i64, true]

// A width still settles from whichever element states one, and the
// ones that state none take it.
@test
fn test_one_element_still_says_it():
    let a := [1, 2, 3i64]
    static_assert_eq(@typeof(a[0]), i64)

// A unit settles the same way, wherever it is written.
@test
fn test_a_unit_settles_like_a_width():
    let m : i64 ¤meter = 1
    let a := [m, 2]
    let b := [2, m]
    assert_eq(a[1], 2¤meter)
    assert_eq(b[0], 2¤meter)

@test
@expect error 2320 "an array holds one unit, but element 0 is m and element 1 is s"
fn error_a_literal_of_two_units():
    let m : i64 ¤meter = 1
    let s : i64 ¤second = 2
    let a : mut = [m, s]

// ---------------------------------------------------------------------
// The four places a value meets a type
// ---------------------------------------------------------------------

fn takes_numbers(a : i32[]) → i32:
    a[0]

fn lends(a : &mut i32[]):
    a[0] ← 9

fn hands_back_numbers() → i32[]:
    let s : str[] = ["a"]
    s

@test
@expect error 2770 "takes_numbers: argument 'a': 'i32' cannot hold a string"
fn error_an_argument_of_the_wrong_element_type():
    let s : str[] = ["a", "b"]
    let n : mut = takes_numbers(s)

// A lent array is written into where the caller holds it, so its type
// has to be the caller's already.
@test
@expect error 2754 "lends: argument 'a': 'i32' cannot hold a string"
fn error_lending_an_array_of_the_wrong_element_type():
    let s : mut str[] = ["a", "b"]
    lends(&s)

@test
@expect error 2756 "hands_back_numbers: return type is i32[], but 'i32' cannot hold a string"
fn error_a_return_of_the_wrong_element_type():
    let r : mut = hands_back_numbers()

// Two arrays join into one, which holds one type of value.
@test
@expect error 2727 "⧺: an array holds one type of value, so two joined hold the same one, but the left operand holds i32 and the right holds str"
fn error_joining_arrays_of_two_types():
    let a : i32[] = [1, 2]
    let b : str[] = ["q"]
    let c : mut = a ⧺ b

@test
@expect error 2310 "⧺: an array holds one unit, so two joined hold the same one, but the left operand is m and the right is unmeasured"
fn error_joining_a_measured_array_to_a_bare_one():
    let d : i64 ¤meter[] = [1, 2]
    let e : i64[] = [3]
    let c : mut = d ⧺ e

@test
fn test_joining_arrays_that_agree():
    let a : i32[] = [1, 2]
    let b : i32[] = [3]
    let c := a ⧺ b
    assert_eq(c[2], 3)
    assert_eq(#c, 3¤ptrdiff)

// ---------------------------------------------------------------------
// Where a unit cannot be said yet
// ---------------------------------------------------------------------

// A unit belongs to a binding or to what an array holds.  Inside a
// compound type it would have to belong to the type itself, which is
// the question a sum or product type raises.
@test
@expect error 2021 "Line 332, col 17: a unit belongs to a binding or to what an array holds; a type alias or a tuple element cannot state one yet"
fn error_a_unit_in_a_tuple_element():
    let t : (i64 ¤meter, str) = (1, "a")

@start
@impure
fn main():
    std.println("array unit tests passed")
