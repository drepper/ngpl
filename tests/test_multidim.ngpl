// test_multidim.ngpl -- tests for multi-dimensional subscript syntax arr[i, j]

// ---- 2D read access -----------------------------------------------------

@test
fn test_2d_read() → ∅:
    let m := (3, 4) ⍴ (1…12)
    assert_eq(m[0, 0], 1)
    assert_eq(m[0, 3], 4)
    assert_eq(m[1, 0], 5)
    assert_eq(m[2, 3], 12)

@test
fn test_2d_read_variable_index() → ∅:
    let m := (2, 3) ⍴ [10, 20, 30, 40, 50, 60]
    let r := 1
    let c := 2
    assert_eq(m[r, c], 60)

// ---- 2D write access ----------------------------------------------------

@test
fn test_2d_write() → ∅:
    let m : mut = (2, 3) ⍴ 0
    m[0, 1] ← 42
    m[1, 2] ← 99
    assert_eq(m[0, 1], 42)
    assert_eq(m[1, 2], 99)
    assert_eq(m[0, 0], 0)

@test
fn test_2d_write_variable_index() → ∅:
    let m : mut = (2, 2) ⍴ 0
    let r := 1
    let c := 0
    m[r, c] ← 7
    assert_eq(m[1, 0], 7)

// ---- 3D access ----------------------------------------------------------

@test
fn test_3d_read() → ∅:
    let a := (2, 3, 4) ⍴ (1…24)
    assert_eq(a[0, 0, 0], 1)
    assert_eq(a[0, 0, 3], 4)
    assert_eq(a[0, 2, 3], 12)
    assert_eq(a[1, 0, 0], 13)
    assert_eq(a[1, 2, 3], 24)

@test
fn test_3d_write() → ∅:
    let a : mut = (2, 2, 2) ⍴ 0
    a[1, 0, 1] ← 55
    assert_eq(a[1, 0, 1], 55)
    assert_eq(a[0, 0, 0], 0)

// ---- mixed: single subscript on outer, multi on inner -------------------

@test
fn test_single_then_multi() → ∅:
    let a := (2, 3, 4) ⍴ (1…24)
    let row := a[1]
    assert_eq(row[0, 0], 13)
    assert_eq(row[2, 3], 24)

// ---- equivalence: arr[i, j] == arr[i][j] -------------------------------

@test
fn test_equiv_chained() → ∅:
    let m := (3, 3) ⍴ (1…9)
    foreach r := 0…2:
        foreach c := 0…2:
            assert_eq(m[r, c], m[r][c])

// ---- out-of-bounds ------------------------------------------------------

@test
@expect error "out of range"
fn test_2d_oob_row() → ∅:
    let m : mut = (2, 3) ⍴ 0
    let x : mut = m[2, 0]

@test
@expect error "out of range"
fn test_2d_oob_col() → ∅:
    let m : mut = (2, 3) ⍴ 0
    let x : mut = m[0, 3]

@test
@expect error "out of range"
fn test_2d_write_oob() → ∅:
    let m : mut = (2, 3) ⍴ 0
    m[0, 3] ← 1

// ---- non-array inner dimension ------------------------------------------

@test
@expect error "requires nested arrays"
fn test_flat_multi_subscript() → ∅:
    let a : mut = [1, 2, 3]
    let x : mut = a[0, 0]

@start
fn main() → ∅:
    std.print("multidim tests passed")
