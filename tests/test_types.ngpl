// Test type coercion, widening, and optional parameters.

// Untyped int coerced to u32 on function call.
@test
fn test_widen_to_u32():
    let result := add_u32(100, 200)
    assert_eq(result, 300)

fn add_u32(a : u32, b : u32) → u32:
    a + b

// Optional parameter accepts both value and ∅.
@test
fn test_optional_param_some():
    assert_eq(unwrap_or_zero(42), 42)

@test
fn test_optional_param_none():
    assert_eq(unwrap_or_zero(∅), 0)

fn unwrap_or_zero(x : i64?) → i64:
    x ?? 0

// ---------------------------------------------------------------------
// An optional or expected binding
// ---------------------------------------------------------------------

// A binding says it is optional the same way a parameter or a type
// alias does, with ? after the type.
@test
fn test_optional_binding_holds_a_value():
    let x : i32? = 5
    assert_eq(x ?? 0, 5)

@test
fn test_optional_binding_holds_nothing():
    let x : i32? = ∅
    assert_eq(x ?? 0, 0)

// The ? admits absence; what is there when there is something still
// has to be the type.
@test
fn test_optional_binding_matches():
    let x : i32? = 7
    match x:
        ∃(v):  assert_eq(v, 7)
        ∅:     assert(false)

@test
fn test_optional_binding_matches_absent():
    let x : i32? = ∅
    match x:
        ∃(v):  assert(false)
        ∅:     assert(true)

// ! is the expected form, as it is elsewhere.
@test
fn test_expected_binding():
    let e : i32! = 7
    assert_eq(e ?? 0, 7)

// ---------------------------------------------------------------------
// A literal's suffix says what type it is
// ---------------------------------------------------------------------

@test
fn test_integer_suffix_applies():
    static_assert_eq(@typeof(5i32), i32)
    static_assert_eq(@typeof(5u8), u8)
    static_assert_eq(@typeof(5u7), u7)
    static_assert_eq(@typeof(5i64), i64)

@test
fn test_float_suffix_applies():
    static_assert_eq(@typeof(1.5f32), f32)
    static_assert_eq(@typeof(1.5f64), f64)
    static_assert_eq(@typeof(1.5bfloat16), bfloat16)

// Without a suffix a literal stays untyped and settles where it is
// used.
@test
fn test_no_suffix_stays_untyped():
    static_assert_eq(@typeof(5), int)
    static_assert_eq(@typeof(1.5), float)

// A whole number may be spelled with a float type, which is how a
// float is written without a fractional part.
@test
fn test_whole_number_with_a_float_suffix():
    static_assert_eq(@typeof(5f32), f32)
    assert(5f32 = 5.0)

// A suffix names a type, so one that names nothing is a mistake, and
// a fractional number cannot take an integer type.  Those are output
// tests, since a literal is read before anything runs.

@start
@impure
fn main():
    std.println("type tests passed")

// ---------------------------------------------------------------------
// Equality is =, inequality ≠, and only ← stores
// ---------------------------------------------------------------------

// The same glyph separates a definition from its value.  Each consumes
// its = before an expression begins, so an = reached while an
// expression is being read is the operator.
@test
fn test_a_definition_initialized_with_a_comparison():
    let x : i64 = 5
    let b : bool = x = 5
    assert(b)
    assert(¬(x = 6))

@test
fn test_equality_in_a_condition():
    let x : i64 = 5
    let hit : mut = false
    if x = 5:
        hit ← true
    assert(hit)

// The old spelling is refused by name, since every program written
// before the rename uses it.
@test
@expect error 2027 "Line 130, col 20: '==' is not an operator; equality is written '='"
fn error_the_old_spelling():
    let x : i64 = 5
    let b : mut = x == 5

@test
@expect error 2027 "Line 136, col 20: '!=' is not an operator; inequality is written '≠'"
fn error_the_old_spelling_of_inequality():
    let x : i64 = 5
    let b : mut = x != 5

// The two read as a pair, ≠ being = with a stroke through it.
@test
fn test_inequality():
    let x : i64 = 5
    assert(x ≠ 6)
    assert(¬(x ≠ 5))
    let differ : bool = x ≠ 6
    assert(differ)

// Storing is ← and nothing else, so a statement that compares computes
// something nothing reads.
@test
@expect error 2291 "the value of this statement is not used; it computes something and nothing reads it"
fn error_comparing_where_a_store_was_meant():
    let x : mut i64 = 1
    x = 5
    x ← 2
