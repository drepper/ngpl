// The @build function is read for what it declares before anything
// runs.  A recipe is handed the build it declares on and, where it
// reads it, what the command line said: one std.Options with a member
// per option -- the name -o gave, the target --target gave -- each an
// optional, ∅ where the command line said nothing.  A recipe that reads
// none of it, as most do, takes only the build.  This one reads it, so
// it takes both.  It adds an executable for each thing to be built, the paths a
// source is looked for along, and the flags the compiler is asked for.
// Acting on any of that belongs to the compiler; reading the recipe
// does not.
//
// A recipe is a program and not a table: the names below are computed,
// by the same functions the tests check, so what reaches the build is
// what the recipe worked out rather than what was typed.

fn suffixed(stem : str, ext : str) → str:
    stem ⧺ "." ⧺ ext

fn rooted(dir : str, name : str) → str:
    if dir = "": name else: dir ⧺ "/" ⧺ name

@build
fn build(b : &mut std.Build, o : &std.Options):
    // where an executable that names no directory of its own goes
    b.output_dir ← "build"
    b.search_path("vendor")
    b.search_path(rooted("third_party", "ngpl"))
    b.flag("O1")
    b.flag("contracts=enforce")
    // Two outputs from one recipe, the second saying where it goes.
    // What -o and --target said is read off the options, ∅ where
    // nothing was said: the first output is called what -o asked for,
    // and the second is built for what --target asked for.  The
    // compiler applies both to what a recipe adds in any case, so a
    // recipe reading them says the same thing rather than a different
    // one.
    b.add_executable(std.Build.Executable{name: o.output ?? "demo",
                                          root_source_file: suffixed("main", "ngpl")})
    b.add_executable(std.Build.Executable{name: "demo-tools",
                                          root_source_file: suffixed("tools", "ngpl"),
                                          output_dir: rooted("build", "tools"),
                                          target: o.target ?? ""})

@test
fn test_a_name_is_computed():
    assert(suffixed("main", "ngpl") = "main.ngpl")
    assert(suffixed("tools", "ngpl") = "tools.ngpl")

@test
fn test_a_directory_that_is_empty_adds_nothing():
    assert(rooted("", "ngpl") = "ngpl")
    assert(rooted("third_party", "ngpl") = "third_party/ngpl")
    assert(rooted("build", "tools") = "build/tools")

@start
@impure
fn main():
    std.println("build tests passed")
