// The @build function is read for what it declares before anything
// runs: the one file the program is rooted in, where the result goes,
// the search paths and the compiler flags all land in std.build.
// Acting on a build recipe belongs to the compiler; reading it does
// not.
//
// Each thing is declared by naming it and answered by a reader.  The
// three that hold a single name answer "" until one is declared; the
// two that hold a list answer them in the order they were declared.
// The program is rooted in one file and says the rest of itself with
// @import, so a recipe names that one file and no more.

@build
fn build():
    let root : str = "src/" ⧺ "main" ⧺ ".ngpl"
    std.build.root_source_file(root)
    std.build.output_dir("build")
    std.build.output("demo")
    std.build.search_path("vendor")
    std.build.search_path("third_party/ngpl")
    std.build.flag("O1")
    std.build.flag("contracts=enforce")

// What was declared has been read by the time anything else runs.
@test
fn test_search_paths_are_read():
    let p := std.build.paths()
    assert(#p = 2)
    assert(p[0] = "vendor")
    assert(p[1] = "third_party/ngpl")

@test
fn test_flags_are_read():
    let f := std.build.flags()
    assert(#f = 2)
    assert(f[0] = "O1")
    assert(f[1] = "contracts=enforce")

// A recipe is a program, not a table: the name here was computed and
// is answered as it was declared.
@test
fn test_the_root_source_is_read():
    assert(std.build.root_source_file_name() = "src/main.ngpl")

@test
fn test_the_output_is_read():
    assert(std.build.output_name() = "demo")
    assert(std.build.output_directory() = "build")

@start
@impure
fn main():
    std.println("build tests passed")
